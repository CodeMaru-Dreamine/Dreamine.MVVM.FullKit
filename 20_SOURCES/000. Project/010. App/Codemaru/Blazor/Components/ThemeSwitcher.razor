@namespace Codemaru.Blazor.Components
@inject IJSRuntime JS
@inject SiteLocalization Text

<label class="cm-theme-switcher" title="@Text["theme.label"]">
    <i class="@ThemeIcon" aria-hidden="true"></i>
    <span class="visually-hidden">@Text["theme.label"]</span>
    <select value="@_theme" @onchange="OnThemeChangedAsync" aria-label="@Text["theme.label"]">
        <option value="system">@Text["theme.system"]</option>
        <option value="light">@Text["theme.light"]</option>
        <option value="dark">@Text["theme.dark"]</option>
    </select>
</label>

@code {
    private string _theme = "system";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _theme = await JS.InvokeAsync<string>("codemaruTheme.get");
        StateHasChanged();
    }

    private async Task OnThemeChangedAsync(ChangeEventArgs args)
    {
        var theme = args.Value?.ToString() ?? "system";
        _theme = theme;
        await JS.InvokeVoidAsync("codemaruTheme.set", theme);
    }

    private string ThemeIcon => _theme switch
    {
        "light" => "fa-solid fa-sun",
        "dark" => "fa-solid fa-moon",
        _ => "fa-solid fa-desktop"
    };
}
