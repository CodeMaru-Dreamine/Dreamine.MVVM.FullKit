@namespace Codemaru.Blazor
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation
@inject SiteLocalization Text
@inject PublicLanguageSettings PublicLanguage

<!DOCTYPE html>
<html lang="@Text.HtmlLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>CodeMaru — @Text["services.title"]</title>
    <meta name="keywords" content="CodeMaru, CardHybrid, Dreamine, vCard, QR, Wedding, ThankYou, Families, CCTV, ShopStore, Portfolio" />
    <link rel="icon" type="image/jpeg" href="/img/Codemaru_Essence.jpg" />
    <script>
        (() => {
            const saved = localStorage.getItem("codemaru-theme");
            if (saved === "light" || saved === "dark") {
                document.documentElement.dataset.theme = saved;
            }
        })();
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Organization",
          "name": "CodeMaru",
          "url": "https://codemaru.co.kr/",
          "logo": "https://codemaru.co.kr/img/Codemaru_Bloom_Light.jpg",
          "sameAs": [
            "https://shop.codemaru.co.kr",
            "https://wedding.codemaru.co.kr",
            "https://thankyou.codemaru.co.kr",
            "https://families.codemaru.co.kr",
            "https://portfolio.codemaru.co.kr",
            "https://github.com/CodeMaru-Dreamine",
            "https://cctvviewer.codemaru.co.kr"
          ],
          "department": [
            {
              "@@type": "WebApplication",
              "name": "CardHybrid",
              "url": "https://codemaru.co.kr/cardhybrid",
              "description": "@Text["service.cardhybrid"]"
            }
          ]
        }
    </script>

    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/cardhybrid.css" />
    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/Codemaru.styles.css" />
    <link rel="stylesheet" href="/css/codemaru-site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <HeadOutlet />
</head>
<body>
    <Codemaru.Blazor.Routes @rendermode="new InteractiveServerRenderMode(prerender: true)" />
    <script src="/_content/Dreamine.UI.Blazor/dreamine-localization.js"></script>
    <script src="/_content/Dreamine.UI.Blazor/dreamine-portal.js"></script>
    <script src="/_framework/blazor.web.js"></script>
    <script src="/js/site.js" defer></script>
</body>
</html>

@code {
    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("lang", out var language))
        {
            Text.SetLanguage(language.ToString());
        }
        else
        {
            Text.SetLanguage(PublicLanguage.DefaultLanguage);
        }
    }
}
