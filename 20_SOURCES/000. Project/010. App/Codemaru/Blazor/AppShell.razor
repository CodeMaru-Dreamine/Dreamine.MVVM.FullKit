@namespace Codemaru.Blazor
@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>CodeMaru - 명함 QR, 모바일 청첩장, 감사장, 가족 앨범, CCTV, 쇼핑몰</title>
    <meta name="keywords" content="코드마루, CodeMaru, 명함 QR, vCard, 모바일 청첩장, 감사장, 가족 앨범, CCTV 원격 모니터링, 쇼핑몰, 포트폴리오, Dreamine, CardHybrid" />
    <link rel="icon" type="image/jpeg" href="/img/Codemaru_Essence.jpg" />
    <script>
        (() => {
            const saved = localStorage.getItem("codemaru-theme");
            if (saved === "light" || saved === "dark") {
                document.documentElement.dataset.theme = saved;
            }
        })();
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Organization",
          "name": "코드마루",
          "url": "https://codemaru.co.kr/",
          "logo": "https://codemaru.co.kr/img/Codemaru_Bloom_Light.jpg",
          "sameAs": [
            "https://shop.codemaru.co.kr",
            "https://wedding.codemaru.co.kr",
            "https://thankyou.codemaru.co.kr",
            "https://families.codemaru.co.kr",
            "https://portfolio.codemaru.co.kr",
            "https://github.com/CodeMaru-Dreamine",
            "https://cctvviewer.codemaru.co.kr"
          ],
          "department": [
            {
              "@@type": "WebApplication",
              "name": "CardHybrid",
              "url": "https://codemaru.co.kr/cardhybrid",
              "description": "QR, vCard, 명함 랜딩 페이지와 명함 앞뒷면 내보내기를 지원하는 CodeMaru 명함 도구."
            }
          ]
        }
    </script>

    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/cardhybrid.css" />
    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/Codemaru.styles.css" />
    <link rel="stylesheet" href="/css/codemaru-site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <HeadOutlet />
</head>
<body>
    <Codemaru.Blazor.Routes @rendermode="new InteractiveServerRenderMode(prerender: true)" />
    <script src="/_framework/blazor.web.js"></script>
    <script src="/js/site.js" defer></script>
</body>
</html>
