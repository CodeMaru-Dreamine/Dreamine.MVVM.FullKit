@namespace Codemaru.Blazor.Layout
@implements IDisposable
@inject NavigationManager Navigation
@inject SiteLocalization Text
@using Dreamine.UI.Blazor.Navigation

<AuthorizeView>
    <Authorized Context="authenticationState">
        <DreaminePortalHeader BrandName="CodeMaru"
                              BrandUrl="/"
                              BrandImageUrl="/img/Codemaru_Bloom.jpg"
                              BrandLightImageUrl="/img/Codemaru_Bloom_Light.jpg"
                              BrandImageAlt=""
                              Items="@NavigationItems"
                              ActiveKey="@ActiveKey"
                              NavigationAriaLabel="CodeMaru services"
                              ToggleMenuLabel="@Text["nav.toggle"]"
                              Fixed="true"
                              IsAuthenticated="true"
                              DisplayName="@DisplayNameOf(authenticationState)"
                              ScreenSettingsLabel="@Text["screenSettings"]"
                              AccountUrl="@($"/account?returnUrl={ReturnUrl}")"
                              AccountLabel="@Text["account"]"
                              SignoutUrl="@($"/signout?returnUrl={ReturnUrl}")"
                              SignoutLabel="@Text["logout"]">
            <Preferences>
                <DreaminePortalPreferences ThemeLabel="@Text["theme.label"]"
                                           SystemThemeLabel="@Text["theme.system"]"
                                           LightThemeLabel="@Text["theme.light"]"
                                           DarkThemeLabel="@Text["theme.dark"]"
                                           ThemeStorageKey="codemaru-theme"
                                           CookieDomain=".codemaru.co.kr"
                                           Language="@Text.Language"
                                           LanguageChanged="ChangeLanguageAsync"
                                           Languages="@Text.Languages"
                                           LanguageLabel="@Text["language"]"
                                           FallbackLanguage="ko"
                                           LanguageStorageKey="codemaru-language" />
            </Preferences>
            <AdditionalUserActions>
                <AuthorizeView Policy="CodemaruAdmin" Context="adminContext">
                    <Authorized>
                        <a href="/admin"><span aria-hidden="true">⌁</span> @Text["admin"]</a>
                    </Authorized>
                </AuthorizeView>
            </AdditionalUserActions>
        </DreaminePortalHeader>
    </Authorized>
    <NotAuthorized>
        <DreaminePortalHeader BrandName="CodeMaru"
                              BrandUrl="/"
                              BrandImageUrl="/img/Codemaru_Bloom.jpg"
                              BrandLightImageUrl="/img/Codemaru_Bloom_Light.jpg"
                              BrandImageAlt=""
                              Items="@NavigationItems"
                              ActiveKey="@ActiveKey"
                              NavigationAriaLabel="CodeMaru services"
                              ToggleMenuLabel="@Text["nav.toggle"]"
                              Fixed="true"
                              LoginUrl="@($"/login?returnUrl={ReturnUrl}")"
                              LoginLabel="@Text["login"]">
            <Preferences>
                <DreaminePortalPreferences ThemeLabel="@Text["theme.label"]"
                                           SystemThemeLabel="@Text["theme.system"]"
                                           LightThemeLabel="@Text["theme.light"]"
                                           DarkThemeLabel="@Text["theme.dark"]"
                                           ThemeStorageKey="codemaru-theme"
                                           CookieDomain=".codemaru.co.kr"
                                           Language="@Text.Language"
                                           LanguageChanged="ChangeLanguageAsync"
                                           Languages="@Text.Languages"
                                           LanguageLabel="@Text["language"]"
                                           FallbackLanguage="ko"
                                           LanguageStorageKey="codemaru-language" />
            </Preferences>
        </DreaminePortalHeader>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string ReturnUrl => Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery);

    private string? ActiveKey
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.Trim('/');
            if (string.IsNullOrWhiteSpace(path))
            {
                return "home";
            }

            return path.Split('/', StringSplitOptions.RemoveEmptyEntries)[0].ToLowerInvariant() switch
            {
                "cardhybrid" => "cardhybrid",
                "contact" => "contact",
                _ => null
            };
        }
    }

    private IReadOnlyList<DreaminePortalNavigationItem> NavigationItems =>
    [
        new("home", Text["nav.home"], "/"),
        new("dreamine", "Dreamine", "https://dreamine.kr/", true),
        new("cardhybrid", "CardHybrid", "/cardhybrid"),
        new("wedding", "Wedding", "https://wedding.codemaru.co.kr"),
        new("thankyou", "ThankYou", "https://thankyou.codemaru.co.kr/"),
        new("families", "Families", "https://families.codemaru.co.kr"),
        new("portfolio", "Portfolio", "https://portfolio.codemaru.co.kr/"),
        new("cctv", "CCTV", "https://cctvviewer.codemaru.co.kr"),
        new("shop", "ShopStore", "https://shop.codemaru.co.kr/"),
        new("contact", Text["contact"], "/contact")
    ];

    protected override void OnInitialized() => Text.Changed += HandleLanguageChanged;

    private Task ChangeLanguageAsync(string language)
    {
        Text.SetLanguage(language);
        return Task.CompletedTask;
    }

    private string DisplayNameOf(AuthenticationState context)
    {
        var name = context.User.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? Text["account"] : name;
    }

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Text.Changed -= HandleLanguageChanged;
}
