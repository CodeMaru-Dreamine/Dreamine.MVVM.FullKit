@namespace Codemaru.Blazor.Layout
@implements IDisposable
@inject NavigationManager Navigation
@inject SiteLocalization Text
@using Codemaru.Blazor.Components

<header class="cm-topbar">
    <a class="cm-brand" href="/">
        <span class="cm-brand-logo-wrap">
            <img class="cm-brand-logo cm-logo-dark" src="/img/Codemaru_Bloom.jpg" alt="" />
            <img class="cm-brand-logo cm-logo-light" src="/img/Codemaru_Bloom_Light.jpg" alt="" />
        </span>
        <span class="cm-brand-text">CodeMaru</span>
    </a>

    <div class="cm-right">
        <nav id="cmMenu" class="cm-nav cm-nav-menu @(isOpen ? "open" : null)">
            <NavLink href="/" Match="NavLinkMatch.All" ActiveClass="active">@Text["nav.home"]</NavLink>
            <a href="https://dreamine.kr/" target="_blank" rel="noopener">Dreamine</a>
            <NavLink href="/cardhybrid" ActiveClass="active">CardHybrid</NavLink>
            <a href="https://wedding.codemaru.co.kr">Wedding</a>
            <a href="https://thankyou.codemaru.co.kr/">ThankYou</a>
            <a href="https://families.codemaru.co.kr">Families</a>
            <a href="https://portfolio.codemaru.co.kr/">Portfolio</a>
            <a href="https://cctvviewer.codemaru.co.kr">CCTV</a>
            <a href="https://shop.codemaru.co.kr/">ShopStore</a>
            <NavLink href="/contact" Match="NavLinkMatch.All" ActiveClass="active">@Text["contact"]</NavLink>

            <AuthorizeView>
                <Authorized>
                    <details class="cm-user-menu">
                        <summary class="cm-user-badge">
                            <i class="fa-solid fa-user"></i>
                            @DisplayNameOf(context)
                            <i class="fa-solid fa-chevron-down cm-user-chevron"></i>
                        </summary>
                        <div class="cm-user-popover">
                            <p class="cm-user-menu-label">@Text["screenSettings"]</p>
                            <ThemeSwitcher />
                            <LanguageSwitcher />
                            <div class="cm-user-menu-divider"></div>
                            <a href="/account?returnUrl=@ReturnUrl"><i class="fa-regular fa-user"></i> @Text["account"]</a>
                            <AuthorizeView Policy="CodemaruAdmin" Context="adminContext">
                                <Authorized>
                                    <a href="/admin"><i class="fa-solid fa-chart-line"></i> @Text["admin"]</a>
                                </Authorized>
                            </AuthorizeView>
                            <a href="/signout?returnUrl=@ReturnUrl"><i class="fa-solid fa-arrow-right-from-bracket"></i> @Text["logout"]</a>
                        </div>
                    </details>
                </Authorized>
                <NotAuthorized>
                    <ThemeSwitcher />
                    <LanguageSwitcher />
                    <a class="cm-auth-link" href="/login?returnUrl=@ReturnUrl">@Text["login"]</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>

        <button class="cm-nav-burger"
                type="button"
                @onclick="ToggleMenu"
                aria-label="@Text["nav.toggle"]"
                aria-expanded="@isOpen"
                aria-controls="cmMenu">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

@code {
    private bool isOpen;

    private string ReturnUrl => Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery);

    private string DisplayNameOf(AuthenticationState context)
    {
        var name = context.User.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? Text["account"] : name;
    }

    private void ToggleMenu()
    {
        isOpen = !isOpen;
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        Text.Changed += HandleLanguageChanged;
    }

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!isOpen)
        {
            return;
        }

        isOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        Text.Changed -= HandleLanguageChanged;
    }
}
