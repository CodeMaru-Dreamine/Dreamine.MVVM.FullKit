@namespace Codemaru.Blazor.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject SiteLocalization Text

<NavMenu @key="@($"nav-{Text.Language}")" />

<main class="cm-body" @key="@($"body-{Text.Language}")">
    @Body
</main>

<footer class="cm-footer">
    <div class="cm-footer-links">
        <a href="/about">@Text["about"]</a>
        <span class="cm-footer-sep">|</span>
        <a href="/privacy">@Text["privacy"]</a>
        <span class="cm-footer-sep">|</span>
        <a href="/terms">@Text["terms"]</a>
        <span class="cm-footer-sep">|</span>
        <a href="/contact">@Text["contact"]</a>
    </div>
    <p class="cm-footer-copy">© 2026 CodeMaru · @Text["footer"] · <a href="mailto:admin@codemaru.co.kr">admin@codemaru.co.kr</a></p>
</footer>

<a href="/contact" class="floating-contact" aria-label="@Text["contact"]">
    <i class="fa-solid fa-envelope"></i>
    @Text["contact"]
</a>

@code {
    protected override void OnInitialized() => Text.Changed += HandleLanguageChanged;

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Text.Changed -= HandleLanguageChanged;
}
