@namespace Codemaru.Blazor.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject SiteLocalization Text
@inject NavigationManager Navigation

<NavMenu @key="@($"nav-{Text.Language}")" />

<main class="@BodyClass" @key="@($"body-{Text.Language}")">
    @Body
</main>

<footer class="cm-footer">
    <div class="cm-footer-links">
        <a href="/about">@Text["about"]</a>
        <span class="cm-footer-sep">|</span>
        <a href="/privacy">@Text["privacy"]</a>
        <span class="cm-footer-sep">|</span>
        <a href="/terms">@Text["terms"]</a>
        <span class="cm-footer-sep">|</span>
        <a href="/contact">@Text["contact"]</a>
    </div>
    <p class="cm-footer-copy">© 2026 CodeMaru · @Text["footer"] · <a href="mailto:admin@codemaru.co.kr">admin@codemaru.co.kr</a></p>
</footer>

<a href="/contact" class="floating-contact" aria-label="@Text["contact"]">
    <i class="fa-solid fa-envelope"></i>
    @Text["contact"]
</a>

@code {
    private string BodyClass => IsCardHybridPage
        ? "cm-body cm-body--flush"
        : "cm-body";

    private bool IsCardHybridPage =>
        string.Equals(
            new Uri(Navigation.Uri).AbsolutePath.Trim('/'),
            "cardhybrid",
            StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Text.Changed += HandleLanguageChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Text.Changed -= HandleLanguageChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
