@page "/about"
@namespace Codemaru.Blazor.Pages
@inject SiteLocalization Text

<PageTitle>@Text["about"] — CodeMaru</PageTitle>
<SeoHead Title="@($"{Text["about"]} — CodeMaru")"
         Description="@Text["about.lead"]"
         CanonicalPath="/about"
         ImageAlt="@Text["about"]" />

<article class="cm-about">
    <header class="cm-about-hero">
        <div>
            <p class="cm-home-kicker">ABOUT CODEMARU</p>
            <h1>@AsHtml(Text["about.title"])</h1>
            <p class="cm-about-lead">@Text["about.lead"]</p>
            <div class="cm-about-actions">
                <a class="cm-home-primary" href="/contact">@Text["about.contact"] <i class="fa-solid fa-arrow-right"></i></a>
                <a class="cm-home-secondary" href="https://github.com/CodeMaru-Dreamine" target="_blank" rel="noopener">
                    <i class="fa-brands fa-github"></i> GitHub
                </a>
            </div>
        </div>
        <img src="/img/codemaru-about-v2.png" alt="@Text["about"]" />
    </header>

    <section class="cm-about-story">
        <div>
            <p class="cm-home-kicker">WHY CODEMARU</p>
            <h2>@AsHtml(Text["about.why"])</h2>
        </div>
        <div>
            <p>@Text["about.why1"]</p>
            <p>@Text["about.why2"]</p>
        </div>
    </section>

    <section class="cm-about-principles" aria-label="@Text["about"]">
        <article>
            <span>01</span>
            <i class="fa-solid fa-pen-ruler"></i>
            <h2>@Text["about.principle.design"]</h2>
            <p>@Text["about.principle.designText"]</p>
        </article>
        <article>
            <span>02</span>
            <i class="fa-solid fa-server"></i>
            <h2>@Text["about.principle.run"]</h2>
            <p>@Text["about.principle.runText"]</p>
        </article>
        <article>
            <span>03</span>
            <i class="fa-solid fa-arrows-rotate"></i>
            <h2>@Text["about.principle.improve"]</h2>
            <p>@Text["about.principle.improveText"]</p>
        </article>
    </section>

    <section class="cm-about-capabilities">
        <div>
            <p class="cm-home-kicker">WHAT I BUILD</p>
            <h2>@AsHtml(Text["about.build"])</h2>
            <p>@Text["about.buildLead"]</p>
        </div>
        <ul>
            <li><i class="fa-brands fa-windows"></i><span><strong>WPF · MVVM</strong> @Text["about.cap.wpf"]</span></li>
            <li><i class="fa-solid fa-globe"></i><span><strong>ASP.NET · Blazor</strong> @Text["about.cap.web"]</span></li>
            <li><i class="fa-solid fa-database"></i><span><strong>Database</strong> @Text["about.cap.db"]</span></li>
            <li><i class="fa-solid fa-video"></i><span><strong>CCTV · RTSP</strong> @Text["about.cap.cctv"]</span></li>
            <li><i class="fa-solid fa-gears"></i><span><strong>@Text["about.cap.automation"]</strong> @Text["about.cap.automationText"]</span></li>
            <li><i class="fa-solid fa-code-branch"></i><span><strong>Open Source</strong> @Text["about.cap.oss"]</span></li>
        </ul>
    </section>

    <section class="cm-about-cta">
        <div>
            <p class="cm-home-kicker">WORK WITH CODEMARU</p>
            <h2>@Text["about.cta"]</h2>
            <p>@Text["about.ctaLead"]</p>
        </div>
        <a class="cm-home-primary" href="/contact">@Text["contact"] <i class="fa-solid fa-arrow-right"></i></a>
    </section>
</article>

@code {
    private static MarkupString AsHtml(string value) =>
        new(value.Replace("\n", "<br />", StringComparison.Ordinal));
}
