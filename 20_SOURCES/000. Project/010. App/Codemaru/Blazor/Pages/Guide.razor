@page "/guide"
@page "/guide/{Service}"
@namespace Codemaru.Blazor.Pages
@inject SiteLocalization Text

<PageTitle>@Copy.Manual — @Current.Title | CodeMaru</PageTitle>
<SeoHead Title="@($"{Current.Title} | {Copy.Manual}")"
         Description="@Current.Description"
         CanonicalPath="@($"/guide/{ActiveKey}")"
         ImageAlt="@Current.Title" />

<section class="guide-page" @key="@Text.Language">
    <nav class="guide-nav" aria-label="@Copy.Manual">
        <h2>@Copy.Manual</h2>
        <ul>
            @foreach (var item in Services)
            {
                <li>
                    <a class="@(item.Key == ActiveKey ? "active" : "")" href="/guide/@item.Key">
                        <span>@item.Icon</span> @item.Name
                    </a>
                </li>
            }
        </ul>
    </nav>

    <article class="guide-content">
        <header class="guide-header">
            <span class="guide-icon">@Current.Icon</span>
            <div>
                <h1>@Current.Title</h1>
                <p class="guide-subtitle">@Current.Description</p>
            </div>
        </header>

        <div class="guide-body">
            <section>
                <h2>@Copy.Overview</h2>
                <p>@Current.Overview</p>
            </section>
            <section>
                <h2>@Copy.Start</h2>
                <ol>
                    <li>@Copy.StepOpen.Replace("{service}", Current.Name)</li>
                    <li>@Copy.StepEnter</li>
                    <li>@Copy.StepPreview</li>
                    <li>@Copy.StepSave</li>
                </ol>
            </section>
            <section>
                <h2>@Copy.Features</h2>
                <dl>
                    <dt>✏️ @Copy.Edit</dt><dd>@Copy.EditDetail</dd>
                    <dt>👁️ @Copy.Preview</dt><dd>@Copy.PreviewDetail</dd>
                    <dt>🔗 @Copy.Share</dt><dd>@Copy.ShareDetail</dd>
                    <dt>🔐 @Copy.Account</dt><dd>@Copy.AccountDetail</dd>
                </dl>
            </section>
            <section>
                <h2>@Copy.Faq</h2>
                <dl>
                    <dt>@Copy.FaqMobile</dt><dd>@Copy.FaqMobileAnswer</dd>
                    <dt>@Copy.FaqLanguage</dt><dd>@Copy.FaqLanguageAnswer</dd>
                    <dt>@Copy.FaqSave</dt><dd>@Copy.FaqSaveAnswer</dd>
                </dl>
            </section>
        </div>
    </article>
</section>

