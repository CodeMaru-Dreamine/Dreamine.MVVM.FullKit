@page "/cardhybrid"
@namespace Codemaru.Blazor.Pages
@implements IDisposable
@using System.Text.Json
@using Codemaru.Models
@inject CardHybridCircuitSession Session
@inject ImageBackgroundRemover BackgroundRemover
@inject LandingPageExporter Exporter
@inject LandingPagePublisher Publisher
@inject CardProfileImporter Importer
@inject IJSRuntime JS
@inject SiteLocalization Text

<PageTitle>CardHybrid — 무료 명함 QR · vCard · 랜딩 페이지 | CodeMaru</PageTitle>
<SeoHead Title="CardHybrid — 무료 명함 QR · vCard · 랜딩 페이지"
         Description="QR 코드, 명함 랜딩 페이지, vCard 저장, 앞뒷면 PDF 내보내기를 한 화면에서 무료로 관리하는 CodeMaru 명함 도구입니다."
         CanonicalPath="/cardhybrid"
         Image="https://codemaru.co.kr/img/codemaru_og_v2.png"
         ImageAlt="CardHybrid 디지털 명함 제작 화면" />

<main class="card-hybrid-shell">
    @if (showMigrationPrompt)
    {
        <div class="migration-prompt" role="dialog" aria-labelledby="migrationPromptTitle">
            <div class="migration-prompt-body">
                <h3 id="migrationPromptTitle">@Dialog.MigrationTitle</h3>
                <p><strong>@Session.CurrentUser.DisplayName</strong> — @Dialog.MigrationQuestion</p>
                <p class="migration-prompt-warning">
                    ⚠️ @Dialog.MigrationWarning
                </p>
                <div class="migration-prompt-actions">
                    <button type="button" class="primary-button" @onclick="AcceptGuestMigrationAsync">@Dialog.SaveAccount</button>
                    <button type="button" class="ghost-button" @onclick="RejectGuestMigrationAsync">@Dialog.Discard</button>
                </div>
            </div>
        </div>
    }

    @if (showSaveOptionsPrompt)
    {
        <div class="save-options-prompt" role="dialog" aria-labelledby="saveOptionsTitle">
            <div class="save-options-body">
                <h3 id="saveOptionsTitle">@Dialog.SaveOptionsTitle</h3>
                <p>@Dialog.SaveOptionsDescription</p>

                <label class="check-row">
                    <input type="checkbox" @bind="publishLandingOnSave" />
                    @Dialog.PublishPage
                </label>
                <label class="check-row">
                    <input type="checkbox" @bind="includePhoneInVCard" />
                    @C("includePhone")
                </label>
                <label class="check-row">
                    <input type="checkbox" @bind="includeAddressInVCard" />
                    @C("includeAddress")
                </label>

                <p class="save-options-url">@LandingUrl</p>

                <div class="save-options-actions">
                    <button type="button" class="primary-button" @onclick="SaveHistoryWithOptionsAsync">@Dialog.Save</button>
                    <button type="button" class="ghost-button" @onclick="CancelSaveOptions">@Dialog.Cancel</button>
                </div>
            </div>
        </div>
    }

    <section class="workspace-band">
        <div class="workspace-title">
            <div>
                <p class="eyebrow">Codemaru Feature</p>
                <h1>CardHybrid</h1>
            </div>
            <div class="toolbar">
                <button type="button" class="ghost-button" title="@C("refreshQr")" @onclick="ApplyProfile">@C("refreshQr")</button>
                <button type="button" class="primary-button" title="현재 명함을 이력에 저장" @onclick="OpenSaveOptionsPrompt">@HistorySaveButtonText</button>
            </div>
        </div>

        <div class="tool-grid">
            <section class="editor-panel" aria-label="@C("editor")">
                <div class="panel-header">
                    <h2>@C("cardInfo")</h2>
                    <span>@SavedStatus</span>
                </div>

                <div class="profile-fieldset">
                <div class="field-with-style">
                    <label class="field-main">
                        @C("frontBrand")
                        <input @bind="brand" @bind:event="oninput" />
                    </label>
                    <label>
                        @C("font")
                        <select @bind="frontFontFamily">
                            @foreach (var font in FontOptions)
                            {
                                <option value="@font">@font</option>
                            }
                        </select>
                    </label>
                    <label>
                        @C("size")
                        <input type="number" min="10" max="56" step="1" @bind="frontBrandFontSize" @bind:event="oninput" />
                    </label>
                </div>

                <div class="field-with-style">
                    <label class="field-main">
                        @C("frontTagline")
                        <input @bind="tagline" @bind:event="oninput" />
                    </label>
                    <label>
                        @C("font")
                        <select @bind="frontFontFamily">
                            @foreach (var font in FontOptions)
                            {
                                <option value="@font">@font</option>
                            }
                        </select>
                    </label>
                    <label>
                        @C("size")
                        <input type="number" min="10" max="40" step="1" @bind="frontTaglineFontSize" @bind:event="oninput" />
                    </label>
                </div>

                <div class="field-with-style">
                    <label class="field-main">
                        @C("category")
                        <textarea rows="3" @bind="category" @bind:event="oninput"></textarea>
                    </label>
                    <label>
                        @C("font")
                        <select @bind="frontFontFamily">
                            @foreach (var font in FontOptions)
                            {
                                <option value="@font">@font</option>
                            }
                        </select>
                    </label>
                    <label>
                        @C("size")
                        <input type="number" min="10" max="40" step="1" @bind="frontCategoryFontSize" @bind:event="oninput" />
                    </label>
                </div>

                <div class="field-with-style">
                    <label class="field-main">
                        @C("email")
                        <input type="email" @bind="email" @bind:event="oninput" />
                    </label>
                    <label>
                        @C("font")
                        <select @bind="frontFontFamily">
                            @foreach (var font in FontOptions)
                            {
                                <option value="@font">@font</option>
                            }
                        </select>
                    </label>
                    <label>
                        @C("size")
                        <input type="number" min="9" max="28" step="1" @bind="frontEmailFontSize" @bind:event="oninput" />
                    </label>
                </div>

                <div class="field-with-style">
                    <label class="field-main">
                        @C("backBrand")
                        <input @bind="backBrand" @bind:event="oninput" />
                    </label>
                    <label>
                        @C("font")
                        <select @bind="backFontFamily">
                            @foreach (var font in FontOptions)
                            {
                                <option value="@font">@font</option>
                            }
                        </select>
                    </label>
                    <label>
                        @C("size")
                        <input type="number" min="10" max="48" step="1" @bind="backBrandFontSize" @bind:event="oninput" />
                    </label>
                </div>

                <div class="field-with-style">
                    <label class="field-main">
                        @C("backTagline")
                        <input @bind="backTagline" @bind:event="oninput" />
                    </label>
                    <label>
                        @C("font")
                        <select @bind="backFontFamily">
                            @foreach (var font in FontOptions)
                            {
                                <option value="@font">@font</option>
                            }
                        </select>
                    </label>
                    <label>
                        @C("size")
                        <input type="number" min="9" max="32" step="1" @bind="backTaglineFontSize" @bind:event="oninput" />
                    </label>
                </div>

                <div class="field-with-style">
                    <label class="field-main">
                        @C("name")
                        <input @bind="name" @bind:event="oninput" />
                    </label>
                    <label>
                        @C("font")
                        <select @bind="backFontFamily">
                            @foreach (var font in FontOptions)
                            {
                                <option value="@font">@font</option>
                            }
                        </select>
                    </label>
                    <label>
                        @C("size")
                        <input type="number" min="10" max="36" step="1" @bind="backNameFontSize" @bind:event="oninput" />
                    </label>
                </div>

                <div class="field-with-style">
                    <label class="field-main">
                        @C("role")
                        <input @bind="role" @bind:event="oninput" />
                    </label>
                    <label>
                        @C("font")
                        <select @bind="backFontFamily">
                            @foreach (var font in FontOptions)
                            {
                                <option value="@font">@font</option>
                            }
                        </select>
                    </label>
                    <label>
                        @C("size")
                        <input type="number" min="9" max="30" step="1" @bind="backRoleFontSize" @bind:event="oninput" />
                    </label>
                </div>
                <label>
                    @C("phone")
                    <textarea rows="2" @bind="phone" @bind:event="oninput"></textarea>
                </label>
                <label>
                    @C("address")
                    <input @bind="address" @bind:event="oninput" />
                </label>
                <label>
                    @C("handle")
                    <input @bind="landingHandle" @bind:event="oninput" placeholder="minsu" />
                    <span class="field-hint">@LandingUrl</span>
                </label>

                <div class="size-grid">
                    <label>
                        @C("width")
                        <input type="number" min="40" max="140" step="1" @bind="cardWidthMm" @bind:event="oninput" />
                    </label>
                    <label>
                        @C("height")
                        <input type="number" min="25" max="90" step="1" @bind="cardHeightMm" @bind:event="oninput" />
                    </label>
                </div>

                <div class="accent-row">
                    <label>
                        @C("accent")
                        <input type="color" @bind="accentColor" />
                    </label>
                    <div class="swatch" style="background:@accentColor"></div>
                </div>

                <label>
                    @C("backImage")
                    <span class="localized-file-input">
                        <InputFile OnChange="OnLogoSelectedAsync" accept="image/png,image/jpeg,image/webp,image/svg+xml,image/x-icon,image/vnd.microsoft.icon,.ico" />
                        <span class="localized-file-button">@C("chooseFile")</span>
                        <span class="localized-file-name">@(logoFileName ?? C("noFileSelected"))</span>
                    </span>
                </label>

                @if (!string.IsNullOrWhiteSpace(logoImageDataUrl))
                {
                    <label class="check-row">
                        <input type="checkbox" checked="@removeLogoBackground" @onchange="OnRemoveBackgroundChangedAsync" />
                        @C("removeBackground")
                    </label>
                    <button type="button" class="ghost-button full-button" @onclick="RemoveLogo">@C("removeImage")</button>
                }

                <label>
                    @C("shortBio")
                    <input @bind="shortBio" @bind:event="oninput" />
                </label>
                <label>
                    @C("landingDescription")
                    <textarea rows="3" @bind="landingDescription" @bind:event="oninput"></textarea>
                </label>
                <label>
                    @C("vcardNote")
                    <textarea rows="2" @bind="vCardNote" @bind:event="oninput"></textarea>
                </label>
                <label>
                    @C("internalMemo")
                    <textarea rows="3" @bind="internalMemo" @bind:event="oninput"></textarea>
                </label>
                </div>
            </section>

            <section class="preview-panel" aria-label="@C("preview")">
                <div class="preview-tabs" role="tablist" aria-label="@C("preview")">
                    <button type="button" class="@TabClass("card")" @onclick='() => activePreviewTab = "card"'>@C("card")</button>
                    <button type="button" class="@TabClass("landing")" @onclick='() => activePreviewTab = "landing"'>@C("landingHtml")</button>
                </div>

                @if (activePreviewTab == "card")
                {
                    <div class="export-actions card-export-actions">
                        <a class="ghost-button" download="card-front.svg" href="@CardFrontSvgDataUrl">@C("frontSvg")</a>
                        <a class="ghost-button" download="card-back.svg" href="@CardBackSvgDataUrl">@C("backSvg")</a>
                    </div>

                    <div class="card-preview-block">
                        <span class="side-label">@C("front")</span>
                        @if (IsImportedImageCard)
                        {
                            <div class="business-card imported-card" style="@CardStyle">
                                <img src="@importedFrontImageDataUrl" alt="@Dialog.ImportedFrontAlt" />
                            </div>
                        }
                        else
                        {
                            <div class="business-card front" style="@CardStyle">
                                <div class="front-copy">
                                    <h2 style="color:@accentColor">@brand</h2>
                                    <p>@tagline</p>
                                    <strong>@category</strong>
                                    <span>@email</span>
                                </div>
                                <div class="qr-stack">
                                    <div class="qr-box">@((MarkupString)State.QrSvg)</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="card-preview-block">
                        <span class="side-label">@C("back")</span>
                        @if (IsImportedImageCard)
                        {
                            <div class="business-card imported-card" style="@CardStyle">
                                @if (string.IsNullOrWhiteSpace(importedBackImageDataUrl))
                                {
                                    <span class="imported-card-empty">@Dialog.NoBackImage</span>
                                }
                                else
                                {
                                    <img src="@importedBackImageDataUrl" alt="@Dialog.ImportedBackAlt" />
                                }
                            </div>
                        }
                        else
                        {
                            <div class="business-card back" style="@CardStyle">
                                <div class="back-logo-slot" style="border-color:@accentColor">
                                    @if (string.IsNullOrWhiteSpace(logoImageDataUrl))
                                    {
                                        <span style="background:@accentColor"></span>
                                    }
                                    else
                                    {
                                        <img src="@logoImageDataUrl" alt="@backBrand logo" />
                                    }
                                </div>
                                <div class="back-copy">
                                    <h3>@backBrand</h3>
                                    <p>@backTagline</p>
                                    <strong>@name</strong>
                                    <span>@role</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="landing-preview">
                        <div>
                            <p class="eyebrow">Landing page</p>
                            <h2>@name</h2>
                            <p>@role at @backBrand</p>
                            <a href="@LandingUrl" target="_blank">@LandingUrl</a>
                        </div>
                        <dl>
                            <dt>Email</dt>
                            <dd>@email</dd>
                            <dt>Phone</dt>
                            <dd>@DisplayValue(phone)</dd>
                            <dt>Memo</dt>
                            <dd>@shortBio</dd>
                        </dl>
                    </div>
                }
                else
                {
                    <div class="export-panel">
                        <div class="panel-header">
                            <h2>@C("landingCreate")</h2>
                            <div class="export-actions">
                                <button type="button" class="ghost-button" @onclick="SaveLandingHtmlToServerAsync">@C("saveServer")</button>
                                <a class="ghost-button" download="card-landing.html" href="@LandingHtmlDataUrl">@C("saveHtml")</a>
                                <a class="ghost-button" download="contact.vcf" href="@VCardDataUrl">@C("mobileVcard")</a>
                                <a class="ghost-button" download="contact_windows.vcf" href="@WindowsVCardDataUrl">@C("windowsVcard")</a>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(landingPublishMessage))
                        {
                            <p class="@LandingPublishMessageClass">@landingPublishMessage</p>
                        }

                        <div class="theme-row" role="radiogroup" aria-label="@C("landingHtml")">
                            <button type="button" class="@ThemeClass("light")" @onclick='() => SetTheme("light")'>@C("themeLight")</button>
                            <button type="button" class="@ThemeClass("dark")" @onclick='() => SetTheme("dark")'>@C("themeDark")</button>
                            <button type="button" class="@ThemeClass("blue")" @onclick='() => SetTheme("blue")'>@C("themeBlue")</button>
                            <button type="button" class="@ThemeClass("green")" @onclick='() => SetTheme("green")'>@C("themeGreen")</button>
                        </div>

                        <div class="vcard-options" aria-label="vCard 공개 항목">
                            <label class="check-row compact">
                                <input type="checkbox" @bind="includePhoneInVCard" />
                                @C("includePhone")
                            </label>
                            <label class="check-row compact">
                                <input type="checkbox" @bind="includeAddressInVCard" />
                                @C("includeAddress")
                            </label>
                        </div>

                        <div class="landing-page-render @LandingThemeClass">
                            <section class="landing-card">
                                <div class="landing-logo" style="border-color:@accentColor">
                                    @if (string.IsNullOrWhiteSpace(logoImageDataUrl))
                                    {
                                        <span style="background:@accentColor"></span>
                                    }
                                    else
                                    {
                                        <img src="@logoImageDataUrl" alt="@backBrand logo" />
                                    }
                                </div>
                                <p class="eyebrow">@backBrand</p>
                                <h2>@name</h2>
                                <p>@role</p>
                                <a href="@LandingUrl" target="_blank">@LandingUrl</a>
                            </section>

                            <section class="landing-contact-grid">
                                <div>
                                    <dt>Email</dt>
                                    <dd>@email</dd>
                                </div>
                                <div>
                                    <dt>Phone</dt>
                                    <dd>@DisplayValue(phone)</dd>
                                </div>
                                <div>
                                    <dt>Company</dt>
                                    <dd>@backBrand</dd>
                                </div>
                                <div>
                                    <dt>Address</dt>
                                    <dd>@DisplayValue(address)</dd>
                                </div>
                                <div class="wide-field">
                                    <dt>Memo</dt>
                                    <dd>@landingDescription</dd>
                                </div>
                            </section>
                        </div>

                        <label>
                            @C("exportHtml")
                            <textarea rows="10" readonly>@LandingHtml</textarea>
                        </label>
                    </div>
                }
            </section>

            <section class="history-panel" aria-label="@C("historyLabel")">
                <div class="panel-header">
                    <h2>@C("history")</h2>
                    <button type="button" class="icon-button" title="@C("reset")" @onclick="ClearHistory">@C("reset")</button>
                </div>

                <div class="signin-box">
                    <span>@CurrentUserLabel</span>
                    <AuthorizeView>
                        <NotAuthorized>
                            <p class="signin-hint">
                                @C("guestHint")
                                <br />
                                @Dialog.SignInAction
                            </p>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>

                <label class="import-box">
                    @C("importCard")
                    <span class="localized-file-input">
                        <InputFile OnChange="OnImportSelectedAsync" multiple accept=".vcf,text/vcard,text/x-vcard,image/png,image/jpeg,image/webp,image/svg+xml,image/x-icon,image/vnd.microsoft.icon,.ico" />
                        <span class="localized-file-button">@C("chooseFile")</span>
                        <span class="localized-file-name">@(importFileName ?? C("noFileSelected"))</span>
                    </span>
                </label>

                @if (State.History.Count == 0)
                {
                    <p class="empty-text">@C("emptyHistory")</p>
                }
                else
                {
                    <div class="history-list">
                        @foreach (var entry in State.History)
                        {
                            <div class="history-item">
                                <button type="button" class="history-summary" title="@C("edit")" @onclick="() => LoadHistory(entry)">
                                    <strong>@entry.Profile.BackBrand</strong>
                                    <span>@entry.Profile.Name / @entry.Profile.Role</span>
                                    <small>@entry.CreatedAt.ToString("yyyy.MM.dd HH:mm")</small>
                                </button>
                                <div class="history-actions" aria-label="@C("historyLabel")">
                                    <button type="button" class="history-action-button" @onclick="() => LoadHistory(entry)">@C("edit")</button>
                                    <button type="button" class="history-action-button danger" @onclick="() => DeleteHistory(entry)">@C("delete")</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </section>
</main>

@code {
    private string C(string key) => CardHybridLocalization.Get(Text.Language, key);
    private CardHybridLocalization.DialogCopy Dialog => CardHybridLocalization.Dialog(Text.Language);
    private CardHybridState State => Session.State;
    private static readonly string[] FontOptions =
    [
        "Segoe UI",
        "Malgun Gothic",
        "맑은 고딕",
        "Arial",
        "Calibri",
        "Noto Sans KR",
        "Pretendard",
        "Gulim",
        "Batang"
    ];

    private string brand = string.Empty;
    private string tagline = string.Empty;
    private string backBrand = string.Empty;
    private string backTagline = string.Empty;
    private string category = string.Empty;
    private string name = string.Empty;
    private string role = string.Empty;
    private string email = string.Empty;
    private string phone = string.Empty;
    private string address = string.Empty;
    private string website = "https://codemaru.co.kr";
    private string landingHandle = string.Empty;
    private string accentColor = "#5d7f57";
    private string shortBio = string.Empty;
    private string landingDescription = string.Empty;
    private string vCardNote = string.Empty;
    private string internalMemo = string.Empty;
    private string? logoImageDataUrl;
    private string? logoFileName;
    private string? importFileName;
    private string? importedFrontImageDataUrl;
    private string? importedBackImageDataUrl;
    private byte[]? logoOriginalBytes;
    private string? logoOriginalContentType;
    private bool removeLogoBackground;
    private double cardWidthMm = 90;
    private double cardHeightMm = 50;
    private string frontFontFamily = "Segoe UI";
    private string backFontFamily = "Segoe UI";
    private double frontBrandFontSize = 28;
    private double frontTaglineFontSize = 18;
    private double frontCategoryFontSize = 18;
    private double frontEmailFontSize = 14;
    private double backBrandFontSize = 22;
    private double backTaglineFontSize = 14;
    private double backNameFontSize = 16;
    private double backRoleFontSize = 14;
    private string landingTheme = "light";
    private bool includePhoneInVCard;
    private bool includeAddressInVCard;
    private bool publishLandingOnSave = true;
    private bool showSaveOptionsPrompt;
    private string activePreviewTab = "card";
    private string lastSavedText = string.Empty;
    private string landingPublishMessage = string.Empty;
    private bool landingPublishMessageIsError;
    private Guid? editingHistoryId;

    private string CardStyle
    {
        get
        {
            var width = Clamp(cardWidthMm, 40, 140);
            var height = Clamp(cardHeightMm, 25, 90);

            return $"--card-width-mm:{width:0.##}; --card-height-mm:{height:0.##}; --card-ratio:{width:0.##} / {height:0.##}; --front-font:{CssString(frontFontFamily)}; --back-font:{CssString(backFontFamily)}; --front-brand-size:{Clamp(frontBrandFontSize, 10, 56):0.##}px; --front-tagline-size:{Clamp(frontTaglineFontSize, 10, 40):0.##}px; --front-category-size:{Clamp(frontCategoryFontSize, 10, 40):0.##}px; --front-email-size:{Clamp(frontEmailFontSize, 9, 28):0.##}px; --back-brand-size:{Clamp(backBrandFontSize, 10, 48):0.##}px; --back-tagline-size:{Clamp(backTaglineFontSize, 9, 32):0.##}px; --back-name-size:{Clamp(backNameFontSize, 10, 36):0.##}px; --back-role-size:{Clamp(backRoleFontSize, 9, 30):0.##}px;";
        }
    }

    private string LandingThemeClass => $"theme-{landingTheme}";
    private string LandingUrl => CreateProfile().LandingUrl;
    private string LandingHtml => Exporter.BuildHtml(CreateProfile(), LandingUrl);
    private string LandingHtmlDataUrl => $"data:text/html;charset=utf-8,{Uri.EscapeDataString(LandingHtml)}";
    private string VCardDataUrl => $"data:text/vcard;charset=utf-8,{Uri.EscapeDataString(Exporter.BuildVCard(CreateProfile()))}";
    private string WindowsVCardDataUrl => $"data:text/x-vcard;charset=us-ascii,{Uri.EscapeDataString(Exporter.BuildWindowsVCard(CreateProfile()))}";
    private string CardFrontSvgDataUrl => $"data:image/svg+xml;charset=utf-8,{Uri.EscapeDataString(Exporter.BuildCardSideSvg(CreateProfile(), State.QrSvg, true))}";
    private string CardBackSvgDataUrl => $"data:image/svg+xml;charset=utf-8,{Uri.EscapeDataString(Exporter.BuildCardSideSvg(CreateProfile(), State.QrSvg, false))}";
    private string SavedStatus => string.IsNullOrWhiteSpace(lastSavedText) ? C("notSaved") : lastSavedText;
    private string HistorySaveButtonText => C("saveHistory");
    private string LandingPublishMessageClass => landingPublishMessageIsError
        ? "publish-message error"
        : "publish-message";
    private bool IsImportedImageCard => !string.IsNullOrWhiteSpace(importedFrontImageDataUrl) ||
        !string.IsNullOrWhiteSpace(importedBackImageDataUrl);
    private string CurrentUserLabel => string.IsNullOrWhiteSpace(Session.CurrentUser.Email)
        ? C("guest")
        : Session.CurrentUser.DisplayName;

    private const string GuestStorageKey = "codemaru:cardhybrid:guest";
    private static readonly JsonSerializerOptions GuestJsonOptions = new(JsonSerializerDefaults.Web);

    private bool showMigrationPrompt;
    private CardHybridSnapshot? pendingGuestSnapshot;
    private bool guestStorageChecked;

    protected override async Task OnInitializedAsync()
    {
        Session.StateChanged += OnStateChanged;
        await Session.EnsureInitializedAsync();
        CopyFromProfile(State.Profile);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // JS interop 은 pre-render 이후에만 안전. localStorage 접근을 여기서 처리.
        if (!firstRender || guestStorageChecked)
        {
            return;
        }
        guestStorageChecked = true;

        try
        {
            var pendingJson = await JS.InvokeAsync<string?>("localStorage.getItem", GuestStorageKey);

            if (!Session.CurrentUser.IsGuest && !string.IsNullOrWhiteSpace(pendingJson))
            {
                var snapshot = JsonSerializer.Deserialize<CardHybridSnapshot>(pendingJson, GuestJsonOptions);
                if (snapshot?.Profile is not null)
                {
                    pendingGuestSnapshot = snapshot;
                    showMigrationPrompt = true;
                    StateHasChanged();
                }
            }
            else if (Session.CurrentUser.IsGuest && !string.IsNullOrWhiteSpace(pendingJson))
            {
                // Guest 상태 복구 (같은 브라우저에서 새로고침한 경우)
                var snapshot = JsonSerializer.Deserialize<CardHybridSnapshot>(pendingJson, GuestJsonOptions);
                if (snapshot?.Profile is not null)
                {
                    Session.ImportSnapshot(snapshot);
                }
            }
        }
        catch (Exception ex)
        {
            await Console.Error.WriteLineAsync($"[CardHybrid] guest snapshot restore failed: {ex.Message}");
        }
    }

    private async Task AcceptGuestMigrationAsync()
    {
        if (pendingGuestSnapshot is null)
        {
            showMigrationPrompt = false;
            return;
        }

        await Session.ReplaceUserSnapshotAsync(pendingGuestSnapshot);
        await JS.InvokeVoidAsync("localStorage.removeItem", GuestStorageKey);

        pendingGuestSnapshot = null;
        showMigrationPrompt = false;
        CopyFromProfile(State.Profile);
    }

    private async Task RejectGuestMigrationAsync()
    {
        pendingGuestSnapshot = null;
        showMigrationPrompt = false;
        await JS.InvokeVoidAsync("localStorage.removeItem", GuestStorageKey);
    }

    private async Task PersistGuestSnapshotAsync()
    {
        if (!Session.CurrentUser.IsGuest)
        {
            return;
        }

        try
        {
            var snapshot = Session.CaptureCurrentSnapshot();
            var json = JsonSerializer.Serialize(snapshot, GuestJsonOptions);
            await JS.InvokeVoidAsync("localStorage.setItem", GuestStorageKey, json);
        }
        catch (Exception ex)
        {
            await Console.Error.WriteLineAsync($"[CardHybrid] guest snapshot persist failed: {ex.Message}");
        }
    }

    private void ApplyProfile()
    {
        Session.UpdateProfile(CreateProfile());
    }

    private void OpenSaveOptionsPrompt()
    {
        showSaveOptionsPrompt = true;
    }

    private void CancelSaveOptions()
    {
        showSaveOptionsPrompt = false;
    }

    private async Task SaveHistoryWithOptionsAsync()
    {
        showSaveOptionsPrompt = false;

        var profile = SaveHistoryCore();
        if (profile is null || !publishLandingOnSave)
        {
            return;
        }

        await PublishLandingAsync(profile);
    }

    private CardProfile? SaveHistoryCore()
    {
        try
        {
            var profile = CreateProfile();
            if (editingHistoryId is { } historyId)
            {
                var updatedEntry = Session.UpdateHistory(historyId, profile);
                if (updatedEntry is not null)
                {
                    lastSavedText = $"{updatedEntry.CreatedAt:HH:mm:ss} 수정 저장";
                    editingHistoryId = null;
                    return updatedEntry.Profile;
                }

                editingHistoryId = null;
            }

            Session.UpdateProfile(profile);
            var entry = Session.SaveCurrent();
            lastSavedText = $"{entry.CreatedAt:HH:mm:ss} 저장";
            return entry.Profile;
        }
        catch (Exception ex)
        {
            editingHistoryId = null;
            lastSavedText = "저장 중 오류";
            Console.Error.WriteLine(ex);
            return null;
        }
    }

    private async Task SaveLandingHtmlToServerAsync()
    {
        var profile = CreateProfile();
        Session.UpdateProfile(profile);
        await PublishLandingAsync(profile);
    }

    private async Task PublishLandingAsync(CardProfile profile)
    {
        activePreviewTab = "landing";
        landingPublishMessage = string.Empty;

        try
        {
            var result = await Publisher.PublishIndexAsync(profile, Exporter.BuildHtml(profile, profile.LandingUrl));
            landingPublishMessageIsError = false;
            landingPublishMessage = $"서버 저장 완료: {result.PublicUrl}";
            lastSavedText = "랜딩 HTML 서버 저장";
        }
        catch (Exception ex)
        {
            landingPublishMessageIsError = true;
            landingPublishMessage = $"서버 저장 실패: {ex.Message}";
            lastSavedText = "랜딩 HTML 저장 실패";
            Console.Error.WriteLine(ex);
        }
    }

    private void LoadHistory(CardHistoryEntry entry)
    {
        editingHistoryId = entry.Id;
        Session.LoadHistory(entry);
        lastSavedText = $"{entry.CreatedAt:HH:mm} 이력 편집 중";
    }

    private void ClearHistory()
    {
        editingHistoryId = null;
        Session.ClearHistory();
        lastSavedText = "이력 초기화";
    }

    private void DeleteHistory(CardHistoryEntry entry)
    {
        if (Session.RemoveHistory(entry.Id))
        {
            if (editingHistoryId == entry.Id)
            {
                editingHistoryId = null;
            }

            lastSavedText = $"{entry.CreatedAt:HH:mm} 이력 삭제";
        }
    }

    private async Task OnImportSelectedAsync(InputFileChangeEventArgs args)
    {
        var files = args.GetMultipleFiles(10);
        importFileName = files.Count switch
        {
            0 => null,
            1 => files[0].Name,
            _ => $"{files[0].Name} +{files.Count - 1}"
        };
        if (files.Count == 0)
        {
            lastSavedText = "선택된 파일 없음";
            return;
        }

        var file = files[0];
        var extension = Path.GetExtension(file.Name);

        if (extension.Equals(".vcf", StringComparison.OrdinalIgnoreCase) ||
            file.ContentType.Contains("vcard", StringComparison.OrdinalIgnoreCase))
        {
            await ImportVCardAsync(file);
            return;
        }

        if (IsSupportedImageImport(file))
        {
            await ImportImagesAsync(files);
            return;
        }

        lastSavedText = "지원하지 않는 파일";
    }

    private async Task ImportVCardAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(maxAllowedSize: 4 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);

        var content = DecodeText(memory.ToArray());
        var profile = Importer.ImportVCard(content, CreateProfile());
        SaveImportedProfile(profile, $"{Path.GetFileName(file.Name)} 가져옴");
    }

    private async Task ImportImagesAsync(IReadOnlyList<IBrowserFile> files)
    {
        var imageFiles = files.Where(IsSupportedImageImport).Take(2).ToArray();
        var images = new List<(IBrowserFile File, string Name, string Side, string DataUrl)>();

        foreach (var imageFile in imageFiles)
        {
            var (name, side) = ParseCardImageFileName(imageFile.Name);
            images.Add((imageFile, name, side, await ReadImageDataUrlAsync(imageFile)));
        }

        if (images.Count == 0)
        {
            lastSavedText = "이미지 없음";
            return;
        }

        var displayName = images.Select(static image => image.Name)
            .FirstOrDefault(static value => !string.IsNullOrWhiteSpace(value)) ?? "Imported Card";
        var frontImage = images.FirstOrDefault(static image => image.Side == "front").DataUrl;
        var backImage = images.FirstOrDefault(static image => image.Side == "back").DataUrl;

        frontImage = string.IsNullOrWhiteSpace(frontImage) ? images[0].DataUrl : frontImage;
        if (string.IsNullOrWhiteSpace(backImage) && images.Count > 1)
        {
            backImage = images.First(image => image.DataUrl != frontImage).DataUrl;
        }

        var profile = CreateProfile() with
        {
            Brand = displayName,
            BackBrand = displayName,
            Name = displayName,
            Role = "이미지 명함",
            BackTagline = "가져온 명함 이미지",
            LogoImageDataUrl = null,
            RemoveLogoBackground = false,
            ImportedFrontImageDataUrl = frontImage,
            ImportedBackImageDataUrl = backImage
        };

        logoOriginalBytes = null;
        logoOriginalContentType = null;
        SaveImportedProfile(profile, string.IsNullOrWhiteSpace(backImage) ? $"{displayName} 앞면 저장" : $"{displayName} 앞/뒤 저장");
    }

    private void SaveImportedProfile(CardProfile profile, string message)
    {
        editingHistoryId = null;
        Session.UpdateProfile(profile);
        var entry = Session.SaveCurrent();
        CopyFromProfile(entry.Profile);
        lastSavedText = $"{entry.CreatedAt:HH:mm:ss} {message}";
    }

    private void SetTheme(string theme)
    {
        landingTheme = theme;
        ApplyProfile();
    }

    private CardProfile CreateProfile()
    {
        var handle = CardLandingPath.Slugify(landingHandle);
        if (string.IsNullOrWhiteSpace(handle))
        {
            handle = "me";
        }

        var landingSlug = CardLandingPath.NormalizeForTenant($"card/{handle}", Session.CurrentUser);

        return new CardProfile(
            Brand: brand,
            Tagline: tagline,
            BackBrand: backBrand,
            BackTagline: backTagline,
            Category: category,
            Name: name,
            Role: role,
            Email: email,
            Phone: phone,
            Address: address,
            Website: string.IsNullOrWhiteSpace(website) ? "https://codemaru.co.kr" : website.Trim(),
            LandingSlug: landingSlug,
            AccentColor: accentColor,
            ShortBio: shortBio,
            LandingDescription: landingDescription,
            VCardNote: vCardNote,
            InternalMemo: internalMemo,
            LogoImageDataUrl: logoImageDataUrl,
            RemoveLogoBackground: removeLogoBackground,
            CardWidthMm: Clamp(cardWidthMm, 40, 140),
            CardHeightMm: Clamp(cardHeightMm, 25, 90),
            FrontFontFamily: frontFontFamily,
            BackFontFamily: backFontFamily,
            FrontBrandFontSize: Clamp(frontBrandFontSize, 10, 56),
            FrontTaglineFontSize: Clamp(frontTaglineFontSize, 10, 40),
            FrontCategoryFontSize: Clamp(frontCategoryFontSize, 10, 40),
            FrontEmailFontSize: Clamp(frontEmailFontSize, 9, 28),
            BackBrandFontSize: Clamp(backBrandFontSize, 10, 48),
            BackTaglineFontSize: Clamp(backTaglineFontSize, 9, 32),
            BackNameFontSize: Clamp(backNameFontSize, 10, 36),
            BackRoleFontSize: Clamp(backRoleFontSize, 9, 30),
            LandingTheme: landingTheme,
            IncludePhoneInVCard: includePhoneInVCard,
            IncludeAddressInVCard: includeAddressInVCard,
            ImportedFrontImageDataUrl: importedFrontImageDataUrl,
            ImportedBackImageDataUrl: importedBackImageDataUrl);
    }

    private void CopyFromProfile(CardProfile profile)
    {
        brand = profile.Brand;
        tagline = profile.Tagline;
        backBrand = profile.BackBrand;
        backTagline = profile.BackTagline;
        category = profile.Category;
        name = profile.Name;
        role = profile.Role;
        email = profile.Email;
        phone = profile.Phone;
        address = profile.Address;
        website = string.IsNullOrWhiteSpace(profile.Website) ? "https://codemaru.co.kr" : profile.Website;
        landingHandle = ExtractLandingHandle(profile.LandingSlug);
        accentColor = profile.AccentColor;
        shortBio = profile.ShortBio;
        landingDescription = profile.LandingDescription;
        vCardNote = profile.VCardNote;
        internalMemo = profile.InternalMemo;
        logoImageDataUrl = profile.LogoImageDataUrl;
        importedFrontImageDataUrl = profile.ImportedFrontImageDataUrl;
        importedBackImageDataUrl = profile.ImportedBackImageDataUrl;
        removeLogoBackground = profile.RemoveLogoBackground;
        cardWidthMm = profile.CardWidthMm;
        cardHeightMm = profile.CardHeightMm;
        frontFontFamily = profile.FrontFontFamily;
        backFontFamily = profile.BackFontFamily;
        frontBrandFontSize = profile.FrontBrandFontSize;
        frontTaglineFontSize = profile.FrontTaglineFontSize;
        frontCategoryFontSize = profile.FrontCategoryFontSize;
        frontEmailFontSize = profile.FrontEmailFontSize;
        backBrandFontSize = profile.BackBrandFontSize;
        backTaglineFontSize = profile.BackTaglineFontSize;
        backNameFontSize = profile.BackNameFontSize;
        backRoleFontSize = profile.BackRoleFontSize;
        landingTheme = profile.LandingTheme;
        includePhoneInVCard = profile.IncludePhoneInVCard;
        includeAddressInVCard = profile.IncludeAddressInVCard;
    }

    private async Task OnLogoSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        logoFileName = file.Name;
        await using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);

        logoOriginalBytes = memory.ToArray();
        logoOriginalContentType = string.IsNullOrWhiteSpace(file.ContentType)
            ? "application/octet-stream"
            : file.ContentType;
        logoImageDataUrl = BackgroundRemover.CreateDataUrl(logoOriginalBytes, logoOriginalContentType, removeLogoBackground);
        ApplyProfile();
    }

    private Task OnRemoveBackgroundChangedAsync(ChangeEventArgs args)
    {
        removeLogoBackground = args.Value is bool value && value;

        if (logoOriginalBytes is not null && logoOriginalContentType is not null)
        {
            logoImageDataUrl = BackgroundRemover.CreateDataUrl(logoOriginalBytes, logoOriginalContentType, removeLogoBackground);
        }
        else if (!string.IsNullOrWhiteSpace(logoImageDataUrl) && TryReadDataUrl(logoImageDataUrl, out var bytes, out var contentType))
        {
            logoOriginalBytes = bytes;
            logoOriginalContentType = contentType;
            logoImageDataUrl = BackgroundRemover.CreateDataUrl(bytes, contentType, removeLogoBackground);
        }

        ApplyProfile();
        return Task.CompletedTask;
    }

    private void RemoveLogo()
    {
        logoImageDataUrl = null;
        logoOriginalBytes = null;
        logoOriginalContentType = null;
        removeLogoBackground = false;
        ApplyProfile();
    }

    private void OnStateChanged(object? sender, CardHybridState state)
    {
        CopyFromProfile(state.Profile);

        if (guestStorageChecked && Session.HasGuestChanges)
        {
            _ = PersistGuestSnapshotAsync();
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private static string ExtractLandingHandle(string landingSlug)
    {
        var segments = CardLandingPath.Split(landingSlug);
        if (segments.Length == 0)
        {
            return string.Empty;
        }

        return segments[^1];
    }

    private string TabClass(string tab)
    {
        return activePreviewTab == tab ? "tab-button active" : "tab-button";
    }

    private string ThemeClass(string theme)
    {
        return landingTheme == theme ? "theme-button active" : "theme-button";
    }

    private static string DisplayValue(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static double Clamp(double value, double min, double max)
    {
        return Math.Min(Math.Max(value, min), max);
    }

    private static string CssString(string value)
    {
        var safe = string.IsNullOrWhiteSpace(value) ? "Segoe UI" : value.Replace("'", string.Empty, StringComparison.Ordinal);
        return $"'{safe}'";
    }

    private static bool TryReadDataUrl(string dataUrl, out byte[] bytes, out string contentType)
    {
        bytes = [];
        contentType = "application/octet-stream";

        const string marker = ";base64,";
        var markerIndex = dataUrl.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (!dataUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase) || markerIndex < 0)
        {
            return false;
        }

        contentType = dataUrl[5..markerIndex];
        bytes = Convert.FromBase64String(dataUrl[(markerIndex + marker.Length)..]);
        return true;
    }

    private static bool IsSupportedImageImport(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name);
        return file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".svg", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".png", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".jpg", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".jpeg", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".webp", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".ico", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetImageContentType(IBrowserFile file)
    {
        if (!string.IsNullOrWhiteSpace(file.ContentType) &&
            file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            return file.ContentType;
        }

        return Path.GetExtension(file.Name).ToLowerInvariant() switch
        {
            ".svg" => "image/svg+xml",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".webp" => "image/webp",
            ".ico" => "image/x-icon",
            _ => "image/png"
        };
    }

    private static (string Name, string Side) ParseCardImageFileName(string fileName)
    {
        var name = Path.GetFileNameWithoutExtension(fileName).Trim();
        if (name.EndsWith("_front", StringComparison.OrdinalIgnoreCase))
        {
            return (name[..^"_front".Length].Trim(), "front");
        }

        if (name.EndsWith("_back", StringComparison.OrdinalIgnoreCase))
        {
            return (name[..^"_back".Length].Trim(), "back");
        }

        if (name.EndsWith("_앞면", StringComparison.OrdinalIgnoreCase) ||
            name.EndsWith("_앞", StringComparison.OrdinalIgnoreCase))
        {
            var marker = name.EndsWith("_앞면", StringComparison.OrdinalIgnoreCase) ? "_앞면" : "_앞";
            return (name[..^marker.Length].Trim(), "front");
        }

        if (name.EndsWith("_뒷면", StringComparison.OrdinalIgnoreCase) ||
            name.EndsWith("_뒤", StringComparison.OrdinalIgnoreCase))
        {
            var marker = name.EndsWith("_뒷면", StringComparison.OrdinalIgnoreCase) ? "_뒷면" : "_뒤";
            return (name[..^marker.Length].Trim(), "back");
        }

        return (name, string.Empty);
    }

    private static async Task<string> ReadImageDataUrlAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);

        return $"data:{GetImageContentType(file)};base64,{Convert.ToBase64String(memory.ToArray())}";
    }

    private static string DecodeText(byte[] bytes)
    {
        if (bytes.Length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF)
        {
            return Encoding.UTF8.GetString(bytes, 3, bytes.Length - 3);
        }

        if (bytes.Length >= 2 && bytes[0] == 0xFF && bytes[1] == 0xFE)
        {
            return Encoding.Unicode.GetString(bytes, 2, bytes.Length - 2);
        }

        if (bytes.Length >= 2 && bytes[0] == 0xFE && bytes[1] == 0xFF)
        {
            return Encoding.BigEndianUnicode.GetString(bytes, 2, bytes.Length - 2);
        }

        return Encoding.UTF8.GetString(bytes);
    }

    public void Dispose()
    {
        Session.StateChanged -= OnStateChanged;
    }
}
