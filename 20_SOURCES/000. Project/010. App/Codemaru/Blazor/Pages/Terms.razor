@page "/terms"
@namespace Codemaru.Blazor.Pages
@inject SiteLocalization Text

<PageTitle>@Document.Title | CodeMaru</PageTitle>
<SeoHead Title="@($"{Document.Title} | CodeMaru")"
         Description="@Document.Description"
         CanonicalPath="/terms"
         Type="article"
         ImageAlt="@Document.Title" />

<section class="cm-legal">
    <h1>@Document.Title</h1>
    <p class="cm-legal-date">@Document.Updated</p>
    @foreach (var legalSection in Document.Sections)
    {
        <div class="cm-legal-block">
            <h2>@legalSection.Heading</h2>
            @if (legalSection.Paragraph is not null)
            {
                <p>@legalSection.Paragraph</p>
            }
            @if (legalSection.Items is not null)
            {
                <ul>
                    @foreach (var item in legalSection.Items)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
            @if (legalSection == Document.Sections[^1])
            {
                <p><a href="mailto:admin@codemaru.co.kr">admin@codemaru.co.kr</a></p>
            }
        </div>
    }
</section>

@code {
    private LegalDocument Document => LegalLocalization.Terms(Text.Language);
}
