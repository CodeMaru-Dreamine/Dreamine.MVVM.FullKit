@page "/"
@namespace Codemaru.Blazor.Pages
@inject SiteLocalization Text

<PageTitle>CodeMaru — @Plain(Text["home.title"])</PageTitle>
<SeoHead Title="@($"CodeMaru — {Plain(Text["home.title"])}")"
         Description="@Plain(Text["home.lead"])"
         CanonicalPath="/"
         ImageAlt="@Text["services.title"]" />

<section class="cm-home-hero">
    <div class="cm-home-copy">
        <p class="cm-home-kicker">@Text["home.kicker"]</p>
        <h1>@AsHtml(Text["home.title"])</h1>
        <p>@AsHtml(Text["home.lead"])</p>
        <div class="cm-home-actions">
            <a class="cm-home-primary" href="#services">@Text["home.services"] <i class="fa-solid fa-arrow-right"></i></a>
            <a class="cm-home-secondary" href="/about">@Text["home.about"]</a>
        </div>
    </div>
    <img class="cm-home-hero-art" src="/img/codemaru-hero-v2.png" alt="@Text["services.title"]" />
</section>

<section class="cm-home-values" aria-label="CodeMaru 운영 원칙">
    <article><i class="fa-solid fa-code"></i><div><strong>@Text["value.design.title"]</strong><span>@Text["value.design.text"]</span></div></article>
    <article><i class="fa-solid fa-check"></i><div><strong>@Text["value.run.title"]</strong><span>@Text["value.run.text"]</span></div></article>
    <article><i class="fa-solid fa-arrow-trend-up"></i><div><strong>@Text["value.improve.title"]</strong><span>@Text["value.improve.text"]</span></div></article>
</section>

<header id="services" class="cm-section-heading">
    <h2>@Text["services.title"]</h2>
    <p>@Text["services.lead"]</p>
</header>

