<section id="about" class="cm-maker">
    <div class="cm-maker-copy">
        <p class="cm-home-kicker">About CodeMaru</p>
        <h2>@AsHtml(Text["about.title"])</h2>
        <p>@Text["about.lead"]</p>
        <div class="cm-maker-links">
            <a href="/about">@Text["home.about"]</a>
            <a href="https://github.com/CodeMaru-Dreamine" target="_blank" rel="noopener"><i class="fa-brands fa-github"></i> GitHub</a>
        </div>
    </div>
    <img class="cm-maker-art" src="/img/codemaru-about-v2.png" alt="@Text["about"]" />
</section>

@code {
    private static string Plain(string value) => value.Replace("\n", " ", StringComparison.Ordinal);
    private static MarkupString AsHtml(string value) =>
        new(value.Replace("\n", "<br />", StringComparison.Ordinal));

    private static string PreviewSrc(string key, string fallback)
    {
        var path = Path.Combine(AppContext.BaseDirectory, "wwwroot", "img", "previews", $"{key}.jpg");
        return File.Exists(path)
            ? $"img/previews/{key}.jpg?v={File.GetLastWriteTime(path).Ticks}"
            : fallback;
    }
}
