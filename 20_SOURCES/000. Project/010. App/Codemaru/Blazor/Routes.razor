@namespace Codemaru.Blazor
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@inject SiteLocalization Text

<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <LayoutView Layout="@typeof(MainLayout)">
                    <main class="cm-not-authorized">
                        <i class="fa-solid fa-lock"></i>
                        <AuthorizeView Context="accessContext">
                            <Authorized>
                                <h1>@Copy.AdminRequired</h1>
                                <p>@Copy.AdminRequiredDetail</p>
                                <a href="/">@Copy.Home</a>
                            </Authorized>
                            <NotAuthorized>
                                <h1>@Copy.SignInRequired</h1>
                                <p>@Copy.SignInRequiredDetail</p>
                                <a href="/login?returnUrl=%2Fadmin">@Copy.SignIn</a>
                            </NotAuthorized>
                        </AuthorizeView>
                    </main>
                </LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <PageTitle>@Copy.NotFound | CodeMaru</PageTitle>
        <HeadContent>
            <meta name="robots" content="noindex, follow" />
        </HeadContent>
        <LayoutView Layout="@typeof(MainLayout)">
            <main class="cm-not-found">
                <p class="cm-not-found-code">404</p>
                <h1>@Copy.NotFound</h1>
                <p>@Copy.NotFoundDetail</p>
                <div class="cm-not-found-actions">
                    <a href="/">@Copy.Home</a>
                    <a href="/guide">@Copy.Guides</a>
                </div>
            </main>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private RouteCopy Copy => RouteLocalization.Get(Text.Language);
}
