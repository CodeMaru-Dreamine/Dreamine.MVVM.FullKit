<Window
    x:Class="Codemaru.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="clr-namespace:Dreamine.Hybrid.Wpf.Converters;assembly=Dreamine.Hybrid.Wpf"
    xmlns:util="clr-namespace:Dreamine.Hybrid.Wpf.Utility;assembly=Dreamine.Hybrid.Wpf"
    mc:Ignorable="d"
    Title="{Binding Title}"
    Width="1220"
    Height="760"
    MinWidth="980"
    MinHeight="620"
    d:DesignWidth="1220"
    d:DesignHeight="760">
    <Grid Background="#F4F6F3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D9E0D6" BorderThickness="0,0,1,0" Padding="20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#243126" Text="Codemaru" />
                    <TextBlock Margin="0,8,0,20" Foreground="#667067" TextWrapping="Wrap" Text="명함(CardHybrid) · SSL 인증서 관리 등 CodeMaru 운영 도구 모음입니다. CCTV 에이전트(DreamineVMS)는 카메라가 연결된 PC에 별도 설치가 필요합니다." />

                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#6B746C" Text="현재 카드" />
                    <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#1F2B21" Text="{Binding Brand}" />
                    <TextBlock Margin="0,2,0,0" Foreground="#475247" Text="{Binding OwnerName}" />
                    <TextBlock Margin="0,8,0,0" Foreground="#475247" TextWrapping="Wrap" Text="{Binding LandingUrl}" />

                    <Border Margin="0,18,0,0" Padding="12" Background="#EEF3EB" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#607062" Text="상태" />
                            <TextBlock Margin="0,6,0,0" Foreground="#607062" Text="{Binding CurrentUser, StringFormat=사용자 {0}}" />
                            <TextBlock Margin="0,6,0,0" Foreground="#263228" Text="{Binding StatusMessage}" />
                            <TextBlock Margin="0,8,0,0" Foreground="#607062" Text="{Binding HistoryCount, StringFormat=저장된 이력 {0}개}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox Margin="0,20,0,0" BorderBrush="#DDE4DA" ItemsSource="{Binding Logs}" />
            </DockPanel>
        </Border>

        <TabControl Grid.Column="1" Margin="14" SelectedIndex="0">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F5F7FB">
                    <StackPanel Margin="28">
                        <TextBlock Foreground="#0891B2" FontSize="12" FontWeight="Bold" Text="CODEMARU OPERATIONS" />
                        <TextBlock Margin="0,6,0,4" Foreground="#14213D" FontSize="30" FontWeight="Bold" Text="운영 대시보드" />
                        <TextBlock Foreground="#52627A" FontSize="14" Text="CodeMaru 서비스와 로컬 운영 도구의 현재 구성을 확인합니다." />

                        <UniformGrid Margin="0,24,0,0" Columns="4">
                            <Border Margin="0,0,10,0" Padding="18" Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="12">
                                <StackPanel><TextBlock Foreground="#64748B" Text="연결된 서비스" /><TextBlock Margin="0,8,0,0" Foreground="#14213D" FontSize="25" FontWeight="Bold" Text="8" /></StackPanel>
                            </Border>
                            <Border Margin="0,0,10,0" Padding="18" Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="12">
                                <StackPanel><TextBlock Foreground="#64748B" Text="CardHybrid" /><TextBlock Margin="0,8,0,0" Foreground="#16845B" FontSize="19" FontWeight="Bold" Text="실행 중" /></StackPanel>
                            </Border>
                            <Border Margin="0,0,10,0" Padding="18" Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="12">
                                <StackPanel><TextBlock Foreground="#64748B" Text="공통 인증" /><TextBlock Margin="0,8,0,0" Foreground="#16845B" FontSize="19" FontWeight="Bold" Text="연결됨" /></StackPanel>
                            </Border>
                            <Border Padding="18" Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="12">
                                <StackPanel><TextBlock Foreground="#64748B" Text="저장된 명함" /><TextBlock Margin="0,8,0,0" Foreground="#14213D" FontSize="25" FontWeight="Bold" Text="{Binding HistoryCount}" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="22" Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Foreground="#14213D" FontSize="18" FontWeight="Bold" Text="관리 도구" />
                                    <TextBlock Margin="0,5,0,18" Foreground="#64748B" Text="상단 탭에서 필요한 운영 화면으로 이동하세요." />
                                    <Border Margin="0,0,0,10" Padding="14" Background="#F1F7FF" CornerRadius="8"><DockPanel><TextBlock Foreground="#1D4ED8" FontWeight="Bold" Text="CardHybrid Server" /><TextBlock DockPanel.Dock="Right" Foreground="#16845B" Text="웹 서버 화면" /></DockPanel></Border>
                                    <Border Margin="0,0,0,10" Padding="14" Background="#F1F7FF" CornerRadius="8"><DockPanel><TextBlock Foreground="#1D4ED8" FontWeight="Bold" Text="Embedded" /><TextBlock DockPanel.Dock="Right" Foreground="#16845B" Text="로컬 편집 화면" /></DockPanel></Border>
                                    <Border Padding="14" Background="#F1F7FF" CornerRadius="8"><DockPanel><TextBlock Foreground="#1D4ED8" FontWeight="Bold" Text="Certificate" /><TextBlock DockPanel.Dock="Right" Foreground="#16845B" Text="SSL · Caddy 관리" /></DockPanel></Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="22" Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Foreground="#14213D" FontSize="18" FontWeight="Bold" Text="현재 명함" />
                                    <TextBlock Margin="0,18,0,0" Foreground="#64748B" Text="브랜드" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#14213D" FontSize="20" FontWeight="Bold" Text="{Binding Brand}" />
                                    <TextBlock Margin="0,16,0,0" Foreground="#64748B" Text="사용자" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#14213D" FontWeight="SemiBold" Text="{Binding CurrentUser}" />
                                    <TextBlock Margin="0,16,0,0" Foreground="#64748B" Text="상태" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#16845B" FontWeight="SemiBold" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="CardHybrid Server" x:Name="ServerTab">
                <Border Background="#303530" Padding="14"
                        d:Visibility="Visible"
                        Visibility="{Binding Source={x:Static util:DesignTimeGuard.IsInDesignMode},
                                             Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <TextBlock Foreground="White" Text="Design-time preview placeholder." />
                </Border>
            </TabItem>
            <TabItem Header="Embedded" x:Name="EmbeddedTab">
                <Border Background="#303530" Padding="14"
                        d:Visibility="Visible"
                        Visibility="{Binding Source={x:Static util:DesignTimeGuard.IsInDesignMode},
                                             Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <TextBlock Foreground="White" Text="Embedded Blazor preview placeholder." />
                </Border>
            </TabItem>
            <TabItem Header="Certificate">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0b1120" DataContext="{Binding CertificateMonitor}">
                    <Grid Margin="24" Background="#0b1120">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#e5e7eb" Text="Certificate Monitor" />
                            <TextBlock Margin="0,6,0,0" Foreground="#9ca3af" Text="win-acme 인증서 남은 기간, 자동 갱신 작업, Caddy 설정 검증 및 graceful reload 상태를 확인합니다." />
                        </StackPanel>

                        <Border Grid.Row="1" Margin="0,0,0,16" Padding="16" Background="#111827" BorderBrush="#1f2937" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Certificate Folder" />
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" Text="{Binding CertificateDirectory, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="wacs.exe" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" Text="{Binding WacsPath, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="caddy.exe" />
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" Text="{Binding CaddyPath, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Caddy Config" />
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" Text="{Binding CaddyConfigPath, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Caddy Working Dir" />
                                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" Text="{Binding CaddyWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Config Adapter" />
                                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,16,8" Text="{Binding CaddyConfigAdapter, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,0,8,8" Foreground="#9ca3af" Text="Admin API (optional)" />
                                <TextBox Grid.Row="5" Grid.Column="3" Margin="0,0,0,8" Text="{Binding CaddyAdminAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Reload Mode" />
                                <CheckBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"
                                          Foreground="#d1d5db"
                                          IsChecked="{Binding CaddyForceReload}"
                                          Content="Force module reprovisioning (reload renewed certificate files)" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,0" Foreground="#9ca3af" Text="Thresholds" />
                                <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <TextBlock Margin="0,4,8,0" Foreground="#9ca3af" Text="Warning Days" />
                                    <TextBox Width="80" Margin="0,0,16,0" Text="{Binding WarningDays, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,4,8,0" Foreground="#9ca3af" Text="Critical Days" />
                                    <TextBox Width="80" Margin="0,0,16,0" Text="{Binding CriticalDays, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Width="120" Margin="0,0,8,0" Command="{Binding SaveSettingsCommand}" Content="Save Settings" />
                                    <Button Width="100" Command="{Binding RefreshCommand}" Content="Refresh" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Padding="16" Background="#111827" BorderBrush="#1f2937" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#e5e7eb" Text="Certificate Status" />
                                        <TextBlock DockPanel.Dock="Right" FontSize="16" FontWeight="Bold" Foreground="{Binding HealthBrush}" Text="{Binding HealthText}" />
                                    </DockPanel>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Remaining" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Foreground="#e5e7eb" Text="{Binding RemainingDaysText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Expires" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Foreground="#e5e7eb" Text="{Binding NotAfterText}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Certificate" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Foreground="#d1d5db" Text="{Binding CertificatePath}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Subject" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Foreground="#d1d5db" Text="{Binding Subject}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,0" Foreground="#9ca3af" Text="Issuer" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="#d1d5db" Text="{Binding Issuer}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Padding="16" Background="#111827" BorderBrush="#1f2937" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#e5e7eb" Text="win-acme Renewal" />
                                        <Button DockPanel.Dock="Right" Width="120" Command="{Binding CheckRenewalTaskCommand}" Content="Check Task" />
                                    </DockPanel>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Task" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Foreground="#e5e7eb" Text="{Binding TaskName}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="State" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Foreground="#e5e7eb" Text="{Binding TaskState}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Last Run" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Foreground="#d1d5db" Text="{Binding LastRunTime}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" Foreground="#9ca3af" Text="Next Run" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Foreground="#d1d5db" Text="{Binding NextRunTime}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,0" Foreground="#9ca3af" Text="Last Result" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="#d1d5db" Text="{Binding LastTaskResult}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3" Margin="0,0,0,16" Padding="16" Background="#111827" BorderBrush="#1f2937" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#e5e7eb" Text="Actions" />
                                <TextBlock Margin="0,6,0,12" Foreground="#f59e0b" Text="Force Renew는 발급 제한에 걸릴 수 있으므로 테스트 중 반복 실행하지 마십시오." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Width="130" Height="34" Margin="0,0,8,0" Command="{Binding RunRenewCommand}" Content="Run Renew" />
                                    <Button Width="130" Height="34" Margin="0,0,8,0" Command="{Binding ForceRenewCommand}" Content="Force Renew" />
                                    <Button Width="130" Height="34" Command="{Binding ReloadCaddyCommand}" Content="Reload Caddy" />
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" Foreground="#d1d5db" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" Padding="16" Background="#111827" BorderBrush="#1f2937" BorderThickness="1" CornerRadius="10">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" FontSize="18" FontWeight="SemiBold" Foreground="#e5e7eb" Text="Command Output" />
                                <TextBox MinHeight="180" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0b1120" Foreground="#d1d5db" BorderBrush="#374151" Text="{Binding CommandOutput, Mode=OneWay}" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
