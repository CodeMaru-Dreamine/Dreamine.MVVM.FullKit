@page "/{Slug}"
@namespace WeddingThankYou.Blazor.Pages
@using System.Diagnostics.CodeAnalysis
@inject NavigationManager Nav

@*!
  \file SlugRedirect.razor
  \brief Invite 페이지가 없으므로 /{Slug} 진입 시 /{Slug}/thankyou 로 리다이렉트.
*@

@code {
    [Parameter] public string Slug { get; set; } = "";

    [SuppressMessage("Security", "S5146", Justification = "The redirect target is a same-origin relative path built only after strict lowercase slug validation and URI escaping.")]
    protected override void OnInitialized()
    {
        Nav.NavigateTo(GetCanonicalRedirectPath(Slug), replace: true);
    }

    private static string GetCanonicalRedirectPath(string slug)
    {
        if (!IsValidSlug(slug))
            return "/";

        return $"/{Uri.EscapeDataString(slug)}/thankyou";
    }

    private static bool IsValidSlug(string slug)
    {
        if (slug.Length is < 2 or > 64 ||
            slug[0] == '-' ||
            slug[^1] == '-' ||
            slug is "admin" or "superadmin")
        {
            return false;
        }

        return slug.All(c => c is >= 'a' and <= 'z' or >= '0' and <= '9' or '-');
    }
}
