    private async Task ResetHeroPanel(string target, bool mobile)
    {
        var position = ResolveHeroPanelPlacement(target);
        if (position is null) return;

        if (mobile)
        {
            position.MobileX = null;
            position.MobileY = null;
        }
        else
        {
            position.DesktopX = null;
            position.DesktopY = null;
        }

        await Vm.SaveConfigAsync();
        await ReloadPreview();
    }

    private async Task AlignHeroPanel(string target, bool mobile)
    {
        var position = ResolveHeroPanelPlacement(target);
        if (position is null) return;

        SnapFloatingPosition(position, mobile);
        await Vm.SaveConfigAsync();
        await ReloadPreview();
    }

    [JSInvokable]
    public async Task OnPreviewElementMoved(string target, double xPercent, double yPercent, string viewport)
    {
        if (Vm.Config is null) return;
        var isMobile = string.Equals(viewport, "mobile", StringComparison.OrdinalIgnoreCase);
        switch (target)
        {
            case "music":
                SetFloatingPosition(Vm.Config.MusicButtonPlacement, xPercent, yPercent, isMobile);
                Vm.Config.MusicButtonPosition = "custom";
                break;
            case "heroThankYou":
                SetFloatingPosition(Vm.Config.HeroPanelPlacement, xPercent, yPercent, isMobile);
                break;
            case "heroTop":
                SetFloatingPosition(Vm.Config.HeroTopPanelPlacement, xPercent, yPercent, isMobile);
                break;
            case "heroBottom":
                SetFloatingPosition(Vm.Config.HeroBottomPanelPlacement, xPercent, yPercent, isMobile);
                break;
            default:
                return;
        }

        await Vm.SaveConfigAsync();
        await ReloadPreview();
        StateHasChanged();
    }

    private static void SetFloatingPosition(WeddingFloatingPosition position, double xPercent, double yPercent, bool mobile)
    {
        if (mobile)
        {
            position.MobileX = ClampPercent(xPercent);
            position.MobileY = ClampPercent(yPercent);
        }
        else
        {
            position.DesktopX = ClampPercent(xPercent);
            position.DesktopY = ClampPercent(yPercent);
        }
    }

    private static void SnapFloatingPosition(WeddingFloatingPosition position)
    {
        if (position.HasDesktop)
        {
            position.DesktopX = SnapPercent(position.DesktopX!.Value);
            position.DesktopY = SnapPercent(position.DesktopY!.Value);
        }
        if (position.HasMobile)
        {
            position.MobileX = SnapPercent(position.MobileX!.Value);
            position.MobileY = SnapPercent(position.MobileY!.Value);
        }
    }

    private static void SnapFloatingPosition(WeddingFloatingPosition position, bool mobile)
    {
        if (mobile)
        {
            if (!position.HasMobile) return;
            position.MobileX = SnapPercent(position.MobileX!.Value);
            position.MobileY = SnapPercent(position.MobileY!.Value);
            return;
        }

        if (!position.HasDesktop) return;
        position.DesktopX = SnapPercent(position.DesktopX!.Value);
        position.DesktopY = SnapPercent(position.DesktopY!.Value);
    }

    private WeddingFloatingPosition? ResolveHeroPanelPlacement(string target)
    {
        if (Vm.Config is null) return null;
        return target switch
        {
            "heroTop" => Vm.Config.HeroTopPanelPlacement,
            "heroBottom" => Vm.Config.HeroBottomPanelPlacement,
            _ => null,
        };
    }

    private static double SnapPercent(double value)
    {
        var anchors = new[] { 15d, 50d, 85d };
        return anchors.OrderBy(x => Math.Abs(x - value)).First();
    }

    private static double ClampPercent(double value) => Math.Clamp(value, 0, 100);

    private string FormatFloatingPosition(WeddingFloatingPosition position)
    {
        var mobileLabel = Text["admin.preview.phone"];
        var defaultLabel = Text["admin.media.default.position"];
        var mobile = position.HasMobile ? $"{mobileLabel} {position.MobileX:0.#}%, {position.MobileY:0.#}%" : $"{mobileLabel} · {defaultLabel}";
        var desktop = position.HasDesktop ? $"PC {position.DesktopX:0.#}%, {position.DesktopY:0.#}%" : $"PC · {defaultLabel}";
        return $"{desktop} · {mobile}";
    }

    private RenderFragment HeroPositionControl(string target, string title, WeddingFloatingPosition position) => @<div class="w-drag-control-card">
        <strong>@title</strong>
        <div class="w-drag-control-device">
            <span><b>PC</b> @FormatFloatingPosition(position, false)</span>
            <div>
                <button type="button" class="w-btn w-btn--sm" @onclick='() => SetPreviewMode("pc")'>@Text["admin.hero.position.drag"]</button>
                <button type="button" class="w-btn w-btn--sm" @onclick="() => AlignHeroPanel(target, false)">@Text["common.align"]</button>
                <button type="button" class="w-btn w-btn--sm" @onclick="() => ResetHeroPanel(target, false)">@Text["common.reset"]</button>
            </div>
        </div>
        <div class="w-drag-control-device">
            <span><b>@Text["admin.preview.phone"]</b> @FormatFloatingPosition(position, true)</span>
            <div>
                <button type="button" class="w-btn w-btn--sm" @onclick='() => SetPreviewMode("phone")'>@Text["admin.hero.position.drag"]</button>
                <button type="button" class="w-btn w-btn--sm" @onclick="() => AlignHeroPanel(target, true)">@Text["common.align"]</button>
                <button type="button" class="w-btn w-btn--sm" @onclick="() => ResetHeroPanel(target, true)">@Text["common.reset"]</button>
            </div>
        </div>
    </div>;

    private string FormatFloatingPosition(WeddingFloatingPosition position, bool mobile)
    {
        var defaultLabel = Text["admin.media.default.position"];
        if (mobile)
            return position.HasMobile ? $"{position.MobileX:0.#}%, {position.MobileY:0.#}%" : defaultLabel;
        return position.HasDesktop ? $"{position.DesktopX:0.#}%, {position.DesktopY:0.#}%" : defaultLabel;
    }

