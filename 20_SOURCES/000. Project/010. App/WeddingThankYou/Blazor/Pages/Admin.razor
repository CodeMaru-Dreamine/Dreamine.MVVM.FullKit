    private static readonly HashSet<string> _defaultLabels =
        ["신랑", "신부", "신랑 아버지", "신랑 어머니", "신부 아버지", "신부 어머니"];

    private readonly object _uploadTickerSync = new();
    private int _uploadElapsedSec;
    private int _uploadRunActive;
    private bool _disposed;
    private System.Threading.CancellationTokenSource? _uploadTickCts;

    private async Task SelectSection(string key)
    {
        if (string.Equals(_selected, key, StringComparison.OrdinalIgnoreCase)) return;

        if ((key == "story" && !IsStoryLayout) || (key == "photobook" && !IsPhotoBookLayout) || (key == "cards" && !IsCardLayout))
        {
            _selected = "design";
            _navOpen = false;
            return;
        }

        if (Vm.Config is not null)
        {
            await Vm.SaveConfigAsync();
        }

        _selected = key;
        _navOpen = false;
    }

    /// <summary>현재 설정에 반영된 감사장 레이아웃 모드 (Admin UI 활성 카드 표시에 사용).</summary>
    private WeddingLayoutMode CurrentLayoutMode =>
        ThankYouDesignCatalog.ResolveLayoutMode(Vm.Config?.ThankYouStyle);
    private WeddingLayoutOption? SelectedLayoutOption => WeddingLayoutCatalog.Instance.Find(_layoutCandidateMode ?? CurrentLayoutMode);
    private IEnumerable<WeddingLayoutOption> FilteredLayoutOptions => WeddingLayoutCatalog.Options.Where(x =>
        string.IsNullOrWhiteSpace(_layoutSearch) ||
        LocalizedLayoutLabel(x).Contains(_layoutSearch, StringComparison.CurrentCultureIgnoreCase) ||
        LocalizedLayoutDescription(x).Contains(_layoutSearch, StringComparison.CurrentCultureIgnoreCase));
    private void ChooseLayout(WeddingLayoutOption option)
    {
        _layoutCandidateMode = option.Mode;
        _layoutPickerOpen = false;
        _layoutSearch = "";
    }
    private void ApplySelectedLayout()
    {
        if (SelectedLayoutOption is not { } selected) return;
        SelectLayout(selected.Mode);
        _layoutCandidateMode = null;
    }
    private bool CurrentHeroCropUsesFullImage =>
        _heroCropViewport == "mobile" ? _heroCropMobileFull : _heroCropDesktopFull;
    private HeroImageCropRegion CurrentHeroCropDraft =>
        _heroCropViewport == "mobile" ? _heroCropMobileDraft : _heroCropDesktopDraft;
    private double CurrentHeroCropAspect =>
        _heroCropViewport == "mobile"
            ? (double)CurrentPreviewDevice.Width / CurrentPreviewDevice.Height
            : 16d / 9d;
    private string HeroCropEditorKey => $"{_heroCropViewport}:{_heroCropEditorRevision}";

    private void OpenHeroCropEditor()
    {
        if (Vm.Config is null) return;
        _heroCropDesktopFull = !string.Equals(Vm.Config.HeroDesktopFit, "cover", StringComparison.OrdinalIgnoreCase);
        _heroCropMobileFull = !string.Equals(Vm.Config.HeroMobileFit, "cover", StringComparison.OrdinalIgnoreCase);
        _heroCropDesktopDraft = CloneCrop(Vm.Config.HeroDesktopCrop);
        _heroCropMobileDraft = CloneCrop(Vm.Config.HeroMobileCrop);
        _heroCropViewport = _previewMode == "pc" ? "desktop" : "mobile";
        _heroCropEditorOpen = true;
        QueueHeroCropEditorInit();
    }

    private void CloseHeroCropEditor()
    {
        _heroCropEditorOpen = false;
        _heroCropEditorNeedsInit = false;
    }

    private void SetHeroCropViewport(string viewport)
    {
        _heroCropViewport = viewport == "desktop" ? "desktop" : "mobile";
        _previewMode = _heroCropViewport == "desktop" ? "pc" : "phone";
        QueueHeroCropEditorInit();
    }

    private void SetHeroCropMode(bool useFullImage)
    {
        if (_heroCropViewport == "mobile") _heroCropMobileFull = useFullImage;
        else _heroCropDesktopFull = useFullImage;
        QueueHeroCropEditorInit();
    }

    private void QueueHeroCropEditorInit()
    {
        _heroCropEditorRevision++;
        _heroCropEditorNeedsInit = _heroCropEditorOpen && !CurrentHeroCropUsesFullImage;
    }

    [JSInvokable]
    public void OnHeroCropDraftChanged(string viewport, double x, double y, double width, double height)
    {
        var draft = new HeroImageCropRegion { X = x, Y = y, Width = width, Height = height };
        NormalizeCropDraft(draft);
        if (string.Equals(viewport, "mobile", StringComparison.OrdinalIgnoreCase)) _heroCropMobileDraft = draft;
        else _heroCropDesktopDraft = draft;
    }

    private async Task ApplyHeroCropEditor()
    {
        if (Vm.Config is null) return;
        Vm.Config.HeroDesktopFit = _heroCropDesktopFull ? "contain" : "cover";
        Vm.Config.HeroMobileFit = _heroCropMobileFull ? "contain" : "cover";
        Vm.Config.HeroDesktopCrop = CloneCrop(_heroCropDesktopDraft);
        Vm.Config.HeroMobileCrop = CloneCrop(_heroCropMobileDraft);
        Vm.Config.HeroDesktopFocusX = Vm.Config.HeroDesktopCrop.X + Vm.Config.HeroDesktopCrop.Width / 2;
        Vm.Config.HeroDesktopFocusY = Vm.Config.HeroDesktopCrop.Y + Vm.Config.HeroDesktopCrop.Height / 2;
        Vm.Config.HeroMobileFocusX = Vm.Config.HeroMobileCrop.X + Vm.Config.HeroMobileCrop.Width / 2;
        Vm.Config.HeroMobileFocusY = Vm.Config.HeroMobileCrop.Y + Vm.Config.HeroMobileCrop.Height / 2;
        await OnSaveConfig();
        CloseHeroCropEditor();
    }

    private static HeroImageCropRegion CloneCrop(HeroImageCropRegion? source) => new()
    {
        X = source?.X ?? 0,
        Y = source?.Y ?? 0,
        Width = source?.Width ?? 100,
        Height = source?.Height ?? 100,
    };

    private static void NormalizeCropDraft(HeroImageCropRegion crop)
    {
        crop.X = Math.Clamp(double.IsFinite(crop.X) ? crop.X : 0, 0, 95);
        crop.Y = Math.Clamp(double.IsFinite(crop.Y) ? crop.Y : 0, 0, 95);
        crop.Width = Math.Clamp(double.IsFinite(crop.Width) ? crop.Width : 100, 5, 100 - crop.X);
        crop.Height = Math.Clamp(double.IsFinite(crop.Height) ? crop.Height : 100, 5, 100 - crop.Y);
    }
    private void SelectCustomTheme()
    {
        if (Vm.Config is null || !Vm.Config.HasPremiumPlan) return;
        ActivateCustomTheme();
    }

    private void OnThemeBaseColorChanged(ChangeEventArgs e)
    {
        if (Vm.Config is null
            || !Vm.Config.HasPremiumPlan
            || !WeddingThemePaletteGenerator.TryNormalizeHexColor(
                e.Value?.ToString(),
                out var baseColor))
        {
            return;
        }

        WeddingThemePaletteGenerator.ApplyGenerated(Vm.Config.CustomTheme, baseColor);
        ActivateCustomTheme();
    }

    private void ApplyAutomaticThemePalette()
    {
        if (Vm.Config is null || !Vm.Config.HasPremiumPlan) return;

        var baseColor = WeddingThemePaletteGenerator.NormalizeHexColor(
            Vm.Config.CustomTheme.BaseColor,
            Vm.Config.CustomTheme.Primary);
        WeddingThemePaletteGenerator.ApplyGenerated(Vm.Config.CustomTheme, baseColor);
        ActivateCustomTheme();
    }

    private void UpdateCustomThemeColor(string token, string? value)
    {
        if (Vm.Config is null
            || !Vm.Config.HasPremiumPlan
            || !WeddingThemePaletteGenerator.TryNormalizeHexColor(value, out var normalized))
        {
            return;
        }

        var custom = Vm.Config.CustomTheme;
        switch (token)
        {
            case "primary":
                custom.Primary = normalized;
                break;
            case "accent":
                custom.Accent = normalized;
                break;
            case "dark":
                custom.Dark = normalized;
                break;
            case "text":
                custom.Text = normalized;
                break;
            case "muted":
                custom.MutedText = normalized;
                break;
            case "background":
                custom.Background = normalized;
                break;
            case "panel":
                custom.PanelBackground = normalized;
                break;
            case "button":
                custom.ButtonBackground = normalized;
                break;
            case "button-text":
                custom.ButtonText = normalized;
                break;
            case "border":
                custom.Border = normalized;
                break;
            default:
                return;
        }

        ActivateCustomTheme();
    }

    private void ActivateCustomTheme()
    {
        if (Vm.Config is null) return;
        Vm.Config.ThemeName = WeddingThemeCatalog.CustomThemeKey;
    }

    /// <summary>레이아웃 카드 선택 시 호출 — legacy 문자열 필드에 저장.</summary>
    private void SelectLayout(WeddingLayoutMode mode)
    {
        if (Vm.Config is null) return;
        var option = WeddingLayoutCatalog.Instance.Find(mode);
        if (option is null || !option.IsImplemented || !CanUseLayout(option)) return;
        Vm.Config.ThankYouStyle = ThankYouDesignCatalog.ToLegacyLayoutKey(mode);
        if ((mode != WeddingLayoutMode.Story && _selected == "story") ||
            (mode != WeddingLayoutMode.PhotoBook && _selected == "photobook") ||
            (mode != WeddingLayoutMode.Card && _selected == "cards"))
        {
            _selected = "design";
        }
    }

    private bool CanUseLayout(WeddingLayoutOption option)
    {
        if (Vm.Config is null) return option.Tier == WeddingLayoutTier.Free;
        var access = BuildLayoutAccessState();
        return option.Tier == WeddingLayoutTier.Free
            || access.HasPremiumPlan
            || access.IsLayoutUnlocked(option.Mode)
            || access.IsLayoutUnlocked(option.Key);
    }

    private WeddingLayoutAccessState BuildLayoutAccessState()
    {
        if (Vm.Config is null) return new WeddingLayoutAccessState();
        return new WeddingLayoutAccessState
        {
            HasPremiumPlan = Vm.Config.HasPremiumPlan,
            UnlockedLayouts = Vm.Config.UnlockedLayoutModes
                .Select(WeddingLayoutCatalog.FromLegacyKey)
                .Where(x => x != WeddingLayoutMode.Unknown)
                .ToArray(),
            UnlockedLayoutKeys = Vm.Config.UnlockedLayoutModes.ToArray(),
        };
    }

    private bool CanUseTheme(WeddingThemeOption option)
    {
        if (Vm.Config is null) return option.Tier == WeddingThemeTier.Free;
        return new WeddingThemeAccessPolicy().CanUse(option, BuildThemeAccessState());
    }

    private WeddingThemeAccessState BuildThemeAccessState()
    {
        if (Vm.Config is null) return new WeddingThemeAccessState();
        return new WeddingThemeAccessState
        {
            HasPremiumPlan = Vm.Config.HasPremiumPlan,
            UnlockedThemeKeys = Vm.Config.UnlockedThemeKeys
                .Where(WeddingThemeCatalog.IsPresetKey)
                .Select(WeddingThemeCatalog.NormalizeKey)
                .ToArray(),
        };
    }

    private void SelectTheme(string themeKey)
    {
        if (Vm.Config is null) return;
        var option = WeddingThemeCatalog.Instance.Find(themeKey);
        if (option is null || !option.IsImplemented || !CanUseTheme(option)) return;
        Vm.Config.ThemeName = option.Key;
    }

