@page "/{Slug}/admin"
@layout WeddingThankYou.Blazor.Layout.WeddingLayout
@namespace WeddingThankYou.Blazor.Pages
@rendermode InteractiveServer

@using Microsoft.JSInterop
@using Markdig
@using Wedding.Common
@using WeddingThankYou.Models
@inject WeddingThankYou.ViewModels.AdminViewModel Vm
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ThankYouLocalization Text
@implements IDisposable

<PageTitle>@Text["admin"] — @Slug</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="/css/WeddingPlatformLayout.css?v=20260802-layout-parity-3" />
    <link rel="stylesheet" href="/css/thankyou-admin-accessibility.css?v=20260802-layout-parity-3" />
</HeadContent>

<div class="w-admin">
    <div class="w-admin-preferences" aria-label="@Text["screen.settings"]">
        <WeddingThankYou.Blazor.Components.ThankYouPreferences />
    </div>
    @if (!Vm.IsAuthenticated)
    {
        <div class="w-admin__login w-panel">
            <h1 class="w-admin__title">⚙ @Text["admin.manage"] — <code>@Slug</code></h1>
            <h2>@Text["admin.signin"]</h2>
            @if (Vm.IsSignedIn)
            {
                <p class="w-hint">@Text["admin.shared.current"]: <strong>@Vm.CurrentUserLabel</strong></p>
                <p class="w-hint">@Text["admin.link.account"]</p>
            }
            else
            {
                <p class="w-hint">@Text["admin.login.first"]</p>
                <a class="w-btn" href="@LoginUrl">@Text["common.login"]</a>
            }
            <input class="w-input" type="password" placeholder="@Text["field.password"]" @bind="Vm.LoginPassword" />
            <button class="w-btn w-btn--primary" @onclick="OnLogin">@Text["login"]</button>
            @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
            {
                <p class="w-status">@DisplayStatusMessage</p>
            }
        </div>
    }
    else if (!Vm.IsLoaded)
    {
        <div class="w-loading"><div class="w-spinner"></div></div>
    }
    else
    {
        <div class="w-admin-shell @(_previewCollapsed ? "is-preview-collapsed" : "")">
            @if (_navOpen)
            {
                <button class="w-admin-nav__backdrop" @onclick="() => _navOpen = false" aria-label="@Text["admin.close.menu"]"></button>
            }
            <aside class="w-admin-nav @(_navOpen ? "is-open" : "")">
                <div class="w-admin-nav__head">
                    <div class="w-admin-nav__brand">
                        <span class="w-admin-nav__brand-icon">⚙</span>
                        <div>
                            <strong>@Text["admin.manage"]</strong>
                            <small>@Slug</small>
                        </div>
                    </div>
                    <button class="w-admin-nav__close" @onclick="() => _navOpen = false" aria-label="@Text["admin.close.menu"]">✕</button>
                </div>

                <nav class="w-admin-nav__list">
                    @foreach (var item in VisibleNavItems)
                    {
                        <button class="w-admin-nav__item @(_selected == item.Key ? "active" : "")"
                                @onclick="() => SelectSection(item.Key)">
                            <span class="w-admin-nav__icon">@((MarkupString)item.Icon)</span>
                            <span class="w-admin-nav__label">@item.Label</span>
                        </button>
                    }
                </nav>

                <div class="w-admin-nav__foot">
                    <button class="w-btn w-btn--primary w-btn--block" @onclick="OnSaveConfig">
                        @Text["admin.save"]
                    </button>
                    <button class="w-btn w-btn--block" @onclick="OnShareThankYou">
                        @Text["admin.share"]
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
                    {
                        <p class="w-status">@DisplayStatusMessage</p>
                    }
                    <a class="w-admin-nav__link" href="@PreviewUrl" target="_blank">@Text["admin.open.thankyou"]</a>
                </div>
            </aside>

            <main class="w-admin-content">
                <div class="w-admin-content__topbar">
                    <button class="w-admin-nav__toggle" @onclick="() => _navOpen = !_navOpen" aria-label="@Text["admin.open.menu"]">☰</button>
                    <h2 class="w-admin-content__title">
                        <span class="w-admin-title__icon">@((MarkupString)CurrentNavItem.Icon)</span>
                        <span class="w-admin-title__text">@CurrentNavItem.Label</span>
                    </h2>
                    <button class="w-admin-preview__toggle" @onclick="OnPreviewToggle" aria-label="@Text["admin.open.preview"]"
                            title="@Text["admin.open.preview"]">
                        <span class="w-admin-preview__toggle-icon">📱</span>
                        <span class="w-admin-preview__toggle-text">@(_previewCollapsed ? Text["admin.expand.preview"] : Text["admin.preview"])</span>
                    </button>
                </div>

                <div class="w-admin-content__body">
                    @if (_selected == "basic")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.basic.hero"]</h3>
                            <label class="w-label">@Text["admin.basic.title"]</label>
                            <input class="w-input" @bind="Vm.Config!.HeroTitle" placeholder="Thank You" />

                            <label class="w-label">@Text["field.couple"]</label>
                            <input class="w-input" @bind="Vm.Config!.CoupleName" />

                            <div class="w-coord-row">
                                <div>
                                    <label class="w-label">@Text["field.date"]</label>
                                    <input class="w-input" type="date" @bind="Vm.Config.WeddingDate" />
                                </div>
                                <div>
                                    <label class="w-label">@Text["admin.basic.time"]</label>
                                    <input class="w-input" @bind="Vm.Config.WeddingTime" placeholder="@Text["admin.basic.time.placeholder"]" />
                                </div>
                            </div>

                            <label class="w-label">@Text["admin.basic.venue"]</label>
                            <input class="w-input" @bind="Vm.Config.VenueName" />

                            <label class="w-label">@Text["admin.basic.address"]</label>
                            <input class="w-input" @bind="Vm.Config.VenueAddress" />

                            <label class="w-label">@Text["admin.basic.story.ko"]</label>
                            <textarea class="w-input w-textarea" rows="5" @bind="Vm.Config.Story"></textarea>

                            <label class="w-label">@Text["admin.basic.story.other"]</label>
                            <textarea class="w-input w-textarea" rows="5" @bind="Vm.Config.Story2"></textarea>

                            <label class="w-label">@Text["admin.notice"]</label>
                            <p class="w-hint">@Text["admin.notice.desc"]</p>
                            <p class="w-hint">@Text["admin.notice.ai"]</p>
                            <div class="w-note-examples" aria-label="@Text["admin.notice.examples"]">
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("warm")'>@Text["admin.notice.warm"]</button>
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("formal")'>@Text["admin.notice.formal"]</button>
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("simple")'>@Text["admin.notice.simple"]</button>
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("ai")'>@Text["admin.notice.ai.example"]</button>
                            </div>
                            <div class="w-note-toolbar">
                                <button class="@(Vm.Config.CeremonyNoteFormat == "Markdown" ? "active" : "")"
                                        @onclick='() => Vm.Config.CeremonyNoteFormat = "Markdown"'>@Text["admin.notice.markdown"]</button>
                                <button class="@(Vm.Config.CeremonyNoteFormat == "Html" ? "active" : "")"
                                        @onclick='() => Vm.Config.CeremonyNoteFormat = "Html"'>HTML</button>
                            </div>
                            <div class="w-note-editor-grid">
                                <div class="w-note-editor">
                                    @if (Vm.Config.CeremonyNoteFormat == "Markdown")
                                    {
                                        <textarea class="w-input w-textarea w-textarea--code w-textarea--notice" rows="12"
                                                  @bind="Vm.Config.CeremonyNote" @bind:event="oninput"
                                                  placeholder="@Text["admin.notice.markdown.placeholder"]"></textarea>
                                        <p class="w-hint">@Text["admin.notice.markdown.hint"]</p>
                                    }
                                    else
                                    {
                                        <textarea class="w-input w-textarea w-textarea--code w-textarea--notice" rows="12"
                                                  @bind="Vm.Config.CeremonyNote" @bind:event="oninput"
                                                  placeholder="@Text["admin.notice.html.placeholder"]"></textarea>
                                        <p class="w-hint">@Text["admin.notice.html.hint"]</p>
                                    }
                                </div>
                                <div class="w-note-preview">
                                    <div class="w-note-preview__head">@Text["admin.notice.html.preview"]</div>
                                    <div class="w-note-preview__body">
                                        @if (string.IsNullOrWhiteSpace(Vm.Config.CeremonyNote))
                                        {
                                            <p class="w-note-preview__empty">@Text["admin.notice.preview.empty"]</p>
                                        }
                                        else
                                        {
                                            @((MarkupString)CeremonyNotePreviewHtml)
                                        }
                                    </div>
                                </div>
                            </div>
                        </section>
                    }
                    else if (_selected == "design")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.design.layout"]</h3>
                            <p class="w-hint">@Text["admin.design.layout.hint"]</p>
                            @{ var selectedLayout = SelectedLayoutOption; var matchingLayouts = FilteredLayoutOptions.ToArray(); }
                            <div class="w-layout-picker">
                                <div class="w-layout-combobox">
                                    <button type="button" class="w-layout-combobox__trigger" aria-haspopup="listbox" aria-expanded="@_layoutPickerOpen" @onclick="() => _layoutPickerOpen = !_layoutPickerOpen"><span class="w-layout-combobox__value"><small>@Text["admin.design.select"]</small><strong>@(selectedLayout is null ? Text["admin.design.none"] : LocalizedLayoutLabel(selectedLayout))</strong></span><span class="w-layout-combobox__chevron">@(_layoutPickerOpen ? "▴" : "▾")</span></button>
                                    @if (_layoutPickerOpen)
                                    {
                                        <div class="w-layout-combobox__popover"><label class="w-layout-combobox__search-label">@Text["admin.design.search"]</label><input class="w-input w-layout-combobox__search" type="search" placeholder="@Text["admin.design.search.placeholder"]" @bind="_layoutSearch" @bind:event="oninput" />
                                            <div class="w-layout-options" role="listbox">
                                                @foreach (var descriptor in matchingLayouts)
                                                {
                                                    var canUse = CanUseLayout(descriptor); var canApply = canUse && descriptor.IsImplemented; var applied = CurrentLayoutMode == descriptor.Mode; var selected = selectedLayout?.Mode == descriptor.Mode;
                                                    <button type="button" class="w-layout-option @(selected ? "is-selected" : "") @(!canApply ? "is-locked" : "")" disabled="@(!canApply)" @onclick="() => ChooseLayout(descriptor)"><span class="w-style-card__preview w-style-card__preview--@descriptor.Key"></span><span class="w-layout-option__meta"><strong>@LocalizedLayoutLabel(descriptor)</strong><small>@LocalizedLayoutDescription(descriptor)</small></span><span class="w-layout-option__badges">@if (applied) { <span class="w-layout-badge w-layout-badge--active">@Text["admin.design.applied"]</span> }<span class="w-layout-badge">@(descriptor.Tier == WeddingLayoutTier.Free ? "Free" : "Premium")</span></span></button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                @if (selectedLayout is not null)
                                {
                                    <article class="w-layout-detail"><div class="w-layout-detail__visual w-style-card__preview w-style-card__preview--@selectedLayout.Key"></div><div class="w-layout-detail__content"><div class="w-layout-detail__badges"><span class="w-layout-badge">@(selectedLayout.Tier == WeddingLayoutTier.Free ? "Free" : "Premium")</span>@if (CurrentLayoutMode == selectedLayout.Mode) { <span class="w-layout-badge w-layout-badge--active">@Text["admin.design.current"]</span> }</div><h4>@LocalizedLayoutLabel(selectedLayout)</h4><p>@LocalizedLayoutDescription(selectedLayout)</p><dl class="w-layout-detail__facts"><div><dt>@Text["admin.design.screen.mode"]</dt><dd>@(selectedLayout.UsesBottomNavigation ? Text["admin.design.bottom.nav"] : Text["admin.design.vertical.scroll"])</dd></div><div><dt>@Text["admin.design.supported.sections"]</dt><dd>@selectedLayout.SupportedSections.Count</dd></div></dl><div class="w-layout-detail__actions"><button type="button" class="w-btn w-btn--primary" disabled="@(CurrentLayoutMode == selectedLayout.Mode)" @onclick="ApplySelectedLayout">@Text["admin.layout.apply"]</button></div></div></article>
                                }
                            </div>
                        </section>

                        <section class="w-admin__section">
                            <div class="w-admin-section-title-row">
                                <div>
                                    <h3 class="w-admin__section-h">@Text["admin.design.sections"]</h3>
                                    <p class="w-hint">@Text["admin.design.sections.hint"]</p>
                                </div>
                                <button type="button" class="w-btn w-btn--sm" @onclick="ResetSectionOrder">@Text["admin.design.recommended"]</button>
                            </div>
                            <div class="w-section-order-list">
                                @foreach (var section in OrderedDesignSections)
                                {
                                    var isSectionVisible = IsSectionVisible(section);
                                    <div class="w-section-order-item @(section == "hero" ? "is-fixed" : "") @(!isSectionVisible ? "is-hidden" : "")">
                                        <span class="w-section-order-item__icon">@WeddingSectionOrderCatalog.GetIcon(section)</span>
                                        <span class="w-section-order-item__label">@LocalizedSectionLabel(section)</span>
                                        <div class="w-section-order-item__actions">
                                            @if (section == "hero")
                                            {
                                                <span class="w-hint">@Text["admin.design.fixed"]</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="w-btn w-btn--sm" @onclick="() => MoveSection(section, -1)">@Text["admin.design.up"]</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick="() => MoveSection(section, 1)">@Text["admin.design.down"]</button>
                                                <button type="button"
                                                        class="w-btn w-btn--sm @(isSectionVisible ? "" : "w-btn--muted")"
                                                        title="@(isSectionVisible ? Text["admin.design.section.hide.title"] : Text["admin.design.section.show.title"])"
                                                        @onclick="() => ToggleSectionVisibility(section)">
                                                    @(isSectionVisible ? Text["admin.design.hide"] : Text["admin.design.show"])
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🎨 @Text["admin.design.colors"]</h3>
                            <div class="w-theme-picker">
                                @foreach (var t in ThankYouDesignCatalog.Themes)
                                {
                                    var canUse = CanUseTheme(t);
                                    var canSelect = canUse && t.IsImplemented;
                                    <button class="w-theme-btn @(Vm.Config!.ThemeName == t.Key ? "active" : "") @(!canSelect ? "is-locked" : "")"
                                            style="--tc:@t.Primary;--tca:@t.Accent"
                                            disabled="@(!canSelect)"
                                            @onclick="() => SelectTheme(t.Key)">
                                        <span class="w-theme-swatch"></span>
                                        <span>
                                            @LocalizedThemeLabel(t.Key)
                                            @if (!t.IsImplemented)
                                            {
                                                <small class="w-layout-lock">@Text["admin.design.preparing"]</small>
                                            }
                                            else if (!canUse)
                                            {
                                                <small class="w-layout-lock">@Text["admin.design.locked"]</small>
                                            }
                                        </span>
                                    </button>
                                }
                            </div>

                            <div class="w-custom-theme @(Vm.Config!.ThemeName == WeddingThemeCatalog.CustomThemeKey ? "is-active" : "")">
                                <div class="w-custom-theme__head">
                                    <div>
                                        <strong>@Text["admin.design.custom.theme"]</strong>
                                        <p class="w-hint">@Text["admin.design.custom.theme.hint"]</p>
                                    </div>
                                    <span class="w-layout-badge">Premium</span>
                                </div>

                                @if (Vm.Config.HasPremiumPlan)
                                {
                                    var customPalette = CurrentCustomPalette;

                                    <label class="w-label">@Text["admin.design.theme.name"]</label>
                                    <input class="w-input"
                                           maxlength="40"
                                           @bind="Vm.Config.CustomTheme.Name" />

                                    <div class="w-custom-theme__generator">
                                        <div class="w-custom-theme__generator-copy">
                                            <strong>@Text["admin.design.auto.palette"]</strong>
                                            <p class="w-hint">@Text["admin.design.auto.palette.hint"]</p>
                                        </div>
                                        <label class="w-custom-theme__base">
                                            <span>@Text["admin.design.primary.color"]</span>
                                            <input type="color"
                                                   value="@customPalette.BaseColor"
                                                   @oninput="OnThemeBaseColorChanged" />
                                            <code>@customPalette.BaseColor</code>
                                        </label>
                                        <button type="button"
                                                class="w-btn w-btn--sm"
                                                @onclick="ApplyAutomaticThemePalette">
                                            @Text["admin.design.palette.rebuild"]
                                        </button>
                                    </div>

                                    <div class="w-custom-theme__palette"
                                         aria-label="@Text["admin.design.palette.aria"]">
                                        <span style="--w-custom-swatch:@customPalette.Primary" title="@Text["admin.design.color.primary"]"></span>
                                        <span style="--w-custom-swatch:@customPalette.Accent" title="@Text["admin.design.color.accent"]"></span>
                                        <span style="--w-custom-swatch:@customPalette.Background" title="@Text["admin.design.color.background"]"></span>
                                        <span style="--w-custom-swatch:@customPalette.PanelBackground" title="@Text["admin.design.color.surface"]"></span>
                                        <span style="--w-custom-swatch:@customPalette.Text" title="@Text["admin.design.color.text"]"></span>
                                        <span style="--w-custom-swatch:@customPalette.MutedText" title="@Text["admin.design.color.muted"]"></span>
                                    </div>

                                    <div class="w-custom-theme__contrast" aria-live="polite">
                                        <span class="@(TextContrastRatio >= 4.5 ? "is-good" : "is-warning")">
                                            @Text["admin.design.contrast.text"] @TextContrastRatio.ToString("0.0"):1
                                        </span>
                                        <span class="@(MutedContrastRatio >= 4.5 ? "is-good" : "is-warning")">
                                            @Text["admin.design.contrast.muted"] @MutedContrastRatio.ToString("0.0"):1
                                        </span>
                                        <span class="@(ButtonContrastRatio >= 4.5 ? "is-good" : "is-warning")">
                                            @Text["admin.design.contrast.button"] @ButtonContrastRatio.ToString("0.0"):1
                                        </span>
                                    </div>

                                    <details class="w-custom-theme__details">
                                        <summary>@Text["admin.design.colors.advanced"]</summary>
                                        <p class="w-hint">@Text["admin.design.colors.advanced.hint"]</p>
                                        <div class="w-custom-theme__colors">
                                            <label>
                                                <span>@Text["admin.design.color.primary"]</span>
                                                <input type="color" value="@customPalette.Primary"
                                                       @oninput='e => UpdateCustomThemeColor("primary", e.Value?.ToString())' />
                                                <code>@customPalette.Primary</code>
                                            </label>
                                            <label>
                                                <span>@Text["admin.design.color.accent"]</span>
                                                <input type="color" value="@customPalette.Accent"
                                                       @oninput='e => UpdateCustomThemeColor("accent", e.Value?.ToString())' />
                                                <code>@customPalette.Accent</code>
                                            </label>
                                            <label>
                                                <span>@Text["admin.design.color.accent.text"]</span>
                                                <input type="color" value="@customPalette.Dark"
                                                       @oninput='e => UpdateCustomThemeColor("dark", e.Value?.ToString())' />
                                                <code>@customPalette.Dark</code>
                                            </label>
                                            <label>
                                                <span>@Text["admin.design.color.text"]</span>
                                                <input type="color" value="@customPalette.Text"
                                                       @oninput='e => UpdateCustomThemeColor("text", e.Value?.ToString())' />
                                                <code>@customPalette.Text</code>
                                            </label>
                                            <label>
                                                <span>@Text["admin.design.color.muted"]</span>
                                                <input type="color" value="@customPalette.MutedText"
                                                       @oninput='e => UpdateCustomThemeColor("muted", e.Value?.ToString())' />
                                                <code>@customPalette.MutedText</code>
                                            </label>
                                            <label>
                                                <span>@Text["admin.design.color.background"]</span>
                                                <input type="color" value="@customPalette.Background"
                                                       @oninput='e => UpdateCustomThemeColor("background", e.Value?.ToString())' />
                                                <code>@customPalette.Background</code>
                                            </label>
                                            <label>
                                                <span>@Text["admin.design.color.surface"]</span>
                                                <input type="color" value="@customPalette.PanelBackground"
                                                       @oninput='e => UpdateCustomThemeColor("panel", e.Value?.ToString())' />
                                                <code>@customPalette.PanelBackground</code>
                                            </label>
                                            <label>
                                                <span>@Text["admin.design.color.button"]</span>
                                                <input type="color" value="@customPalette.ButtonBackground"
                                                       @oninput='e => UpdateCustomThemeColor("button", e.Value?.ToString())' />
                                                <code>@customPalette.ButtonBackground</code>
                                            </label>
                                            <label>
                                                <span>@Text["admin.design.color.button.text"]</span>
                                                <input type="color" value="@customPalette.ButtonText"
                                                       @oninput='e => UpdateCustomThemeColor("button-text", e.Value?.ToString())' />
                                                <code>@customPalette.ButtonText</code>
                                            </label>
                                            <label>
                                                <span>@Text["admin.design.color.border"]</span>
                                                <input type="color" value="@customPalette.Border"
                                                       @oninput='e => UpdateCustomThemeColor("border", e.Value?.ToString())' />
                                                <code>@customPalette.Border</code>
                                            </label>
                                        </div>
                                    </details>

                                    <button type="button"
                                            class="w-btn w-btn--primary"
                                            @onclick="SelectCustomTheme">
                                        @(Vm.Config.ThemeName == WeddingThemeCatalog.CustomThemeKey
                                            ? Text["admin.design.custom.selected"]
                                            : Text["admin.design.custom.use"])
                                    </button>
                                }
                                else if (Vm.Config.ThemeName == WeddingThemeCatalog.CustomThemeKey)
                                {
                                    <p class="w-layout-detail__notice">@Text["admin.design.custom.preserved"]</p>
                                }
                                else
                                {
                                    <p class="w-layout-detail__notice">@Text["admin.design.custom.premium.hint"]</p>
                                }
                            </div>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🖼 @Text["admin.hero.image"]</h3>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config!.HeroImageFileName))
                            {
                                <button type="button" class="w-admin__hero-preview w-admin__hero-preview--button" title="@Text["admin.hero.image.edit"]" @onclick="OpenHeroCropEditor"><img src="@Vm.GetHeroUrl(Slug, Vm.Config.HeroImageFileName)" alt="@Text["admin.hero.image"]" /><span><b>@Vm.Config.HeroImageFileName</b><small>@Text["admin.hero.image.tap"]</small></span></button>
                            }
                            <LocalizedInputFile Class="w-file-input" OnChange="OnHeroUpload" Accept="image/*" />
                            @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }
                            <p class="w-hint">@Text["admin.hero.image.recommend"]</p>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config.HeroImageFileName)) { <button type="button" class="w-btn w-btn--primary" @onclick="OpenHeroCropEditor">@Text["admin.hero.image.edit.area"]</button> }
                        </section>

                        @if (_heroCropEditorOpen && !string.IsNullOrWhiteSpace(Vm.Config!.HeroImageFileName))
                        {
                            <div class="w-hero-crop-modal__backdrop" @onclick="CloseHeroCropEditor">
                                <section class="w-hero-crop-modal" role="dialog" aria-modal="true" aria-labelledby="hero-crop-title" @onclick:stopPropagation>
                                    <header class="w-hero-crop-modal__head"><div><h3 id="hero-crop-title">@Text["admin.hero.crop.title"]</h3><p>@Text["admin.hero.crop.desc"]</p></div><button type="button" class="w-admin-preview__close" @onclick="CloseHeroCropEditor" aria-label="@Text["common.cancel"]">✕</button></header>
                                    <div class="w-hero-crop-guide"><strong>@Text["admin.hero.crop.source"]</strong><span>@Text["admin.hero.crop.source.hint"]</span><small>@Text["admin.hero.crop.target.hint"]</small></div>
