            CurrentCustomPalette.MutedText,
            CurrentCustomPalette.Background);
    private double ButtonContrastRatio =>
        WeddingThemePaletteGenerator.ContrastRatio(
            CurrentCustomPalette.ButtonText,
            CurrentCustomPalette.ButtonBackground);
    private IReadOnlyList<string> OrderedDesignSections =>
        WeddingSectionOrderCatalog.NormalizeThankYouOrder(Vm.Config?.SectionOrder);

    private bool IsSectionVisible(string section)
    {
        if (Vm.Config is null || string.Equals(section, "hero", StringComparison.OrdinalIgnoreCase)) return true;
        return !Vm.Config.SectionVisibility.TryGetValue(section, out var visible) || visible;
    }

    private void ToggleSectionVisibility(string section)
    {
        if (Vm.Config is null || string.Equals(section, "hero", StringComparison.OrdinalIgnoreCase)) return;
        var current = !Vm.Config.SectionVisibility.TryGetValue(section, out var visible) || visible;
        Vm.Config.SectionVisibility[section] = !current;
