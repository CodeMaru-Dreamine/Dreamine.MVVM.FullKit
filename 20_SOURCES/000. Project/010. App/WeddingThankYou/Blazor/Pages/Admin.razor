    private async Task RunUploadAsync(Func<Task> action)
    {
        if (System.Threading.Interlocked.CompareExchange(
                ref _uploadRunActive,
                1,
                0) != 0)
        {
            return;
        }

        try
        {
            System.Threading.CancellationTokenSource source;
            lock (_uploadTickerSync)
            {
                if (_disposed)
                {
                    return;
                }

                source = new System.Threading.CancellationTokenSource();
                _uploadTickCts = source;
                _uploadElapsedSec = 0;
            }

            var ticker = RunUploadTickerAsync(source.Token);
            try
            {
                if (!source.IsCancellationRequested)
                {
                    await action();
                }
            }
            finally
            {
                await source.CancelAsync();

                try
                {
                    await ticker;
                }
                catch (OperationCanceledException)
                    when (source.IsCancellationRequested)
                {
                }
                finally
                {
                    lock (_uploadTickerSync)
                    {
                        if (ReferenceEquals(_uploadTickCts, source))
                        {
                            _uploadTickCts = null;
                        }
                    }

                    source.Dispose();
                }
            }
        }
        finally
        {
            System.Threading.Volatile.Write(ref _uploadRunActive, 0);
        }
    }

    private async Task RunUploadTickerAsync(
        System.Threading.CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            await Task.Delay(1000, token);
            _uploadElapsedSec++;
            await InvokeAsync(StateHasChanged);
        }
    }

