                    <figure class="wedding-story-hero-photo @(isReverse ? "wedding-story-hero-photo--portrait" : "")">
                        <button type="button" class="wedding-photo-thumb" @onclick="() => OpenPremiumPhoto(photo)" aria-label="@(L("public.story.photo.open", chapter.Title))">
                            <img src="@photo.Url" alt="@chapter.Title" loading="@(chapterIndex == 0 ? "eager" : "lazy")" />
                        </button>
                    </figure>
                }
                <div class="wedding-story-text-block @(isClosing ? "wedding-story-text-block--wide" : "")">
                    @RenderStoryChapterBody(chapter, chapterIndex)
                </div>
            </section>
        }
    </text>;

    private RenderFragment RenderStoryMomentStrip() => @<section class="wedding-story-moment-strip" id="gallery">
        <div class="wedding-layout-heading">
            <p class="wedding-layout-kicker">@Text["public.story.title"]</p>
            <h2>@Text["public.story.moments.title"]</h2>
            <span>@L("public.gallery.count.visible", StoryStripVisible, StoryStripTotal)</span>
        </div>
        <div class="w-gallery__controls">
            <button class="w-btn" type="button" @onclick="TogglePremiumAutoPlay">
                @(premiumAutoPlaying ? Text["public.gallery.autoplay.stop"] : Text["public.gallery.autoplay.start"])
            </button>
        </div>
        <div class="wedding-story-moment-strip__grid">
            @for (int i = 0; i < StoryStripVisible; i++)
            {
                var photoIndex = i;
                <figure>
                    <button type="button" class="wedding-photo-thumb" @onclick="() => OpenPremiumPhoto(photoIndex)" aria-label="@(L("public.gallery.photo.open", photoIndex + 1))">
                        <img src="@Vm.AllPhotos[photoIndex].Url" alt="@(L("public.gallery.photo.alt", photoIndex + 1))" loading="lazy" />
                    </button>
                </figure>
            }
        </div>
        @if (StoryStripVisible < StoryStripTotal)
        {
            <div class="wedding-layout-more">
                <button type="button" class="w-btn w-btn--primary" @onclick="LoadMoreStoryStrip">
                    @L("public.gallery.more", Math.Min(StoryStripPageSize, StoryStripTotal - StoryStripVisible))
                </button>
            </div>
        }
    </section>;

    private RenderFragment RenderGuestbook() => @<section class="w-guestbook w-invite-tab-page">
        <h2 class="w-section-title">📖 @Text["public.guestbook.title"]</h2>
        <div class="w-gb__form">
            <input class="w-input" type="text" aria-label="@Text["public.guestbook.name"]" placeholder="@Text["public.guestbook.name"]" @bind="VmGuest.Name" />
            <input class="w-input" type="text" aria-label="@Text["public.guestbook.contact.optional"]" placeholder="@Text["public.guestbook.contact.optional"]" @bind="VmGuest.Contact" />
            <textarea class="w-input w-textarea" rows="4" aria-label="@Text["public.guestbook.message.placeholder"]" placeholder="@Text["public.guestbook.message.placeholder"]" @bind="VmGuest.Message"></textarea>
            <div class="w-gb__actions">
                <button class="w-btn w-btn--primary" @onclick="OnGuestbookAdd" disabled="@VmGuest.IsSaving">@Text["public.guestbook.submit"]</button>
                <button class="w-btn" @onclick="OnGuestbookReload">@Text["public.guestbook.reload"]</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(VmGuest.LastStatus))
            {
                <p class="w-status">@VmGuest.LastStatus</p>
            }
        </div>
        <ul class="w-gb__list">
            @foreach (var e in VmGuest.EntriesView)
            {
                <li class="w-gb__entry">
                    <div class="w-gb__meta"><strong>@e.Name</strong><span class="w-gb__date">@Text.FormatDateTime(e.CreatedLocal)</span></div>
                    <div class="w-gb__msg">@e.Message</div>
                </li>
            }
        </ul>
    </section>;

    public async ValueTask DisposeAsync()
    {
        Text.Changed -= OnLanguageChanged;
        try
        {
            await JS.InvokeVoidAsync("weddingInterop.clearTheme");
        }
        catch (JSDisconnectedException)
        {
            // The circuit may already be gone during a full-page navigation.
        }
        await StopAutoPlay();
        await StopPremiumAutoPlay();
        autoCts?.Dispose();
        premiumAutoCts?.Dispose();
        _selfRef?.Dispose();
    }
}
