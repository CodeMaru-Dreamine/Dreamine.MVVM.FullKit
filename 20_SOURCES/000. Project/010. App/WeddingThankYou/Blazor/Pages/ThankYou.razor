@page "/{Slug}/thankyou"
@page "/{Slug}"
@layout WeddingThankYou.Blazor.Layout.WeddingLayout
@namespace WeddingThankYou.Blazor.Pages
@rendermode InteractiveServer

@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Rendering
@using Wedding.Common
@inject WeddingThankYou.ViewModels.InvitationViewModel Vm
@inject WeddingThankYou.ViewModels.GuestbookViewModel VmGuest
@inject ThankYouLocalization Text
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@L("public.page.title", Vm.CoupleName)</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="/css/wedding-layout-components.css?v=20260802-layout-parity-3" />
    @if (Vm.Config is not null)
    {
        <style>.w-public-root{--w-hero-image-fit-desktop:@Vm.Config.HeroDesktopFit;--w-hero-image-fit-mobile:@Vm.Config.HeroMobileFit;--w-hero-image-position-desktop:@($"{Vm.Config.HeroDesktopFocusX}% {Vm.Config.HeroDesktopFocusY}%");--w-hero-image-position-mobile:@($"{Vm.Config.HeroMobileFocusX}% {Vm.Config.HeroMobileFocusY}%");--w-hero-image-crop-desktop-enabled:@(Vm.Config.HeroDesktopFit == "cover" ? 1 : 0);--w-hero-image-crop-desktop-x:@Vm.Config.HeroDesktopCrop.X;--w-hero-image-crop-desktop-y:@Vm.Config.HeroDesktopCrop.Y;--w-hero-image-crop-desktop-width:@Vm.Config.HeroDesktopCrop.Width;--w-hero-image-crop-desktop-height:@Vm.Config.HeroDesktopCrop.Height;--w-hero-image-crop-mobile-enabled:@(Vm.Config.HeroMobileFit == "cover" ? 1 : 0);--w-hero-image-crop-mobile-x:@Vm.Config.HeroMobileCrop.X;--w-hero-image-crop-mobile-y:@Vm.Config.HeroMobileCrop.Y;--w-hero-image-crop-mobile-width:@Vm.Config.HeroMobileCrop.Width;--w-hero-image-crop-mobile-height:@Vm.Config.HeroMobileCrop.Height;@if (Vm.ThemeName == WeddingThemeCatalog.CustomThemeKey){<text>--w-primary:@Vm.Config.CustomThemePrimary;--w-dark:@Vm.Config.CustomThemeDark;--w-secondary:@Vm.Config.CustomThemeAccent;--w-accent:@Vm.Config.CustomThemeAccent;--w-text:@Vm.Config.CustomThemeText;--w-muted-text:@Vm.Config.CustomThemeMutedText;--w-bg:@Vm.Config.CustomThemeBackground;--w-panel-bg:@Vm.Config.CustomThemePanel;--w-border:@Vm.Config.CustomThemeBorder;--w-button-bg:@Vm.Config.CustomThemeButtonBackground;--w-button-text:@Vm.Config.CustomThemeButtonText;--w-nav-bg:@Vm.Config.CustomThemePanel;--w-nav-text:@Vm.Config.CustomThemeText;</text>}}</style>
    }
    <meta property="og:title" content="@Vm.OgTitle" />
    <meta property="og:description" content="@Vm.OgDescription" />
    <meta property="og:image" content="@(string.IsNullOrWhiteSpace(Vm.OgImageUrl) ? "/img/og-thankyou.png" : Vm.OgImageUrl)" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
</HeadContent>

@if (!Vm.IsLoaded)
{
    <div class="w-loading"><div class="w-spinner"></div></div>
}
else if (Vm.NotFound)
{
    <div class="w-notfound"><h1>404</h1><p>@Text["public.notfound.message"]</p><a href="/">@Text["public.home"]</a></div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Vm.MusicUrl))
    {
        <div class="w-music-bar @(Vm.MusicButtonPosition == "top" ? "w-music-bar--top" : "") @(Vm.HasCustomMusicButtonPosition ? "w-draggable-positioned" : "") @(AdminPreview ? "w-design-draggable" : "")"
             data-drag-target="music"
             style="@Vm.MusicButtonStyle">
            <audio @ref="audioRef" src="@Vm.MusicUrl" loop preload="auto"></audio>
            <button class="w-music-btn" @onclick="ToggleMusic" title="@(isMusicPlaying ? Text["public.music.pause"] : Text["public.music.play"])"
                    aria-label="@(isMusicPlaying ? Text["public.music.pause"] : Text["public.music.play"])">
                @(isMusicPlaying ? "⏸" : "🎵")
            </button>
            <span class="w-music-label">@(isMusicPlaying ? Text["public.music.playing"] : Text["public.music.play"])</span>
        </div>
    }

    @if (UseTabs)
    {
        <nav class="w-invite-tabs-bar" aria-label="@Text["public.menu"]">
            @foreach (var item in TabItems)
            {
                <button class="@TabClass(item.Key)" @onclick="() => SetTab(item.Key)"><span>@item.Icon</span><small>@item.Label</small></button>
            }
        </nav>

        <button class="w-invite-menu-fab @(_mobileTabMenuOpen ? "is-open" : "")"
                @onclick="ToggleMobileTabMenu"
                aria-label="@(_mobileTabMenuOpen ? Text["public.menu.close"] : Text["public.menu.open"])"
                aria-expanded="@_mobileTabMenuOpen"
                aria-controls="thankyou-mobile-menu">
            @(_mobileTabMenuOpen ? "✕" : "☰")
        </button>

        @if (_mobileTabMenuOpen)
        {
            <div class="w-invite-menu-backdrop" @onclick="ToggleMobileTabMenu"></div>
            <nav id="thankyou-mobile-menu" class="w-invite-menu-sheet" aria-label="@Text["public.menu.mobile"]">
                <div class="w-invite-menu-sheet__handle"></div>
                <div class="w-invite-menu-sheet__grid">
                    @foreach (var item in TabItems)
                    {
                        <button class="w-invite-menu-item @(ActiveTab == item.Key ? "active" : "")" @onclick="() => SelectTabAndClose(item.Key)">
                            <span class="w-invite-menu-item__ico">@item.Icon</span><span>@item.Label</span>
                        </button>
                    }
                </div>
            </nav>
        }
    }

    @if (UseCardLayout)
    {
        var cardPages = CardPages;
        <section class="wedding-card-experience" aria-label="@(L("public.card.aria", Vm.CoupleName))">
            <LayoutTransitionSurface Presentation="LayoutPresentationMode.FlipCard" Transition="@CardTransition"
                                     PageCount="@cardPages.Count" ActiveIndex="@_cardPageIndex"
                                     ActiveIndexChanged="OnCardPageChanged" PageLabel="CardPageLabel"
                                     AriaLabel="@(L("public.card.aria", Vm.CoupleName))">
                <PageContent Context="pageIndex">
                    @{ var cardPage = cardPages[Math.Clamp(pageIndex, 0, cardPages.Count - 1)]; }
                    <article class="wedding-card-face">
                        @if (cardPage is null)
                        {
                            <section class="wedding-card-cover w-hero--invite-positioned"
                                     role="banner"
                                     data-drag-container
                                     data-hero-crop-container>
                                @if (!string.IsNullOrWhiteSpace(Vm.HeroImageUrl))
                                {
                                    <img class="wedding-card-cover__image wedding-card-cover__image--backdrop" src="@Vm.HeroImageUrl" alt="" aria-hidden="true" />
                                    <img class="wedding-card-cover__image" data-hero-crop-image src="@Vm.HeroImageUrl" alt="@(L("public.hero.photo.alt", Vm.CoupleName))" />
                                }
                                else { <div class="wedding-card-cover__image wedding-card-cover__image--empty"></div> }
                                <div class="wedding-card-cover__veil"></div><span class="wedding-card-cover__seal" aria-hidden="true">W</span>
                                <div class="wedding-card-cover__panel wedding-card-cover__panel--top w-panel w-hero__top
                                            w-hero-panel--dv-@Vm.HeroPanelVerticalDesktop
                                            w-hero-panel--dh-@Vm.HeroPanelHorizontalDesktop
                                            w-hero-panel--mv-@Vm.HeroPanelVerticalMobile
                                            w-hero-panel--mh-@Vm.HeroPanelHorizontalMobile
                                            @(Vm.HasCustomHeroTopPanelPosition ? "w-draggable-positioned" : "")
                                            @(AdminPreview ? "w-design-draggable" : "")"
                                     data-drag-target="heroTop"
                                     @onpointerdown:stopPropagation
                                     @onpointerup:stopPropagation
                                     style="@Vm.HeroTopPanelStyle">
                                    <p class="wedding-card-cover__kicker">@Vm.HeroTitle</p><h1>@Vm.CoupleName</h1>
                                </div>
                                <div class="wedding-card-cover__panel wedding-card-cover__panel--bottom w-panel w-hero__bottom
                                            w-hero-panel--dv-bottom w-hero-panel--dh-center
                                            w-hero-panel--mv-bottom w-hero-panel--mh-center
                                            @(Vm.HasCustomHeroBottomPanelPosition ? "w-draggable-positioned" : "")
                                            @(AdminPreview ? "w-design-draggable" : "")"
                                     data-drag-target="heroBottom"
                                     @onpointerdown:stopPropagation
                                     @onpointerup:stopPropagation
                                     style="@Vm.HeroBottomPanelStyle">
                                    <p class="wedding-card-cover__date">@WeddingDateText <span>@Vm.WeddingTime</span></p>
                                    @if (!string.IsNullOrWhiteSpace(Vm.VenueName)) { <p class="wedding-card-cover__venue">@Vm.VenueName</p> }
                                </div>
                            </section>
                        }
                        else
                        {
                            var highlight = ResolveCardHighlight(cardPage);
                            <section class="wedding-card-sheet wedding-card-sheet--@cardPage">
                                <header class="wedding-card-sheet__header"><span class="wedding-card-sheet__folio">@(pageIndex + 1). @Text["public.section.card"]</span><span class="wedding-card-sheet__icon">@(string.IsNullOrWhiteSpace(highlight?.Icon) ? WeddingSectionOrderCatalog.GetIcon(cardPage) : highlight.Icon)</span><h2>@(string.IsNullOrWhiteSpace(highlight?.Title) ? SectionLabel(cardPage) : highlight.Title)</h2>@if (!string.IsNullOrWhiteSpace(highlight?.Body)) { <p>@highlight.Body</p> }</header>
                                <div class="wedding-card-sheet__content" role="region" tabindex="0">@RenderStandardSection(cardPage)</div>
                                <footer class="wedding-card-sheet__footer"><span>@Vm.CoupleName</span><span>↕ @Text["public.scroll"]</span><span>@Text["public.thankyou"]</span></footer>
                            </section>
                        }
                    </article>
                </PageContent>
            </LayoutTransitionSurface>
            <p class="wedding-card-navigation__hint">@Text["public.card.navigation.hint"]</p>
        </section>
    }
    else if (UsePhotoBookLayout)
    {
        var bookPages = PhotoBookReaderPages;
        <section class="wedding-layout-photobook" aria-label="@(L("public.photobook.aria", Vm.CoupleName))">
            <section class="wedding-photobook-pages"><header class="wedding-photobook-heading"><p class="wedding-layout-kicker">@Text["public.photobook.label"]</p><h2>@Text["public.photobook.title"]</h2></header>
                <div class="wedding-photobook-reader">
                    <LayoutTransitionSurface Presentation="LayoutPresentationMode.PagedBook" Transition="@PhotoBookTransition" PageCount="@bookPages.Count" ActiveIndex="@_bookPageIndex" ActiveIndexChanged="OnBookPageChanged" PageLabel="BookPageLabel" AriaLabel="@(L("public.photobook.aria", Vm.CoupleName))">
                        <PageContent Context="pageIndex">@RenderPhotoBookReaderPage(bookPages[Math.Clamp(pageIndex, 0, bookPages.Count - 1)])</PageContent>
                        <ReplicaContent Context="pageIndex">@RenderPhotoBookReplica(bookPages[Math.Clamp(pageIndex, 0, bookPages.Count - 1)])</ReplicaContent>
                    </LayoutTransitionSurface>
                </div>
            </section>
        </section>
    }
    else if (UseGalleryLayout)
    {
        <section class="wedding-layout-gallery w-layout-gallery">
            <section class="wedding-gallery-cover" role="banner">
                @if (!string.IsNullOrWhiteSpace(Vm.HeroImageUrl))
                {
                    <div class="wedding-gallery-cover__media" data-hero-crop-container>
                        <img class="wedding-gallery-cover__image" data-hero-crop-image src="@Vm.HeroImageUrl" alt="@(L("public.hero.photo.alt", Vm.CoupleName))" />
                    </div>
                }
                else
                {
                    <div class="wedding-gallery-cover__image wedding-gallery-cover__image--empty"></div>
                }
                <div class="wedding-gallery-cover__panel">
                    <p class="wedding-layout-kicker">@Vm.HeroTitle</p>
                    <h1>@Vm.CoupleName</h1>
                    <p>@L("public.hero.date.thanks", WeddingDateText)</p>
                    @if (!string.IsNullOrWhiteSpace(Vm.VenueName))
                    {
                        <p class="wedding-layout-muted">@Vm.VenueName</p>
                    }
                </div>
            </section>

            @foreach (var section in Vm.OrderedSections.Where(x => x != "hero"))
            {
                @RenderPremiumGallerySection(section)
            }
        </section>
    }
    else if (UseStoryLayout)
    {
        @* ══ Story 레이아웃 — 챕터 흐름형 (Gallery 앨범형과 시각적으로 구분) ══ *@
        <section class="wedding-layout-story w-layout-story">

            @foreach (var section in Vm.OrderedSections.Where(x => x != "hero"))
            {
                @RenderPremiumStorySection(section)
            }
        </section>
    }
    else if (!UseTabs || ActiveTab == "hero")
    {
    <section class="w-hero w-hero--thankyou w-hero--thankyou-positioned w-hero--style-@Vm.ThankYouStyle w-hero--dh-@Vm.HeroPanelHorizontalDesktop w-hero--mh-@Vm.HeroPanelHorizontalMobile" role="banner">
        @if (!string.IsNullOrWhiteSpace(Vm.HeroImageUrl))
        {
            <div class="w-hero__bg" data-hero-crop-container>
                <img class="w-hero__image w-hero__image--backdrop" src="@Vm.HeroImageUrl" alt="" aria-hidden="true" />
                <img class="w-hero__image w-hero__image--foreground" data-hero-crop-image src="@Vm.HeroImageUrl" alt="@(L("public.hero.photo.alt", Vm.CoupleName))" />
            </div>
        }
        else
        {
            <div class="w-hero__bg w-hero__bg--default"></div>
        }
        <div class="w-hero__overlay"></div>
        <div class="w-hero__content">
            <div class="w-hero__top w-panel w-hero-panel--dv-@Vm.HeroPanelVerticalDesktop w-hero-panel--dh-@Vm.HeroPanelHorizontalDesktop w-hero-panel--mv-@Vm.HeroPanelVerticalMobile w-hero-panel--mh-@Vm.HeroPanelHorizontalMobile @(Vm.HasCustomHeroPanelPosition ? "w-draggable-positioned" : "") @(AdminPreview ? "w-design-draggable" : "")"
                 data-drag-target="heroThankYou"
                 style="@Vm.HeroPanelStyle">
                <h1 class="w-hero__title">@Text["public.thankyou"]</h1>
                <p class="w-hero__names">@Vm.CoupleName</p>
                <p class="w-hero__date">@L("public.hero.date.thanks", WeddingDateText)</p>
            </div>
        </div>
    </section>
    }

    @if (!UsePremiumLayout)
    {
        @foreach (var section in Vm.OrderedSections.Where(x => x != "hero"))
        {
            if (!UseTabs || ActiveTab == section)
            {
                @RenderStandardSection(section)
            }
        }
    }

    <footer class="w-footer">
        @if (!string.IsNullOrWhiteSpace(Vm.InvitationUrl))
        {
            <a href="@Vm.InvitationUrl" target="_blank" rel="noopener">@Text["public.invitation.open"]</a>
            <span> · </span>
        }
        <a href="@AdminUrl" class="w-admin-link">⚙ @Text["public.admin.open"]</a>
    </footer>
    @if (UsePremiumLayout)
    {
        <PhotoLightbox Photos="@Vm.AllPhotos"
                       IsOpen="@premiumPhotoLightboxOpen"
                       CurrentIndex="@premiumPhotoLightboxIndex"
                       CurrentIndexChanged="OnPremiumPhotoIndexChanged"
                       Closed="ClosePremiumPhoto" />
    }
    @if (videoLightboxOpen && Vm.VideoUrls.Count > 0)
    {
        <div class="w-lightbox" role="dialog" aria-modal="true" aria-label="@Text["public.video.title"]" tabindex="-1" @ref="vlbRef" @onkeydown="OnVideoKeyDown">
            <button class="w-lb__close" @onclick="CloseVideoLightbox" aria-label="@Text["public.lightbox.close"]">✕</button>
            @if (Vm.VideoUrls.Count > 1)
            {
                <button class="w-lb__prev" @onclick="VideoPrev" aria-label="@Text["public.video.previous"]">‹</button>
            }
            <video class="w-lb__video" src="@Vm.VideoUrls[videoLightboxIdx]" controls autoplay playsinline @onplay="PauseMusicForVideo"></video>
            @if (Vm.VideoUrls.Count > 1)
            {
                <button class="w-lb__next" @onclick="VideoNext" aria-label="@Text["public.video.next"]">›</button>
                <span class="w-lb__counter">@(videoLightboxIdx + 1) / @Vm.VideoUrls.Count</span>
            }
        </div>
        <div class="w-lb__backdrop" @onclick="CloseVideoLightbox"></div>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "adminPreview")] public bool AdminPreview { get; set; }
    [SupplyParameterFromQuery(Name = "lang")] public string? Language { get; set; }
    private static readonly string[] SupportedLanguageCodes = ThankYouLocalization.Languages.Select(item => item.Code).ToArray();
    private string AdminUrl => $"/{Slug}/admin?lang={Uri.EscapeDataString(Text.Language)}";

    private ElementReference lbRef;
    private ElementReference vlbRef;
    private ElementReference audioRef;
    private bool isMusicPlaying;
    private bool musicSyncInitialized;
    private double? startX;
    private bool isAutoPlaying;
    private System.Threading.CancellationTokenSource? autoCts;

    private bool shouldFocusLightbox;
    private bool videoLightboxOpen;
    private int videoLightboxIdx;
    private bool shouldFocusVideoLightbox;

    private DotNetObjectReference<ThankYou>? _selfRef;
    private string? _appliedDocumentLanguage;
    private bool _themeNeedsApply = true;

    // ── 탭 스타일 상태 ─────────────────────────────────
    private string ActiveTab { get; set; } = "hero";
    private bool UseTabs => Vm.LayoutMode == WeddingLayoutMode.TabMenu;
    private bool UseGalleryLayout => Vm.LayoutMode == WeddingLayoutMode.Gallery;
    private bool UseStoryLayout => Vm.LayoutMode == WeddingLayoutMode.Story;
    private bool UseCardLayout => Vm.LayoutMode == WeddingLayoutMode.Card;
    private bool UsePhotoBookLayout => Vm.LayoutMode == WeddingLayoutMode.PhotoBook;
    private int _cardPageIndex;
    private int _bookPageIndex;
    private static readonly LayoutTransitionDefinition CardTransition = new() { Kind = LayoutTransitionKind.FlipCard, DurationMilliseconds = 720, EnableSwipe = true, EnableKeyboard = true, ShowNavigation = true };
    private static readonly LayoutTransitionDefinition PhotoBookTransition = new() { Kind = LayoutTransitionKind.PageTurn, DurationMilliseconds = 900, EnableSwipe = true, EnableKeyboard = true, ShowNavigation = true };
    private IReadOnlyList<string?> CardPages => new string?[] { null }
        .Concat(Vm.OrderedSections.Where(x => x != "hero" && IsAvailable(x)).Cast<string?>()).ToList();
    private string L(string key, params object?[] arguments)
        => arguments.Length == 0 ? Text[key] : string.Format(Text[key], arguments);
    private string WeddingDateText => Text.FormatDate(Vm.WeddingDate);
    private string SectionLabel(string section)
    {
        var key = $"public.section.{section.ToLowerInvariant()}";
        var localized = Text[key];
        return string.Equals(localized, key, StringComparison.OrdinalIgnoreCase)
            ? WeddingSectionOrderCatalog.GetLabel(section)
            : localized;
    }
    private Task OnCardPageChanged(int index) { _cardPageIndex = index; return Task.CompletedTask; }
    private string CardPageLabel(int index) => CardPages[Math.Clamp(index, 0, CardPages.Count - 1)] is { } section
        ? SectionLabel(section)
        : Text["public.card.cover"];
    private CardHighlight? ResolveCardHighlight(string section) => Vm.CardHighlights
        .OrderBy(x => x.Order).FirstOrDefault(x => string.Equals(x.SectionKey, section, StringComparison.OrdinalIgnoreCase));
    private sealed record PhotoBookReaderPage(
        string Kind,
        PhotoBookPage? PhotoPage = null,
        string? Section = null,
        PhotoInfo? Photo = null);

    private IReadOnlyList<PhotoBookReaderPage> PhotoBookReaderPages => ResolvePhotoBookReaderPages();

    private List<PhotoBookReaderPage> ResolvePhotoBookReaderPages()
    {
        var pages = new List<PhotoBookReaderPage>
        {
            new("cover"),
        };

        foreach (var section in Vm.OrderedSections.Where(section =>
                     !string.Equals(section, "hero", StringComparison.OrdinalIgnoreCase)))
        {
            if (string.Equals(section, "gallery", StringComparison.OrdinalIgnoreCase))
            {
                pages.AddRange(ResolvePhotoBookPhotoPages());
                continue;
            }

            if (IsAvailable(section))
            {
                pages.Add(new PhotoBookReaderPage("section", Section: section));
            }
        }

        return pages;
    }

    private IEnumerable<PhotoBookReaderPage> ResolvePhotoBookPhotoPages()
    {
        var photos = Vm.AllPhotos;
        var used = new HashSet<int>();
        var result = new List<PhotoBookReaderPage>(Math.Max(Vm.PhotoBookPages.Count, photos.Count));

        foreach (var configuredPage in Vm.PhotoBookPages.OrderBy(page => page.PageNumber))
        {
            var matchedIndex = FindPhotoBookPhotoIndex(configuredPage.PhotoFileName, used);
            if (matchedIndex < 0)
            {
                matchedIndex = FindFirstUnusedPhotoBookPhotoIndex(used);
            }

            if (matchedIndex >= 0)
            {
                used.Add(matchedIndex);
            }

            result.Add(new PhotoBookReaderPage(
                "photo",
                configuredPage,
                Photo: matchedIndex >= 0 ? photos[matchedIndex] : null));
        }

        var nextPageNumber = Math.Max(
            1,
            Vm.PhotoBookPages.Select(page => page.PageNumber).DefaultIfEmpty(0).Max() + 1);
        for (var i = 0; i < photos.Count; i++)
        {
            if (used.Contains(i))
            {
                continue;
            }

            var pageNumber = nextPageNumber++;
            result.Add(new PhotoBookReaderPage(
                "photo",
                new PhotoBookPage
                {
                    PageNumber = pageNumber,
                    PhotoFileName = photos[i].FileName,
                    Caption = L("public.page.number", pageNumber),
                },
                Photo: photos[i]));
        }

        return result;
    }

    private int FindPhotoBookPhotoIndex(string? fileName, HashSet<int> used)
    {
        if (string.IsNullOrWhiteSpace(fileName))
        {
            return -1;
        }

        for (var i = 0; i < Vm.AllPhotos.Count; i++)
        {
            if (!used.Contains(i)
                && string.Equals(Vm.AllPhotos[i].FileName, fileName, StringComparison.OrdinalIgnoreCase))
            {
                return i;
            }
        }

        return -1;
    }

    private int FindFirstUnusedPhotoBookPhotoIndex(HashSet<int> used)
    {
        for (var i = 0; i < Vm.AllPhotos.Count; i++)
        {
            if (!used.Contains(i))
            {
                return i;
            }
        }

        return -1;
    }
    private Task OnBookPageChanged(int index) { _bookPageIndex = index; return Task.CompletedTask; }
    private string BookPageLabel(int index)
    {
        var page = PhotoBookReaderPages[Math.Clamp(index, 0, PhotoBookReaderPages.Count - 1)];
        return page.Kind == "cover"
            ? Text["public.photobook.cover"]
            : page.PhotoPage?.Caption ?? (page.Section is null ? Text["public.photobook.label"] : SectionLabel(page.Section));
    }
    private RenderFragment RenderPhotoBookReaderPage(PhotoBookReaderPage readerPage) => @<article class="wedding-photobook-page @(readerPage.Kind == "section" ? "wedding-photobook-page--section" : "")">
        @if (readerPage.Kind == "cover")
        {
            <section class="wedding-photobook-cover w-hero--invite-positioned"
                     role="banner"
                     data-drag-container
                     data-hero-crop-container>
                @if (!string.IsNullOrWhiteSpace(Vm.HeroImageUrl))
                {
                    <img class="wedding-photobook-cover__image wedding-photobook-cover__image--backdrop" src="@Vm.HeroImageUrl" alt="" aria-hidden="true" />
                    <img class="wedding-photobook-cover__image wedding-photobook-cover__image--foreground" data-hero-crop-image src="@Vm.HeroImageUrl" alt="@(L("public.hero.photo.alt", Vm.CoupleName))" />
                }
                else
                {
                    <div class="wedding-photobook-cover__image wedding-photobook-cover__image--empty"></div>
                }
                <div class="wedding-photobook-cover__veil"></div>
                <div class="wedding-photobook-cover__panel">
                    <div class="wedding-photobook-cover__copy wedding-photobook-cover__copy--top w-panel w-hero__top
                                w-hero-panel--dv-@Vm.HeroPanelVerticalDesktop
                                w-hero-panel--dh-@Vm.HeroPanelHorizontalDesktop
                                w-hero-panel--mv-@Vm.HeroPanelVerticalMobile
                                w-hero-panel--mh-@Vm.HeroPanelHorizontalMobile
                                @(Vm.HasCustomHeroTopPanelPosition ? "w-draggable-positioned" : "")
                                @(AdminPreview ? "w-design-draggable" : "")"
                         data-drag-target="heroTop"
                         @onpointerdown:stopPropagation
                         @onpointerup:stopPropagation
                         style="@Vm.HeroTopPanelStyle">
                        <p class="wedding-layout-kicker">@Vm.HeroTitle</p><h1>@Vm.CoupleName</h1>
                    </div>
