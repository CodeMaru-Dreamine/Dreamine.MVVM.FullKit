@inject ThankYouLocalization Text
@implements IDisposable

<label class="w-local-file @Class">
    <InputFile class="w-local-file__native"
               OnChange="HandleChange"
               accept="@Accept"
               multiple="@Multiple"
               disabled="@Disabled" />
    <span class="w-local-file__button">@Text["file.choose"]</span>
    <span class="w-local-file__name" title="@_selectionLabel">@_selectionLabel</span>
</label>

@code {
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }
    [Parameter] public string? Accept { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private string _selectionLabel = string.Empty;
    private string? _selectedFileName;
    private int _selectedFileCount;

    protected override void OnInitialized()
    {
        Text.Changed += OnLanguageChanged;
        RefreshSelectionLabel();
    }

    private async Task HandleChange(InputFileChangeEventArgs args)
    {
        _selectedFileCount = args.FileCount;
        _selectedFileName = args.FileCount == 1 ? args.File.Name : null;
        RefreshSelectionLabel();
        await OnChange.InvokeAsync(args);
    }

    private void RefreshSelectionLabel()
    {
        _selectionLabel = _selectedFileCount switch
        {
            0 => Text["file.none"],
            1 => _selectedFileName ?? Text["file.none"],
            _ => string.Format(Text["file.selected.count"], _selectedFileCount),
        };
    }

    private void OnLanguageChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshSelectionLabel();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Text.Changed -= OnLanguageChanged;
    }
}
