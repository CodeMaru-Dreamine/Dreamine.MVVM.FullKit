<Window x:Class="Wedding.Layouts.Editor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:contracts="clr-namespace:Wedding.Layouts.Contracts;assembly=Wedding.Layouts.Contracts"
        Title="코드마루 청첩장 레이아웃 편집기"
        Width="1480"
        Height="900"
        MinWidth="1180"
        MinHeight="740"
        Background="#F6F2ED"
        FontFamily="Malgun Gothic"
        Closing="MainWindow_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="14,11"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Text="청첩장 레이아웃 만들기" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="#766B62"
                               Text="섹션을 골라 배치하고, 오른쪽에서 모양을 다듬으세요." />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Click="NewStarter_Click" Content="새 레이아웃" />
                    <Button Click="Open_Click" Content="파일 열기…" />
                    <Button Click="Save_Click" Content="저장" />
                    <Button Click="SaveAs_Click" Content="다른 이름으로 저장…" />
                    <Button Click="Validate_Click" Content="문제 확인" />
                    <Button Margin="8,0,0,0"
                            Click="ShowEasyHelp_Click"
                            Content="사용법" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            MinWidth="230"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="AdvancedModeCheckBox"
                              HorizontalAlignment="Right"
                              Checked="AdvancedModeCheckBox_Changed"
                              Content="고급 도구 보기"
                              Unchecked="AdvancedModeCheckBox_Changed" />
                    <TextBlock x:Name="FilePathText"
                               Margin="12,4,0,0"
                               MaxWidth="330"
                               HorizontalAlignment="Right"
                               Foreground="#6C6259"
                               Text="아직 저장되지 않은 레이아웃"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="EditorModeTabs"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0">
            <TabItem x:Name="EasyEditorTab" Header="간편 편집">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.ColumnSpan="5"
                            Margin="0,0,0,8"
                            Padding="12,8"
                            Background="#FFF7E8"
                            BorderBrush="#E3C69E"
                            BorderThickness="1"
                            CornerRadius="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="18,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#8C6742"
                                       FontWeight="SemiBold"
                                       Text="실제 이름·계좌·지도 내용은 웹 청첩장 관리 화면에서 입력" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#51463C"
                                       Text="① 왼쪽에서 섹션 선택/추가  →  ② 가운데 프레임 안을 스크롤해 카드 선택  →  ③ 오른쪽에서 꾸미기  →  ④ 문제 확인·저장"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Padding="14"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Text="1. 섹션 선택/추가" />
                                <TextBlock Margin="0,3,0,14"
                                           Foreground="#766B62"
                                           Text="이미 있으면 해당 섹션으로 이동하고, 없으면 완성된 형태로 추가합니다."
                                           TextWrapping="Wrap" />

                                <UniformGrid Columns="2">
                                    <Button Margin="0,0,6,8"
                                            Padding="8,10"
                                            Click="AddSectionPreset_Click"
                                            Content="♡  표지"
                                            Tag="Hero" />
                                    <Button Margin="0,0,0,8"
                                            Padding="8,10"
                                            Click="AddSectionPreset_Click"
                                            Content="✉  초대 글"
                                            Tag="Invitation" />
                                    <Button Margin="0,0,6,8"
                                            Padding="8,10"
                                            Click="AddSectionPreset_Click"
                                            Content="▣  예식 안내"
                                            Tag="Calendar" />
                                    <Button Margin="0,0,0,8"
                                            Padding="8,10"
                                            Click="AddSectionPreset_Click"
                                            Content="▧  사진첩"
                                            Tag="Gallery" />
                                    <Button Margin="0,0,6,8"
                                            Padding="8,10"
                                            Click="AddSectionPreset_Click"
                                            Content="❦  이야기"
                                            Tag="Story" />
                                    <Button Margin="0,0,0,8"
                                            Padding="8,10"
                                            Click="AddSectionPreset_Click"
                                            Content="▶  영상"
                                            Tag="Video" />
                                    <Button Margin="0,0,6,8"
                                            Padding="8,10"
                                            Click="AddSectionPreset_Click"
                                            Content="⌖  오시는 길"
                                            Tag="Location" />
                                    <Button Margin="0,0,0,8"
                                            Padding="8,10"
                                            Click="AddSectionPreset_Click"
                                            Content="▤  계좌 안내"
                                            Tag="Accounts" />
                                    <Button Margin="0,0,6,8"
                                            Padding="8,10"
                                            Click="AddSectionPreset_Click"
                                            Content="✎  방명록"
                                            Tag="Guestbook" />
                                    <Button Margin="0,0,0,8"
                                            Padding="8,10"
                                            Click="AddSectionPreset_Click"
                                            Content="☎  연락하기"
                                            Tag="Contact" />
                                </UniformGrid>
                                <Button x:Name="RemoveSelectedSectionButton"
                                        Margin="0,2,0,0"
                                        HorizontalContentAlignment="Center"
                                        Click="RemoveEasySection_Click"
                                        Content="−  선택한 섹션 빼기"
                                        ToolTip="가운데 화면에서 선택한 섹션을 레이아웃에서 제거합니다." />

                                <Separator Margin="0,10,0,14" />
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="보여 주는 방식" />
                                <ComboBox x:Name="EasyPresentationComboBox"
                                          Margin="0,7,0,4"
                                          DisplayMemberPath="Label"
                                          ItemsSource="{Binding FriendlyPresentationOptions}"
                                          SelectionChanged="EasyPresentationComboBox_SelectionChanged" />
                                <TextBlock x:Name="EasyPresentationDescriptionText"
                                           Margin="0,0,0,12"
                                           Foreground="#766B62"
                                           TextWrapping="Wrap" />

                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="대표 색상" />
                                <TextBlock Margin="0,3,0,8"
                                           Foreground="#766B62"
                                           Text="하나만 고르면 읽기 편한 나머지 색상을 자동으로 맞춥니다."
                                           TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Width="34"
                                            Height="34"
                                            MinWidth="0"
                                            Margin="0,0,8,8"
                                            Padding="0"
                                            Background="#B88A58"
                                            BorderBrush="#8F6840"
                                            Click="ThemeColor_Click"
                                            Tag="#B88A58"
                                            ToolTip="로즈 골드" />
                                    <Button Width="34"
                                            Height="34"
                                            MinWidth="0"
                                            Margin="0,0,8,8"
                                            Padding="0"
                                            Background="#6F8B73"
                                            BorderBrush="#4F6853"
                                            Click="ThemeColor_Click"
                                            Tag="#6F8B73"
                                            ToolTip="포레스트 그린" />
                                    <Button Width="34"
                                            Height="34"
                                            MinWidth="0"
                                            Margin="0,0,8,8"
                                            Padding="0"
                                            Background="#385C7A"
                                            BorderBrush="#263F54"
                                            Click="ThemeColor_Click"
                                            Tag="#385C7A"
                                            ToolTip="네이비 블루" />
                                    <Button Width="34"
                                            Height="34"
                                            MinWidth="0"
                                            Margin="0,0,8,8"
                                            Padding="0"
                                            Background="#B77B83"
                                            BorderBrush="#895A61"
                                            Click="ThemeColor_Click"
                                            Tag="#B77B83"
                                            ToolTip="블러쉬 핑크" />
                                    <Button Width="34"
                                            Height="34"
                                            MinWidth="0"
                                            Margin="0,0,8,8"
                                            Padding="0"
                                            Background="#6D5A75"
                                            BorderBrush="#4C3E52"
                                            Click="ThemeColor_Click"
                                            Tag="#6D5A75"
                                            ToolTip="플럼" />
                                </WrapPanel>
                                <TextBlock x:Name="EasyThemeStatusText"
                                           Margin="0,1,0,0"
                                           Foreground="#6A7A65"
                                           Text="현재 패키지의 색상을 유지하고 있습니다."
                                           TextWrapping="Wrap" />

                                <Separator Margin="0,14,0,14" />
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="미리보기 자료" />
                                <TextBlock Margin="0,3,0,8"
                                           Foreground="#766B62"
                                           Text="실제 사진·영상·음악을 넣어 전체 분위기를 확인합니다. 이 파일들은 레이아웃 JSON에 저장되지 않습니다."
                                           TextWrapping="Wrap" />
                                <Button Margin="0,0,0,7"
                                        HorizontalContentAlignment="Left"
                                        Click="ChoosePreviewPhotos_Click"
                                        Content="▧  사진 선택…" />
                                <Button Margin="0,0,0,7"
                                        HorizontalContentAlignment="Left"
                                        Click="ChoosePreviewVideo_Click"
                                        Content="▶  영상 선택…" />
                                <Button Margin="0,0,0,7"
                                        HorizontalContentAlignment="Left"
                                        Click="ChoosePreviewAudio_Click"
                                        Content="♫  배경음악 선택…" />
                                <Button Margin="0,0,0,8"
                                        HorizontalContentAlignment="Left"
                                        Click="ResetPreviewMedia_Click"
                                        Content="↺  기본 샘플로 되돌리기" />
                                <TextBlock x:Name="PreviewMediaSummaryText"
                                           Foreground="#6A7A65"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="2"
                            Padding="14"
                            Background="#EDE7DF"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="18"
                                               FontWeight="Bold"
                                               Text="2. 화면 구성" />
                                    <TextBlock Margin="0,3,0,10"
                                               Foreground="#766B62"
                                               Text="청첩장 프레임 안에서 마우스 휠로 이동하고, 꾸밀 카드를 클릭하세요." />
                                    <TextBlock x:Name="EasyPreviewModeText"
                                               Margin="0,-6,0,10"
                                               Foreground="#8C6742"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,-6,0,10"
                                               Foreground="#766B62"
                                               FontSize="12"
                                               Text="폰·PC 프레임은 고정된 작업 화면이며 내용만 내부에서 스크롤됩니다. 세로 스크롤·카드·포토북 구성은 즉시 바뀌고, 세부 반응형 덮어쓰기와 실제 3D 책장 전환은 고급 도구에서 확인합니다."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                    <Button x:Name="PhonePreviewButton"
                                            MinWidth="54"
                                            Background="#D8B488"
                                            BorderBrush="#B88A58"
                                            Click="PreviewDevice_Click"
                                            Content="폰"
                                            Tag="Phone" />
                                    <Button x:Name="PcPreviewButton"
                                            MinWidth="54"
                                            Margin="0"
                                            Click="PreviewDevice_Click"
                                            Content="PC"
                                            Tag="Pc" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Border x:Name="EasyPreviewFrame"
                                        Width="370"
                                        Height="640"
                                        Margin="18,8,18,18"
                                        Padding="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Background="#FFFDFC"
                                        BorderBrush="#26221E"
                                        BorderThickness="7"
                                        CornerRadius="28">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Width="62"
                                                Height="7"
                                                Margin="0,0,0,10"
                                                HorizontalAlignment="Center"
                                                Background="#292522"
                                                CornerRadius="4" />
                                        <Border Grid.Row="1"
                                                Margin="0,0,0,9"
                                                Padding="9,6"
                                                Background="#F2E9DF"
                                                BorderBrush="#DDCDBB"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <DockPanel>
                                                <Button x:Name="PreviewAudioToggleButton"
                                                        DockPanel.Dock="Right"
                                                        MinWidth="48"
                                                        Margin="8,0,0,0"
                                                        Padding="7,3"
                                                        Click="TogglePreviewAudio_Click"
                                                        Content="재생" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Margin="0,0,7,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="16"
                                                               Text="♫" />
                                                    <TextBlock x:Name="PreviewAudioTitleText"
                                                               MaxWidth="220"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Text="미리보기 음악"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <MediaElement x:Name="PreviewAudioPlayer"
                                                      Grid.Row="1"
                                                      Width="0"
                                                      Height="0"
                                                      IsHitTestVisible="False"
                                                      LoadedBehavior="Manual"
                                                      MediaEnded="PreviewAudioPlayer_MediaEnded"
                                                      MediaFailed="PreviewMediaPlayer_MediaFailed"
                                                      Opacity="0"
                                                      UnloadedBehavior="Stop"
                                                      Volume=".55" />
                                        <ListBox x:Name="EasySectionList"
                                                 Grid.Row="2"
                                                 Padding="0,2,4,10"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemsSource="{Binding EasySections}"
                                                 SelectionChanged="EasySectionList_SelectionChanged"
                                                 ScrollViewer.CanContentScroll="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.PanningMode="VerticalOnly"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Tag="Flow"
                                                 Visibility="Visible">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Margin" Value="0,0,0,9" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                           Value="Single" />
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}"
                                                                           Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="SectionPreviewCard"
                                                            Padding="0"
                                                            Background="{Binding SectionBackground}"
                                                            BorderBrush="{Binding SectionBorderBrush}"
                                                            BorderThickness="{Binding SectionBorderThickness}"
                                                            ClipToBounds="True"
                                                            CornerRadius="12"
                                                            TextElement.Foreground="{Binding TextBrush}">
                                                        <StackPanel>
                                                            <Grid x:Name="HeroMediaPreview"
                                                                  Height="360"
                                                                  Background="#27211D"
                                                                  Visibility="Collapsed">
                                                                <Image Source="{Binding HeroImage}"
                                                                       Stretch="UniformToFill" />
                                                                <Rectangle VerticalAlignment="Bottom"
                                                                           Height="155">
                                                                    <Rectangle.Fill>
                                                                        <LinearGradientBrush StartPoint=".5,0"
                                                                                             EndPoint=".5,1">
                                                                            <GradientStop Offset="0"
                                                                                          Color="#00100B08" />
                                                                            <GradientStop Offset="1"
                                                                                          Color="#D8120E0B" />
                                                                        </LinearGradientBrush>
                                                                    </Rectangle.Fill>
                                                                </Rectangle>
                                                                <StackPanel Margin="20"
                                                                            VerticalAlignment="Bottom">
                                                                    <TextBlock Margin="0,0,0,6"
                                                                               HorizontalAlignment="Center"
                                                                               FontFamily="Georgia"
                                                                               FontSize="10"
                                                                               Foreground="#F1D8BE"
                                                                               Text="OUR MIDNIGHT BEGINNING" />
                                                                    <TextBlock HorizontalAlignment="Center"
                                                                               FontFamily="Georgia"
                                                                               FontSize="22"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="White"
                                                                               Text="{Binding PreviewTitle}" />
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="#F8EEE5"
                                                                               Text="{Binding PreviewBody}"
                                                                               TextAlignment="Center"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <StackPanel x:Name="InvitationContentPreview"
                                                                        Margin="{Binding ContentMargin}"
                                                                        Visibility="Collapsed">
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           FontFamily="Georgia"
                                                                           FontSize="11"
                                                                           Foreground="{Binding AccentBrush}"
                                                                           Text="WEDDING INVITATION" />
                                                                <TextBlock Margin="0,8,0,10"
                                                                           HorizontalAlignment="Center"
                                                                           FontFamily="Georgia"
                                                                           FontSize="21"
                                                                           Text="{Binding PreviewTitle}" />
                                                                <Border Width="34"
                                                                        Height="1"
                                                                        Margin="0,0,0,14"
                                                                        Background="{Binding AccentBrush}" />
                                                                <TextBlock FontSize="13"
                                                                           Foreground="#625850"
                                                                           LineHeight="23"
                                                                           Text="서로의 계절을 함께 걷고 싶은 두 사람이&#x0a;소중한 분들을 모시고 새로운 시작을 약속합니다.&#x0a;&#x0a;따뜻한 축복으로 자리를 빛내 주시면&#x0a;더없는 기쁨으로 간직하겠습니다."
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,17,0,0"
                                                                           HorizontalAlignment="Center"
                                                                           FontWeight="SemiBold"
                                                                           Text="김현우 · 박지은" />
                                                            </StackPanel>

                                                            <StackPanel x:Name="CalendarContentPreview"
                                                                        Margin="{Binding ContentMargin}"
                                                                        Visibility="Collapsed">
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           FontFamily="Georgia"
                                                                           FontSize="10"
                                                                           Foreground="{Binding AccentBrush}"
                                                                           Text="WEDDING INFORMATION" />
                                                                <TextBlock Margin="0,7,0,12"
                                                                           HorizontalAlignment="Center"
                                                                           FontFamily="Georgia"
                                                                           FontSize="21"
                                                                           Text="예식 안내" />
                                                                <TextBlock Margin="0,0,0,15"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="#8A7768"
                                                                           LineHeight="21"
                                                                           Text="깊어가는 가을 저녁,&#x0a;저희 두 사람의 새로운 시작을 함께해 주세요."
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           FontFamily="Georgia"
                                                                           FontSize="18"
                                                                           Text="OCTOBER 2029" />
                                                                <TextBlock Margin="0,5,0,16"
                                                                           HorizontalAlignment="Center"
                                                                           FontWeight="SemiBold"
                                                                           Text="10월 13일 토요일 · 오후 5시 30분" />
                                                                <UniformGrid Margin="0,0,0,6"
                                                                             Columns="7">
                                                                    <TextBlock HorizontalAlignment="Center" Foreground="#C66C6C" Text="일" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="월" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="화" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="수" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="목" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="금" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="토" />
                                                                </UniformGrid>
                                                                <UniformGrid Columns="7">
                                                                    <TextBlock HorizontalAlignment="Center" Foreground="#B9ADA4" Text="" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="1" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="2" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="3" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="4" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="5" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="6" />
                                                                    <TextBlock HorizontalAlignment="Center" Foreground="#C66C6C" Text="7" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="8" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="9" />
