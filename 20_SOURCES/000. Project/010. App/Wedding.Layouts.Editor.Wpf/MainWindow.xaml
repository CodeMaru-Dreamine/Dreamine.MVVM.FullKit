            </TabItem>

            <TabItem x:Name="AdvancedEditorTab"
                     Header="고급 도구"
                     Visibility="Collapsed">
                <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="패키지 정보" />

                        <TextBlock Text="Layout key" />
                        <TextBox x:Name="KeyTextBox"
                                 LostKeyboardFocus="KeyTextBox_LostKeyboardFocus"
                                 TextChanged="EditorTextValue_Changed"
                                 ToolTip="소문자, 숫자, 하이픈만 사용할 수 있습니다." />

                        <TextBlock Text="Version" />
                        <TextBox x:Name="VersionTextBox"
                                 TextChanged="EditorTextValue_Changed"
                                 ToolTip="예: 1.0.0" />

                        <TextBlock Text="표시 이름" />
                        <TextBox x:Name="LabelTextBox"
                                 TextChanged="EditorTextValue_Changed" />

                        <TextBlock Text="설명" />
                        <TextBox x:Name="DescriptionTextBox"
                                 AcceptsReturn="True"
                                 Height="70"
                                 TextChanged="EditorTextValue_Changed"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="정책 서버 (읽기 전용)" />
                        <DockPanel Margin="0,4,0,6">
                            <Button x:Name="RefreshTierPolicyButton"
                                    DockPanel.Dock="Right"
                                    MinWidth="58"
                                    Margin="6,0,0,0"
                                    Padding="8,4"
                                    Click="RefreshTierPolicy_Click"
                                    Content="조회" />
                            <TextBox x:Name="PolicyServerTextBox"
                                     Margin="0"
                                     Text="https://wedding.codemaru.co.kr"
                                     ToolTip="운영 또는 로컬 Wedding 서버의 기본 주소입니다." />
                        </DockPanel>

                        <TextBlock Text="등급 (실제 서버 정책)" />
                        <Border Margin="0,4,0,6"
                                Padding="8"
                                Background="#F3EEE8"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="TierPolicyValueText"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>
                        <TextBlock x:Name="TierPolicyText"
                                   Margin="0,0,0,8"
                                   Foreground="#6C6259"
                                   TextWrapping="Wrap" />

                        <GroupBox Header="페이지 프레젠테이션">
                            <StackPanel>
                                <TextBlock Text="표현 방식" />
                                <ComboBox x:Name="PresentationComboBox"
                                          ItemsSource="{Binding PresentationOptions}"
                                          SelectionChanged="PresentationComboBox_SelectionChanged"
                                          ToolTip="Flow는 세로 문서, FlipCard는 카드 덱, PagedBook은 펼침 책으로 렌더링됩니다." />

                                <TextBlock Text="전환 효과" />
                                <ComboBox x:Name="TransitionKindComboBox"
                                          ItemsSource="{Binding TransitionKindOptions}"
                                          SelectionChanged="EditorSelectionValue_Changed" />

                                <TextBlock Text="전환 시간 (150~2000ms)" />
                                <TextBox x:Name="TransitionDurationTextBox"
                                         TextChanged="EditorTextValue_Changed"
                                         ToolTip="웹과 WPF 미리보기가 함께 사용하는 전환 시간입니다." />

                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="TransitionSwipeCheckBox"
                                              Margin="0,0,12,5"
                                              Click="EditorToggleValue_Changed"
                                              Content="스와이프" />
                                    <CheckBox x:Name="TransitionKeyboardCheckBox"
                                              Margin="0,0,12,5"
                                              Click="EditorToggleValue_Changed"
                                              Content="키보드" />
                                    <CheckBox x:Name="TransitionNavigationCheckBox"
                                              Margin="0,0,0,5"
                                              Click="EditorToggleValue_Changed"
                                              Content="이동 버튼" />
                                </WrapPanel>

                                <Button x:Name="TransitionPreviewButton"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Click="PreviewTransition_Click"
                                        Content="전환 미리보기" />

                                <Border Height="116"
                                        Padding="9"
                                        ClipToBounds="True"
                                        Background="#EEE4D8"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Grid>
                                        <Grid x:Name="TransitionPreviewFlatHost">
                                            <Border Margin="20,8,4,0"
                                                    Background="#E5D5C2"
                                                    CornerRadius="6" />
                                            <Border x:Name="TransitionPreviewPage"
                                                    Margin="7,0,17,8"
                                                    Padding="10"
                                                    Background="White"
                                                    BorderBrush="#D5BEA2"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="TransitionPreviewScale"
                                                                        ScaleX="1"
                                                                        ScaleY="1" />
                                                        <RotateTransform x:Name="TransitionPreviewRotate"
                                                                         Angle="0" />
                                                        <TranslateTransform x:Name="TransitionPreviewTranslate"
                                                                            X="0"
                                                                            Y="0" />
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               Foreground="#A27649"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Text="WEDDING INVITATION" />
                                                    <TextBlock x:Name="TransitionPreviewLabel"
                                                               Margin="0,7,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontFamily="Georgia"
                                                               FontSize="17"
                                                               Text="Preview" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!--
                                            PageTurn은 단일 Border의 2D 변형으로 흉내 내지 않는다.
                                            오른쪽 페이지 mesh가 책등(spine)의 Y축을 중심으로 회전하며,
                                            front/back VisualBrush가 각각 실제 양면을 담당한다.
                                        -->
                                        <Grid x:Name="TransitionPreviewBookHost"
                                              Visibility="Collapsed">
                                            <Border Margin="12,77,12,2"
                                                    Background="#24000000"
                                                    CornerRadius="50">
                                                <Border.Effect>
                                                    <BlurEffect Radius="9" />
                                                </Border.Effect>
                                            </Border>

                                            <Viewport3D ClipToBounds="True">
                                                <Viewport3D.Camera>
                                                    <PerspectiveCamera FieldOfView="38"
                                                                       LookDirection="0,-0.04,-4.6"
                                                                       Position="0,0.08,4.6"
                                                                       UpDirection="0,1,0" />
                                                </Viewport3D.Camera>

                                                <ModelVisual3D>
                                                    <ModelVisual3D.Content>
                                                        <Model3DGroup>
                                                            <AmbientLight Color="#FFBEB6AA" />
                                                            <DirectionalLight Color="#FFFFFFFF"
                                                                              Direction="-0.35,-0.25,-1" />

                                                            <!-- 고정된 왼쪽 페이지 -->
                                                            <GeometryModel3D>
                                                                <GeometryModel3D.Geometry>
                                                                    <MeshGeometry3D Positions="-1.68,-1,0 0,-1,0 0,1,0 -1.68,1,0"
                                                                                    TextureCoordinates="0,1 1,1 1,0 0,0"
                                                                                    TriangleIndices="0 1 2 0 2 3" />
                                                                </GeometryModel3D.Geometry>
                                                                <GeometryModel3D.Material>
                                                                    <DiffuseMaterial>
                                                                        <DiffuseMaterial.Brush>
                                                                            <VisualBrush Stretch="Fill">
                                                                                <VisualBrush.Visual>
                                                                                    <Border Width="168"
                                                                                            Height="100"
                                                                                            Padding="12"
                                                                                            Background="#FFFFFCF7"
                                                                                            BorderBrush="#FFD4BEA3"
                                                                                            BorderThickness="1">
                                                                                        <Grid>
                                                                                            <StackPanel VerticalAlignment="Center">
                                                                                                <TextBlock HorizontalAlignment="Center"
                                                                                                           Foreground="#FFA27649"
                                                                                                           FontSize="9"
                                                                                                           FontWeight="Bold"
                                                                                                           Text="PHOTO BOOK" />
                                                                                                <TextBlock Margin="0,5,0,0"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           FontFamily="Georgia"
                                                                                                           FontSize="16"
                                                                                                           Text="01" />
                                                                                            </StackPanel>
                                                                                            <TextBlock HorizontalAlignment="Left"
                                                                                                       VerticalAlignment="Bottom"
                                                                                                       Foreground="#88705A43"
                                                                                                       FontSize="7"
                                                                                                       Text="CURRENT" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </VisualBrush.Visual>
                                                                            </VisualBrush>
                                                                        </DiffuseMaterial.Brush>
                                                                    </DiffuseMaterial>
                                                                </GeometryModel3D.Material>
                                                            </GeometryModel3D>

                                                            <!-- 회전 페이지 아래에서 미리 준비되는 다음 오른쪽 페이지 -->
                                                            <GeometryModel3D>
                                                                <GeometryModel3D.Geometry>
                                                                    <MeshGeometry3D Positions="0,-1,-0.01 1.68,-1,-0.01 1.68,1,-0.01 0,1,-0.01"
                                                                                    TextureCoordinates="0,1 1,1 1,0 0,0"
                                                                                    TriangleIndices="0 1 2 0 2 3" />
                                                                </GeometryModel3D.Geometry>
                                                                <GeometryModel3D.Material>
                                                                    <DiffuseMaterial>
                                                                        <DiffuseMaterial.Brush>
                                                                            <VisualBrush Stretch="Fill">
                                                                                <VisualBrush.Visual>
                                                                                    <Border Width="168"
                                                                                            Height="100"
                                                                                            Padding="12"
                                                                                            Background="#FFFFFCF7"
                                                                                            BorderBrush="#FFD4BEA3"
                                                                                            BorderThickness="1">
                                                                                        <Grid>
                                                                                            <StackPanel VerticalAlignment="Center">
                                                                                                <TextBlock HorizontalAlignment="Center"
                                                                                                           Foreground="#FFA27649"
                                                                                                           FontSize="9"
                                                                                                           FontWeight="Bold"
                                                                                                           Text="PHOTO BOOK" />
                                                                                                <TextBlock Margin="0,5,0,0"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           FontFamily="Georgia"
                                                                                                           FontSize="16"
                                                                                                           Text="04" />
                                                                                            </StackPanel>
                                                                                            <TextBlock HorizontalAlignment="Right"
                                                                                                       VerticalAlignment="Bottom"
                                                                                                       Foreground="#88705A43"
                                                                                                       FontSize="7"
                                                                                                       Text="NEXT" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </VisualBrush.Visual>
                                                                            </VisualBrush>
                                                                        </DiffuseMaterial.Brush>
                                                                    </DiffuseMaterial>
                                                                </GeometryModel3D.Material>
                                                            </GeometryModel3D>

                                                            <!--
                                                                실제 회전 leaf. Material은 앞면, BackMaterial은
                                                                뒷면이며 backface 선택은 WPF 3D 파이프라인이 처리한다.
                                                            -->
                                                            <GeometryModel3D x:Name="TransitionPreviewTurningPage">
                                                                <GeometryModel3D.Geometry>
                                                                    <MeshGeometry3D Positions="0,-1,0 1.68,-1,0 1.68,1,0 0,1,0"
                                                                                    TextureCoordinates="0,1 1,1 1,0 0,0"
                                                                                    TriangleIndices="0 1 2 0 2 3" />
                                                                </GeometryModel3D.Geometry>
                                                                <GeometryModel3D.Material>
                                                                    <DiffuseMaterial>
                                                                        <DiffuseMaterial.Brush>
                                                                            <VisualBrush Stretch="Fill">
                                                                                <VisualBrush.Visual>
                                                                                    <Border Width="168"
                                                                                            Height="100"
                                                                                            Padding="12"
                                                                                            BorderBrush="#FFD0B797"
                                                                                            BorderThickness="1">
                                                                                        <Border.Background>
                                                                                            <LinearGradientBrush StartPoint="0,0"
                                                                                                                 EndPoint="1,0">
                                                                                                <GradientStop Offset="0"
                                                                                                              Color="#FFE7D8C5" />
                                                                                                <GradientStop Offset="0.09"
                                                                                                              Color="#FFFFFCF7" />
                                                                                                <GradientStop Offset="0.82"
                                                                                                              Color="#FFFFFCF7" />
                                                                                                <GradientStop Offset="1"
                                                                                                              Color="#FFE8D7C1" />
                                                                                            </LinearGradientBrush>
                                                                                        </Border.Background>
                                                                                        <Grid>
                                                                                            <StackPanel VerticalAlignment="Center">
                                                                                                <TextBlock HorizontalAlignment="Center"
                                                                                                           Foreground="#FFA27649"
                                                                                                           FontSize="9"
                                                                                                           FontWeight="Bold"
                                                                                                           Text="WEDDING STORY" />
                                                                                                <TextBlock Margin="0,5,0,0"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           FontFamily="Georgia"
                                                                                                           FontSize="16"
                                                                                                           Text="02" />
                                                                                            </StackPanel>
                                                                                            <TextBlock HorizontalAlignment="Right"
                                                                                                       VerticalAlignment="Bottom"
                                                                                                       Foreground="#88705A43"
                                                                                                       FontSize="7"
                                                                                                       Text="FRONT" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </VisualBrush.Visual>
                                                                            </VisualBrush>
                                                                        </DiffuseMaterial.Brush>
                                                                    </DiffuseMaterial>
                                                                </GeometryModel3D.Material>
                                                                <GeometryModel3D.BackMaterial>
                                                                    <DiffuseMaterial>
                                                                        <DiffuseMaterial.Brush>
                                                                            <VisualBrush Stretch="Fill">
                                                                                <VisualBrush.RelativeTransform>
                                                                                    <ScaleTransform CenterX="0.5"
                                                                                                    CenterY="0.5"
                                                                                                    ScaleX="-1" />
                                                                                </VisualBrush.RelativeTransform>
                                                                                <VisualBrush.Visual>
                                                                                    <Border Width="168"
                                                                                            Height="100"
                                                                                            Padding="12"
                                                                                            BorderBrush="#FFD0B797"
                                                                                            BorderThickness="1">
                                                                                        <Border.Background>
                                                                                            <LinearGradientBrush StartPoint="0,0"
                                                                                                                 EndPoint="1,0">
                                                                                                <GradientStop Offset="0"
                                                                                                              Color="#FFE1CEB7" />
                                                                                                <GradientStop Offset="0.16"
                                                                                                              Color="#FFFFFAF2" />
                                                                                                <GradientStop Offset="0.91"
                                                                                                              Color="#FFFFFAF2" />
                                                                                                <GradientStop Offset="1"
                                                                                                              Color="#FFE6D5C0" />
                                                                                            </LinearGradientBrush>
                                                                                        </Border.Background>
                                                                                        <Grid>
                                                                                            <StackPanel VerticalAlignment="Center">
                                                                                                <TextBlock HorizontalAlignment="Center"
                                                                                                           Foreground="#FF8D6943"
                                                                                                           FontSize="9"
                                                                                                           FontWeight="Bold"
                                                                                                           Text="OUR MOMENTS" />
                                                                                                <TextBlock Margin="0,5,0,0"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           FontFamily="Georgia"
                                                                                                           FontSize="16"
                                                                                                           Text="03" />
                                                                                            </StackPanel>
                                                                                            <TextBlock HorizontalAlignment="Left"
                                                                                                       VerticalAlignment="Bottom"
                                                                                                       Foreground="#88705A43"
                                                                                                       FontSize="7"
                                                                                                       Text="BACK" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </VisualBrush.Visual>
                                                                            </VisualBrush>
                                                                        </DiffuseMaterial.Brush>
                                                                    </DiffuseMaterial>
                                                                </GeometryModel3D.BackMaterial>
                                                                <GeometryModel3D.Transform>
                                                                    <Transform3DGroup>
                                                                        <ScaleTransform3D x:Name="TransitionPreviewBookCurveScale"
                                                                                          CenterX="0"
                                                                                          CenterY="0"
                                                                                          CenterZ="0"
                                                                                          ScaleX="1"
                                                                                          ScaleY="1"
                                                                                          ScaleZ="1" />
                                                                        <RotateTransform3D CenterX="0"
                                                                                           CenterY="0"
                                                                                           CenterZ="0">
                                                                            <RotateTransform3D.Rotation>
                                                                                <AxisAngleRotation3D x:Name="TransitionPreviewBookRotation"
                                                                                                     Angle="0"
                                                                                                     Axis="0,1,0" />
                                                                            </RotateTransform3D.Rotation>
                                                                        </RotateTransform3D>
                                                                        <TranslateTransform3D OffsetZ="0.025" />
                                                                    </Transform3DGroup>
                                                                </GeometryModel3D.Transform>
                                                            </GeometryModel3D>
                                                        </Model3DGroup>
                                                    </ModelVisual3D.Content>
                                                </ModelVisual3D>
                                            </Viewport3D>

                                            <!-- 책등의 고정 접힘 -->
                                            <Border Width="10"
                                                    Margin="0,3"
                                                    HorizontalAlignment="Center"
                                                    IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0"
                                                                         EndPoint="1,0">
                                                        <GradientStop Offset="0"
                                                                      Color="#00FFFFFF" />
                                                        <GradientStop Offset="0.38"
                                                                      Color="#552B1B0E" />
                                                        <GradientStop Offset="0.52"
                                                                      Color="#99FFFFFF" />
                                                        <GradientStop Offset="0.68"
                                                                      Color="#442B1B0E" />
                                                        <GradientStop Offset="1"
                                                                      Color="#00FFFFFF" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- 회전 각도에 따라 책 위를 가로지르는 이동 그림자 -->
                                            <Border x:Name="TransitionPreviewBookShadow"
                                                    Width="54"
                                                    Margin="0,7"
                                                    HorizontalAlignment="Center"
                                                    IsHitTestVisible="False"
                                                    Opacity="0"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0"
                                                                         EndPoint="1,0">
                                                        <GradientStop Offset="0"
                                                                      Color="#001C1008" />
                                                        <GradientStop Offset="0.5"
                                                                      Color="#771C1008" />
                                                        <GradientStop Offset="1"
                                                                      Color="#001C1008" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="TransitionPreviewBookShadowTranslate"
                                                                        X="48" />
                                                </Border.RenderTransform>
                                            </Border>

                                            <!-- 시스템에서 애니메이션을 끈 경우 현재 펼침면만 짧게 fade한다. -->
                                            <Border x:Name="TransitionPreviewBookFadeOverlay"
                                                    Margin="8,4"
                                                    Padding="8"
                                                    Background="#FFFFFCF7"
                                                    BorderBrush="#FFD4BEA3"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    IsHitTestVisible="False"
                                                    Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Georgia"
                                                               FontSize="15"
                                                               Text="01" />
                                                    <TextBlock Grid.Column="1"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Georgia"
                                                               FontSize="15"
                                                               Text="02" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="섹션 순서 (쉼표 구분)" />
                        <TextBox x:Name="SectionOrderTextBox"
                                 AcceptsReturn="True"
                                 Height="56"
                                 TextChanged="EditorTextValue_Changed"
                                 TextWrapping="Wrap"
                                 ToolTip="예: Hero, Invitation, Gallery, Location" />

                        <DockPanel Margin="0,8,0,6">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="안전한 색상 토큰" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button MinWidth="50"
                                        Padding="8,4"
                                        Click="AddToken_Click"
                                        Content="추가" />
                                <Button MinWidth="50"
                                        Padding="8,4"
                                        Margin="0"
                                        Click="RemoveToken_Click"
                                        Content="삭제" />
                            </StackPanel>
                        </DockPanel>

                        <DataGrid x:Name="StyleTokensGrid"
                                  Height="220"
                                  AutoGenerateColumns="False"
                                  CellEditEnding="StyleTokensGrid_CellEditEnding"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding StyleTokens}"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" Header="토큰">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Token}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Margin="0"
                                                      ItemsSource="{Binding DataContext.StyleTokenOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="110"
                                                    Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="#RRGGBB" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="블록 트리" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#766B62"
                                   Text="웹은 이 트리를 코드 변경 없이 동적으로 렌더링합니다." />
                    </StackPanel>

                    <TreeView x:Name="BlockTree"
                              Grid.Row="1"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              SelectedItemChanged="BlockTree_SelectedItemChanged" />

                    <StackPanel Grid.Row="2"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button Click="AddChild_Click" Content="자식 블록 추가" />
                        <Button Margin="0"
                                Click="RemoveBlock_Click"
                                Content="선택 블록 삭제" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="선택 블록 속성" />
                        <TextBlock x:Name="SelectedBlockPathText"
                                   Margin="0,3,0,12"
                                   Foreground="#766B62"
                                   Text="블록을 선택하세요." />

                        <TextBlock Text="Id" />
                        <TextBox x:Name="BlockIdTextBox"
                                 TextChanged="EditorTextValue_Changed"
                                 IsEnabled="False" />

                        <TextBlock Text="Kind" />
                        <ComboBox x:Name="BlockKindComboBox"
                                  SelectionChanged="EditorSelectionValue_Changed"
                                  IsEnabled="False"
                                  ItemsSource="{Binding BlockKindOptions}" />

                        <TextBlock Text="Binding" />
                        <ComboBox x:Name="BlockBindingComboBox"
                                  SelectionChanged="EditorSelectionValue_Changed"
                                  IsEnabled="False"
                                  ItemsSource="{Binding BindingOptions}" />

                        <TextBlock Text="Variant" />
                        <ComboBox x:Name="BlockVariantComboBox"
                                  SelectionChanged="EditorSelectionValue_Changed"
                                  IsEnabled="False"
                                  ItemsSource="{Binding VariantOptions}" />

                        <TextBlock Text="고정 텍스트" />
                        <TextBox x:Name="BlockTextTextBox"
                                 AcceptsReturn="True"
                                 Height="76"
                                 IsEnabled="False"
                                 TextChanged="EditorTextValue_Changed"
                                 TextWrapping="Wrap"
                                 ToolTip="HTML, CSS, 스크립트, URL은 허용되지 않습니다." />

                        <GroupBox Header="컨테이너 기본값">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="기본 열 수 (1~12)" />
                                    <TextBox x:Name="BlockColumnsTextBox"
                                             IsEnabled="False"
                                             TextChanged="EditorTextValue_Changed"
                                             ToolTip="Page, Section, Container, Grid, Card와 Hero 내부 자식 배치의 기본 열 수입니다." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="기본 간격" />
                                    <ComboBox x:Name="BlockGapComboBox"
                                              IsEnabled="False"
                                              ItemsSource="{Binding GapOptions}"
                                              SelectionChanged="EditorSelectionValue_Changed"
                                              ToolTip="블록 자식 사이의 기본 간격입니다." />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <TextBlock Margin="0,-5,0,4"
                                   Foreground="#6B7280"
                                   Text="반응형 Columns=1, Gap=Medium, Alignment=Stretch는 이 기본값을 상속하며 다른 값은 해당 화면 크기에서 덮어씁니다. Stack은 항상 한 열이고 간격만 적용됩니다."
                                   TextWrapping="Wrap" />

                        <Button x:Name="ApplyBlockButton"
                                Width="150"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Click="ApplyBlock_Click"
                                Content="블록 속성 적용" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,8,0,5"
                Padding="10,8"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            MinWidth="92"
                            Margin="8,0,0,0"
                            Padding="8,4"
                            Click="ToggleValidationDetails_Click"
                            Content="자세히 보기" />
                    <TextBlock x:Name="ValidationSummaryText"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="아직 문제를 확인하지 않았습니다." />
                </DockPanel>
                <Expander x:Name="ValidationDetailsExpander"
                          Margin="0,7,0,0"
                          Header="고급 진단 정보"
                          IsExpanded="False">
                    <ListView x:Name="ValidationErrorsList"
                              MaxHeight="155">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="280"
                                                DisplayMemberBinding="{Binding Path}"
                                                Header="JSON 경로" />
                                <GridViewColumn Width="180"
                                                DisplayMemberBinding="{Binding Code}"
                                                Header="코드" />
                                <GridViewColumn Width="760"
                                                DisplayMemberBinding="{Binding Message}"
                                                Header="설명" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Expander>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Foreground="#5F554C"
                   Text="준비됨" />
    </Grid>
</Window>
