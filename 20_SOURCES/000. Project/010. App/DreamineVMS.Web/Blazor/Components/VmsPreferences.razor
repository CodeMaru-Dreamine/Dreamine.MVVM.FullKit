@namespace DreamineVMS.Web.Blazor.Components
@implements IDisposable
@inject VmsLocalization Text

<DreaminePortalPreferences Theme="@theme"
                           ThemeChanged="ChangeThemeAsync"
                           ThemeLabel="@Text["theme"]"
                           SystemThemeLabel="@Text["system"]"
                           LightThemeLabel="@Text["light"]"
                           DarkThemeLabel="@Text["dark"]"
                           ThemeStorageKey="codemaru-theme"
                           CookieDomain=".codemaru.co.kr"
                           Language="@Text.Language"
                           LanguageChanged="ChangeLanguageAsync"
                           Languages="@Languages"
                           LanguageLabel="@Text["language"]"
                           FallbackLanguage="ko"
                           LanguageStorageKey="codemaru-language" />

@code {
    private string theme = "system";
    private static readonly IReadOnlyList<DreamineLanguage> Languages = VmsLocalization.Languages
        .Select(x => new DreamineLanguage(x.Code, x.Region, x.NativeName, x.HtmlLanguage)).ToArray();
    protected override void OnInitialized() => Text.Changed += OnChanged;
    private Task ChangeThemeAsync(string value) { theme = value; return Task.CompletedTask; }
    private Task ChangeLanguageAsync(string language) { Text.SetLanguage(language); return Task.CompletedTask; }
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Text.Changed -= OnChanged;
}
