@namespace DreamineVMS.Web.Blazor
@using DreamineVMS.Web.Services.Auth
@implements IDisposable
@inject VmsAuthState AuthState
@inject VmsLocalization Text
@inject NavigationManager Nav
@inject IJSRuntime JS

<DreaminePortalHeader BrandName="CodeMaru"
                      BrandUrl="@LocalizedUrl("https://codemaru.co.kr")"
                      BrandImageUrl="/images/Codemaru_Bloom.jpg"
                      BrandLightImageUrl="/images/Codemaru_Bloom_Light.jpg"
                      BrandImageAlt=""
                      Items="@PortalItems"
                      ActiveKey="cctv"
                      NavigationAriaLabel="@Text["nav.services"]"
                      ToggleMenuLabel="@Text["nav.toggle"]"
                      UseCodeMaruAppearance="true"
                      Fixed="true"
                      IsAuthenticated="@(hasLoadedCurrentUser && AuthState.IsAuthenticated)"
                      DisplayName="@NavUserLabel"
                      ScreenSettingsLabel="@Text["screen.settings"]"
                      LoginUrl="@LoginUrl"
                      LoginLabel="@Text["login"]"
                      AccountUrl="@AccountUrl"
                      AccountLabel="@Text["account"]"
                      SignoutUrl="@LocalizedPath("/logout")"
                      SignoutLabel="@Text["logout"]">
    <Preferences><VmsPreferences /></Preferences>
    <AdditionalUserActions>
        <a href="@LocalizedPath("/guide")"><span aria-hidden="true">?</span> @Text["guide"]</a>
        @if (hasLoadedCurrentUser && AuthState.IsAuthenticated && AuthState.CurrentUser is not null)
        {
            <a href="@LocalizedPath($"/{AuthState.CurrentUser.PublicSlug}/cameras")"><span aria-hidden="true">⌁</span> @Text["cameras"]</a>
        }
    </AdditionalUserActions>
</DreaminePortalHeader>

@code {
    private bool hasLoadedCurrentUser;
    private string LoginUrl => IdentityUrl("login");
    private string AccountUrl => IdentityUrl("account");
    private string NavUserLabel => !string.IsNullOrWhiteSpace(AuthState.SharedDisplayName)
        ? AuthState.SharedDisplayName
        : string.IsNullOrWhiteSpace(AuthState.CurrentUser?.DisplayName)
            ? Text["account"]
            : AuthState.CurrentUser.DisplayName;
    private IReadOnlyList<DreaminePortalNavigationItem> PortalItems =>
    [
        new("home", Text["home"], LocalizedUrl("https://codemaru.co.kr")),
        new("dreamine", "Dreamine", "https://dreamine.kr/", OpenInNewWindow: true),
        new("cardhybrid", "CardHybrid", LocalizedUrl("https://codemaru.co.kr/cardhybrid")),
        new("wedding", "Wedding", LocalizedUrl("https://wedding.codemaru.co.kr")),
        new("thankyou", "ThankYou", LocalizedUrl("https://thankyou.codemaru.co.kr/")),
        new("families", "Families", LocalizedUrl("https://families.codemaru.co.kr")),
        new("portfolio", "Portfolio", LocalizedUrl("https://portfolio.codemaru.co.kr/")),
        new("cctv", "CCTV", LocalizedPath("/")),
        new("shop", "ShopStore", LocalizedUrl("https://shop.codemaru.co.kr/")),
        new("contact", Text["contact"], LocalizedUrl("https://codemaru.co.kr/contact"))
    ];

    protected override void OnInitialized()
    {
        Text.Changed += HandleChanged;
        Nav.LocationChanged += HandleLocationChanged;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthState.RestoreAsync(JS);
        hasLoadedCurrentUser = true;
        StateHasChanged();
    }
    private string LocalizedPath(string path) => $"{path}{(path.Contains('?') ? '&' : '?')}lang={Uri.EscapeDataString(Text.Language)}";
    private string LocalizedUrl(string url) => $"{url}{(url.Contains('?') ? '&' : '?')}lang={Uri.EscapeDataString(Text.Language)}";
    private string IdentityUrl(string action) => Dreamine.Identity.DreamineIdentityPortal.CreateUrl(action, Nav.Uri, Text.Language);
    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Text.Changed -= HandleChanged; Nav.LocationChanged -= HandleLocationChanged; }
}
