@namespace DreamineVMS.Web.Blazor
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject VmsLocalization Text

<!DOCTYPE html>
<html lang="@Text.HtmlLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Text["page.title"]</title>
    <meta name="description" content="@Text["seo.description"]" />
    <meta property="og:title" content="CodeMaru CCTV Viewer" />
    <meta property="og:description" content="@Text["seo.description"]" />
    <meta property="og:url" content="https://cctvviewer.codemaru.co.kr/" />
    <base href="/" />
    <script>
        (() => {
            const media = window.matchMedia('(prefers-color-scheme: dark)');
            const sync = event => document.documentElement.classList.toggle('system-dark', event.matches);
            sync(media); media.addEventListener?.('change', sync);
            const cookie = document.cookie.split(';').map(x => x.trim()).find(x => x.startsWith('dreamine-theme='));
            const saved = cookie ? decodeURIComponent(cookie.substring('dreamine-theme='.length)) : localStorage.getItem('codemaru-theme');
            if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
        })();
    </script>
    <link rel="stylesheet" href="/css/app.css?v=20260805-portal-i18n-4" />
    <link rel="stylesheet" href="/DreamineVMS.Web.styles.css?v=20260805-portal-i18n-4" />
    <HeadOutlet />
</head>
<body>
    <VmsPortalRoot @rendermode="new InteractiveServerRenderMode(prerender: true)" />
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.17/dist/hls.min.js"></script>
    <script src="/js/hls-interop.js?v=20260805-i18n-1"></script>
    <script src="/_content/Dreamine.UI.Blazor/dreamine-portal.js?v=20260805-portal-i18n-4"></script>
    <script src="/_framework/blazor.web.js"></script>
</body>
</html>

@code {
    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("lang", out var language))
            Text.SetLanguage(VmsLocalization.NormalizeLanguageCode(language.ToString()));
    }
}
