@page "/"
@namespace DreamineVMS.Web.Blazor.Pages
@implements IDisposable
@using DreamineVMS.Web.Models
@using DreamineVMS.Web.Services.Auth
@using DreamineVMS.Web.Services.Cameras
@inject VmsAuthState AuthState
@inject VmsUserService UserService
@inject IVmsCameraRepository Repository
@inject VmsLocalization Localization
@inject IJSRuntime JS

<PageTitle>@T("page.title")</PageTitle>

<div class="home-shell">

    <!-- Hero -->
    <header class="home-hero">
        <div class="home-hero-inner">
            <div class="home-badge">@T("hero.badge")</div>
            <h1 class="home-title">
                @T("hero.title.1")<br />@T("hero.title.2")<br />@T("hero.title.3")
            </h1>
            <p class="home-sub">@T("hero.subtitle.1")<br />@T("hero.subtitle.2")</p>
            <div class="home-hero-btns">
                @if (AuthState.IsAuthenticated)
                {
                    <a class="primary link-button home-cta" href="@LocalizedPath($"/{AuthState.CurrentUser?.PublicSlug}/cameras")">@T("action.manage")</a>
                    <a class="secondary link-button" href="@LocalizedPath($"/{AuthState.CurrentUser?.PublicSlug}/live")">@T("action.live")</a>
                }
                else
                {
                    <a class="primary link-button home-cta" href="@LocalizedPath("/register")">@T("action.start")</a>
                    <a class="secondary link-button" href="@LocalizedPath("/login")">@T("action.login")</a>
                }
            </div>
        </div>
    </header>

    <!-- 공개 라이브 목록 -->
    @if (_loaded)
    {
        <section class="home-live-section">
            <h2 class="home-section-title">@T("live.title")</h2>

            @if (_publicUsers.Count == 0)
            {
                <p class="muted" style="text-align:center;padding:2rem;">
                    @T("live.empty")
                </p>
            }
            else
            {
                <div class="home-live-grid">
                    @foreach (var user in _publicUsers)
                    {
                        var camCount = _camCounts.GetValueOrDefault(user.Id, 0);
                        <a class="home-live-card" href="@LocalizedPath($"/{user.PublicSlug}/live")">
                            <div class="home-live-thumb">
                                @if (!string.IsNullOrWhiteSpace(user.OgImage))
                                {
                                    <img src="@user.OgImage" alt="@user.DisplayName" style="width:100%;height:100%;object-fit:cover;border-radius:8px;" />
                                }
                                else
                                {
                                    <span class="home-live-icon">📷</span>
                                }
                            </div>
                            <div class="home-live-info">
                                <strong>@user.DisplayName</strong>
                                <span>@TF("live.camera.count", camCount)</span>
                                <span class="home-live-slug">/@user.PublicSlug/live</span>
                            </div>
                            <div class="home-live-badge">@T("live.badge")</div>
                        </a>
                    }
                </div>
            }
        </section>
    }

    <!-- 에이전트 앱 다운로드 -->
    <section class="home-download">
        <div class="home-download-inner">
            <div>
                <h2>@T("download.title")</h2>
                <p class="muted">@T("download.description")</p>
                <ul class="home-download-req">
                    <li>@T("download.req.windows")</li>
                    <li>@T("download.req.ffmpeg")</li>
                    <li>@T("download.req.rtsp")</li>
                    <li>@T("download.req.size")</li>
                    <li>@T("download.req.disk")<br/>
                        <small style="color:#94a3b8;">@T("download.req.cleanup")</small>
                    </li>
                </ul>
                <p style="margin-top:12px;font-size:0.82rem;color:#fbbf24;">
                    ⚠ <strong>@T("download.webview.lead")</strong>@T("download.webview.detail")
                </p>
                <p style="margin-top:6px;font-size:0.82rem;color:#94a3b8;">
                    @T("download.admin.prefix")<strong>@T("download.admin.location")</strong>@T("download.admin.suffix")<br/>
                    @T("download.default.path")
                </p>
            </div>
            <a class="home-download-btn" href="@LocalizedPath("/Setup/DreamineVMS-Setup-v1.0.0.exe")" download>
                <span>⬇</span>
                <span>
                    <strong>@T("download.install")</strong>
                    <small>@T("download.version")</small>
                </span>
            </a>
        </div>
    </section>

    <!-- Features -->
    <section class="home-features">
        <div class="home-features-grid">
            <div class="home-feature-card">
                <span class="home-feat-icon">📡</span>
                <strong>@T("feature.rtsp.title")</strong>
                <p>@T("feature.rtsp.description")</p>
            </div>
            <div class="home-feature-card">
                <span class="home-feat-icon">🌐</span>
                <strong>@T("feature.browser.title")</strong>
                <p>@T("feature.browser.description")</p>
            </div>
            <div class="home-feature-card">
                <span class="home-feat-icon">🔒</span>
                <strong>@T("feature.isolation.title")</strong>
                <p>@T("feature.isolation.description")</p>
            </div>
            <div class="home-feature-card">
                <span class="home-feat-icon">🎥</span>
                <strong>@T("feature.multi.title")</strong>
                <p>@T("feature.multi.description")</p>
            </div>
            <div class="home-feature-card">
                <span class="home-feat-icon">🔗</span>
                <strong>@T("feature.share.title")</strong>
                <p>@T("feature.share.prefix")<span class="home-slug-sample">/@T("feature.share.nickname")/live</span>@T("feature.share.suffix")</p>
            </div>
            <div class="home-feature-card">
                <span class="home-feat-icon">⚡</span>
                <strong>@T("feature.ffmpeg.title")</strong>
                <p>@T("feature.ffmpeg.description")</p>
            </div>
        </div>
    </section>

    <footer class="home-footer">
        @if (AuthState.IsAuthenticated)
        {
            <a href="@LocalizedPath($"/{AuthState.CurrentUser?.PublicSlug}/cameras")" class="primary link-button">@T("action.manage.short")</a>
            <a href="@LocalizedPath($"/{AuthState.CurrentUser?.PublicSlug}/live")" class="secondary link-button">@T("action.live")</a>
        }
        else
        {
            <a href="@LocalizedPath("/register")" class="primary link-button">@T("footer.start")</a>
            <a href="@LocalizedPath("/login")" class="secondary link-button">@T("footer.account")</a>
        }
        <a href="@LocalizedPath("/guide")" class="secondary link-button">@T("footer.guide")</a>
    </footer>

</div>

@code {
    private List<VmsUser> _publicUsers = [];
    private Dictionary<string, int> _camCounts = [];
    private bool _loaded;

    protected override void OnInitialized() => Localization.Changed += HandleLanguageChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthState.RestoreAsync(JS);

        _publicUsers = UserService.GetUsersWithPublicCameras();

        // 로그인한 본인은 비공개 설정이어도 항상 목록에 표시
        if (AuthState.IsAuthenticated && AuthState.CurrentUser is not null
            && !_publicUsers.Any(u => u.Id == AuthState.CurrentUser.Id))
        {
            _publicUsers.Insert(0, AuthState.CurrentUser);
        }

        // 본인은 전체 카메라 수, 타인은 공개 카메라 수
        var allCams = Repository.GetAll();
        _camCounts = _publicUsers.ToDictionary(
            u => u.Id,
            u => AuthState.CurrentUser?.Id == u.Id
                ? allCams.Count(c => c.TenantId == u.Id && c.Enabled)
                : allCams.Count(c => c.TenantId == u.Id && c.IsPublic && c.Enabled));

        _loaded = true;
        StateHasChanged();
    }

    private string T(string key) => VmsHomeText.Get(Localization.Language, key);
    private string TF(string key, params object?[] args) => VmsHomeText.Format(Localization.Language, key, args);
    private string LocalizedPath(string path) => $"{path}{(path.Contains('?') ? '&' : '?')}lang={Uri.EscapeDataString(Localization.Language)}";
    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Localization.Changed -= HandleLanguageChanged;
}
