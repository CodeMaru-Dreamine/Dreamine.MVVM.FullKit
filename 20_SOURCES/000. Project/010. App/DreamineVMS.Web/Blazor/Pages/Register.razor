@page "/register"
@namespace DreamineVMS.Web.Blazor.Pages
@inject NavigationManager Nav
@inject VmsLocalization Text

<PageTitle>@Text["signup"] — Dreamine VMS</PageTitle>

<div class="page-shell auth-shell">
    <div class="auth-card">
        <h1>@Text["signup"]</h1>
        <p class="muted">@Text["redirect.signup"]</p>
        <a class="primary link-button full-btn" href="@SignupUrl">@Text["continue.signup"]</a>
    </div>
</div>

@code {
    private string SignupUrl => Dreamine.Identity.DreamineIdentityPortal.CreateUrl("login", Nav.BaseUri, Text.Language) + "&mode=signup";

    protected override void OnInitialized()
    {
        Nav.NavigateTo(SignupUrl, forceLoad: true);
    }
}
