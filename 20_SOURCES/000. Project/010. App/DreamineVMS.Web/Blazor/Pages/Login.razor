@page "/login"
@namespace DreamineVMS.Web.Blazor.Pages
@inject NavigationManager Nav
@inject VmsLocalization Text

<PageTitle>@Text["login"] — Dreamine VMS</PageTitle>

<div class="page-shell auth-shell">
    <div class="auth-card">
        <h1>@Text["login"]</h1>
        <p class="muted">@Text["redirect.login"]</p>
        <a class="primary link-button full-btn" href="@LoginUrl">@Text["continue.login"]</a>
    </div>
</div>

@code {
    private string LoginUrl => Dreamine.Identity.DreamineIdentityPortal.CreateUrl("login", Nav.BaseUri, Text.Language);

    protected override void OnInitialized()
    {
        Nav.NavigateTo(LoginUrl, forceLoad: true);
    }
}
