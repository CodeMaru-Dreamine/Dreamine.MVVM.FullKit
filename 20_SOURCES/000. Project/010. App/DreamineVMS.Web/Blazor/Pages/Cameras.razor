@page "/{Slug}/cameras"
@namespace DreamineVMS.Web.Blazor.Pages
@using DreamineVMS.Web.Models
@using DreamineVMS.Web.Services.Auth
@using DreamineVMS.Web.Services.Cameras
@implements IDisposable
@inject IVmsCameraRepository Repository
@inject VmsAuthState AuthState
@inject VmsUserService UserService
@inject VmsLocalization Text
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory

<PageTitle>@T("page.title")</PageTitle>

<div class="page-shell">
    <div class="hero">
        <div>
            <a href="@LocalizedPath("/")" style="font-size:0.85rem;color:#6b7280;text-decoration:none;display:inline-block;margin-bottom:0.4rem;">← @T("back.home")</a>
            <h1>@T("heading")</h1>
            @if (AuthState.CurrentUser is not null)
            {
                <p>@AuthState.CurrentUser.DisplayName · @T("public.link"): <a href="@LocalizedPath($"/{AuthState.CurrentUser.PublicSlug}/live")" target="_blank">/@AuthState.CurrentUser.PublicSlug/live</a></p>
            }
        </div>
        <div class="action-toolbar">
            @if (AuthState.CurrentUser is not null)
            {
                <a class="primary link-button" href="@LocalizedPath($"/{AuthState.CurrentUser.PublicSlug}/live")">@T("my.live")</a>
            }
            <a class="secondary link-button" href="@LocalizedPath("/logout")">@T("logout")</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="cam-alert @(_isError ? "cam-alert-error" : "cam-alert-ok")">@_message</div>
    }

    <section class="event-card">
        <h3>@T("agent.account")</h3>
        <p class="muted" style="margin-bottom:1rem;">
            @T("agent.description")
        </p>
        <div class="agent-login-box">
            <div>
                <span>@T("agent.email")</span>
                <strong>@(AuthState.CurrentUser?.Email ?? "-")</strong>
            </div>
            <div>
                <span>@T("password.status")</span>
                <strong>@(_hasAgentPassword ? T("status.configured") : T("status.not.configured"))</strong>
            </div>
        </div>
        <div class="cam-form">
            <div class="cam-form-row agent-password-row">
                <label>
                    @T("new.agent.password")
                    <input type="password" @bind="_agentPassword" @bind:event="oninput" placeholder="@T("placeholder.password.min")" />
                </label>
                <label>
                    @T("password.confirmation")
                    <input type="password" @bind="_agentPasswordConfirm" @bind:event="oninput" placeholder="@T("placeholder.password.repeat")" />
                </label>
                <button class="primary" @onclick="SaveAgentPasswordAsync" disabled="@_agentPasswordBusy">
                    @(_agentPasswordBusy ? T("saving") : T("save.password"))
                </button>
            </div>
        </div>
    </section>

    <!-- 카카오 / SNS 공유 미리보기 설정 -->
    <section class="event-card">
        <h3>@T("share.settings")</h3>
        <p class="muted" style="margin-bottom:1rem;">@T("share.description")</p>

        <div class="cam-form">
            <label class="cam-form-full">
                @T("field.title")
                <input @bind="_ogTitle" placeholder="@TF("placeholder.share.title", AuthState.CurrentUser?.DisplayName ?? string.Empty)" />
            </label>
            <label class="cam-form-full">
                @T("field.description")
                <input @bind="_ogDescription" placeholder="@T("placeholder.share.description")" />
            </label>
            <label class="cam-form-full">
                @T("field.image")
                <div style="display:flex;gap:10px;align-items:center;margin-top:6px;flex-wrap:wrap;">
                    <label class="upload-btn" style="cursor:pointer;">
                        <span>@T("upload.image")</span>
                        <InputFile OnChange="UploadOgImageAsync" accept="image/*" style="display:none;" />
                    </label>
                    <span style="color:#6b7280;font-size:0.82em;">@T("upload.hint")</span>
                </div>
                <input @bind="_ogImage" placeholder="https://..." style="margin-top:8px;" />
            </label>

            @if (!string.IsNullOrWhiteSpace(_ogImage))
            {
                <div style="margin-bottom:1rem;">
                    <img src="@_ogImage" alt="@T("preview.alt")"
                         style="max-width:300px;max-height:160px;border-radius:8px;border:1px solid #374151;" />
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_uploadError))
            {
                <p style="color:#f87171;font-size:0.85em;margin-bottom:0.5rem;">@_uploadError</p>
            }

            <div class="cam-form-actions">
                <button class="primary" @onclick="SaveOgAsync" disabled="@_ogBusy">
                    @(_ogBusy ? T("saving") : T("save"))
                </button>
                @if (AuthState.CurrentUser is not null)
                {
                    <a class="secondary link-button" href="@LocalizedPath($"/{AuthState.CurrentUser.PublicSlug}/live")" target="_blank">
                        @T("open.my.live")
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- 카메라 목록 (에이전트 앱에서 자동 동기화됨) -->
    <section class="event-card">
        <h3>@TF("cameras.registered", _cameras.Count)</h3>
        <p class="muted" style="margin-bottom:1rem;">@T("cameras.description")</p>

        @if (_cameras.Count == 0)
        {
            <p class="muted">@T("cameras.empty")</p>
        }
        else
        {
            <div class="cam-table-wrap">
                <table class="cam-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@T("table.name")</th>
                            <th>@T("table.host")</th>
                            <th>@T("table.status")</th>
                            <th>@T("table.visibility")</th>
                            <th>@T("table.actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cam in _cameras.OrderBy(c => c.DisplayOrder))
                        {
                            <tr class="@(cam.Enabled ? "" : "cam-row-disabled")">
                                <td>@cam.DisplayOrder</td>
                                <td><strong>@cam.Name</strong></td>
                                <td>@cam.Host</td>
                                <td>
                                    <span class="badge @(cam.Enabled ? "badge-green" : "badge-gray")">
                                        @(cam.Enabled ? T("status.enabled") : T("status.disabled"))
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(cam.IsPublic ? "badge-green" : "badge-gray")">
                                        @(cam.IsPublic ? T("visibility.public") : T("visibility.private"))
                                    </span>
                                </td>
                                <td>
                                    <button class="mini danger" @onclick="() => DeleteCameraAsync(cam)">@T("delete")</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- 라이브 레이아웃 설정 -->
    <section class="event-card">
        <h3>@T("layout.settings")</h3>
        <p class="muted" style="margin-bottom:16px;">@T("layout.description")</p>
        <div class="layout-picker">
            @foreach (var opt in _layoutOptions)
            {
                <button class="layout-btn @(_selectedLayout == opt.Key ? "active" : "")"
                        @onclick="() => SelectLayoutAsync(opt.Key)">
                    <div class="layout-preview">
                        @((MarkupString)opt.Preview)
                    </div>
                    <span>@T(opt.LabelKey)</span>
                </button>
            }
        </div>
    </section>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private List<CameraDevice> _cameras = [];
    private string _message = "";
    private bool _isError;

    // 레이아웃
    private string _selectedLayout = "auto";
    private record LayoutOption(string Key, string LabelKey, string Preview);
    private static readonly LayoutOption[] _layoutOptions =
    [
        new("auto",   "layout.auto",   "<div class='lp-auto'><div></div><div></div><div></div></div>"),
        new("1",      "layout.1",      "<div class='lp-1'><div></div></div>"),
        new("2h",     "layout.2h",     "<div class='lp-2h'><div></div><div></div></div>"),
        new("2v",     "layout.2v",     "<div class='lp-2v'><div></div><div></div></div>"),
        new("3-left", "layout.3-left", "<div class='lp-3l'><div class='big'></div><div></div><div></div></div>"),
        new("3-top",  "layout.3-top",  "<div class='lp-3t'><div class='big'></div><div></div><div></div></div>"),
        new("4",      "layout.4",      "<div class='lp-4'><div></div><div></div><div></div><div></div></div>"),
    ];

    // OG 설정
    private string _ogTitle = "";
    private string _ogDescription = "";
    private string _ogImage = "";
    private bool _ogBusy;
    private string _uploadError = "";

    // 에이전트 연결 비밀번호
    private string _agentPassword = "";
    private string _agentPasswordConfirm = "";
    private bool _agentPasswordBusy;
    private bool _hasAgentPassword;

    protected override void OnInitialized()
    {
        Text.Changed += HandleLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthState.RestoreAsync(JS);
        if (!AuthState.IsAuthenticated) { Nav.NavigateTo(LocalizedPath("/login")); return; }

        // 다른 사용자의 slug로 접근 시 자신의 페이지로 리다이렉트
        if (!string.IsNullOrWhiteSpace(Slug) &&
            !string.Equals(Slug, AuthState.CurrentUser?.PublicSlug, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(LocalizedPath($"/{AuthState.CurrentUser?.PublicSlug}/cameras"));
            return;
        }

        LoadCameras();
        _selectedLayout = AuthState.CurrentUser?.LiveLayout ?? "auto";
        _ogTitle = AuthState.CurrentUser?.OgTitle ?? "";
        _ogDescription = AuthState.CurrentUser?.OgDescription ?? "";
        _ogImage = AuthState.CurrentUser?.OgImage ?? "";
        _hasAgentPassword = !string.IsNullOrWhiteSpace(AuthState.CurrentUser?.PasswordHash);
        StateHasChanged();
    }

    private async Task SelectLayoutAsync(string layout)
    {
        _selectedLayout = layout;
        if (AuthState.CurrentUser is not null)
            await UserService.SetLayoutAsync(AuthState.CurrentUser.Id, layout);
        ShowMessage(TF("message.layout.saved", LayoutLabel(layout)));
    }

    private async Task UploadOgImageAsync(InputFileChangeEventArgs e)
    {
        _uploadError = "";
        var file = e.File;
        if (file is null) return;
        if (file.Size > 5 * 1024 * 1024) { _uploadError = T("error.file.too.large"); return; }

        var sessionToken = await JS.InvokeAsync<string?>("localStorage.getItem", "vms_session");
        if (string.IsNullOrWhiteSpace(sessionToken)) { _uploadError = T("error.session.expired"); return; }

        using var content = new MultipartFormDataContent();
        var stream = file.OpenReadStream(5 * 1024 * 1024);
        content.Add(new StreamContent(stream), "file", file.Name);

        using var req = new HttpRequestMessage(HttpMethod.Post, Nav.BaseUri.TrimEnd('/') + "/api/upload/og-image");
        req.Headers.Add("X-Session-Token", sessionToken);
        req.Content = content;

        using var http = HttpClientFactory.CreateClient();
        using var resp = await http.SendAsync(req);
        if (!resp.IsSuccessStatusCode) { _uploadError = TF("error.upload.failed", resp.StatusCode); return; }

        var json = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
        _ogImage = json.GetProperty("url").GetString() ?? "";
        StateHasChanged();
    }

    private async Task SaveOgAsync()
    {
        if (AuthState.CurrentUser is null) return;
        _ogBusy = true;
        try
        {
            await UserService.UpdateOgAsync(AuthState.CurrentUser.Id, _ogTitle, _ogDescription, _ogImage);
            ShowMessage(T("message.share.saved"));
        }
        finally { _ogBusy = false; }
    }

    private async Task SaveAgentPasswordAsync()
    {
        if (AuthState.CurrentUser is null) return;

        _agentPasswordBusy = true;
        try
        {
            var (ok, error, user) = await UserService.SetAgentPasswordAsync(
                AuthState.CurrentUser.Id,
                _agentPassword,
                _agentPasswordConfirm);

            if (!ok)
            {
                ShowMessage(LocalizeAgentPasswordError(error), error: true);
                return;
            }

            _agentPassword = "";
            _agentPasswordConfirm = "";
            _hasAgentPassword = !string.IsNullOrWhiteSpace(user?.PasswordHash);
            ShowMessage(T("message.password.saved"));
        }
        finally
        {
            _agentPasswordBusy = false;
        }
    }

    private async Task DeleteCameraAsync(CameraDevice cam)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", TF("confirm.camera.delete", cam.Name));
        if (!confirmed) return;
        await Repository.DeleteAsync(cam.Id);
        LoadCameras();
        ShowMessage(TF("message.camera.deleted", cam.Name));
    }

    private void LoadCameras()
    {
        var tenantId = AuthState.CurrentUser?.Id ?? "";
        _cameras = Repository.GetAll()
            .Where(c => c.TenantId == tenantId)
            .ToList();
    }

    private void ShowMessage(string msg, bool error = false)
    {
        _message = msg;
        _isError = error;
    }

    private string T(string key) => VmsCamerasText.Get(Text.Language, key);

    private string TF(string key, params object?[] args) =>
        VmsCamerasText.Format(Text.Language, key, args);

    private string LocalizedPath(string path) =>
        $"{path}{(path.Contains('?') ? '&' : '?')}lang={Uri.EscapeDataString(Text.Language)}";

    private string LayoutLabel(string layout) =>
        _layoutOptions.FirstOrDefault(option => option.Key == layout) is { } option
            ? T(option.LabelKey)
            : layout;

    private string LocalizeAgentPasswordError(string error) => error switch
    {
        "에이전트 연결 비밀번호는 8자 이상이어야 합니다." => T("error.password.min"),
        "비밀번호 확인이 일치하지 않습니다." => T("error.password.mismatch"),
        "사용자를 찾을 수 없습니다." => T("error.user.not.found"),
        _ => T("error.password.save")
    };

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Text.Changed -= HandleLanguageChanged;
    }
}
