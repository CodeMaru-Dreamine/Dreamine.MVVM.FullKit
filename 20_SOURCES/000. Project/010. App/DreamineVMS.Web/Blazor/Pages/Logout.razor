@page "/logout"
@namespace DreamineVMS.Web.Blazor.Pages
@using DreamineVMS.Web.Services.Auth
@inject VmsAuthState AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject VmsLocalization Text

<PageTitle>@Text["logout"] — Dreamine VMS</PageTitle>

<div class="page-shell auth-shell">
    <div class="auth-card">
        <h1>@Text["logout"]</h1>
        <p class="muted">@Text["signing.out"]</p>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthState.SignOutAsync(JS);
        Nav.NavigateTo(Dreamine.Identity.DreamineIdentityPortal.CreateUrl("signout", Nav.BaseUri, Text.Language), forceLoad: true);
    }
}
