@page "/guide"
@namespace DreamineVMS.Web.Blazor.Pages
@implements IDisposable
@inject VmsLocalization Text

<PageTitle>@G("page.title")</PageTitle>

<div class="guide-shell">

    <div class="guide-hero">
        <a href="@WithLanguage("/")" class="guide-back">@G("back.home")</a>
        <h1>@H("hero.title")</h1>
        <p class="muted">@G("hero.subtitle")</p>
    </div>

    <!-- Step 1 -->
    <div class="guide-step">
        <div class="guide-step-num">1</div>
        <div class="guide-step-body">
            <h2>@G("step1.title")</h2>
            <p>@H("step1.intro")</p>
            <ul class="guide-list">
                <li>@H("step1.item1")</li>
                <li>@H("step1.item2")</li>
                <li>@H("step1.item3")</li>
            </ul>
            <a class="guide-btn" href="@WithLanguage("/register")">@G("step1.action")</a>
        </div>
    </div>

    <!-- Step 2 -->
    <div class="guide-step">
        <div class="guide-step-num">2</div>
        <div class="guide-step-body">
            <h2>@G("step2.title")</h2>
            <p>@H("step2.intro")</p>
            <ul class="guide-list">
                <li>@G("step2.item1")</li>
                <li>@G("step2.item2")</li>
                <li>@G("step2.item3")</li>
                <li>@G("step2.item4")</li>
                <li>@H("step2.item5")</li>
            </ul>
            <div class="guide-warn">
                @H("step2.warning")
            </div>
            <div class="guide-tip" style="margin-top:8px;">
                @H("step2.tip")
            </div>
            <a class="guide-btn" href="@WithLanguage("/Setup/DreamineVMS-Setup-v1.0.0.exe")" download>@G("step2.action")</a>
        </div>
    </div>

    <!-- Step 3 -->
    <div class="guide-step">
        <div class="guide-step-num">3</div>
        <div class="guide-step-body">
            <h2>@G("step3.title")</h2>
            <p>@H("step3.intro")</p>
            <ul class="guide-list">
                <li>@H("step3.item1")</li>
                <li>@H("step3.item2")</li>
            </ul>
        </div>
    </div>

    <!-- Step 4 -->
    <div class="guide-step">
        <div class="guide-step-num">4</div>
        <div class="guide-step-body">
            <h2>@G("step4.title")</h2>
            <p>@H("step4.intro")</p>
            <ul class="guide-list">
                <li>@H("step4.item1")</li>
                <li>@H("step4.item2")</li>
                <li>@H("step4.item3")</li>
                <li>@H("step4.item4")</li>
                <li>@H("step4.item5")</li>
            </ul>
            <div class="guide-tip">
                @H("step4.tip1")
            </div>
            <div class="guide-tip">
                @H("step4.tip2")
            </div>
        </div>
    </div>

    <!-- Step 5 -->
    <div class="guide-step">
        <div class="guide-step-num">5</div>
        <div class="guide-step-body">
            <h2>@G("step5.title")</h2>
            <p>@H("step5.intro")</p>
            <ul class="guide-list">
                <li>@H("step5.item1")</li>
                <li>@H("step5.item2")</li>
                <li>@H("step5.item3")</li>
            </ul>
            <a class="guide-btn" href="@WithLanguage("/login")">@G("step5.action")</a>
        </div>
    </div>

    <!-- FAQ -->
    <div class="guide-faq">
        <h2>@G("faq.title")</h2>

        <div class="guide-faq-item">
            <strong>@G("faq1.question")</strong>
            <p>@H("faq1.answer")</p>
        </div>
        <div class="guide-faq-item">
            <strong>@G("faq2.question")</strong>
            <p>@H("faq2.answer")</p>
        </div>
        <div class="guide-faq-item">
            <strong>@G("faq3.question")</strong>
            <p>@G("faq3.answer")</p>
        </div>
        <div class="guide-faq-item">
            <strong>@G("faq4.question")</strong>
            <p>@G("faq4.answer")</p>
        </div>
        <div class="guide-faq-item">
            <strong>@G("faq5.question")</strong>
            <p>@H("faq5.answer")</p>
        </div>
    </div>

    <div class="guide-footer">
        <a href="@WithLanguage("/")" class="secondary link-button">@G("back.home")</a>
        <a href="@WithLanguage("/register")" class="primary link-button">@G("footer.action")</a>
    </div>

</div>

@code {
    protected override void OnInitialized() => Text.Changed += HandleLanguageChanged;
    private string G(string key) => VmsGuideText.Get(Text.Language, key);
    private MarkupString H(string key) => new(G(key));
    private string WithLanguage(string path) => $"{path}?lang={Uri.EscapeDataString(Text.Language)}";
    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Text.Changed -= HandleLanguageChanged;
}
