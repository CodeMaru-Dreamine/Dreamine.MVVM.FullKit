@page "/admin"
@layout PortfolioApp.Blazor.Layout.PortfolioLayout
@namespace PortfolioApp.Blazor.Pages
@rendermode InteractiveServer
@implements IDisposable

@inject PortfolioHomeViewModel Vm
@inject PortfolioLocalization Text

<PageTitle>@Text["dashboard.super.title"] — CodeMaru</PageTitle>

<div class="pf-page portfolio-superadmin">
    @if (!Vm.IsAuthenticated)
    {
        <div class="sa-login pa-login-card">
            <div class="pa-login-card__mark"><i class="fas fa-chess-pawn"></i></div>
            <p class="pa-eyebrow">CodeMaru Portfolio</p>
            <h1>@Text["super.admin"]</h1>
            <p>@Text["dashboard.super.sub"]</p>
            @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
            {
                <p class="pf-status pf-status--err">@LocalizedStatus</p>
            }
            <label class="pf-label" for="superAdminPassword">@Text["admin.password"]</label>
            <input id="superAdminPassword" class="pf-input" type="password"
                   value="@Vm.LoginPassword" @oninput="OnPasswordInput" @onkeydown="OnLoginKey"
                   placeholder="@Text["admin.password"]" autocomplete="current-password" />
            <button class="pf-btn pf-btn--primary pf-btn--full" @onclick="OnLogin">@Text["login"]</button>
        </div>
    }
    else
    {
        <div class="pa-super-shell">
            <aside class="pa-super-sidebar">
                <div class="pa-super-brand"><span><i class="fas fa-chess-pawn"></i></span><div><small>CodeMaru</small><strong>Portfolio</strong></div></div>
                <nav aria-label="@Text["super.admin"]">
                    <button class="@(section == "dashboard" ? "active" : null)" @onclick='() => section = "dashboard"'><i class="fas fa-table-cells-large"></i><span>@Text["dashboard"]</span></button>
                    <button class="@(section == "portfolios" ? "active" : null)" @onclick='() => section = "portfolios"'><i class="far fa-folder"></i><span>@Text["stat.portfolios"]</span></button>
                    <button class="@(section == "projects" ? "active" : null)" @onclick='() => section = "projects"'><i class="fas fa-layer-group"></i><span>@Text["projects"]</span></button>
                    <button class="@(section == "ordering" ? "active" : null)" @onclick='() => section = "ordering"'><i class="fas fa-arrow-down-up-across-line"></i><span>@Ui("노출 순서", "Display order")</span></button>
                    <button class="@(section == "settings" ? "active" : null)" @onclick='() => section = "settings"'><i class="fas fa-gear"></i><span>@Ui("서비스 설정", "Service settings")</span></button>
                </nav>
                <div class="pa-super-sidebar__footer">
                    <a href="/"><i class="fas fa-house"></i> CodeMaru Portfolio</a>
                </div>
            </aside>

            <main class="pa-super-main">
                <header class="pa-super-header">
                    <div>
                        <p class="pa-eyebrow">@Text["super.admin"]</p>
                        <h1>@SectionTitle</h1>
                        <p>@Text["dashboard.super.sub"]</p>
                    </div>
                    <div class="pa-super-toolbar">
                        <label class="pa-search"><i class="fas fa-magnifying-glass"></i><input @bind="search" @bind:event="oninput" placeholder="@Text["search"]" /></label>
                        <button class="pf-btn pf-btn--ghost" title="@Text["refresh"]" @onclick="OnRefresh"><i class="fas fa-rotate"></i></button>
                        <button class="pa-admin-profile" type="button"><span>A</span><div><strong>Admin</strong><small>@Text["super.admin"]</small></div></button>
                        <button class="pf-btn pf-btn--ghost" type="button" title="@Text["logout"]" @onclick="OnLogout"><i class="fas fa-right-from-bracket"></i> @Text["logout"]</button>
                        <button class="pf-btn pf-btn--primary" @onclick="() => showCreate = !showCreate"><i class="fas fa-plus"></i> @Text["new.portfolio"]</button>
                    </div>
                </header>

                @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
                {
                    <p class="pf-status @(Vm.StatusMessage.StartsWith("✅") ? "pf-status--ok" : "pf-status--err")">@LocalizedStatus</p>
                }

                @if (showCreate)
                {
                    <section class="pa-panel pa-create-drawer">
                        <div class="pa-panel__heading"><div><p class="pa-eyebrow">Portfolio</p><h2>@Text["new.portfolio"]</h2></div><button class="pa-icon-btn" @onclick="() => showCreate = false" aria-label="@Text["cancel"]">×</button></div>
                        <div class="pa-create-grid">
                            <div class="pf-form__row"><label class="pf-label">@Text["url.address"]</label><input class="pf-input" @bind="Vm.NewSlug" placeholder="msjang" /></div>
                            <div class="pf-form__row"><label class="pf-label">@Text["owner.name"]</label><input class="pf-input" @bind="Vm.NewOwnerName" /></div>
                            <div class="pf-form__row"><label class="pf-label">@Text["admin.password"]</label><input class="pf-input" type="password" @bind="Vm.NewPassword" autocomplete="new-password" /></div>
                            <button class="pf-btn pf-btn--primary" @onclick="OnCreate"><i class="fas fa-plus"></i> @Text["create.portfolio"]</button>
                        </div>
                    </section>
                }

                @if (section == "dashboard")
                {
                    <section class="pa-stat-grid pa-stat-grid--super">
                        <article class="pa-stat-card"><span><i class="far fa-folder"></i></span><div><small>@Text["stat.portfolios"]</small><strong>@Vm.Tenants.Count</strong><em>@Ui("등록 계정", "registered accounts")</em></div></article>
                        <article class="pa-stat-card"><span><i class="fas fa-layer-group"></i></span><div><small>@Text["stat.projects"]</small><strong>@TotalProjects</strong><em>@Ui("전체 포트폴리오 합계", "across all portfolios")</em></div></article>
                        <article class="pa-stat-card"><span><i class="fas fa-house"></i></span><div><small>@Text["stat.featured"]</small><strong>@FeaturedCount</strong><em>@FeaturedPercent% @Ui("노출", "visible")</em></div></article>
                        <article class="pa-stat-card"><span><i class="fas fa-palette"></i></span><div><small>@Ui("사용 중인 디자인", "Active designs")</small><strong>@ThemeCount</strong><em>@Ui("실제 선택된 테마", "themes in use")</em></div></article>
                    </section>

                    <section class="pa-super-dashboard-grid">
                        <article class="pa-panel pa-distribution">
                            <div class="pa-panel__heading"><div><p class="pa-eyebrow">Portfolio</p><h2>@Ui("서비스 구성", "Service overview")</h2></div></div>
                            <div class="pa-distribution__content">
                                <div class="pa-donut" style="--featured:@FeaturedPercent"><strong>@Vm.Tenants.Count</strong><small>@Text["stat.portfolios"]</small></div>
                                <div class="pa-distribution__legend"><p><i class="public"></i><span>@Ui("홈 공개", "Featured")</span><strong>@FeaturedCount</strong></p><p><i class="private"></i><span>@Ui("비노출", "Not featured")</span><strong>@(Vm.Tenants.Count - FeaturedCount)</strong></p></div>
                            </div>
                        </article>
                        <article class="pa-panel pa-theme-summary">
                            <div class="pa-panel__heading"><h2>@Ui("디자인 분포", "Design distribution")</h2></div>
                            @foreach (var theme in ThemeDistribution)
                            {
                                <div class="pa-progress-row"><span><i class="theme-@theme.Name"></i>@theme.Name</span><div><b style="width:@theme.Percent%"></b></div><strong>@theme.Count</strong></div>
                            }
                            @if (ThemeDistribution.Count == 0) { <p class="pf-empty">@Ui("데이터가 없습니다.", "No data yet.")</p> }
                        </article>
                    </section>

                    <section class="pa-panel">
                        <div class="pa-panel__heading"><div><p class="pa-eyebrow">Portfolio</p><h2>@Text["recent.portfolios"]</h2></div><button class="pf-btn pf-btn--sm pf-btn--ghost" @onclick='() => section = "portfolios"'>@Text["stat.portfolios"] →</button></div>
                        <PortfolioTable Items="@FilteredTenants.Take(6).ToList()" ProjectCounts="@Vm.ProjectCounts" Compact="true" OnSave="SaveTenant" OnDelete="DeleteTenant" Text="@Text" />
                    </section>
                }
                else if (section == "settings")
                {
                    <section class="pa-panel pa-service-settings">
                        <div class="pa-panel__heading"><div><p class="pa-eyebrow">CodeMaru</p><h2>@Ui("서비스 설정", "Service settings")</h2></div></div>
                        <div class="pa-service-info"><i class="fas fa-shield-halved"></i><div><strong>@Ui("실제 데이터 기준 운영", "Real-data administration")</strong><p>@Ui("대시보드 수치는 저장된 포트폴리오와 업무 사례만 집계하며 임의 방문 수를 만들지 않습니다.", "Dashboard figures are calculated only from saved portfolios and work items; no visit figures are fabricated.")</p></div></div>
                        <div class="pa-service-info"><i class="fas fa-language"></i><div><strong>10 @Text["language"]</strong><p>한국어 · English · Español · Français · Italiano · Português · 日本語 · 简体中文 · 繁體中文 · Tiếng Việt</p></div></div>
                    </section>
                }
                else
                {
                    <section class="pa-panel">
                        <div class="pa-panel__heading"><div><p class="pa-eyebrow">Portfolio</p><h2>@SectionTitle</h2><p>@Ui("계정을 선택해 공개 상태와 콘텐츠 관리를 이어가세요.", "Select an account to continue managing visibility and content.")</p></div></div>
                        <PortfolioTable Items="@FilteredTenants" ProjectCounts="@Vm.ProjectCounts" Compact="false" OnSave="SaveTenant" OnDelete="DeleteTenant" Text="@Text" />
                    </section>
                }
            </main>
        </div>
    }
</div>

@code {
    private string section = "dashboard";
    private string search = "";
    private bool showCreate;

    private int TotalProjects => Vm.ProjectCounts.Values.Sum();
    private int FeaturedCount => Vm.Tenants.Count(item => item.ShowOnHome);
    private int FeaturedPercent => Vm.Tenants.Count == 0 ? 0 : (int)Math.Round(FeaturedCount * 100d / Vm.Tenants.Count);
    private int ThemeCount => Vm.Tenants.Select(item => item.ThemeName).Where(name => !string.IsNullOrWhiteSpace(name)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private string SectionTitle => section switch
    {
        "portfolios" => Text["stat.portfolios"],
        "projects" => Text["projects"],
        "ordering" => Ui("노출 순서", "Display order"),
        "settings" => Ui("서비스 설정", "Service settings"),
        _ => Text["dashboard.super.title"]
    };

    private List<PortfolioConfig> FilteredTenants => Vm.Tenants
        .Where(item => string.IsNullOrWhiteSpace(search)
            || item.OwnerName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || item.Slug.Contains(search, StringComparison.OrdinalIgnoreCase)
            || item.Title.Contains(search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(item => item.PinOrder == 0 ? int.MaxValue : item.PinOrder)
        .ThenByDescending(item => item.CreatedAt)
        .ToList();

    private List<ThemeSummary> ThemeDistribution => Vm.Tenants
        .GroupBy(item => string.IsNullOrWhiteSpace(item.ThemeName) ? "dark" : item.ThemeName, StringComparer.OrdinalIgnoreCase)
        .Select(group => new ThemeSummary(group.Key, group.Count(), Vm.Tenants.Count == 0 ? 0 : (int)Math.Round(group.Count() * 100d / Vm.Tenants.Count)))
        .OrderByDescending(item => item.Count)
        .ToList();

    protected override void OnInitialized() => Text.Changed += HandleLanguageChanged;
    protected override async Task OnInitializedAsync() { if (Vm.IsAuthenticated) await Vm.LoadSuperAdminAsync(); }
    private void OnPasswordInput(ChangeEventArgs e) => Vm.LoginPassword = e.Value?.ToString() ?? string.Empty;
    private async Task OnLogin() { if (await Vm.LoginAsync()) await Vm.LoadSuperAdminAsync(); }
    private async Task OnLoginKey(KeyboardEventArgs e) { if (e.Key == "Enter") await OnLogin(); }
    private async Task OnRefresh() => await Vm.LoadSuperAdminAsync();
    private async Task OnCreate() { if (await Vm.CreateTenantAsSuperAdminAsync()) { await Vm.LoadSuperAdminAsync(); showCreate = false; } }
    private async Task SaveTenant(PortfolioConfig config) => await Vm.SaveTenantAsync(config);
    private async Task DeleteTenant(string slug) => await Vm.DeleteTenantAsync(slug);
    private void OnLogout() { showCreate = false; Vm.LogoutSuperAdmin(); }
    private string LocalizedStatus
    {
        get
        {
            string status = Vm.StatusMessage;
            if (string.IsNullOrWhiteSpace(status)) return string.Empty;
            if (status == "❌ URL 주소를 입력하세요.") return Local("status.url");
            if (status == "❌ 이름을 입력하세요.") return Local("status.owner");
            if (status == "❌ 비밀번호는 8자 이상이어야 합니다.") return Local("status.password");
            if (status == "❌ URL 주소는 64자 이하의 영문 소문자, 숫자, 하이픈(-)만 사용할 수 있습니다.") return Local("status.slug.format");
            if (status == "❌ 포트폴리오 생성이 진행 중입니다. 잠시만 기다려 주세요.") return Local("status.create.busy");
            if (status == "❌ 로그인 시도가 너무 많습니다. 15분 후 다시 시도해 주세요.") return Local("status.login.rate");
            if (status == "❌ 이미 사용 중인 주소입니다.") return Local("status.used");
            if (status == "❌ 비밀번호가 틀렸습니다.") return Local("status.login");
            if (status.Contains("세션이 만료", StringComparison.Ordinal)) return Local("status.expired");

            string? subject = ExtractQuotedValue(status);
            if (subject is not null && status.Contains("생성되었습니다", StringComparison.Ordinal)) return string.Format(Local("status.created"), subject);
            if (subject is not null && status.Contains("저장 완료", StringComparison.Ordinal)) return string.Format(Local("status.saved"), subject);
            if (subject is not null && status.Contains("삭제 완료", StringComparison.Ordinal)) return string.Format(Local("status.deleted"), subject);
            return status;
        }
    }

    private string Ui(string korean, string english) => UiTexts.TryGetValue(korean, out string[]? values) ? Pick(values) : (Text.Language == "ko" ? korean : english);
    private string Local(string key) => LocalTexts.TryGetValue(key, out string[]? values) ? Pick(values) : key;
    private string Pick(string[] values)
    {
        int index = Array.IndexOf(LanguageCodes, Text.Language);
        return values[index < 0 ? 5 : index];
    }
    private static string? ExtractQuotedValue(string value)
    {
        int start = value.IndexOf('\'');
        int end = start < 0 ? -1 : value.IndexOf('\'', start + 1);
        return start >= 0 && end > start ? value[(start + 1)..end] : null;
    }
    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Text.Changed -= HandleLanguageChanged;

    private sealed record ThemeSummary(string Name, int Count, int Percent);

    private static readonly string[] LanguageCodes = ["en", "es", "fr", "it", "pt", "ko", "ja", "zh-hans", "zh-hant", "vi"];
    private static readonly IReadOnlyDictionary<string, string[]> UiTexts = new Dictionary<string, string[]>(StringComparer.Ordinal)
    {
        ["노출 순서"] = ["Display order", "Orden de visualización", "Ordre d’affichage", "Ordine di visualizzazione", "Ordem de exibição", "노출 순서", "表示順", "展示顺序", "顯示順序", "Thứ tự hiển thị"],
        ["서비스 설정"] = ["Service settings", "Ajustes del servicio", "Paramètres du service", "Impostazioni servizio", "Configurações do serviço", "서비스 설정", "サービス設定", "服务设置", "服務設定", "Cài đặt dịch vụ"],
        ["등록 계정"] = ["registered accounts", "cuentas registradas", "comptes enregistrés", "account registrati", "contas cadastradas", "등록 계정", "登録アカウント", "已登记账户", "已登記帳戶", "tài khoản đã đăng ký"],
        ["전체 포트폴리오 합계"] = ["across all portfolios", "en todos los portafolios", "sur tous les portfolios", "in tutti i portfolio", "em todos os portfólios", "전체 포트폴리오 합계", "全ポートフォリオ合計", "全部作品集合计", "所有作品集合計", "trên tất cả hồ sơ"],
        ["노출"] = ["visible", "visibles", "visibles", "visibili", "visíveis", "노출", "表示", "展示", "顯示", "hiển thị"],
        ["사용 중인 디자인"] = ["Active designs", "Diseños activos", "Styles actifs", "Design attivi", "Designs ativos", "사용 중인 디자인", "使用中デザイン", "使用中的设计", "使用中的設計", "Thiết kế đang dùng"],
        ["실제 선택된 테마"] = ["designs in use", "diseños en uso", "styles utilisés", "design in uso", "designs em uso", "실제 선택된 디자인", "実際に使用中のデザイン", "实际使用的设计", "實際使用的設計", "thiết kế đang sử dụng"],
        ["서비스 구성"] = ["Service overview", "Resumen del servicio", "Vue du service", "Panoramica servizio", "Visão do serviço", "서비스 구성", "サービス概要", "服务概览", "服務概覽", "Tổng quan dịch vụ"],
        ["홈 공개"] = ["Featured", "Destacados", "Mis en avant", "In evidenza", "Em destaque", "홈 공개", "ホーム掲載", "首页展示", "首頁顯示", "Nổi bật"],
        ["비노출"] = ["Not featured", "No destacados", "Non affichés", "Non in evidenza", "Não destacados", "비노출", "非掲載", "未展示", "未顯示", "Không nổi bật"],
        ["디자인 분포"] = ["Design distribution", "Distribución de diseños", "Répartition des styles", "Distribuzione design", "Distribuição de designs", "디자인 분포", "デザイン分布", "设计分布", "設計分布", "Phân bố thiết kế"],
        ["데이터가 없습니다."] = ["No data yet.", "Aún no hay datos.", "Aucune donnée.", "Nessun dato.", "Ainda não há dados.", "데이터가 없습니다.", "データがありません。", "暂无数据。", "尚無資料。", "Chưa có dữ liệu."],
        ["실제 데이터 기준 운영"] = ["Real-data administration", "Administración con datos reales", "Administration sur données réelles", "Gestione con dati reali", "Administração com dados reais", "실제 데이터 기준 운영", "実データによる運用", "基于真实数据运营", "以實際資料營運", "Quản trị bằng dữ liệu thực"],
        ["대시보드 수치는 저장된 포트폴리오와 업무 사례만 집계하며 임의 방문 수를 만들지 않습니다."] = ["Dashboard figures use only saved portfolios and work samples; no visit counts are fabricated.", "Las cifras usan solo portafolios y trabajos guardados; no se inventan visitas.", "Les chiffres utilisent uniquement les portfolios et travaux enregistrés, sans visites fictives.", "I dati usano solo portfolio e lavori salvati, senza visite inventate.", "Os números usam apenas portfólios e trabalhos salvos, sem visitas inventadas.", "대시보드 수치는 저장된 포트폴리오와 업무 사례만 집계하며 임의 방문 수를 만들지 않습니다.", "保存済みのポートフォリオと実績のみを集計し、架空の訪問数は表示しません。", "面板仅统计已保存的作品集和案例，不生成虚假访问量。", "面板僅統計已儲存的作品集與案例，不產生虛假瀏覽量。", "Số liệu chỉ dùng hồ sơ và công việc đã lưu, không tạo lượt xem giả."],
        ["계정을 선택해 공개 상태와 콘텐츠 관리를 이어가세요."] = ["Select an account to manage visibility and content.", "Selecciona una cuenta para gestionar visibilidad y contenido.", "Sélectionnez un compte pour gérer visibilité et contenu.", "Seleziona un account per gestire visibilità e contenuti.", "Selecione uma conta para gerenciar visibilidade e conteúdo.", "계정을 선택해 공개 상태와 콘텐츠 관리를 이어가세요.", "アカウントを選択して公開状態と内容を管理します。", "选择账户以管理公开状态和内容。", "選擇帳戶以管理公開狀態與內容。", "Chọn tài khoản để quản lý hiển thị và nội dung." ]
    };

    private static readonly IReadOnlyDictionary<string, string[]> LocalTexts = new Dictionary<string, string[]>(StringComparer.Ordinal)
    {
        ["status.url"] = ["❌ Enter a public address.", "❌ Introduce una dirección pública.", "❌ Saisissez une adresse publique.", "❌ Inserisci un indirizzo pubblico.", "❌ Informe um endereço público.", "❌ 공개 주소를 입력하세요.", "❌ 公開アドレスを入力してください。", "❌ 请输入公开地址。", "❌ 請輸入公開網址。", "❌ Nhập địa chỉ công khai."],
