@page "/"
@layout PortfolioApp.Blazor.Layout.PortfolioLayout
@namespace PortfolioApp.Blazor.Pages
@rendermode InteractiveServer

@inject PortfolioHomeViewModel Vm
@inject PortfolioUserContext UserContext
@inject PortfolioLocalization Text
@inject NavigationManager Nav

<PageTitle>@Text["page.title"]</PageTitle>

<HeadContent>
    <meta name="description" content="@Text["seo.description"]" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@Nav.Uri" />
    <meta property="og:title" content="@Text["page.title"]" />
    <meta property="og:description" content="@Text["seo.description"]" />
    <meta property="og:image" content="@(Nav.BaseUri.TrimEnd('/') + "/img/og-platform.png")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
</HeadContent>

<div class="pf-page">

    <!-- ── 히어로 ── -->
    <section class="pf-hero">
        <div class="pf-hero__inner">
            <p class="pf-hero__badge">@Text["hero.badge"]</p>
            <h1 class="pf-hero__title">@HeroTitle</h1>
            <p class="pf-hero__sub">@Text["hero.sub"]</p>
            <div class="pf-hero__actions">
                <a href="#create" class="pf-btn pf-btn--primary">@Text["create.now"]</a>
                <a href="@LocalizedPath("/guide")" class="pf-btn pf-btn--ghost">@Text["guide"]</a>
                @if (currentUser.IsAuthenticated)
                {
                    <a href="#my-portfolios" class="pf-btn pf-btn--ghost">@Text["manage.mine"]</a>
                }
                else if (hasLoadedCurrentUser)
                {
                    <a href="@LoginUrl" class="pf-btn pf-btn--ghost">@Text["login"]</a>
                }
            </div>
        </div>
    </section>

    <!-- ── 서비스 안내 ── -->
    <div class="pf-service-notice">
        <span>@Text["service.notice"]</span>
        <span class="pf-notice-sep">·</span>
        <span>🗑 @Text["service.cleanup"]</span>
    </div>

    <!-- ── 기능 소개 ── -->
    <section class="pf-features">
        <div class="pf-feature">
            <span class="pf-feature__icon">🛠️</span>
            <h3>@Text["feature.projects"]</h3>
            <p>@Text["feature.projects.desc"]</p>
        </div>
        <div class="pf-feature">
            <span class="pf-feature__icon">📄</span>
            <h3>@Text["feature.career"]</h3>
            <p>@Text["feature.career.desc"]</p>
        </div>
        <div class="pf-feature">
            <span class="pf-feature__icon">🔍</span>
            <h3>@Text["feature.search"]</h3>
            <p>@Text["feature.search.desc"]</p>
        </div>
        <div class="pf-feature">
            <span class="pf-feature__icon">📬</span>
            <h3>@Text["feature.message"]</h3>
            <p>@Text["feature.message.desc"]</p>
        </div>
        <div class="pf-feature">
            <span class="pf-feature__icon">🎨</span>
            <h3>@Text["feature.themes"]</h3>
            <p>@Local("feature.themes.desc")</p>
        </div>
        <div class="pf-feature">
            <span class="pf-feature__icon">🔗</span>
            <h3>@Text["feature.links"]</h3>
            <p>@Local("feature.links.desc")</p>
        </div>
    </section>

    <!-- ── 가입 폼 ── -->
    <section class="pf-create" id="create">
        <div class="pf-create__box">
            @if (currentUser.IsAuthenticated)
            {
                <div class="pf-account">
                    <span>@Local("shared.signin")</span>
                    <strong>@CurrentUserLabel</strong>
                    <a href="@AccountUrl" class="pf-account__link">@Text["account"]</a>
                    <a href="@SignoutUrl" class="pf-account__link">@Text["logout"]</a>
                </div>
            }
            else if (hasLoadedCurrentUser)
            {
                <div class="pf-account pf-account--guest">
                    <span>@Local("signin.benefit")</span>
                    <a href="@LoginUrl" class="pf-account__link">@Local("shared.signin")</a>
                </div>
            }

            <h2 class="pf-create__title">@Text["create.title"]</h2>
            <p class="pf-create__desc">@Text["create.desc"]</p>

            @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
            {
                <p class="pf-status @(Vm.StatusMessage.StartsWith("✅") ? "pf-status--ok" : "pf-status--err")">
                    @LocalizedStatusMessage
                </p>
            }

            <div class="pf-form">
                <div class="pf-form__row">
                    <label class="pf-label">
                        @Text["url.address"]
                        <span class="pf-label__hint">@Text["url.hint"] (msjang)</span>
                    </label>
                    <div class="pf-input-prefix">
                        <span class="pf-prefix" title="@Nav.BaseUri">@(new Uri(Nav.BaseUri).Authority)/</span>
                        <input class="pf-input" @bind="Vm.NewSlug" placeholder="msjang"
                               @oninput="OnSlugInput" spellcheck="false" autocomplete="off" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(slugPreview))
                    {
                        <p class="pf-slug-preview">👉 @slugPreview</p>
                    }
                </div>

                <div class="pf-form__row">
                    <label class="pf-label">@Text["owner.name"]</label>
                    <input class="pf-input" @bind="Vm.NewOwnerName" placeholder="@Text["owner.name"]" />
                </div>

                <div class="pf-form__row">
                    <label class="pf-label">
                        @Text["admin.password"]
                        <span class="pf-label__hint">@Text["admin.password.hint"]</span>
                    </label>
                    <input class="pf-input" type="password" @bind="Vm.NewPassword"
                           placeholder="@Local("password.minimum")" autocomplete="new-password" />
                </div>

                <button class="pf-btn pf-btn--primary pf-btn--full"
                        @onclick="OnCreate" disabled="@isCreating">
                    @(isCreating ? Text["creating"] : $"🚀 {Text["create.portfolio"]}")
                </button>
            </div>

            <p class="pf-create__notice">
                @Local("after.create.prefix") <code>/my-portfolio/admin</code> @Local("after.create.suffix")
            </p>
        </div>
    </section>

    @if (currentUser.IsAuthenticated)
    {
        <section class="pf-list pf-list--mine" id="my-portfolios">
            <h2 class="pf-list__title">@Text["my.portfolios"]</h2>
            @if (myPortfolios.Count == 0)
            {
                <p class="pf-empty">@Local("mine.empty.prefix") <code>/my-portfolio/admin</code> @Local("mine.empty.suffix")</p>
            }
            else
            {
                <div class="pf-list__grid">
                    @foreach (var t in myPortfolios)
                    {
                        <a href="@LocalizedPath($"/{t.Slug}/admin")" class="pf-card pf-card--manage">
                            <div class="pf-card__body">
                                <div class="pf-card__name">@t.OwnerName</div>
                                <div class="pf-card__title">@t.Title</div>
                                <div class="pf-card__bio">/@t.Slug/admin</div>
                                <span class="pf-manage-link">@Local("manage.open")</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>
    }

    <!-- ── 공개 포트폴리오 목록 ── -->
    @if (publicList.Count > 0)
    {
        <section class="pf-list">
            <h2 class="pf-list__title">🗂️ @Text["public.portfolios"]</h2>
            <div class="pf-list__grid">
                @foreach (var t in publicList)
                {
                    var imgUrl = !string.IsNullOrWhiteSpace(t.ProfileImageFileName)
                        ? $"/portfolio-data/{t.Slug}/media/_profile/{Uri.EscapeDataString(t.ProfileImageFileName)}"
                        : null;

                    <a href="@LocalizedPath($"/{t.Slug}")" class="pf-card">
                        <div class="pf-card__avatar"
                             style="@(imgUrl != null ? $"background-image:url('{imgUrl}')" : "")">
                            @if (imgUrl == null)
                            {
                                <span class="pf-card__avatar-icon">🧑‍💻</span>
                            }
                        </div>
                        <div class="pf-card__body">
                            <div class="pf-card__name">@t.OwnerName</div>
                            <div class="pf-card__title">@t.Title</div>
                            @if (!string.IsNullOrWhiteSpace(t.Bio))
                            {
                                <div class="pf-card__bio">@t.Bio</div>
                            }
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <footer class="pf-footer">
        <p>@Local("powered.by") CodeMaru Portfolio · <a href="mailto:admin@codemaru.co.kr">admin@codemaru.co.kr</a></p>
        <a href="@LocalizedPath("/admin")" class="pf-admin-link">@Text["admin"]</a>
    </footer>
</div>

