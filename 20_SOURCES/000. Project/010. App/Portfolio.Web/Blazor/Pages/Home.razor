    private MarkupString HeroTitle => new(Text["hero.title"].Replace("\n", "<br />", StringComparison.Ordinal));

    private string LocalizedStatusMessage => Vm.StatusMessage switch
    {
        "❌ URL 주소를 입력하세요." => Local("status.url"),
        "❌ 이름을 입력하세요." => Local("status.owner"),
        "❌ 비밀번호는 8자 이상이어야 합니다." => Local("status.password"),
        "❌ URL 주소는 64자 이하의 영문 소문자, 숫자, 하이픈(-)만 사용할 수 있습니다." => Local("status.slug.format"),
        "❌ 포트폴리오 생성이 진행 중입니다. 잠시만 기다려 주세요." => Local("status.create.busy"),
        "❌ 생성 요청이 너무 많습니다. 한 시간 후 다시 시도해 주세요." => Local("status.create.rate"),
        "❌ 이미 사용 중인 주소입니다." => Local("status.used"),
        _ when Vm.StatusMessage.StartsWith("✅", StringComparison.Ordinal) => Local("status.created"),
        _ => Vm.StatusMessage
    };

    private string LoginUrl => IdentityUrl("login");
    private string AccountUrl => IdentityUrl("account");
    private string SignoutUrl => IdentityUrl("signout");
    private string CurrentUserLabel => string.IsNullOrWhiteSpace(currentUser.DisplayName)
        ? currentUser.Provider
        : $"{currentUser.DisplayName} ({currentUser.Provider})";

    private string Local(string key)
    {
        if (!LocalTexts.TryGetValue(key, out string[]? values))
        {
            return key;
        }

        int index = Array.IndexOf(LanguageCodes, Text.Language);
        return values[index < 0 ? 5 : index];
    }

    private string LocalizedPath(string path)
    {
        string separator = path.Contains('?') ? "&" : "?";
        return $"{path}{separator}lang={Uri.EscapeDataString(Text.Language)}";
    }

    private string IdentityUrl(string action)
    {
        Uri current = Nav.ToAbsoluteUri(Nav.Uri);
        return Dreamine.Identity.DreamineIdentityPortal.CreateUrl(action, current.AbsoluteUri, Text.Language);
    }

    protected override void OnInitialized()
    {
        Vm.NewSlug = "";
        Vm.NewOwnerName = "";
        Vm.NewPassword = "";
    }

    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserContext.GetCurrentAsync();
        hasLoadedCurrentUser = true;
        await Vm.LoadAsync();
        publicList = Vm.Tenants
            .Where(t => t.ShowOnHome)
            .OrderBy(t => t.PinOrder == 0 ? int.MaxValue : t.PinOrder)
            .ThenByDescending(t => t.CreatedAt)
            .ToList();
        myPortfolios = currentUser.IsAuthenticated
            ? Vm.Tenants
                .Where(IsMyPortfolio)
                .OrderByDescending(t => t.CreatedAt)
                .ToList()
            : [];
    }

    private void OnSlugInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var clean = new string(raw.ToLowerInvariant()
            .Select(c => (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' ? c : '-').ToArray())
            .Trim('-');
        Vm.NewSlug = clean;
        slugPreview = string.IsNullOrWhiteSpace(clean) ? "" : $"{Nav.BaseUri}{clean}";
    }

    private async Task OnCreate()
    {
        isCreating = true;
        StateHasChanged();
        try
        {
            var slug = Vm.NewSlug.Trim().ToLowerInvariant();
            var ok = await Vm.CreateTenantAsync();
            if (ok)
            {
                await Task.Delay(1200);
                Nav.NavigateTo($"/{slug}/admin");
            }
        }
        finally { isCreating = false; }
    }

    private bool IsMyPortfolio(PortfolioConfig config) =>
        string.Equals(config.OwnerUserId, currentUser.Id, StringComparison.Ordinal)
        || (config.AdminUsers?.Any(x => string.Equals(x.UserId, currentUser.Id, StringComparison.Ordinal)) == true);
}
