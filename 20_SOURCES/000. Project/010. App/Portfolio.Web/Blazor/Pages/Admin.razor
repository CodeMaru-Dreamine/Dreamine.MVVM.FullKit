    private int AdminLanguageIndex => Text.Language.Trim().ToLowerInvariant() switch
    {
        "es" => 1,
        "fr" => 2,
        "it" => 3,
        "pt" or "pt-br" or "pt-pt" => 4,
        "ko" => 5,
        "ja" => 6,
        "zh-hans" or "zh-cn" or "zh-sg" => 7,
        "zh-hant" or "zh-tw" or "zh-hk" => 8,
        "vi" => 9,
        _ => 0,
    };

    private string A(string key) => AdminTexts.TryGetValue(key, out var values) && values.Length == 10
        ? values[AdminLanguageIndex]
        : key;

    private string Status(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        if (StatusKeys.TryGetValue(value, out var key)) return A(key);
        if (value.Contains("미디어 저장 공간", StringComparison.Ordinal)) return A("status.media.space");
        if (value.Contains("동영상 개수", StringComparison.Ordinal)) return A("status.media.videos");
        if (value.Contains("must be between 1 byte", StringComparison.OrdinalIgnoreCase)) return A("status.media.size");
        if (value.Contains("file type is not allowed", StringComparison.OrdinalIgnoreCase)) return A("status.media.type");
        if (AdminLanguageIndex == 5) return value;
        if (value.StartsWith("❌", StringComparison.Ordinal)) return A("status.error.generic");
        if (value.StartsWith("✅", StringComparison.Ordinal)) return A("status.done.generic");
        return value;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Vm.IsLoadedFor(Slug)) await Vm.InitializeAsync(Slug);
    }

    protected override void OnInitialized() => Text.Changed += HandleLanguageChanged;

    private void OnPasswordInput(ChangeEventArgs e) => Vm.LoginPassword = e.Value?.ToString() ?? string.Empty;

    private async Task OnLogin()
    {
        var ok = await Vm.LoginAsync(Slug);
        if (ok) await Vm.LoadAsync(Slug);
    }

    private async Task OnLoginKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnLogin();
    }

    private void SetTab(string tab) { activeTab = tab; Vm.CancelEdit(); }

    private void NewProjectFromOverview()
    {
        activeTab = "project";
        Vm.NewProject();
    }

    private void EditProjectFromOverview(ProjectItem project)
    {
        activeTab = "project";
        Vm.EditProject(project);
    }

    private string CategoryLabel(ProjectCategory category) => category switch
    {
        ProjectCategory.Work => Text["project.work"],
        ProjectCategory.Public => Text["project.public"],
        _ => Text["project.personal"]
    };

    private void SelectPortfolioTheme(string theme)
    {
        if (Vm.Config is not null) Vm.Config.ThemeName = theme;
    }

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnRefresh() => await Vm.LoadAsync(Slug);

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        Vm.PendingFiles.Clear();
        Vm.PendingFiles.AddRange(e.GetMultipleFiles(20));
    }

    private async Task OnSaveProject() => await Vm.SaveProjectAsync(Slug);

    private async Task OnDeleteProject(string projectId) => await Vm.DeleteProjectAsync(Slug, projectId);

    private async Task OnDeleteMedia(string projectId, string fileName) =>
        await Vm.DeleteProjectMediaAsync(Slug, projectId, fileName);

    private async Task OnDeleteCover(string projectId) =>
        await Vm.DeleteProjectCoverAsync(Slug, projectId);

    private async Task OnDeleteAnyImage(string projectId, string img, ProjectCategory cat)
    {
        if (Vm.EditingProject == null) return;
        // WorkImages에서 제거 (Work/Personal/Public 공통)
        if (!IsExternalUrl(img))
            await Vm.DeleteProjectMediaAsync(Slug, projectId, img);
        else
            Vm.EditingProject.WorkImages = Vm.EditingProject.WorkImages.Where(x => x != img).ToArray();
        // ImageFileName이 이 이미지면 초기화
        if (Vm.EditingProject.ImageFileName == img)
            Vm.EditingProject.ImageFileName = Vm.EditingProject.WorkImages.FirstOrDefault();
    }

    private static bool IsExternalUrl(string url) =>
        url.StartsWith('/') || url.StartsWith("http://") || url.StartsWith("https://");

    private void OnAddImageUrl()
    {
        if (string.IsNullOrWhiteSpace(imageUrlInput) || Vm.EditingProject == null) return;
        var url = imageUrlInput.Trim();
        if (!Vm.EditingProject.WorkImages.Contains(url))
            Vm.EditingProject.WorkImages = [.. Vm.EditingProject.WorkImages, url];
        Vm.EditingProject.ImageFileName ??= url;
        imageUrlInput = "";
    }

    private void OnAddVideoUrl()
    {
        if (string.IsNullOrWhiteSpace(videoUrlInput) || Vm.EditingProject == null) return;
        var url = videoUrlInput.Trim();
        if (!Vm.EditingProject.VideoFileNames.Contains(url))
            Vm.EditingProject.VideoFileNames = [.. Vm.EditingProject.VideoFileNames, url];
        videoUrlInput = "";
    }

    private void OnLogout()
    {
        Vm.Logout();
        Nav.NavigateTo($"/{Slug}", forceLoad: true);
    }

    private void OnVideosSelected(InputFileChangeEventArgs e)
    {
        Vm.PendingVideos.Clear();
        Vm.PendingVideos.AddRange(e.GetMultipleFiles(10));
    }

    private async Task OnDeleteVideo(string projectId, string fileName) =>
        await Vm.DeleteProjectVideoAsync(Slug, projectId, fileName);

    private async Task OnSaveResume() => await Vm.SaveResumeAsync(Slug);

    private async Task OnSaveConfig() => await Vm.SaveConfigAsync();

    private async Task OnRemoveAdmin(string userId)
    {
        await Vm.RemoveAdminAsync(userId);
        StateHasChanged();
    }

    private async Task OnChangePassword()
    {
        pwMessage = "";
        var ok = await Vm.ChangePasswordAsync(Slug, currentPw, newPw, newPwConfirm);
        pwMessage = Vm.StatusMessage;
        if (ok) { currentPw = ""; newPw = ""; newPwConfirm = ""; }
    }

    private async Task OnProfileSelected(InputFileChangeEventArgs e) =>
        await Vm.UploadProfileImageAsync(Slug, e.File);

    private async Task OnMarkRead(string msgId) => await Vm.MarkReadAsync(Slug, msgId);

    private async Task OnDeleteMessage(string msgId) => await Vm.DeleteMessageAsync(Slug, msgId);

    private async Task OnDeleteSelf()
    {
        await Vm.DeleteSelfAsync(Slug);
        Nav.NavigateTo("/");
    }

    private void OnTagsChange(ChangeEventArgs e)
    {
        if (Vm.EditingProject == null) return;
        Vm.EditingProject.Tags = (e.Value?.ToString() ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }

    private void OnWorkBulletsChange(ChangeEventArgs e)
    {
        if (Vm.EditingProject == null) return;
        Vm.EditingProject.WorkBullets = (e.Value?.ToString() ?? string.Empty)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }

    private void OnExpBulletsChange(ChangeEventArgs e)
    {
        if (Vm.EditingExp == null) return;
        Vm.EditingExp.Bullets = (e.Value?.ToString() ?? string.Empty)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    public void Dispose() => Text.Changed -= HandleLanguageChanged;
}
