@page "/{Slug}/admin"
@layout PortfolioApp.Blazor.Layout.PortfolioLayout
@namespace PortfolioApp.Blazor.Pages
@rendermode InteractiveServer
@implements IDisposable

@inject PortfolioAdminViewModel Vm
@inject NavigationManager Nav
@inject PortfolioLocalization Text
@using PortfolioApp.ViewModels

<PageTitle>@Text["admin"] — @(Vm.Config?.OwnerName ?? Slug)</PageTitle>

<div class="pf-page pf-admin">

    @if (!Vm.IsAuthenticated)
    {
        <div class="pf-login-box">
            <div class="pf-login-box__nav">
                <a href="/" class="pf-login-box__home">← @Text["home"]</a>
                <a href="/@Slug" class="pf-login-box__home">@Text["public.page"] →</a>
            </div>
            <h1 class="pf-login-box__title">🧑‍💻 @Slug</h1>
            @if (Vm.IsSignedIn)
            {
                <p class="pf-login-box__desc">@A("shared.login.current"): <strong>@Vm.CurrentUserLabel</strong></p>
                <p class="pf-login-box__desc">@A("shared.login.connect")</p>
            }
            else
            {
                <p class="pf-login-box__desc">@A("shared.login.first")</p>
                <a class="pf-btn pf-btn--ghost pf-btn--full" href="@LoginUrl">@A("shared.login")</a>
            }
            @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
            {
                <p class="pf-status pf-status--err">@Status(Vm.StatusMessage)</p>
            }
            <input class="pf-input" type="password"
                   value="@Vm.LoginPassword"
                   @oninput="OnPasswordInput"
                   @onkeydown="OnLoginKey"
                   placeholder="@A("password")" autocomplete="current-password" />
            <button class="pf-btn pf-btn--primary pf-btn--full" @onclick="OnLogin">@Text["login"]</button>
        </div>
    }
    else
    {
        <div class="pa-tenant-shell">
            <aside class="pa-tenant-sidebar">
                <div class="pa-tenant-brand">
                    <span class="pa-tenant-brand__mark">@Initial</span>
                    <div><strong>@(Vm.Config?.OwnerName ?? Slug)</strong><small>/@Slug</small></div>
                </div>
                <nav class="pa-tenant-nav" aria-label="@Text["admin"]">
                    <button class="@(activeTab == "overview" ? "active" : null)" @onclick='() => SetTab("overview")'><i class="fas fa-table-cells-large"></i><span>@Text["overview"]</span></button>
                    <button class="@(activeTab == "project" ? "active" : null)" @onclick='() => SetTab("project")'><i class="fas fa-folder-open"></i><span>@Text["projects"]</span></button>
                    <button class="@(activeTab == "resume" ? "active" : null)" @onclick='() => SetTab("resume")'><i class="fas fa-file-lines"></i><span>@Text["career.profile"]</span></button>
                    <button class="@(activeTab == "messages" ? "active" : null)" @onclick='() => SetTab("messages")'>
                        <i class="fas fa-comment-dots"></i><span>@Text["messages"]</span>
                        @if (UnreadCount > 0) { <b>@UnreadCount</b> }
                    </button>
                    <button class="@(activeTab == "design" ? "active" : null)" @onclick='() => SetTab("design")'><i class="fas fa-pen-nib"></i><span>@Text["design"]</span></button>
                    <button class="@(activeTab == "settings" ? "active" : null)" @onclick='() => SetTab("settings")'><i class="fas fa-gear"></i><span>@Text["settings"]</span></button>
                </nav>
                <div class="pa-tenant-sidebar__footer">
                    <a href="/@Slug"><i class="fas fa-arrow-up-right-from-square"></i> @Text["public.page"]</a>
                    <button @onclick="OnLogout"><i class="fas fa-right-from-bracket"></i> @Text["logout"]</button>
                </div>
            </aside>

            <main class="pa-tenant-main">
                <header class="pa-tenant-header">
                    <div>
                        <p class="pa-eyebrow">Portfolio</p>
                        <h1>@(Vm.Config?.OwnerName ?? Slug) @Text["portfolio"]</h1>
                        <p>@Text["dashboard.tenant.sub"]</p>
                    </div>
                    <div class="pa-header-actions">
                        <button class="pf-btn pf-btn--ghost" @onclick="OnRefresh"><i class="fas fa-rotate"></i> @Text["refresh"]</button>
                        <a href="/@Slug" class="pf-btn pf-btn--primary"><i class="fas fa-arrow-up-right-from-square"></i> @Text["public.page"]</a>
                    </div>
                </header>

        @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
        {
            <p class="pf-status @(Vm.StatusMessage.StartsWith("✅") ? "pf-status--ok" : "pf-status--err")">
                @Status(Vm.StatusMessage)
            </p>
        }
        @if (Vm.IsSignedIn)
        {
            <p class="pf-status pf-status--ok">@A("shared.login"): @Vm.CurrentUserLabel · @(Vm.IsOwner ? A("role.owner") : A("role.admin"))</p>
        }

        @if (activeTab == "overview")
        {
            <section class="pa-overview">
                <div class="pa-stat-grid">
                    <article class="pa-stat-card"><span><i class="fas fa-layer-group"></i></span><div><small>@Text["stat.projects"]</small><strong>@Vm.Projects.Count</strong></div></article>
                    <article class="pa-stat-card"><span><i class="fas fa-globe"></i></span><div><small>@Text["stat.public"]</small><strong>@PublicProjectCount</strong></div></article>
                    <article class="pa-stat-card"><span><i class="fas fa-message"></i></span><div><small>@Text["stat.unread"]</small><strong>@UnreadCount</strong></div></article>
                    <article class="pa-stat-card"><span><i class="fas fa-circle-check"></i></span><div><small>@Text["stat.completion"]</small><strong>@CompletionPercent%</strong></div></article>
                </div>
                <div class="pa-overview-grid">
                    <article class="pa-panel">
                        <div class="pa-panel__heading"><div><p class="pa-eyebrow">Portfolio</p><h2>@Text["recent.projects"]</h2></div><button class="pf-btn pf-btn--sm pf-btn--ghost" @onclick='() => SetTab("project")'>@Text["projects"] →</button></div>
                        @if (Vm.Projects.Count == 0)
                        {
                            <div class="pa-empty"><i class="fas fa-folder-open"></i><p>@Text["project.none"]</p><button class="pf-btn pf-btn--primary" @onclick="NewProjectFromOverview">+ @Text["new.project"]</button></div>
                        }
                        else
                        {
                            <div class="pa-recent-list">
                                @foreach (var project in Vm.Projects.OrderBy(x => x.SortOrder == 0 ? int.MaxValue : x.SortOrder).Take(5))
                                {
                                    <button @onclick="() => EditProjectFromOverview(project)"><span>@project.Emoji</span><div><strong>@project.Title</strong><small>@CategoryLabel(project.Category) · @project.Year</small></div><i class="fas fa-chevron-right"></i></button>
                                }
                            </div>
                        }
                    </article>
                    <article class="pa-panel pa-completion">
                        <div class="pa-panel__heading"><h2>@Text["stat.completion"]</h2></div>
                        <div class="pa-completion__ring" style="--value:@CompletionPercent"><strong>@CompletionPercent%</strong></div>
                        <ul>
                            <li class="@(HasBasicProfile ? "done" : null)">@Text["owner.name"]</li>
                            <li class="@(Vm.Projects.Count > 0 ? "done" : null)">@Text["projects"]</li>
                            <li class="@(HasCareerProfile ? "done" : null)">@Text["career.profile"]</li>
                        </ul>
                    </article>
                </div>
            </section>
        }

        <!-- ── 탭: 프로젝트 ── -->
        @if (activeTab == "project")
        {
            <div class="pf-tab-body">
                @if (Vm.EditingProject == null)
                {
                    <button class="pf-btn pf-btn--primary" @onclick="Vm.NewProject">+ @Text["new.project"]</button>

                    @if (Vm.Projects.Count == 0)
                    {
                        <p class="pf-empty">@Text["project.none"]</p>
                    }
                    else
                    {
                        <div class="pf-project-admin-list">
                            @foreach (var p in Vm.Projects)
                            {
                                <div class="pf-project-admin-item">
                                    <span class="pf-project-admin-item__emoji">@p.Emoji</span>
                                    <span class="pf-project-admin-item__title">@p.Title</span>
                                    <span class="pf-project-admin-item__year">@p.Year</span>
                                    <span class="pf-badge @(p.Category == ProjectCategory.Work ? "pf-badge--blue" : p.Category == ProjectCategory.Public ? "pf-badge--purple" : "pf-badge--green")">
                                        @CategoryLabel(p.Category)
                                    </span>
                                    <div class="pf-project-admin-item__actions">
                                        <button class="pf-btn pf-btn--sm pf-btn--ghost"
                                                @onclick="() => Vm.EditProject(p)">@Text["edit"]</button>
                                        <button class="pf-btn pf-btn--sm pf-btn--danger"
                                                @onclick="() => OnDeleteProject(p.Id)">@Text["delete"]</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    var proj = Vm.EditingProject;
                    <div class="pf-post-editor">
                        <div class="pf-form__row">
                            <label class="pf-label">@Text["category"]</label>
                            <select class="pf-input" @bind="proj.Category">
                                <option value="@ProjectCategory.Personal">@Text["project.personal"]</option>
                                <option value="@ProjectCategory.Work">@Text["project.work"]</option>
                                <option value="@ProjectCategory.Public">@Text["project.public"]</option>
                            </select>
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@A("emoji")</label>
                            <input class="pf-input" @bind="proj.Emoji" style="max-width:80px" />
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@A("title")</label>
                            <input class="pf-input" @bind="proj.Title" placeholder="@A("work.title.placeholder")" />
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@A("description")</label>
                            <textarea class="pf-textarea" @bind="proj.Description" rows="3"></textarea>
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@Text["tag"] <span class="pf-label__hint">@A("comma.hint")</span></label>
                            <input class="pf-input" value="@string.Join(", ", proj.Tags)"
                                   @onchange="OnTagsChange" />
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@A("year")</label>
                            <input class="pf-input" type="number" @bind="proj.Year" style="max-width:100px" />
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@A("source.link")</label>
                            <input class="pf-input" @bind="proj.GitHub" placeholder="https://github.com/..." />
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@A("result.link")</label>
                            <input class="pf-input" @bind="proj.LiveUrl" placeholder="https://..." />
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@A("document.link")</label>
                            <input class="pf-input" @bind="proj.DocUrl" placeholder="https://..." />
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@A("display.order") <span class="pf-label__hint">@A("display.order.hint")</span></label>
                            <input class="pf-input" type="number" @bind="proj.SortOrder" style="max-width:80px" />
                        </div>

                        @if (proj.Category == ProjectCategory.Work)
                        {
                            <hr class="pf-divider" />
                            <h4>@A("work.extra")</h4>
                            <div class="pf-form__row">
                                <label class="pf-label">@A("subtitle")</label>
                                <input class="pf-input" @bind="proj.WorkSubtitle" />
                            </div>
                            <div class="pf-form__row">
                                <label class="pf-label">@A("period")</label>
                                <input class="pf-input" @bind="proj.WorkPeriod" placeholder="2023.01 ~ 2023.12" />
                            </div>
                            <div class="pf-form__row">
                                <label class="pf-label">@A("role")</label>
                                <input class="pf-input" @bind="proj.WorkRole" placeholder="@A("role.placeholder")" />
                            </div>
                            <div class="pf-form__row">
                                <label class="pf-label">@A("organization.client")</label>
                                <input class="pf-input" @bind="proj.WorkCompany" />
                            </div>
                            <div class="pf-form__row">
                                <label class="pf-label">@Text["skills"]</label>
                                <input class="pf-input" @bind="proj.WorkTech" placeholder="C#, WPF, SQL Server" />
                            </div>
                            <div class="pf-form__row">
                                <label class="pf-label">@Text["detail.results"] <span class="pf-label__hint">@A("line.hint")</span></label>
                                <textarea class="pf-textarea" rows="4"
                                          value="@string.Join("\n", proj.WorkBullets)"
                                          @onchange="OnWorkBulletsChange"></textarea>
                            </div>
                        }

                        <!-- 이미지 블러 설정 -->
                        <div class="pf-form__row">
                            <label class="pf-label">@A("image.blur") <span class="pf-label__hint">@A("image.blur.hint")</span></label>
                            <select class="pf-input" style="max-width:200px" @bind="proj.ImageBlurLevel">
                                <option value="0">@A("blur.none")</option>
                                <option value="1">@A("blur.low")</option>
                                <option value="2">@A("blur.medium")</option>
                                <option value="3">@A("blur.high")</option>
                            </select>
                        </div>

                        <!-- 이미지 업로드 -->
                        <div class="pf-form__row">
                            <label class="pf-label">@Text["detail.gallery"]</label>
                            @if (proj.Category == ProjectCategory.Work)
                            {
                                <div class="pf-img-guide">
                                    <span class="pf-img-guide__badge pf-img-guide__badge--hero">@A("hero.image") 1920×600</span>
                                    <span class="pf-img-guide__badge">@A("additional.image") 1200×675</span>
                                    <span class="pf-img-guide__tip">@A("hero.image.hint")</span>
                                </div>
                            }
                            else
                            {
                                <div class="pf-img-guide">
                                    <span class="pf-img-guide__badge pf-img-guide__badge--thumb">@A("cover.image") 1200×630</span>
                                    <span class="pf-img-guide__tip">@A("cover.image.hint")</span>
                                </div>
                            }
                            <div class="pf-media-input-row">
                                <InputFile class="pf-input-file" multiple OnChange="OnFilesSelected" accept="image/*" />
                                <span class="pf-media-input-or">@A("or.url")</span>
                                <div class="pf-url-add">
                                    <input class="pf-input pf-input--sm" @bind="imageUrlInput" placeholder="https://…" />
                                    <button class="pf-btn pf-btn--sm pf-btn--ghost" @onclick="OnAddImageUrl">+ @Text["add"]</button>
                                </div>
                            </div>
                            @if (Vm.PendingFiles.Count > 0)
                            {
                                <ul class="pf-file-list">
                                    @foreach (var f in Vm.PendingFiles)
                                    {
                                        <li>📎 @f.Name</li>
                                    }
                                </ul>
                            }
                        </div>

                        @{
                            // Work와 Personal/Public 모두 WorkImages로 통합 관리
                            // Personal/Public의 경우 ImageFileName이 별도 존재하면 포함
                            var allImages = proj.WorkImages.Length > 0
                                ? proj.WorkImages
                                : (string.IsNullOrWhiteSpace(proj.ImageFileName) ? [] : [proj.ImageFileName]);
                        }
                        @if (allImages.Length > 0)
                        {
                            <div class="pf-form__row">
                                <label class="pf-label">@A("uploaded.images")</label>
                                <div class="pf-media-grid pf-media-grid--admin">
                                    @foreach (var img in allImages)
                                    {
                                        <div class="pf-media-item">
                                            <img src="@Vm.GetImageUrl(Slug, proj.Id, img)" alt="" />
                                            <button class="pf-media-item__del"
                                                    @onclick="() => OnDeleteAnyImage(proj.Id, img, proj.Category)">✕</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- 동영상 업로드 -->
                        <div class="pf-form__row">
                            <label class="pf-label">@Text["detail.video"] <span class="pf-label__hint">@A("multiple.allowed")</span></label>
                            <div class="pf-media-input-row">
                                <InputFile class="pf-input-file" multiple OnChange="OnVideosSelected" accept="video/*" />
                                <span class="pf-media-input-or">@A("or.url")</span>
                                <div class="pf-url-add">
                                    <input class="pf-input pf-input--sm" @bind="videoUrlInput" placeholder="https://… (MP4, YouTube)" />
                                    <button class="pf-btn pf-btn--sm pf-btn--ghost" @onclick="OnAddVideoUrl">+ @Text["add"]</button>
                                </div>
                            </div>
                            @if (Vm.PendingVideos.Count > 0)
                            {
                                <ul class="pf-file-list">
                                    @foreach (var v in Vm.PendingVideos)
                                    {
                                        <li>🎬 @v.Name (@(v.Size / 1024 / 1024)MB)</li>
                                    }
                                </ul>
                            }
                        </div>

                        @if (proj.VideoFileNames.Length > 0)
                        {
                            <div class="pf-form__row">
                                <label class="pf-label">@A("uploaded.videos")</label>
                                <div class="pf-video-list pf-video-list--admin">
                                    @foreach (var vid in proj.VideoFileNames)
                                    {
                                        var adminVidUrl = Vm.GetVideoUrl(Slug, proj.Id, vid);
                                        <div class="pf-video-item">
                                            @if (PortfolioPublicViewModel.TryGetYouTubeEmbedUrl(adminVidUrl, out var adminEmbedUrl))
                                            {
                                                <iframe class="pf-video--admin pf-video--yt" src="@adminEmbedUrl"
                                                        frameborder="0" allowfullscreen
                                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                                            }
                                            else
                                            {
                                                <video src="@adminVidUrl" controls class="pf-video--admin" preload="metadata"></video>
                                            }
                                            <button class="pf-media-item__del"
                                                    @onclick="() => OnDeleteVideo(proj.Id, vid)">✕</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="pf-form__actions">
                            <button class="pf-btn pf-btn--primary" @onclick="OnSaveProject" disabled="@Vm.IsUploading">
                                @(Vm.IsUploading ? A("uploading") : Text["save"])
                            </button>
                            <button class="pf-btn pf-btn--ghost" @onclick="Vm.CancelEdit">@Text["cancel"]</button>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- ── 탭: Resume ── -->
        @if (activeTab == "resume")
        {
            <div class="pf-tab-body">

                <h3>🛠 @Text["skills"]</h3>
                <div class="pf-form pf-form--inline">
                    <input class="pf-input" @bind="Vm.NewSkillCategory" placeholder="@A("strength.category.placeholder")" />
                    <input class="pf-input" @bind="Vm.NewSkillNames" placeholder="@A("strength.items.placeholder")" />
                    <button class="pf-btn pf-btn--primary" @onclick="Vm.AddSkillGroup">+ @Text["add"]</button>
                </div>
                @foreach (var g in Vm.Resume.SkillGroups)
                {
                    <div class="pf-skill-admin-item">
                        <strong>@g.Category</strong>
                        <span>@string.Join(", ", g.Skills)</span>
                        <button class="pf-btn pf-btn--sm pf-btn--danger"
                                @onclick="() => Vm.RemoveSkillGroup(g)">@Text["delete"]</button>
                    </div>
                }

                <hr class="pf-divider" />

                <h3>💼 @Text["experience"]</h3>
                @if (Vm.EditingExp == null)
                {
                    <button class="pf-btn pf-btn--primary" @onclick="Vm.NewExperience">+ @A("experience.add")</button>
                    @foreach (var exp in Vm.Resume.Experiences)
                    {
                        <div class="pf-exp-admin-item">
                            <strong>@exp.Company</strong> · @exp.Role · @exp.Period
                            <button class="pf-btn pf-btn--sm pf-btn--ghost"
                                    @onclick="() => Vm.EditExperience(exp)">@Text["edit"]</button>
                            <button class="pf-btn pf-btn--sm pf-btn--danger"
                                    @onclick="() => Vm.RemoveExperience(exp)">@Text["delete"]</button>
                        </div>
                    }
                }
                else
                {
                    var exp = Vm.EditingExp;
                    <div class="pf-post-editor">
                        <div class="pf-form__row"><label class="pf-label">@A("organization")</label><input class="pf-input" @bind="exp.Company" /></div>
                        <div class="pf-form__row"><label class="pf-label">@A("role")</label><input class="pf-input" @bind="exp.Role" /></div>
                        <div class="pf-form__row"><label class="pf-label">@A("period")</label><input class="pf-input" @bind="exp.Period" placeholder="2020.01 ~ 2023.12" /></div>
                        <div class="pf-form__row"><label class="pf-label">@A("description")</label><textarea class="pf-textarea" @bind="exp.Description" rows="2"></textarea></div>
                        <div class="pf-form__row">
                            <label class="pf-label">@Text["detail.results"] <span class="pf-label__hint">@A("line.hint")</span></label>
                            <textarea class="pf-textarea" rows="4"
                                      value="@string.Join("\n", exp.Bullets)"
                                      @onchange="OnExpBulletsChange"></textarea>
                        </div>
                        <div class="pf-form__actions">
                            <button class="pf-btn pf-btn--primary" @onclick="Vm.SaveExperience">@Text["save"]</button>
                            <button class="pf-btn pf-btn--ghost" @onclick="Vm.CancelExp">@Text["cancel"]</button>
                        </div>
                    </div>
                }

                <hr class="pf-divider" />

                <h3>🎓 @Text["education"]</h3>
                @if (Vm.EditingEdu == null)
                {
                    <button class="pf-btn pf-btn--primary" @onclick="Vm.NewEducation">+ @A("education.add")</button>
                    @foreach (var edu in Vm.Resume.Educations)
                    {
                        <div class="pf-exp-admin-item">
                            <strong>@edu.School</strong> · @edu.Degree · @edu.Period
                            <button class="pf-btn pf-btn--sm pf-btn--ghost"
                                    @onclick="() => Vm.EditEducation(edu)">@Text["edit"]</button>
                            <button class="pf-btn pf-btn--sm pf-btn--danger"
                                    @onclick="() => Vm.RemoveEducation(edu)">@Text["delete"]</button>
                        </div>
                    }
                }
                else
                {
                    var edu = Vm.EditingEdu;
                    <div class="pf-post-editor">
                        <div class="pf-form__row"><label class="pf-label">@A("school")</label><input class="pf-input" @bind="edu.School" /></div>
                        <div class="pf-form__row"><label class="pf-label">@A("degree")</label><input class="pf-input" @bind="edu.Degree" /></div>
                        <div class="pf-form__row"><label class="pf-label">@A("period")</label><input class="pf-input" @bind="edu.Period" placeholder="2010.03 ~ 2014.02" /></div>
                        <div class="pf-form__actions">
                            <button class="pf-btn pf-btn--primary" @onclick="Vm.SaveEducation">@Text["save"]</button>
                            <button class="pf-btn pf-btn--ghost" @onclick="Vm.CancelEdu">@Text["cancel"]</button>
                        </div>
                    </div>
                }

                <hr class="pf-divider" />
                <button class="pf-btn pf-btn--primary" @onclick="OnSaveResume">💾 @A("career.save")</button>
            </div>
        }

        <!-- ── 탭: 메시지 ── -->
        @if (activeTab == "messages")
        {
            <div class="pf-tab-body">
                @if (Vm.Messages.Count == 0)
                {
                    <p class="pf-empty">@A("messages.none")</p>
                }
                else
                {
                    @foreach (var msg in Vm.Messages)
                    {
                        <div class="pf-message-item @(msg.IsRead ? "" : "pf-message-item--unread")">
                            <div class="pf-message-item__header">
                                <strong>@msg.SenderName</strong>
                                @if (!string.IsNullOrWhiteSpace(msg.Email))
                                {
                                    <a href="mailto:@msg.Email" class="pf-message-item__email">@msg.Email</a>
                                }
                                <span class="pf-message-item__date">@msg.SentAt.ToString("yy.MM.dd HH:mm")</span>
                                @if (!msg.IsRead)
                                {
                                    <span class="pf-badge pf-badge--new">@A("new")</span>
                                }
                            </div>
                            <p class="pf-message-item__body">@msg.Message</p>
                            <div class="pf-message-item__actions">
                                @if (!msg.IsRead)
                                {
                                    <button class="pf-btn pf-btn--sm pf-btn--ghost"
                                            @onclick="() => OnMarkRead(msg.Id)">@A("mark.read")</button>
                                }
                                <button class="pf-btn pf-btn--sm pf-btn--danger"
                                        @onclick="() => OnDeleteMessage(msg.Id)">@Text["delete"]</button>
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @if (activeTab == "design" && Vm.Config is not null)
        {
            var designConfig = Vm.Config;
            <div class="pf-tab-body pa-design-panel">
                <div class="pa-panel__heading">
                    <div><p class="pa-eyebrow">Portfolio</p><h2>@Text["design"]</h2></div>
                    <a href="/@Slug" target="_blank" class="pf-btn pf-btn--ghost"><i class="fas fa-arrow-up-right-from-square"></i> @Text["public.page"]</a>
                </div>
                <p class="pf-muted">@A("design.public.hint")</p>
                <div class="pa-theme-grid">
                    @foreach (var theme in PortfolioThemes)
                    {
                        <button type="button" class="pa-theme-card @(designConfig.ThemeName == theme.Value ? "selected" : null)" @onclick="() => SelectPortfolioTheme(theme.Value)">
                            <span class="pa-theme-card__preview theme-@theme.Value"><i></i><b></b><em></em></span>
                            <strong>@A(theme.Label)</strong>
                            @if (designConfig.ThemeName == theme.Value) { <small><i class="fas fa-check"></i> @A("applied")</small> }
                        </button>
                    }
                </div>
                <div class="pa-design-actions">
                    <button class="pf-btn pf-btn--primary" @onclick="OnSaveConfig"><i class="fas fa-floppy-disk"></i> @Text["save"]</button>
                </div>
            </div>
        }

        <!-- ── 탭: 설정 ── -->
        @if (activeTab == "settings" && Vm.Config is not null)
        {
            var cfg = Vm.Config;
            <div class="pf-tab-body pf-settings">
                <div class="pf-form__row">
                    <h3 style="margin-bottom:.8rem">@A("admin.accounts")</h3>
                    <p class="pf-muted">@A("admin.accounts.hint")</p>
                    @if (Vm.EffectiveAdminUsers.Count == 0)
                    {
                        <p class="pf-muted">@A("admin.accounts.none")</p>
                    }
                    else
                    {
                        <div class="pf-admin-users">
                            @foreach (var admin in Vm.EffectiveAdminUsers)
                            {
                                var isOwner = string.Equals(admin.Role, "Owner", StringComparison.OrdinalIgnoreCase);
                                <div class="pf-admin-users__item">
                                    <div>
                                        <strong>@(isOwner ? A("role.owner") : A("role.admin"))</strong>
                                        <span>@(string.IsNullOrWhiteSpace(admin.DisplayName) ? admin.Provider : admin.DisplayName)</span>
                                        @if (!string.IsNullOrWhiteSpace(admin.Email))
                                        {
                                            <small>@admin.Email</small>
                                        }
                                        <small>@admin.Provider · @admin.AddedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                    </div>
                                    @if (Vm.IsOwner && !isOwner)
                                    {
                                        <button class="pf-btn pf-btn--danger pf-btn--sm" @onclick="() => OnRemoveAdmin(admin.UserId)">@Text["delete"]</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <hr class="pf-divider" />

                <div class="pf-form__row">
                    <label class="pf-label">@Text["owner.name"]</label>
                    <input class="pf-input" @bind="cfg.OwnerName" />
                </div>
                <div class="pf-form__row">
                    <label class="pf-label">@A("professional.title")</label>
                    <input class="pf-input" @bind="cfg.Title" placeholder="@A("professional.title.placeholder")" />
                </div>
                <div class="pf-form__row">
                    <label class="pf-label">@A("short.intro")</label>
                    <textarea class="pf-textarea" @bind="cfg.Bio" rows="2"></textarea>
                </div>
                <div class="pf-form__row">
                    <label class="pf-label">@A("profile.photo")</label>
                    <div class="pf-img-guide">
                        <span class="pf-img-guide__badge pf-img-guide__badge--profile">400×400</span>
                        <span class="pf-img-guide__tip">@A("profile.photo.hint")</span>
                    </div>
                    <InputFile class="pf-input-file" OnChange="OnProfileSelected" accept="image/*" />
                    @if (!string.IsNullOrWhiteSpace(cfg.ProfileImageFileName))
                    {
                        <img class="pf-cover-preview"
                             src="@Vm.GetProfileImageUrl(Slug, cfg.ProfileImageFileName)" alt="@A("profile.photo")" />
                    }
                </div>
                <div class="pf-form__row">
                    <label class="pf-label">@Text["theme"]</label>
                    <select class="pf-input" @bind="cfg.ThemeName">
                        <option value="dark">🌑 @A("theme.dark")</option>
                        <option value="ocean">🌊 @A("theme.ocean")</option>
                        <option value="forest">🌲 @A("theme.forest")</option>
                        <option value="minimal">⬜ @A("theme.minimal")</option>
                        <option value="warm">🍊 @A("theme.warm")</option>
                    </select>
                </div>
                <div class="pf-form__row">
                    <label class="pf-label">GitHub URL</label>
                    <input class="pf-input" @bind="cfg.GithubUrl" placeholder="https://github.com/username" />
                </div>
                <div class="pf-form__row">
                    <label class="pf-label">LinkedIn URL</label>
                    <input class="pf-input" @bind="cfg.LinkedInUrl" placeholder="https://linkedin.com/in/..." />
                </div>
                <div class="pf-form__row">
                    <label class="pf-label">@A("public.email")</label>
                    <input class="pf-input" type="email" @bind="cfg.ContactEmail" />
                </div>
                <div class="pf-form__row pf-form__row--check">
                    <label>
                        <input type="checkbox" @bind="cfg.AllowContact" />
                        📬 @A("contact.allow")
                    </label>
                </div>
                <div class="pf-form__row pf-form__row--check">
                    <label>
                        <input type="checkbox" @bind="cfg.ShowOnHome" />
                        🏠 @A("home.show")
                    </label>
                </div>
                <div class="pf-form__row">
                    <label class="pf-label">@A("preview.title")</label>
                    <input class="pf-input" @bind="cfg.OgTitle" placeholder="@A("preview.title.hint")" />
                </div>
                <div class="pf-form__row">
                    <label class="pf-label">@A("preview.description")</label>
                    <input class="pf-input" @bind="cfg.OgDescription" />
                </div>

                <button class="pf-btn pf-btn--primary" @onclick="OnSaveConfig">💾 @A("settings.save")</button>

                <hr class="pf-divider" />

                <div class="pf-form__row">
                    <h3 style="margin-bottom:.8rem">🔑 @A("password.change")</h3>
                    <div class="pf-pw-change">
                        <div class="pf-form__row">
                            <label class="pf-label">@A("password.current")</label>
                            <input class="pf-input" type="password" @bind="currentPw" placeholder="@A("password.current")" />
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@A("password.new") <span class="pf-label__hint">@A("password.min8")</span></label>
                            <input class="pf-input" type="password" @bind="newPw" placeholder="@A("password.new")" />
                        </div>
                        <div class="pf-form__row">
                            <label class="pf-label">@A("password.confirm")</label>
                            <input class="pf-input" type="password" @bind="newPwConfirm" placeholder="@A("password.confirm.placeholder")" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(pwMessage))
                        {
                            <p class="pf-status @(pwMessage.StartsWith("✅") ? "pf-status--ok" : "pf-status--err")">@Status(pwMessage)</p>
                        }
                        <button class="pf-btn pf-btn--primary" @onclick="OnChangePassword">🔑 @A("password.change")</button>
                    </div>
                </div>

                <hr class="pf-divider" />

                <div class="pf-danger-zone">
                    <h3>⚠️ @A("danger.zone")</h3>
                    <p>@A("danger.hint")</p>
                    @if (!confirmDelete)
                    {
                        <button class="pf-btn pf-btn--danger" @onclick="() => confirmDelete = true">
                            🗑 @A("portfolio.delete")
                        </button>
                    }
                    else
                    {
                        <div class="pf-delete-confirm">
                            <p><strong>@string.Format(A("portfolio.delete.confirm"), Slug)</strong><br />@A("portfolio.delete.scope")</p>
                            <div class="pf-form__actions">
                                <button class="pf-btn pf-btn--danger" @onclick="OnDeleteSelf">@A("confirm.delete")</button>
                                <button class="pf-btn pf-btn--ghost" @onclick="() => confirmDelete = false">@Text["cancel"]</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
            </main>
        </div>
    }
</div>

