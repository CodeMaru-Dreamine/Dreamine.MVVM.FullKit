@page "/guide"
@layout PortfolioApp.Blazor.Layout.PortfolioLayout
@namespace PortfolioApp.Blazor.Pages

@inject PortfolioLocalization Text

<PageTitle>@Text["guide"] — CodeMaru Portfolio</PageTitle>

<div class="pf-page pf-guide">
    <div class="pf-guide__inner">
        <h1 class="pf-guide__title">📖 @Text["guide"]</h1>

        <h2 class="pf-guide__section-title">@Local("quick.title")</h2>
        <ol class="pf-guide__steps">
            <li>
                <strong>@Text["create.portfolio"]</strong>
                <p>@Text["create.desc"]</p>
            </li>
            <li>
                <strong>@Text["admin"]</strong>
                <p>@Local("admin.desc")</p>
            </li>
            <li>
                <strong>@Text["projects"]</strong>
                <p>@Text["feature.projects.desc"]</p>
            </li>
            <li>
                <strong>@Text["career.profile"]</strong>
                <p>@Text["feature.career.desc"]</p>
            </li>
            <li>
                <strong>@Text["settings"]</strong>
                <p>@Local("settings.desc")</p>
            </li>
            <li>
                <strong>@Text["public.page"]</strong>
                <p>@Local("share.desc")</p>
            </li>
        </ol>

        <h2 class="pf-guide__section-title">🖼️ @Local("media.title")</h2>
        <p class="pf-guide__section-desc">@Local("media.desc")</p>

        <div class="pf-guide__img-table">
            <div class="pf-guide__img-row pf-guide__img-row--header">
                <span>@Local("table.use")</span>
                <span>@Local("table.size")</span>
                <span>@Local("table.ratio")</span>
                <span>@Local("table.note")</span>
            </div>
            <div class="pf-guide__img-row">
                <span><span class="pf-img-guide__badge pf-img-guide__badge--profile" style="font-size:.75rem">@Local("profile.label")</span></span>
                <span class="pf-guide__img-size">400 × 400</span>
                <span class="pf-guide__img-ratio">1 : 1</span>
                <span class="pf-guide__img-desc">@Local("profile.desc")</span>
            </div>
            <div class="pf-guide__img-row">
                <span><span class="pf-img-guide__badge pf-img-guide__badge--thumb" style="font-size:.75rem">@Local("cover.label")</span></span>
                <span class="pf-guide__img-size">1200 × 630</span>
                <span class="pf-guide__img-ratio">16 : 9</span>
                <span class="pf-guide__img-desc">@Local("cover.desc")</span>
            </div>
            <div class="pf-guide__img-row">
                <span><span class="pf-img-guide__badge pf-img-guide__badge--hero" style="font-size:.75rem">@Local("banner.label")</span></span>
                <span class="pf-guide__img-size">1920 × 600</span>
                <span class="pf-guide__img-ratio">16 : 5</span>
                <span class="pf-guide__img-desc">@Local("banner.desc")</span>
            </div>
            <div class="pf-guide__img-row">
                <span><span class="pf-img-guide__badge" style="font-size:.75rem">@Local("gallery.label")</span></span>
                <span class="pf-guide__img-size">1200 × 675</span>
                <span class="pf-guide__img-ratio">16 : 9</span>
                <span class="pf-guide__img-desc">@Local("gallery.desc")</span>
            </div>
            <div class="pf-guide__img-row">
                <span><span class="pf-img-guide__badge" style="font-size:.75rem">@Text["detail.video"]</span></span>
                <span class="pf-guide__img-size">≤ 500 MB</span>
                <span class="pf-guide__img-ratio">16 : 9</span>
                <span class="pf-guide__img-desc">@Local("video.desc")</span>
            </div>
        </div>

        <div class="pf-guide__tip-box">
            <strong>💡 @Local("tips.title")</strong>
            <ul>
                <li>@Local("tips.formats")</li>
                <li>@Local("tips.limits")</li>
                <li>@Local("tips.crop")</li>
            </ul>
        </div>

        <h2 class="pf-guide__section-title">🏷️ @Local("categories.title")</h2>
        <div class="pf-guide__cat-grid">
            <div class="pf-guide__cat-card">
                <div class="pf-guide__cat-badge pf-guide__cat-badge--personal">@Text["project.personal"]</div>
                <p>@Local("category.personal.desc")</p>
            </div>
            <div class="pf-guide__cat-card">
                <div class="pf-guide__cat-badge pf-guide__cat-badge--work">@Text["project.work"]</div>
                <p>@Local("category.work.desc")</p>
            </div>
            <div class="pf-guide__cat-card">
                <div class="pf-guide__cat-badge pf-guide__cat-badge--public">@Text["project.public"]</div>
                <p>@Local("category.public.desc")</p>
            </div>
        </div>

        <h2 class="pf-guide__faq-title">❓ @Local("faq.title")</h2>
        <dl class="pf-guide__faq">
            <dt>@Local("faq.password.q")</dt>
            <dd>@Local("faq.password.a")</dd>
            <dt>@Local("faq.visibility.q")</dt>
            <dd>@Local("faq.visibility.a")</dd>
        </dl>

        <div class="pf-guide__contact">
            @Text["contact"]: <a href="mailto:admin@codemaru.co.kr">admin@codemaru.co.kr</a>
        </div>
    </div>
</div>

