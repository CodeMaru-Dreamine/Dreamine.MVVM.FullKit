@page "/{Slug}"
@layout PortfolioApp.Blazor.Layout.PortfolioLayout
@namespace PortfolioApp.Blazor.Pages
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@implements IDisposable

@inject PortfolioPublicViewModel Vm
@inject PortfolioLocalization Text
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(Vm.Config?.OwnerName ?? Slug) — Portfolio</PageTitle>

@if (Vm.Config is { } metadata)
{
    string pageTitle = string.IsNullOrWhiteSpace(metadata.OgTitle) ? $"{metadata.OwnerName} — Portfolio" : metadata.OgTitle;
    string description = string.IsNullOrWhiteSpace(metadata.OgDescription) ? metadata.Bio : metadata.OgDescription;
    string? imageUrl = GetSocialImageUrl(metadata);

    <HeadContent>
        <meta name="description" content="@description" />
        <link rel="canonical" href="@Nav.Uri" />
        <meta property="og:title" content="@pageTitle" />
        <meta property="og:description" content="@description" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@Nav.Uri" />
        @if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            <meta property="og:image" content="@imageUrl" />
            <meta name="twitter:card" content="summary_large_image" />
            <meta name="twitter:image" content="@imageUrl" />
        }
        <meta name="twitter:title" content="@pageTitle" />
        <meta name="twitter:description" content="@description" />
    </HeadContent>
}

<div class="pf-page pf-portfolio theme-@(Vm.Config?.ThemeName ?? "dark")">
    @if (!Vm.HasLoaded)
    {
        <div class="pf-loading" aria-live="polite">
            <div class="pf-loading__mark"></div>
        </div>
    }
    else if (Vm.Config is null)
    {
        <div class="pf-not-found">
            <h1>404</h1>
            <p>@Text["notfound.portfolio"]</p>
            <a href="@HomePath" class="pf-btn pf-btn--primary">@Text["home"]</a>
        </div>
    }
    else
    {
        PortfolioConfig cfg = Vm.Config;

        <nav class="pf-nav pf-nav--portfolio" aria-label="Portfolio">
            <a href="@PortfolioPath" class="pf-nav__brand">
                <span class="pf-nav__brand-icon">●</span>
                <span class="pf-nav__brand-text">@cfg.OwnerName</span>
            </a>
            <div class="pf-nav__links">
                <a href="#" @onclick="ScrollToProjects" @onclick:preventDefault class="pf-nav__link">@Text["projects"]</a>
                <a href="#" @onclick="ScrollToResume" @onclick:preventDefault class="pf-nav__link">@Text["career.profile"]</a>
                @if (cfg.AllowContact)
                {
                    <a href="#" @onclick="ScrollToContact" @onclick:preventDefault class="pf-nav__link">@Text["contact"]</a>
                }
                <a href="@AdminPath" class="pf-nav__link pf-nav__link--ghost">@Text["admin"]</a>
            </div>
        </nav>

        <section class="pf-profile-hero">
            <div class="pf-profile-hero__inner">
                @if (!string.IsNullOrWhiteSpace(cfg.ProfileImageFileName))
                {
                    <img class="pf-profile-hero__avatar"
                         src="@Vm.GetProfileImageUrl(Slug, cfg.ProfileImageFileName)"
                         alt="@cfg.OwnerName" />
                }
                else
                {
                    <div class="pf-profile-hero__avatar pf-profile-hero__avatar--empty" aria-hidden="true">@Initial(cfg.OwnerName)</div>
                }
                <div class="pf-profile-hero__meta">
                    <h1 class="pf-profile-hero__name">@cfg.OwnerName</h1>
                    <p class="pf-profile-hero__title">@cfg.Title</p>
                    @if (!string.IsNullOrWhiteSpace(cfg.Bio))
                    {
                        <p class="pf-profile-hero__bio">@cfg.Bio</p>
                    }
                    <div class="pf-profile-hero__links">
                        @if (SafeExternalUrl(cfg.GithubUrl) is { } githubUrl)
                        {
                            <a href="@githubUrl" target="_blank" rel="noopener noreferrer" class="pf-social-link"><i class="fab fa-github"></i> GitHub</a>
                        }
                        @if (SafeExternalUrl(cfg.LinkedInUrl) is { } linkedInUrl)
                        {
                            <a href="@linkedInUrl" target="_blank" rel="noopener noreferrer" class="pf-social-link"><i class="fab fa-linkedin"></i> LinkedIn</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(cfg.ContactEmail))
                        {
                            <a href="mailto:@cfg.ContactEmail" class="pf-social-link"><i class="fas fa-envelope"></i> @cfg.ContactEmail</a>
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="pf-section" id="projects">
            <div class="pf-section__header">
                <h2><i class="fas fa-layer-group"></i> @Text["projects"]</h2>
            </div>

            <div class="pf-toolbar">
                <div class="pf-tool pf-tool--search">
                    <i class="fas fa-magnifying-glass"></i>
                    <input class="pf-input" aria-label="@(Text["search"])" placeholder="@(Text["filter.search"])"
                           value="@Vm.Query" @oninput="OnQueryInput" />
                </div>
                <div class="pf-tool">
                    <label>@Text["tag"]</label>
                    <select class="pf-input" @bind="Vm.SelectedTag">
                        <option value="">@Text["all.tags"]</option>
                        @foreach (string tag in Vm.AllTags)
                        {
                            <option value="@tag">@tag</option>
                        }
                    </select>
                </div>
                <div class="pf-tool">
                    <label>@Text["category"]</label>
                    <select class="pf-input" @bind="Vm.SelectedCategory">
                        <option value="">@Text["all"]</option>
                        <option value="Personal">@Text["project.personal"]</option>
                        <option value="Work">@Text["project.work"]</option>
                        <option value="Public">@Text["project.public"]</option>
                    </select>
                </div>
            </div>

            @if (Vm.Personal.Count > 0)
            {
                <div class="pf-category">
                    <h3 class="pf-category__title">@Text["project.personal"]</h3>
                    <div class="pf-grid pf-grid--projects">
                        @foreach (ProjectItem project in Vm.Personal)
                        {
                            <PortfolioProjectCard @key="project.Id" Project="project" Slug="@Slug" Vm="Vm" Text="Text" />
                        }
                    </div>
                </div>
            }

            @if (Vm.Work.Count > 0)
            {
                <div class="pf-category">
                    <h3 class="pf-category__title">@Text["project.work"]</h3>
                    <div class="pf-grid pf-grid--projects">
                        @foreach (ProjectItem project in Vm.Work)
                        {
                            <PortfolioProjectCard @key="project.Id" Project="project" Slug="@Slug" Vm="Vm" Text="Text" />
                        }
                    </div>
                </div>
            }

            @if (Vm.Public.Count > 0)
            {
                <div class="pf-category">
                    <h3 class="pf-category__title">@Text["project.public"]</h3>
                    <div class="pf-grid pf-grid--projects">
                        @foreach (ProjectItem project in Vm.Public)
                        {
                            <PortfolioProjectCard @key="project.Id" Project="project" Slug="@Slug" Vm="Vm" Text="Text" />
                        }
                    </div>
                </div>
            }

            @if (Vm.Personal.Count == 0 && Vm.Work.Count == 0 && Vm.Public.Count == 0)
            {
                <p class="pf-empty">@Text["project.none"]</p>
            }
        </section>

        @if (HasCareer)
        {
            <section class="pf-section" id="resume">
                <div class="pf-section__header"><h2><i class="fas fa-id-card"></i> @Text["career.profile"]</h2></div>

                @if (Vm.Resume.SkillGroups.Count > 0)
                {
                    <div class="pf-resume-block">
                        <h3 class="pf-resume-block__title">@Text["skills"]</h3>
                        @foreach (SkillGroup group in Vm.Resume.SkillGroups)
                        {
                            <div class="pf-skill-group">
                                <span class="pf-skill-group__label">@group.Category</span>
                                <div class="pf-skill-chips">
                                    @foreach (string skill in group.Skills)
                                    {
                                        <span class="pf-skill-chip">@skill</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (Vm.Resume.Experiences.Count > 0)
                {
                    <div class="pf-resume-block">
                        <h3 class="pf-resume-block__title">@Text["experience"]</h3>
                        @foreach (ExperienceItem experience in Vm.Resume.Experiences)
                        {
                            <div class="pf-exp-card">
                                <div class="pf-exp-card__header">
                                    <strong>@experience.Company</strong>
                                    <span class="pf-exp-card__role">@experience.Role</span>
                                    <span class="pf-exp-card__period">@experience.Period</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(experience.Description))
                                {
                                    <p class="pf-exp-card__desc">@experience.Description</p>
                                }
                                @if (experience.Bullets.Count > 0)
                                {
                                    <ul class="pf-exp-card__bullets">
                                        @foreach (string item in experience.Bullets)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                }

                @if (Vm.Resume.Educations.Count > 0)
                {
                    <div class="pf-resume-block">
                        <h3 class="pf-resume-block__title">@Text["education"]</h3>
                        @foreach (EducationItem education in Vm.Resume.Educations)
                        {
                            <div class="pf-edu-card">
                                <strong>@education.School</strong>
                                <span class="pf-edu-card__degree">@education.Degree</span>
                                <span class="pf-edu-card__period">@education.Period</span>
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @if (cfg.AllowContact)
        {
            <section class="pf-section" id="contact">
                <div class="pf-section__header"><h2><i class="fas fa-envelope"></i> @Text["contact"]</h2></div>
                @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
                {
                    <p class="pf-status @(Vm.StatusMessage.StartsWith("✅", StringComparison.Ordinal) ? "pf-status--ok" : "pf-status--err")">@LocalizedContactStatus</p>
                }
                <div class="pf-contact-form">
                    <div class="pf-form__row">
                        <label class="pf-label">@Text["name"]</label>
                        <input class="pf-input" autocomplete="name" maxlength="100" required @bind="Vm.ContactName" />
                    </div>
                    <div class="pf-form__row">
                        <label class="pf-label">@Text["email.optional"]</label>
                        <input class="pf-input" type="email" autocomplete="email" maxlength="254" @bind="Vm.ContactEmail" />
                    </div>
                    <div class="pf-form__row">
                        <label class="pf-label">@Text["message"]</label>
                        <textarea class="pf-textarea" @bind="Vm.ContactMessage" rows="4" maxlength="4000" required placeholder="@(Text["contact.placeholder"])"></textarea>
                    </div>
                    <button class="pf-btn pf-btn--primary" disabled="@Vm.IsSendingContact" @onclick="OnSendContact"><i class="fas fa-paper-plane"></i> @Text["send"]</button>
                </div>
            </section>
        }

        <footer class="pf-footer">
            <p>@cfg.OwnerName · Powered by <a href="@HomePath">CodeMaru Portfolio</a></p>
        </footer>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private string LanguageQuery => $"?lang={Uri.EscapeDataString(Text.Language)}";
    private string HomePath => $"/{LanguageQuery}";
    private string PortfolioPath => $"/{Slug}{LanguageQuery}";
    private string AdminPath => $"/{Slug}/admin{LanguageQuery}";
    private bool HasCareer => Vm.Resume.SkillGroups.Count > 0 || Vm.Resume.Experiences.Count > 0 || Vm.Resume.Educations.Count > 0;
    private string LocalizedContactStatus => Vm.StatusMessage.StartsWith("✅", StringComparison.Ordinal)
        ? Text["contact.success"]
        : Vm.StatusMessage.Contains("잠시 후", StringComparison.Ordinal)
            ? Text["contact.rate"]
        : Vm.StatusMessage.Contains("글자 수", StringComparison.Ordinal)
            ? Text["contact.too.long"]
        : Vm.StatusMessage.Contains("이메일 또는", StringComparison.Ordinal)
            ? Text["contact.invalid"]
        : Vm.StatusMessage.Contains("이름", StringComparison.Ordinal) || Vm.StatusMessage.Contains("메시지", StringComparison.Ordinal)
            ? Text["contact.required"]
            : Vm.StatusMessage;

    protected override void OnInitialized()
    {
        Text.Changed += OnLanguageChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await Vm.LoadAsync(Slug);
    }

    private string? GetSocialImageUrl(PortfolioConfig config)
    {
        ProjectItem? coverProject = Vm.Projects.FirstOrDefault(project =>
            !string.IsNullOrWhiteSpace(project.WorkImages.FirstOrDefault() ?? project.ImageFileName));
        string? coverFileName = coverProject?.WorkImages.FirstOrDefault() ?? coverProject?.ImageFileName;
        string? relativeUrl = !string.IsNullOrWhiteSpace(config.ProfileImageFileName)
            ? Vm.GetProfileImageUrl(Slug, config.ProfileImageFileName)
            : coverProject is null || string.IsNullOrWhiteSpace(coverFileName)
                ? null
                : Vm.GetImageUrl(Slug, coverProject.Id, coverFileName);

        return string.IsNullOrWhiteSpace(relativeUrl) ? null : Nav.ToAbsoluteUri(relativeUrl).ToString();
    }

    private static string Initial(string value) => string.IsNullOrWhiteSpace(value) ? "P" : value.Trim()[0].ToString();

    private static string? SafeExternalUrl(string? value)
    {
        if (!Uri.TryCreate(value, UriKind.Absolute, out Uri? uri))
            return null;

        return uri.Scheme is "http" or "https" ? uri.AbsoluteUri : null;
    }

    private Task ScrollTo(string id) => JS.InvokeVoidAsync("portfolioInterop.scrollToId", id).AsTask();
    private Task ScrollToProjects() => ScrollTo("projects");
    private Task ScrollToResume() => ScrollTo("resume");
    private Task ScrollToContact() => ScrollTo("contact");
    private void OnQueryInput(ChangeEventArgs args) => Vm.Query = args.Value?.ToString() ?? string.Empty;
    private Task OnSendContact() => Vm.SendContactAsync(Slug);
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Text.Changed -= OnLanguageChanged;
    }
}
