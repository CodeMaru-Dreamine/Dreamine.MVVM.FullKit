@inherits LayoutComponentBase
@namespace PortfolioApp.Blazor.Layout
@implements IDisposable
@inject PortfolioUserContext UserContext
@inject PortfolioLocalization Text
@inject NavigationManager Nav

<div class="pf-portal-shell">
    <DreaminePortalHeader BrandName="CodeMaru"
                          BrandUrl="@CodeMaruHomeUrl"
                          BrandImageUrl="/img/Codemaru_Bloom.jpg"
                          BrandLightImageUrl="/img/Codemaru%20Bloom%20Light.jpg"
                          BrandImageAlt=""
                          Items="@PortalItems"
                          ActiveKey="portfolio"
                          NavigationAriaLabel="CodeMaru services"
                          ToggleMenuLabel="@Text["nav.toggle"]"
                          UseCodeMaruAppearance="true"
                          Fixed="true"
                          IsAuthenticated="@currentUser.IsAuthenticated"
                          DisplayName="@NavUserLabel"
                          ScreenSettingsLabel="@Text["screen.settings"]"
                          LoginUrl="@LoginUrl"
                          LoginLabel="@Text["login"]"
                          AccountUrl="@AccountUrl"
                          AccountLabel="@Text["account"]"
                          SignoutUrl="@SignoutUrl"
                          SignoutLabel="@Text["logout"]">
        <Preferences>
            <PortfolioPreferences />
        </Preferences>
        <AdditionalUserActions>
            <a href="@LocalizedPath("/guide")"><span aria-hidden="true">?</span> @Text["guide"]</a>
            @if (currentUser.IsAuthenticated)
            {
                <a href="@LocalizedPath("/admin")"><span aria-hidden="true">⌁</span> @Text["admin"]</a>
            }
        </AdditionalUserActions>
    </DreaminePortalHeader>

    <div id="main-content" tabindex="-1">
        @Body
    </div>
</div>

@code {
    private PortfolioCurrentUser currentUser = PortfolioCurrentUser.Anonymous;

    private string LoginUrl => IdentityUrl("login");
    private string AccountUrl => IdentityUrl("account");
    private string SignoutUrl => IdentityUrl("signout");
    private string NavUserLabel => string.IsNullOrWhiteSpace(currentUser.DisplayName) ? Text["account"] : currentUser.DisplayName;
    private string CodeMaruHomeUrl => LocalizedUrl("https://codemaru.co.kr");

    private IReadOnlyList<DreaminePortalNavigationItem> PortalItems =>
    [
        new("home", Text["home"], CodeMaruHomeUrl),
        new("dreamine", "Dreamine", "https://dreamine.kr/", OpenInNewWindow: true),
        new("cardhybrid", "CardHybrid", LocalizedUrl("https://codemaru.co.kr/cardhybrid")),
        new("wedding", "Wedding", LocalizedUrl("https://wedding.codemaru.co.kr")),
        new("thankyou", "ThankYou", LocalizedUrl("https://thankyou.codemaru.co.kr/")),
        new("families", "Families", LocalizedUrl("https://families.codemaru.co.kr")),
        new("portfolio", "Portfolio", LocalizedUrl("https://portfolio.codemaru.co.kr/")),
        new("cctv", "CCTV", LocalizedUrl("https://cctvviewer.codemaru.co.kr")),
        new("shop", "ShopStore", LocalizedUrl("https://shop.codemaru.co.kr/")),
        new("contact", Text["contact"], LocalizedUrl("https://codemaru.co.kr/contact"))
    ];

    protected override void OnInitialized()
    {
        Text.Changed += HandleLanguageChanged;
        Nav.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnInitializedAsync() => currentUser = await UserContext.GetCurrentAsync();

    private string LocalizedPath(string path)
    {
        char separator = path.Contains('?') ? '&' : '?';
        return $"{path}{separator}lang={Uri.EscapeDataString(Text.Language)}";
    }

    private string LocalizedUrl(string url)
    {
        char separator = url.Contains('?') ? '&' : '?';
        return $"{url}{separator}lang={Uri.EscapeDataString(Text.Language)}";
    }

    private string IdentityUrl(string action)
    {
        Uri current = Nav.ToAbsoluteUri(Nav.Uri);
        return Dreamine.Identity.DreamineIdentityPortal.CreateUrl(action, current.AbsoluteUri, Text.Language);
    }

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Text.Changed -= HandleLanguageChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
