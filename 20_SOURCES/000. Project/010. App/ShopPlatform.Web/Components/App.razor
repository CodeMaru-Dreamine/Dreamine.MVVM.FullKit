@using Microsoft.AspNetCore.WebUtilities
@inject ShopPlatform.Models.ShopOptions ShopOpts
@inject ShopLocalization Localization
@inject NavigationManager Navigation
<!DOCTYPE html>
<html lang="@Localization.HtmlLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localization["page.title"]</title>
    <base href="/" />

    <!-- Default OG tags are emitted during SSR so crawlers receive them without Blazor. -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="ShopPlatform" />
    <meta property="og:url"         content="@ShopOpts.BaseUrl" />
    <meta property="og:title"       content="@Localization["page.title"]" />
    <meta property="og:description" content="@Localization["seo.description"]" />
    <meta property="og:image"       content="@(ShopOpts.BaseUrl.TrimEnd('/'))/img/shop-og-default.png" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content="@Localization["page.title"]" />
    <meta name="twitter:description" content="@Localization["seo.description"]" />
    <meta name="twitter:image"       content="@(ShopOpts.BaseUrl.TrimEnd('/'))/img/shop-og-default.png" />
    <meta name="description"         content="@Localization["seo.description"]" />

    <script>
        (() => {
            const media = window.matchMedia('(prefers-color-scheme: dark)');
            const sync = event => document.documentElement.classList.toggle('system-dark', event.matches);
            sync(media);
            media.addEventListener?.('change', sync);

            const cookie = document.cookie.split(';')
                .map(value => value.trim())
                .find(value => value.startsWith('dreamine-theme='));
            const saved = cookie
                ? decodeURIComponent(cookie.substring('dreamine-theme='.length))
                : localStorage.getItem('codemaru-theme');
            if (saved === 'light' || saved === 'dark') {
                document.documentElement.dataset.theme = saved;
            }
        })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/shop-site.css?v=20260805-portal-i18n-1" />
    <link rel="stylesheet" href="ShopPlatform.Web.styles.css?v=20260805-portal-i18n-1" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_content/Dreamine.UI.Blazor/dreamine-portal.js?v=20260805-portal-i18n-1"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/site.js"></script>
    <script src="js/toss-payment.js"></script>
</body>
</html>

@code {
    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("lang", out var language))
        {
            Localization.SetLanguage(language.ToString());
        }
    }
}
