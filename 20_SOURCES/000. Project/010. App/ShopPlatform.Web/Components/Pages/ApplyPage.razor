@page "/apply"
@implements IDisposable
@inject ShopOptions ShopOpts
@inject IShopTenantStore TenantStore
@inject TenantDbContextFactory DbFactory
@inject ShopUserContext UserContext
@inject NavigationManager Nav
@inject ShopLocalization Localization

<PageTitle>@T("apply.pageTitle")</PageTitle>

<div class="sp-apply-wrap">
    <div class="sp-apply-box">

        @if (_submitted)
        {
            <!-- 신청 완료 -->
            <div class="sp-apply-done">
                <div class="sp-apply-done-icon">🎉</div>
                <h2>@T("apply.done.title")</h2>
                <p class="text-muted">
                    @T("apply.done.description")
                </p>
                <div class="sp-apply-url-preview">
                    <span class="text-muted small">@T("apply.shopUrl")</span>
                    <strong>@(ShopOpts.BaseUrl.TrimEnd('/'))/@_slug</strong>
                    <span class="text-muted small mt-1">@T("apply.adminUrl")</span>
                    <strong>@(ShopOpts.BaseUrl.TrimEnd('/'))/@_slug/admin</strong>
                </div>
                <div class="sp-apply-notice mt-3">
                    <p>⚠️ @T("apply.done.expiryPrefix")<strong>@T("apply.done.expiryStrong")</strong>@T("apply.done.expirySuffix")</p>
                    <p>📧 @T("apply.inquiry"): <a href="mailto:admin@codemaru.co.kr">admin@codemaru.co.kr</a></p>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 flex-wrap">
                    <a href="@Localization.WithLanguage($"/{_slug}/admin")" class="btn btn-primary">@T("apply.done.openAdmin") →</a>
                    <a href="@Localization.WithLanguage($"/{_slug}")" class="btn btn-outline-secondary">@T("apply.viewShop")</a>
                </div>
            </div>
        }
        else
        {
            @if (!currentUser.IsAuthenticated)
            {
                <div class="sp-apply-header">
                    <h1>@T("apply.title")</h1>
                    <p class="text-muted">@T("apply.login.description")</p>
                </div>
                <a class="btn btn-primary btn-lg w-100 mt-3" href="@LoginUrl">@T("apply.login.action")</a>
            }
            else
            {
            <div class="sp-apply-header">
                <h1>@T("apply.title")</h1>
                <p class="text-muted">@((MarkupString)TF("apply.account.description", $"<strong>{System.Net.WebUtility.HtmlEncode(CurrentUserLabel)}</strong>"))</p>
            </div>

            <!-- 안내 박스 -->
            <div class="sp-apply-alert">
                <div>🆓 <strong>@T("apply.alert.freeStrong")</strong>@T("apply.alert.freeSuffix")</div>
                <div>⏰ @T("apply.alert.expiryPrefix")<strong>@T("apply.alert.expiryStrong")</strong>@T("apply.alert.expirySuffix")</div>
                <div>⚡ @T("apply.alert.outage")</div>
            </div>

            <EditForm Model="_form" OnSubmit="Submit">

                <div class="sp-form-group">
                    <label>@T("apply.slug.label") <span class="text-danger">*</span></label>
                    <div class="sp-slug-input-wrap">
                        <span class="sp-slug-prefix">@(ShopOpts.BaseUrl.TrimEnd('/'))/</span>
                        <InputText @bind-Value="_form.Slug" class="form-control sp-slug-field"
                                   placeholder="my-shop" @oninput="OnSlugInput" />
                    </div>
                    @if (!string.IsNullOrEmpty(_slugError))
                    {
                        <div class="text-danger small mt-1">@T(_slugError)</div>
                    }
                    else if (_slugOk)
                    {
                        <div class="text-success small mt-1">✓ @T("apply.slug.available")</div>
                    }
                    <div class="form-text">@T("apply.slug.help")</div>
                </div>

                <div class="sp-form-group">
                    <label>@T("apply.name.label") <span class="text-danger">*</span></label>
                    <InputText @bind-Value="_form.ShopName" class="form-control" placeholder="@T("apply.name.placeholder")" />
                    @if (!string.IsNullOrEmpty(_shopNameError))
                    {
                        <div class="text-danger small mt-1">@T(_shopNameError)</div>
                    }
                </div>

                <div class="sp-form-group">
                    <label>@T("apply.email.label") <span class="text-muted">(@T("apply.optional"))</span></label>
                    <InputText @bind-Value="_form.Email" type="email" class="form-control"
                               placeholder="@currentUser.Email" />
                    <div class="form-text">@T("apply.email.help")</div>
                    @if (!string.IsNullOrEmpty(_emailError))
                    {
                        <div class="text-danger small mt-1">@T(_emailError)</div>
                    }
                </div>

                <div class="sp-form-group">
                    <label>@T("apply.description.label") <span class="text-muted">(@T("apply.optional"))</span></label>
                    <InputTextArea @bind-Value="_form.Description" class="form-control" rows="2"
                                  placeholder="@T("apply.description.placeholder")" />
                </div>

                @if (!string.IsNullOrEmpty(_errorMsg))
                {
                    <div class="alert alert-danger py-2">@ErrorMessage</div>
                }

                <div class="sp-apply-terms">
                    <label>
                        <input type="checkbox" @bind="_agreedTerms" />
                        &nbsp;@T("apply.terms")
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3"
                        disabled="@(_isSubmitting || !_agreedTerms)">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>@T("apply.submitting")</span>
                    }
                    else
                    {
                        <span>@T("apply.submit") →</span>
                    }
                </button>
            </EditForm>

            <div class="sp-apply-footer-note">
                @T("apply.existing")
                <a href="@Localization.WithLanguage("/my-shops")">@T("apply.manage") →</a>
            </div>
            }
        }
    </div>
</div>

@code {
    private ApplyForm _form = new();
    private ShopCurrentUser currentUser = ShopCurrentUser.Anonymous;
    private bool _submitted;
    private bool _isSubmitting;
    private bool _agreedTerms;
    private string _slugError = string.Empty;
    private bool _slugOk;
    private string _email = string.Empty;
    private string _slug  = string.Empty;
    private string _errorMsg = string.Empty;
    private string _shopNameError = string.Empty;
    private string _emailError = string.Empty;
    private string LoginUrl => Dreamine.Identity.DreamineIdentityPortal.CreateUrl("login", Nav.Uri, Localization.Language);
    private string CurrentUserLabel => string.IsNullOrWhiteSpace(currentUser.DisplayName) ? currentUser.Email : currentUser.DisplayName;
    private string ErrorMessage => T(_errorMsg);

    protected override async Task OnInitializedAsync()
    {
        Localization.Changed += HandleLanguageChanged;
        currentUser = await UserContext.GetCurrentAsync();
        if (!string.IsNullOrWhiteSpace(currentUser.Email))
        {
            _form.Email = currentUser.Email;
        }
    }

    private async Task OnSlugInput(ChangeEventArgs e)
    {
        var raw = (e.Value?.ToString() ?? "").ToLowerInvariant().Trim();
        // 허용 문자 필터
        _form.Slug = System.Text.RegularExpressions.Regex.Replace(
            raw,
            @"[^a-z0-9\-]",
            "",
            System.Text.RegularExpressions.RegexOptions.None,
            TimeSpan.FromMilliseconds(250));
        _slugError = string.Empty;
        _slugOk    = false;

        if (string.IsNullOrEmpty(_form.Slug)) return;
        if (_form.Slug.Length < 2)  { _slugError = "apply.error.slugMin"; return; }
        if (_form.Slug.Length > 30) { _slugError = "apply.error.slugMax"; return; }

        // Reserved 경로 체크
        var reserved = new[] { "admin", "apply", "pay", "healthz", "policy", "img", "css", "js" };
        if (reserved.Contains(_form.Slug)) { _slugError = "apply.error.slugReserved"; return; }

        // 중복 체크
        var existing = await TenantStore.GetAsync(_form.Slug);
        if (existing != null) { _slugError = "apply.error.slugTaken"; return; }

        _slugOk = true;
    }

    private async Task Submit()
    {
        _errorMsg = string.Empty;
        _shopNameError = string.Empty;
        _emailError = string.Empty;

        if (string.IsNullOrWhiteSpace(_form.ShopName))
            _shopNameError = "apply.error.nameRequired";
        if (!string.IsNullOrWhiteSpace(_form.Email) && !System.Net.Mail.MailAddress.TryCreate(_form.Email, out _))
            _emailError = "apply.error.emailInvalid";
        if (!string.IsNullOrEmpty(_shopNameError) || !string.IsNullOrEmpty(_emailError))
            return;

        // 슬러그 재검증
        if (!_slugOk && string.IsNullOrEmpty(_slugError))
            await OnSlugInput(new ChangeEventArgs { Value = _form.Slug });

        if (!string.IsNullOrEmpty(_slugError)) { _errorMsg = "apply.error.checkSlug"; return; }
        if (!_slugOk) { _errorMsg = "apply.error.verifySlug"; return; }
        if (string.IsNullOrWhiteSpace(_form.Slug)) { _errorMsg = "apply.error.slugRequired"; return; }
        if (!currentUser.IsAuthenticated) { _errorMsg = "apply.error.loginRequired"; return; }

        _isSubmitting = true;

        try
        {
            // 이중 중복 체크
            var existing = await TenantStore.GetAsync(_form.Slug);
            if (existing != null) { _errorMsg = "apply.error.slugTakenOther"; return; }

            // 쇼핑몰 즉시 생성
            var config = new ShopPlatform.Models.ShopConfig
            {
                Slug              = _form.Slug,
                ShopName          = _form.ShopName,
                Description       = _form.Description,
                AdminPasswordHash = string.Empty,
                OwnerUserId       = currentUser.Id,
                OwnerProvider     = currentUser.Provider,
                OwnerEmail        = currentUser.Email,
                OwnerDisplayName  = currentUser.DisplayName,
                OwnerLinkedAt     = DateTime.UtcNow,
                AdminUsers =
                [
                    new ShopAdminUser
                    {
                        UserId = currentUser.Id,
                        Provider = currentUser.Provider,
                        Email = currentUser.Email,
                        DisplayName = currentUser.DisplayName,
                        Role = "Owner",
                        AddedAt = DateTime.UtcNow
                    }
                ],
                IsActive          = true,
                CreatedAt         = DateTime.UtcNow,
                Business          = new ShopPlatform.Models.ShopBusinessInfo
                {
                    Email = string.IsNullOrWhiteSpace(_form.Email) ? currentUser.Email : _form.Email
                }
            };

            await TenantStore.SaveAsync(config);

            // SQLite DB 초기화 (테이블 생성)
            using var db = DbFactory.Create(_form.Slug);
            // EnsureCreated는 DbContextFactory 내부에서 호출됨

            _email     = _form.Email;
            _slug      = _form.Slug;
            _submitted = true;
        }
        catch (Exception)
        {
            _errorMsg = "apply.error.create";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class ApplyForm
    {
        public string ShopName { get; set; } = string.Empty;

        public string Slug { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;
    }

    private string T(string key) => ShopPlatformText.Get(key, Localization.Language);
    private string TF(string key, params object?[] args) => ShopPlatformText.Format(key, Localization.Language, args);
    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Localization.Changed -= HandleLanguageChanged;
}
