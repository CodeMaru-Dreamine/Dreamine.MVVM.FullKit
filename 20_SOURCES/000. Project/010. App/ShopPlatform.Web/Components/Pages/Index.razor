@page "/"
@implements IDisposable
@inject IShopTenantStore TenantStore
@inject ShopOptions ShopOpts
@inject ShopLocalization Localization

<PageTitle>@T("index.pageTitle")</PageTitle>

<!-- Hero -->
<div class="sp-hero-wrapper">
<section class="sp-hero">
    <div class="sp-hero-inner">
        <div class="sp-hero-badge">✨ @T("index.hero.badge")</div>
        <h1 class="sp-hero-title">
            @T("index.hero.title")<br />
            <span class="sp-accent">@T("index.hero.accent")</span>
        </h1>
        <p class="sp-hero-sub">
            @T("index.hero.description1")<br />
            @T("index.hero.description2")
        </p>
        <div class="sp-hero-cta">
            <a href="@Localization.WithLanguage("/apply")" class="btn btn-primary btn-lg sp-cta-btn">@T("index.hero.apply") →</a>
            <span class="sp-cta-note">@T("index.hero.existing") <a href="@Localization.WithLanguage("/my-shops")" class="sp-cta-link">@T("index.hero.manage") →</a></span>
        </div>
    </div>
    <div class="sp-hero-visual">
        <div class="sp-mockup">
            <div class="sp-mockup-bar">
                <span></span><span></span><span></span>
                <div class="sp-mockup-url">shop.codemaru.co.kr/<em>my-shop</em></div>
            </div>
            <div class="sp-mockup-body">
                <div class="sp-mock-header">🛒 @T("index.mock.shop")</div>
                <div class="sp-mock-products">
                    <div class="sp-mock-card"></div>
                    <div class="sp-mock-card"></div>
                    <div class="sp-mock-card"></div>
                </div>
            </div>
        </div>
    </div>
</section>
</div>

<!-- 운영 중인 쇼핑몰 -->
@if (_shops != null && _shops.Count > 0)
{
    <section class="sp-shops">
        <div class="sp-shops-inner">
            <h2 class="sp-shops-title">@T("index.shops.title")</h2>
            <p class="sp-shops-sub">@T("index.shops.description")</p>
            <div class="sp-shop-grid">
                @foreach (var shop in _shops)
                {
                    <a href="@Localization.WithLanguage($"/{shop.Slug}")" class="sp-shop-card">
                        <div class="sp-shop-card-thumb">
                            @if (!string.IsNullOrEmpty(shop.LogoPath))
                            {
                                <img src="@shop.LogoPath" alt="@shop.ShopName" />
                            }
                            else
                            {
                                <div class="sp-shop-card-placeholder">🏪</div>
                            }
                        </div>
                        <div class="sp-shop-card-body">
                            <h4 class="sp-shop-card-name">@shop.ShopName</h4>
                            @if (!string.IsNullOrEmpty(shop.Description))
                            {
                                <p class="sp-shop-card-desc">@shop.Description</p>
                            }
                            <span class="sp-shop-card-link">@ShopOpts.BaseUrl.TrimEnd('/')/@shop.Slug</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- 특징 -->
<section class="sp-features">
    <div class="sp-features-inner">
        <div class="sp-feature-item">
            <div class="sp-feature-icon">🏪</div>
            <h3>@T("index.feature.url.title")</h3>
            <p>@T("index.feature.url.prefix")<strong>my-shop</strong>@T("index.feature.url.suffix")</p>
        </div>
        <div class="sp-feature-item">
            <div class="sp-feature-icon">💳</div>
            <h3>@T("index.feature.settlement.title")</h3>
            <p>@T("index.feature.settlement.description")</p>
        </div>
        <div class="sp-feature-item">
            <div class="sp-feature-icon">📦</div>
            <h3>@T("index.feature.manage.title")</h3>
            <p>@T("index.feature.manage.description")</p>
        </div>
        <div class="sp-feature-item">
            <div class="sp-feature-icon">🔒</div>
            <h3>@T("index.feature.security.title")</h3>
            <p>@T("index.feature.security.description")</p>
        </div>
    </div>
</section>

<!-- 사용법 -->
<section class="sp-how">
    <div class="sp-how-inner">
        <h2>@T("index.steps.title")</h2>
        <div class="sp-steps">
            <div class="sp-step">
                <div class="sp-step-num">1</div>
                <h4>@T("index.steps.apply.title")</h4>
                <p>@T("index.steps.apply.description")</p>
            </div>
            <div class="sp-step-arrow">→</div>
            <div class="sp-step">
                <div class="sp-step-num">2</div>
                <h4>@T("index.steps.setup.title")</h4>
                <p>@T("index.steps.setup.description")</p>
            </div>
            <div class="sp-step-arrow">→</div>
            <div class="sp-step">
                <div class="sp-step-num">3</div>
                <h4>@T("index.steps.share.title")</h4>
                <p>@T("index.steps.share.description")</p>
            </div>
        </div>
    </div>
</section>

<!-- 무료 서비스 안내 -->
<section class="sp-notice">
    <div class="sp-notice-inner">
        <h3 class="sp-notice-title">@T("index.notice.title")</h3>
        <div class="sp-notice-grid">
            <div class="sp-notice-item">
                <span class="sp-notice-icon">⏰</span>
                <div>
                    <strong>@T("index.notice.expiry.title")</strong>
                    <p>@T("index.notice.expiry.description")</p>
                </div>
            </div>
            <div class="sp-notice-item">
                <span class="sp-notice-icon">⚡</span>
                <div>
                    <strong>@T("index.notice.outage.title")</strong>
                    <p>@T("index.notice.outage.description")</p>
                </div>
            </div>
            <div class="sp-notice-item">
                <span class="sp-notice-icon">📧</span>
                <div>
                    <strong>@T("index.notice.support.title")</strong>
                    <p>@T("index.notice.support.prefix") <a href="mailto:admin@codemaru.co.kr">admin@codemaru.co.kr</a>@T("index.notice.support.suffix")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 푸터 -->
<footer class="sp-footer">
    <p>© @DateTime.UtcNow.Year ShopPlatform @T("index.footer.by") <a href="@Localization.WithLanguage("https://codemaru.co.kr")" target="_blank" rel="noopener">Codemaru</a></p>
</footer>

@code {
    private List<ShopPlatform.Models.ShopConfig>? _shops;
    protected override async Task OnInitializedAsync()
    {
        Localization.Changed += HandleLanguageChanged;
        var all = await TenantStore.GetAllAsync();
        _shops = all.Where(s => s.IsActive).OrderBy(s => s.CreatedAt).ToList();
    }

    private string T(string key) => ShopPlatformText.Get(key, Localization.Language);
    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Localization.Changed -= HandleLanguageChanged;
}
