@page "/{Slug}/checkout"
@inject TenantContext Tenant
@inject IShopTenantStore TenantStore
@inject CartService Cart
@inject ShopCustomerSession CustomerSession
@inject ShopCustomerLoginSync CustomerLogin
@inject TenantDbContextFactory DbFactory
@inject PaymentKeyProtector KeyProtector
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ShopOptions Opts
@inject ShopLocalization Localization
@implements IDisposable

<PageTitle>@T("Payment") — @(Tenant.Config?.ShopName ?? T("Shop"))</PageTitle>

@if (!_tenantLookupCompleted)
{
    <div class="container py-5 text-center"><p class="text-muted">@T("Loading")</p></div>
}
else if (_tenant == null)
{
    <div class="container py-5 text-center"><h2>@T("ShopUnavailable")</h2></div>
}
else if (Cart.Count == 0)
{
    <div class="container py-5 text-center">
        <p class="text-muted">@T("CartEmpty")</p>
        <a href="@Localization.WithLanguage($"/{Slug}")" class="btn btn-primary">@T("ContinueShopping")</a>
    </div>
}
else
{
    <div class="container py-4" style="max-width:780px">
        <h2 class="fw-bold mb-1">💳 @T("PaymentProcess")</h2>
        <a href="@Localization.WithLanguage($"/{Slug}/cart")" class="btn btn-link ps-0 mb-3">← @T("BackToCart")</a>

        @if (!string.IsNullOrEmpty(_errorKey))
        {
            <div class="alert alert-danger">@T(_errorKey)</div>
        }

        <!-- 주문 상품 요약 -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header fw-semibold">@T("OrderItems")</div>
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <tbody>
                        @foreach (var item in Cart.Items)
                        {
                            <tr>
                                <td class="ps-3">@item.ProductName <small class="text-muted">× @item.Quantity</small></td>
                                <td class="text-end pe-3">@Money(item.Subtotal)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td class="ps-3">@T("Total")</td>
                            <td class="text-end pe-3 text-primary">@Money(Cart.Total)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="row g-4">
            <!-- 주문자 정보 -->
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-header fw-semibold">@T("CustomerInfo")</div>
                    <div class="card-body">
                        @if (CustomerSession.IsLoggedIn)
                        {
                            <div class="alert alert-light py-2 mb-3 small">
                                👤 @((MarkupString)F("OrderingAs", $"<strong>{System.Net.WebUtility.HtmlEncode(CustomerSession.User!.Name)}</strong>"))
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label">@T("Name") <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_name" @bind:event="oninput" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@T("Phone") <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_phone" @bind:event="oninput" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@T("Email")</label>
                            <input class="form-control" type="email" @bind="_email" @bind:event="oninput" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 배송지 정보 -->
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-header fw-semibold">@T("ShippingInfo")</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">@T("ShippingAddress") <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_address" @bind:event="oninput" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@T("RequestNotes")</label>
                            <input class="form-control" @bind="_memo" @bind:event="oninput" placeholder="@T("RequestPlaceholder")" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 결제 수단 -->
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header fw-semibold">@T("PaymentMethod")</div>
                    <div class="card-body">
                        <div class="d-flex flex-column gap-2 mb-3">
                            <label class="form-check">
                                <input type="radio" class="form-check-input" name="payMethod"
                                       checked="@(_method == "card")"
                                       @onchange='() => OnMethodChange("card")' />
                                <span class="ms-2">@T("CardMethod")</span>
                            </label>
                            <label class="form-check">
                                <input type="radio" class="form-check-input" name="payMethod"
                                       checked="@(_method == "transfer")"
                                       @onchange='() => OnMethodChange("transfer")' />
                                <span class="ms-2">@T("TransferDemo")</span>
                            </label>
                            <label class="form-check">
                                <input type="radio" class="form-check-input" name="payMethod"
                                       checked="@(_method == "virtual")"
                                       @onchange='() => OnMethodChange("virtual")' />
                                <span class="ms-2">@T("VirtualDemo")</span>
                            </label>
                        </div>

                        @if (!_tenant.Payment.IsEnabled && _method == "card")
                        {
                            <div class="alert alert-info mb-0">
                                <strong>@T("DemoMode")</strong> — @T("DemoModeHelp")
                            </div>
                        }
                        else if (_method == "card")
                        {
                            <!-- Toss v2 위젯 -->
                            <div id="payment-methods" style="min-height:48px"></div>
                            <div id="agreement" class="mt-2" style="min-height:24px"></div>
                        }
                    </div>
                </div>
            </div>

            <!-- 하단 버튼 -->
            <div class="col-12 d-flex justify-content-between align-items-center">
                <a href="@Localization.WithLanguage($"/{Slug}/cart")" class="btn btn-outline-secondary">@T("BackToCart")</a>

                @if (!_tenant.Payment.IsEnabled || _method != "card")
                {
                    <button class="btn btn-primary btn-lg" @onclick="PlaceDemoOrder" disabled="@_processing">
                        @(_processing ? T("Processing") : F("PlaceDemoOrder", Money(Cart.Total)))
                    </button>
                }
                else
                {
                    <button class="btn btn-success btn-lg" @onclick="PayOrSubmit" disabled="@_processing">
                        @(_processing ? T("Processing")
                          : _widgetReady ? T("PayByCard")
                          : T("OpenCardMethods"))
                    </button>
                }
            </div>
        </div>

        @if (!CustomerSession.IsLoggedIn)
        {
            <p class="text-center text-muted small mt-4">
                <a href="@LoginUrl">@T("Login")</a>@T("LoginAutoFill")
            </p>
        }
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private ShopConfig? _tenant;
    private string _name    = string.Empty;
    private string _email   = string.Empty;
    private string _phone   = string.Empty;
    private string _address = string.Empty;
    private string _memo    = string.Empty;
    private string _errorKey = string.Empty;
    private string _method  = "card";
    private bool   _processing;
    private bool   _widgetReady;
    private string? _successUrl;
    private string? _failUrl;
    private string _loadedSlug = string.Empty;
    private bool _tenantLookupCompleted;
    private int _loadVersion;
    private string LoginUrl => Localization.WithLanguage(
        $"/{Slug}/login?returnUrl={Uri.EscapeDataString($"/{Slug}/checkout")}");

    protected override void OnInitialized()
        => Localization.Changed += OnLanguageChanged;

    protected override async Task OnParametersSetAsync()
    {
        var requestedSlug = Slug;
        if (_tenantLookupCompleted && _loadedSlug == requestedSlug) return;

        var loadVersion = ++_loadVersion;
        _tenantLookupCompleted = false;
        Tenant.Config = null;
        _tenant = null;
        _widgetReady = false;
        _successUrl = _failUrl = null;
        _errorKey = string.Empty;

        var cfg = await TenantStore.GetAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug) return;

        Tenant.Config = cfg;
        _tenant = cfg;
        _loadedSlug = requestedSlug;
        _tenantLookupCompleted = true;
        if (_tenant == null) return;

        await CustomerLogin.SyncAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug) return;

        if (CustomerSession.IsLoggedIn)
        {
            var u = CustomerSession.User!;
            _name    = u.Name;
            _email   = u.Email;
            _phone   = u.Phone;
            _address = u.Address;
        }
    }

    private void OnMethodChange(string method)
    {
        _method = method;
        if (method != "card")
        {
            _widgetReady = false;
            _successUrl = _failUrl = null;
        }
    }

    private async Task PayOrSubmit()
    {
        if (!Validate()) return;
        await CustomerLogin.SaveProfileAsync(Slug, _name, _phone, _address, _email);
        if (!_widgetReady)
            await OpenTossWidget();
        else
            await RequestPayment();
    }

    private async Task OpenTossWidget()
    {
        _processing = true;
        _errorKey = string.Empty;
        try
        {
            // 서버측: 주문 ID 생성 및 URL 구성
            var orderId = GenerateOrderId();
            var baseUrl = Opts.BaseUrl.TrimEnd('/');
            _successUrl = Localization.WithLanguage($"{baseUrl}/pay/{Slug}/return");
            _failUrl    = Localization.WithLanguage($"{baseUrl}/pay/{Slug}/fail");

            var clientKey    = _tenant!.Payment.TossClientKey;
            var customerIdRaw = !string.IsNullOrEmpty(_email) ? _email
                              : !string.IsNullOrEmpty(_name)  ? _name
                              : "guest";

            // 주문을 미리 DB에 pending 상태로 저장
            using var db = DbFactory.Create(Slug);
            var order = new ShopPlatform.Models.Order
            {
                OrderNo        = orderId,
                CustomerName   = _name,
                CustomerEmail  = _email,
                CustomerPhone  = _phone,
                ShippingAddress = _address,
                TotalAmount    = Cart.Total,
                Status         = "pending",
                TransactionId  = string.Empty,
                Lines = Cart.Items.Select(i => new ShopPlatform.Models.OrderLine
                {
                    ProductId   = i.ProductId,
                    ProductName = i.ProductName,
                    UnitPrice   = i.UnitPrice,
                    Quantity    = i.Quantity
                }).ToList()
            };
            db.Orders.Add(order);
            await db.SaveChangesAsync();

            await JS.InvokeVoidAsync("openTossWidget",
                orderId,
                (double)Cart.Total,
                clientKey,
                customerIdRaw,
                F("ShopOrder", Tenant.Config!.ShopName));

            _widgetReady = true;
        }
        catch (Exception)
        {
            _errorKey = "PaymentError";
        }
        finally { _processing = false; }
    }

    private Task RequestPayment()
    {
        try
        {
            _ = JS.InvokeVoidAsync("requestTossPayment", _successUrl!, _failUrl!);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        return Task.CompletedTask;
    }

    private async Task PlaceDemoOrder()
    {
        if (!Validate()) return;
        await CustomerLogin.SaveProfileAsync(Slug, _name, _phone, _address, _email);
        _processing = true;
        using var db = DbFactory.Create(Slug);
        var orderNo = GenerateOrderId();
        var order = new ShopPlatform.Models.Order
        {
            OrderNo         = orderNo,
            CustomerName    = _name,
            CustomerEmail   = _email,
            CustomerPhone   = _phone,
            ShippingAddress = _address,
            TotalAmount     = Cart.Total,
            Status          = "paid",
            TransactionId   = $"DEMO-{Guid.NewGuid():N}",
            Lines = Cart.Items.Select(i => new ShopPlatform.Models.OrderLine
            {
                ProductId   = i.ProductId,
                ProductName = i.ProductName,
                UnitPrice   = i.UnitPrice,
                Quantity    = i.Quantity
            }).ToList()
        };
        db.Orders.Add(order);
        // 재고 차감 (무한 재고 제외)
        foreach (var item in Cart.Items)
        {
            var product = await db.Products.FindAsync(item.ProductId);
            if (product == null || product.IsUnlimitedStock) continue;
            product.Stock = Math.Max(0, product.Stock - item.Quantity);
        }
        await db.SaveChangesAsync();
        Cart.Clear();
        Nav.NavigateTo(Localization.WithLanguage($"/{Slug}/order/{orderNo}?demo=1"));
    }

    private bool Validate()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_address))
        {
            _errorKey = "RequiredCheckout";
            return false;
        }
        _errorKey = string.Empty;
        return true;
    }

    private static string GenerateOrderId() =>
        $"ORD-{DateTime.UtcNow:yyyyMMddHHmmss}-{Guid.NewGuid():N}"[..36];

    private string T(string key) => ShopStorefrontText.Get(key, Localization.Language);
    private string F(string key, params object?[] args) => ShopStorefrontText.Format(key, Localization.Language, args);
    private string Money(decimal amount) => ShopStorefrontText.Money(amount, Localization.Language);
    private void OnLanguageChanged()
    {
        if (!string.IsNullOrEmpty(_successUrl))
            _successUrl = Localization.WithLanguage(_successUrl);
        if (!string.IsNullOrEmpty(_failUrl))
            _failUrl = Localization.WithLanguage(_failUrl);
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Localization.Changed -= OnLanguageChanged;
}
