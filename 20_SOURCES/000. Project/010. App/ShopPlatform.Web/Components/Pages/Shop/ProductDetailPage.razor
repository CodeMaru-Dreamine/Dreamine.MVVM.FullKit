@page "/{Slug}/products/{ProductId:int}"
@inject TenantContext Tenant
@inject IShopTenantStore TenantStore
@inject TenantDbContextFactory DbFactory
@inject CartService Cart
@inject ShopCustomerSession CustomerSession
@inject ShopCustomerLoginSync CustomerLogin
@inject NavigationManager Nav
@inject ShopLocalization Localization
@implements IDisposable
@using System.Text.Json
@using ShopPlatform.Services

<PageTitle>@(_product?.Name ?? T("ProductDetails")) — @(Tenant.Config?.ShopName ?? T("Shop"))</PageTitle>

@if (!_tenantLookupCompleted)
{
    <div class="container py-5 text-center"><p class="text-muted">@T("Loading")</p></div>
}
else if (!Tenant.IsResolved)
{
    <div class="container py-5 text-center"><h2>@T("ShopUnavailable")</h2></div>
}
else
{
    var cfg = Tenant.Config!;

    <header class="ss-header">
        <div class="ss-header-inner">
            <a href="@Localization.WithLanguage($"/{Slug}")" class="ss-brand">
                @if (!string.IsNullOrEmpty(cfg.LogoPath))
                {
                    <img src="@cfg.LogoPath" class="ss-brand-logo" alt="@cfg.ShopName" />
                }
                <span class="ss-brand-name">@cfg.ShopName</span>
            </a>
            <nav class="ss-nav">
                <a href="@Localization.WithLanguage($"/{Slug}")">@T("Home")</a>
                <a href="@Localization.WithLanguage($"/{Slug}/products")" class="active">@T("AllProducts")</a>
                @if (cfg.ShowPlatformHomeLink)
                {
                    <a href="@Localization.WithLanguage("/")">@T("PlatformHome")</a>
                }
            </nav>
            <div class="ss-header-right">
                @if (CustomerSession.IsLoggedIn)
                {
                    <span class="ss-user-name">👤 @CustomerSession.User!.Name</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LogoutCustomer">@T("Logout")</button>
                }
                else
                {
                    <a href="@Localization.WithLanguage($"/{Slug}/login")" class="btn btn-sm btn-outline-secondary">@T("Login")</a>
                    <a href="@Localization.WithLanguage($"/{Slug}/register")" class="btn btn-sm btn-outline-primary">@T("Register")</a>
                }
                <a href="@Localization.WithLanguage($"/{Slug}/cart")" class="ss-cart-btn" aria-label="@T("Cart")">
                    🛒
                    @if (Cart.Count > 0)
                    {
                        <span class="ss-cart-badge">@Cart.Count</span>
                    }
                </a>
            </div>
        </div>
    </header>

    <div class="ss-body">
        @if (_product == null)
        {
            <div class="container py-5 text-center">
                <h3>@T("ProductNotFound")</h3>
                <a href="@Localization.WithLanguage($"/{Slug}/products")" class="btn btn-outline-primary mt-3">@T("BackToList")</a>
            </div>
        }
        else
        {
            var p = _product;

            <!-- 상품 메인 영역 -->
            <section class="ss-detail-main container py-4">
                <div class="ss-detail-grid">

                    <!-- 이미지 -->
                    <div class="ss-detail-img-col">
                        @if (!string.IsNullOrEmpty(p.ImagePath))
                        {
                            <img src="@p.ImagePath" alt="@p.Name" class="ss-detail-main-img" />
                        }
                        else
                        {
                            <div class="ss-detail-img-placeholder">🏷️</div>
                        }
                    </div>

                    <!-- 정보 -->
                    <div class="ss-detail-info-col">
                        <h1 class="ss-detail-title">@p.Name</h1>
                        @if (!string.IsNullOrEmpty(p.Description))
                        {
                            <p class="ss-detail-desc">@p.Description</p>
                        }

                        @if (p.IsAvailable)
                        {
                            <span class="ss-detail-stock-ok">
                                @(p.IsUnlimitedStock ? T("InStock") : F("StockCount", p.Stock))
                            </span>
                        }
                        else
                        {
                            <span class="ss-detail-stock-out">@T("SoldOut")</span>
                        }

                        <div class="ss-detail-divider"></div>

                        <!-- 가격 -->
                        <div class="ss-detail-price-area">
                            <span class="ss-detail-price">@Money(p.Price)</span>
                        </div>

                        <!-- 수량 -->
                        @if (p.IsAvailable)
                        {
                            <div class="ss-detail-qty">
                                <label class="ss-detail-qty-label">@T("Quantity")</label>
                                <div class="ss-qty-ctrl">
                                    <button class="ss-qty-btn" aria-label="@T("DecreaseQuantity")" @onclick="() => _qty = Math.Max(1, _qty - 1)">−</button>
                                    <span class="ss-qty-val">@_qty</span>
                                    <button class="ss-qty-btn" aria-label="@T("IncreaseQuantity")" @onclick="() => _qty = p.IsUnlimitedStock ? _qty + 1 : Math.Min(p.Stock, _qty + 1)">+</button>
                                </div>
                            </div>

                            <!-- 총액 -->
                            <div class="ss-detail-total">
                                @T("Total"): <strong>@Money(p.Price * _qty)</strong>
                            </div>
                        }

                        @if (_lastAddedQty > 0)
                        {
                            <div class="alert alert-success py-2 mt-2">@F("AddedToCart", _lastAddedQty)</div>
                        }

                        <!-- 버튼 -->
                        <div class="ss-detail-btns mt-3">
                            @if (p.IsAvailable)
                            {
                                <button class="btn btn-outline-primary" @onclick="AddToCart">🛒 @T("AddToCart")</button>
                                <a href="@Localization.WithLanguage($"/{Slug}/cart")" class="btn btn-secondary">@T("GoToCart")</a>
                                <button class="btn btn-primary" @onclick="BuyNow">@T("BuyNow")</button>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>@T("SoldOut")</button>
                            }
                        </div>

                        <a href="@Localization.WithLanguage($"/{Slug}/products")" class="ss-detail-back">@T("BackToList")</a>
                    </div>
                </div>
            </section>

            <!-- 동영상 -->
            @if (!string.IsNullOrEmpty(p.VideoUrl))
            {
                <section class="container pb-4">
                    <div class="ss-detail-video-wrap">
                        @if (p.VideoUrl.Contains("youtube.com") || p.VideoUrl.Contains("youtu.be"))
                        {
                            var embedId = GetYoutubeId(p.VideoUrl);
                            @if (!string.IsNullOrEmpty(embedId))
                            {
                                <iframe src="https://www.youtube.com/embed/@embedId"
                                        title="@F("ProductVideo", p.Name)"
                                        frameborder="0" allowfullscreen
                                        class="ss-detail-video"></iframe>
                            }
                        }
                        else
                        {
                            <video src="@p.VideoUrl" controls class="ss-detail-video"></video>
                        }
                    </div>
                </section>
            }

            <!-- 상세 이미지 목록 -->
            @if (ParseDetailImages(p.DetailImagesJson) is { Count: > 0 } detailImgs)
            {
                <section class="container pb-4">
                    <div class="ss-detail-img-gallery">
                        @foreach (var imgSrc in detailImgs)
                        {
                            <img src="@imgSrc" alt="@T("DetailImage")" class="ss-detail-gallery-img" />
                        }
                    </div>
                </section>
            }

            <!-- 상세 텍스트 -->
            @if (!string.IsNullOrEmpty(p.DetailHtml))
            {
                <section class="container pb-4">
                    <div class="ss-detail-html-wrap">
                        <div class="ss-detail-html-inner">
                            @MarkdownHelper.ToHtmlAuto(p.DetailHtml)
                        </div>
                    </div>
                </section>
            }

            <!-- 환불·교환·배송 정책 -->
            @if (!string.IsNullOrEmpty(cfg.Policy.RefundPolicy)
              || !string.IsNullOrEmpty(cfg.Policy.ExchangePolicy)
              || !string.IsNullOrEmpty(cfg.Policy.DeliveryPolicy))
            {
                <section class="container pb-5">
                    <h3 class="ss-policy-title">@T("PoliciesTitle")</h3>
                    <div class="ss-policy-accordion">

                        @if (!string.IsNullOrEmpty(cfg.Policy.RefundPolicy))
                        {
                            <div class="ss-policy-item @(_openPolicy == 1 ? "open" : "")">
                                <button class="ss-policy-hd" @onclick="() => TogglePolicy(1)">
                                    <span>1) @T("RefundPolicy")</span>
                                    <span class="ss-policy-arrow">@(_openPolicy == 1 ? "∧" : "∨")</span>
                                </button>
                                @if (_openPolicy == 1)
                                {
                                    <div class="ss-policy-body">
                                        @MarkdownHelper.ToHtmlAuto(cfg.Policy.RefundPolicy)
                                    </div>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(cfg.Policy.ExchangePolicy))
                        {
                            <div class="ss-policy-item @(_openPolicy == 2 ? "open" : "")">
                                <button class="ss-policy-hd" @onclick="() => TogglePolicy(2)">
                                    <span>2) @T("ExchangePolicy")</span>
                                    <span class="ss-policy-arrow">@(_openPolicy == 2 ? "∧" : "∨")</span>
                                </button>
                                @if (_openPolicy == 2)
                                {
                                    <div class="ss-policy-body">
                                        @MarkdownHelper.ToHtmlAuto(cfg.Policy.ExchangePolicy)
                                    </div>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(cfg.Policy.DeliveryPolicy))
                        {
                            <div class="ss-policy-item @(_openPolicy == 3 ? "open" : "")">
                                <button class="ss-policy-hd" @onclick="() => TogglePolicy(3)">
                                    <span>3) @T("DeliveryPolicy")</span>
                                    <span class="ss-policy-arrow">@(_openPolicy == 3 ? "∧" : "∨")</span>
                                </button>
                                @if (_openPolicy == 3)
                                {
                                    <div class="ss-policy-body">
                                        @MarkdownHelper.ToHtmlAuto(cfg.Policy.DeliveryPolicy)
                                    </div>
                                }
                            </div>
                        }

                    </div>
                </section>
            }
        }

        <ShopPlatform.Components.Pages.Shop.Shared.ShopFooter Config="cfg" Slug="@Slug" />
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public int ProductId { get; set; }

    private ShopPlatform.Models.Product? _product;
    private int _qty = 1;
    private int _openPolicy = 1;
    private int _lastAddedQty;
    private string _loadedSlug = string.Empty;
    private int _loadedProductId;
    private bool _tenantLookupCompleted;
    private int _loadVersion;

    protected override void OnInitialized()
        => Localization.Changed += OnLanguageChanged;

    protected override async Task OnParametersSetAsync()
    {
        var requestedSlug = Slug;
        var requestedProductId = ProductId;
        if (_tenantLookupCompleted &&
            _loadedSlug == requestedSlug &&
            _loadedProductId == requestedProductId) return;

        var loadVersion = ++_loadVersion;
        _tenantLookupCompleted = false;
        Tenant.Config = null;
        _product = null;
        _qty = 1;

        var cfg = await TenantStore.GetAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug || requestedProductId != ProductId) return;

        Tenant.Config = cfg;
        _loadedSlug = requestedSlug;
        _loadedProductId = requestedProductId;
        _tenantLookupCompleted = true;
        if (!Tenant.IsResolved) return;

        await CustomerLogin.SyncAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug || requestedProductId != ProductId) return;

        using var db = DbFactory.Create(requestedSlug);
        _product = db.Products.FirstOrDefault(p => p.Id == requestedProductId && p.IsActive);
    }

    private void AddToCart()
    {
        if (_product == null) return;
        for (var i = 0; i < _qty; i++) Cart.Add(_product);
        _lastAddedQty = _qty;
        StateHasChanged();
        Task.Delay(2000).ContinueWith(_ => { _lastAddedQty = 0; InvokeAsync(StateHasChanged); });
    }

    private void BuyNow()
    {
        if (_product == null) return;
        for (var i = 0; i < _qty; i++) Cart.Add(_product);
        Nav.NavigateTo(Localization.WithLanguage($"/{Slug}/cart"));
    }

    private void TogglePolicy(int idx)
        => _openPolicy = (_openPolicy == idx) ? 0 : idx;

    private void LogoutCustomer()
    {
        CustomerSession.Logout();
        var returnPath = Localization.WithLanguage($"/{Slug}");
        Nav.NavigateTo(Dreamine.Identity.DreamineIdentityPortal.CreateUrl(
            "signout",
            Nav.ToAbsoluteUri(returnPath).ToString(),
            Localization.Language), forceLoad: true);
    }

    private static List<string> ParseDetailImages(string json)
    {
        try { return JsonSerializer.Deserialize<List<string>>(json) ?? new(); }
        catch { return new(); }
    }

    private static string GetYoutubeId(string url)
    {
        try
        {
            var uri = new Uri(url);
            if (uri.Host.Contains("youtu.be"))
                return uri.AbsolutePath.TrimStart('/');
            var q = System.Web.HttpUtility.ParseQueryString(uri.Query);
            return q["v"] ?? string.Empty;
        }
        catch { return string.Empty; }
    }

    private string T(string key) => ShopStorefrontText.Get(key, Localization.Language);
    private string F(string key, params object?[] args) => ShopStorefrontText.Format(key, Localization.Language, args);
    private string Money(decimal amount) => ShopStorefrontText.Money(amount, Localization.Language);
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Localization.Changed -= OnLanguageChanged;
}
