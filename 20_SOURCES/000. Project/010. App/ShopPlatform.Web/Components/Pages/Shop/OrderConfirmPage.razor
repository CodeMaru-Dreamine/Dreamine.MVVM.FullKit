@page "/{Slug}/order/{OrderNo}"
@inject TenantContext Tenant
@inject IShopTenantStore TenantStore
@inject TenantDbContextFactory DbFactory
@inject NavigationManager Nav
@inject ShopLocalization Localization
@implements IDisposable

<PageTitle>@T("OrderComplete") — @(Tenant.Config?.ShopName ?? T("Shop"))</PageTitle>

<div class="container py-5" style="max-width:640px">
    @if (!_tenantLookupCompleted)
    {
        <div class="text-center py-5">
            <p class="text-muted">@T("Loading")</p>
        </div>
    }
    else if (!Tenant.IsResolved)
    {
        <div class="text-center py-5">
            <h2>@T("ShopUnavailable")</h2>
        </div>
    }
    else if (!_orderLookupCompleted)
    {
        <div class="text-center py-5">
            <p class="text-muted">@T("LoadingOrder")</p>
        </div>
    }
    else if (_order == null)
    {
        <div class="text-center py-5">
            <h2>@Localization["page.notfound"]</h2>
        </div>
    }
    else
    {
        <div class="text-center mb-4">
            <div style="font-size:3.5rem">✅</div>
            <h2 class="mt-2 fw-bold">@T("OrderCompletedMessage")</h2>
            <p class="text-muted">
                @F("ThanksForShopping", Tenant.Config?.ShopName ?? T("Shop"))
            </p>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">@T("OrderInfo")</h5>
                <dl class="row mb-0">
                    <dt class="col-4 text-muted">@T("OrderNumber")</dt>
                    <dd class="col-8"><code>@_order.OrderNo</code></dd>

                    <dt class="col-4 text-muted">@T("Customer")</dt>
                    <dd class="col-8">@_order.CustomerName</dd>

                    <dt class="col-4 text-muted">@T("Phone")</dt>
                    <dd class="col-8">@_order.CustomerPhone</dd>

                    <dt class="col-4 text-muted">@T("Destination")</dt>
                    <dd class="col-8">@_order.ShippingAddress</dd>

                    <dt class="col-4 text-muted">@T("PaymentAmount")</dt>
                    <dd class="col-8 fw-bold text-primary">@Money(_order.TotalAmount)</dd>

                    <dt class="col-4 text-muted">@T("PaymentStatus")</dt>
                    <dd class="col-8">
                        <span class="badge @(_order.Status == "paid" ? "bg-success" : "bg-warning text-dark")">
                            @StatusText(_order.Status)
                        </span>
                        @if (!string.IsNullOrEmpty(_order.TransactionId))
                        {
                            <small class="text-muted ms-2">@T("Transaction"): @_order.TransactionId[..Math.Min(20, _order.TransactionId.Length)]...</small>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (_order.Lines.Any())
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">@T("OrderItems")</h5>
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>@T("ProductName")</th>
                                <th class="text-end">@T("Quantity")</th>
                                <th class="text-end">@T("Amount")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _order.Lines)
                            {
                                <tr>
                                    <td>@line.ProductName</td>
                                    <td class="text-end">@line.Quantity</td>
                                    <td class="text-end">@Money(line.Subtotal)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="2" class="text-end">@T("Total")</td>
                                <td class="text-end">@Money(_order.TotalAmount)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }

        <div class="text-center">
            <a href="@Localization.WithLanguage($"/{Slug}")" class="btn btn-primary">@T("ContinueShopping")</a>
        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public string OrderNo { get; set; } = string.Empty;

    private Order? _order;
    private string _loadedSlug = string.Empty;
    private string _loadedOrderNo = string.Empty;
    private bool _tenantLookupCompleted;
    private bool _orderLookupCompleted;
    private int _loadVersion;

    protected override void OnInitialized()
        => Localization.Changed += OnLanguageChanged;

    protected override async Task OnParametersSetAsync()
    {
        var requestedSlug = Slug;
        var requestedOrderNo = OrderNo;
        if (_tenantLookupCompleted &&
            _orderLookupCompleted &&
            _loadedSlug == requestedSlug &&
            _loadedOrderNo == requestedOrderNo) return;

        var loadVersion = ++_loadVersion;
        _tenantLookupCompleted = false;
        _orderLookupCompleted = false;
        Tenant.Config = null;
        _order = null;

        var cfg = await TenantStore.GetAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug || requestedOrderNo != OrderNo) return;

        Tenant.Config = cfg;
        _loadedSlug = requestedSlug;
        _loadedOrderNo = requestedOrderNo;
        _tenantLookupCompleted = true;
        if (!Tenant.IsResolved) return;

        using var db = DbFactory.Create(requestedSlug);
        _order = db.Orders
            .Where(o => o.OrderNo == requestedOrderNo)
            .Select(o => new Order
            {
                Id = o.Id, OrderNo = o.OrderNo,
                CustomerName = o.CustomerName, CustomerPhone = o.CustomerPhone,
                CustomerEmail = o.CustomerEmail, ShippingAddress = o.ShippingAddress,
                TotalAmount = o.TotalAmount, Status = o.Status,
                TransactionId = o.TransactionId, CreatedAt = o.CreatedAt,
                Lines = db.OrderLines.Where(l => l.OrderId == o.Id).ToList()
            })
            .FirstOrDefault();
        _orderLookupCompleted = true;
    }

    private string T(string key) => ShopStorefrontText.Get(key, Localization.Language);
    private string F(string key, params object?[] args) => ShopStorefrontText.Format(key, Localization.Language, args);
    private string Money(decimal amount) => ShopStorefrontText.Money(amount, Localization.Language);
    private string StatusText(string status) => status.ToLowerInvariant() switch
    {
        "paid" => T("Paid"),
        "pending" => T("Pending"),
        "failed" => T("Failed"),
        "cancelled" or "canceled" => T("Cancelled"),
        _ => status
    };

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Localization.Changed -= OnLanguageChanged;
}
