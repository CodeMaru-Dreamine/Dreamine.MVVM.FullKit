@page "/{Slug}/policy/{PolicyType}"
@inject TenantContext Tenant
@inject IShopTenantStore TenantStore
@inject ShopLocalization Localization
@implements IDisposable
@using ShopPlatform.Services

@{
    var cfg   = Tenant.Config;
    var title = PolicyType switch
    {
        "refund"   => T("RefundPolicy"),
        "exchange" => T("ExchangePolicy"),
        "delivery" => T("DeliveryPolicy"),
        _          => T("PolicyGuide")
    };
    var content = PolicyType switch
    {
        "refund"   => cfg?.Policy.RefundPolicy,
        "exchange" => cfg?.Policy.ExchangePolicy,
        "delivery" => cfg?.Policy.DeliveryPolicy,
        _          => null
    };
}

<PageTitle>@title — @(cfg?.ShopName ?? T("Shop"))</PageTitle>

@if (!_tenantLookupCompleted)
{
    <div class="container py-5 text-center"><p class="text-muted">@T("Loading")</p></div>
}
else if (cfg == null)
{
    <div class="container py-5 text-center"><h2>@T("ShopUnavailable")</h2></div>
}
else
{
    <!-- ── 헤더 ── -->
    <header class="ss-header">
        <div class="ss-header-inner">
            <a href="@Localization.WithLanguage($"/{Slug}")" class="ss-brand">
                @if (!string.IsNullOrEmpty(cfg.LogoPath))
                {
                    <img src="@cfg.LogoPath" class="ss-brand-logo" alt="@cfg.ShopName" />
                }
                <span class="ss-brand-name">@cfg.ShopName</span>
            </a>
            <nav class="ss-nav">
                <a href="@Localization.WithLanguage($"/{Slug}")">@T("Home")</a>
                <a href="@Localization.WithLanguage($"/{Slug}/products")">@T("AllProducts")</a>
            </nav>
            <div class="ss-header-right"></div>
        </div>
    </header>

    <div class="ss-body">
        <div class="container py-5" style="max-width:820px">
            <!-- 브레드크럼 -->
            <nav aria-label="@T("Breadcrumb")" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Localization.WithLanguage($"/{Slug}")">@T("Home")</a></li>
                    <li class="breadcrumb-item active">@title</li>
                </ol>
            </nav>

            <div class="card shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 mb-4 fw-bold">@title</h1>
                    <hr class="mb-4" />

                    @if (string.IsNullOrWhiteSpace(content))
                    {
                        <p class="text-muted">@T("NoPolicyContent")</p>
                    }
                    else
                    {
                        <div class="policy-content">
                            @MarkdownHelper.ToHtmlAuto(content)
                        </div>
                    }
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="@Localization.WithLanguage($"/{Slug}")" class="btn btn-outline-secondary">← @T("BackToShop")</a>
            </div>
        </div>

        <ShopPlatform.Components.Pages.Shop.Shared.ShopFooter Config="cfg" Slug="@Slug" />
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public string PolicyType { get; set; } = string.Empty;

    private string _loadedSlug = string.Empty;
    private bool _tenantLookupCompleted;
    private int _loadVersion;

    protected override void OnInitialized()
        => Localization.Changed += OnLanguageChanged;

    protected override async Task OnParametersSetAsync()
    {
        var requestedSlug = Slug;
        if (_tenantLookupCompleted && _loadedSlug == requestedSlug) return;

        var loadVersion = ++_loadVersion;
        _tenantLookupCompleted = false;
        Tenant.Config = null;

        var cfg = await TenantStore.GetAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug) return;

        Tenant.Config = cfg;
        _loadedSlug = requestedSlug;
        _tenantLookupCompleted = true;
    }

    private string T(string key) => ShopStorefrontText.Get(key, Localization.Language);
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Localization.Changed -= OnLanguageChanged;
}
