@page "/{Slug}/register"
@using Dreamine.Identity
@inject TenantContext Tenant
@inject IShopTenantStore TenantStore
@inject TenantDbContextFactory DbFactory
@inject ShopCustomerSession Session
@inject NavigationManager Nav
@inject ShopLocalization Localization
@implements IDisposable

<PageTitle>@T("Register") — @(Tenant.Config?.ShopName ?? T("Shop"))</PageTitle>

@if (!_tenantLookupCompleted)
{
    <div class="container py-5 text-center"><p class="text-muted">@T("Loading")</p></div>
}
else if (!Tenant.IsResolved)
{
    <div class="container py-5 text-center"><h2>@T("ShopUnavailable")</h2></div>
}
else
{
<div class="container py-5" style="max-width:480px">
    <div class="text-center mb-4">
        <h2 class="fw-bold">@T("Register")</h2>
        <p class="text-muted">@(Tenant.Config?.ShopName ?? "") @T("Member")</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="mb-3">
                <label class="form-label">@T("Name") <span class="text-danger">*</span></label>
                <input class="form-control" @bind="_name" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("Email") <span class="text-danger">*</span></label>
                <input class="form-control" type="email" @bind="_email" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("Password") <span class="text-danger">*</span></label>
                <input class="form-control" type="password" @bind="_password" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("ConfirmPassword")</label>
                <input class="form-control" type="password" @bind="_confirm" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("Phone")</label>
                <input class="form-control" @bind="_phone" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("Address")</label>
                <input class="form-control" @bind="_address" @bind:event="oninput" />
            </div>
            @if (!string.IsNullOrEmpty(_errorKey))
            {
                <div class="alert alert-danger py-2">@T(_errorKey)</div>
            }
            <button class="btn btn-primary w-100" @onclick="Register" disabled="@_loading">
                @(_loading ? T("Registering") : T("Register"))
            </button>
            <hr />
            <p class="text-center mb-0 small">
                @T("AlreadyMember") <a href="@Localization.WithLanguage($"/{Slug}/login")">@T("Login")</a>
            </p>
        </div>
    </div>
</div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private string _name = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private string _phone = string.Empty;
    private string _address = string.Empty;
    private string _errorKey = string.Empty;
    private bool _loading;
    private bool _tenantLookupCompleted;
    private int _loadVersion;

    protected override void OnInitialized()
        => Localization.Changed += OnLanguageChanged;

    protected override async Task OnParametersSetAsync()
    {
        var requestedSlug = Slug;
        var loadVersion = ++_loadVersion;
        _tenantLookupCompleted = false;
        Tenant.Config = null;

        var cfg = await TenantStore.GetAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug) return;

        Tenant.Config = cfg;
        _tenantLookupCompleted = true;
    }

    private async Task Register()
    {
        _errorKey = string.Empty;
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _errorKey = "RegisterRequiredFields";
            return;
        }
        if (_password != _confirm)
        {
            _errorKey = "PasswordMismatch";
            return;
        }
        if (_password.Length < 8)
        {
            _errorKey = "PasswordMinimum";
            return;
        }
        _loading = true;
        using var db = DbFactory.Create(Slug);
        var emailLower = _email.Trim().ToLower();
        if (db.Users.Any(u => u.Email == emailLower))
        {
            _errorKey = "EmailExists";
            _loading = false;
            return;
        }
        var user = new ShopUser
        {
            Email = emailLower,
            PasswordHash = DreaminePasswordHasher.HashPassword(_password),
            Name = _name.Trim(),
            Phone = _phone.Trim(),
            Address = _address.Trim()
        };
        db.Users.Add(user);
        await db.SaveChangesAsync();
        Session.Login(user);
        Nav.NavigateTo(Localization.WithLanguage($"/{Slug}"));
    }

    private string T(string key) => ShopStorefrontText.Get(key, Localization.Language);
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Localization.Changed -= OnLanguageChanged;
}
