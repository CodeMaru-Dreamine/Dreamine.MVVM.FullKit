@page "/{Slug}"
@inject TenantContext Tenant
@inject IShopTenantStore TenantStore
@inject TenantDbContextFactory DbFactory
@inject CartService Cart
@inject ShopCustomerSession CustomerSession
@inject ShopCustomerLoginSync CustomerLogin
@inject ShopOptions ShopOpts
@inject IWebHostEnvironment Env
@inject ShopLocalization Localization
@implements IDisposable
@using ShopPlatform.Services

<PageTitle>@(Tenant.Config?.ShopName ?? T("Shop"))</PageTitle>

@if (Tenant.IsResolved)
{
    var cfg2      = Tenant.Config!;
    var _shopName = !string.IsNullOrEmpty(cfg2.OgTitle) ? cfg2.OgTitle : cfg2.ShopName;
    var _shopDesc = !string.IsNullOrEmpty(cfg2.OgDescription) ? cfg2.OgDescription
                    : !string.IsNullOrEmpty(cfg2.Description) ? cfg2.Description
                    : F("ShopHere", cfg2.ShopName);
    // OgImagePath 설정 → 없으면 샵별 자동 생성 이미지, 그것도 없으면 기본 이미지
    string _shopImg;
    if (!string.IsNullOrEmpty(cfg2.OgImagePath))
    {
        _shopImg = cfg2.OgImagePath.StartsWith("http") ? cfg2.OgImagePath : $"{_baseUrl}{cfg2.OgImagePath}";
    }
    else if (!string.IsNullOrEmpty(cfg2.LogoPath))
    {
        _shopImg = cfg2.LogoPath.StartsWith("http") ? cfg2.LogoPath : $"{_baseUrl}{cfg2.LogoPath}";
    }
    else
    {
        // 샵 이름/설명이 담긴 OG 이미지 자동 생성
        var generatedPath = OgImageGenerator.EnsureShopOg(
            Env.WebRootPath, Slug, cfg2.ShopName, _shopDesc, _baseUrl);
        _shopImg = $"{_baseUrl}{generatedPath}";
    }
    var _shopUrl  = $"{_baseUrl}/{Slug}";
    <HeadContent>
        <meta property="og:type"        content="website" />
        <meta property="og:site_name"   content="ShopPlatform" />
        <meta property="og:url"         content="@_shopUrl" />
        <meta property="og:title"       content="@_shopName" />
        <meta property="og:description" content="@_shopDesc" />
        <meta property="og:image"       content="@_shopImg" />
        <meta property="og:image:width"  content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="description" content="@_shopDesc" />
    </HeadContent>
}

@if (!_tenantLookupCompleted)
{
    <div class="container py-5 text-center">
        <p class="text-muted">@T("Loading")</p>
    </div>
}
else if (!Tenant.IsResolved)
{
    <div class="container py-5 text-center">
        <h2>@T("ShopUnavailable")</h2>
        <a href="@Localization.WithLanguage("/")">@T("Home")</a>
    </div>
}
else if (!Tenant.Config!.IsActive)
{
    <div class="container py-5 text-center">
        <h2>@T("ShopPreparing")</h2>
    </div>
}
else
{
    var cfg = Tenant.Config!;

    <!-- ── 고정 헤더 ── -->
    <header class="ss-header">
        <div class="ss-header-inner">
            <a href="@Localization.WithLanguage($"/{Slug}")" class="ss-brand">
                @if (!string.IsNullOrEmpty(cfg.LogoPath))
                {
                    <img src="@cfg.LogoPath" class="ss-brand-logo" alt="@cfg.ShopName" />
                }
                <span class="ss-brand-name">@cfg.ShopName</span>
            </a>
            <nav class="ss-nav">
                <a href="@Localization.WithLanguage($"/{Slug}")">@T("Home")</a>
                <a href="@Localization.WithLanguage($"/{Slug}/products")">@T("AllProducts")</a>
                @if (cfg.ShowPlatformHomeLink)
                {
                    <a href="@Localization.WithLanguage("/")">@T("PlatformHome")</a>
                }
            </nav>
            <div class="ss-header-right">
                @if (CustomerSession.IsLoggedIn)
                {
                    <span class="ss-user-name">👤 @CustomerSession.User!.Name</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LogoutCustomer">@T("Logout")</button>
                }
                else
                {
                    <a href="@Localization.WithLanguage($"/{Slug}/login")" class="btn btn-sm btn-outline-secondary">@T("Login")</a>
                    <a href="@Localization.WithLanguage($"/{Slug}/register")" class="btn btn-sm btn-outline-primary">@T("Register")</a>
                }
                <a href="@Localization.WithLanguage($"/{Slug}/cart")" class="ss-cart-btn" aria-label="@T("Cart")">
                    🛒
                    @if (Cart.Count > 0)
                    {
                        <span class="ss-cart-badge">@Cart.Count</span>
                    }
                </a>
            </div>
        </div>
    </header>

    <div class="ss-body">

        <!-- ── 히어로 배너 ── -->
        <section class="ss-hero" style="@(!string.IsNullOrEmpty(cfg.BannerImagePath) ? $"background-image:url({cfg.BannerImagePath})" : "")">
            <div class="ss-hero-content">
                @if (!string.IsNullOrEmpty(cfg.LogoPath))
                {
                    <img src="@cfg.LogoPath" class="ss-hero-logo" alt="@cfg.ShopName" />
                }
                <h1 class="ss-hero-title">@cfg.ShopName</h1>
                @if (!string.IsNullOrEmpty(cfg.HeroText))
                {
                    <p class="ss-hero-tagline">@cfg.HeroText</p>
                }
                @if (!string.IsNullOrEmpty(cfg.HeroSubText))
                {
                    <p class="ss-hero-sub">@cfg.HeroSubText</p>
                }
                else if (!string.IsNullOrEmpty(cfg.Description))
                {
                    <p class="ss-hero-sub">@cfg.Description</p>
                }
                <div class="ss-hero-cta">
                    <a href="@Localization.WithLanguage($"/{Slug}/products")" class="btn btn-primary btn-lg">@T("ViewAllProducts")</a>
                    <a href="@Localization.WithLanguage($"/{Slug}/cart")" class="btn btn-outline-light btn-lg">@T("Cart") 🛒</a>
                </div>
            </div>
        </section>

        <!-- ── 추천 상품 ── -->
        <section class="ss-featured">
            <div class="container">
                <h2 class="ss-section-title">@T("FeaturedProducts")</h2>

                @if (_products == null)
                {
                    <p class="text-muted text-center py-4">@T("Loading")</p>
                }
                else if (_products.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <p>@T("NoProducts")</p>
                        <a href="@Localization.WithLanguage($"/{Slug}/admin")" class="btn btn-outline-primary">@T("AddProductsInAdmin")</a>
                    </div>
                }
                else
                {
                    <div class="ss-product-grid">
                        @foreach (var p in _products.Take(cfg.FeaturedCount > 0 ? cfg.FeaturedCount : 4))
                        {
                            <div class="ss-product-card">
                                <a href="@Localization.WithLanguage($"/{Slug}/products/{p.Id}")" class="ss-product-img-wrap">
                                    @if (!string.IsNullOrEmpty(p.ImagePath))
                                    {
                                        <img src="@p.ImagePath" alt="@p.Name" />
                                    }
                                    else
                                    {
                                        <div class="ss-product-img-placeholder">🏷️</div>
                                    }
                                    @if (!p.IsAvailable)
                                    {
                                        <span class="ss-sold-out">@T("SoldOut")</span>
                                    }
                                </a>
                                <div class="ss-product-info">
                                    <h5 class="ss-product-name">
                                        <a href="@Localization.WithLanguage($"/{Slug}/products/{p.Id}")" class="ss-product-name-link">@p.Name</a>
                                    </h5>
                                    @if (!string.IsNullOrEmpty(p.Description))
                                    {
                                        <p class="ss-product-desc">@p.Description</p>
                                    }
                                    <p class="ss-product-price">@Money(p.Price)</p>
                                    <div class="ss-product-actions">
                                        <a href="@Localization.WithLanguage($"/{Slug}/products/{p.Id}")" class="btn btn-primary btn-sm">@T("Details")</a>
                                        @if (p.IsAvailable)
                                        {
                                            <button class="btn btn-outline-primary btn-sm"
                                                    @onclick="() => AddToCart(p)">@T("Add")</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_products.Count > (cfg.FeaturedCount > 0 ? cfg.FeaturedCount : 4))
                    {
                        <div class="text-center mt-4">
                            <a href="@Localization.WithLanguage($"/{Slug}/products")" class="btn btn-outline-primary btn-lg">
                                @F("ViewProductCount", _products.Count)
                            </a>
                        </div>
                    }
                }
            </div>
        </section>

        <!-- ── 푸터 ── -->
        <ShopPlatform.Components.Pages.Shop.Shared.ShopFooter Config="cfg" Slug="@Slug" />
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private List<ShopPlatform.Models.Product>? _products;
    private string _baseUrl = string.Empty;
    private string _loadedSlug = string.Empty;
    private bool _tenantLookupCompleted;
    private int _loadVersion;

    [Inject] private NavigationManager Nav { get; set; } = default!;

    protected override void OnInitialized()
        => Localization.Changed += OnLanguageChanged;

    protected override async Task OnParametersSetAsync()
    {
        var requestedSlug = Slug;
        if (_tenantLookupCompleted && _loadedSlug == requestedSlug) return;

        var loadVersion = ++_loadVersion;
        _tenantLookupCompleted = false;
        Tenant.Config = null;
        _baseUrl = ShopOpts.BaseUrl.TrimEnd('/');
        _products = null;

        // Resolve the tenant before login synchronization so an existing shop
        // never flashes the unavailable state during the first async render.
        var cfg = await TenantStore.GetAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug) return;

        Tenant.Config = cfg;
        _loadedSlug = requestedSlug;
        _tenantLookupCompleted = true;

        if (!Tenant.IsResolved) return;

        await CustomerLogin.SyncAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug) return;

        using var db = DbFactory.Create(requestedSlug);
        _products = db.Products
            .Where(p => p.IsActive)
            .OrderByDescending(p => p.IsFeatured)
            .ThenBy(p => p.SortOrder)
            .ThenBy(p => p.Name)
            .ToList();
    }

    private void AddToCart(ShopPlatform.Models.Product p)
    {
        Cart.Add(p);
        StateHasChanged();
    }

    private void LogoutCustomer()
    {
        CustomerSession.Logout();
        var returnPath = Localization.WithLanguage($"/{Slug}");
        Nav.NavigateTo(Dreamine.Identity.DreamineIdentityPortal.CreateUrl(
            "signout",
            Nav.ToAbsoluteUri(returnPath).ToString(),
            Localization.Language), forceLoad: true);
    }

    private string T(string key) => ShopStorefrontText.Get(key, Localization.Language);
    private string F(string key, params object?[] args) => ShopStorefrontText.Format(key, Localization.Language, args);
    private string Money(decimal amount) => ShopStorefrontText.Money(amount, Localization.Language);
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Localization.Changed -= OnLanguageChanged;
}
