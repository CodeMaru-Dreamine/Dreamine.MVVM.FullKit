@using ShopPlatform.Models
@inject ShopLocalization Localization
@implements IDisposable

<footer class="ss-footer-biz">
    @{
        var b = Config.Business;
        bool hasBiz = !string.IsNullOrEmpty(b.CompanyName) || !string.IsNullOrEmpty(b.BusinessNumber);
    }

    @if (hasBiz)
    {
        <div class="ss-footer-info">
            @if (!string.IsNullOrEmpty(b.CompanyName) || !string.IsNullOrEmpty(b.Representative) || !string.IsNullOrEmpty(b.BusinessNumber))
            {
                <p>
                    @if (!string.IsNullOrEmpty(b.CompanyName))   { <span>@T("CompanyName"): <strong>@b.CompanyName</strong></span> }
                    @if (!string.IsNullOrEmpty(b.Representative)) { <span class="ss-footer-sep">|</span><span>@T("Representative"): @b.Representative</span> }
                    @if (!string.IsNullOrEmpty(b.BusinessNumber)) { <span class="ss-footer-sep">|</span><span>@T("BusinessNumber"): @b.BusinessNumber</span> }
                </p>
            }
            @if (!string.IsNullOrEmpty(b.Address))
            {
                <p>@T("BusinessAddress"): @b.Address</p>
            }
            @if (!string.IsNullOrEmpty(b.ManagerName) || !string.IsNullOrEmpty(b.Email) || !string.IsNullOrEmpty(b.Phone))
            {
                <p>
                    @if (!string.IsNullOrEmpty(b.ManagerName)) { <span>@T("Manager"): @b.ManagerName</span> }
                    @if (!string.IsNullOrEmpty(b.Email))       { <span class="ss-footer-sep">|</span><span>@T("Email"): <a href="mailto:@b.Email">@b.Email</a></span> }
                    @if (!string.IsNullOrEmpty(b.Phone))       { <span class="ss-footer-sep">|</span><span>@T("FooterPhone"): @b.Phone</span> }
                </p>
            }
        </div>

        <div class="ss-footer-links">
            <a href="@Localization.WithLanguage($"/{Slug}/policy/refund")">@T("RefundPolicy")</a>
            <a href="@Localization.WithLanguage($"/{Slug}/policy/exchange")">@T("ExchangePolicy")</a>
            <a href="@Localization.WithLanguage($"/{Slug}/policy/delivery")">@T("DeliveryPolicy")</a>
        </div>

        @if (!string.IsNullOrEmpty(b.TaxType))
        {
            <p class="ss-footer-tax">※ @b.TaxType</p>
        }
    }

    <p class="ss-footer-copy">
        @if (!string.IsNullOrEmpty(b.CopyrightText))
        {
            @b.CopyrightText
        }
        else
        {
            <span>© @DateTime.Now.Year @Config.ShopName &nbsp;·&nbsp; @T("PoweredBy") <a href="@Localization.WithLanguage("/")">ShopPlatform</a></span>
        }
    </p>
</footer>

@code {
    [Parameter] public ShopConfig Config { get; set; } = default!;
    [Parameter] public string Slug { get; set; } = string.Empty;

    protected override void OnInitialized()
        => Localization.Changed += OnLanguageChanged;

    private string T(string key) => ShopStorefrontText.Get(key, Localization.Language);
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Localization.Changed -= OnLanguageChanged;
}
