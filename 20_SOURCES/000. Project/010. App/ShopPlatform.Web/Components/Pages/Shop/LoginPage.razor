@page "/{Slug}/login"
@using Dreamine.Identity
@inject TenantContext Tenant
@inject IShopTenantStore TenantStore
@inject TenantDbContextFactory DbFactory
@inject ShopCustomerSession Session
@inject ShopCustomerLoginSync CustomerLogin
@inject NavigationManager Nav
@inject ShopLocalization Localization
@implements IDisposable

<PageTitle>@T("Login") — @(Tenant.Config?.ShopName ?? T("Shop"))</PageTitle>

@if (!_tenantLookupCompleted)
{
    <div class="container py-5 text-center"><p class="text-muted">@T("Loading")</p></div>
}
else if (!Tenant.IsResolved)
{
    <div class="container py-5 text-center"><h2>@T("ShopUnavailable")</h2></div>
}
else
{
<div class="container py-5" style="max-width:420px">
    <div class="text-center mb-4">
        <h2 class="fw-bold">@T("Login")</h2>
        <p class="text-muted">@(Tenant.Config?.ShopName ?? "") @T("Member")</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <a class="btn btn-primary w-100 mb-3" href="@CommonLoginUrl">@T("ContinueWithCodeMaru")</a>
            <div class="text-center text-muted small mb-3">@T("OrLocalLogin")</div>
            <div class="mb-3">
                <label class="form-label">@T("Email")</label>
                <input class="form-control" type="email" @bind="_email" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("Password")</label>
                <input class="form-control" type="password" @bind="_password" @bind:event="oninput"
                       @onkeypress="OnKey" />
            </div>
            @if (!string.IsNullOrEmpty(_errorKey))
            {
                <div class="alert alert-danger py-2">@T(_errorKey)</div>
            }
            <button class="btn btn-primary w-100" @onclick="Login" disabled="@_loading">
                @(_loading ? T("SigningIn") : T("Login"))
            </button>
            <hr />
            <p class="text-center mb-0 small">
                @T("CheckoutProfileHelp")
            </p>
        </div>
    </div>
    <div class="text-center mt-3">
        <a href="@Localization.WithLanguage($"/{Slug}")" class="text-muted small">← @T("BackToShop")</a>
    </div>
</div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _errorKey = string.Empty;
    private bool _loading;
    private bool _tenantLookupCompleted;
    private int _loadVersion;
    private string SafeReturnPath => GetSafeReturnPath(ReturnUrl, Slug);
    private string SafeLocalizedReturnPath => Localization.WithLanguage(SafeReturnPath);

    protected override void OnInitialized()
        => Localization.Changed += OnLanguageChanged;

    protected override async Task OnParametersSetAsync()
    {
        var requestedSlug = Slug;
        var loadVersion = ++_loadVersion;
        _tenantLookupCompleted = false;
        Tenant.Config = null;

        var cfg = await TenantStore.GetAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug) return;

        Tenant.Config = cfg;
        _tenantLookupCompleted = true;
        if (!Tenant.IsResolved) return;

        await CustomerLogin.SyncAsync(requestedSlug);
        if (loadVersion != _loadVersion || requestedSlug != Slug) return;

        if (Session.IsLoggedIn)
            Nav.NavigateTo(SafeLocalizedReturnPath);
    }

    private string CommonLoginUrl => Dreamine.Identity.DreamineIdentityPortal.CreateUrl(
        "login",
        Nav.ToAbsoluteUri(SafeLocalizedReturnPath).ToString(),
        Localization.Language);

    private void Login()
    {
        _errorKey = string.Empty;
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _errorKey = "LoginRequiredFields";
            return;
        }
        _loading = true;
        using var db = DbFactory.Create(Slug);
        var user = db.Users.FirstOrDefault(u => u.Email == _email.Trim().ToLower());
        if (user == null)
        {
            _errorKey = "InvalidCredentials";
            _loading = false;
            return;
        }

        var verification = DreaminePasswordHasher.VerifyPassword(_password, user.PasswordHash, out var upgradedHash);
        if (verification is PasswordHashVerificationResult.Failed && VerifyLegacyShopHash(_password, user.PasswordHash))
        {
            verification = PasswordHashVerificationResult.SuccessRehashNeeded;
            upgradedHash = DreaminePasswordHasher.HashPassword(_password);
        }

        if (verification is PasswordHashVerificationResult.Failed)
        {
            _errorKey = "InvalidCredentials";
            _loading = false;
            return;
        }

        if (verification is PasswordHashVerificationResult.SuccessRehashNeeded && upgradedHash is not null)
        {
            user.PasswordHash = upgradedHash;
            db.Users.Update(user);
            db.SaveChanges();
        }

        Session.Login(user);
        Nav.NavigateTo(SafeLocalizedReturnPath);
    }

    private Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Login();
        return Task.CompletedTask;
    }

    private static bool VerifyLegacyShopHash(string plain, string hash)
    {
        var actual = Convert.ToBase64String(System.Security.Cryptography.SHA256.HashData(
            System.Text.Encoding.UTF8.GetBytes(plain + "ShopPlatformSalt2025")));
        return string.Equals(actual, hash, StringComparison.Ordinal);
    }

    private static string GetSafeReturnPath(string? requestedPath, string tenantSlug)
    {
        if (!IsValidTenantSlug(tenantSlug))
            return "/";

        var tenantRoot = $"/{tenantSlug}";
        if (string.IsNullOrWhiteSpace(requestedPath))
            return tenantRoot;

        if (requestedPath.Length > 2048 ||
            requestedPath[0] != '/' ||
            requestedPath.StartsWith("//", StringComparison.Ordinal) ||
            requestedPath.Contains('\\') ||
            requestedPath.Any(char.IsControl))
        {
            return tenantRoot;
        }

        var decoded = requestedPath;
        try
        {
            while (true)
            {
                var next = Uri.UnescapeDataString(decoded);
                if (string.Equals(next, decoded, StringComparison.Ordinal))
                    break;

                decoded = next;
            }
        }
        catch (UriFormatException)
        {
            return tenantRoot;
        }

        if (decoded.StartsWith("//", StringComparison.Ordinal) ||
            decoded.Contains('\\') ||
            decoded.Contains("://", StringComparison.Ordinal) ||
            decoded.Any(char.IsControl))
        {
            return tenantRoot;
        }

        var localOrigin = new Uri("https://local.invalid/", UriKind.Absolute);
        if (!Uri.TryCreate(localOrigin, decoded, out var resolved) ||
            !string.Equals(resolved.Scheme, localOrigin.Scheme, StringComparison.Ordinal) ||
            !string.Equals(resolved.Host, localOrigin.Host, StringComparison.Ordinal) ||
            resolved.Port != localOrigin.Port ||
            !string.IsNullOrEmpty(resolved.UserInfo))
        {
            return tenantRoot;
        }

        string normalizedPath;
        try
        {
            normalizedPath = Uri.UnescapeDataString(resolved.AbsolutePath);
        }
        catch (UriFormatException)
        {
            return tenantRoot;
        }

        if (!string.Equals(normalizedPath, tenantRoot, StringComparison.Ordinal) &&
            !normalizedPath.StartsWith($"{tenantRoot}/", StringComparison.Ordinal))
        {
            return tenantRoot;
        }

        return resolved.AbsolutePath + resolved.Query + resolved.Fragment;
    }

    private static bool IsValidTenantSlug(string slug)
    {
        if (slug.Length is < 2 or > 30 || slug[0] == '-' || slug[^1] == '-')
            return false;

        return slug.All(c => c is >= 'a' and <= 'z' or >= '0' and <= '9' or '-');
    }

    private string T(string key) => ShopStorefrontText.Get(key, Localization.Language);
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Localization.Changed -= OnLanguageChanged;
}
