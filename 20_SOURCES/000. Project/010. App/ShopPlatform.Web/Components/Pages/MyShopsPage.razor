@page "/my-shops"
@implements IDisposable
@inject IShopTenantStore TenantStore
@inject ShopUserContext UserContext
@inject NavigationManager Nav
@inject ShopLocalization Localization

<PageTitle>@T("myShops.pageTitle")</PageTitle>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">@T("myShops.title")</h1>
            <p class="text-muted mb-0">@T("myShops.description")</p>
        </div>
        <a class="btn btn-outline-secondary" href="@Localization.WithLanguage("/")">@T("myShops.home")</a>
    </div>

    @if (!currentUser.IsAuthenticated)
    {
        <div class="card shadow-sm" style="max-width:480px">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold">@T("myShops.login.title")</h2>
                <p class="text-muted">@T("myShops.login.description")</p>
                <a class="btn btn-primary w-100" href="@LoginUrl">@T("myShops.login.action")</a>
            </div>
        </div>
    }
    else if (_loading)
    {
        <p class="text-muted">@T("myShops.loading")</p>
    }
    else if (_shops.Count == 0)
    {
        <div class="card shadow-sm" style="max-width:520px">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold">@T("myShops.empty.title")</h2>
                <p class="text-muted">@T("myShops.empty.description")</p>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-primary" href="@Localization.WithLanguage("/apply")">@T("myShops.empty.apply")</a>
                    <a class="btn btn-outline-secondary" href="@Localization.WithLanguage("/")">@T("myShops.home")</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var shop in _shops)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(shop.LogoPath))
                        {
                            <img src="@shop.LogoPath" class="card-img-top" alt="@shop.ShopName" style="height:160px;object-fit:cover" />
                        }
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h2 class="h5 fw-bold mb-0">@shop.ShopName</h2>
                                <span class="badge @(shop.IsActive ? "bg-success" : "bg-secondary")">
                                    @(shop.IsActive ? T("myShops.active") : T("myShops.inactive"))
                                </span>
                            </div>
                            <p class="text-muted small mb-2">@(!string.IsNullOrWhiteSpace(shop.Description) ? shop.Description : T("myShops.noDescription"))</p>
                            <p class="small mb-3"><code>/@shop.Slug</code></p>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="@Localization.WithLanguage($"/{shop.Slug}/admin")" class="btn btn-primary btn-sm">@T("myShops.openAdmin")</a>
                                <a href="@Localization.WithLanguage($"/{shop.Slug}")" class="btn btn-outline-secondary btn-sm">@T("myShops.viewShop")</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private ShopCurrentUser currentUser = ShopCurrentUser.Anonymous;
    private List<ShopConfig> _shops = new();
    private bool _loading = true;

    private string LoginUrl => Dreamine.Identity.DreamineIdentityPortal.CreateUrl("login", Nav.Uri, Localization.Language);

    protected override async Task OnInitializedAsync()
    {
        Localization.Changed += HandleLanguageChanged;
        currentUser = await UserContext.GetCurrentAsync();
        if (!currentUser.IsAuthenticated)
        {
            _loading = false;
            return;
        }

        var all = await TenantStore.GetAllAsync();
        _shops = all
            .Where(shop => IsAdminUser(shop, currentUser))
            .OrderBy(shop => shop.ShopName)
            .ToList();
        _loading = false;
    }

    private static bool IsAdminUser(ShopConfig config, ShopCurrentUser user)
    {
        if (!user.IsAuthenticated) return false;
        if (string.Equals(config.OwnerUserId, user.Id, StringComparison.Ordinal)) return true;
        return config.AdminUsers.Any(admin => string.Equals(admin.UserId, user.Id, StringComparison.Ordinal));
    }

    private string T(string key) => ShopPlatformText.Get(key, Localization.Language);
    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Localization.Changed -= HandleLanguageChanged;
}
