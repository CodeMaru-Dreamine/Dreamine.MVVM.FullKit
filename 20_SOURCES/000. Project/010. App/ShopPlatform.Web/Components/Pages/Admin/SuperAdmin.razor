@page "/admin"
@using Dreamine.Identity
@inject IShopTenantStore TenantStore
@inject ShopOptions Opts
@inject NavigationManager Nav
@inject ShopLocalization Localization
@implements IDisposable

<PageTitle>@T("superAdmin.pageTitle") — ShopPlatform</PageTitle>

@if (!_authenticated)
{
    <div class="container py-5" style="max-width:400px">
        <h2>@T("superAdmin.heading")</h2>
        <div class="mb-3">
            <label class="form-label">@T("common.password")</label>
            <input type="password" class="form-control" @bind="_password" @bind:event="oninput" @onkeypress="OnKey" />
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        <button class="btn btn-primary w-100" @onclick="Login">@T("common.signIn")</button>
    </div>
}
else
{
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>@T("superAdmin.manageShops")</h2>
            <div>
                <button class="btn btn-success me-2" @onclick="() => _showCreate = true">+ @T("superAdmin.createShop")</button>
                <button class="btn btn-outline-danger" @onclick="Logout">@T("common.signOut")</button>
            </div>
        </div>

        @if (_showCreate)
        {
            <div class="card mb-4" style="max-width:500px">
                <div class="card-body">
                    <h5>@T("superAdmin.createHeading")</h5>
                    <div class="mb-3">
                        <label class="form-label">@T("superAdmin.slug") (URL)</label>
                        <div class="input-group">
                            <span class="input-group-text">shop.codemaru.co.kr/</span>
                            <input class="form-control" @bind="_newSlug" placeholder="my-shop" />
                        </div>
                        <div class="form-text">@T("superAdmin.slugHelp")</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@T("common.shopName")</label>
                        <input class="form-control" @bind="_newName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@T("superAdmin.adminPassword")</label>
                        <input class="form-control" type="password" @bind="_newPassword" />
                    </div>
                    @if (!string.IsNullOrEmpty(_createError))
                    {
                        <div class="alert alert-danger">@_createError</div>
                    }
                    <button class="btn btn-primary me-2" @onclick="CreateShop">@T("common.create")</button>
                    <button class="btn btn-secondary" @onclick="() => _showCreate = false">@T("common.cancel")</button>
                </div>
            </div>
        }

        @if (_shops == null)
        {
            <p>@T("common.loading")</p>
        }
        else if (_shops.Count == 0)
        {
            <p class="text-muted">@T("superAdmin.noShops")</p>
        }
        else
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@T("superAdmin.slug")</th>
                        <th>@T("common.shopName")</th>
                        <th>@T("common.status")</th>
                        <th>@T("common.payment")</th>
                        <th>@T("common.createdAt")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _shops)
                    {
                        <tr>
                            <td><code>@s.Slug</code></td>
                            <td>@s.ShopName</td>
                            <td>
                                <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">
                                    @(s.IsActive ? T("common.active") : T("common.inactive"))
                                </span>
                            </td>
                            <td>
                                @if (s.Payment.IsEnabled)
                                {
                                    <span class="badge @(s.Payment.IsTestMode ? "bg-warning text-dark" : "bg-success")">
                                        @(s.Payment.IsTestMode ? T("common.test") : T("common.live"))
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">@T("common.notConfigured")</span>
                                }
                            </td>
                            <td>@s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td>
                                <a href="@Localization.WithLanguage($"/{s.Slug}")" class="btn btn-sm btn-outline-secondary me-1" target="_blank" rel="noopener">@T("common.view")</a>
                                <a href="@Localization.WithLanguage($"/{s.Slug}/admin")" class="btn btn-sm btn-outline-primary me-1">@T("common.admin")</a>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteShop(s.Slug)">@T("common.delete")</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private bool _authenticated;
    private string _password = string.Empty;
    private string _error = string.Empty;
    private List<ShopConfig>? _shops;
    private bool _showCreate;
    private string _newSlug = string.Empty;
    private string _newName = string.Empty;
    private string _newPassword = string.Empty;
    private string _createError = string.Empty;

    protected override void OnInitialized()
    {
        Localization.Changed += OnLocalizationChanged;
    }

    private async Task Login()
    {
        try
        {
            if (DreaminePasswordHasher.VerifyPassword(_password, Opts.SuperAdminPassword))
            {
                _authenticated = true;
                await LoadShops();
            }
            else
            {
                _error = string.Format(T("superAdmin.invalidPasswordLength"), _password.Length);
            }
        }
        catch (Exception ex)
        {
            _error = string.Format(T("common.errorWithMessage"), ex.Message);
        }
    }

    private void Logout() => _authenticated = false;

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Login();
    }

    private async Task LoadShops()
    {
        _shops = (await TenantStore.GetAllAsync()).ToList();
    }

    private async Task CreateShop()
    {
        _createError = string.Empty;
        var slug = _newSlug.Trim().ToLowerInvariant();

        if (string.IsNullOrEmpty(slug) ||
            !System.Text.RegularExpressions.Regex.IsMatch(
                slug,
                @"^[a-z0-9\-]+$",
                System.Text.RegularExpressions.RegexOptions.None,
                TimeSpan.FromMilliseconds(250)))
        {
            _createError = T("superAdmin.invalidSlug");
            return;
        }
        if (await TenantStore.ExistsAsync(slug))
        {
            _createError = T("superAdmin.slugExists");
            return;
        }
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _createError = T("superAdmin.passwordRequired");
            return;
        }
        if (_newPassword.Length < 8)
        {
            _createError = T("superAdmin.passwordMinLength");
            return;
        }

        var config = new ShopConfig
        {
            Slug = slug,
            ShopName = string.IsNullOrWhiteSpace(_newName) ? slug : _newName.Trim(),
            AdminPasswordHash = DreaminePasswordHasher.HashPassword(_newPassword),
            IsActive = true,
            CreatedAt = DateTime.UtcNow
        };
        await TenantStore.SaveAsync(config);
        _showCreate = false;
        _newSlug = _newName = _newPassword = string.Empty;
        await LoadShops();
    }

    private async Task DeleteShop(string slug)
    {
        await TenantStore.DeleteAsync(slug);
        await LoadShops();
    }

    private string T(string key) => ShopAdminText.Get(key, Localization.Language);
    private void OnLocalizationChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Localization.Changed -= OnLocalizationChanged;
}
