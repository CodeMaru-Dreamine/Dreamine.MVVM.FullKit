@inject PaymentKeyProtector KeyProtector
@inject ShopLocalization Localization
@implements IDisposable

<div class="card" style="max-width:600px">
    <div class="card-header">
        <h5 class="mb-0">@T("paymentSettings.title")</h5>
    </div>
    <div class="card-body">

        <div class="alert alert-info mb-4">
            <strong>@T("paymentSettings.keyGuideTitle")</strong><br />
            1. <a href="https://developers.tosspayments.com" target="_blank" rel="noopener">@T("paymentSettings.developerConsole")</a> @T("paymentSettings.openConsole")<br />
            2. @T("paymentSettings.keyGuideStep2")<br />
            3. @T("paymentSettings.testKeys"): <code>test_ck_...</code> / <code>test_sk_...</code><br />
            4. @T("paymentSettings.liveKeyStep")<br />
            <small class="text-muted">@T("paymentSettings.settlementNote")</small>
        </div>

        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="payEnabled"
                   @bind="_isEnabled" />
            <label class="form-check-label" for="payEnabled">@T("paymentSettings.enable")</label>
        </div>

        <div class="form-check form-switch mb-4">
            <input class="form-check-input" type="checkbox" id="testMode"
                   @bind="_isTestMode" />
            <label class="form-check-label" for="testMode">
                @T("paymentSettings.testMode")
                <span class="badge @(_isTestMode ? "bg-warning text-dark" : "bg-success") ms-1">
                    @(_isTestMode ? T("common.test") : T("common.live"))
                </span>
            </label>
        </div>

        <div class="mb-3">
            <label class="form-label">@T("paymentSettings.clientKey") (Client Key)</label>
            <input class="form-control font-monospace" placeholder="@(_isTestMode ? "test_ck_..." : "ck_...")"
                   @bind="_clientKey" />
            <div class="form-text">@T("paymentSettings.clientKeyHelp")</div>
        </div>

        <div class="mb-3">
            <label class="form-label">@T("paymentSettings.secretKey") (Secret Key)</label>
            <input class="form-control font-monospace" type="password"
                   placeholder="@(_isTestMode ? "test_sk_..." : "sk_...")"
                   @bind="_secretKeyPlain" />
            <div class="form-text">@T("paymentSettings.secretKeyHelp")</div>
            @if (!string.IsNullOrEmpty(_secretKeyPlain))
            {
                <div class="form-text text-success">✓ @T("paymentSettings.newKeyEntered")</div>
            }
            else if (!string.IsNullOrEmpty(Config.Payment.TossSecretKeyEncrypted))
            {
                <div class="form-text text-muted">@T("paymentSettings.existingKey")</div>
            }
        </div>

        @if (!string.IsNullOrEmpty(_saveMessage))
        {
            <div class="alert @(_saveError ? "alert-danger" : "alert-success")">@_saveMessage</div>
        }

        <button class="btn btn-primary" @onclick="Save">@T("paymentSettings.save")</button>
    </div>
</div>

@code {
    [Parameter] public ShopConfig Config { get; set; } = default!;
    [Parameter] public EventCallback<ShopConfig> OnSave { get; set; }

    private bool _isEnabled;
    private bool _isTestMode;
    private string _clientKey = string.Empty;
    private string _secretKeyPlain = string.Empty;
    private string _saveMessage = string.Empty;
    private bool _saveError;
    private ShopConfig? _loadedConfig;

    protected override void OnInitialized()
    {
        Localization.Changed += OnLocalizationChanged;
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loadedConfig, Config)) return;
        _loadedConfig = Config;
        _isEnabled = Config.Payment.IsEnabled;
        _isTestMode = Config.Payment.IsTestMode;
        _clientKey = Config.Payment.TossClientKey;
    }

    private async Task Save()
    {
        _saveMessage = string.Empty;
        Config.Payment.IsEnabled = _isEnabled;
        Config.Payment.IsTestMode = _isTestMode;
        Config.Payment.TossClientKey = _clientKey.Trim();

        if (!string.IsNullOrWhiteSpace(_secretKeyPlain))
        {
            Config.Payment.TossSecretKeyEncrypted = KeyProtector.Protect(_secretKeyPlain.Trim());
            _secretKeyPlain = string.Empty;
        }

        // 콜백 URL 자동 세팅
        var slug = Config.Slug;
        Config.Payment.SuccessReturnUrl = $"/pay/{slug}/return";
        Config.Payment.FailReturnUrl = $"/pay/{slug}/fail";

        try
        {
            await OnSave.InvokeAsync(Config);
            _saveMessage = T("paymentSettings.saved");
            _saveError = false;
        }
        catch (Exception ex)
        {
            _saveMessage = string.Format(T("common.saveFailed"), ex.Message);
            _saveError = true;
        }
    }

    private string T(string key) => ShopAdminText.Get(key, Localization.Language);
    private void OnLocalizationChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Localization.Changed -= OnLocalizationChanged;
}
