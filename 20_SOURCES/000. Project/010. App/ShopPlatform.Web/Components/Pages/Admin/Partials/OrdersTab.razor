@inject TenantDbContextFactory DbFactory
@inject ShopLocalization Localization
@implements IDisposable

<div>
    <h5 class="mb-3">@T("orders.title")</h5>

    @if (_orders == null)
    {
        <p>@T("common.loading")</p>
    }
    else if (_orders.Count == 0)
    {
        <p class="text-muted">@T("orders.empty")</p>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>@T("orders.number")</th>
                    <th>@T("orders.customer")</th>
                    <th>@T("orders.total")</th>
                    <th>@T("common.status")</th>
                    <th>@T("orders.dateTime")</th>
                    <th>@T("orders.transactionId")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in _orders)
                {
                    <tr>
                        <td><code>@o.OrderNo</code></td>
                        <td>@o.CustomerName</td>
                        <td>@o.TotalAmount.ToString("N0") @T("common.krw")</td>
                        <td>
                            <span class="badge @StatusBadge(o.Status)">@StatusLabel(o.Status)</span>
                        </td>
                        <td>@o.CreatedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                        <td><small class="text-muted">@o.TransactionId</small></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private List<Order>? _orders;

    protected override void OnInitialized()
    {
        Localization.Changed += OnLocalizationChanged;
        using var db = DbFactory.Create(Slug);
        _orders = db.Orders.OrderByDescending(o => o.Id).ToList();
    }

    private static string StatusBadge(string status) => status switch
    {
        "paid" => "bg-success",
        "pending" => "bg-warning text-dark",
        "cancelled" => "bg-danger",
        _ => "bg-secondary"
    };

    private string StatusLabel(string status) => status.ToLowerInvariant() switch
    {
        "paid" => T("orders.statusPaid"),
        "pending" => T("orders.statusPending"),
        "cancelled" => T("orders.statusCancelled"),
        _ => status
    };

    private string T(string key) => ShopAdminText.Get(key, Localization.Language);
    private void OnLocalizationChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Localization.Changed -= OnLocalizationChanged;
}
