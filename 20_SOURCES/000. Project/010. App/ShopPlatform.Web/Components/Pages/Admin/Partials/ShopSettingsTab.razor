@inject IShopTenantStore TenantStore
@inject ShopOptions ShopOpts
@inject TenantDbContextFactory DbFactory
@inject ShopLocalization Localization
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

<div style="max-width:680px">

    <!-- 기본 정보 -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">@T("shopSettings.basicInfo")</div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">@T("common.shopName")</label>
                <input class="form-control" @bind="_name" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("shopSettings.descriptionLabel")</label>
                <textarea class="form-control" rows="2" @bind="_description"></textarea>
            </div>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" @bind="_isActive" />
                <label class="form-check-label">@T("shopSettings.enableShop")</label>
            </div>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" @bind="_showPlatformHomeLink" />
                <label class="form-check-label">@T("shopSettings.showPlatformHome")</label>
                <div class="form-text">@T("shopSettings.showPlatformHomeHelp")</div>
            </div>
        </div>
    </div>

    <!-- 히어로 배너 -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">@T("shopSettings.heroSettings")</div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">@T("shopSettings.heroText")</label>
                <input class="form-control" @bind="_heroText"
                       placeholder="@T("shopSettings.heroTextPlaceholder")" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("shopSettings.heroSubText")</label>
                <input class="form-control" @bind="_heroSubText"
                       placeholder="@T("shopSettings.heroSubTextPlaceholder")" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("shopSettings.bannerUrl")</label>
                <input class="form-control" @bind="_bannerImagePath"
                       placeholder="@T("shopSettings.urlPlaceholder")" />
                <div class="form-text">@T("shopSettings.defaultGradientHelp")</div>
            </div>
            <div class="mb-3">
                <label class="form-label">@T("shopSettings.uploadBanner")</label>
                <InputFile OnChange="UploadBanner" accept="image/*" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("shopSettings.featuredCount")</label>
                <select class="form-select" style="max-width:160px" @bind="_featuredCount">
                    <option value="3">@string.Format(T("shopSettings.itemCount"), 3)</option>
                    <option value="4">@string.Format(T("shopSettings.itemCount"), 4)</option>
                    <option value="6">@string.Format(T("shopSettings.itemCount"), 6)</option>
                    <option value="8">@string.Format(T("shopSettings.itemCount"), 8)</option>
                </select>
            </div>
        </div>
    </div>

    <!-- 로고 -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">@T("shopSettings.logoImage")</div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(_logoPath))
            {
                <div class="mb-2">
                    <img src="@_logoPath" alt="@T("shopSettings.logoAlt")" style="height:60px;object-fit:contain;border:1px solid #e2e8f0;border-radius:8px;padding:4px" />
                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => _logoPath = null">@T("common.delete")</button>
                </div>
            }
            <div class="mb-3">
                <label class="form-label">@T("shopSettings.logoUrl")</label>
                <input class="form-control" @bind="_logoPath" placeholder="@T("shopSettings.logoUrlPlaceholder")" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("shopSettings.uploadLogo")</label>
                <InputFile OnChange="UploadLogo" accept="image/*" class="form-control" />
            </div>
        </div>
    </div>

    <!-- 사업자 정보 -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">@T("shopSettings.businessInfo")</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@T("shopSettings.companyName")</label>
                    <input class="form-control" @bind="_bizCompany" placeholder="@T("shopSettings.companyPlaceholder")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@T("shopSettings.representative")</label>
                    <input class="form-control" @bind="_bizRep" placeholder="@T("shopSettings.personPlaceholder")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@T("shopSettings.businessNumber")</label>
                    <input class="form-control" @bind="_bizNumber" placeholder="@T("shopSettings.businessNumberPlaceholder")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@T("common.phone")</label>
                    <input class="form-control" @bind="_bizPhone" placeholder="@T("shopSettings.phonePlaceholder")" />
                </div>
                <div class="col-12">
                    <label class="form-label">@T("common.address")</label>
                    <input class="form-control" @bind="_bizAddress" placeholder="@T("shopSettings.addressPlaceholder")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@T("shopSettings.operationsManager")</label>
                    <input class="form-control" @bind="_bizManager" placeholder="@T("shopSettings.managerPlaceholder")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@T("common.email")</label>
                    <input class="form-control" @bind="_bizEmail" placeholder="@T("shopSettings.emailPlaceholder")" />
                </div>
                <div class="col-12">
                    <label class="form-label">@T("shopSettings.taxType")</label>
                    <input class="form-control" @bind="_bizTaxType"
                           placeholder="@T("shopSettings.taxPlaceholder")" />
                </div>
                <div class="col-12">
                    <label class="form-label">@T("shopSettings.copyrightText")</label>
                    <input class="form-control" @bind="_bizCopyright"
                           placeholder="@T("shopSettings.copyrightPlaceholder")" />
                </div>
            </div>
        </div>
    </div>

    <!-- 환불·교환·배송 정책 -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">📋 @T("shopSettings.policies")</div>
        <div class="card-body">
            <div class="alert alert-info py-2 mb-3" style="font-size:.85rem">
                <strong>@T("shopSettings.markdownHelp")</strong><br />
                <code>- @T("products.itemExample")</code> → @T("shopSettings.bulletList") &nbsp;|&nbsp;
                <code>**@T("products.boldExample")**</code> → <strong>@T("products.boldExample")</strong> &nbsp;|&nbsp;
                <code>## @T("shopSettings.titleExample")</code> → @T("products.subheadingExample") &nbsp;|&nbsp;
                @T("shopSettings.blankLineParagraph")
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">@T("shopSettings.refundPolicy")</label>
                <textarea class="form-control" rows="6" @bind="_policyRefund"
                          placeholder="@T("shopSettings.refundPlaceholder")"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">@T("shopSettings.exchangePolicy")</label>
                <textarea class="form-control" rows="6" @bind="_policyExchange"
                          placeholder="@T("shopSettings.exchangePlaceholder")"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">@T("shopSettings.deliveryPolicy")</label>
                <textarea class="form-control" rows="6" @bind="_policyDelivery"
                          placeholder="@T("shopSettings.deliveryPlaceholder")"></textarea>
            </div>
        </div>
    </div>

    <!-- 링크 미리보기 -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">🔗 @T("shopSettings.linkPreview")</div>
        <div class="card-body">
            <p class="text-muted small mb-3">@T("shopSettings.linkPreviewHelp")</p>
            <div class="mb-3">
                <label class="form-label">@T("shopSettings.previewTitle")</label>
                <input class="form-control" @bind="_ogTitle"
                       placeholder="@T("shopSettings.previewTitlePlaceholder")" />
            </div>
            <div class="mb-3">
                <label class="form-label">@T("shopSettings.previewDescription")</label>
                <textarea class="form-control" rows="2" @bind="_ogDescription"
                          placeholder="@T("shopSettings.previewDescriptionPlaceholder")"></textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">@T("shopSettings.previewImage")</label>
                @if (!string.IsNullOrEmpty(_ogImagePath))
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="@_ogImagePath" alt="@T("shopSettings.ogImageAlt")"
                             style="height:72px;width:128px;object-fit:cover;border:1px solid #e2e8f0;border-radius:6px" />
                        <span class="text-muted small">@System.IO.Path.GetFileName(_ogImagePath)</span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _ogImagePath = null">× @T("common.remove")</button>
                    </div>
                }
                <InputFile OnChange="UploadOgImage" accept="image/*" class="form-control" />
                <div class="form-text">@T("shopSettings.previewImageHelp")</div>
            </div>
        </div>
    </div>

    <!-- 관리자 -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">@T("common.administrators")</div>
        <div class="card-body">
            <p class="text-muted small mb-2">
                @T("shopSettings.adminHelp")
            </p>
            @if (Config.AdminUsers.Count == 0)
            {
                <div class="alert alert-warning py-2 mb-0">@T("shopSettings.noAdmins")</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@T("common.name")</th>
                                <th>@T("common.email")</th>
                                <th>@T("shopSettings.role")</th>
                                @if (CanManageAdmins)
                                {
                                    <th style="width:180px">@T("common.manage")</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var admin in Config.AdminUsers)
                            {
                                <tr>
                                    <td>@admin.DisplayName</td>
                                    <td>@admin.Email</td>
                                    <td>
                                        @if (CanManageAdmins && !IsCurrentUser(admin))
                                        {
                                            <select class="form-select form-select-sm" style="max-width:120px"
                                                    value="@NormalizeRole(admin.Role)"
                                                    @onchange="e => ChangeAdminRole(admin, e.Value?.ToString() ?? AdminRole)">
                                                <option value="Owner">@T("roles.owner")</option>
                                                <option value="Admin">@T("roles.admin")</option>
                                            </select>
                                        }
                                        else
                                        {
                                            @RoleLabel(EffectiveRole(admin))
                                        }
                                    </td>
                                    @if (CanManageAdmins)
                                    {
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    disabled="@(!CanRemoveAdmin(admin))"
                                                    @onclick="() => RemoveAdmin(admin)">
                                                @T("common.delete")
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert alert-success">@_msg</div>
    }
    @if (!string.IsNullOrEmpty(_err))
    {
        <div class="alert alert-danger">@_err</div>
    }

    <button class="btn btn-primary" @onclick="Save">@T("common.save")</button>
</div>

@code {
    [Parameter] public ShopConfig Config { get; set; } = default!;
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;
    [Parameter] public EventCallback<ShopConfig> OnSave { get; set; }

    private const string AdminRole = "Admin";

    private string _name        = string.Empty;
    private string _description = string.Empty;
    private string _heroText    = string.Empty;
    private string _heroSubText = string.Empty;
    private string? _bannerImagePath;
    private string? _logoPath;
    private int    _featuredCount = 4;
    private bool   _isActive;
    private bool   _showPlatformHomeLink;
    private string _msg = string.Empty;
    private string _err = string.Empty;

    // 정책
    private string _policyRefund   = string.Empty;
    private string _policyExchange = string.Empty;
    private string _policyDelivery = string.Empty;

    // OG 미리보기
    private string  _ogTitle       = string.Empty;
    private string  _ogDescription = string.Empty;
    private string? _ogImagePath;

    // 사업자 정보
    private string _bizCompany  = string.Empty;
    private string _bizRep      = string.Empty;
    private string _bizNumber   = string.Empty;
    private string _bizPhone    = string.Empty;
    private string _bizAddress  = string.Empty;
    private string _bizManager  = string.Empty;
    private string _bizEmail    = string.Empty;
    private string _bizTaxType  = string.Empty;
    private string _bizCopyright = string.Empty;
    private ShopConfig? _loadedConfig;

    protected override void OnInitialized()
    {
        Localization.Changed += OnLocalizationChanged;
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loadedConfig, Config)) return;
        _loadedConfig = Config;
        _name             = Config.ShopName;
        _description      = Config.Description;
        _heroText         = Config.HeroText;
        _heroSubText      = Config.HeroSubText;
        _bannerImagePath  = Config.BannerImagePath;
        _logoPath         = Config.LogoPath;
        _featuredCount    = Config.FeaturedCount > 0 ? Config.FeaturedCount : 4;
        _isActive         = Config.IsActive;
        _showPlatformHomeLink = Config.ShowPlatformHomeLink;
        _ogTitle          = Config.OgTitle;
        _ogDescription    = Config.OgDescription;
        _ogImagePath      = Config.OgImagePath;
        _policyRefund     = Config.Policy.RefundPolicy;
        _policyExchange   = Config.Policy.ExchangePolicy;
        _policyDelivery   = Config.Policy.DeliveryPolicy;

        var b = Config.Business;
        _bizCompany   = b.CompanyName;
        _bizRep       = b.Representative;
        _bizNumber    = b.BusinessNumber;
        _bizPhone     = b.Phone;
        _bizAddress   = b.Address;
        _bizManager   = b.ManagerName;
        _bizEmail     = b.Email;
        _bizTaxType   = b.TaxType;
        _bizCopyright = b.CopyrightText;
    }

    private async Task UploadBanner(InputFileChangeEventArgs e)
        => _bannerImagePath = await SaveImage(e, "banner");

    private async Task UploadLogo(InputFileChangeEventArgs e)
        => _logoPath = await SaveImage(e, "logo");

    private async Task UploadOgImage(InputFileChangeEventArgs e)
        => _ogImagePath = await SaveImage(e, "og");

    private async Task<string?> SaveImage(InputFileChangeEventArgs e, string prefix)
    {
        _err = string.Empty;
        var file = e.File;
        var allowed = new[] { "image/jpeg", "image/png", "image/webp", "image/gif" };
        if (!allowed.Contains(file.ContentType)) { _err = T("shopSettings.invalidImageType"); return null; }
        if (file.Size > 5 * 1024 * 1024) { _err = T("shopSettings.imageTooLarge"); return null; }

        var ext = Path.GetExtension(file.Name).ToLower();
        var fn  = $"{prefix}-{Guid.NewGuid():N}{ext}";
        var dir = Path.Combine(ShopOpts.ResolvedDataPath, Config.Slug, "images");
        Directory.CreateDirectory(dir);
        var path = Path.Combine(dir, fn);
        await using var fs = File.Create(path);
        await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(fs);
        return $"/shop-img/{Config.Slug}/images/{fn}";
    }

    private async Task Save()
    {
        Config.ShopName        = _name;
        Config.Description     = _description;
        Config.HeroText        = _heroText;
        Config.HeroSubText     = _heroSubText;
        Config.BannerImagePath = _bannerImagePath;
        Config.LogoPath        = _logoPath;
        Config.FeaturedCount   = _featuredCount;
        Config.IsActive        = _isActive;
        Config.ShowPlatformHomeLink = _showPlatformHomeLink;
        Config.OgTitle         = _ogTitle;
        Config.OgDescription   = _ogDescription;
        Config.OgImagePath     = _ogImagePath;
        Config.Policy.RefundPolicy   = _policyRefund;
        Config.Policy.ExchangePolicy = _policyExchange;
        Config.Policy.DeliveryPolicy = _policyDelivery;

        Config.Business.CompanyName    = _bizCompany;
        Config.Business.Representative = _bizRep;
        Config.Business.BusinessNumber = _bizNumber;
        Config.Business.Phone          = _bizPhone;
        Config.Business.Address        = _bizAddress;
        Config.Business.ManagerName    = _bizManager;
        Config.Business.Email          = _bizEmail;
        Config.Business.TaxType        = _bizTaxType;
        Config.Business.CopyrightText  = _bizCopyright;

        await OnSave.InvokeAsync(Config);
        _msg = T("common.saved");
        await Task.Delay(2000);
        _msg = string.Empty;
    }

    private bool CanManageAdmins =>
        Config.AdminUsers.Any(admin =>
            string.Equals(admin.UserId, CurrentUserId, StringComparison.Ordinal)
            && string.Equals(EffectiveRole(admin), "Owner", StringComparison.OrdinalIgnoreCase));

    private static string NormalizeRole(string? role) =>
        string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase) ? "Owner" : "Admin";

    private string EffectiveRole(ShopAdminUser admin)
    {
        if (!string.IsNullOrWhiteSpace(Config.OwnerUserId)
            && string.Equals(Config.OwnerUserId, admin.UserId, StringComparison.Ordinal))
        {
            return "Owner";
        }

        if (!Config.AdminUsers.Any(IsExplicitOwner)
            && string.IsNullOrWhiteSpace(Config.OwnerUserId)
            && Config.AdminUsers.Count > 0
            && string.Equals(Config.AdminUsers[0].UserId, admin.UserId, StringComparison.Ordinal))
        {
            return "Owner";
        }

        return NormalizeRole(admin.Role);
    }

    private static bool IsExplicitOwner(ShopAdminUser admin) =>
        string.Equals(NormalizeRole(admin.Role), "Owner", StringComparison.OrdinalIgnoreCase);

    private bool IsCurrentUser(ShopAdminUser admin) =>
        string.Equals(admin.UserId, CurrentUserId, StringComparison.Ordinal);

    private int OwnerCount =>
        Config.AdminUsers.Count(admin => string.Equals(EffectiveRole(admin), "Owner", StringComparison.OrdinalIgnoreCase));

    private bool CanRemoveAdmin(ShopAdminUser admin)
    {
        if (IsCurrentUser(admin)) return false;
        return !string.Equals(EffectiveRole(admin), "Owner", StringComparison.OrdinalIgnoreCase)
            || OwnerCount > 1;
    }

    private void ChangeAdminRole(ShopAdminUser admin, string role)
    {
        var nextRole = NormalizeRole(role);
        if (string.Equals(EffectiveRole(admin), "Owner", StringComparison.OrdinalIgnoreCase)
            && nextRole == "Admin"
            && OwnerCount <= 1)
        {
            _err = T("shopSettings.lastOwnerRoleError");
            return;
        }

        admin.Role = nextRole;
        _err = string.Empty;
    }

    private void RemoveAdmin(ShopAdminUser admin)
    {
        if (!CanRemoveAdmin(admin))
        {
            _err = T("shopSettings.removeOwnerError");
            return;
        }

        Config.AdminUsers.Remove(admin);
        _err = string.Empty;
    }

    private string T(string key) => ShopAdminText.Get(key, Localization.Language);
    private string RoleLabel(string role) => string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase)
        ? T("roles.owner")
        : T("roles.admin");
    private void OnLocalizationChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Localization.Changed -= OnLocalizationChanged;
}
