@using Microsoft.AspNetCore.WebUtilities
@inherits LayoutComponentBase
@implements IDisposable
@inject TenantContext Tenant
@inject ShopUserContext UserContext
@inject ShopLocalization Localization
@inject NavigationManager Nav

<DreaminePortalHeader BrandName="CodeMaru"
                      BrandUrl="@LocalizedUrl("https://codemaru.co.kr/")"
                      BrandImageUrl="/img/Codemaru_Bloom.jpg"
                      BrandLightImageUrl="/img/Codemaru%20Bloom%20Light.jpg"
                      BrandImageAlt=""
                      Items="@PortalItems"
                      ActiveKey="shop"
                      NavigationAriaLabel="@Localization["nav.services"]"
                      ToggleMenuLabel="@Localization["nav.toggle"]"
                      UseCodeMaruAppearance="true"
                      Fixed="true"
                      IsAuthenticated="@(hasLoadedCurrentUser && currentUser.IsAuthenticated)"
                      DisplayName="@NavUserLabel"
                      ScreenSettingsLabel="@Localization["screen.settings"]"
                      LoginUrl="@LoginUrl"
                      LoginLabel="@Localization["login"]"
                      AccountUrl="@AccountUrl"
                      AccountLabel="@Localization["account"]"
                      SignoutUrl="@SignoutUrl"
                      SignoutLabel="@Localization["logout"]">
    <Preferences>
        <ShopPreferences />
    </Preferences>
    <AdditionalUserActions>
        <a href="@LocalizedPath("/my-shops")"><span aria-hidden="true">▣</span> @Localization["my.shops"]</a>
        <a href="@LocalizedPath("/apply")"><span aria-hidden="true">＋</span> @Localization["open.shop"]</a>
    </AdditionalUserActions>
</DreaminePortalHeader>

<div id="main-content"
     class="shop-layout @(Tenant.IsResolved ? "tenant-active" : null)"
     tabindex="-1">
    @Body
</div>

@code {
    private ShopCurrentUser currentUser = ShopCurrentUser.Anonymous;
    private bool hasLoadedCurrentUser;

    private string LoginUrl => IdentityUrl("login", Nav.Uri);
    private string AccountUrl => IdentityUrl("account", Nav.Uri);
    private string SignoutUrl => IdentityUrl("signout", LocalizedUrl(Nav.BaseUri));
    private string NavUserLabel => string.IsNullOrWhiteSpace(currentUser.DisplayName)
        ? Localization["account"]
        : currentUser.DisplayName;

    private IReadOnlyList<DreaminePortalNavigationItem> PortalItems =>
    [
        new("home", Localization["home"], LocalizedUrl("https://codemaru.co.kr/")),
        new("dreamine", "Dreamine", "https://dreamine.kr/", OpenInNewWindow: true),
        new("cardhybrid", "CardHybrid", LocalizedUrl("https://codemaru.co.kr/cardhybrid")),
        new("wedding", "Wedding", LocalizedUrl("https://wedding.codemaru.co.kr")),
        new("thankyou", "ThankYou", LocalizedUrl("https://thankyou.codemaru.co.kr/")),
        new("families", "Families", LocalizedUrl("https://families.codemaru.co.kr")),
        new("portfolio", "Portfolio", LocalizedUrl("https://portfolio.codemaru.co.kr/")),
        new("cctv", "CCTV", LocalizedUrl("https://cctvviewer.codemaru.co.kr")),
        new("shop", "ShopStore", LocalizedPath("/")),
        new("contact", Localization["contact"], LocalizedUrl("https://codemaru.co.kr/contact"))
    ];

    protected override void OnInitialized()
    {
        Localization.Changed += HandleLanguageChanged;
        Nav.LocationChanged += HandleLocationChanged;
        ApplyLanguageFromLocation();
    }

    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserContext.GetCurrentAsync();
        hasLoadedCurrentUser = true;
    }

    private void ApplyLanguageFromLocation()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("lang", out var language))
        {
            Localization.SetLanguage(language.ToString());
        }
    }

    private string LocalizedPath(string path) => Localization.WithLanguage(path);
    private string LocalizedUrl(string url) => Localization.WithLanguage(url);

    private string IdentityUrl(string action, string returnUrl) =>
        Dreamine.Identity.DreamineIdentityPortal.CreateUrl(action, returnUrl, Localization.Language);

    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        ApplyLanguageFromLocation();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Localization.Changed -= HandleLanguageChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
