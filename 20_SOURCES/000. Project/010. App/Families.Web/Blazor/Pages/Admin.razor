@page "/{Slug}/admin"
@layout FamiliesApp.Blazor.Layout.FamilyLayout
@namespace FamiliesApp.Blazor.Pages
@rendermode InteractiveServer
@implements IDisposable

@inject FamilyAdminViewModel Vm
@inject NavigationManager Nav
@inject FamilyLocalization Text

<PageTitle>@Text["admin.user.title"] — @(Vm.Config?.FamilyName ?? Slug)</PageTitle>

<div class="fa-user-admin">
    <div class="fa-user-admin-preferences" aria-label="@Text["screen.settings"]">
        <FamilyPreferences />
    </div>

<main class="fa-page fa-admin">

    @if (!Vm.IsAuthenticatedFor(Slug))
    {
        <!-- Sign-in -->
        <div class="fa-login-box">
            <h1 class="fa-login-box__title">👨‍👩‍👧‍👦 @Slug</h1>
            @if (Vm.IsSignedIn)
            {
                <p class="fa-login-box__desc"><strong>@Text.Format("admin.user.shared.current", Vm.CurrentUserLabel)</strong></p>
                <p class="fa-login-box__desc">@Text["admin.user.link.account"]</p>
            }
            else
            {
                <p class="fa-login-box__desc">@Text["admin.user.login.first"]</p>
                <a class="fa-btn fa-btn--ghost fa-btn--full" href="@LoginUrl">@Text["common.login"]</a>
            }

            @if (!string.IsNullOrWhiteSpace(StatusText))
            {
                <p class="fa-status @(Vm.StatusIsError ? "fa-status--err" : "fa-status--ok")">@StatusText</p>
            }

            <input class="fa-input" type="password"
                   value="@Vm.LoginPassword"
                   @oninput="OnPasswordInput"
                   @onkeydown="OnLoginKey" placeholder="@Text["field.password"]" autocomplete="current-password" />
            <button class="fa-btn fa-btn--primary fa-btn--full" @onclick="OnLogin">@Text["login"]</button>
        </div>
    }
    else
    {
        <!-- Administrator tabs -->
        <div class="fa-admin-header">
            <h1>@(Vm.Config?.FamilyName ?? Slug) @Text["admin.user.heading"]</h1>
            <div class="fa-admin-header__actions">
                <button class="fa-btn fa-btn--ghost" @onclick="OnRefresh" aria-label="@Text["common.refresh"]">🔄</button>
                <a href="@AlbumUrl" class="fa-btn fa-btn--ghost">@Text["admin.user.open.album"] →</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(StatusText))
        {
            <p class="fa-status @(Vm.StatusIsError ? "fa-status--err" : "fa-status--ok")">
                @StatusText
            </p>
        }
        @if (Vm.IsSignedIn)
        {
            <p class="fa-status fa-status--ok">@Text.Format("admin.user.shared.current", Vm.CurrentUserLabel) · @(Vm.IsOwner ? Text["admin.role.owner"] : Text["admin.role.admin"])</p>
        }

        <div class="fa-tabs">
            <button class="fa-tab @(activeTab == "post" ? "fa-tab--active" : "")" disabled="@Vm.IsUploading" @onclick='() => SetTabAsync("post")'>✏️ @Text["admin.user.tab.write"]</button>
            <button class="fa-tab @(activeTab == "manage" ? "fa-tab--active" : "")" disabled="@Vm.IsUploading" @onclick='() => SetTabAsync("manage")'>📋 @Text["admin.user.tab.posts"]</button>
            <button class="fa-tab @(activeTab == "albums" ? "fa-tab--active" : "")" disabled="@Vm.IsUploading" @onclick='() => SetTabAsync("albums")'>📂 @Text["admin.user.tab.albums"]</button>
            <button class="fa-tab @(activeTab == "settings" ? "fa-tab--active" : "")" disabled="@Vm.IsUploading" @onclick='() => SetTabAsync("settings")'>⚙️ @Text["admin.user.tab.settings"]</button>
        </div>

        <!-- Write post -->
        @if (activeTab == "post")
        {
            var post = Vm.EditingPost;
            if (post is null)
            {
                <div class="fa-tab-body">
                    <button class="fa-btn fa-btn--primary" @onclick="Vm.NewPost">+ @Text["admin.user.post.new"]</button>
                </div>
            }
            else
            {
                <div class="fa-tab-body fa-post-editor">
                    <div class="fa-form__row">
                        <label class="fa-label">@Text["admin.user.post.title"]</label>
                        <input class="fa-input" @bind="post.Title" @bind:event="oninput"
                               placeholder="@Text["admin.user.post.title.placeholder"]" />
                    </div>

                    <div class="fa-form__row">
                        <label class="fa-label">@Text["admin.user.post.date"]</label>
                        <input class="fa-input" type="datetime-local"
                               value="@post.PostedAt.ToString("yyyy-MM-ddTHH:mm")"
                               @onchange="e => post.PostedAt = DateTime.Parse(e.Value?.ToString() ?? DateTime.Now.ToString())" />
                    </div>

                    <div class="fa-form__row">
                        <label class="fa-label">@Text["admin.user.post.album"]</label>
                        <select class="fa-input" @bind="post.AlbumId">
                            <option value="">-- @Text["admin.user.post.no_album"] --</option>
                            @foreach (var album in Vm.Albums)
                            {
                                <option value="@album.Id">@album.Name</option>
                            }
                        </select>
                    </div>

                    <div class="fa-form__row">
                        <label class="fa-label">
                            @Text["admin.user.post.content"]
                            <span class="fa-label__hint">@Text["admin.user.post.markdown"]</span>
                        </label>
                        <textarea class="fa-textarea fa-textarea--tall" @bind="post.Content"
                                  @bind:event="oninput"
                                  placeholder="@Text["admin.user.post.content.placeholder"]" rows="8"></textarea>
                    </div>

                    <div class="fa-form__row">
                        <label class="fa-label">@Text["admin.user.post.upload"]</label>
                        <DirectUploadInput Slug="@Slug"
                                           Purpose="FamilyUploadPurpose.PostMedia"
                                           PostSnapshot="@post"
                                           Multiple="true"
                                           MaxFiles="50"
                                           AuthorizedAdminSlug="@Vm.AuthorizedAdminSlug"
                                           OnUploadingChanged="OnDirectUploadingChanged"
                                           OnCompleted="OnMediaUploadCompleted" />
                        <div class="fa-video-url-row">
                            <span class="fa-video-url-row__label">@Text["admin.user.post.image_url"]</span>
                            <input class="fa-input fa-video-url-row__input" @bind="imageUrlInput"
                                   placeholder="@Text["admin.user.post.image_url.placeholder"]" />
                            <button class="fa-btn fa-btn--sm fa-btn--ghost" @onclick="OnAddImageUrl">+ @Text["common.add"]</button>
                        </div>
                        <div class="fa-video-url-row">
                            <span class="fa-video-url-row__label">@Text["admin.user.post.video_url"]</span>
                            <input class="fa-input fa-video-url-row__input" @bind="videoUrlInput"
                                   placeholder="@Text["admin.user.post.video_url.placeholder"]" />
                            <button class="fa-btn fa-btn--sm fa-btn--ghost" @onclick="OnAddVideoUrl">+ @Text["common.add"]</button>
                        </div>
                    </div>

                    <!-- Existing media -->
                    @if (post.PhotoFileNames.Count + post.VideoFileNames.Count > 0)
                    {
                        <div class="fa-form__row">
                            <label class="fa-label">@Text["admin.user.post.registered"]</label>
                            <div class="fa-media-grid fa-media-grid--admin">
                                @foreach (var fn in post.PhotoFileNames)
                                {
                                    var isExtImg = fn.StartsWith("http", StringComparison.OrdinalIgnoreCase);
                                    var imgSrc = isExtImg ? fn : Vm.GetThumbUrl(Slug, post.Id, fn);
                                    <div class="fa-media-item @(isExtImg ? "fa-media-item--exturl" : "")">
                                        <img src="@imgSrc" alt="" />
                                        @if (isExtImg)
                                        {
                                            <span class="fa-media-item__url-badge">🔗</span>
                                        }
                                        <button class="fa-media-item__del"
                                                @onclick="() => OnDeleteMedia(post.Id, fn)" aria-label="@Text["common.delete"]">✕</button>
                                    </div>
                                }
                                @foreach (var fn in post.VideoFileNames)
                                {
                                    var isExt = fn.StartsWith("http", StringComparison.OrdinalIgnoreCase);
                                    var vidSrc = isExt ? fn : Vm.GetMediaUrl(Slug, post.Id, fn);
                                    <div class="fa-media-item fa-media-item--video">
                                        @if (FamilyAdminViewModel.IsYouTube(fn))
                                        {
                                            <span style="font-size:11px">▶ YouTube</span>
                                            <span style="font-size:10px;word-break:break-all;opacity:.7">@fn</span>
                                        }
                                        else
                                        {
                                            <video src="@vidSrc" preload="metadata" controls></video>
                                        }
                                        <button class="fa-media-item__del"
                                                @onclick="() => OnDeleteMedia(post.Id, fn)" aria-label="@Text["common.delete"]">✕</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="fa-form__row fa-form__row--check">
                        <label>
                            <input type="checkbox" @bind="post.IsPinned" />
                            📌 @Text["admin.user.post.pinned"]
                        </label>
                    </div>
                    <div class="fa-form__row fa-form__row--check">
                        <label style="gap:12px">
                            @Text["admin.user.post.media_position"]
                            <label style="font-weight:normal;cursor:pointer">
                                <input type="radio" name="mediaPos_@post.Id"
                                       checked="@(post.MediaPosition == MediaPosition.Top)"
                                       @onchange="() => post.MediaPosition = MediaPosition.Top" />
                                📷 @Text["admin.user.post.top"]
                            </label>
                            <label style="font-weight:normal;cursor:pointer">
                                <input type="radio" name="mediaPos_@post.Id"
                                       checked="@(post.MediaPosition == MediaPosition.Bottom)"
                                       @onchange="() => post.MediaPosition = MediaPosition.Bottom" />
                                📷 @Text["admin.user.post.bottom"]
                            </label>
                        </label>
                    </div>

                    <div class="fa-form__actions">
                        <button class="fa-btn fa-btn--primary" @onclick="OnSavePost" disabled="@Vm.IsUploading">
                            @(Vm.IsUploading ? Text["common.uploading"] : Text["common.save"])
                        </button>
                        <button class="fa-btn fa-btn--ghost" @onclick="OnCancelEdit" disabled="@Vm.IsUploading">@Text["common.cancel"]</button>
                    </div>
                </div>
            }
        }

        <!-- Manage posts -->
        @if (activeTab == "manage")
        {
            var adminPageSize = Vm.Config?.PageSize ?? 20;
            var managePaged = Vm.Posts.Skip((managePage - 1) * adminPageSize).Take(adminPageSize).ToList();
            var manageTotalPages = (int)Math.Ceiling((double)Vm.Posts.Count / adminPageSize);

            <div class="fa-tab-body">
                @if (Vm.Posts.Count == 0)
                {
                    <p class="fa-empty">@Text["admin.user.post.empty"]</p>
                }
                else
                {
                    <div class="fa-list-summary">
                        @Text.Format("admin.user.post.summary", Vm.Posts.Count, managePage, manageTotalPages)
                    </div>
                    <div class="fa-post-list">
                        @foreach (var post in managePaged)
                        {
                            <div class="fa-post-list__item">
                                <div class="fa-post-list__info">
                                    @if (post.IsPinned) { <span class="fa-pin-badge">📌</span> }
                                    <span class="fa-post-list__title">@post.Title</span>
                                    <span class="fa-post-list__date">@FormatDate(post.PostedAt)</span>
                                    <span class="fa-post-list__count">📷@post.PhotoFileNames.Count 🎬@post.VideoFileNames.Count</span>
                                </div>
                                <div class="fa-post-list__actions">
                                    <button class="fa-btn fa-btn--sm fa-btn--ghost"
                                            @onclick="() => OnEditPost(post)">@Text["common.edit"]</button>
                                    <button class="fa-btn fa-btn--sm fa-btn--danger"
                                            @onclick="() => OnDeletePost(post.Id)">@Text["common.delete"]</button>
                                </div>
                            </div>
                        }
                    </div>
                    @if (manageTotalPages > 1)
                    {
                        <nav class="fa-pager" aria-label="@Text["admin.user.post.pager"]">
                            <button class="fa-pager__btn" disabled="@(managePage <= 1)"
                                    @onclick="() => managePage--">‹ @Text["common.previous"]</button>
                            @for (int p = Math.Max(1, managePage - 2); p <= Math.Min(manageTotalPages, managePage + 2); p++)
                            {
                                var pg = p;
                                <button class="fa-pager__btn @(pg == managePage ? "fa-pager__btn--active" : "")"
                                        @onclick="() => managePage = pg">@pg</button>
                            }
                            <button class="fa-pager__btn" disabled="@(managePage >= manageTotalPages)"
                                    @onclick="() => managePage++">@Text["common.next"] ›</button>
                        </nav>
                    }
                }
            </div>
        }

        <!-- Manage albums -->
        @if (activeTab == "albums")
        {
            const int albumPageSize = 20;
            var albumPaged = Vm.Albums.Skip((albumPage - 1) * albumPageSize).Take(albumPageSize).ToList();
            var albumTotalPages = (int)Math.Ceiling((double)Vm.Albums.Count / albumPageSize);

            <div class="fa-tab-body">
                <div class="fa-form">
                    <div class="fa-form__row fa-form__row--inline">
                        <input class="fa-input" @bind="Vm.NewAlbumName" placeholder="@Text["admin.user.album.name.placeholder"]" />
                        <input class="fa-input" @bind="Vm.NewAlbumDesc" placeholder="@Text["admin.user.album.description.placeholder"]" />
                        <button class="fa-btn fa-btn--primary" @onclick="OnAddAlbum">+ @Text["admin.user.album.add"]</button>
                    </div>
                </div>

                @if (Vm.Albums.Count > 0)
                {
                    <div class="fa-album-admin-list">
                        @foreach (var album in albumPaged)
                        {
                            <div class="fa-album-admin-item">
                                <span class="fa-album-admin-item__name">📁 @album.Name</span>
                                @if (!string.IsNullOrWhiteSpace(album.Description))
                                {
                                    <span class="fa-album-admin-item__desc">@album.Description</span>
                                }
                                <button class="fa-btn fa-btn--sm fa-btn--danger"
                                        @onclick="() => OnDeleteAlbum(album.Id)">@Text["common.delete"]</button>
                            </div>
                        }
                    </div>
                    @if (albumTotalPages > 1)
                    {
                        <nav class="fa-pager" aria-label="@Text["admin.user.album.pager"]">
                            <button class="fa-pager__btn" disabled="@(albumPage <= 1)"
                                    @onclick="() => albumPage--">‹ @Text["common.previous"]</button>
                            @for (int p = Math.Max(1, albumPage - 2); p <= Math.Min(albumTotalPages, albumPage + 2); p++)
                            {
                                var pg = p;
                                <button class="fa-pager__btn @(pg == albumPage ? "fa-pager__btn--active" : "")"
                                        @onclick="() => albumPage = pg">@pg</button>
                            }
                            <button class="fa-pager__btn" disabled="@(albumPage >= albumTotalPages)"
                                    @onclick="() => albumPage++">@Text["common.next"] ›</button>
                        </nav>
                    }
                }
                else
                {
                    <p class="fa-empty">@Text["admin.user.album.empty"]</p>
                }
            </div>
        }

        <!-- Settings -->
        @if (activeTab == "settings" && Vm.Config is not null)
        {
            var cfg = Vm.Config;
            <div class="fa-tab-body fa-settings">
                <div class="fa-form__row">
                    <label class="fa-label">@Text["admin.user.settings.family"]</label>
                    <input class="fa-input" @bind="cfg.FamilyName" />
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">@Text["admin.user.settings.bio"]</label>
                    <textarea class="fa-textarea" @bind="cfg.Bio" rows="3" placeholder="@Text["admin.user.settings.bio.placeholder"]"></textarea>
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">@Text["admin.user.settings.theme"]</label>
                    <select class="fa-input" @bind="cfg.ThemeName">
                        <option value="warm">🍊 @Text["theme.warm"]</option>
                        <option value="mint">🌿 @Text["theme.mint"]</option>
                        <option value="lavender">💜 @Text["theme.lavender"]</option>
                        <option value="sky">🩵 @Text["theme.sky"]</option>
                        <option value="peach">🍑 @Text["theme.peach"]</option>
                    </select>
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">@Text["admin.user.settings.cover"]</label>
                    <DirectUploadInput Slug="@Slug"
                                       Purpose="FamilyUploadPurpose.Cover"
                                       Accept="image/*,.heic,.heif,.avif"
                                       AuthorizedAdminSlug="@Vm.AuthorizedAdminSlug"
                                       OnUploadingChanged="OnDirectUploadingChanged"
                                       OnCompleted="OnCoverUploadCompleted" />
                    @if (!string.IsNullOrWhiteSpace(cfg.CoverImageFileName))
                    {
                        <img class="fa-cover-preview"
                             src="@Vm.GetCoverUrl(Slug, cfg.CoverImageFileName)" alt="@Text["admin.user.settings.cover.alt"]" />
                    }
                </div>

                <div class="fa-form__row fa-form__row--check">
                    <label>
                        <input type="checkbox" @bind="cfg.AllowReactions" />
                        ❤️ @Text["admin.user.settings.allow_reactions"]
                    </label>
                </div>

                <div class="fa-form__row fa-form__row--check">
                    <label>
                        <input type="checkbox" @bind="cfg.AllowComments" />
                        💬 @Text["admin.user.settings.allow_comments"]
                    </label>
                </div>

                <div class="fa-form__row fa-form__row--check">
                    <label>
                        <input type="checkbox" @bind="cfg.ShowOnHome" />
                        🏠 @Text["admin.user.settings.show_home"]
                    </label>
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">
                        @Text["admin.user.settings.page_size"]
                        <span class="fa-label__hint">@Text["admin.user.settings.page_size.hint"]</span>
                    </label>
                    <select class="fa-input" style="max-width:160px"
                            value="@cfg.PageSize"
                            @onchange="OnPageSizeChanged">
                        <option value="5">@Text.Format("common.count", 5)</option>
                        <option value="10">@Text.Format("common.count", 10)</option>
                        <option value="20">@Text.Format("admin.user.settings.page_size.default", 20)</option>
                        <option value="30">@Text.Format("common.count", 30)</option>
                        <option value="50">@Text.Format("common.count", 50)</option>
                        <option value="100">@Text.Format("common.count", 100)</option>
                    </select>
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">@Text["admin.user.settings.og_title"]</label>
                    <input class="fa-input" @bind="cfg.OgTitle" placeholder="@Text["admin.user.settings.og_title.placeholder"]" />
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">@Text["admin.user.settings.og_description"]</label>
                    <input class="fa-input" @bind="cfg.OgDescription" />
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">@Text["admin.user.settings.og_image"]</label>
                    @if (!string.IsNullOrWhiteSpace(cfg.OgImageFileName))
                    {
                        <div class="fa-og-preview">
                            <img src="@OgPreviewUrl" alt="@Text["admin.user.settings.og_image.alt"]" />
                            <button class="fa-btn fa-btn--sm fa-btn--ghost"
                                    @onclick="() => cfg.OgImageFileName = string.Empty">✕ @Text["common.delete"]</button>
                        </div>
                    }
                    <DirectUploadInput Slug="@Slug"
                                       Purpose="FamilyUploadPurpose.OgImage"
                                       Accept="image/jpeg,image/png,image/webp"
                                       AuthorizedAdminSlug="@Vm.AuthorizedAdminSlug"
                                       OnUploadingChanged="OnDirectUploadingChanged"
                                       OnCompleted="OnOgImageUploadCompleted" />
                    <span class="fa-label__hint">@Text["admin.user.settings.og_image.hint"]</span>
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">@Text["admin.user.settings.admin_password"]</label>
                    <input class="fa-input" type="password" @bind="Vm.NewAdminPassword"
                           @bind:event="oninput"
                           placeholder="@Text["admin.user.settings.admin_password.placeholder"]" autocomplete="new-password" />
                    <span class="fa-label__hint">@Text["admin.user.settings.admin_password.hint"]</span>
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">@Text["admin.user.settings.viewer_password"]</label>
                    <input class="fa-input" type="password" @bind="Vm.NewViewerPassword"
                           @bind:event="oninput"
                           placeholder="@Text["admin.user.settings.viewer_password.placeholder"]" autocomplete="new-password" />
                    <span class="fa-label__hint">@Text["admin.user.settings.viewer_password.hint"]</span>
                    @if (Vm.Config is not null && FamilyAccessService.UsesLegacyAdminPassword(Vm.Config))
                    {
                        <span class="fa-access-lock__warning">@Text["access.legacy_warning"]</span>
                    }
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">@Text["admin.user.settings.admins"]</label>
                    <div class="fa-album-admin-list">
                        @foreach (var admin in Vm.EffectiveAdminUsers)
                        {
                            var isOwner = string.Equals(admin.Role, "Owner", StringComparison.OrdinalIgnoreCase);
                            <div class="fa-album-admin-item">
                                <span class="fa-album-admin-item__name">
                                    @(isOwner ? "👑" : "👤")
                                    @(string.IsNullOrWhiteSpace(admin.DisplayName) ? admin.Provider : admin.DisplayName)
                                </span>
                                <span class="fa-album-admin-item__desc">
                                    @(isOwner ? Text["admin.role.owner"] : Text["admin.role.admin"])
                                    @if (!string.IsNullOrWhiteSpace(admin.Provider))
                                    {
                                        <span> · @admin.Provider</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(admin.Email))
                                    {
                                        <span> · @admin.Email</span>
                                    }
                                </span>
                                @if (Vm.IsOwner && !isOwner)
                                {
                                    <button class="fa-btn fa-btn--sm fa-btn--danger"
                                            @onclick="() => OnRemoveAdmin(admin.UserId)">@Text["common.delete"]</button>
                                }
                            </div>
                        }
                    </div>
                    <span class="fa-label__hint">@Text["admin.user.settings.admins.link.hint"]</span>
                </div>

                <button class="fa-btn fa-btn--primary" @onclick="OnSaveConfig" disabled="@Vm.IsUploading">
                    @(Vm.IsUploading ? Text["common.uploading"] : $"💾 {Text["admin.user.settings.save"]}")
                </button>

                <hr class="fa-divider" />

                <div class="fa-danger-zone">
                    <h3>⚠️ @Text["admin.user.settings.danger"]</h3>
                    <p>@Text["admin.user.settings.danger.desc"]</p>
                    @if (!confirmDelete)
                    {
                        <button class="fa-btn fa-btn--danger" @onclick="() => confirmDelete = true">
                            🗑 @Text["admin.user.settings.delete_album"]
                        </button>
                    }
                    else
                    {
                        <div class="fa-delete-confirm">
                            <p><strong>@Text.Format("admin.user.settings.delete_confirm", Slug)</strong><br/>@Text["admin.user.settings.delete_contents"]</p>
                            <div class="fa-form__actions">
                                <button class="fa-btn fa-btn--danger" @onclick="OnDeleteSelf">@Text["admin.user.settings.confirm_delete"]</button>
                                <button class="fa-btn fa-btn--ghost" @onclick="() => confirmDelete = false">@Text["common.cancel"]</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</main>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private string activeTab = "post";
    private bool confirmDelete = false;
    private string videoUrlInput = "";
    private string imageUrlInput = "";
    private int managePage = 1;
    private int albumPage = 1;

    private string StatusText => string.IsNullOrWhiteSpace(Vm.StatusKey)
        ? string.Empty
        : Text.Format(Vm.StatusKey, Vm.StatusArguments);

    private string AlbumUrl => $"/{Uri.EscapeDataString(Slug)}?lang={Uri.EscapeDataString(Text.Language)}";
    private string LoginUrl => $"https://codemaru.co.kr/_identity/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}&lang={Uri.EscapeDataString(Text.Language)}";
    private string FormatDate(DateTime value) => value.ToString("d", System.Globalization.CultureInfo.GetCultureInfo(Text.HtmlLanguage));
    private string OgPreviewUrl => $"/og/families/{Uri.EscapeDataString(Slug)}?v={Uri.EscapeDataString(Vm.Config?.OgImageFileName ?? string.Empty)}";

    protected override void OnInitialized() => Text.Changed += OnLanguageChanged;

    protected override async Task OnParametersSetAsync()
    {
        await Vm.InitializeAsync(Slug);
    }

    private void OnPasswordInput(ChangeEventArgs e) => Vm.LoginPassword = e.Value?.ToString() ?? string.Empty;

    private async Task OnRefresh() => await Vm.LoadAsync(Slug);

    private async Task OnLogin()
    {
        var ok = await Vm.LoginAsync(Slug);
        if (ok)
            await Vm.LoadAsync(Slug);
    }

    private async Task OnLoginKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnLogin();
    }

    private async Task SetTabAsync(string tab)
    {
        if (Vm.IsUploading)
            return;

        activeTab = tab;
        managePage = 1;
        albumPage = 1;
        if (tab != "post") await Vm.CancelEditAsync(Slug);
    }

    private async Task OnCancelEdit()
    {
        if (!Vm.IsUploading)
            await Vm.CancelEditAsync(Slug);
    }

    private Task OnMediaUploadCompleted(IReadOnlyList<FamilyUploadResult> results)
    {
        Vm.ApplyDirectUploads(Slug, results);
        return Task.CompletedTask;
    }

    private Task OnDirectUploadingChanged(bool isUploading)
    {
        Vm.SetDirectUploadState(isUploading);
        return Task.CompletedTask;
    }

    private async Task OnSavePost()
    {
        await Vm.SavePostAsync(Slug);
        if (Vm.EditingPost is null)
            activeTab = "manage";
    }

    private void OnEditPost(PostEntry post)
    {
        Vm.EditPost(post);
        activeTab = "post";
    }

    private async Task OnDeletePost(string postId)
    {
        await Vm.DeletePostAsync(Slug, postId);
    }

    private async Task OnRemoveAdmin(string userId)
    {
        await Vm.RemoveAdminAsync(userId);
    }

    private void OnAddImageUrl()
    {
        if (string.IsNullOrWhiteSpace(imageUrlInput) || Vm.EditingPost is null) return;
        var url = imageUrlInput.Trim();
        if (!Vm.EditingPost.PhotoFileNames.Contains(url))
            Vm.EditingPost.PhotoFileNames.Add(url);
        imageUrlInput = "";
    }

    private void OnAddVideoUrl()
    {
        if (string.IsNullOrWhiteSpace(videoUrlInput) || Vm.EditingPost is null) return;
        var url = videoUrlInput.Trim();
        if (!Vm.EditingPost.VideoFileNames.Contains(url))
            Vm.EditingPost.VideoFileNames.Add(url);
        videoUrlInput = "";
    }

    private async Task OnDeleteMedia(string postId, string fileName)
    {
        await Vm.DeletePostMediaAsync(Slug, postId, fileName);
    }

    private async Task OnAddAlbum()
    {
        await Vm.AddAlbumAsync(Slug);
    }

    private async Task OnDeleteAlbum(string albumId)
    {
        await Vm.DeleteAlbumAsync(Slug, albumId);
    }

    private async Task OnCoverUploadCompleted(IReadOnlyList<FamilyUploadResult> results)
    {
        if (results.Count > 0)
        {
            await Vm.ApplyDirectCoverUploadAsync(Slug, results[^1]);
        }
    }

    private async Task OnOgImageUploadCompleted(IReadOnlyList<FamilyUploadResult> results)
    {
        if (results.Count > 0)
        {
            await Vm.ApplyDirectOgImageUploadAsync(Slug, results[^1]);
        }
    }

    private async Task OnSaveConfig()
    {
        await Vm.SaveConfigAsync();
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (Vm.Config is null) return;
        if (int.TryParse(e.Value?.ToString(), out var v))
            Vm.Config.PageSize = v;
    }

    private async Task OnDeleteSelf()
    {
        await Vm.DeleteSelfAsync(Slug);
        Nav.NavigateTo("/");
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Text.Changed -= OnLanguageChanged;
}
