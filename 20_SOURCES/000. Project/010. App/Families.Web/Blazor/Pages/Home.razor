@page "/"
@layout FamiliesApp.Blazor.Layout.FamilyLayout
@namespace FamiliesApp.Blazor.Pages
@rendermode InteractiveServer
@implements IDisposable

@inject FamilyHomeViewModel Vm
@inject FamilyUserContext UserContext
@inject NavigationManager Nav
@inject FamilyLocalization Text
@using Dreamine.UI.Blazor.Navigation

<PageTitle>@Text["page.title"]</PageTitle>

<HeadContent>
    <meta name="description" content="@Text["seo.description"]" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@Nav.Uri" />
    <meta property="og:title" content="@Text["page.title"]" />
    <meta property="og:description" content="@Text["seo.description"]" />
    <meta property="og:image" content="@(Nav.BaseUri.TrimEnd('/') + "/img/og-platform.png")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
</HeadContent>

<div class="fa-portal-page">
    <DreaminePortalHeader BrandName="CodeMaru"
                          BrandUrl="@CodeMaruHomeUrl"
                          BrandImageUrl="/img/Codemaru_Bloom.jpg"
                          BrandLightImageUrl="/img/Codemaru%20Bloom%20Light.jpg"
                          Items="@PortalItems"
                          ActiveKey="families"
                          NavigationAriaLabel="@Text["nav.services"]"
                          ToggleMenuLabel="@Text["nav.toggle"]"
                          UseCodeMaruAppearance="true"
                          Fixed="true"
                          IsAuthenticated="@currentUser.IsAuthenticated"
                          DisplayName="@NavUserLabel"
                          ScreenSettingsLabel="@Text["screen.settings"]"
                          LoginUrl="@LoginUrl"
                          LoginLabel="@Text["login"]"
                          AccountUrl="@AccountUrl"
                          AccountLabel="@Text["account"]"
                          SignoutUrl="@SignoutUrl"
                          SignoutLabel="@Text["logout"]">
        <Preferences>
            <FamilyPreferences />
        </Preferences>
        <AdditionalUserActions>
            <a href="#my-families"><span aria-hidden="true">▣</span> @Text["manage.mine"]</a>
        </AdditionalUserActions>
    </DreaminePortalHeader>

    <main class="fa-page" id="main-content" tabindex="-1">

    <!-- ── 히어로 배너 ── -->
    <section class="fa-hero">
        <div class="fa-hero__inner">
            <p class="fa-hero__badge">@Text["hero.badge"]</p>
            <h1 class="fa-hero__title">@Text["hero.title"]</h1>
            <p class="fa-hero__sub">@Text["hero.sub"]</p>
            <div class="fa-hero__actions">
                <a href="#create" class="fa-btn fa-btn--primary">@Text["create.now"]</a>
                <a href="@CodeMaruHomeUrl" class="fa-btn fa-btn--secondary">@Text["codemaru.home"]</a>
                @if (currentUser.IsAuthenticated)
                {
                    <a href="#my-families" class="fa-btn fa-btn--secondary">@Text["manage.mine"]</a>
                }
                else if (hasLoadedCurrentUser)
                {
                    <a href="@LoginUrl" class="fa-btn fa-btn--secondary">@Text["login"]</a>
                }
            </div>
        </div>
    </section>

    <!-- ── 서비스 안내 ── -->
    <div class="fa-service-notice">
        <span>@Text["service.notice"] <a href="mailto:admin@codemaru.co.kr">admin@codemaru.co.kr</a></span>
        <span class="fa-notice-sep">·</span>
        <span>@Text["service.cleanup"]</span>
    </div>

    <!-- ── 기능 소개 ── -->
    <section class="fa-features">
        <div class="fa-feature">
            <span class="fa-feature__icon">📸</span>
            <h3>@Text["features.media"]</h3>
            <p>@Text["features.media.desc"]</p>
        </div>
        <div class="fa-feature">
            <span class="fa-feature__icon">📖</span>
            <h3>@Text["features.story"]</h3>
            <p>@Text["features.story.desc"]</p>
        </div>
        <div class="fa-feature">
            <span class="fa-feature__icon">🗂</span>
            <h3>@Text["features.albums"]</h3>
            <p>@Text["features.albums.desc"]</p>
        </div>
        <div class="fa-feature">
            <span class="fa-feature__icon">❤️</span>
            <h3>@Text["features.reactions"]</h3>
            <p>@Text["features.reactions.desc"]</p>
        </div>
        <div class="fa-feature">
            <span class="fa-feature__icon">🔒</span>
            <h3>@Text["features.privacy"]</h3>
            <p>@Text["features.privacy.desc"]</p>
        </div>
        <div class="fa-feature">
            <span class="fa-feature__icon">🎨</span>
            <h3>@Text["features.themes"]</h3>
            <p>@Text["features.themes.desc"]</p>
        </div>
    </section>

    <!-- ── 가입 폼 ── -->
    <section class="fa-create" id="create">
        <div class="fa-create__box">
            @if (currentUser.IsAuthenticated)
            {
                <div class="fa-account">
                    <span>@Text["common.login"]</span>
                    <strong>@CurrentUserLabel</strong>
                    <a href="@AccountUrl" class="fa-account__link">@Text["account"]</a>
                    <a href="@SignoutUrl" class="fa-account__link">@Text["logout"]</a>
                </div>
            }
            else if (hasLoadedCurrentUser)
            {
                <div class="fa-account fa-account--guest">
                    <span>@Text["guest.account"]</span>
                    <a href="@LoginUrl" class="fa-account__link">@Text["common.login"]</a>
                </div>
            }

            <h2 class="fa-create__title">@Text["start.title"]</h2>
            <p class="fa-create__desc">@Text["start.desc"]</p>

            @if (Vm.HasStatus)
            {
                <p class="fa-status @(Vm.StatusIsSuccess ? "fa-status--ok" : "fa-status--err")">
                    @Text.Format(Vm.StatusKey, Vm.StatusArguments)
                </p>
            }

            <div class="fa-form">
                <div class="fa-form__row">
                    <label class="fa-label">
                        @Text["field.slug"]
                        <span class="fa-label__hint">@Text["field.slug.hint"]</span>
                    </label>
                    <div class="fa-input-prefix">
                        <span class="fa-prefix">@Nav.BaseUri</span>
                        <input class="fa-input" @bind="Vm.NewSlug" placeholder="kim-family"
                               @oninput="OnSlugInput" spellcheck="false" autocomplete="off" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(slugPreview))
                    {
                        <p class="fa-slug-preview">👉 @slugPreview</p>
                    }
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">
                        @Text["field.viewer.password"]
                        <span class="fa-label__hint">@Text["field.viewer.password.hint"]</span>
                    </label>
                    <input class="fa-input" type="password" @bind="Vm.NewViewerPassword"
                           placeholder="@Text["field.password.placeholder"]" autocomplete="new-password" />
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">@Text["field.family"]</label>
                    <input class="fa-input" @bind="Vm.NewFamilyName" placeholder="@Text["field.family.placeholder"]" />
                </div>

                <div class="fa-form__row">
                    <label class="fa-label">
                        @Text["field.password"]
                        <span class="fa-label__hint">@Text["field.password.hint"]</span>
                    </label>
                    <input class="fa-input" type="password" @bind="Vm.NewPassword"
                           placeholder="@Text["field.password.placeholder"]" autocomplete="new-password" />
                </div>

                <button class="fa-btn fa-btn--primary fa-btn--full"
                        @onclick="OnCreate" disabled="@isCreating">
                    @(isCreating ? Text["creating"] : Text["create.button"])
                </button>
            </div>

            <p class="fa-create__notice">
                @Text["create.notice"]
            </p>
        </div>
    </section>

    @if (myAlbums.Count > 0)
    {
        <section class="fa-albums-list" id="my-families">
            <h2 class="fa-albums-list__title">@Text["my.albums"]</h2>
            <div class="fa-albums-list__grid">
                @foreach (var t in myAlbums)
                {
                    var imgUrl = !string.IsNullOrWhiteSpace(t.CoverImageFileName)
                        ? $"/family-data/{t.Slug}/{Uri.EscapeDataString(t.CoverImageFileName)}"
                        : null;

                    <a href="/@t.Slug/admin" class="fa-album-card">
                        <div class="fa-album-card__thumb"
                             style="@(imgUrl != null ? $"background-image:url('{imgUrl}')" : "")">
                            @if (imgUrl == null)
                            {
                                <span class="fa-album-card__no-img">👨‍👩‍👧‍👦</span>
                            }
                        </div>
                        <div class="fa-album-card__body">
                            <div class="fa-album-card__name">@t.FamilyName</div>
                            <div class="fa-album-card__bio">@Text["manage.open"]</div>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- ── 공개 앨범 목록 ── -->
    @if (publicAlbums.Count > 0)
    {
        <section class="fa-albums-list">
            <h2 class="fa-albums-list__title">@Text["public.albums"]</h2>
            <div class="fa-albums-list__grid">
                @foreach (var t in publicAlbums)
                {
                    var imgUrl = !string.IsNullOrWhiteSpace(t.CoverImageFileName)
                        ? $"/family-data/{t.Slug}/{Uri.EscapeDataString(t.CoverImageFileName)}"
                        : null;

                    <a href="/@t.Slug" class="fa-album-card">
                        <div class="fa-album-card__thumb"
                             style="@(imgUrl != null ? $"background-image:url('{imgUrl}')" : "")">
                            @if (imgUrl == null)
                            {
                                <span class="fa-album-card__no-img">👨‍👩‍👧‍👦</span>
                            }
                        </div>
                        <div class="fa-album-card__body">
                            <div class="fa-album-card__name">@t.FamilyName</div>
                            @if (!string.IsNullOrWhiteSpace(t.Bio))
                            {
                                <div class="fa-album-card__bio">@t.Bio</div>
                            }
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- ── 하단 ── -->
    <footer class="fa-footer">
        <p>@Text["footer.powered"] · <a href="mailto:admin@codemaru.co.kr" class="fa-footer__contact">admin@codemaru.co.kr</a></p>
        <a href="/admin" class="fa-admin-link">@Text["admin"]</a>
    </footer>
    </main>
</div>

@code {
    private bool isCreating;
    private string slugPreview = "";
    private List<FamilyConfig> publicAlbums = [];
    private List<FamilyConfig> myAlbums = [];
    private FamilyCurrentUser currentUser = FamilyCurrentUser.Anonymous;
    private bool hasLoadedCurrentUser;

    private string LoginUrl => IdentityUrl("login");
    private string AccountUrl => IdentityUrl("account");
    private string SignoutUrl => IdentityUrl("signout");
    private string NavUserLabel => string.IsNullOrWhiteSpace(currentUser.DisplayName) ? Text["account"] : currentUser.DisplayName;
    private string CurrentUserLabel => string.IsNullOrWhiteSpace(currentUser.DisplayName)
        ? currentUser.Provider
        : $"{currentUser.DisplayName} ({currentUser.Provider})";
    private string CodeMaruHomeUrl => LocalizedUrl("https://codemaru.co.kr");
    private IReadOnlyList<DreaminePortalNavigationItem> PortalItems =>
    [
        new("home", Text["home"], CodeMaruHomeUrl),
        new("dreamine", "Dreamine", "https://dreamine.kr/", OpenInNewWindow: true),
        new("cardhybrid", "CardHybrid", LocalizedUrl("https://codemaru.co.kr/cardhybrid")),
        new("wedding", "Wedding", LocalizedUrl("https://wedding.codemaru.co.kr")),
        new("thankyou", "ThankYou", LocalizedUrl("https://thankyou.codemaru.co.kr/")),
        new("families", "Families", LocalizedUrl("https://families.codemaru.co.kr")),
        new("portfolio", "Portfolio", LocalizedUrl("https://portfolio.codemaru.co.kr/")),
        new("cctv", "CCTV", LocalizedUrl("https://cctvviewer.codemaru.co.kr")),
        new("shop", "ShopStore", LocalizedUrl("https://shop.codemaru.co.kr/")),
        new("contact", Text["contact"], LocalizedUrl("https://codemaru.co.kr/contact"))
    ];

    private string LocalizedUrl(string url)
    {
        char separator = url.Contains('?') ? '&' : '?';
        return $"{url}{separator}lang={Uri.EscapeDataString(Text.Language)}";
    }

    private string IdentityUrl(string action)
    {
        Uri current = Nav.ToAbsoluteUri(Nav.Uri);
        return $"/_identity/{action}?lang={Uri.EscapeDataString(Text.Language)}&returnUrl={Uri.EscapeDataString(current.PathAndQuery)}";
    }

    protected override void OnInitialized()
    {
        Text.Changed += OnTextChanged;
        Vm.NewSlug = "";
        Vm.NewFamilyName = "";
        Vm.NewPassword = "";
        Vm.NewViewerPassword = "";
    }

    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserContext.GetCurrentAsync();
        hasLoadedCurrentUser = true;
        await Vm.LoadAsync();
        publicAlbums = Vm.Tenants
            .Where(t => t.ShowOnHome)
            .OrderBy(t => t.PinOrder == 0 ? int.MaxValue : t.PinOrder)
            .ThenByDescending(t => t.CreatedAt)
            .ToList();
        myAlbums = currentUser.IsAuthenticated
            ? Vm.Tenants
                .Where(t => IsMyAlbum(t))
                .OrderByDescending(t => t.CreatedAt)
                .ToList()
            : [];
    }

    private void OnSlugInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var clean = new string(raw.ToLowerInvariant()
            .Select(c => char.IsLetterOrDigit(c) || c == '-' ? c : '-').ToArray())
            .Trim('-');
        Vm.NewSlug = clean;
        slugPreview = string.IsNullOrWhiteSpace(clean) ? "" : $"{Nav.BaseUri}{clean}";
    }

    private async Task OnCreate()
    {
        isCreating = true;
        StateHasChanged();
        try
        {
            var slug = Vm.NewSlug.Trim().ToLowerInvariant();
            var ok = await Vm.CreateTenantAsync(currentUser);
            if (ok)
            {
                await Task.Delay(1200);
                Nav.NavigateTo($"/{slug}/admin");
            }
        }
        finally { isCreating = false; }
    }

    private bool IsMyAlbum(FamilyConfig config) =>
        string.Equals(config.OwnerUserId, currentUser.Id, StringComparison.Ordinal)
        || config.AdminUsers.Any(x => string.Equals(x.UserId, currentUser.Id, StringComparison.Ordinal));

    private void OnTextChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Text.Changed -= OnTextChanged;
}
