    private IEnumerable<DamagePopup> VisibleDamagePopups(string targetUnitId)
    {
        var matching = damagePopups.Where(item => item.TargetUnitId == targetUnitId).ToArray();
        if (!gameSettings.Combat.AggregateDamage || matching.Length <= 1) return matching;
        return
        [
            new DamagePopup(
                matching.Max(item => item.Id),
                matching.Aggregate(0L, (total, item) => GameRules.SaturatingAdd(total, item.Damage)),
                matching.Any(item => item.IsCritical),
                targetUnitId)
        ];
    }
