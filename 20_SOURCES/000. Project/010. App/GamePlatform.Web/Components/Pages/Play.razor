    private static string FormatNumber(long value) => value.ToString("N0");
    private static string FormatCompact(long value) => value switch { >= 1_000_000_000 => $"{value / 1_000_000_000d:0.#}B", >= 1_000_000 => $"{value / 1_000_000d:0.#}M", >= 10_000 => $"{value / 1_000d:0.#}K", _ => value.ToString("N0") };
    private static string FormatBoostDuration(TimeSpan duration) => duration.TotalHours >= 1 ? $"{duration.TotalHours:0}시간" : $"{duration.TotalMinutes:0}분";
    private static string FormatOfflineDuration(TimeSpan duration) => duration.TotalHours >= 1 ? $"{(int)duration.TotalHours}시간 {duration.Minutes}분" : $"{Math.Max(0, (int)duration.TotalMinutes)}분";
    private static string FormatBoostExpiry(DateTime? expiresUtc) => expiresUtc is null ? "종료" : $"{expiresUtc.Value.ToLocalTime():HH:mm}까지";
    private static double CodexProgress(CodexEntry entry) => entry.TotalStages <= 0 ? 0d : Math.Clamp((double)entry.ClearedStages / entry.TotalStages * 100d, 0d, 100d);
    private static string EquipmentName(string type, int level) => level >= 10 ? $"천명 {type}" : level >= 5 ? $"청운 {type}" : $"수련 {type}";
    private static string EquipmentSlotName(CompanionEquipmentSlot slot) => slot switch { CompanionEquipmentSlot.Weapon => "무기", CompanionEquipmentSlot.Armor => "방어구", _ => "옥패" };
    private static string WeaponTypeName(CompanionWeaponType type) => type switch { CompanionWeaponType.Sword => "검", CompanionWeaponType.Spear => "창", CompanionWeaponType.Bow => "활", CompanionWeaponType.Staff => "지팡이", CompanionWeaponType.Mace => "철퇴", CompanionWeaponType.Dagger => "쌍단도", _ => "전용 무기" };
    private static string EquipmentTypeName(CompanionEquipmentDefinition definition) => definition.Slot == CompanionEquipmentSlot.Weapon && definition.WeaponType is not null ? WeaponTypeName(definition.WeaponType.Value) : EquipmentSlotName(definition.Slot);
    private static string EquipmentArtCss(CompanionEquipmentDefinition definition) => string.IsNullOrWhiteSpace(definition.AssetCssClass) ? "" : $"mi-weapon-atlas {definition.AssetCssClass}";
    private CompanionGrowthView? EquipmentOwner(CompanionEquipmentView equipment) => snapshot.CompanionGrowth.FirstOrDefault(hero =>
        hero.Equipment.Any(equipped => string.Equals(equipped.Instance.InstanceId, equipment.Instance.InstanceId, StringComparison.OrdinalIgnoreCase)));
    private static string EquipmentBonus(CompanionEquipmentView item) => string.Join(" · ", new[] { item.AttackPercent > 0 ? $"공 +{item.AttackPercent}%" : null, item.HealthPercent > 0 ? $"생 +{item.HealthPercent}%" : null, item.DefensePercent > 0 ? $"방 +{item.DefensePercent}%" : null }.Where(value => value is not null));
    private static string EquipmentRarityName(CompanionEquipmentRarity rarity) => rarity switch { CompanionEquipmentRarity.Legendary => "전설", CompanionEquipmentRarity.Epic => "영웅", _ => "희귀" };
    private static string EquipmentRarityCss(CompanionEquipmentRarity rarity) => rarity.ToString().ToLowerInvariant();
    private static string RarityName(CompanionRarity rarity) => rarity switch { CompanionRarity.Legendary => "전설", CompanionRarity.Epic => "영웅", _ => "희귀" };
    private static string RarityCss(CompanionRarity rarity) => rarity.ToString().ToLowerInvariant();

    public async ValueTask DisposeAsync()
    {
        CommunicationService.MessagePublished -= OnAdminMessagePublished;
        try { snapshot = await Session.PauseAutoSpeedBoostAsync(CancellationToken.None); }
        catch (InvalidOperationException) { }
        lifetimeCancellation.Cancel();
        holdCancellation?.Cancel();
        lootToastCancellation?.Cancel();
        await autoLoop.DisposeAsync();
        await enemyLoop.DisposeAsync();
        if (holdTask is not null) { try { await holdTask; } catch (OperationCanceledException) { } }
        if (componentReference is not null)
        {
            try { await JS.InvokeVoidAsync("maruIdle.unbindVisibility"); } catch (JSDisconnectedException) { }
            try { await JS.InvokeVoidAsync("maruIdle.unbindIdleTimer"); } catch (JSDisconnectedException) { }
            try { await JS.InvokeVoidAsync("maruIdle.unbindFormationDrag"); } catch (JSDisconnectedException) { }
            componentReference.Dispose();
        }
        holdCancellation?.Dispose();
        lootToastCancellation?.Dispose();
        await Audio.DisposeAsync();
        lifetimeCancellation.Dispose();
    }

    private sealed record DamagePopup(long Id, long Damage, bool IsCritical, string TargetUnitId);
}
