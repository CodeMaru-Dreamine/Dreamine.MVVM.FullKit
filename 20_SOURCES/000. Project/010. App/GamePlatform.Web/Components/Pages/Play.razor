    private async Task DismissAnnouncementAsync()
    {
        if (latestAnnouncement is not { } announcement) return;
        var readKey = AdminNoticeReadKey(announcement);
        if (!IsMailRead(readKey)) gameSettings.General.ReadMailKeys.Add(readKey);
        latestAnnouncement = adminAnnouncements.FirstOrDefault(item => !IsMailRead(AdminNoticeReadKey(item)));
        await PersistReadStateAsync();
