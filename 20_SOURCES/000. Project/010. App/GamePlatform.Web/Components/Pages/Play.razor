    private bool IsAdminMessageForCurrentUser(GameAdminMessage message) =>
        message.Target == GameAdminMessageTarget.AllPlayers
        || string.Equals(message.TargetUserId, currentUserId, StringComparison.OrdinalIgnoreCase);

    private void OnAdminMessagePublished(GameAdminMessage message) => _ = InvokeAsync(() =>
    {
        if (!IsAdminMessageForCurrentUser(message)) return;
        if (message.Kind == GameAdminMessageKind.Announcement)
        {
            adminAnnouncements = new[] { message }
                .Concat(adminAnnouncements.Where(item => item.MessageId != message.MessageId))
                .Take(20)
                .ToArray();
            latestAnnouncement = message;
        }
        else if (message.Kind == GameAdminMessageKind.Mail)
        {
            adminMailMessages = new[] { message }
                .Concat(adminMailMessages.Where(item => item.MessageId != message.MessageId))
                .Take(50)
                .ToArray();
            quickNotice = $"새 운영 우편 · {message.Title}";
        }
        StateHasChanged();
    });

