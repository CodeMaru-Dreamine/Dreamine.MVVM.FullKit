    private (int Levels, long Cost) EquipmentBatchPlan
    {
        get
        {
            var requested = equipmentUpgradeBatch == 0 ? 1_000 : equipmentUpgradeBatch;
            var remainingGold = snapshot.Gold;
            var cost = 0L;
            var levels = 0;
            while (levels < requested && SelectedInheritanceLevel <= int.MaxValue - levels - 1)
            {
                var nextCost = GameRules.EquipmentUpgradeCost(SelectedInheritanceLevel + levels);
                if (nextCost > remainingGold) break;
                remainingGold -= nextCost;
                cost += nextCost;
                levels++;
            }
            return (levels, cost);
        }
    }
    private int EquipmentBatchLevels => EquipmentBatchPlan.Levels;
    private long EquipmentBatchCost => EquipmentBatchPlan.Cost;
    private (int Levels, long Cost) SwordBatchPlan => ResolveBodyGrowthBatch(snapshot.AttackLevel, GameRules.UpgradeCost);
    private (int Levels, long Cost) SwordArtBatchPlan => ResolveBodyGrowthBatch(snapshot.SwordArtLevel, GameRules.SwordArtUpgradeCost);
    private int SwordBatchLevels => SwordBatchPlan.Levels;
    private long SwordBatchCost => SwordBatchPlan.Cost;
    private int SwordArtBatchLevels => SwordArtBatchPlan.Levels;
    private long SwordArtBatchCost => SwordArtBatchPlan.Cost;
    private (int Levels, long Cost) ResolveBodyGrowthBatch(int currentLevel, Func<int, long> costResolver)
    {
        var requested = bodyGrowthBatch == 0 ? 1_000 : bodyGrowthBatch;
        var remainingGold = snapshot.Gold;
        var cost = 0L;
        var levels = 0;
        while (levels < requested && currentLevel <= int.MaxValue - levels - 1)
        {
            var nextCost = costResolver(currentLevel + levels);
            if (nextCost > remainingGold) break;
            remainingGold -= nextCost;
            cost = GameRules.SaturatingAdd(cost, nextCost);
            levels++;
        }
        return (levels, cost);
    }
