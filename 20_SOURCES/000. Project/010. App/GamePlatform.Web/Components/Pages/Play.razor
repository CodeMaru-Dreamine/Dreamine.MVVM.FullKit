    private int BoostPurchaseQuantity(AutoSpeedBoostDefinition item)
    {
        if (item.PriceC <= 0) return 0;
        var capacity = int.MaxValue - BoostCount(item.ItemKey);
        var affordable = (int)Math.Min(int.MaxValue, snapshot.PremiumCurrency / item.PriceC);
        var requested = boostPurchaseBatch == 0 ? Math.Min(capacity, affordable) : boostPurchaseBatch;
        return requested > 0 && requested <= capacity && requested <= affordable ? requested : 0;
    }

    private static long BoostPurchasePrice(AutoSpeedBoostDefinition item, int quantity) =>
        quantity <= 0 || item.PriceC > long.MaxValue / quantity ? 0 : item.PriceC * quantity;

