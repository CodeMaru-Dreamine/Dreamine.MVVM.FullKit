    private void SyncEnemyLoop()
    {
        if (isPageVisible)
            enemyLoop.Start(token => InvokeAsync(() => PerformEnemyAttackAsync(token)), GameRules.DefaultEnemyAttackInterval, lifetimeCancellation.Token);
        else
            _ = enemyLoop.StopAsync();
    }

