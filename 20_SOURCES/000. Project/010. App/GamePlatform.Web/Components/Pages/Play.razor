@page "/maru-idle/play"
@page "/play"
@attribute [Authorize]
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject GameSession Session
@inject IGameSettingsService SettingsService
@inject IGameRankingService RankingService
@inject IGameAdminCommunicationService CommunicationService
@inject IAudioService Audio
@inject IRegionAudioResolver AudioResolver
@inject ICombatAudioDirector CombatAudio
@inject IJSRuntime JS
@inject IWebHostEnvironment HostEnvironment

<PageTitle>마루 원정 | CodeMaru Games</PageTitle>

@if (isLoading)
{
    <section class="mi-loading" aria-live="polite"><span class="mi-loading-mark"></span><strong>여정 기록을 펼치는 중</strong></section>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <section class="gp-auth-card" role="alert"><span class="gp-kicker">불러오기 실패</span><h1>@errorMessage</h1><a class="gp-button gp-button-primary" href="/maru-idle/play">다시 시도</a></section>
}
else
{
<main class="mi-stage phase-@snapshot.Phase.ToString().ToLowerInvariant() quality-@gameSettings.Display.Quality.ToString().ToLowerInvariant() @(snapshot.AutoAttackEnabled ? "auto-active" : null) @(!gameSettings.Display.AmbientEffects ? "ambient-disabled" : null) @(gameSettings.Display.PowerSaving ? "power-saving" : null)"
          style="--region-primary:@snapshot.World.Region.PrimaryColor; --region-accent:@snapshot.World.Region.AccentColor"
          data-exploration-audio-muted="@ExplorationAudioMuted.ToString().ToLowerInvariant()"
          tabindex="0" @ref="gameRoot" @onkeydown="OnKeyDownAsync" @onkeyup="OnKeyUp">
        @if (!ChannelConfirmed)
        {
            <div class="mi-server-gate" role="dialog" aria-modal="true" aria-labelledby="mi-server-gate-title"
                 @onkeydown:stopPropagation="true" @onkeyup:stopPropagation="true">
                <section>
                    <header>
                        <small>FIRST CONNECTION</small>
                        <h1 id="mi-server-gate-title">원정 서버를 선택해 주세요</h1>
                        <p>서버를 선택해야 원정을 시작할 수 있습니다. 월드 채팅과 순위는 같은 서버의 원정대끼리만 공유합니다.</p>
                    </header>
                    <div class="mi-server-gate-list">
                        @foreach (var option in ChannelOptions)
                        {
                            <button type="button" disabled="@serviceBusy" @onclick='() => SelectChannelAsync(option.Key)'>
                                <i>@option.Icon</i>
                                <span><small>@option.Region</small><strong>@option.Name</strong><em>@option.Description</em></span>
                                <b>선택</b>
                            </button>
                        }
                    </div>
                    <footer>
                        <p>선택한 서버는 이 계정에 영구 귀속되며 이후 변경할 수 없습니다.</p>
                        @if (serviceBusy) { <strong role="status">서버 접속 정보를 저장하는 중입니다…</strong> }
                        else if (!string.IsNullOrWhiteSpace(serviceMessage)) { <strong class="is-error" role="alert">@serviceMessage</strong> }
                    </footer>
                </section>
            </div>
        }
        <header class="mi-topbar">
            <button type="button" class="mi-account-profile" aria-label="@currentDisplayName 개인 정보 열기" aria-expanded="@profileOpen" @onclick="OpenProfile">
                <i style="background-image:url('@snapshot.Party.ActiveHero.SpriteAssetUrl'); --sprite-x:@snapshot.Party.ActiveHero.SpriteFocusX%; --sprite-y:@snapshot.Party.ActiveHero.SpriteFocusY%;" aria-hidden="true"></i>
                <span>
                    <strong>@currentDisplayName</strong>
                    <small class="mi-profile-caption">내 원정대</small>
                    <small class="mi-profile-power-mobile">전투력 @FormatCompact(snapshot.Party.PartyAttackPower)</small>
                </span>
                <em title="원정대 전투력">@FormatCompact(snapshot.Party.PartyAttackPower)</em>
            </button>
            <div class="mi-top-actions">
                <PwaInstallButton Variant="compact" />
                <div class="mi-currencies" aria-label="보유 재화">
                    <span class="mi-currency"><i class="mi-coin" aria-hidden="true"></i><small>금화</small><strong>@FormatCompact(snapshot.Gold)</strong></span>
                    <span class="mi-currency"><i class="mi-ticket-icon" aria-hidden="true"></i><small>소환패</small><strong>@FormatCompact(snapshot.HeroSummonTickets)</strong></span>
                    <span class="mi-currency is-premium"><i aria-hidden="true">C</i><small>CodeMaru</small><strong>@FormatCompact(snapshot.PremiumCurrency)</strong></span>
                </div>
                @if (HostEnvironment.IsDevelopment()) { <button type="button" class="mi-dev-reset" aria-label="로컬 테스트 진행을 Stage 1로 초기화" title="테스트 진행 초기화" @onclick="ResetTestProgressAsync">↺</button> }
                <button type="button" class="mi-settings-gear" aria-label="환경설정 열기" @onclick="OpenSettingsAsync">⚙</button>
            </div>
        </header>

        @if (latestAnnouncement is not null)
        {
            <aside class="mi-admin-announcement" role="status" aria-label="운영 공지">
                <span><b>공지</b><strong>@latestAnnouncement.Title</strong><em>@latestAnnouncement.Text</em></span>
                <button type="button" aria-label="공지 확인 및 닫기" @onclick="DismissAnnouncementAsync">×</button>
            </aside>
        }

        @if (profileOpen)
        {
            <div class="mi-profile-backdrop" @onclick="CloseProfile">
                <section class="mi-profile-card" role="dialog" aria-modal="true" aria-labelledby="mi-profile-title" @onclick:stopPropagation="true">
                    <button type="button" class="mi-profile-close" aria-label="개인 정보 닫기" @onclick="CloseProfile">×</button>
                    <header class="mi-profile-identity">
                        <i style="background-image:url('@snapshot.Party.ActiveHero.SpriteAssetUrl'); --sprite-x:@snapshot.Party.ActiveHero.SpriteFocusX%; --sprite-y:@snapshot.Party.ActiveHero.SpriteFocusY%;" aria-hidden="true"></i>
                        <div class="mi-profile-name-block">
                            <small>PLAYER PROFILE</small>
                            <div class="mi-profile-name-row">
                                <h2 id="mi-profile-title">@currentDisplayName</h2>
                                <button type="button" class="mi-profile-name-edit" aria-label="닉네임 변경" @onclick="OpenNicknameEditor">변경</button>
                            </div>
                            <span>ID @PlayerIdDetail</span>
                        </div>
                        <strong><small>원정대 전투력</small>@FormatCompact(snapshot.Party.PartyAttackPower)</strong>
                    </header>
                    @if (nicknameEditorOpen)
                    {
                        <section class="mi-nickname-editor" aria-label="게임 닉네임 변경">
                            <div>
                                <label for="mi-nickname-input">원정대 닉네임</label>
                                <span class="@(snapshot.NicknameChangeCount == 0 ? "is-free" : null)">@NicknameChangePriceLabel</span>
                            </div>
                            <input id="mi-nickname-input" type="text" maxlength="@GameNicknameRules.MaximumLength"
                                   autocomplete="off" spellcheck="false" disabled="@nicknameBusy"
                                   @onkeydown:stopPropagation="true" @onkeyup:stopPropagation="true"
                                   @bind="nicknameDraft" @bind:event="oninput" />
                            <small>한글·영문·숫자 @GameNicknameRules.MinimumLength~@(GameNicknameRules.MaximumLength)자 · 다른 원정대와 중복 불가</small>
                            @if (!string.IsNullOrWhiteSpace(nicknameMessage))
                            {
                                <p class="@(nicknameChangeSucceeded ? "is-success" : "is-error")" role="status">@nicknameMessage</p>
                            }
                            <footer>
                                <button type="button" @onclick="CancelNicknameEditor" disabled="@nicknameBusy">취소</button>
                                <button type="button" class="is-primary" @onclick="ChangeNicknameAsync" disabled="@nicknameBusy">
                                    @(nicknameBusy ? "변경 중" : "닉네임 적용")
                                </button>
                            </footer>
                        </section>
                    }
                    <div class="mi-profile-facts">
                        <article><small>채널</small><strong>@SelectedChannel</strong></article>
                        <article><small>현재 스테이지</small><strong>STAGE @snapshot.Stage</strong></article>
                        <article><small>최고 클리어</small><strong>STAGE @snapshot.HighestClearedStage</strong></article>
                        <article><small>현재 지역</small><strong>@snapshot.World.Region.Name</strong></article>
                    </div>
    <section class="mi-profile-party-preview" aria-label="현재 원정대 편성">
                        <header><div><small>ACTIVE PARTY</small><strong>현재 원정대</strong></div><span>본체 1 + 동료 @snapshot.Party.CompanionCount</span></header>
                        <div class="mi-profile-party-grid">
                            <article class="is-leader">
                                <i style="background-image:url('@snapshot.Party.ActiveHero.SpriteAssetUrl'); --sprite-x:@snapshot.Party.ActiveHero.SpriteFocusX%; --sprite-y:@snapshot.Party.ActiveHero.SpriteFocusY%;" aria-hidden="true"></i>
                                <span><small>대표 캐릭터</small><strong>@snapshot.Party.ActiveHero.Name</strong><em>@snapshot.Party.ActiveHero.Role</em></span>
                            </article>
                            @foreach (var hero in snapshot.Party.Companions)
                            {
                                <article>
                                    <i style="background-image:url('@hero.SpriteAssetUrl'); --sprite-x:@hero.SpriteFocusX%; --sprite-y:@hero.SpriteFocusY%;" aria-hidden="true"></i>
                                    <span><small>출전 동료</small><strong>@hero.Name</strong><em>@hero.Role</em></span>
                                </article>
                            }
        </div>
    </section>
    <section class="mi-profile-growth" aria-label="본체 성장 메뉴">
        <header>
            <div><small>BODY GROWTH</small><strong>본체 성장</strong></div>
            <span>계승 성장</span>
        </header>
        <div class="mi-profile-growth-actions">
            <button type="button" @onclick='() => OpenProfilePanel("upgrade")'>
                <img src="/images/maru-idle/icons-premium/forge.png" alt="" /><span><strong>검 강화</strong><small>본체 기본 공격력</small></span>
            </button>
            <button type="button" @onclick='() => OpenProfilePanel("skills")'>
                <img src="/images/maru-idle/icons-premium/sword-art.png" alt="" /><span><strong>검술 수련</strong><small>기술 피해와 치명타</small></span>
            </button>
            <button type="button" @onclick='() => OpenProfilePanel("equipment")'>
                <img src="/images/maru-idle/icons-premium/equipment.png" alt="" /><span><strong>장비 강화</strong><small>공격·생명·방어</small></span>
            </button>
        </div>
    </section>
</section>
</div>
        }

        <section class="mi-enemy-hud @(snapshot.World.IsBoss ? "is-boss" : null)" aria-label="현재 적 상태">
            <div class="mi-enemy-title"><span>@(snapshot.World.IsBoss ? "REGION BOSS" : snapshot.World.Region.Name)</span><strong>@snapshot.World.EnemyName</strong></div>
            <div class="mi-hp-track" role="progressbar" aria-label="적 체력" aria-valuemin="0" aria-valuemax="@snapshot.EnemyMaxHp" aria-valuenow="@snapshot.EnemyHp">
                <span style="width:@EnemyHpPercent%"></span><em>@FormatNumber(snapshot.EnemyHp) / @FormatNumber(snapshot.EnemyMaxHp)</em>
            </div>
        </section>

<section class="mi-battlefield @(screenShake ? "is-shaking" : null) @(snapshot.World.IsBoss ? "is-boss-stage" : null)" aria-label="전투 영역, 터치하여 공격" @onclick="BattlefieldAttackAsync">
            <img class="mi-background @(backgroundTransition ? "is-transitioning" : null)" src="@CurrentBackgroundUrl" alt="" fetchpriority="high" @onerror="UseFallbackBackground" />
            <div class="mi-lighting lighting-@snapshot.World.LightingKey"></div>
            <div class="mi-midground" aria-hidden="true"></div>
            <div class="mi-ambient ambient-@snapshot.World.Region.AmbientEffectKey" aria-hidden="true">
                @for (var index = 0; index < AmbientParticleCount; index++) { <i style="--i:@index"></i> }
            </div>
            <div class="mi-foreground" aria-hidden="true"></div>
            <nav class="mi-quick-menu @(quickMenuOpen ? "is-open" : null)" aria-label="빠른 메뉴" @onclick:stopPropagation="true">
                <button type="button" class="mi-quick-menu-toggle" aria-expanded="@quickMenuOpen" aria-label="@(quickMenuOpen ? "빠른 메뉴 닫기" : "빠른 메뉴 열기")" @onclick="ToggleQuickMenu"><img src="/images/maru-idle/icons-premium/menu-crest-v1.png" alt="" /><strong>@(quickMenuOpen ? "닫기" : "메뉴")</strong></button>
                @if (quickMenuOpen)
                {
                    <div class="mi-quick-menu-list">
                        <button type="button" @onclick='() => OpenServicePanel("channel")'><img src="/images/maru-idle/icons-premium/quick-channel.png" alt="" /><span>채널</span></button>
                        <button type="button" @onclick="OpenOfflineReward"><img src="/images/maru-idle/rewards/gold-pouch.svg" alt="" /><span>방치 보상</span>@if (snapshot.OfflineReward.IsUnlocked && snapshot.OfflineReward.PendingGold > 0) { <b aria-label="수령 가능"></b> }</button>
                        <button type="button" @onclick='() => OpenQuickCompanions("summon")'><img src="/images/maru-idle/icons-premium/companions.png" alt="" /><span>소환</span></button>
                        <button type="button" @onclick='() => OpenServicePanel("mail")'><img src="/images/maru-idle/icons-premium/codex.png" alt="" /><span>우편</span>@if (snapshot.OfflineReward.PendingGold > 0 || adminMailMessages.Any(item => !IsAdminMailRead(item))) { <b aria-label="확인할 보상 또는 새 우편"></b> }</button>
                        <button type="button" @onclick='() => OpenServicePanel("mission")'><img src="/images/maru-idle/icons-premium/quick-mission.png" alt="" /><span>임무</span></button>
                        <button type="button" @onclick='() => OpenServicePanel("rank")'><img src="/images/maru-idle/icons-premium/quick-ranking.png" alt="" /><span>순위</span></button>
                        <button type="button" @onclick='() => OpenServicePanel("shop")'><img src="/images/maru-idle/icons-premium/quick-shop.png" alt="" /><span>상점</span></button>
                        <button type="button" @onclick="OpenTalismanVault"><img src="/images/maru-idle/boosts/auto-talisman-x3-v1.png" alt="" /><span>부적 사용</span>@if (snapshot.AutoBoostInventory.Sum(item => item.Count) > 0) { <b aria-label="사용 가능 부적"></b> }</button>
                        <button type="button" @onclick="OpenQuickSettingsAsync"><img src="/images/maru-idle/icons-premium/quick-settings.png" alt="" /><span>설정</span></button>
                        <button type="button" @onclick="OpenPowerSavingSettings"><img src="/images/maru-idle/icons-premium/quick-powersave.png" alt="" /><span>절전</span></button>
                    </div>
                }
            </nav>
            @if (quickNotice is not null)
            {
                <button type="button" class="mi-quick-notice" role="status" @onclick="DismissQuickNotice">@quickNotice <span aria-hidden="true">×</span></button>
            }

            @if (snapshot.BossGuardUnits.Any(unit => unit.IsAlive))
            {
                <div class="mi-boss-guards" aria-label="생존한 보조 몬스터 @snapshot.BossGuardUnits.Count(unit => unit.IsAlive) 마리">
                    @foreach (var member in snapshot.BossGuardUnits.Select((unit, index) => (unit, index)).Where(member => member.unit.IsAlive))
                    {
                        <article class="mi-boss-guard guard-@member.index @(hitGuardId == member.unit.UnitId ? "is-hit" : null)" @key="member.unit.UnitId">
                            <img src="@member.unit.AssetUrl" alt="@member.unit.Name" draggable="false" />
                            <span><strong>@member.unit.Name</strong><small>@FormatNumber(member.unit.Hp) / @FormatNumber(member.unit.MaxHp)</small><i><b style="width:@UnitHpPercent(member.unit)%"></b></i></span>
                            @foreach (var popup in VisibleDamagePopups(member.unit.UnitId))
                            {
                                <output class="mi-unit-damage @(popup.IsCritical ? "is-critical" : null)" @key="@($"guard-damage-{popup.Id}")">-@FormatNumber(popup.Damage)</output>
                            }
                        </article>
                    }
                </div>
            }

            <div class="mi-monster @(monsterHit ? "is-hit" : null) @(monsterAttacking ? "is-attacking" : null) @(snapshot.World.IsBoss ? "is-boss" : null)" @key="monsterAnimationKey">
                <img src="@snapshot.World.EnemyAssetUrl" alt="@snapshot.World.EnemyName" draggable="false" />
            </div>
            @foreach (var popup in VisibleDamagePopups("enemy"))
            {
                <output class="mi-damage @(popup.IsCritical && gameSettings.Combat.CriticalEffects ? "is-critical" : null)" @key="@($"enemy-damage-{popup.Id}")">@(popup.IsCritical ? "치명 " : "-")@FormatNumber(popup.Damage)</output>
            }
            @if (playerDamagePopup is not null && hitCompanionId is null)
            {
                <output class="mi-damage mi-player-damage" @key="@($"player-damage-{enemyAnimationSequence}")">-@FormatNumber(playerDamagePopup.Value)</output>
            }
            @if (snapshot.Party.CompanionCount > 0)
            {
                <div class="mi-support-party" aria-label="연수와 함께 출전한 동료 @snapshot.Party.CompanionCount 명">
                    @foreach (var member in snapshot.CompanionUnits.Select((unit, index) => (unit, index)).Where(member => member.unit.IsAlive))
                    {
                        <article class="mi-companion companion-@member.index unit-@member.unit.UnitId @member.unit.SkinCssClass @(playerAttacking ? "is-attacking" : null) @(hitCompanionId == member.unit.UnitId ? "is-hit" : null)"
                                 style="--slot:@member.index; --attack-delay:@(member.index * 42)ms;"
                                 @key="(member.unit.UnitId, animationSequence, enemyAnimationSequence)">
                            <div class="mi-companion-sprite" style="background-image:url('@member.unit.AssetUrl')" role="img" aria-label="@member.unit.Name"></div>
                            @if (playerAttacking && gameSettings.Display.SlashEffects && !SkipCombatEffects)
                            {
                                <i class="mi-companion-attack-effect" aria-hidden="true"></i>
                            }
                            @if (hitCompanionId == member.unit.UnitId && playerDamagePopup is not null)
                            {
                                <output class="mi-unit-damage mi-companion-damage">-@FormatNumber(playerDamagePopup.Value)</output>
                            }
                            <span><strong>@member.unit.Name</strong><small>@member.unit.Role</small><i><b style="width:@UnitHpPercent(member.unit)%"></b></i></span>
                        </article>
                    }
                    <em>원정대 1 + @snapshot.Party.CompanionCount</em>
                </div>
            }
            <div class="mi-player @(playerAttacking ? "is-attacking" : null) @(playerHit ? "is-hit" : null)" aria-label="원정대장 연수" @key="playerAnimationKey">
                <img src="/images/maru-idle/swordswoman-idle-v2.png" alt="떠돌이 검객 연수" draggable="false" />
                <span><strong>연수</strong><small>원정대장</small></span>
            </div>
            @if (playerAttacking && gameSettings.Display.SlashEffects && !SkipCombatEffects)
            {
                <img class="mi-slash" src="/images/maru-idle/effects/slash.svg" alt="" @key="slashAnimationKey" />
                <img class="mi-impact" src="/images/maru-idle/effects/impact.svg" alt="" @key="impactAnimationKey" />
            }

            @if (snapshot.Phase is CombatPhase.Intro or CombatPhase.Transitioning)
            {
                <div class="mi-region-intro" role="status"><span>@(snapshot.World.IsBoss ? "수호자 출현" : "새 길을 여는 중")</span><strong>@snapshot.World.Region.Name</strong>@if (snapshot.World.IsBoss) { <em>@snapshot.World.EnemyName</em> }</div>
            }
            else if (snapshot.Phase == CombatPhase.Victory)
            {
                <div class="mi-victory" role="status"><span>길이 열렸습니다</span><strong>승리</strong></div>
            }
            else if (snapshot.Phase == CombatPhase.Defeat)
            {
                <div class="mi-defeat" role="status"><span>호흡을 가다듬는 중</span><strong>쓰러졌습니다</strong><em>현재 스테이지에서 다시 도전합니다</em></div>
            }
            <div class="mi-touch-hint">전투 영역 터치 · Space</div>
            @if (showAudioUnlockHint) { <button type="button" class="mi-audio-unlock-hint" @onclick:stopPropagation="true" @onclick="EnsureAudioUnlockedAsync">화면을 터치하면 음악이 재생됩니다</button> }
        </section>

        <section class="mi-auto-energy">
            @if (!snapshot.AutoAttackUnlocked)
            {
                <div class="mi-auto-locked" role="status"><span class="mi-lock" aria-hidden="true"></span><strong>AUTO 잠김</strong><small>15 스테이지 클리어 시 자동 공격 해금</small></div>
            }
            else
            {
                <button class="mi-auto-toggle @(snapshot.AutoAttackEnabled ? "is-on" : null)" type="button" aria-pressed="@snapshot.AutoAttackEnabled" @onclick="ToggleAutoAsync">
                    <span class="mi-auto-dot"></span><strong>AUTO</strong><em>@(snapshot.AutoAttackEnabled ? "ON" : "OFF")</em>@if (snapshot.ActiveAutoSpeedMultiplier > 1) { <small>×@snapshot.ActiveAutoSpeedMultiplier</small> }
                </button>
            }
            <div class="mi-energy mi-life"><span>생명력</span><strong>@FormatNumber(snapshot.PlayerHp) / @FormatNumber(snapshot.PlayerMaxHp)</strong><div><i style="width:@PlayerHpPercent%"></i></div></div>
        </section>

        @if (ChannelConfirmed)
        {
            <GameChatPanel UserId="@currentUserId" ChannelKey="@SelectedChannelKey" ChannelName="@SelectedChannel" DisplayName="@currentDisplayName" OpenChanged="@(open => chatOpen = open)" />
        }

        <nav class="mi-menu" aria-label="게임 기능">
            <button type="button" class="mi-menu-item @(IsBodyGrowthPanel ? "is-selected" : null)" @onclick='() => OpenPanel("upgrade")'><img src="/images/maru-idle/icons-premium/forge.png" alt="" /><span>성장</span><small>검 · 검술 · 계승 장비</small></button>
            <button type="button" class="mi-menu-item @(activePanel == "companions" ? "is-selected" : null)" @onclick='() => OpenCompanions("formation")'><img src="/images/maru-idle/icons-premium/companions.png" alt="" /><span>동료</span><small>@snapshot.Party.CompanionCount/@PartyRules.MaximumCompanions 편성</small></button>
            <button type="button" class="mi-menu-item mi-explore-item @(activePanel is null && !endlessTrialOpen ? "is-selected" : null) @(snapshot.AutoAttackEnabled ? "is-auto" : null)" aria-label="탐험 전투 화면으로 돌아가기" @onclick="ReturnToExploration">
                <img src="/images/maru-idle/icons-premium/explore.png" alt="" /><span>탐험</span><small>@(snapshot.AutoAttackEnabled ? "AUTO 진행 중" : "전투 화면")</small>
            </button>
            <button type="button" class="mi-menu-item @(offlineRewardOpen ? "is-selected" : null)" @onclick="OpenOfflineReward"><img src="/images/maru-idle/rewards/gold-pouch.svg" alt="" /><span>보상</span><small>@(snapshot.OfflineReward.PendingGold > 0 ? $"{FormatCompact(snapshot.OfflineReward.PendingGold)} 수령" : "원정 정산")</small></button>
            <button type="button" class="mi-menu-item @(endlessTrialOpen ? "is-selected" : null)" @onclick="OpenEndlessTrial"><img src="/images/maru-idle/icons-premium/codex.png" alt="" /><span>시련</span><small>콘텐츠 8종</small></button>
        </nav>

        @if (endlessTrialOpen)
        {
            <TrialArcade @key="trialArcadeComponentKey" Snapshot="snapshot" SnapshotChanged="OnEndlessSnapshotChanged" CloseRequested="CloseEndlessTrial" />
        }

        @if (servicePanel is not null)
        {
            <aside class="mi-service-sheet" role="dialog" aria-modal="true" aria-label="게임 서비스">
                <header><div><small>EXPEDITION SERVICES</small><h2>원정 서비스</h2><p>채널과 원정 지원 기능을 한곳에서 관리합니다.</p></div><button type="button" aria-label="서비스 닫기" @onclick="CloseServicePanel">×</button></header>
                <nav aria-label="서비스 종류">
                    <button class="@(servicePanel == "channel" ? "is-selected" : null)" @onclick='() => servicePanel = "channel"'>채널</button>
                    <button class="@(servicePanel == "mail" ? "is-selected" : null)" @onclick='() => OpenServiceTabAsync("mail")'>우편</button>
                    <button class="@(servicePanel == "mission" ? "is-selected" : null)" @onclick='() => servicePanel = "mission"'>임무</button>
                    <button class="@(servicePanel == "rank" ? "is-selected" : null)" @onclick='() => OpenServiceTabAsync("rank")'>순위</button>
                    <button class="@(servicePanel == "shop" ? "is-selected" : null)" @onclick='() => servicePanel = "shop"'>상점</button>
                </nav>
                <div class="mi-service-content">
                    @if (servicePanel == "channel")
                    {
                        <section class="mi-channel-service">
                            <header><div><small>WORLD CHANNEL</small><h3>계정 채널 선택</h3><p>@(ChannelConfirmed ? "최초 확정한 채널에 계정이 귀속되어 변경할 수 없습니다." : "계정 시작 시 단 한 번만 선택할 수 있습니다. 확정 후에는 변경할 수 없습니다.")</p></div><strong>@(ChannelConfirmed ? $"{SelectedChannel} 확정" : "채널 미확정")</strong></header>
                            <div>
                                @foreach (var option in ChannelOptions)
                                {
                                    <button type="button" class="@(SelectedChannelKey == option.Key ? "is-selected" : null)" disabled="@(serviceBusy || ChannelConfirmed)" @onclick='() => SelectChannelAsync(option.Key)'>
                                        <i>@option.Icon</i><span><small>@option.Region</small><strong>@option.Name</strong><em>@option.Description</em></span><b>@ChannelActionLabel(option.Key)</b>
                                    </button>
                                }
                            </div>
                            <p class="mi-channel-rule">※ 채널 확정은 계정당 1회이며 장비·재화·순위가 해당 채널에 귀속됩니다.</p>
                        </section>
                    }
                    else if (servicePanel == "mail")
                    {
                        <section class="mi-mail-service"><header><small>EXPEDITION POST</small><h3>원정 우편함</h3><p>현재 수령할 수 있는 정산 보상과 운영 소식을 모아봅니다.</p></header>
                            <article class="is-reward"><i>休</i><span><strong>방치 원정 정산</strong><small>@(snapshot.OfflineReward.PendingGold > 0 ? $"금화 {FormatNumber(snapshot.OfflineReward.PendingGold)} 수령 가능" : "새로 도착한 정산 보상이 없습니다.")</small></span><button type="button" @onclick="OpenOfflineReward">확인</button></article>
                            @if (SelectedAdminMail is { } adminMail)
                            {
                                <article class="mi-mail-detail is-admin-mail"><i>令</i><div><small>CodeMaru 운영팀 · @(adminMail.Target == GameAdminMessageTarget.AllPlayers ? "전체 우편" : "개별 우편")</small><strong>@adminMail.Title</strong><p>@adminMail.Text</p><span>@adminMail.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                    @if (adminMail.AttachmentKind != GameAdminMailAttachmentKind.None)
                                    {
                                        <div class="mi-admin-mail-attachment"><b>🎁 @AdminMailAttachmentLabel(adminMail.AttachmentKind)</b><strong>@FormatNumber(adminMail.AttachmentAmount)</strong></div>
                                    }
                                </div><footer><button type="button" class="is-secondary" @onclick="CloseMailDetail">목록으로</button>@if (adminMail.AttachmentKind != GameAdminMailAttachmentKind.None) { <button type="button" disabled="@(serviceBusy || Session.HasClaimedAdminMailReward(adminMail.MessageId))" @onclick="() => ClaimAdminMailRewardAsync(adminMail.MessageId)">@(Session.HasClaimedAdminMailReward(adminMail.MessageId) ? "수령 완료" : "선물 받기")</button> }</footer></article>
                                @if (!string.IsNullOrWhiteSpace(mailClaimMessage)) { <p class="mi-service-result">@mailClaimMessage</p> }
                            }
                            else if (selectedMailKey == "trial-arcade-open")
                            {
                                <article class="mi-mail-detail"><img src="/images/maru-idle/icons-premium/codex.png" alt="" /><div><small>원정 관리국 · 시스템 우편</small><strong>시련 회랑 개방 안내</strong><p>첫 번째 미니게임 ‘무한 시련’이 개방되었습니다. 좌우로 원정대를 이동해 몰려오는 마물을 막고, 무기와 동료를 늘려 끝없이 상승하는 난이도에 도전해 보세요.</p><span>입장 비용 없음 · 반복 플레이 가능 · 금화·광석·장비·부적 획득</span></div><footer><button type="button" class="is-secondary" @onclick="CloseMailDetail">목록으로</button><button type="button" @onclick="OpenTrialFromMail">시련 회랑 입장</button></footer></article>
                            }
                            else
                            {
                                @foreach (var item in adminMailMessages)
                                {
                                    <article class="@(IsAdminMailRead(item) ? null : "is-unread")"><i>令</i><span><strong>@item.Title</strong><small>@item.Text</small><em>@item.CreatedUtc.ToLocalTime().ToString("MM-dd HH:mm") · @(item.Target == GameAdminMessageTarget.AllPlayers ? "전체 우편" : "개별 우편")@if (item.AttachmentKind != GameAdminMailAttachmentKind.None) { <b> · 🎁 @AdminMailAttachmentLabel(item.AttachmentKind) @FormatNumber(item.AttachmentAmount)</b> }</em></span><button type="button" @onclick="() => OpenAdminMailAsync(item)">@(IsAdminMailRead(item) ? "다시 읽기" : "새 우편")</button></article>
                                }
                                <article><i>信</i><span><strong>시련 회랑 개방 안내</strong><small>첫 번째 미니게임 ‘무한 시련’이 개방되었습니다.</small></span><button type="button" @onclick='() => OpenMailAsync("trial-arcade-open")'>@(IsMailRead("trial-arcade-open") ? "다시 읽기" : "열기")</button></article>
                            }
                        </section>
                    }
                    else if (servicePanel == "mission")
                    {
                        <section class="mi-mission-service"><header><small>DAILY ORDERS</small><h3>오늘의 원정 임무</h3><p>대한민국 표준시 자정에 새 임무가 시작됩니다. 달성한 보상은 직접 수령해 계정에 저장됩니다.</p></header>
                            @foreach (var mission in snapshot.DailyMissions)
                            {
                                <article class="@(mission.IsClaimed ? "is-claimed" : mission.IsCompleted ? "is-complete" : null)"><span><strong>@mission.Definition.Name</strong><small>@mission.Definition.Description</small><em>@mission.Progress / @mission.Definition.Target</em></span><progress max="@mission.Definition.Target" value="@mission.Progress"></progress><div><img src="@(mission.Definition.RewardKind == DailyMissionRewardKind.Gold ? "/images/maru-idle/rewards/gold-pouch.svg" : mission.Definition.RewardKind == DailyMissionRewardKind.UpgradeMaterial ? "/images/maru-idle/rewards/companion-ore.svg" : "/images/maru-idle/icons-premium/companions.png")" alt="" /><b>@mission.Definition.RewardLabel</b><button type="button" disabled="@(serviceBusy || !mission.IsCompleted || mission.IsClaimed)" @onclick="() => ClaimDailyMissionAsync(mission.Definition.MissionKey)">@(mission.IsClaimed ? "수령 완료" : mission.IsCompleted ? "보상 수령" : "진행 중")</button></div></article>
                            }
                            @if (!string.IsNullOrWhiteSpace(missionMessage)) { <p class="mi-service-result">@missionMessage</p> }
                        </section>
                    }
                    else if (servicePanel == "rank")
                    {
                        <section class="mi-rank-service"><header><small>CHANNEL RANKING</small><h3>@SelectedChannel 원정대 순위</h3><p>가상 경쟁자 없이 이 서버에 저장된 실제 계정 전투력만 집계합니다.</p></header>
                            @if (!ChannelConfirmed)
                            {
                                <p class="mi-rank-empty">채널을 최초 확정하면 해당 채널 순위에 등록됩니다.</p>
                            }
                            else if (rankingBusy)
                            {
                                <p class="mi-rank-empty">채널 순위를 집계하는 중입니다.</p>
                            }
                            else if (channelRankings.Count == 0)
                            {
                                <p class="mi-rank-empty">아직 등록된 원정대가 없습니다.</p>
                            }
                            else
                            {
                                @foreach (var entry in channelRankings)
                                {
                                    <article class="@(string.Equals(entry.UserId, currentUserId, StringComparison.Ordinal) ? "is-player" : null)"><b>@entry.Rank</b><span><strong>@RankingDisplayName(entry)</strong><small>STAGE @entry.HighestClearedStage · @FormatNumber(entry.TotalDefeated)기 격파</small></span><em>@FormatCompact(entry.AttackPower)</em></article>
                                }
                            }
                        </section>
                    }
                    else if (servicePanel == "talisman")
                    {
                        <section class="mi-talisman-service"><header><small>WIND TALISMAN VAULT</small><h3>AUTO 가속 부적 보관함</h3><p>드랍과 상점 구매로 얻은 부적을 여기서 즉시 사용할 수 있습니다.</p></header>
                            @if (snapshot.ActiveAutoSpeedMultiplier > 1) { <div class="mi-service-active-boost"><img src="/images/maru-idle/boosts/auto-talisman-x5-v1.png" alt="" /><span><small>현재 효과</small><strong>AUTO ×@snapshot.ActiveAutoSpeedMultiplier</strong><em>@FormatBoostExpiry(snapshot.AutoSpeedBoostEndsUtc)</em></span><button type="button" disabled="@actionBusy" @onclick="DeactivateBoostAsync">효과 해제</button></div> }
                            <div class="mi-service-talisman-grid">@foreach (var item in BoostCatalog) { var ownedCount = BoostCount(item.ItemKey); <article><img src="@item.AssetUrl" alt="" /><span><small>AUTO ×@item.Multiplier · @FormatBoostDuration(item.Duration)</small><strong>@item.Name</strong><em>보유 @(ownedCount)개</em></span><button type="button" disabled="@(actionBusy || ownedCount <= 0 || snapshot.ActiveAutoSpeedMultiplier > 1)" @onclick="() => ActivateBoostAsync(item.ItemKey)">사용</button></article> }</div>
                            @if (!string.IsNullOrWhiteSpace(boostMessage)) { <p class="mi-service-result">@boostMessage</p> }
                        </section>
                    }
                    else
                    {
                        <section class="mi-shop-service"><header><small>CODEMARU SUPPLY</small><h3>원정 보급 상점</h3><p>보유 CodeMaru C @FormatNumber(snapshot.PremiumCurrency) · 구매 결과는 즉시 계정에 저장됩니다.</p></header>
                            <TerritoryShieldShop Changed="@(() => snapshot = Session.Snapshot)" />
                            <h4>금화 교환</h4><div class="mi-gold-pack-list">@foreach (var pack in GoldPackCatalog) { <article><img src="@pack.AssetUrl" alt="" /><span><small>GOLD EXCHANGE</small><strong>@pack.Name</strong><em>금화 @FormatNumber(pack.Gold)</em></span><button type="button" disabled="@(actionBusy || snapshot.PremiumCurrency < pack.PriceC)" @onclick='() => PurchaseGoldPackAsync(pack.PackKey)'>C @pack.PriceC</button></article> }</div>
                            <h4>AUTO 가속 부적</h4>
                            <div class="mi-shop-purchase-batch" role="radiogroup" aria-label="부적 구매 수량">
                                <button type="button" role="radio" aria-checked="@(boostPurchaseBatch == 1 ? "true" : "false")" class="@(boostPurchaseBatch == 1 ? "is-selected" : null)" @onclick="() => SetBoostPurchaseBatch(1)">1개</button>
                                <button type="button" role="radio" aria-checked="@(boostPurchaseBatch == 10 ? "true" : "false")" class="@(boostPurchaseBatch == 10 ? "is-selected" : null)" @onclick="() => SetBoostPurchaseBatch(10)">10개</button>
                                <button type="button" role="radio" aria-checked="@(boostPurchaseBatch == 0 ? "true" : "false")" class="@(boostPurchaseBatch == 0 ? "is-selected" : null)" @onclick="() => SetBoostPurchaseBatch(0)">최대</button>
                            </div>
                            <div>@foreach (var item in BoostCatalog) { var quantity = BoostPurchaseQuantity(item); var displayQuantity = quantity > 0 ? quantity : boostPurchaseBatch; var totalPrice = BoostPurchasePrice(item, displayQuantity); <article><img src="@item.AssetUrl" alt="" /><span><strong>@item.Name</strong><small>AUTO ×@item.Multiplier · @((int)item.Duration.TotalMinutes)분 · 보유 @BoostCount(item.ItemKey)개</small></span><button type="button" title="@(quantity > 0 ? $"{quantity:N0}개 구매" : "구매 불가")" disabled="@(actionBusy || quantity <= 0)" @onclick='() => PurchaseBoostAsync(item.ItemKey, quantity)'>C @FormatNumber(totalPrice)</button></article> }</div>
                            @if (!string.IsNullOrWhiteSpace(boostMessage)) { <p class="mi-service-result">@boostMessage</p> }
                            @if (!string.IsNullOrWhiteSpace(shopMessage)) { <p class="mi-service-result">@shopMessage</p> }
                        </section>
                    }
                    @if (!string.IsNullOrWhiteSpace(serviceMessage)) { <p class="mi-service-result">@serviceMessage</p> }
                </div>
            </aside>
        }

        @if (activePanel is not null)
        {
            <aside class="mi-sheet panel-@activePanel" role="dialog" aria-modal="true" aria-label="@PanelTitle" @onclick:stopPropagation="true">
                <button class="mi-sheet-close" type="button" @onclick="ClosePanel" aria-label="닫기">×</button><span>@PanelEyebrow</span><h2>@PanelTitle</h2>
                @if (activePanel == "companions")
                {
                    <nav class="mi-companion-tabs" aria-label="동료 관리 메뉴">
                        <button type="button" class="@(companionTab == "growth" ? "is-selected" : null)" @onclick='() => SetCompanionTab("growth")'>육성</button>
                        <button type="button" class="@(companionTab == "codex" ? "is-selected" : null)" @onclick='() => SetCompanionTab("codex")'>도감</button>
                        <button type="button" class="@(companionTab == "formation" ? "is-selected" : null)" @onclick='() => SetCompanionTab("formation")'>편성</button>
                        <button type="button" class="@(companionTab == "summon" ? "is-selected" : null)" @onclick='() => SetCompanionTab("summon")'>소환</button>
                    </nav>
                    @if (companionTab == "formation")
                    {
                        <section class="mi-companion-management mi-formation-management">
                            <header><div><small>ACTIVE PARTY</small><strong>출전 동료 선택</strong></div><span>@snapshot.Party.CompanionCount / @PartyRules.MaximumCompanions</span></header>
                            <p>미리보기에서 동료를 끌어 순서를 바꿀 수 있습니다. 본체 검과 공용 장비 성장은 모든 편성에 계승됩니다.</p>
                            <section class="mi-formation-recommendation" aria-label="추천 동료 조합">
                                <nav class="mi-formation-recommendation-modes" aria-label="추천 조합 기준">
                                    <button type="button" class="@(formationRecommendationMode == FormationRecommendationMode.BasePotential ? "is-selected" : null)" @onclick="() => formationRecommendationMode = FormationRecommendationMode.BasePotential">기본 잠재력</button>
                                    <button type="button" class="@(formationRecommendationMode == FormationRecommendationMode.CurrentPower ? "is-selected" : null)" @onclick="() => formationRecommendationMode = FormationRecommendationMode.CurrentPower">현재 최강</button>
                                    <button type="button" class="@(formationRecommendationMode == FormationRecommendationMode.Exploration ? "is-selected" : null)" @onclick="() => formationRecommendationMode = FormationRecommendationMode.Exploration">탐험 특화</button>
                                    <button type="button" class="@(formationRecommendationMode == FormationRecommendationMode.TrialTower ? "is-selected" : null)" @onclick="() => formationRecommendationMode = FormationRecommendationMode.TrialTower">시련의 탑</button>
                                </nav>
                                <header>
                                    <div><small>@FormationRecommendationEyebrow</small><strong>@FormationRecommendationTitle</strong><span>@FormationRecommendationSummary</span></div>
                                    <button type="button" disabled="@(actionBusy || RecommendedFormation.Count == 0 || IsRecommendedFormationActive)" @onclick="ApplyRecommendedFormationAsync">@(IsRecommendedFormationActive ? "추천 조합 적용됨" : "추천 조합 적용")</button>
                                </header>
                                <div class="mi-formation-recommendation-cards">
                                    @foreach (var candidate in RecommendedFormation)
                                    {
                                        <article class="rarity-@candidate.Hero.Rarity.ToString().ToLowerInvariant()">
                                            <i style="background-image:url('@candidate.ActiveSkin.AssetUrl'); --sprite-x:@candidate.Hero.SpriteFocusX%; --sprite-y:@candidate.Hero.SpriteFocusY%;"></i>
                                            <span><strong>@candidate.Hero.Name</strong><small>@RarityName(candidate.Hero.Rarity) · @candidate.Hero.Role</small><em>@FormationRecommendationMetric(candidate)</em></span>
                                        </article>
                                    }
                                </div>
                                <p>@FormationRecommendationDescription</p>
                            </section>
                            <div class="mi-formation-preview" aria-label="현재 전투 배치 미리보기">
                                <div class="mi-formation-preview-heading">
                                    <span><b aria-hidden="true">↔</b> 카드를 드래그해 순서 변경</span>
                                    <small>왼쪽이 선봉</small>
                                </div>
                                <article class="mi-formation-main">
                                    <i style="background-image:url('@snapshot.Party.ActiveHero.SpriteAssetUrl')"></i>
                                    <span><small>본체 · 원정대장</small><strong>@snapshot.Party.ActiveHero.Name</strong></span>
                                </article>
                                <div class="mi-formation-slots">
                                    @for (var slot = 0; slot < snapshot.Party.Companions.Count; slot++)
                                    {
                                        var hero = snapshot.Party.Companions[slot];
                                        var position = slot;
                                        <article @key="hero.HeroId" class="mi-formation-unit slot-@position" data-hero-id="@hero.HeroId">
                                            <header><span>@(position + 1)</span><b class="mi-drag-handle" aria-hidden="true">⠿</b></header>
                                            <i style="background-image:url('@hero.SpriteAssetUrl'); --sprite-x:@hero.SpriteFocusX%; --sprite-y:@hero.SpriteFocusY%;"></i>
                                            <span><strong>@hero.Name</strong><small>@hero.Role</small></span>
                                            <div class="mi-formation-unit-actions">
                                                <button type="button" disabled="@(actionBusy || position == 0)" @onclick="() => MoveCompanionAsync(hero.HeroId, -1)" aria-label="@hero.Name 앞 위치로">←</button>
                                                <button type="button" disabled="@(actionBusy || position == snapshot.Party.Companions.Count - 1)" @onclick="() => MoveCompanionAsync(hero.HeroId, 1)" aria-label="@hero.Name 뒤 위치로">→</button>
                                            </div>
                                        </article>
                                    }
                                </div>
                            </div>
                            <div class="mi-companion-sortbar" role="group" aria-label="동료 목록 정렬">
                                <span>목록 정렬</span>
                                <button type="button" class="@(companionRosterSort == "default" ? "is-selected" : null)" @onclick='() => companionRosterSort = "default"'>기본순</button>
                                <button type="button" class="@(companionRosterSort == "rarity-desc" ? "is-selected" : null)" @onclick='() => companionRosterSort = "rarity-desc"'>전설 → 희귀</button>
                                <button type="button" class="@(companionRosterSort == "rarity-asc" ? "is-selected" : null)" @onclick='() => companionRosterSort = "rarity-asc"'>희귀 → 전설</button>
                            </div>
                            <div class="mi-companion-card-grid mi-formation-roster">
                                @foreach (var hero in SortedFormationCompanions)
                                {
                                    var selected = snapshot.Party.Companions.Any(item => item.HeroId == hero.HeroId);
                                    <button type="button" class="mi-companion-card rarity-@hero.Rarity.ToString().ToLowerInvariant() @(selected ? "is-selected" : null)" disabled="@(actionBusy || (!selected && snapshot.Party.CompanionCount >= PartyRules.MaximumCompanions))" @onclick="() => ToggleCompanionAsync(hero.HeroId)">
                                        <i style="background-image:url('@hero.SpriteAssetUrl'); --sprite-x:@hero.SpriteFocusX%; --sprite-y:@hero.SpriteFocusY%;"></i>
                                        <span><strong>@hero.Name</strong><small><mark class="mi-rarity-mark rarity-@hero.Rarity.ToString().ToLowerInvariant()">@RarityName(hero.Rarity)</mark>@hero.Role</small><em>지원 공격 +@hero.AssistPowerPercent%</em></span>
                                        <b>@(selected ? "출전" : "대기")</b>
                                    </button>
                                }
                            </div>
                        </section>
                    }
                    else if (companionTab == "growth")
                    {
                        <section class="mi-companion-management mi-growth-management">
                            <header><div><small>COMPANION GROWTH</small><strong>독립 성장</strong></div><span class="mi-premium-balance">C @FormatNumber(snapshot.PremiumCurrency)</span></header>
                            <p>금화 육성, 조각 승급, 개인 장비와 외형 보너스가 동료별로 따로 저장됩니다.</p>
                            @if (SelectedCompanionGrowth is not null)
                            {
                                var growth = SelectedCompanionGrowth;
                                <div class="mi-growth-workspace">
                                    <nav class="mi-growth-roster" aria-label="육성할 동료 선택">
                                        @foreach (var candidate in FormationCompanionGrowth)
                                        {
                                            <button type="button" class="hero-@candidate.Hero.HeroId @candidate.ActiveSkin.CssClass @(candidate.Hero.HeroId == growth.Hero.HeroId ? "is-selected" : null)" @onclick="() => SelectCompanion(candidate.Hero.HeroId)">
                                                <i style="background-image:url('@candidate.ActiveSkin.AssetUrl'); --sprite-x:@candidate.Hero.SpriteFocusX%; --sprite-y:@candidate.Hero.SpriteFocusY%;"></i>
                                                <span><strong>@candidate.Hero.Name</strong><small>Lv.@candidate.Level · @candidate.Rank 성</small></span>
                                            </button>
                                        }
                                    </nav>
                                    <article class="mi-growth-detail hero-@growth.Hero.HeroId @growth.ActiveSkin.CssClass">
                                        <header>
                                            <i style="background-image:url('@growth.ActiveSkin.AssetUrl'); --sprite-x:@growth.Hero.SpriteFocusX%; --sprite-y:@growth.Hero.SpriteFocusY%;"></i>
                                            <div><small>@growth.Hero.Role</small><h3>@growth.Hero.Name</h3><span>Lv.@growth.Level · @growth.Rank 성</span></div>
                                            <strong>전투 지원 +@growth.AttackPercent%</strong>
                                        </header>
                                        <dl class="mi-growth-stats"><div><dt>공격</dt><dd>+@growth.AttackPercent%</dd></div><div><dt>생명</dt><dd>+@growth.HealthPercent%</dd></div><div><dt>방어</dt><dd>+@growth.DefensePercent%</dd></div></dl>
                                        <div class="mi-growth-actions">
                                            <button type="button" disabled="@(actionBusy || snapshot.Gold < growth.LevelUpCost || growth.Level >= int.MaxValue)" @onclick="() => UpgradeCompanionLevelAsync(growth.Hero.HeroId)"><span>금화 육성</span><small>@(growth.Level >= int.MaxValue ? "시스템 최대" : $"{FormatNumber(growth.LevelUpCost)} 금화 · 레벨 제한 없음")</small></button>
                                            <button type="button" disabled="@(actionBusy || growth.Shards < growth.RankUpShardCost || !CompanionProgressionRules.CanRankUp(growth.Rank))" @onclick="() => RankUpCompanionAsync(growth.Hero.HeroId)"><span>@(growth.Rank >= 10 ? "한계 돌파 승급" : "조각 승급")</span><small>@(CompanionProgressionRules.CanRankUp(growth.Rank) ? $"{FormatNumber(growth.Shards)} / {FormatNumber(growth.RankUpShardCost)} 조각 · {growth.Rank + 1:N0}성" : "시스템 최대")</small></button>
                                        </div>
                                        <p class="mi-companion-message">10성 이후에도 조각으로 계속 승급합니다. 매 승급 시 공격 +3%p · 생명 +4%p · 방어 +2%p (피해 감소는 최대 75%).</p>
                                        <section class="mi-personal-equipment mi-equipment-inventory">
                                            <h4><span>@growth.Hero.Name 착용 장비 <small>전용 무기: @WeaponTypeName(growth.Hero.WeaponType)</small></span></h4>
                                            <div class="mi-equipped-slots">
                                                @foreach (var slot in EquipmentSlots)
                                                {
                                                    var equippedItem = growth.Equipment.FirstOrDefault(item => item.Definition.Slot == slot);
                                                    <button type="button" class="mi-equipped-slot-button @(equippedItem is null ? "is-empty" : "is-equipped")" @onclick="() => OpenCompanionEquipmentPicker(slot)">
                                                        @if (equippedItem is null)
                                                        {
                                                            <i><span>+</span></i><span><small>@EquipmentSlotName(slot)</small><strong>미착용</strong><em>눌러서 장비 선택</em></span><b>선택</b>
                                                        }
                                                        else
                                                        {
                                                            <i class="@EquipmentArtCss(equippedItem.Definition)"><img src="@equippedItem.Definition.AssetUrl" alt="" /><b>+@equippedItem.Instance.Level</b></i><span><small>@EquipmentRarityName(equippedItem.Instance.Rarity) · @EquipmentSlotName(slot)</small><strong>@equippedItem.DisplayName</strong><em>@EquipmentBonus(equippedItem)</em></span><b>변경</b>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        </section>
                                        <section class="mi-companion-skins">
                                            <h4>외형 의장 <small>보유 효과는 장착 시 적용</small></h4>
                                            <div>
                                                @foreach (var skin in growth.Skins)
                                                {
                                                    var owned = growth.OwnedSkinIds.Contains(skin.SkinId);
                                                    var active = growth.ActiveSkinId == skin.SkinId;
                                                    <button type="button" class="hero-@growth.Hero.HeroId @skin.CssClass @(active ? "is-active" : null)" disabled="@(actionBusy || active || (!owned && snapshot.PremiumCurrency < skin.PriceC))" @onclick="() => SelectOrPurchaseSkinAsync(growth.Hero.HeroId, skin.SkinId)">
                                                        <i><img src="@skin.AssetUrl" alt="@skin.Name 미리보기" /></i>
                                                        <span><strong>@skin.Name</strong><small>공 +@skin.AttackPercent% · 생 +@skin.HealthPercent% · 방 +@skin.DefensePercent%</small></span><em>@(active ? "사용 중" : owned ? "선택" : $"C {skin.PriceC:N0}")</em>
                                                    </button>
                                                }
                                            </div>
                                        </section>
                                        @if (!string.IsNullOrWhiteSpace(companionActionMessage)) { <p class="mi-companion-message">@companionActionMessage</p> }
                                        @if (HostEnvironment.IsDevelopment()) { <button type="button" class="mi-dev-premium" disabled="@actionBusy" @onclick="GrantDevelopmentCurrencyAsync">로컬 결제 테스트 · C 600 충전</button> }
                                    </article>
                                </div>
                            }
                        </section>
                    }
                    else if (companionTab == "summon")
                    {
                        <section class="mi-summon-panel @(latestSummonRewards.Count > 10 ? "has-many-results" : null)">
                            <header><div><small>COMPANION SUMMON</small><strong>인연 소환</strong></div><span>소환패 @FormatNumber(snapshot.HeroSummonTickets)</span></header>
                            <div class="mi-pity-stack">
                                <div class="mi-pity-track is-epic"><span style="width:@(snapshot.HeroSummonPity * 100d / CompanionSummonPolicy.PityThreshold)%"></span><strong>영웅 이상 확정까지 @(CompanionSummonPolicy.EpicGuaranteePulls - snapshot.HeroSummonPity)회</strong></div>
                                <div class="mi-pity-track is-legendary"><span style="width:@(snapshot.LegendarySummonPity * 100d / CompanionSummonPolicy.LegendaryPityThreshold)%"></span><strong>전설 확정까지 @(CompanionSummonPolicy.LegendaryGuaranteePulls - snapshot.LegendarySummonPity)회</strong></div>
                            </div>
                            <p>동료 등장률 12% · 희귀 9.5% · 영웅 2% · 전설 0.5%. 자연 등장과 별개로 영웅 이상은 50회, 전설은 1,000회 안에 반드시 등장하며 중복은 등급별 전용 조각으로 전환됩니다.</p>
                            <div class="mi-summon-controls">
                                <div class="mi-summon-counts" role="radiogroup" aria-label="빠른 소환 횟수 선택">
                                    @foreach (var count in SummonCountOptions)
                                    {
                                        <button type="button" role="radio" aria-checked="@(summonCount == count ? "true" : "false")" class="@(summonCount == count ? "is-selected" : null)" @onclick="() => SetSummonCount(count)">@count 회</button>
                                    }
                                </div>
                                <div class="mi-summon-stepper" aria-label="소환 횟수 직접 조절">
                                    <button type="button" disabled="@(actionBusy || summonCount <= MinimumSummonCount)" @onclick="() => AdjustSummonCount(-1)" aria-label="소환 횟수 1회 줄이기">−</button>
                                    <span><small>선택한 소환</small><output>@summonCount 회</output></span>
                                    <button type="button" disabled="@(actionBusy || summonCount >= MaximumSummonCount)" @onclick="() => AdjustSummonCount(1)" aria-label="소환 횟수 1회 늘리기">+</button>
                                </div>
                            </div>
                            <button class="mi-summon-button" type="button" disabled="@(actionBusy || snapshot.HeroSummonTickets < summonCount)" @onclick="SummonCompanionsAsync"><span>@(snapshot.HeroSummonTickets < summonCount ? "소환패 부족" : $"{summonCount}회 소환")</span><small>소환패 @summonCount 장 · 소환 후 @FormatNumber(Math.Max(0, snapshot.HeroSummonTickets - summonCount))장</small></button>
                            @if (!string.IsNullOrWhiteSpace(summonMessage)) { <p class="mi-summon-message">@summonMessage</p> }
                            <div class="mi-summon-reveal @(latestSummonRewards.Count > 0 ? "is-open" : null) @(latestSummonRewards.Count > 10 ? "is-many" : null) @(actionBusy ? "is-summoning" : null)" @key="summonRevealSequence" aria-live="polite" aria-busy="@actionBusy">
                                <div class="mi-summon-magic" aria-hidden="true">
                                    <i class="mi-summon-sigil"></i><i class="mi-summon-ring"></i><b></b>
                                    <span></span><span></span><span></span><span></span><span></span><span></span>
                                </div>
                                <div class="mi-summon-reveal-content">
                                    @if (latestSummonRewards.Count == 0)
                                    {
                                        <div class="mi-summon-empty"><small>FATE RESONANCE</small><strong>인연의 문이 열립니다</strong><span>소환 횟수를 선택하고 인연을 불러오세요</span></div>
                                    }
                                    else
                                    {
                                        <header class="mi-summon-result-summary">
                                            <div><small>SUMMON RESULT</small><strong>@(latestSummonRewards.Count)개 전체 보상</strong></div>
                                            @if (latestSummonRewards.Count > 10) { <span>↕ 스크롤해 모두 확인</span> }
                                        </header>
                                        <div class="mi-summon-result-grid count-@Math.Min(latestSummonRewards.Count, 10)">
                                            @foreach (var reward in latestSummonRewards)
                                            {
                                                var rewardHero = reward.HeroId is null ? null : PartyRules.AllCompanions.FirstOrDefault(hero => hero.HeroId == reward.HeroId);
                                                <article class="kind-@reward.Kind.ToString().ToLowerInvariant() @(reward.Rarity is null ? null : $"rarity-{RarityCss(reward.Rarity.Value)}")">
                                                    @if (rewardHero is not null) { <i style="background-image:url('@rewardHero.SpriteAssetUrl')"></i> }
                                                    else
                                                    {
                                                        <i class="mi-summon-reward-art"><img src="@(reward.Kind == CompanionSummonRewardKind.Gold ? "/images/maru-idle/rewards/gold-pouch.svg" : "/images/maru-idle/rewards/companion-ore.svg")" alt="" /></i>
                                                    }
                                                    <small>@(reward.RolledHero ? $"{RarityName(reward.Rarity ?? CompanionRarity.Rare)} · {(reward.WasDuplicate ? "중복" : "신규 동료")}" : "인연 보상")</small><strong>@reward.DisplayName</strong><span>× @FormatNumber(reward.Quantity)</span>
                                                </article>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <section class="mi-summon-ticket-shop" aria-label="CodeMaru C 소환패 상점">
                                <header><div><small>SUMMON TICKET SHOP</small><strong>소환패 교환소</strong></div><span>보유 C <b>@FormatNumber(snapshot.PremiumCurrency)</b></span></header>
                                <div>
                                    @foreach (var pack in SummonTicketPackCatalog)
                                    {
                                        <button type="button" disabled="@(actionBusy || snapshot.PremiumCurrency < pack.PriceC)" @onclick="() => PurchaseSummonTicketPackAsync(pack.PackKey)"><span><strong>소환패 @pack.Tickets 장</strong><small>@pack.Label</small></span><b>C @FormatNumber(pack.PriceC)</b></button>
                                    }
                                </div>
                            </section>
                            <div class="mi-summon-economy"><span><strong>무료 획득</strong><small>스테이지 최초 클리어마다 +1</small></span><span><strong>천장 공유</strong><small>무료·구매 소환 모두 누적 횟수에 포함</small></span></div>
                        </section>
                    }
                    else if (companionTab == "inheritance")
                    {
                        <section class="mi-inheritance-panel">
                            <header><div><small>ACCOUNT INHERITANCE</small><strong>본체 공용 성장</strong></div><span>ACCOUNT BOUND</span></header>
                            <p class="mi-inheritance-compact-copy">장식 영역 없이 현재 수치와 부위별 강화 기능만 표시합니다. 무기·갑주·옥패는 각각 독립 성장합니다.</p>
                            <div class="mi-inheritance-stat-grid" aria-label="계승 성장 현황">
                                <article><span><img src="/images/maru-idle/icons-premium/forge.png" alt="" /></span><div><small>계승된 검 단계</small><strong>Lv.@snapshot.AttackLevel</strong></div><em>검</em></article>
                                <article><span><img src="/images/maru-idle/icons-premium/sword-art.png" alt="" /></span><div><small>계승된 검술</small><strong>Lv.@snapshot.SwordArtLevel</strong></div><em>술</em></article>
                                <article><span><img src="/images/maru-idle/icons-premium/equipment.png" alt="" /></span><div><small>계승 장비 합계</small><strong>+@(snapshot.WeaponEquipmentLevel + snapshot.ArmorEquipmentLevel + snapshot.JadeEquipmentLevel)</strong></div><em>裝</em></article>
                                <article class="is-power"><span><img src="/images/maru-idle/icons-premium/forge.png" alt="" /></span><div><small>현재 원정대 총 공격력</small><strong>@FormatNumber(snapshot.AttackPower)</strong></div><em>POWER</em></article>
                            </div>
                            <section class="mi-inheritance-forge" aria-label="계승 장비 단련소">
                                <header><div><small>LEGACY FORGE</small><strong>계승 장비 단련소</strong></div><span>보유 금화 @FormatNumber(snapshot.Gold)</span></header>
                                <div class="mi-inheritance-loadout" role="tablist" aria-label="확인할 계승 장비 선택">
                                    <button type="button" role="tab" aria-selected="@(selectedInheritanceSlot == "weapon")" class="@(selectedInheritanceSlot == "weapon" ? "is-selected" : null)" @onclick='() => SelectInheritanceSlot("weapon")'><img src="/images/maru-idle/icons-premium/forge.png" alt="" /><span><small>천명 무기</small><strong>+@snapshot.WeaponEquipmentLevel</strong></span></button>
                                    <button type="button" role="tab" aria-selected="@(selectedInheritanceSlot == "armor")" class="@(selectedInheritanceSlot == "armor" ? "is-selected" : null)" @onclick='() => SelectInheritanceSlot("armor")'><img src="/images/maru-idle/icons-premium/equipment.png" alt="" /><span><small>수호 갑주</small><strong>+@snapshot.ArmorEquipmentLevel</strong></span></button>
                                    <button type="button" role="tab" aria-selected="@(selectedInheritanceSlot == "jade")" class="@(selectedInheritanceSlot == "jade" ? "is-selected" : null)" @onclick='() => SelectInheritanceSlot("jade")'><img src="/images/maru-idle/icons-premium/companions.png" alt="" /><span><small>인연 옥패</small><strong>+@snapshot.JadeEquipmentLevel</strong></span></button>
                                </div>
                                <article class="mi-inheritance-gear-detail" @key="@($"{selectedInheritanceSlot}-{equipmentUpgradeSequence}")">
                                    <figure><img src="@SelectedInheritanceAsset" alt="" /><i></i></figure>
                                    <div>
                                        <small>@SelectedInheritanceEyebrow</small><strong>@SelectedInheritanceName</strong><p>@SelectedInheritanceEffect</p>
                                        <div class="mi-inheritance-tier"><span><b style="width:@InheritanceTierPercent%"></b></span><small>다음 계승 등급까지 @(5 - SelectedInheritanceLevel % 5)단계</small></div>
                                    </div>
                                </article>
                                @if (!string.IsNullOrWhiteSpace(equipmentMessage)) { <p class="mi-inheritance-message">@equipmentMessage</p> }
                                <div class="mi-inheritance-batch" role="radiogroup" aria-label="연속 단련 횟수">
                                    <button type="button" role="radio" aria-checked="@(equipmentUpgradeBatch == 1)" class="@(equipmentUpgradeBatch == 1 ? "is-selected" : null)" @onclick="() => SetEquipmentUpgradeBatch(1)">1회</button>
                                    <button type="button" role="radio" aria-checked="@(equipmentUpgradeBatch == 10)" class="@(equipmentUpgradeBatch == 10 ? "is-selected" : null)" @onclick="() => SetEquipmentUpgradeBatch(10)">10회</button>
                                    <button type="button" role="radio" aria-checked="@(equipmentUpgradeBatch == 0)" class="@(equipmentUpgradeBatch == 0 ? "is-selected" : null)" @onclick="() => SetEquipmentUpgradeBatch(0)">최대</button>
                                </div>
                                <button class="mi-inheritance-upgrade" type="button" disabled="@(actionBusy || EquipmentBatchLevels == 0)" @onclick="UpgradeEquipmentBatchAsync"><img src="@SelectedInheritanceAsset" alt="" /><span><strong>@(EquipmentBatchLevels == 0 ? "단련할 금화가 부족합니다" : $"{SelectedInheritanceLabel} +{EquipmentBatchLevels} 단련")</strong><small>@(EquipmentBatchLevels == 0 ? $"필요 금화 {FormatNumber(SelectedInheritanceUpgradeCost)}" : $"{FormatNumber(EquipmentBatchCost)} 금화 · 선택 부위만 적용")</small></span><b>단련</b></button>
                            </section>
                        </section>
                    }
                    else
                    {
                        <section class="mi-companion-management">
                            <header><div><small>COMPANION CODEX</small><strong>동료 도감</strong></div><span>@snapshot.Party.AvailableCompanions.Count / @PartyRules.AllCompanions.Count</span></header>
                            <p>전투에는 5명만 데려가지만 동료 카탈로그는 콘텐츠 추가에 따라 계속 확장됩니다.</p>
                            <div class="mi-companion-codex-scroll">
                                @foreach (var rarityGroup in PartyRules.AllCompanions.GroupBy(hero => hero.Rarity).OrderByDescending(group => group.Key))
                                {
                                    <section class="mi-rarity-group rarity-@RarityCss(rarityGroup.Key)">
                                        <header><strong>@RarityName(rarityGroup.Key)</strong><span>@rarityGroup.Count(hero => snapshot.Party.AvailableCompanions.Any(item => item.HeroId == hero.HeroId)) / @rarityGroup.Count()</span></header>
                                        <div class="mi-codex-card-grid">
                                            @foreach (var hero in rarityGroup)
                                            {
                                                var unlocked = snapshot.Party.AvailableCompanions.Any(item => item.HeroId == hero.HeroId);
                                                <article class="mi-companion-card @(unlocked ? "is-owned" : "is-locked")"><i style="background-image:url('@hero.SpriteAssetUrl'); --sprite-x:@hero.SpriteFocusX%; --sprite-y:@hero.SpriteFocusY%;"></i><span><strong>@(unlocked ? hero.Name : "미확인 동료")</strong><small>@(unlocked ? hero.Role : $"{RarityName(hero.Rarity)} 소환으로 영입")</small><em>@(unlocked ? $"지원 공격 +{hero.AssistPowerPercent}%" : "도감 미등록")</em></span></article>
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                        </section>
                    }
                }
                else if (IsBodyGrowthPanel)
                {
                    <nav class="mi-companion-tabs mi-body-growth-tabs" aria-label="본체 성장 메뉴">
                        <button type="button" class="@(activePanel == "upgrade" ? "is-selected" : null)" @onclick='() => OpenPanel("upgrade")'>검 강화</button>
                        <button type="button" class="@(activePanel == "skills" ? "is-selected" : null)" @onclick='() => OpenPanel("skills")'>검술 수련</button>
                        <button type="button" class="@(activePanel == "equipment" ? "is-selected" : null)" @onclick='() => OpenPanel("equipment")'>계승 장비</button>
                    </nav>
                    @if (activePanel == "upgrade")
                    {
                        <section class="mi-body-growth-pane mi-forge-growth-pane">
                            <article class="mi-growth-keyart mi-forge-keyart">
                                <img src="/images/maru-idle/growth/body-forge-v1.png" alt="연수가 천명검을 단련하는 모습" />
                                <div><small>DESTINY FORGE · @SwordForgeTierName</small><h3>천명검 담금질</h3><p>검신에 축적된 불꽃과 옥빛 기운을 깨워 본체의 기본 공격력을 계승합니다.</p><span>계정 영구 성장</span></div>
                                <b>Lv.@snapshot.AttackLevel</b>
                            </article>
                            <div class="mi-growth-summary mi-premium-growth-summary"><div><small>현재 검 단계</small><strong>Lv.@snapshot.AttackLevel</strong><span>@SwordForgeTierName</span></div><div><small>현재 원정대 공격력</small><strong>@FormatNumber(snapshot.AttackPower)</strong><span>편성 지원력 포함</span></div><div><small>다음 담금질</small><strong>Lv.@(snapshot.AttackLevel + 1)</strong><span>@FormatNumber(snapshot.UpgradeCost) 금화</span></div></div>
                            <section class="mi-growth-track">
                                <header><div><small>FORGE RESONANCE</small><strong>다음 검 등급까지</strong></div><span>Lv.@NextSwordForgeMilestone</span></header>
                                <div><i style="width:@SwordForgeProgressPercent%"></i><b>@SwordForgeProgressPercent%</b></div>
                                <footer><span>현재 Lv.@snapshot.AttackLevel</span><span>등급 승격 Lv.@NextSwordForgeMilestone</span></footer>
                            </section>
                            <div class="mi-growth-benefit-grid">
                                <article><img src="/images/maru-idle/icons-premium/forge.png" alt="" /><span><small>즉시 효과</small><strong>기본 공격 강화</strong><p>모든 공격과 치명타의 기반 피해가 상승합니다.</p></span></article>
                                <article><img src="/images/maru-idle/icons-premium/companions.png" alt="" /><span><small>계승 범위</small><strong>전체 원정대 적용</strong><p>대표 캐릭터와 현재 편성을 바꿔도 효과가 유지됩니다.</p></span></article>
                                <article><img src="/images/maru-idle/icons-premium/equipment.png" alt="" /><span><small>연계 성장</small><strong>무기 계승 증폭</strong><p>계승 무기와 검술 보너스가 최종 공격력에 함께 반영됩니다.</p></span></article>
                            </div>
                            <aside class="mi-growth-lore"><span>검로 기록</span><p>열 번의 담금질마다 검의 공명이 한 단계 깊어집니다. 금화만 소비하며 실패하거나 단계가 하락하지 않습니다.</p></aside>
                            <div class="mi-inheritance-batch mi-body-growth-batch" role="radiogroup" aria-label="검 연속 강화 횟수">
                                <button type="button" role="radio" aria-checked="@(bodyGrowthBatch == 1)" class="@(bodyGrowthBatch == 1 ? "is-selected" : null)" @onclick="() => SetBodyGrowthBatch(1)">1회</button>
                                <button type="button" role="radio" aria-checked="@(bodyGrowthBatch == 10)" class="@(bodyGrowthBatch == 10 ? "is-selected" : null)" @onclick="() => SetBodyGrowthBatch(10)">10회</button>
                                <button type="button" role="radio" aria-checked="@(bodyGrowthBatch == 0)" class="@(bodyGrowthBatch == 0 ? "is-selected" : null)" @onclick="() => SetBodyGrowthBatch(0)">최대 <small>1,000회</small></button>
                            </div>
                            <button class="mi-upgrade" type="button" disabled="@(SwordBatchLevels == 0 || actionBusy)" @onclick="UpgradeSwordAsync">검 벼리기 +@SwordBatchLevels <small>@(SwordBatchLevels == 0 ? $"필요 금화 {FormatNumber(snapshot.UpgradeCost)}" : $"{FormatNumber(SwordBatchCost)} 금화")</small></button>
                        </section>
                    }
                    else if (activePanel == "skills")
                    {
                        <section class="mi-body-growth-pane mi-sword-art-growth-pane">
                            <article class="mi-growth-keyart mi-sword-art-keyart">
                                <img src="/images/maru-idle/growth/sword-arts-v1.png" alt="연수가 월광 아래 검술을 펼치는 모습" />
                                <div><small>SWORD ART MANUAL · @SwordArtDisciplineName</small><h3>청월 검결</h3><p>호흡과 검로를 하나로 이어 연속 참격과 치명타의 위력을 끌어올립니다.</p><span>수련 실패 없음</span></div>
                                <b>Lv.@snapshot.SwordArtLevel</b>
                            </article>
                            <div class="mi-growth-summary mi-premium-growth-summary"><div><small>수련 단계</small><strong>Lv.@snapshot.SwordArtLevel</strong><span>@SwordArtDisciplineName</span></div><div><small>검술 추가 공격력</small><strong>+@FormatNumber(snapshot.SwordArtAttackBonus)</strong><span>기본 공격에 합산</span></div><div><small>현재 총 공격력</small><strong>@FormatNumber(snapshot.AttackPower)</strong><span>모든 보너스 적용</span></div></div>
                            <section class="mi-growth-track mi-sword-art-track">
                                <header><div><small>MASTERY PATH</small><strong>다음 오의 해금까지</strong></div><span>Lv.@NextSwordArtMilestone</span></header>
                                <div><i style="width:@SwordArtProgressPercent%"></i><b>@SwordArtProgressPercent%</b></div>
                                <footer><span>현재 Lv.@snapshot.SwordArtLevel</span><span>@NextSwordArtName</span></footer>
                            </section>
                            <div class="mi-skill-grid mi-premium-skill-grid" aria-label="검술 수련 계보">
                                <article class="@(snapshot.SwordArtLevel >= 1 ? "is-unlocked" : null)"><span>Ⅰ</span><i>流</i><strong>유성 베기</strong><small>@(snapshot.SwordArtLevel >= 1 ? "습득 완료" : "Lv.1 해금")</small><p>빠른 초식으로 검광을 남겨 기본 피해를 증폭합니다.</p></article>
                                <article class="@(snapshot.SwordArtLevel >= 5 ? "is-unlocked" : null)"><span>Ⅱ</span><i>月</i><strong>반월 참</strong><small>@(snapshot.SwordArtLevel >= 5 ? "습득 완료" : "Lv.5 해금")</small><p>반월의 검기를 넓게 펼쳐 다수의 적을 꿰뚫습니다.</p></article>
                                <article class="@(snapshot.SwordArtLevel >= 10 ? "is-unlocked" : null)"><span>Ⅲ</span><i>雷</i><strong>천뢰 일섬</strong><small>@(snapshot.SwordArtLevel >= 10 ? "습득 완료" : "Lv.10 해금")</small><p>찰나의 뇌광으로 치명적인 마무리 일격을 완성합니다.</p></article>
                            </div>
                            <aside class="mi-growth-lore"><span>사문 비전</span><p>수련 단계가 오를 때마다 추가 공격력이 누적됩니다. 오의는 자동으로 습득되며 별도의 장착이나 교체가 필요하지 않습니다.</p></aside>
                            <div class="mi-inheritance-batch mi-body-growth-batch" role="radiogroup" aria-label="검술 연속 수련 횟수">
                                <button type="button" role="radio" aria-checked="@(bodyGrowthBatch == 1)" class="@(bodyGrowthBatch == 1 ? "is-selected" : null)" @onclick="() => SetBodyGrowthBatch(1)">1회</button>
                                <button type="button" role="radio" aria-checked="@(bodyGrowthBatch == 10)" class="@(bodyGrowthBatch == 10 ? "is-selected" : null)" @onclick="() => SetBodyGrowthBatch(10)">10회</button>
                                <button type="button" role="radio" aria-checked="@(bodyGrowthBatch == 0)" class="@(bodyGrowthBatch == 0 ? "is-selected" : null)" @onclick="() => SetBodyGrowthBatch(0)">최대 <small>1,000회</small></button>
                            </div>
                            <button class="mi-upgrade" type="button" disabled="@(SwordArtBatchLevels == 0 || actionBusy)" @onclick="UpgradeSwordArtAsync">검술 수련 +@SwordArtBatchLevels <small>@(SwordArtBatchLevels == 0 ? $"필요 금화 {FormatNumber(snapshot.SwordArtUpgradeCost)}" : $"{FormatNumber(SwordArtBatchCost)} 금화")</small></button>
                        </section>
                    }
                    else
                    {
                    <section class="mi-body-growth-pane">
                    <div class="mi-growth-summary"><div><small>계승 장비 합계</small><strong>+@(snapshot.WeaponEquipmentLevel + snapshot.ArmorEquipmentLevel + snapshot.JadeEquipmentLevel)</strong></div><div><small>무기 공격 · 옥패 지원</small><strong>+@FormatNumber(snapshot.EquipmentAttackBonus) · +@snapshot.JadeAssistBonusPercent%</strong></div></div>
                    <div class="mi-equipment-grid" aria-label="장착 장비">
                        <article><span><img src="/images/maru-idle/icons-premium/forge.png" alt="" /></span><div><small>무기 · 공격력</small><strong>@EquipmentName("검", snapshot.WeaponEquipmentLevel)</strong></div><em>+@snapshot.WeaponEquipmentLevel</em></article>
                        <article><span><img src="/images/maru-idle/icons-premium/equipment.png" alt="" /></span><div><small>갑주 · 생명/방어</small><strong>@EquipmentName("도포", snapshot.ArmorEquipmentLevel)</strong></div><em>+@snapshot.ArmorEquipmentLevel</em></article>
                        <article><span><img src="/images/maru-idle/icons-premium/companions.png" alt="" /></span><div><small>옥패 · 동료 지원</small><strong>@EquipmentName("옥패", snapshot.JadeEquipmentLevel)</strong></div><em>+@snapshot.JadeEquipmentLevel</em></article>
                    </div>
                    <section class="mi-inheritance-forge mi-growth-inline-forge" aria-label="계승 장비 단련소">
                        <header><div><small>LEGACY FORGE</small><strong>부위별 계승 단련소</strong></div><span>보유 금화 @FormatNumber(snapshot.Gold)</span></header>
                        <div class="mi-inheritance-loadout" role="tablist" aria-label="강화할 계승 장비 선택">
                            <button type="button" role="tab" aria-selected="@(selectedInheritanceSlot == "weapon")" class="@(selectedInheritanceSlot == "weapon" ? "is-selected" : null)" @onclick='() => SelectInheritanceSlot("weapon")'><img src="/images/maru-idle/icons-premium/forge.png" alt="" /><span><small>천명 무기</small><strong>+@snapshot.WeaponEquipmentLevel</strong></span></button>
                            <button type="button" role="tab" aria-selected="@(selectedInheritanceSlot == "armor")" class="@(selectedInheritanceSlot == "armor" ? "is-selected" : null)" @onclick='() => SelectInheritanceSlot("armor")'><img src="/images/maru-idle/icons-premium/equipment.png" alt="" /><span><small>수호 갑주</small><strong>+@snapshot.ArmorEquipmentLevel</strong></span></button>
                            <button type="button" role="tab" aria-selected="@(selectedInheritanceSlot == "jade")" class="@(selectedInheritanceSlot == "jade" ? "is-selected" : null)" @onclick='() => SelectInheritanceSlot("jade")'><img src="/images/maru-idle/icons-premium/companions.png" alt="" /><span><small>인연 옥패</small><strong>+@snapshot.JadeEquipmentLevel</strong></span></button>
                        </div>
                        <article class="mi-inheritance-gear-detail" @key="@($"{selectedInheritanceSlot}-{equipmentUpgradeSequence}")">
                            <figure><img src="@SelectedInheritanceAsset" alt="" /><i></i></figure>
                            <div><small>@SelectedInheritanceEyebrow</small><strong>@SelectedInheritanceName</strong><p>@SelectedInheritanceEffect</p><div class="mi-inheritance-tier"><span><b style="width:@InheritanceTierPercent%"></b></span><small>다음 계승 등급까지 @(5 - SelectedInheritanceLevel % 5)단계</small></div></div>
                        </article>
                        @if (!string.IsNullOrWhiteSpace(equipmentMessage)) { <p class="mi-inheritance-message">@equipmentMessage</p> }
                        <div class="mi-inheritance-batch" role="radiogroup" aria-label="연속 단련 횟수">
                            <button type="button" role="radio" aria-checked="@(equipmentUpgradeBatch == 1)" class="@(equipmentUpgradeBatch == 1 ? "is-selected" : null)" @onclick="() => SetEquipmentUpgradeBatch(1)">1회</button>
                            <button type="button" role="radio" aria-checked="@(equipmentUpgradeBatch == 10)" class="@(equipmentUpgradeBatch == 10 ? "is-selected" : null)" @onclick="() => SetEquipmentUpgradeBatch(10)">10회</button>
                            <button type="button" role="radio" aria-checked="@(equipmentUpgradeBatch == 0)" class="@(equipmentUpgradeBatch == 0 ? "is-selected" : null)" @onclick="() => SetEquipmentUpgradeBatch(0)">최대</button>
                        </div>
                        <button class="mi-inheritance-upgrade" type="button" disabled="@(actionBusy || EquipmentBatchLevels == 0)" @onclick="UpgradeEquipmentBatchAsync"><img src="@SelectedInheritanceAsset" alt="" /><span><strong>@(EquipmentBatchLevels == 0 ? "단련할 금화가 부족합니다" : $"{SelectedInheritanceLabel} +{EquipmentBatchLevels} 단련")</strong><small>@(EquipmentBatchLevels == 0 ? $"필요 금화 {FormatNumber(SelectedInheritanceUpgradeCost)}" : $"{FormatNumber(EquipmentBatchCost)} 금화 · 선택 부위만 적용")</small></span><b>단련</b></button>
                    </section>
                    </section>
                    }
                }
                @if (activePanel == "companions" && companionTab == "growth" && selectedCompanionEquipmentSlot is { } pickerSlot && SelectedCompanionGrowth is { } pickerGrowth)
                {
                    var equippedItem = pickerGrowth.Equipment.FirstOrDefault(item => item.Definition.Slot == pickerSlot);
                    var availableItems = CompatibleUnequippedEquipment(pickerGrowth, pickerSlot);
                    <div class="mi-equipment-picker-backdrop" @onclick="CloseCompanionEquipmentPicker">
                        <section class="mi-equipment-picker" role="dialog" aria-modal="true" aria-labelledby="mi-equipment-picker-title" @onclick:stopPropagation="true">
                            <header>
                                <div><small>EQUIPMENT SELECT</small><h3 id="mi-equipment-picker-title">@pickerGrowth.Hero.Name · @EquipmentSlotName(pickerSlot) 선택</h3><p>@(pickerSlot == CompanionEquipmentSlot.Weapon ? $"{WeaponTypeName(pickerGrowth.Hero.WeaponType)} 계열 전용 장비만 표시합니다." : $"현재 장착할 수 있는 {EquipmentSlotName(pickerSlot)}만 표시합니다.")</p></div>
                                <button type="button" aria-label="장비 선택 닫기" @onclick="CloseCompanionEquipmentPicker">×</button>
                            </header>
                            <div class="mi-equipment-picker-summary"><span>사용 가능 <b>@availableItems.Count</b></span><span>미착용 @UnequippedEquipmentCount</span><strong>강화 광석 @FormatNumber(snapshot.CompanionUpgradeMaterials)</strong></div>
                            @if (equippedItem is not null)
                            {
                                <article class="mi-equipment-current rarity-@EquipmentRarityCss(equippedItem.Instance.Rarity)">
                                    <figure class="@EquipmentArtCss(equippedItem.Definition)"><img src="@equippedItem.Definition.AssetUrl" alt="" /><b>+@equippedItem.Instance.Level</b></figure>
                                    <div><small>현재 장착 · @EquipmentRarityName(equippedItem.Instance.Rarity)</small><strong>@equippedItem.DisplayName</strong><span>@EquipmentBonus(equippedItem)</span></div>
                                    <footer><button type="button" disabled="@(actionBusy || equippedItem.Instance.Level >= CompanionProgressionRules.MaximumEquipmentLevel || snapshot.CompanionUpgradeMaterials < equippedItem.UpgradeMaterialCost)" @onclick="() => UpgradeCompanionEquipmentAsync(pickerGrowth.Hero.HeroId, equippedItem.Instance.InstanceId)">@(equippedItem.Instance.Level >= CompanionProgressionRules.MaximumEquipmentLevel ? "강화 최대" : $"강화 · 광석 {equippedItem.UpgradeMaterialCost}")</button><button type="button" class="is-secondary" disabled="@actionBusy" @onclick="() => ToggleCompanionEquipmentAsync(pickerGrowth.Hero.HeroId, equippedItem.Instance.InstanceId)">장착 해제</button></footer>
                                </article>
                            }
                            <div class="mi-equipment-picker-list">
                                @if (availableItems.Count == 0)
                                {
                                    <div class="mi-equipment-picker-empty"><span>+</span><strong>장착 가능한 장비가 없습니다</strong><small>전투와 보스 처치로 @EquipmentSlotName(pickerSlot) 장비를 획득할 수 있습니다.</small></div>
                                }
                                else
                                {
                                    @foreach (var item in availableItems)
                                    {
                                        <article class="rarity-@EquipmentRarityCss(item.Instance.Rarity)">
                                            <figure class="@EquipmentArtCss(item.Definition)"><img src="@item.Definition.AssetUrl" alt="" /><b>+@item.Instance.Level</b></figure>
                                            <div><small>@EquipmentRarityName(item.Instance.Rarity) · @EquipmentTypeName(item.Definition)</small><strong>@item.DisplayName</strong><span>@EquipmentBonus(item)</span></div>
                                            <footer><button type="button" disabled="@actionBusy" @onclick="() => ToggleCompanionEquipmentAsync(pickerGrowth.Hero.HeroId, item.Instance.InstanceId)">장착</button><button type="button" disabled="@(actionBusy || item.Instance.Level >= CompanionProgressionRules.MaximumEquipmentLevel || snapshot.CompanionUpgradeMaterials < item.UpgradeMaterialCost)" @onclick="() => UpgradeCompanionEquipmentAsync(pickerGrowth.Hero.HeroId, item.Instance.InstanceId)">강화 <small>@item.UpgradeMaterialCost</small></button><button type="button" class="is-sell" disabled="@actionBusy" @onclick="() => SellCompanionEquipmentAsync(pickerGrowth.Hero.HeroId, item.Instance.InstanceId)">판매 <small>@FormatNumber(item.SellGold)</small></button></footer>
                                        </article>
                                    }
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(companionActionMessage)) { <p class="mi-equipment-picker-message">@companionActionMessage</p> }
                        </section>
                    </div>
                }
            </aside>
        }

        @if (powerSavingScreenOpen)
        {
            <aside class="mi-power-saving-screen" role="dialog" aria-modal="true" aria-label="절전 모드">
                <time datetime="@PowerSavingNow.ToString("O")"><strong>@PowerSavingNow.ToString("HH:mm")</strong><span>@PowerSavingDateText</span></time>
                <div class="mi-power-saving-emblem"><img src="/images/maru-idle/enemy-bell-fox.webp" alt="휴식 중인 원정 수호령" /></div>
                <section><small>CURRENT EXPEDITION</small><strong>St.@snapshot.Stage</strong><span>@snapshot.World.Region.Name · @(snapshot.AutoAttackEnabled ? "AUTO 원정 진행 중" : "원정 대기 중")</span>@if (snapshot.ActiveAutoSpeedMultiplier > 1) { <em>AUTO ×@snapshot.ActiveAutoSpeedMultiplier · @FormatBoostExpiry(snapshot.AutoSpeedBoostEndsUtc)</em> }</section>
                <label class="mi-power-saving-slider" style="--slide:@powerSavingUnlockProgress%"><input type="range" min="0" max="100" step="1" value="@powerSavingUnlockProgress" @oninput="OnPowerSavingSlide" @onchange="CompletePowerSavingSlide" /><span><i>›</i><strong>슬라이드로 복귀</strong></span></label>
            </aside>
        }

        @if (offlineRewardOpen)
        {
            <div class="mi-offline-backdrop" @onclick="CloseOfflineReward">
                <section class="mi-offline-card" role="dialog" aria-modal="true" aria-labelledby="offline-reward-title" @onclick:stopPropagation="true">
                    <button type="button" class="mi-offline-close" aria-label="방치 보상 닫기" @onclick="CloseOfflineReward">×</button>
                    <span>EXPEDITION REPORT</span>
                    <h2 id="offline-reward-title">방치 보상</h2>
                    @if (!snapshot.OfflineReward.IsUnlocked)
                    {
                        <div class="mi-offline-locked"><i aria-hidden="true">鎖</i><strong>Stage @(snapshot.OfflineReward.UnlockStage)에서 해금</strong><p>접속하지 않은 시간은 전투 요청을 반복하지 않고 서버가 한 번에 정산합니다.</p></div>
                    }
                    else
                    {
                        <div class="mi-offline-summary">
                            <small>현재 원정 수익</small><strong>@FormatNumber(snapshot.OfflineReward.PendingGold) 금화</strong><span>@FormatOfflineDuration(snapshot.OfflineReward.PendingDuration) 적립 · 시간당 @FormatNumber(snapshot.OfflineReward.GoldPerHour)</span>
                        </div>
                        <div class="mi-offline-progress" role="progressbar" aria-label="방치 보상 적립 시간" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@OfflineRewardPercent"><i style="width:@OfflineRewardPercent%"></i></div>
                        <p>최대 @FormatOfflineDuration(snapshot.OfflineReward.MaximumAccrual)까지 적립됩니다. 전투와 AUTO는 방치 정산과 분리되어 있습니다.</p>
                        <button type="button" class="mi-offline-claim" disabled="@(offlineClaimBusy || snapshot.OfflineReward.PendingGold <= 0)" @onclick="ClaimOfflineRewardAsync">@(offlineClaimBusy ? "정산 중…" : snapshot.OfflineReward.PendingGold > 0 ? "보상 수령" : "적립 중")</button>
                        @if (offlineRewardMessage is not null) { <output class="mi-offline-message">@offlineRewardMessage</output> }
                    }
                </section>
            </div>
        }

        @if (snapshot.ShowAutoUnlockNotice)
        {
            <div class="mi-unlock-backdrop" role="dialog" aria-modal="true" aria-labelledby="auto-unlock-title">
                <div class="mi-unlock-card"><span>A NEW RHYTHM</span><h2 id="auto-unlock-title">자동공격 해금</h2><p>Stage 15의 길을 돌파했습니다. AUTO 설정은 계정에 영구 저장됩니다.</p><button type="button" @onclick="AcknowledgeUnlockAsync">확인</button></div>
            </div>
        }

        @if (latestEquipmentDrop is not null)
        {
            <div class="mi-loot-toast is-equipment" role="status"><span>MONSTER EQUIPMENT DROP</span><figure class="@EquipmentArtCss(latestEquipmentDrop.Definition)"><img src="@latestEquipmentDrop.Definition.AssetUrl" alt="" /></figure><strong>@latestEquipmentDrop.DisplayName</strong><small>@EquipmentRarityName(latestEquipmentDrop.Instance.Rarity) · @EquipmentTypeName(latestEquipmentDrop.Definition) · 계정 공용 가방에 보관됨</small><button type="button" @onclick="DismissBoostDrop" aria-label="전리품 알림 닫기">×</button></div>
        }
        else if (latestBoostDrop is not null)
        {
            <div class="mi-loot-toast" role="status"><span>BOSS DROP · 3%</span><strong>@latestBoostDrop.Name</strong><small>빠른 메뉴 → 부적 사용에서 활성화할 수 있습니다.</small><button type="button" @onclick="DismissBoostDrop" aria-label="전리품 알림 닫기">×</button></div>
        }

        @if (showTutorial)
        {
            <div class="mi-tutorial" role="dialog" aria-modal="true"><div><span>기본 조작</span><h2>전투 영역을 누르면 공격합니다</h2><p>Space 키와 전투 영역 길게 누르기도 지원합니다. Stage 15를 넘으면 AUTO가 열립니다.</p><button type="button" @onclick="() => showTutorial = false">확인</button></div></div>
        }

        @if (settingsOpen)
        {
            <GameSettingsModal SavedSettings="gameSettings" CurrentAudio="audioSelection" ActiveTab="@settingsTab" ActiveTabChanged="value => settingsTab = value"
                               SupportsVibration="supportsVibration" AutoUnlocked="snapshot.AutoAttackUnlocked" IsAudioPaused="audioPaused"
                               Saving="settingsSaving" ErrorMessage="@settingsError" PreviewChanged="PreviewSettingsAsync" ApplyRequested="ApplySettingsAsync"
                               CloseRequested="CloseSettingsAsync" PreviousTrack="() => ChangeTrackAsync(-1)" NextTrack="() => ChangeTrackAsync(1)"
                               TogglePlayback="ToggleAudioPlaybackAsync" TutorialRequested="ShowTutorialAsync" />
        }
    </main>
}

@code {
    private static readonly TimeSpan LootToastDuration = TimeSpan.FromSeconds(5);
    private const int MinimumSummonCount = 1;
    private const int MaximumSummonCount = 100;
    private static readonly int[] SummonCountOptions = [1, 5, 10, 50, 100];
    private readonly CancellationTokenSource lifetimeCancellation = new();
    private readonly AutoAttackLoop autoLoop = new();
    private readonly AutoAttackLoop enemyLoop = new();
    private readonly List<DamagePopup> damagePopups = [];
    private readonly object transitionSync = new();
