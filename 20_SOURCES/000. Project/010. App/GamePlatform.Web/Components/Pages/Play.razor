    private Task EnsureVictoryTransitionAsync()
    {
        lock (transitionSync)
        {
            if (victoryTransitionTask is not { IsCompleted: false })
                victoryTransitionTask = RunVictoryTransitionAsync(lifetimeCancellation.Token);
            return victoryTransitionTask;
        }
    }

    private Task EnsureDefeatTransitionAsync()
    {
        lock (transitionSync)
        {
            if (defeatTransitionTask is not { IsCompleted: false })
                defeatTransitionTask = RunDefeatTransitionAsync(lifetimeCancellation.Token);
            return defeatTransitionTask;
        }
    }

    private async Task RunDefeatTransitionAsync(CancellationToken cancellationToken)
    {
        await Task.Delay(1250, cancellationToken);
        snapshot = await Session.RestartAfterDefeatAsync(cancellationToken);
        await InvokeAsync(StateHasChanged);
        await SyncAutoLoopAsync();
        SyncEnemyLoop();
    }

    private async Task RunVictoryTransitionAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(560, cancellationToken);
            snapshot = await Session.AdvanceCombatPhaseAsync(cancellationToken);
            backgroundTransition = true;
            backgroundFailed = false;
            await InvokeAsync(StateHasChanged);

            // 이미지·오디오 브라우저 연동은 전투 상태 머신을 막아서는 안 됩니다.
            _ = PreloadBackgroundSafelyAsync(snapshot.World.BackgroundUrl, cancellationToken);
            await Task.Delay(280, cancellationToken);
            displayedBackgroundUrl = snapshot.World.BackgroundUrl;
            backgroundTransition = false;
            snapshot = await Session.AdvanceCombatPhaseAsync(cancellationToken);
            _ = SyncRegionAudioSafelyAsync(cancellationToken);
            await InvokeAsync(StateHasChanged);
            if (snapshot.Phase == CombatPhase.Intro) await RunIntroAsync();
            _ = PreloadBackgroundSafelyAsync(snapshot.World.PreloadBackgroundUrl, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            settingsError = $"전투 화면 전환을 자동 복구했습니다. ({exception.Message})";
            await RecoverCombatTransitionAfterFailureAsync(cancellationToken);
        }
        finally
        {
            backgroundTransition = false;
            if (!lifetimeCancellation.IsCancellationRequested)
            {
                await SyncAutoLoopAsync();
                SyncEnemyLoop();
            }
        }
    }

    private async Task PreloadBackgroundSafelyAsync(string? backgroundUrl, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(backgroundUrl)) return;
        try
        {
            await JS.InvokeVoidAsync("maruIdle.preload", cancellationToken, backgroundUrl);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception)
        {
            backgroundFailed = true;
        }
    }

    private async Task SyncRegionAudioSafelyAsync(CancellationToken cancellationToken)
    {
        try { await SyncRegionAudioAsync(cancellationToken); }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            settingsError = $"지역 음악 전환에 실패했습니다. 전투는 계속됩니다. ({exception.Message})";
        }
    }

    private async Task RecoverCombatTransitionAfterFailureAsync(CancellationToken cancellationToken)
    {
        try
        {
            snapshot = Session.Snapshot;
            for (var step = 0; step < 3 && snapshot.Phase is CombatPhase.Victory or CombatPhase.Transitioning or CombatPhase.Intro; step++)
                snapshot = await Session.AdvanceCombatPhaseAsync(cancellationToken);
            displayedBackgroundUrl = snapshot.World.BackgroundUrl;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception)
        {
            // 다음 AUTO 틱이 현재 서버 단계에서 복구를 다시 시도합니다.
        }
    }

    private async Task RecoverAutomaticCombatAsync(CancellationToken cancellationToken)
    {
        switch (snapshot.Phase)
        {
            case CombatPhase.Victory:
                await EnsureVictoryTransitionAsync();
                break;
            case CombatPhase.Defeat:
                await EnsureDefeatTransitionAsync();
                break;
            case CombatPhase.Transitioning:
                snapshot = await Session.AdvanceCombatPhaseAsync(cancellationToken);
                if (snapshot.Phase == CombatPhase.Intro)
                    await RunIntroAsync();
                await InvokeAsync(StateHasChanged);
                SyncEnemyLoop();
                break;
            case CombatPhase.Intro:
                await RunIntroAsync();
                break;
        }
    }

    private async Task RunIntroAsync()
    {
        try { await Task.Delay(850, lifetimeCancellation.Token); snapshot = await Session.AdvanceCombatPhaseAsync(lifetimeCancellation.Token); await InvokeAsync(StateHasChanged); await SyncAutoLoopAsync(); SyncEnemyLoop(); }
        catch (OperationCanceledException) { }
    }

