    private async Task ApplySettingsAsync(GameSettings draft)
    {
        if (settingsSaving) return;
        settingsSaving = true;
        settingsError = null;
        try
        {
            var normalized = GameSettingsPolicy.Normalize(draft);
            if (snapshot.AutoAttackUnlocked && normalized.Combat.AutoEnabled != snapshot.AutoAttackEnabled)
            {
                snapshot = await Session.SetAutoAttackAsync(normalized.Combat.AutoEnabled, lifetimeCancellation.Token);
                await SyncAutoLoopAsync();
            }
            normalized.Combat.AutoEnabled = snapshot.AutoAttackEnabled;
            gameSettings = await SettingsService.SaveAsync(currentUserId, normalized, lifetimeCancellation.Token);
            await Audio.ApplySettingsAsync(gameSettings.Sound, lifetimeCancellation.Token);
            await JS.InvokeVoidAsync("maruIdle.configureIdleTimer", gameSettings.General.ScreenSaverTimeoutMinutes);
            settingsOpen = false;
            await InvokeAsync(StateHasChanged);
            await gameRoot.FocusAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            settingsError = $"설정을 저장하지 못했습니다. 기존 설정을 유지합니다. ({exception.Message})";
            await Audio.ApplySettingsAsync(gameSettings.Sound, lifetimeCancellation.Token);
        }
        finally { settingsSaving = false; }
    }

    private async Task ChangeTrackAsync(int direction)
    {
        var track = AudioResolver.ResolveAdjacent(audioSelection.Track.AssetKey, direction);
        audioSelection = audioSelection with { Track = track };
        await EnsureAudioUnlockedAsync();
        if (!audioUnlocked) return;
        try
        {
            await Audio.PlayMusicAsync(track, gameSettings.Sound, lifetimeCancellation.Token);
            await Audio.SetPausedAsync(ShouldPauseAudio, lifetimeCancellation.Token);
        }
        catch (JSException exception) { settingsError = $"곡을 재생하지 못했습니다. ({exception.Message})"; }
    }

    private async Task ToggleAudioPlaybackAsync()
    {
        if (!audioUnlocked) await EnsureAudioUnlockedAsync();
        audioPaused = !audioPaused;
        try { await Audio.SetPausedAsync(ShouldPauseAudio, lifetimeCancellation.Token); }
        catch (JSException exception) { settingsError = $"재생 상태를 변경하지 못했습니다. ({exception.Message})"; }
    }

    private async Task EnsureAudioUnlockedAsync()
    {
        if (!audioInitialized || audioUnlocked) return;
        try
        {
            audioUnlocked = await Audio.UnlockAsync(lifetimeCancellation.Token);
            if (!audioUnlocked) { showAudioUnlockHint = true; return; }
            await Audio.PlayMusicAsync(audioSelection.Track, gameSettings.Sound, lifetimeCancellation.Token);
            await Audio.SetPausedAsync(ShouldPauseAudio, lifetimeCancellation.Token);
            showAudioUnlockHint = false;
            await JS.InvokeVoidAsync("maruAudio.markUnlockHintSeen");
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException)
        {
            settingsError = $"브라우저가 음악 재생을 허용하지 않았습니다. ({exception.Message})";
            showAudioUnlockHint = true;
        }
    }

    /// <summary>브라우저의 첫 사용자 입력으로 오디오 제한이 해제되면 현재 지역 음악을 시작합니다.</summary>
    [JSInvokable("OnAudioGestureUnlocked")]
    public async Task OnAudioGestureUnlockedAsync()
    {
        if (!audioInitialized || audioUnlocked || lifetimeCancellation.IsCancellationRequested) return;
        audioUnlocked = true;
        showAudioUnlockHint = false;
        try
        {
            await Audio.PlayMusicAsync(audioSelection.Track, gameSettings.Sound, lifetimeCancellation.Token);
            await Audio.SetPausedAsync(ShouldPauseAudio, lifetimeCancellation.Token);
            await JS.InvokeVoidAsync("maruAudio.markUnlockHintSeen");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or OperationCanceledException)
        {
            audioUnlocked = false;
            showAudioUnlockHint = true;
        }
    }

    private async Task SyncRegionAudioAsync(CancellationToken cancellationToken)
    {
        var next = AudioResolver.Resolve(snapshot.Stage);
        if (next.Track.AssetKey == audioSelection.Track.AssetKey) { audioSelection = next; return; }
        audioSelection = next;
        if (!audioUnlocked) return;
        try
        {
            await Audio.PlayMusicAsync(next.Track, gameSettings.Sound, cancellationToken);
            await Audio.SetPausedAsync(ShouldPauseAudio, cancellationToken);
        }
        catch (JSException exception) { settingsError = $"지역 음악 전환에 실패했습니다. 전투는 계속됩니다. ({exception.Message})"; }
    }

