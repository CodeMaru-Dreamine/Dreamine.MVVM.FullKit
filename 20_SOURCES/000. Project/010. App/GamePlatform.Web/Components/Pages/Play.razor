    private async Task LoadAdminCommunicationsAsync()
    {
        if (string.IsNullOrWhiteSpace(currentUserId)) return;
        adminMailMessages = await CommunicationService.LoadForUserAsync(
            currentUserId,
            GameAdminMessageKind.Mail,
            cancellationToken: lifetimeCancellation.Token);
        adminAnnouncements = await CommunicationService.LoadForUserAsync(
            currentUserId,
            GameAdminMessageKind.Announcement,
            count: 20,
            cancellationToken: lifetimeCancellation.Token);
        latestAnnouncement = adminAnnouncements.FirstOrDefault(item => !IsMailRead(AdminNoticeReadKey(item)));
    }

