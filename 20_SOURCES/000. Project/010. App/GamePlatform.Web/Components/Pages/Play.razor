    [JSInvokable]
    public async Task CommitCompanionFormationAsync(string[] heroIds)
    {
        if (actionBusy || heroIds.Length != snapshot.Party.Companions.Count) return;
        var validIds = snapshot.Party.Companions.Select(hero => hero.HeroId).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (heroIds.Distinct(StringComparer.OrdinalIgnoreCase).Count() != heroIds.Length || heroIds.Any(heroId => !validIds.Contains(heroId))) return;
        await PersistCompanionFormationAsync(heroIds);
    }

    private async Task MoveCompanionAsync(string heroId, int offset)
    {
        if (actionBusy) return;
        var selected = snapshot.Party.Companions.Select(hero => hero.HeroId).ToList();
        var sourceIndex = selected.IndexOf(heroId);
        var targetIndex = sourceIndex + Math.Sign(offset);
        if (sourceIndex < 0 || targetIndex < 0 || targetIndex >= selected.Count) return;
        (selected[sourceIndex], selected[targetIndex]) = (selected[targetIndex], selected[sourceIndex]);
        await PersistCompanionFormationAsync(selected);
    }

