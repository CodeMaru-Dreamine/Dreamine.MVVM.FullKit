    private async Task SyncAutoLoopAsync()
    {
        if (snapshot.AutoAttackUnlocked && snapshot.AutoAttackEnabled && isPageVisible)
            autoLoop.Start(token => InvokeAsync(() => PerformAttackAsync(AttackSource.Automatic, token)), snapshot.AutoAttackInterval, lifetimeCancellation.Token);
        else await autoLoop.StopAsync();
