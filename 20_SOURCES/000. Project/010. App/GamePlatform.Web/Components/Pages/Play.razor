            gameSettings = await SettingsService.SaveAsync(currentUserId, gameSettings, lifetimeCancellation.Token);
            Channel = null;
            serviceMessage = $"{SelectedChannel} 채널로 계정이 확정되었습니다. 이후에는 변경할 수 없습니다.";
