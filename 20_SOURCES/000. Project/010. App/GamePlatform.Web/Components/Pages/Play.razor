    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirst(Dreamine.Identity.DreamineIdentityExtensions.UserIdClaimType)?.Value
                         ?? authenticationState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                         ?? authenticationState.User.FindFirst(ClaimTypes.Email)?.Value;
            if (string.IsNullOrWhiteSpace(userId)) { errorMessage = "로그인 계정의 사용자 식별자를 확인할 수 없습니다."; return; }
            currentUserId = userId;
            var loginDisplayName = authenticationState.User.Identity?.Name
                                   ?? authenticationState.User.FindFirst(ClaimTypes.Email)?.Value
                                   ?? $"검객-{userId[^Math.Min(4, userId.Length)..]}";
            snapshot = await Session.InitializeAsync(userId, lifetimeCancellation.Token);
            currentDisplayName = string.IsNullOrWhiteSpace(snapshot.GameNickname)
                ? loginDisplayName
                : snapshot.GameNickname;
            gameSettings = await SettingsService.LoadAsync(userId, cancellationToken: lifetimeCancellation.Token);
            await LoadAdminCommunicationsAsync();
            CommunicationService.MessagePublished += OnAdminMessagePublished;
            gameSettings.Combat.AutoEnabled = snapshot.AutoAttackEnabled;
            audioSelection = AudioResolver.Resolve(snapshot.Stage);
            displayedBackgroundUrl = snapshot.World.BackgroundUrl;
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested) { }
        catch (Exception exception) { errorMessage = exception.Message; }
        finally { isLoading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && errorMessage is null && lastExplorationAudioMuted != ExplorationAudioMuted)
        {
            var muted = ExplorationAudioMuted;
            try { await JS.InvokeVoidAsync("maruAudio.setExplorationMuted", lifetimeCancellation.Token, muted); lastExplorationAudioMuted = muted; }
            catch (Exception exception) when (exception is JSException or OperationCanceledException) { }
        }
        if (!firstRender || isLoading || errorMessage is not null) return;
        try
        {
            componentReference = DotNetObjectReference.Create(this);
            isPageVisible = await JS.InvokeAsync<bool>("maruIdle.bindVisibility", componentReference);
            await JS.InvokeVoidAsync("maruIdle.bindIdleTimer", componentReference, gameSettings.General.ScreenSaverTimeoutMinutes);
            await JS.InvokeVoidAsync("maruIdle.bindFormationDrag", componentReference);
            supportsVibration = await JS.InvokeAsync<bool>("maruAudio.supportsVibration");
            prefersReducedMotion = await JS.InvokeAsync<bool>("maruAudio.prefersReducedMotion");
            await JS.InvokeVoidAsync("maruAudio.clearGuestSettings");
            try
            {
                audioInitialized = await Audio.InitializeAsync(gameSettings.Sound, lifetimeCancellation.Token);
                if (audioInitialized)
                {
                    await JS.InvokeVoidAsync("maruAudio.bindAutoUnlock", componentReference);
                    var started = await Audio.PlayMusicAsync(audioSelection.Track, gameSettings.Sound, lifetimeCancellation.Token);
                    showAudioUnlockHint = !started && await JS.InvokeAsync<bool>("maruAudio.shouldShowUnlockHint");
                }
            }
            catch (JSException exception) { settingsError = $"오디오 초기화에 실패했습니다. 전투는 계속할 수 있습니다. ({exception.Message})"; }
            try { await JS.InvokeVoidAsync("maruIdle.preload", snapshot.World.PreloadBackgroundUrl); }
            catch (JSException) { backgroundFailed = true; }
            try { await gameRoot.FocusAsync(); }
            catch (InvalidOperationException) { }
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested) { }
        catch (Exception exception) { settingsError = $"일부 화면 연출을 준비하지 못했습니다. 전투는 계속됩니다. ({exception.Message})"; }
        finally
        {
            if (!lifetimeCancellation.IsCancellationRequested)
            {
                if (ChannelConfirmed)
                {
                    if (snapshot.Phase == CombatPhase.Intro) _ = RunIntroAsync();
                    await SyncAutoLoopAsync();
                    SyncEnemyLoop();
                }
            }
        }
    }

    private async Task BattlefieldAttackAsync() => await PerformAttackAsync(AttackSource.Manual);
    private Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (!ChannelConfirmed) return Task.CompletedTask;
        if (args.Key == "Escape" && profileOpen)
        {
            profileOpen = false;
            return Task.CompletedTask;
        }
        if ((args.Code == "Space" || args.Key == " ") && !args.Repeat)
            return BeginHoldAttackAsync(default!);
        return Task.CompletedTask;
    }

    private void OnKeyUp(KeyboardEventArgs args)
    {
        if (args.Code == "Space" || args.Key == " ") EndHoldAttack(default!);
    }

    private Task BeginHoldAttackAsync(PointerEventArgs _)
    {
        if (holdingAttack || isLoading) return Task.CompletedTask;
        holdingAttack = true;
        holdCancellation = CancellationTokenSource.CreateLinkedTokenSource(lifetimeCancellation.Token);
        holdTask = RunHoldAttackAsync(holdCancellation.Token);
        return Task.CompletedTask;
    }

    private void EndHoldAttack(PointerEventArgs _) { holdingAttack = false; holdCancellation?.Cancel(); }

    private async Task RunHoldAttackAsync(CancellationToken cancellationToken)
    {
        try
        {
            await PerformAttackAsync(AttackSource.Manual, lifetimeCancellation.Token);
            await Task.Delay(GameRules.DefaultAutoAttackInterval, cancellationToken);
            while (!cancellationToken.IsCancellationRequested)
            {
                await PerformAttackAsync(AttackSource.Manual, cancellationToken);
                await Task.Delay(GameRules.DefaultAutoAttackInterval, cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        finally { holdingAttack = false; }
    }

    private async Task PerformAttackAsync(AttackSource source, CancellationToken cancellationToken = default)
    {
        if (source == AttackSource.Manual) await EnsureAudioUnlockedAsync();
        if (!isPageVisible) return;
        if (snapshot.Phase != CombatPhase.Fighting)
        {
            if (source == AttackSource.Automatic)
                await RecoverAutomaticCombatAsync(cancellationToken);
            return;
        }
        try
        {
            var previousAutoInterval = snapshot.AutoAttackInterval;
            var result = await Session.AttackAsync(source, cancellationToken);
            snapshot = result.State;
            if (!result.Accepted) return;
            if (result.EquipmentDropped is not null) ShowEquipmentDrop(result.EquipmentDropped);
            else if (result.AutoSpeedBoostDropped is not null) ShowBoostDrop(result.AutoSpeedBoostDropped);
            PlayAttackAnimation(result);
            var victoryTransition = result.EnemyDefeated
                ? EnsureVictoryTransitionAsync()
                : Task.CompletedTask;
            _ = PlayCombatCueAsync(
                CombatAudio.ResolvePlayerAttack(result.IsCritical, result.EnemyDefeated),
                lifetimeCancellation.Token);
            await InvokeAsync(StateHasChanged);
            if (previousAutoInterval != snapshot.AutoAttackInterval) await SyncAutoLoopAsync();
            await victoryTransition;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void PlayAttackAnimation(AttackResult result)
    {
        var sequence = ++animationSequence;
        playerAttacking = !SkipCombatEffects;
        monsterHit = !SkipCombatEffects && result.TargetUnitId == "enemy";
        hitGuardId = !SkipCombatEffects && result.TargetUnitId?.StartsWith("guard-", StringComparison.Ordinal) == true
            ? result.TargetUnitId
            : null;
        screenShake = !SkipCombatEffects && gameSettings.Display.ScreenShake && !prefersReducedMotion;
        if (gameSettings.Display.DamageNumbers && !SkipCombatEffects)
            damagePopups.Add(new DamagePopup(sequence, result.Damage, result.IsCritical, result.TargetUnitId ?? "enemy"));
        _ = ClearAttackAnimationAsync(sequence);
    }

    private async Task ClearAttackAnimationAsync(long sequence)
    {
        try
        {
            await Task.Delay(520, lifetimeCancellation.Token);
            damagePopups.RemoveAll(item => item.Id == sequence);
            if (sequence == animationSequence)
            {
                playerAttacking = monsterHit = screenShake = false;
                hitGuardId = null;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private async Task PerformEnemyAttackAsync(CancellationToken cancellationToken)
    {
        if (!isPageVisible || snapshot.Phase != CombatPhase.Fighting) return;
        try
        {
            var result = await Session.EnemyAttackAsync(cancellationToken);
            snapshot = result.State;
            if (!result.Accepted) return;
            PlayEnemyAttackAnimation(result);
            var defeatTransition = result.PlayerDefeated
                ? EnsureDefeatTransitionAsync()
                : Task.CompletedTask;
            _ = PlayCombatCueAsync(
                CombatAudio.ResolveEnemyAttack(result.PlayerDefeated),
                lifetimeCancellation.Token);
            await InvokeAsync(StateHasChanged);
            if (result.PlayerDefeated) await SyncAutoLoopAsync();
            await defeatTransition;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void PlayEnemyAttackAnimation(EnemyAttackResult result)
    {
        var sequence = ++enemyAnimationSequence;
        monsterAttacking = !SkipCombatEffects;
        playerHit = !SkipCombatEffects && result.TargetUnitId == "yeonsu";
        hitCompanionId = !SkipCombatEffects && result.TargetUnitId is not null && result.TargetUnitId != "yeonsu"
            ? result.TargetUnitId
            : null;
        playerDamagePopup = gameSettings.Display.DamageNumbers && !SkipCombatEffects ? result.Damage : null;
        screenShake = !SkipCombatEffects && gameSettings.Display.ScreenShake && !prefersReducedMotion;
        _ = ClearEnemyAttackAnimationAsync(sequence);
    }

    private async Task PlayCombatCueAsync(CombatAudioCue cue, CancellationToken cancellationToken)
    {
        try
        {
            if (cue.MovementEffectKey is not null)
                await TryPlayEffectAsync(cue.MovementEffectKey, uiEffect: false, cancellationToken);
            if (cue.ImpactDelayMilliseconds > 0)
                await Task.Delay(cue.ImpactDelayMilliseconds, cancellationToken);
            await TryPlayEffectAsync(cue.ImpactEffectKey, uiEffect: false, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

