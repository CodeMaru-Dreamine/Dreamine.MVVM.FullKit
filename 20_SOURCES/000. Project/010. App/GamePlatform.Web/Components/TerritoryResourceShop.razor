@inject GameSession Session
<section class="resource-shop" aria-label="영지 자원 상점">
    <header><div><small>SUPPLY EXCHANGE</small><h3>자원 보급</h3></div><b>보유 C @Session.Snapshot.PremiumCurrency.ToString("N0")</b></header>
    <div class="choices">@for (var i = 0; i < 3; i++) { var index = i; <button class="@(resource == i ? "selected" : "")" disabled="@busy" @onclick="() => Select(index, pack)">@TerritoryResourceShopRules.Names[i]</button> }</div>
    <div class="choices">@for (var i = 0; i < TerritoryResourceShopRules.Packs.Length; i++) { var index = i; var item = TerritoryResourceShopRules.Packs[i]; <button class="@(pack == i ? "selected" : "")" disabled="@busy" @onclick="() => Select(resource, index)">@item.Amount.ToString("N0")개 · C @item.Coins</button> }</div>
    <p>구매 후 @TerritoryResourceShopRules.Names[resource] <b>@((TerritoryResourceShopRules.Balance(State, resource) + Product.Amount).ToString("N0"))</b> / 창고 @TerritoryRules.StorageCapacity(State).ToString("N0")</p>
    <button class="purchase" disabled="@(busy || Blocked is not null)" @onclick="Buy">@(Blocked ?? (confirming ? $"C {Product.Coins} 사용 · 구매 확정" : $"{TerritoryResourceShopRules.Names[resource]} {Product.Amount:N0} 구매"))</button>
    @if (confirming) { <button disabled="@busy" @onclick="() => confirming = false">취소</button> }
    @if (message is not null) { <p role="status">@message</p> }
</section>
@code {
    [Parameter, EditorRequired] public TerritoryState State { get; set; } = new();
    [Parameter] public EventCallback Changed { get; set; }
    private int resource, pack;
    private bool busy, confirming;
    private string requestId = Guid.NewGuid().ToString("N");
    private string? message;
    private (int Amount, int Coins) Product => TerritoryResourceShopRules.Packs[pack];
    private string? Blocked => Session.Snapshot.PremiumCurrency < Product.Coins ? "코인 부족" : TerritoryRules.StorageCapacity(State) - TerritoryResourceShopRules.Balance(State, resource) < Product.Amount ? "창고 여유 부족" : null;
    private void Select(int r, int p) { if (resource != r || pack != p) requestId = Guid.NewGuid().ToString("N"); resource = r; pack = p; confirming = false; message = null; }
    private async Task Buy()
    {
        if (busy) return;
        if (!confirming) { confirming = true; return; }
        busy = true;
        try {
            var result = await Session.TerritoryActionAsync("resource-buy", resource, pack, expectedJobId: requestId);
            message = result.Message;
            await Changed.InvokeAsync();
            if (result.Success) { confirming = false; requestId = Guid.NewGuid().ToString("N"); }
        } catch { message = "결과를 확인하지 못했습니다. 같은 구매를 재시도해도 중복 차감되지 않습니다."; }
        finally { busy = false; }
    }
}
