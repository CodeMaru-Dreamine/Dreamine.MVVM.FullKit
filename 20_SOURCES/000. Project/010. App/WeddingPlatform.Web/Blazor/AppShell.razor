@namespace WeddingPlatform.Blazor
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject WeddingLocalization Text

<!DOCTYPE html>
<html lang="@Text.HtmlLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        (() => {
            const media = window.matchMedia('(prefers-color-scheme: dark)');
            const syncSystemClass = event => document.documentElement.classList.toggle('system-dark', event.matches);
            syncSystemClass(media);
            media.addEventListener?.('change', syncSystemClass);
            const cookie = document.cookie.split(';').map(x => x.trim()).find(x => x.startsWith('dreamine-theme='));
            const saved = cookie ? decodeURIComponent(cookie.substring('dreamine-theme='.length)) : localStorage.getItem('codemaru-theme');
            if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
        })();
    </script>
    <link rel="stylesheet" href="/css/wedding.css?v=20260802-portal-shell-1" />
    <link rel="stylesheet" href="/WeddingPlatform.Web.styles.css?v=20260802-portal-shell-1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600&display=swap" rel="stylesheet" />
    <!-- Leaflet 지도 CSS — 로컬 파일(CDN 미의존) -->
    <link rel="stylesheet" href="/lib/leaflet/leaflet.min.css" />
    <HeadOutlet />
</head>
<body>
    <WeddingPlatform.Blazor.Routes @rendermode="new InteractiveServerRenderMode(prerender: true)" />

    <!--
      blazor.web.js autostart="false" + 수동 Blazor.start():
      삼성 인터넷 등 일부 브라우저가 WebSocket을 차단할 때 LongPolling으로 자동 폴백하고,
      회선 연결 실패 시 최대 10회 재시도하도록 설정합니다.
    -->
    <script src="/_framework/blazor.web.js" autostart="false"></script>
    <!-- Leaflet JS — 로컬 파일이라 빠름, CDN과 달리 지연/차단 없음 -->
    <script src="/lib/leaflet/leaflet.min.js"></script>
    <script src="/_content/Dreamine.UI.Blazor/dreamine-portal.js?v=20260802-portal-shell-1"></script>
    <script src="/js/wedding-interop.js?v=20260726-theme-palette"></script>
    <script>
        Blazor.start({
            circuit: {
                reconnectionOptions: {
                    maxRetries: 10,
                    retryIntervalMilliseconds: (previousAttempts) => {
                        // 1초 → 2초 → 4초 ... 최대 30초 간격으로 재시도
                        return Math.min(1000 * Math.pow(2, previousAttempts), 30000);
                    }
                },
                configureSignalR: function (builder) {
                    // WebSocket → ServerSentEvents → LongPolling 순으로 폴백
                    builder.withUrl('/_blazor', {
                        transport: 7 // HttpTransportType.WebSockets | SSE | LongPolling
                    }).withAutomaticReconnect([0, 1000, 2000, 5000, 10000, 15000, 30000, 30000, 30000, 30000]);
                }
            }
        });
    </script>
</body>
</html>

@code {
    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("lang", out var language))
        {
            Text.SetLanguage(WeddingLocalization.NormalizeLanguageCode(language.ToString()));
        }
    }
}
