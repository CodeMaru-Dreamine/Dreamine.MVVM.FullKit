    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 같은 브라우저에서 다른 테넌트의 공개 페이지를 본 뒤 관리 화면으로
            // 이동해도 이전 테넌트의 사용자 정의 CSS 변수가 남지 않게 초기화합니다.
            try
            {
                await JS.InvokeVoidAsync(
                    "weddingInterop.applyTheme",
                    WeddingThemeCatalog.DefaultThemeKey,
                    (object?)null);
            }
            catch { }
        }

        if (firstRender && !Vm.IsAuthenticated && !_superAdminAutoLoginChecked)
        {
            _superAdminAutoLoginChecked = true;
            var restored = await TrySuperAdminAutoLoginAsync();
            StateHasChanged();
            if (restored)
            {
                return;
            }
        }

        if (Vm.IsAuthenticated && Vm.IsLoaded)
        {
            if (!_adminInteropInitialized)
            {
                _adminInteropInitialized = true;
                try { await JS.InvokeVoidAsync("weddingInterop.initAdminSplitter"); }
                catch { }

                _selfRef ??= DotNetObjectReference.Create(this);
                try { await JS.InvokeVoidAsync("weddingInterop.initAdminPreviewDesignBridge", _selfRef); }
                catch { }
                await PublishPreviewAccountDraftAsync();
            }

            if (!_initialStateLoaded)
            {
                _initialStateLoaded = true;
                try
                {
                    _previewCollapsed = await JS.InvokeAsync<bool>("weddingInterop.getPreviewCollapsed");
                    StateHasChanged();
                }
                catch { }
            }

            if (_heroCropEditorOpen && _heroCropEditorNeedsInit)
            {
                _heroCropEditorNeedsInit = false;
                _selfRef ??= DotNetObjectReference.Create(this);
                try { await JS.InvokeVoidAsync("weddingInterop.initHeroCropEditor", _selfRef); }
                catch { }
            }
        }
    }

