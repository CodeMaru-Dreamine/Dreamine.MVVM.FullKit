    private static int CompareLayoutVersions(string? left, string? right)
    {
        var leftParts = ParseLayoutVersion(left);
        var rightParts = ParseLayoutVersion(right);
        var coreComparison = leftParts.Core.CompareTo(rightParts.Core);
        if (coreComparison != 0)
        {
            return coreComparison;
        }

        if (leftParts.PreRelease.Length == 0)
        {
            return rightParts.PreRelease.Length == 0 ? 0 : 1;
        }

        if (rightParts.PreRelease.Length == 0)
        {
            return -1;
        }

        return string.Compare(
            leftParts.PreRelease,
            rightParts.PreRelease,
            StringComparison.OrdinalIgnoreCase);
    }

    private static (Version Core, string PreRelease) ParseLayoutVersion(
        string? version)
    {
        var normalized = version?.Trim() ?? WeddingLayoutVersion.Initial;
        var withoutBuild = normalized.Split('+', 2)[0];
        var parts = withoutBuild.Split('-', 2);
        return (
            Version.TryParse(parts[0], out var core)
                ? core
                : new Version(0, 0, 0),
            parts.Length == 2 ? parts[1] : "");
    }

