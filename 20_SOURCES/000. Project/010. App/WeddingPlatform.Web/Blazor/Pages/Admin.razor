    public void Dispose()
    {
        LayoutRegistry.Changed -= OnLayoutCatalogChanged;
        Text.Changed -= OnLanguageChanged;
        lock (_uploadTickerSync)
        {
            if (_disposed)
            {
                return;
            }

            _disposed = true;
            _uploadTickCts?.Cancel();
            _uploadTickCts = null;
        }

        // RunUploadAsync owns and disposes the active source after its ticker
        // has observed cancellation.
        _themePreviewDebounceCts?.Cancel();
        _themePreviewDebounceCts?.Dispose();
        _selfRef?.Dispose();
    }
}
