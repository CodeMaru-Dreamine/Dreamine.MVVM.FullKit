@page "/{Slug}/admin"
@layout WeddingPlatform.Blazor.Layout.WeddingLayout
@namespace WeddingPlatform.Blazor.Pages
@rendermode InteractiveServer

@using Markdig
@using Wedding.Common
@using WeddingPlatform.Models
@using Microsoft.JSInterop
@inject WeddingAdminViewModel Vm
@inject IWeddingLayoutCatalogRegistry LayoutRegistry
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WeddingLocalization Text
@implements IDisposable

<PageTitle>@Text["admin"] — @Slug</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="w-admin">
    <div class="w-admin-preferences" aria-label="@Text["screen.settings"]">
        <WeddingPlatform.Blazor.Components.WeddingPreferences />
    </div>
    @if (!Vm.IsAuthenticated && !_superAdminAutoLoginChecked)
    {
        <div class="w-loading">
            <div class="w-spinner"></div>
            <p class="w-hint">@Text["admin.checking"]</p>
        </div>
    }
    else if (!Vm.IsAuthenticated)
    {
        <h1 class="w-admin__title">⚙ @Text["admin"] — <code>@Slug</code></h1>
        <div class="w-admin__login w-panel">
            <h2>@Text["admin.signin"]</h2>
            @if (Vm.IsSignedIn)
            {
                <p class="w-hint">@Text["admin.shared.current"]: <strong>@Vm.CurrentUserLabel</strong></p>
                <p class="w-hint">@Text["admin.link.account"]</p>
            }
            else
            {
                <p class="w-hint">@Text["admin.login.first"]</p>
                <a class="w-btn" href="@LoginUrl">@Text["common.login"]</a>
            }
            <input class="w-input"
                   type="password"
                   placeholder="@Text["field.password"]"
                   @bind="Vm.LoginPassword"
                   @bind:event="oninput" />
            <button class="w-btn w-btn--primary" @onclick="OnLogin">@Text["login"]</button>
            @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
            {
                <p class="w-status">@DisplayStatusMessage</p>
            }
        </div>
    }
    else if (!Vm.IsLoaded)
    {
        <div class="w-loading"><div class="w-spinner"></div></div>
    }
    else
    {
        <div class="w-admin-shell @(_previewCollapsed ? "is-preview-collapsed" : "")">

            <!-- ══════ 사이드바 ══════ -->
            <aside class="w-admin-nav @(_navOpen ? "is-open" : "")">
                <div class="w-admin-nav__head">
                    <div class="w-admin-nav__brand">
                        <span class="w-admin-nav__brand-icon">⚙</span>
                        <div>
                            <strong>@Text["admin.manage"]</strong>
                            <small><code>@Slug</code></small>
                        </div>
                    </div>
                    <button class="w-admin-nav__close" @onclick="() => _navOpen = false" aria-label="@Text["admin.close.menu"]">✕</button>
                </div>

                <nav class="w-admin-nav__list">
                    @foreach (var item in VisibleNavItems)
                    {
                        <button class="w-admin-nav__item @(_selected == item.Key ? "active" : "")"
                                @onclick="() => SelectSection(item.Key)">
                            <span class="w-admin-nav__icon">@((MarkupString)item.Icon)</span>
                            <span class="w-admin-nav__label">@AdminNavLabel(item.Key)</span>
                        </button>
                    }
                </nav>

                <div class="w-admin-nav__foot">
                    <button class="w-btn w-btn--primary w-btn--block" @onclick="OnSaveConfig">
                        @Text["admin.save"]
                    </button>
                    <button class="w-btn w-btn--block" @onclick="OnShareInvitation">
                        @Text["admin.share"]
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
                    {
                        <p class="w-status w-status--compact">@DisplayStatusMessage</p>
                    }
                    <a class="w-admin-nav__link" href="/@Slug" target="_blank">@Text["admin.open.invite"]</a>
                    <a class="w-admin-nav__link" href="/@Slug/thankyou" target="_blank">@Text["admin.open.thankyou"]</a>
                </div>
            </aside>

            <!-- ══════ 콘텐츠 ══════ -->
            <main class="w-admin-content">

                <div class="w-admin-content__topbar">
                    <button class="w-admin-nav__toggle" @onclick="() => _navOpen = !_navOpen" aria-label="@Text["admin.open.menu"]">☰</button>
                    <h2 class="w-admin-content__title">
                        <span class="w-admin-title__icon">@((MarkupString)CurrentNavItem.Icon)</span>
                        <span class="w-admin-title__text">@AdminNavLabel(CurrentNavItem.Key)</span>
                    </h2>
                    <button class="w-admin-preview__toggle" @onclick="OnPreviewToggle" aria-label="@Text["admin.open.preview"]"
                            title="@(_previewCollapsed ? Text["admin.expand.preview"] : Text["admin.preview"])">
                        <span class="w-admin-preview__toggle-icon">📱</span>
                        <span class="w-admin-preview__toggle-text">@(_previewCollapsed ? Text["admin.expand.preview"] : Text["admin.preview"])</span>
                    </button>
                </div>

                <div class="w-admin-content__body">

                    @if (Vm.IsSignedIn)
                    {
                        <p class="w-status w-status--compact">@Text["common.login"]: @Vm.CurrentUserLabel · @(Vm.IsOwner ? Text["admin.owner"] : Text["admin.manager"])</p>
                    }
                    @if (Vm.IsSuperAdminSession)
                    {
                        <p class="w-status w-status--compact">
                            @Text["admin.super.session"] <code>@Slug</code>
                        </p>
                    }

                    @* ─────────── 기본 정보 ─────────── *@
                    @if (_selected == "basic")
                    {
                        <section class="w-admin__section">
                            <label class="w-label">@Text["admin.basic.hero"]</label>
                            <input class="w-input" @bind="Vm.Config!.HeroTitle" placeholder="Save The Date" />

                            <label class="w-label">@Text["field.couple"]</label>
                            <input class="w-input" @bind="Vm.Config!.CoupleName" />

                            <label class="w-label">@Text["field.date"]</label>
                            <input class="w-input" type="date" @bind="Vm.Config.WeddingDate" />

                            <label class="w-label">@Text["admin.basic.time"]</label>
                            <input class="w-input" @bind="Vm.Config.WeddingTime" placeholder="@Text["admin.basic.time.placeholder"]" />

                            <label class="w-label">@Text["admin.basic.venue"]</label>
                            <input class="w-input" @bind="Vm.Config.VenueName" />

                            <label class="w-label">@Text["admin.basic.address"]</label>
                            <input class="w-input" @bind="Vm.Config.VenueAddress" />

                            <label class="w-label">@Text["admin.basic.story.ko"]</label>
                            <textarea class="w-input w-textarea" rows="4" @bind="Vm.Config.Story"></textarea>

                            <label class="w-label">@Text["admin.basic.story.other"]</label>
                            <textarea class="w-input w-textarea" rows="4" @bind="Vm.Config.Story2"></textarea>
                        </section>
                    }

                    @* ─────────── 예식 안내 ─────────── *@
                    else if (_selected == "notice")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.notice"]</h3>
                            <p class="w-hint">@Text["admin.notice.desc"]</p>
                            <p class="w-hint">@Text["admin.notice.ai"]</p>

                            <div class="w-note-examples" aria-label="@Text["admin.notice.examples"]">
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("warm")'>@Text["admin.notice.warm"]</button>
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("formal")'>@Text["admin.notice.formal"]</button>
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("simple")'>@Text["admin.notice.simple"]</button>
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("ai")'>@Text["admin.notice.ai.example"]</button>
                            </div>

                            <div class="w-note-toolbar">
                                <button class="@(Vm.Config!.CeremonyNoteFormat == "Markdown" ? "active" : "")"
                                        @onclick='() => Vm.Config!.CeremonyNoteFormat = "Markdown"'>@Text["admin.notice.markdown"]</button>
                                <button class="@(Vm.Config!.CeremonyNoteFormat == "Html" ? "active" : "")"
                                        @onclick='() => Vm.Config!.CeremonyNoteFormat = "Html"'>HTML</button>
                            </div>
                            <div class="w-note-editor-grid">
                                <div class="w-note-editor">
                                    @if (Vm.Config.CeremonyNoteFormat == "Markdown")
                                    {
                                        <textarea class="w-input w-textarea w-textarea--code w-textarea--notice" rows="18"
                                                  @bind="Vm.Config.CeremonyNote" @bind:event="oninput"
                                                  placeholder="@Text["admin.notice.markdown.placeholder"]"></textarea>
                                        <p class="w-hint">@Text["admin.notice.markdown.hint"]</p>
                                    }
                                    else
                                    {
                                        <textarea class="w-input w-textarea w-textarea--code w-textarea--notice" rows="18"
                                                  @bind="Vm.Config.CeremonyNote" @bind:event="oninput"
                                                  placeholder="@Text["admin.notice.html.placeholder"]"></textarea>
                                        <p class="w-hint">@Text["admin.notice.html.hint"]</p>
                                    }
                                </div>
                                <div class="w-note-preview">
                                    <div class="w-note-preview__head">@Text["admin.notice.html.preview"]</div>
                                    <div class="w-note-preview__body">
                                        @if (string.IsNullOrWhiteSpace(Vm.Config.CeremonyNote))
                                        {
                                            <p class="w-note-preview__empty">@Text["admin.notice.preview.empty"]</p>
                                        }
                                        else
                                        {
                                            @((MarkupString)CeremonyNotePreviewHtml)
                                        }
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    @* ─────────── 디자인 ─────────── *@
                    else if (_selected == "design")
                    {
                        var selectedLayout = SelectedLayoutOption;
                        var matchingLayouts = FilteredLayoutOptions.ToArray();

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.design.layout"]</h3>
                            <p class="w-hint">@Text["admin.design.layout.hint"]</p>

                            <div class="w-layout-picker">
                                <div class="w-layout-combobox">
                                    <button type="button"
                                            class="w-layout-combobox__trigger"
                                            aria-haspopup="listbox"
                                            aria-expanded="@(_layoutPickerOpen ? "true" : "false")"
                                            aria-controls="w-layout-options"
                                            @onclick="ToggleLayoutPicker">
                                        <span class="w-layout-combobox__value">
                                            <small>@Text["admin.design.select"]</small>
                                            <strong>@(selectedLayout?.Label ?? Text["admin.design.none"])</strong>
                                        </span>
                                        <span class="w-layout-combobox__chevron" aria-hidden="true">@(_layoutPickerOpen ? "▴" : "▾")</span>
                                    </button>

                                    @if (_layoutPickerOpen)
                                    {
                                        <div class="w-layout-combobox__popover">
                                            <label class="w-layout-combobox__search-label" for="w-layout-search">@Text["admin.design.search"]</label>
                                            <input id="w-layout-search"
                                                   class="w-input w-layout-combobox__search"
                                                   type="search"
                                                   autocomplete="off"
                                                   placeholder="이름, 설명, 등급으로 검색"
                                                   @bind="_layoutSearch"
                                                   @bind:event="oninput"
                                                   @onkeydown="OnLayoutSearchKeyDown" />

                                            <div id="w-layout-options" class="w-layout-options" role="listbox" aria-label="레이아웃 검색 결과">
                                                @if (matchingLayouts.Length == 0)
                                                {
                                                    <p class="w-layout-options__empty">@Text["admin.design.noresults"]</p>
                                                }
                                                else
                                                {
                                                    @foreach (var descriptor in matchingLayouts)
                                                    {
                                                        var canUse = CanUseLayout(descriptor);
                                                        var canApply = canUse && descriptor.IsImplemented;
                                                        var isCandidate = selectedLayout is not null
                                                            && string.Equals(selectedLayout.Key, descriptor.Key, StringComparison.OrdinalIgnoreCase)
                                                            && string.Equals(selectedLayout.Version, descriptor.Version, StringComparison.Ordinal);
                                                        var isApplied = IsAppliedLayout(descriptor);

                                                        <button type="button"
                                                                id="w-layout-option-@descriptor.Key"
                                                                class="w-layout-option @(isCandidate ? "is-selected" : "") @(!canApply ? "is-locked" : "")"
                                                                role="option"
                                                                aria-selected="@(isCandidate ? "true" : "false")"
                                                                @onclick="() => SelectLayoutCandidate(descriptor)">
                                                            <span class="w-style-card__preview w-style-card__preview--@descriptor.Key" aria-hidden="true"></span>
                                                            <span class="w-layout-option__meta">
                                                                <strong>@descriptor.Label</strong>
                                                                <small>@descriptor.Description</small>
                                                            </span>
                                                            <span class="w-layout-option__badges">
                                                                @if (isApplied)
                                                                {
                                                                    <span class="w-layout-badge w-layout-badge--active">@Text["admin.design.applied"]</span>
                                                                }
                                                                @if (!descriptor.IsImplemented)
                                                                {
                                                                    <span class="w-layout-badge">@Text["admin.design.preparing"]</span>
                                                                }
                                                                else if (!canUse)
                                                                {
                                                                    <span class="w-layout-badge">@Text["admin.design.locked"]</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="w-layout-badge">@LayoutTierLabel(descriptor)</span>
                                                                }
                                                            </span>
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (selectedLayout is not null)
                                {
                                    var canUseSelectedLayout = CanUseLayout(selectedLayout);
                                    var canApplySelectedLayout = canUseSelectedLayout && selectedLayout.IsImplemented;
                                    var isSelectedLayoutApplied = IsAppliedLayout(selectedLayout);
                                    var availableVersions = GetLayoutVersionOptions(selectedLayout.Key);
                                    var appliedLayout = AppliedLayoutOption;
                                    var activeVersion = Vm.LayoutCatalog
                                        .FindDescriptor(selectedLayout.Key)
                                        ?.CurrentVersion;

                                    <article class="w-layout-detail" aria-live="polite">
                                        <div class="w-layout-detail__visual w-style-card__preview w-style-card__preview--@selectedLayout.Key"
                                             role="img"
                                             aria-label="@selectedLayout.Label 레이아웃 구성 미리보기"></div>

                                        <div class="w-layout-detail__content">
                                            <div class="w-layout-detail__badges">
                                                <span class="w-layout-badge">@LayoutTierLabel(selectedLayout)</span>
                                                <span class="w-layout-badge">@(Vm.IsBuiltInLayout(selectedLayout.Key) ? "기본 제공" : "승인 레이아웃")</span>
                                                <span class="w-layout-badge">v@(selectedLayout.Version)</span>
                                                @if (isSelectedLayoutApplied)
                                                {
                                                    <span class="w-layout-badge w-layout-badge--active">현재 적용됨</span>
                                                }
                                            </div>
                                            <h4>@selectedLayout.Label</h4>
                                            <p>@selectedLayout.Description</p>

                                            <dl class="w-layout-detail__facts">
                                                <div>
                                                    <dt>화면 방식</dt>
                                                    <dd>@(selectedLayout.UsesBottomNavigation ? "하단 메뉴 탐색" : "세로 스크롤")</dd>
                                                </div>
                                                <div>
                                                    <dt>지원 섹션</dt>
                                                    <dd>@(selectedLayout.SupportedSections.Count)개</dd>
                                                </div>
                                            </dl>

                                            @if (availableVersions.Count > 1)
                                            {
                                                <label class="w-label">
                                                    사용할 버전
                                                    <select class="w-input"
                                                            value="@selectedLayout.Version"
                                                            @onchange="e => SelectLayoutVersion(selectedLayout.Key, e)">
                                                        @foreach (var versionOption in availableVersions)
                                                        {
                                                            <option value="@versionOption.Version">
                                                                @LayoutVersionOptionLabel(
                                                                    versionOption,
                                                                    appliedLayout,
                                                                    activeVersion)
                                                            </option>
                                                        }
                                                    </select>
                                                </label>

                                                @if (appliedLayout is not null
                                                    && string.Equals(
                                                        appliedLayout.Key,
                                                        selectedLayout.Key,
                                                        StringComparison.OrdinalIgnoreCase)
                                                    && !string.Equals(
                                                        appliedLayout.Version,
                                                        activeVersion,
                                                        StringComparison.Ordinal))
                                                {
                                                    <p class="w-layout-detail__notice">
                                                        현재 청첩장은 v@(appliedLayout.Version)을 계속 사용합니다.
                                                        사용 가능한 활성 버전 v@(activeVersion)이 있지만 자동으로
                                                        바뀌지 않습니다. 위에서 새 버전을 선택한 뒤 업데이트하세요.
                                                    </p>
                                                }
                                            }

                                            @if (isSelectedLayoutApplied)
                                            {
                                                <label class="w-layout-version-policy">
                                                    <input type="checkbox"
                                                           @bind="Vm.Config!.DesignSettings.FollowActiveLayoutVersion" />
                                                    <span>
                                                        <strong>새 활성 버전 자동 적용</strong>
                                                        <small>
                                                            기본은 현재 v@(selectedLayout.Version)에 고정됩니다.
                                                            이 옵션을 직접 켠 경우에만 이후 승인된 활성 버전과
                                                            슈퍼관리자 롤백을 자동으로 따라갑니다.
                                                        </small>
                                                    </span>
                                                </label>
                                            }
                                            else
                                            {
                                                <p class="w-layout-detail__notice">
                                                    적용하면 v@(selectedLayout.Version)에 고정됩니다.
                                                    새 버전 자동 적용은 적용 후 별도로 켤 수 있습니다.
                                                </p>
                                            }

                                            @if (!selectedLayout.IsImplemented)
                                            {
                                                <p class="w-layout-detail__notice">이 레이아웃은 아직 화면 렌더러가 준비되지 않았습니다.</p>
                                            }
                                            else if (!canUseSelectedLayout)
                                            {
                                                <p class="w-layout-detail__notice">Premium 플랜을 활성화하면 모든 Premium 레이아웃을 사용할 수 있습니다.</p>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(_layoutApplyMessage))
                                            {
                                                <p class="w-layout-detail__success">@_layoutApplyMessage</p>
                                            }

                                            <div class="w-layout-detail__actions">
                                                <button type="button"
                                                        class="w-btn w-btn--primary"
                                                        disabled="@(!canApplySelectedLayout || isSelectedLayoutApplied)"
                                                        @onclick="ApplySelectedLayout">
                                                    @LayoutApplyButtonLabel(selectedLayout, appliedLayout)
                                                </button>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        </section>

                        <section class="w-admin__section">
                            <div class="w-admin-section-title-row">
                                <div>
                                    <h3 class="w-admin__section-h">@Text["admin.design.sections"]</h3>
                                    <p class="w-hint">모든 레이아웃에서 표시 가능한 섹션이 이 순서를 따릅니다. 홈은 레이아웃의 대표 영역이라 항상 첫 화면으로 유지됩니다.</p>
                                </div>
                                <button type="button" class="w-btn w-btn--sm" @onclick="ResetSectionOrder">@Text["admin.design.recommended"]</button>
                            </div>
                            <div class="w-section-order-list">
                                @foreach (var section in OrderedDesignSections)
                                {
                                    var isSectionVisible = IsSectionVisible(section);
                                    <div class="w-section-order-item @(section == "hero" ? "is-fixed" : "") @(!isSectionVisible ? "is-hidden" : "")">
                                        <span class="w-section-order-item__icon">@WeddingSectionOrderCatalog.GetIcon(section)</span>
                                        <span class="w-section-order-item__label">@LocalizedSectionLabel(section)</span>
                                        <div class="w-section-order-item__actions">
                                            @if (section == "hero")
                                            {
                                                <span class="w-hint">@Text["admin.design.fixed"]</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="w-btn w-btn--sm" @onclick="() => MoveSection(section, -1)">@Text["admin.design.up"]</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick="() => MoveSection(section, 1)">@Text["admin.design.down"]</button>
                                                <button type="button"
                                                        class="w-btn w-btn--sm @(isSectionVisible ? "" : "w-btn--muted")"
                                                        title="@(isSectionVisible ? "이 섹션을 청첩장에서 숨깁니다" : "이 섹션을 청첩장에 다시 표시합니다")"
                                                        @onclick="() => ToggleSectionVisibility(section)">
                                                    @(isSectionVisible ? Text["admin.design.hide"] : Text["admin.design.show"])
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🎨 @Text["admin.design.colors"]</h3>
                            <div class="w-theme-picker">
                                @foreach (var t in InvitationDesignCatalog.Themes)
                                {
                                    var canUse = CanUseTheme(t);
                                    var canSelect = canUse && t.IsImplemented;
                                    <button class="w-theme-btn @(Vm.Config!.DesignSettings.ThemeKey == t.Key ? "active" : "") @(!canSelect ? "is-locked" : "")"
                                            style="--tc:@t.Primary;--tca:@t.Accent"
                                            disabled="@(!canSelect)"
                                            @onclick="() => SelectTheme(t.Key)">
                                        <span class="w-theme-swatch"></span>
                                        <span>
                                            @t.DisplayName
                                            @if (!t.IsImplemented)
                                            {
                                                <small class="w-layout-lock">@Text["admin.design.preparing"]</small>
                                            }
                                            else if (!canUse)
                                            {
                                                <small class="w-layout-lock">@Text["admin.design.locked"]</small>
                                            }
                                        </span>
                                    </button>
                                }
                            </div>

                            <div class="w-custom-theme @(Vm.Config!.DesignSettings.ThemeKey == WeddingThemeCatalog.CustomThemeKey ? "is-active" : "")">
                                <div class="w-custom-theme__head">
                                    <div>
                                        <strong>나만의 색상 테마</strong>
                                        <p class="w-hint">레이아웃과 별도로 저장되므로 레이아웃 버전을 변경해도 색상은 유지됩니다.</p>
                                    </div>
                                    <span class="w-layout-badge">Premium</span>
                                </div>

                                @if (Vm.Config.HasPremiumPlan)
                                {
                                    var customPalette = CurrentCustomPalette;

                                    <label class="w-label">테마 이름</label>
                                    <input class="w-input"
                                           maxlength="40"
                                           @bind="Vm.Config.DesignSettings.CustomTheme.Name" />

                                    <div class="w-custom-theme__generator">
                                        <div class="w-custom-theme__generator-copy">
                                            <strong>대표 색상으로 자동 맞춤</strong>
                                            <p class="w-hint">
                                                색상 하나만 고르면 배경·본문·버튼·경계선을 읽기 편한 대비로 자동 보정합니다.
                                                자동 보정 후에도 아래에서 원하는 색만 다시 바꿀 수 있습니다.
                                            </p>
                                        </div>
                                        <label class="w-custom-theme__base">
                                            <span>대표 색상</span>
                                            <input type="color"
                                                   value="@customPalette.BaseColor"
                                                   @oninput="OnThemeBaseColorChanged" />
                                            <code>@customPalette.BaseColor</code>
                                        </label>
                                        <button type="button"
                                                class="w-btn w-btn--sm"
                                                @onclick="ApplyAutomaticThemePalette">
                                            자동 팔레트 다시 만들기
                                        </button>
                                    </div>

                                    <div class="w-custom-theme__palette"
                                         aria-label="현재 사용자 정의 색상 팔레트">
                                        <span style="--w-custom-swatch:@customPalette.Primary" title="포인트"></span>
                                        <span style="--w-custom-swatch:@customPalette.Accent" title="강조"></span>
                                        <span style="--w-custom-swatch:@customPalette.Background" title="배경"></span>
                                        <span style="--w-custom-swatch:@customPalette.PanelBackground" title="표면"></span>
                                        <span style="--w-custom-swatch:@customPalette.Text" title="본문"></span>
                                        <span style="--w-custom-swatch:@customPalette.MutedText" title="보조 본문"></span>
                                    </div>

                                    <div class="w-custom-theme__contrast" aria-live="polite">
                                        <span class="@(TextContrastRatio >= 4.5 ? "is-good" : "is-warning")">
                                            본문 대비 @TextContrastRatio.ToString("0.0"):1
                                        </span>
                                        <span class="@(MutedContrastRatio >= 4.5 ? "is-good" : "is-warning")">
                                            보조 글자 @MutedContrastRatio.ToString("0.0"):1
                                        </span>
                                        <span class="@(ButtonContrastRatio >= 4.5 ? "is-good" : "is-warning")">
                                            버튼 대비 @ButtonContrastRatio.ToString("0.0"):1
                                        </span>
                                    </div>

                                    <details class="w-custom-theme__details">
                                        <summary>세부 색상 직접 조정</summary>
                                        <p class="w-hint">자동 결과가 마음에 들지 않는 항목만 바꿔도 됩니다. 변경 내용은 오른쪽 미리보기에 바로 반영됩니다.</p>
                                        <div class="w-custom-theme__colors">
                                            <label>
                                                <span>포인트(보정)</span>
                                                <input type="color" value="@customPalette.Primary"
                                                       @oninput='e => UpdateCustomThemeColor("primary", e.Value?.ToString())' />
                                                <code>@customPalette.Primary</code>
                                            </label>
                                            <label>
                                                <span>강조</span>
                                                <input type="color" value="@customPalette.Accent"
                                                       @oninput='e => UpdateCustomThemeColor("accent", e.Value?.ToString())' />
                                                <code>@customPalette.Accent</code>
                                            </label>
                                            <label>
                                                <span>강조 텍스트</span>
                                                <input type="color" value="@customPalette.Dark"
                                                       @oninput='e => UpdateCustomThemeColor("dark", e.Value?.ToString())' />
                                                <code>@customPalette.Dark</code>
                                            </label>
                                            <label>
                                                <span>본문</span>
                                                <input type="color" value="@customPalette.Text"
                                                       @oninput='e => UpdateCustomThemeColor("text", e.Value?.ToString())' />
                                                <code>@customPalette.Text</code>
                                            </label>
                                            <label>
                                                <span>보조 본문</span>
                                                <input type="color" value="@customPalette.MutedText"
                                                       @oninput='e => UpdateCustomThemeColor("muted", e.Value?.ToString())' />
                                                <code>@customPalette.MutedText</code>
                                            </label>
                                            <label>
                                                <span>배경</span>
                                                <input type="color" value="@customPalette.Background"
                                                       @oninput='e => UpdateCustomThemeColor("background", e.Value?.ToString())' />
                                                <code>@customPalette.Background</code>
                                            </label>
                                            <label>
                                                <span>패널</span>
                                                <input type="color" value="@customPalette.PanelBackground"
                                                       @oninput='e => UpdateCustomThemeColor("panel", e.Value?.ToString())' />
                                                <code>@customPalette.PanelBackground</code>
                                            </label>
                                            <label>
                                                <span>버튼</span>
                                                <input type="color" value="@customPalette.ButtonBackground"
                                                       @oninput='e => UpdateCustomThemeColor("button", e.Value?.ToString())' />
                                                <code>@customPalette.ButtonBackground</code>
                                            </label>
                                            <label>
                                                <span>버튼 글자</span>
                                                <input type="color" value="@customPalette.ButtonText"
                                                       @oninput='e => UpdateCustomThemeColor("button-text", e.Value?.ToString())' />
                                                <code>@customPalette.ButtonText</code>
                                            </label>
                                            <label>
                                                <span>경계선</span>
                                                <input type="color" value="@customPalette.Border"
                                                       @oninput='e => UpdateCustomThemeColor("border", e.Value?.ToString())' />
                                                <code>@customPalette.Border</code>
                                            </label>
                                        </div>
                                    </details>

                                    @if (!string.IsNullOrWhiteSpace(_themePreviewMessage))
                                    {
                                        <p class="w-layout-detail__success">@_themePreviewMessage</p>
                                    }

                                    <button type="button"
                                            class="w-btn w-btn--primary"
                                            @onclick="SelectCustomTheme">
                                        @(Vm.Config.DesignSettings.ThemeKey == WeddingThemeCatalog.CustomThemeKey
                                            ? "나만의 테마 선택됨"
                                            : "나만의 테마 사용")
                                    </button>
                                }
                                else
                                {
                                    @if (Vm.Config.DesignSettings.ThemeKey == WeddingThemeCatalog.CustomThemeKey)
                                    {
                                        <p class="w-layout-detail__notice">
                                            저장된 나만의 테마 값은 보존되어 있습니다. 현재 공개 화면에는 로즈 골드 기본 테마가 적용되며,
                                            Premium을 다시 활성화하면 기존 색상을 그대로 이어서 사용할 수 있습니다.
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="w-layout-detail__notice">Premium 플랜에서 직접 색상을 만들고 저장할 수 있습니다. 기본 테마 5종은 모두 무료입니다.</p>
                                    }
                                }
                            </div>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🖼 히어로 이미지</h3>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config!.HeroImageFileName))
                            {
                                <button type="button"
                                        class="w-admin__hero-preview w-admin__hero-preview--button"
                                        title="전체 표시 또는 사용할 영역 편집"
                                        @onclick="OpenHeroCropEditor">
                                    <img src="@Vm.GetHeroUrl(Slug, Vm.Config.HeroImageFileName)" alt="히어로" />
                                    <span>
                                        <b>@Vm.Config.HeroImageFileName</b>
                                        <small>사진을 눌러 PC·폰 표시 영역 편집</small>
                                    </span>
                                </button>
                            }
                            <InputFile class="w-file-input" OnChange="OnHeroUpload" accept="image/*" />
                            @if (Vm.IsUploading) { <span class="w-uploading">업로드 중... (@_uploadElapsedSec 초)</span> }
                            <p class="w-hint">
                                권장 원본: 짧은 변 2,000px 이상, 여백이 있는 4:5 사진(예: 2000×2500 이상).
                                PC는 16:9, 폰은 선택한 기기 비율로 영역을 따로 지정할 수 있습니다.
                            </p>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config.HeroImageFileName))
                            {
                                <button type="button" class="w-btn w-btn--primary" @onclick="OpenHeroCropEditor">
                                    전체 표시 · 사용할 영역 편집
                                </button>
                            }
                        </section>

                        @if (_heroCropEditorOpen && !string.IsNullOrWhiteSpace(Vm.Config!.HeroImageFileName))
                        {
                            <div class="w-hero-crop-modal__backdrop" @onclick="CloseHeroCropEditor">
                                <section class="w-hero-crop-modal"
                                         role="dialog"
                                         aria-modal="true"
                                         aria-labelledby="hero-crop-title"
                                         @onclick:stopPropagation>
                                    <header class="w-hero-crop-modal__head">
                                        <div>
                                            <h3 id="hero-crop-title">히어로 이미지 표시 영역</h3>
                                            <p>전체 사진을 쓰거나, 화면 비율이 고정된 사각형을 그리고 이동·확대해 사용할 영역을 고르세요.</p>
                                        </div>
                                        <button type="button" class="w-admin-preview__close" @onclick="CloseHeroCropEditor" aria-label="닫기">✕</button>
                                    </header>

                                    <div class="w-hero-crop-guide">
                                        <strong>가장 선명하게 보이는 원본</strong>
                                        <span>짧은 변 2,000px 이상 · 권장 2000×2500(4:5) 이상 · 인물과 글자가 사진 가장자리에서 떨어진 구도</span>
                                        <small>PC 목표 1920×1080 · 폰 목표 1080×1920. 한 장을 함께 쓰므로 원본에 여백이 많을수록 두 화면 모두 자연스럽습니다.</small>
                                    </div>

                                    <div class="w-hero-crop-modal__tabs">
                                        <button type="button"
                                                class="@(_heroCropViewport == "desktop" ? "active" : "")"
                                                @onclick='() => SetHeroCropViewport("desktop")'>
                                            PC · 16:9
                                        </button>
                                        <button type="button"
                                                class="@(_heroCropViewport == "mobile" ? "active" : "")"
                                                @onclick='() => SetHeroCropViewport("mobile")'>
                                            폰 · @CurrentPreviewDevice.Width×@CurrentPreviewDevice.Height
                                        </button>
                                    </div>

                                    <div class="w-hero-crop-modal__modes">
                                        <button type="button"
                                                class="@(CurrentHeroCropUsesFullImage ? "active" : "")"
                                                @onclick="() => SetHeroCropMode(true)">
                                            전체 표시
                                            <small>사진을 자르지 않고 여백 허용</small>
                                        </button>
                                        <button type="button"
                                                class="@(!CurrentHeroCropUsesFullImage ? "active" : "")"
                                                @onclick="() => SetHeroCropMode(false)">
                                            사각형 영역 사용
                                            <small>선택 영역으로 화면을 빈틈없이 채움</small>
                                        </button>
                                    </div>

                                    @if (CurrentHeroCropUsesFullImage)
                                    {
                                        <div class="w-hero-crop-editor w-hero-crop-editor--full">
                                            <img src="@Vm.GetHeroUrl(Slug, Vm.Config.HeroImageFileName)" alt="히어로 원본 전체" />
                                            <span>전체 이미지가 표시됩니다. 화면 비율이 다르면 위·아래 또는 좌·우에 여백이 생길 수 있습니다.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div @key="HeroCropEditorKey"
                                             class="w-hero-crop-editor"
                                             data-hero-crop-editor-stage
                                             data-viewport="@_heroCropViewport"
                                             data-aspect="@CurrentHeroCropAspect.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                             data-crop-x="@CurrentHeroCropDraft.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                             data-crop-y="@CurrentHeroCropDraft.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                             data-crop-width="@CurrentHeroCropDraft.Width.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                             data-crop-height="@CurrentHeroCropDraft.Height.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            <img src="@Vm.GetHeroUrl(Slug, Vm.Config.HeroImageFileName)" alt="영역을 선택할 히어로 원본" />
                                            <div class="w-hero-crop-editor__selection" data-crop-selection>
                                                <span class="w-hero-crop-editor__label">@(_heroCropViewport == "desktop" ? "PC 16:9" : $"폰 {CurrentPreviewDevice.Width}:{CurrentPreviewDevice.Height}")</span>
                                                <i data-crop-handle="nw"></i>
                                                <i data-crop-handle="ne"></i>
                                                <i data-crop-handle="sw"></i>
                                                <i data-crop-handle="se"></i>
                                            </div>
                                        </div>
                                        <p class="w-hint">빈 곳을 끌어 새 사각형을 그리고, 사각형 안쪽은 이동, 네 모서리는 크기 조절입니다. 화면 비율은 자동으로 유지됩니다.</p>
                                    }

                                    <footer class="w-hero-crop-modal__actions">
                                        <button type="button" class="w-btn" @onclick="CloseHeroCropEditor">취소</button>
                                        <button type="button" class="w-btn w-btn--primary" @onclick="ApplyHeroCropEditor">적용하고 미리보기</button>
                                    </footer>
                                </section>
                            </div>
                        }

                        @if (UsesInviteHeroPlacement)
                        {
                            <section class="w-admin__section">
                                <h3 class="w-admin__section-h">히어로 문구 위치</h3>
                                <p class="w-hint">PC 또는 폰 미리보기를 먼저 선택한 뒤 문구 박스를 끌어 주세요. 두 위치는 따로 저장되며 드래그를 놓으면 즉시 반영됩니다.</p>
                                <div class="w-drag-control-grid">
                                    <div class="w-drag-control-card">
                                        <strong>상단 문구</strong>
                                        <div class="w-drag-control-device">
                                            <span><b>PC</b> @FormatPanelPosition(Vm.Config!.DesignSettings.HeroPlacement.InviteTop, false)</span>
                                            <div>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => SetPreviewMode("pc")'>끌어서 조정</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => AlignHeroPanel("heroTop", false)'>정렬</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => ResetHeroPanel("heroTop", false)'>초기화</button>
                                            </div>
                                        </div>
                                        <div class="w-drag-control-device">
                                            <span><b>폰</b> @FormatPanelPosition(Vm.Config.DesignSettings.HeroPlacement.InviteTop, true)</span>
                                            <div>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => SetPreviewMode("phone")'>끌어서 조정</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => AlignHeroPanel("heroTop", true)'>정렬</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => ResetHeroPanel("heroTop", true)'>초기화</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="w-drag-control-card">
                                        <strong>하단 장소·방명록</strong>
                                        <div class="w-drag-control-device">
                                            <span><b>PC</b> @FormatPanelPosition(Vm.Config!.DesignSettings.HeroPlacement.InviteBottom, false)</span>
                                            <div>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => SetPreviewMode("pc")'>끌어서 조정</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => AlignHeroPanel("heroBottom", false)'>정렬</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => ResetHeroPanel("heroBottom", false)'>초기화</button>
                                            </div>
                                        </div>
                                        <div class="w-drag-control-device">
                                            <span><b>폰</b> @FormatPanelPosition(Vm.Config.DesignSettings.HeroPlacement.InviteBottom, true)</span>
                                            <div>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => SetPreviewMode("phone")'>끌어서 조정</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => AlignHeroPanel("heroBottom", true)'>정렬</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => ResetHeroPanel("heroBottom", true)'>초기화</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        }
                    }

                    @* ─────────── 스토리 챕터 ─────────── *@
                    else if (_selected == "story")
                    {
                        @if (!IsStoryLayout)
                        {
                            <section class="w-admin__section">
                                <h3 class="w-admin__section-h">스토리 챕터</h3>
                                <p class="w-hint">Story 레이아웃을 선택하면 챕터 문구와 대표 사진을 관리할 수 있습니다.</p>
                            </section>
                        }
                        else
                        {
                            <section class="w-admin__section">
                                <div class="w-admin-section-title-row">
                                    <div>
                                        <h3 class="w-admin__section-h">스토리 챕터</h3>
                                        <p class="w-hint">Story 레이아웃에서 사용할 챕터별 대표 사진과 문구입니다. 기본 4개 챕터는 유지되고, 필요한 챕터를 추가할 수 있습니다.</p>
                                    </div>
                                    <button type="button" class="w-btn w-btn--primary" @onclick="OnAddStoryChapter">챕터 추가</button>
                                </div>
                                <div class="w-story-admin-list">
                                    @foreach (var chapter in Vm.Config!.DesignSettings.StoryChapters)
                                    {
                                        <article class="w-story-admin-card">
                                            <div class="w-story-admin-card__head">
                                                <strong>@chapter.Label</strong>
                                                <div class="w-story-admin-card__actions">
                                                    @if (chapter.ChapterNumber <= 4)
                                                    {
                                                        <span class="w-layout-lock">기본</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="w-btn w-btn--small" @onclick="() => OnDeleteStoryChapter(chapter.ChapterNumber)">삭제</button>
                                                    }
                                                    <button type="button" class="w-btn w-btn--small" @onclick="() => OnSaveStoryChapter(chapter)">챕터 저장</button>
                                                </div>
                                            </div>
                                            <label class="w-label">챕터 제목</label>
                                            <input class="w-input" @bind="chapter.Title" />
                                            <label class="w-label">챕터 본문</label>
                                            <textarea class="w-input w-textarea" rows="4" @bind="chapter.Body"></textarea>
                                            <label class="w-label">대표 사진</label>
                                            <select class="w-input" @bind="chapter.PhotoPath">
                                                <option value="">자동 선택</option>
                                                @foreach (var photo in Vm.Gallery)
                                                {
                                                    <option value="@photo.FileName">@photo.FileName</option>
                                                }
                                            </select>
                                            @if (!string.IsNullOrWhiteSpace(chapter.PhotoPath))
                                            {
                                                <div class="w-story-admin-photo">
                                                    <img src="@Vm.GetThumbUrl(Slug, chapter.PhotoPath)" alt="선택된 대표 사진" />
                                                    <span>@chapter.PhotoPath</span>
                                                </div>
                                            }
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                    }

                    @* ─────────── 포토북 페이지 ─────────── *@
                    else if (_selected == "photobook")
                    {
                        @if (!IsPhotoBookLayout)
                        {
                            <section class="w-admin__section">
                                <h3 class="w-admin__section-h">포토북 페이지</h3>
                                <p class="w-hint">PhotoBook 레이아웃을 선택하면 앨범 페이지별 사진과 문구를 관리할 수 있습니다.</p>
                            </section>
                        }
                        else
                        {
                            <section class="w-admin__section">
                                <div class="w-admin-section-title-row">
                                    <div>
                                        <h3 class="w-admin__section-h">포토북 페이지</h3>
                                        <p class="w-hint">포토북 앨범 상단에 크게 표시할 페이지입니다. 사진을 지정하지 않으면 갤러리 순서대로 자동 보충됩니다. 기본 4개는 유지되고 필요하면 추가할 수 있습니다.</p>
                                    </div>
                                    <button type="button" class="w-btn w-btn--primary" @onclick="OnAddPhotoBookPage">페이지 추가</button>
                                </div>
                                <div class="w-story-admin-list">
                                    @* Razor 는 '@page' 를 지시문으로 예약하므로 반복 변수 이름은 반드시 page 를 피해야 한다. *@
                                    @foreach (var bookPage in Vm.Config!.DesignSettings.PhotoBookPages)
                                    {
                                        <article class="w-story-admin-card">
                                            <div class="w-story-admin-card__head">
                                                <strong>@bookPage.Caption</strong>
                                                <div class="w-story-admin-card__actions">
                                                    @if (bookPage.PageNumber <= 4)
                                                    {
                                                        <span class="w-layout-lock">기본</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="w-btn w-btn--small" @onclick="() => OnDeletePhotoBookPage(bookPage.PageNumber)">삭제</button>
                                                    }
                                                    <button type="button" class="w-btn w-btn--small" @onclick="() => OnSavePhotoBookPage(bookPage)">페이지 저장</button>
                                                </div>
                                            </div>
                                            <label class="w-label">캡션 (짧은 한 줄)</label>
                                            <input class="w-input" @bind="bookPage.Caption" placeholder="예: 첫 만남" />
                                            <label class="w-label">본문 문구</label>
                                            <textarea class="w-input w-textarea" rows="3" @bind="bookPage.Body" placeholder="사진 아래에 표시할 짧은 문구"></textarea>
                                            <label class="w-label">사진 선택</label>
                                            <select class="w-input" @bind="bookPage.PhotoFileName">
                                                <option value="">자동 보충 (갤러리 순서)</option>
                                                @foreach (var photo in Vm.Gallery)
                                                {
                                                    <option value="@photo.FileName">@photo.FileName</option>
                                                }
                                            </select>
                                            @if (!string.IsNullOrWhiteSpace(bookPage.PhotoFileName))
                                            {
                                                <div class="w-story-admin-photo">
                                                    <img src="@Vm.GetThumbUrl(Slug, bookPage.PhotoFileName)" alt="선택된 페이지 사진" />
                                                    <span>@bookPage.PhotoFileName</span>
                                                </div>
                                            }
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                    }

                    @* ─────────── 카드 강조 ─────────── *@
                    else if (_selected == "cards")
                    {
                        @if (!IsCardLayout)
                        {
                            <section class="w-admin__section">
                                <h3 class="w-admin__section-h">카드 강조</h3>
                                <p class="w-hint">Card 레이아웃을 선택하면 각 섹션 카드의 아이콘과 제목·부제를 커스터마이즈할 수 있습니다.</p>
                            </section>
                        }
                        else
                        {
                            <section class="w-admin__section">
                                <div class="w-admin-section-title-row">
                                    <div>
                                        <h3 class="w-admin__section-h">카드 강조</h3>
                                        <p class="w-hint">카드 레이아웃에서 각 섹션 카드(예식 안내/오시는 길/계좌 안내 등) 위에 얹혀 표시될 아이콘·제목·부제입니다. 대상 섹션을 선택하면 그 섹션 카드 헤더가 대체됩니다. 제목을 비우면 섹션 기본 라벨이 표시됩니다.</p>
                                    </div>
                                    <button type="button" class="w-btn w-btn--primary" @onclick="OnAddCardHighlight">강조 카드 추가</button>
                                </div>
                                <div class="w-story-admin-list">
                                    @{
                                        var cardSupportedSections = AppliedLayoutOption?
                                            .SupportedSections
                                            .Where(s => !string.Equals(s, "hero", StringComparison.OrdinalIgnoreCase))
                                            .ToList() ?? new List<string>();
                                    }
                                    @foreach (var highlight in Vm.Config!.DesignSettings.CardHighlights)
                                    {
                                        var headTitle = string.IsNullOrWhiteSpace(highlight.Title)
                                            ? (string.IsNullOrWhiteSpace(highlight.SectionKey) ? "(대상 섹션 미지정)" : WeddingSectionOrderCatalog.GetLabel(highlight.SectionKey))
                                            : highlight.Title;
                                        <article class="w-story-admin-card">
                                            <div class="w-story-admin-card__head">
                                                <strong>@(string.IsNullOrWhiteSpace(highlight.Icon) ? "✨" : highlight.Icon) @headTitle</strong>
                                                <div class="w-story-admin-card__actions">
                                                    @if (highlight.Order <= 3)
                                                    {
                                                        <span class="w-layout-lock">기본</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="w-btn w-btn--small" @onclick="() => OnDeleteCardHighlight(highlight.Order)">삭제</button>
                                                    }
                                                    <button type="button" class="w-btn w-btn--small" @onclick="() => OnSaveCardHighlight(highlight)">카드 저장</button>
                                                </div>
                                            </div>
                                            <label class="w-label">대상 섹션</label>
                                            <select class="w-input" @bind="highlight.SectionKey">
                                                <option value="">(사용 안 함)</option>
                                                @foreach (var sectionKey in cardSupportedSections)
                                                {
                                                    <option value="@sectionKey">@WeddingSectionOrderCatalog.GetIcon(sectionKey) @WeddingSectionOrderCatalog.GetLabel(sectionKey)</option>
                                                }
                                            </select>
                                            <label class="w-label">아이콘 · 이모지 <span class="w-label__hint">비우면 섹션 기본 아이콘</span></label>
                                            <input class="w-input" @bind="highlight.Icon" placeholder="예: 💒 📍 💌" />
                                            <label class="w-label">제목 오버라이드 <span class="w-label__hint">비우면 섹션 기본 라벨</span></label>
                                            <input class="w-input" @bind="highlight.Title" placeholder="비워두면 섹션 라벨 그대로" />
                                            <label class="w-label">부제 · 본문</label>
                                            <textarea class="w-input w-textarea" rows="2" @bind="highlight.Body" placeholder="카드 헤더 아래에 얹을 부가 문구(선택)"></textarea>
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                    }

                    @* ─────────── 콘텐츠 ─────────── *@
                    else if (_selected == "content")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🎵 @Text["admin.media.music"]</h3>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config!.MusicFileName))
                            {
                                <div class="w-admin__music-preview">
                                    <audio controls src="@Vm.GetMusicUrl(Slug, Vm.Config.MusicFileName)" style="width:100%"></audio>
                                    <span class="w-hint">@Text["common.current"]: @Vm.Config.MusicFileName</span>
                                    <button class="w-btn w-btn--danger w-btn--sm" @onclick="OnRemoveMusic">🗑 @Text["common.remove"]</button>
                                </div>
                            }
                            else
                            {
                                <p class="w-hint">@Text["admin.media.music.empty"]</p>
                            }
                            <InputFile class="w-file-input" OnChange="OnMusicUpload" accept="audio/*" />
                            @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }

                            <label class="w-label" style="margin-top:.75rem">@Text["admin.media.position"]</label>
                            <div class="w-drag-control-card">
                                <span>@Text["admin.media.position.hint"]</span>
                                <span>@FormatFloatingPosition(Vm.Config!.DesignSettings.MusicButtonPlacement)</span>
                                <button type="button" class="w-btn w-btn--sm" @onclick="ResetMusicButtonPosition">@Text["admin.media.default.position"]</button>
                            </div>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🎬 @Text["admin.media.video"]</h3>
                            <p class="w-hint">갤러리 위에 표시됩니다. mp4 / webm / mov 권장, @Vm.MaxVideoSizeLabel, @(Vm.MaxVideoCount <= 0 ? "개수 무제한" : $"최대 {Vm.MaxVideoCount}개").</p>

                            @if (Vm.Config!.VideoFileNames.Count > 0)
                            {
                                <div class="w-admin__video-list">
                                    @foreach (var fn in Vm.Config.VideoFileNames.ToList())
                                    {
                                        <div class="w-admin__video-item">
                                            <video src="@Vm.GetVideoUrl(Slug, fn)"
                                                   controls preload="metadata" class="w-admin__video-player"></video>
                                            <div class="w-admin__video-meta">
                                                <span class="w-hint">@fn</span>
                                                <button class="w-btn w-btn--danger w-btn--sm"
                                                        @onclick="() => OnDeleteVideo(fn)">@Text["common.delete"]</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (Vm.MaxVideoCount <= 0 || Vm.Config.VideoFileNames.Count < Vm.MaxVideoCount)
                            {
                                <InputFile class="w-file-input" OnChange="OnVideoUpload" accept="video/*" />
                                @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }
                            }
                            else
                            {
                                <p class="w-hint" style="color:var(--w-primary)">최대 @(Vm.MaxVideoCount)개 업로드 완료. 삭제 후 추가 가능합니다.</p>
                            }
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🖼 @Text["admin.media.gallery"] (@Vm.Gallery.Count)</h3>

                            <label class="w-label">@Text["admin.media.interval"] — <strong>@Vm.Config!.GalleryAutoPlaySeconds @Text["common.seconds"]</strong></label>
                            <input type="range" class="w-range" min="1" max="10" step="1"
                                   @bind="Vm.Config!.GalleryAutoPlaySeconds" @bind:event="oninput" />
                            <p class="w-hint">1 ~ 10초 · 설정 저장 후 청첩장에 반영됩니다.</p>

                            <InputFile class="w-file-input" OnChange="OnGalleryUpload" accept="image/*" multiple />
                            @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }

                            <div class="w-admin__gallery">
                                @foreach (var p in Vm.Gallery)
                                {
                                    <div class="w-admin__gallery-item">
                                        <img src="@Vm.GetThumbUrl(Slug, p.FileName)" alt="@p.FileName" />
                                        <div class="w-admin__photo-order">
                                            <button type="button" class="w-btn w-btn--sm" title="맨 앞으로" @onclick="() => OnMovePhotoTo(p.FileName, true)">처음</button>
                                            <button type="button" class="w-btn w-btn--sm" title="앞으로" @onclick="() => OnMovePhoto(p.FileName, -1)">↑</button>
                                            <button type="button" class="w-btn w-btn--sm" title="뒤로" @onclick="() => OnMovePhoto(p.FileName, 1)">↓</button>
                                            <button type="button" class="w-btn w-btn--sm" title="맨 뒤로" @onclick="() => OnMovePhotoTo(p.FileName, false)">끝</button>
                                        </div>
                                        <button class="w-btn w-btn--danger w-btn--sm"
                                                @onclick="() => OnDeletePhoto(p.FileName)">@Text["common.delete"]</button>
                                        <span class="w-admin__fname">@p.FileName</span>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @* ─────────── 지도 ─────────── *@
                    else if (_selected == "map")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.map.coordinates"]</h3>
                            <div class="w-maplink-header">
                                <span class="w-label" style="margin:0">@Text["admin.map.latlng"]</span>
                                <button class="w-btn w-btn--sm" type="button" @onclick="OnGeocode"
                                        disabled="@Vm.IsGeocoding"
                                        title="예식장 이름/주소로 위도·경도를 자동으로 찾아줍니다">
                                    @(Vm.IsGeocoding ? Text["admin.map.searching"] : $"📍 {Text["admin.map.search"]}")
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Vm.GeocodeStatus))
                            {
                                <p class="w-hint" style="color:@(Vm.GeocodeStatus.StartsWith("✅") ? "green" : "#e53e3e")">
                                    @Vm.GeocodeStatus
                                </p>
                            }
                            <div class="w-coord-row">
                                <div>
                                    <label class="w-label">@Text["admin.map.latitude"]</label>
                                    <input class="w-input" type="number" step="0.000001" @bind="Vm.Config!.VenueLat" placeholder="자동 검색 또는 직접 입력" />
                                </div>
                                <div>
                                    <label class="w-label">@Text["admin.map.longitude"]</label>
                                    <input class="w-input" type="number" step="0.000001" @bind="Vm.Config.VenueLng" placeholder="자동 검색 또는 직접 입력" />
                                </div>
                            </div>
                            <p class="w-hint">좌표가 있으면 청첩장에 지도가 표시됩니다. 예식장 이름·주소는 <strong>기본 정보</strong> 탭에서 먼저 입력하세요.</p>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🗺 @Text["admin.map.links"]</h3>
                            <div class="w-maplink-header">
                                <span class="w-label" style="margin:0">카카오맵 · 네이버지도 · 아틀란 · T맵</span>
                                <button class="w-btn w-btn--sm" type="button" @onclick="OnAutoGenerateMapLinks"
                                        title="예식장 이름·주소·좌표를 이용해 링크를 자동으로 채워드립니다">
                                    ✨ @Text["admin.map.generate"]
                                </button>
                            </div>
                            <p class="w-hint">예식장 이름/주소/좌표를 먼저 입력한 후 <strong>자동 생성</strong> 버튼을 누르세요.</p>
                            @if (Vm.Config!.MapLinkKakao != "" || Vm.Config.MapLinkNaver != "" || Vm.Config.MapLinkAtlan != "" || Vm.Config.MapLinkTmap != "")
                            {
                                <p class="w-hint" style="color:green">✅ 링크 생성 완료 (카카오맵 · 네이버지도 · 아틀란 · T맵)</p>
                            }
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.map.roadmap"]</h3>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config!.RoadMapFileName))
                            {
                                <div class="w-admin__hero-preview">
                                    <img src="@Vm.GetRoadMapUrl(Slug, Vm.Config.RoadMapFileName)" alt="약도" />
                                    <span>@Vm.Config.RoadMapFileName</span>
                                </div>
                            }
                            else
                            {
                                <p class="w-hint">아직 약도 이미지가 없습니다. 업로드하면 청첩장 약도 탭에 표시됩니다.</p>
                            }
                            <InputFile class="w-file-input" OnChange="OnRoadMapUpload" accept="image/*" />
                            @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }
                        </section>
                    }

                    @* ─────────── 계좌 안내 ─────────── *@
                    else if (_selected == "account")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">💌 @Text["admin.payment.title"]</h3>
                            <p class="w-hint">@Text["admin.payment.hint"]</p>

                            @for (int i = 0; i < Vm.Config!.Accounts.Count; i++)
                            {
                                var idx = i;
                                var acc = Vm.Config.Accounts[idx];
                                <div class="w-acc-editor">
                                    <div class="w-acc-editor__header">
                                        <strong>@((idx + 1))번 — @(string.IsNullOrWhiteSpace(acc.Label) ? "(레이블 없음)" : acc.Label)</strong>
                                        <button class="w-btn w-btn--danger w-btn--sm" @onclick="() => RemoveAccount(idx)">✕ @Text["common.delete"]</button>
                                    </div>
                                    <div class="w-acc-editor__grid">
                                        <div>
                                            <label class="w-label">@Text["admin.payment.label"]</label>
                                            <select class="w-input" value="@acc.Label" @onchange="e => OnAccountLabelChanged(acc, e)">
                                                <option value="신랑">@Text["admin.payment.groom"]</option>
                                                <option value="신부">@Text["admin.payment.bride"]</option>
                                                <option>신랑 아버지</option>
                                                <option>신랑 어머니</option>
                                                <option>신부 아버지</option>
                                                <option>신부 어머니</option>
                                                <option value="직접 입력">@Text["admin.payment.custom"]</option>
                                            </select>
                                            @if (acc.Label == "직접 입력" || !_defaultLabels.Contains(acc.Label))
                                            {
                                                <input class="w-input" style="margin-top:.4rem" @bind="acc.Label" @bind:after="PublishPreviewAccountDraftAsync" placeholder="레이블 직접 입력" />
                                            }
                                        </div>
                                        <div>
                                            <label class="w-label">@Text["admin.payment.name"]</label>
                                            <input class="w-input" @bind="acc.Name" @bind:after="PublishPreviewAccountDraftAsync" placeholder="홍길동" />
                                        </div>
                                        <div>
                                            <label class="w-label">@Text["admin.payment.contact"]</label>
                                            <input class="w-input" @bind="acc.Phone" @bind:after="PublishPreviewAccountDraftAsync" placeholder="010-0000-0000" />
                                        </div>
                                        <div>
                                            <label class="w-label">@Text["admin.payment.bank"]</label>
                                            <input class="w-input" @bind="acc.BankName" @bind:after="PublishPreviewAccountDraftAsync" placeholder="국민은행" />
                                        </div>
                                        <div>
                                            <label class="w-label">@Text["admin.payment.number"]</label>
                                            <input class="w-input" @bind="acc.Account" @bind:after="PublishPreviewAccountDraftAsync" placeholder="000-000-000000" />
                                        </div>
                                        <div>
                                            <label class="w-label">@Text["admin.payment.holder"]</label>
                                            <input class="w-input" @bind="acc.AccountHolder" @bind:after="PublishPreviewAccountDraftAsync" placeholder="홍길동" />
                                        </div>
                                        <div class="w-acc-editor__full">
                                            <label class="w-label">카카오페이 URL (선택)</label>
                                            <input class="w-input" @bind="acc.KakaoPayUrl" @bind:after="PublishPreviewAccountDraftAsync" placeholder="https://qr.kakaopay.com/..." />
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Vm.Config.Accounts.Count < 8)
                            {
                                <button class="w-btn" @onclick="AddAccount">+ @Text["admin.payment.add"]</button>
                            }
                        </section>
                    }

                    @* ─────────── 공유 설정 ─────────── *@
                    else if (_selected == "share")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.share.mode"]</h3>
                            <select class="w-input" @bind="Vm.Config!.Mode">
                                <option value="@WeddingSiteMode.Invite">@Text["admin.share.invite"]</option>
                                <option value="@WeddingSiteMode.ThankYou">@Text["admin.share.thankyou"]</option>
                                <option value="@WeddingSiteMode.Both">@Text["admin.share.both"]</option>
                            </select>
                            <p class="w-hint">예식 완료 후 <strong>감사장</strong>으로 바꾸면 지도·예식 안내 대신 감사 인사가 표시됩니다.</p>

                            <label class="w-label">감사장 URL (외부, 선택)</label>
                            <input class="w-input" @bind="Vm.Config.ThankYouUrl" placeholder="https://thankyou.example.com" />

                            <label class="w-label">@Text["admin.share.home"]</label>
                            <label class="w-toggle">
                                <input type="checkbox" @bind="Vm.Config.ShowOnHome" />
                                <span class="w-toggle__track"></span>
                                <span class="w-toggle__label">@(Vm.Config.ShowOnHome ? "ON — 메인 페이지에 표시됨" : "OFF — 메인 페이지에 숨김")</span>
                            </label>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🔎 @Text["admin.share.seo"]</h3>
                            <p class="w-hint">
                                허용하면 이 청첩장이 자동 사이트맵에 포함되고 Google·네이버 같은 검색 엔진에
                                색인을 허용합니다. 검색 결과 반영과 제외에는 수일 이상 걸릴 수 있습니다.
                            </p>

                            <label class="w-label">검색 엔진 노출</label>
                            <label class="w-toggle">
                                <input type="checkbox"
                                       checked="@EffectiveSearchIndexing"
                                       @onchange="OnSearchIndexingChanged" />
                                <span class="w-toggle__track"></span>
                                <span class="w-toggle__label">
                                    @(EffectiveSearchIndexing
                                        ? "ON — 검색 결과 노출 및 사이트맵 포함"
                                        : "OFF — noindex 적용 및 사이트맵 제외")
                                </span>
                            </label>

                            @if (!Vm.Config!.IsPublished)
                            {
                                <p class="w-status w-status--compact">
                                    현재 청첩장이 비공개 상태라 검색 노출을 켜도 색인되지 않습니다.
                                </p>
                            }

                            <label class="w-label">@Text["admin.share.search.title"]</label>
                            <input class="w-input"
                                   maxlength="70"
                                   @bind="Vm.Config.SearchTitle"
                                   placeholder="@WeddingSeoService.ResolveSearchTitle(Vm.Config)" />
                            <p class="w-hint">비워두면 커플 이름을 이용해 자동 생성합니다.</p>

                            <label class="w-label">@Text["admin.share.search.description"]</label>
                            <textarea class="w-input w-textarea"
                                      rows="3"
                                      maxlength="180"
                                      @bind="Vm.Config.SearchDescription"
                                      placeholder="@WeddingSeoService.ResolveSearchDescription(Vm.Config)"></textarea>
                            <p class="w-hint">검색 사이트가 상황에 따라 페이지 내용에서 다른 문구를 선택할 수도 있습니다.</p>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🔗 @Text["admin.share.og"]</h3>
                            <p class="w-hint">카카오톡·문자 등으로 청첩장 링크를 공유할 때 표시되는 제목·설명·이미지입니다.</p>

                            <label class="w-label">@Text["admin.share.og.title"]</label>
                            <input class="w-input" @bind="Vm.Config!.OgTitle"
                                   placeholder="@(Vm.Config?.CoupleName + " 청첩장")" />

                            <label class="w-label">@Text["admin.share.og.description"]</label>
                            <textarea class="w-input w-textarea" rows="3" @bind="Vm.Config!.OgDescription"
                                      placeholder="@($"{Vm.Config?.WeddingDate:yyyy년 MM월 dd일} {Vm.Config?.VenueName}에서 함께해 주세요.")"></textarea>

                            <label class="w-label">@Text["admin.share.og.image"]</label>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config!.OgImageFileName))
                            {
                                <div class="w-admin__hero-preview">
                                    <img src="@Vm.GetOgImageUrl(Slug, Vm.Config.OgImageFileName)" alt="OG 이미지" />
                                    <span>@Vm.Config.OgImageFileName</span>
                                    <button class="w-btn w-btn--sm" @onclick="() => { Vm.Config!.OgImageFileName = string.Empty; }">✕ @Text["common.remove"]</button>
