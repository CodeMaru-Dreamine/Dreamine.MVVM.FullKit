    }

    private void OnThemeBaseColorChanged(ChangeEventArgs e)
    {
        if (Vm.Config is null
            || !Vm.Config.HasPremiumPlan
            || !WeddingThemePaletteGenerator.TryNormalizeHexColor(
                e.Value?.ToString(),
                out var baseColor))
        {
            return;
        }

        var custom = Vm.Config.DesignSettings.CustomTheme
            ??= new CustomWeddingThemeSettings();
        WeddingThemePaletteGenerator.ApplyGenerated(custom, baseColor);
        ActivateCustomTheme();
        QueueThemePreview(
            "대표 색상으로 읽기 편한 팔레트를 자동 생성해 미리보기에 반영했습니다.");
    }

    private void ApplyAutomaticThemePalette()
    {
        if (Vm.Config is null || !Vm.Config.HasPremiumPlan)
        {
            return;
        }

        var custom = Vm.Config.DesignSettings.CustomTheme
            ??= new CustomWeddingThemeSettings();
        var baseColor = WeddingThemePaletteGenerator.NormalizeHexColor(
            custom.BaseColor,
            custom.Primary);
        WeddingThemePaletteGenerator.ApplyGenerated(custom, baseColor);
        ActivateCustomTheme();
        _themePreviewMessage =
            "대표 색상으로 읽기 편한 팔레트를 자동 생성해 미리보기에 반영했습니다.";
        CaptureThemePreview();
    }

    private void UpdateCustomThemeColor(string token, string? value)
    {
        if (Vm.Config is null
            || !Vm.Config.HasPremiumPlan
            || !WeddingThemePaletteGenerator.TryNormalizeHexColor(
                value,
                out var normalized))
        {
            return;
        }

        var custom = Vm.Config.DesignSettings.CustomTheme
            ??= new CustomWeddingThemeSettings();
        switch (token)
        {
            case "primary":
                custom.Primary = normalized;
                break;
            case "accent":
                custom.Accent = normalized;
                break;
            case "dark":
                custom.Dark = normalized;
                break;
            case "text":
                custom.Text = normalized;
                break;
            case "muted":
                custom.MutedText = normalized;
                break;
            case "background":
                custom.Background = normalized;
                break;
            case "panel":
                custom.PanelBackground = normalized;
                break;
            case "button":
                custom.ButtonBackground = normalized;
                break;
            case "button-text":
                custom.ButtonText = normalized;
                break;
            case "border":
                custom.Border = normalized;
                break;
            default:
                return;
        }

        ActivateCustomTheme();
        QueueThemePreview(
            "세부 색상 변경을 미리보기에 반영했습니다. 설정 저장 전까지 공개 화면에는 적용되지 않습니다.");
    }

    private void ActivateCustomTheme()
    {
        if (Vm.Config is null)
        {
            return;
        }

        Vm.Config.DesignSettings.ThemeKey = WeddingThemeCatalog.CustomThemeKey;
        Vm.Config.ThemeName = WeddingThemeCatalog.CustomThemeKey;
    }

    private void QueueThemePreview(string message)
    {
        _themePreviewDebounceCts?.Cancel();
        _themePreviewDebounceCts?.Dispose();
        var cts = new System.Threading.CancellationTokenSource();
        _themePreviewDebounceCts = cts;
        _ = ApplyThemePreviewAfterDelayAsync(message, cts);
    }

    private async Task ApplyThemePreviewAfterDelayAsync(
        string message,
        System.Threading.CancellationTokenSource source)
    {
        try
        {
            await Task.Delay(160, source.Token);
            await InvokeAsync(() =>
            {
                if (source.IsCancellationRequested)
                {
                    return;
                }

                _themePreviewMessage = message;
                CaptureThemePreview();
                StateHasChanged();
            });
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void CaptureThemePreview()
    {
        if (Vm.Config is null)
        {
            return;
        }

        var key = Vm.Config.DesignSettings.ThemeKey;
        var palette = string.Equals(
                key,
                WeddingThemeCatalog.CustomThemeKey,
                StringComparison.OrdinalIgnoreCase)
            ? WeddingThemePaletteGenerator.ResolveForEditing(
                Vm.Config.DesignSettings.CustomTheme)
            : null;
        _themePreviewSelection = new WeddingThemePreviewSelection(key, palette);
        _previewOpen = true;
        _previewRevision++;
    }

