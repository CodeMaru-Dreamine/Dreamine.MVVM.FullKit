                                    <img src="@Vm.GetHeroUrl(Slug, Vm.Config.HeroImageFileName)" alt="@Text["admin.hero.image"]" />
                                    <span>
                                        <b>@Vm.Config.HeroImageFileName</b>
                                        <small>@Text["admin.hero.image.tap"]</small>
                                    </span>
                                </button>
                            }
                            <LocalizedInputFile Class="w-file-input" OnChange="OnHeroUpload" Accept="image/*" />
                            @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }
                            <p class="w-hint">@Text["admin.hero.image.recommend"]</p>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config.HeroImageFileName))
                            {
                                <button type="button" class="w-btn w-btn--primary" @onclick="OpenHeroCropEditor">
                                    @Text["admin.hero.image.edit.area"]
                                </button>
                            }
                        </section>

                        @if (_heroCropEditorOpen && !string.IsNullOrWhiteSpace(Vm.Config!.HeroImageFileName))
                        {
                            <div class="w-hero-crop-modal__backdrop" @onclick="CloseHeroCropEditor">
                                <section class="w-hero-crop-modal"
                                         role="dialog"
                                         aria-modal="true"
                                         aria-labelledby="hero-crop-title"
                                         @onclick:stopPropagation>
                                    <header class="w-hero-crop-modal__head">
                                        <div>
                                            <h3 id="hero-crop-title">@Text["admin.hero.crop.title"]</h3>
                                            <p>@Text["admin.hero.crop.desc"]</p>
                                        </div>
                                        <button type="button" class="w-admin-preview__close" @onclick="CloseHeroCropEditor" aria-label="@Text["common.cancel"]">✕</button>
                                    </header>

                                    <div class="w-hero-crop-guide">
                                        <strong>@Text["admin.hero.crop.source"]</strong>
                                        <span>@Text["admin.hero.crop.source.hint"]</span>
                                        <small>@Text["admin.hero.crop.target.hint"]</small>
                                    </div>

                                    <div class="w-hero-crop-modal__tabs">
                                        <button type="button"
                                                class="@(_heroCropViewport == "desktop" ? "active" : "")"
                                                @onclick='() => SetHeroCropViewport("desktop")'>
                                            PC · 16:9
                                        </button>
                                        <button type="button"
                                                class="@(_heroCropViewport == "mobile" ? "active" : "")"
                                                @onclick='() => SetHeroCropViewport("mobile")'>
                                            @Text["admin.hero.crop.phone"] · @CurrentPreviewDevice.Width×@CurrentPreviewDevice.Height
                                        </button>
                                    </div>

                                    <div class="w-hero-crop-modal__modes">
                                        <button type="button"
                                                class="@(CurrentHeroCropUsesFullImage ? "active" : "")"
                                                @onclick="() => SetHeroCropMode(true)">
                                            @Text["admin.hero.crop.full"]
                                            <small>@Text["admin.hero.crop.fit"]</small>
                                        </button>
                                        <button type="button"
                                                class="@(!CurrentHeroCropUsesFullImage ? "active" : "")"
                                                @onclick="() => SetHeroCropMode(false)">
                                            @Text["admin.hero.crop.area"]
                                            <small>@Text["admin.hero.crop.fill"]</small>
                                        </button>
                                    </div>

                                    @if (CurrentHeroCropUsesFullImage)
                                    {
                                        <div class="w-hero-crop-editor w-hero-crop-editor--full">
                                            <img src="@Vm.GetHeroUrl(Slug, Vm.Config.HeroImageFileName)" alt="@Text["admin.hero.image"]" />
                                            <span>@Text["admin.hero.crop.full.hint"]</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div @key="HeroCropEditorKey"
                                             class="w-hero-crop-editor"
                                             data-hero-crop-editor-stage
                                             data-viewport="@_heroCropViewport"
                                             data-aspect="@CurrentHeroCropAspect.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                             data-crop-x="@CurrentHeroCropDraft.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                             data-crop-y="@CurrentHeroCropDraft.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                             data-crop-width="@CurrentHeroCropDraft.Width.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                             data-crop-height="@CurrentHeroCropDraft.Height.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            <img src="@Vm.GetHeroUrl(Slug, Vm.Config.HeroImageFileName)" alt="@Text["admin.hero.crop.title"]" />
                                            <div class="w-hero-crop-editor__selection" data-crop-selection>
                                                <span class="w-hero-crop-editor__label">@(_heroCropViewport == "desktop" ? "PC 16:9" : $"{Text["admin.preview.phone"]} {CurrentPreviewDevice.Width}:{CurrentPreviewDevice.Height}")</span>
                                                <i data-crop-handle="nw"></i>
                                                <i data-crop-handle="ne"></i>
                                                <i data-crop-handle="sw"></i>
                                                <i data-crop-handle="se"></i>
                                            </div>
                                        </div>
                                        <p class="w-hint">@Text["admin.hero.crop.drag.hint"]</p>
                                    }

                                    <footer class="w-hero-crop-modal__actions">
                                        <button type="button" class="w-btn" @onclick="CloseHeroCropEditor">@Text["common.cancel"]</button>
                                        <button type="button" class="w-btn w-btn--primary" @onclick="ApplyHeroCropEditor">@Text["admin.hero.crop.apply"]</button>
                                    </footer>
                                </section>
                            </div>
                        }

                        @if (UsesInviteHeroPlacement)
