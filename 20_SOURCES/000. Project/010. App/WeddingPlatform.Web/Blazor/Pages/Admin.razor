    private void OpenHeroCropEditor()
    {
        if (Vm.Config is null) return;
        var presentation = Vm.Config.DesignSettings.HeroImagePresentation;
        _heroCropDesktopFull = !string.Equals(
            presentation.DesktopFit,
            HeroImagePresentationSettings.Cover,
            StringComparison.OrdinalIgnoreCase);
        _heroCropMobileFull = !string.Equals(
            presentation.MobileFit,
            HeroImagePresentationSettings.Cover,
            StringComparison.OrdinalIgnoreCase);
        _heroCropDesktopDraft = CloneCrop(presentation.DesktopCrop);
        _heroCropMobileDraft = CloneCrop(presentation.MobileCrop);
        _heroCropViewport = _previewMode == "pc" ? "desktop" : "mobile";
        _heroCropEditorOpen = true;
        QueueHeroCropEditorInit();
    }

    private void CloseHeroCropEditor()
    {
        _heroCropEditorOpen = false;
        _heroCropEditorNeedsInit = false;
    }

    private void SetHeroCropViewport(string viewport)
    {
        _heroCropViewport = viewport == "desktop" ? "desktop" : "mobile";
        _previewMode = _heroCropViewport == "desktop" ? "pc" : "phone";
        QueueHeroCropEditorInit();
    }

    private void SetHeroCropMode(bool useFullImage)
    {
        if (_heroCropViewport == "mobile") _heroCropMobileFull = useFullImage;
        else _heroCropDesktopFull = useFullImage;
        QueueHeroCropEditorInit();
    }

    private void QueueHeroCropEditorInit()
    {
        _heroCropEditorRevision++;
        _heroCropEditorNeedsInit = _heroCropEditorOpen && !CurrentHeroCropUsesFullImage;
    }

    [JSInvokable]
    public void OnHeroCropDraftChanged(
        string viewport,
        double x,
        double y,
        double width,
        double height)
    {
        var draft = new HeroImageCropRegion
        {
            X = x,
            Y = y,
            Width = width,
            Height = height,
        };
        NormalizeCropDraft(draft);
        if (string.Equals(viewport, "mobile", StringComparison.OrdinalIgnoreCase))
        {
            _heroCropMobileDraft = draft;
        }
        else
        {
            _heroCropDesktopDraft = draft;
        }
    }

    private async Task ApplyHeroCropEditor()
    {
        if (Vm.Config is null) return;
        var presentation = Vm.Config.DesignSettings.HeroImagePresentation;
        presentation.DesktopFit = _heroCropDesktopFull
            ? HeroImagePresentationSettings.Contain
            : HeroImagePresentationSettings.Cover;
        presentation.MobileFit = _heroCropMobileFull
            ? HeroImagePresentationSettings.Contain
            : HeroImagePresentationSettings.Cover;
        presentation.DesktopCrop = CloneCrop(_heroCropDesktopDraft);
        presentation.MobileCrop = CloneCrop(_heroCropMobileDraft);
        presentation.DesktopFocusX = presentation.DesktopCrop.X + presentation.DesktopCrop.Width / 2;
        presentation.DesktopFocusY = presentation.DesktopCrop.Y + presentation.DesktopCrop.Height / 2;
        presentation.MobileFocusX = presentation.MobileCrop.X + presentation.MobileCrop.Width / 2;
        presentation.MobileFocusY = presentation.MobileCrop.Y + presentation.MobileCrop.Height / 2;

        await Vm.SaveConfigAsync();
        CloseHeroCropEditor();
        await ReloadPreview();
    }

    private static HeroImageCropRegion CloneCrop(HeroImageCropRegion source) =>
        new()
        {
            X = source.X,
            Y = source.Y,
            Width = source.Width,
            Height = source.Height,
        };

    private static void NormalizeCropDraft(HeroImageCropRegion crop)
    {
        crop.X = Math.Clamp(double.IsFinite(crop.X) ? crop.X : 0, 0, 95);
        crop.Y = Math.Clamp(double.IsFinite(crop.Y) ? crop.Y : 0, 0, 95);
        crop.Width = Math.Clamp(double.IsFinite(crop.Width) ? crop.Width : 100, 5, 100 - crop.X);
        crop.Height = Math.Clamp(double.IsFinite(crop.Height) ? crop.Height : 100, 5, 100 - crop.Y);
    }

