                            <label class="w-label">@Text["admin.share.og.image"]</label>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config!.ThankYouOgImageFileName))
                            {
                                <div class="w-admin__hero-preview">
                                    <img src="@Vm.GetOgImageUrl(Slug, Vm.Config.ThankYouOgImageFileName)" alt="감사장 OG 이미지" />
                                    <span>@Vm.Config.ThankYouOgImageFileName</span>
                                    <button class="w-btn w-btn--sm" @onclick="() => { Vm.Config!.ThankYouOgImageFileName = string.Empty; }">✕ @Text["common.remove"]</button>
                                </div>
                            }
                            <InputFile class="w-file-input" OnChange="OnThankYouOgImageUpload" accept="image/*" />
                            <p class="w-hint">감사장 전용 이미지가 없으면 청첩장 OG 이미지가 아니라 히어로 이미지를 사용합니다.</p>
                            @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">👥 @Text["admin.share.users"]</h3>
                            <p class="w-hint">공용 로그인 상태에서 기존 관리자 비밀번호를 입력하면 여러 계정이 같은 청첩장을 관리할 수 있습니다.</p>
                            @if (Vm.EffectiveAdminUsers.Count == 0)
                            {
                                <p class="w-hint">아직 공용 로그인에 연결된 관리자 계정이 없습니다.</p>
                            }
                            else
                            {
                                <div class="w-admin-users">
                                    @foreach (var admin in Vm.EffectiveAdminUsers)
                                    {
                                        var isOwner = string.Equals(admin.Role, "Owner", StringComparison.OrdinalIgnoreCase);
                                        <div class="w-admin-users__item">
                                            <div>
                                                <strong>@(isOwner ? Text["admin.owner"] : Text["admin.manager"])</strong>
                                                <span>@(string.IsNullOrWhiteSpace(admin.DisplayName) ? admin.Provider : admin.DisplayName)</span>
                                                @if (!string.IsNullOrWhiteSpace(admin.Email))
                                                {
                                                    <small>@admin.Email</small>
                                                }
                                                <small>@admin.Provider · @admin.AddedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                            </div>
                                            @if (Vm.CanManageAdministrators && !isOwner)
                                            {
                                                <button class="w-btn w-btn--danger w-btn--sm" @onclick="() => OnRemoveAdmin(admin.UserId)">@Text["common.delete"]</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🔒 @Text["admin.share.password"]</h3>
                            <label class="w-label">비밀번호 (변경 시 입력)</label>
                            <input class="w-input" type="password" @bind="Vm.Config!.PasswordHash" />
                        </section>
                    }

                </div>
            </main>

            <!-- ══════ 스플리터 (드래그로 프리뷰 폭 조정) ══════ -->
            <div class="w-admin-splitter" title="@Text["admin.preview.splitter"]"></div>

            <!-- ══════ 프리뷰 ══════ -->
            <aside class="w-admin-preview @(_previewOpen ? "is-open" : "")">
                <div class="w-admin-preview__head">
                    <strong>@PreviewHeaderTitle</strong>
                    <div class="w-admin-preview__actions">
                        <button class="w-admin-preview__mode @(_previewMode == "phone" ? "active" : "")" @onclick='() => SetPreviewMode("phone")'>@Text["admin.preview.phone"]</button>
                        <button class="w-admin-preview__mode @(_previewMode == "pc" ? "active" : "")" @onclick='() => SetPreviewMode("pc")'>PC</button>
                        @if (_previewMode == "phone")
                        {
                            <select class="w-admin-preview__device" value="@_previewDeviceKey" @onchange="SetPreviewDevice" title="@Text["admin.preview.phone"]">
                                @foreach (var device in _previewDevices)
                                {
                                    <option value="@device.Key">@device.Label</option>
                                }
                            </select>
                        }
                        <button class="w-btn w-btn--sm" @onclick="ReloadPreview" title="@Text["admin.preview.refresh"]">🔄</button>
                        <a class="w-btn w-btn--sm" href="@PreviewUrl" target="_blank" title="@Text["admin.preview.newtab"]">↗</a>
                        <button class="w-admin-preview__close" @onclick="OnClosePreview" aria-label="@Text["admin.preview"]">✕</button>
                    </div>
                </div>
                <div class="w-admin-preview__frame w-admin-preview__frame--@_previewMode" style="@PreviewFrameStyle">
                    <iframe id="w-preview-iframe" src="@PreviewUrl" title="@PreviewTitle"></iframe>
                </div>
                <p class="w-admin-preview__hint">@Text["admin.preview.hint"]</p>
            </aside>

        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private string LoginUrl
    {
        get
        {
            var current = Nav.ToAbsoluteUri(Nav.Uri);
            return $"/_identity/login?lang={Uri.EscapeDataString(Text.Language)}&returnUrl={Uri.EscapeDataString(current.PathAndQuery)}";
        }
    }

    private string _selected = "basic";
    private bool _navOpen = false;
    private bool _previewOpen = false;
    private bool _previewCollapsed = false;
    private bool _initialStateLoaded = false;
    private bool _adminInteropInitialized = false;
    private bool _superAdminAutoLoginChecked = false;
    private string _previewMode = "phone";
    private string _previewDeviceKey = "galaxyS26";
    private bool _layoutPickerOpen = false;
    private string _layoutSearch = "";
    private WeddingLayoutReleaseId? _layoutCandidate;
    private string _layoutApplyMessage = "";
    private WeddingThemePreviewSelection? _themePreviewSelection;
    private string _themePreviewMessage = "";
    private System.Threading.CancellationTokenSource? _themePreviewDebounceCts;
    private bool _heroCropEditorOpen;
    private bool _heroCropEditorNeedsInit;
    private string _heroCropViewport = "mobile";
    private bool _heroCropDesktopFull = true;
    private bool _heroCropMobileFull = true;
    private HeroImageCropRegion _heroCropDesktopDraft = new();
    private HeroImageCropRegion _heroCropMobileDraft = new();
    private long _heroCropEditorRevision;
    private long _previewRevision;
    private DotNetObjectReference<Admin>? _selfRef;

    private record NavItem(string Key, string Icon, string Label);
    private record PreviewDevice(string Key, string Label, int Width, int Height);

    private static readonly PreviewDevice[] _previewDevices =
    [
        new("galaxyS26", "Galaxy S26 · 360×780", 360, 780),
        new("galaxyS26Plus", "Galaxy S26+ · 384×854", 384, 854),
        new("galaxyS26Ultra", "Galaxy S26 Ultra · 412×915", 412, 915),
        new("galaxyZFlip7", "Galaxy Z Flip 7 · 360×840", 360, 840),
        new("galaxyZFold7", "Galaxy Z Fold 7 · 412×915", 412, 915),
        new("iphone17", "iPhone 17 · 393×852", 393, 852),
        new("iphone17Pro", "iPhone 17 Pro · 402×874", 402, 874),
        new("iphone17Max", "iPhone 17 Pro Max · 430×932", 430, 932),
        new("iphoneSE", "iPhone SE · 375×667", 375, 667),
        new("iphone15", "iPhone 15 · 393×852", 393, 852),
        new("iphone15Max", "iPhone 15 Pro Max · 430×932", 430, 932),
        new("galaxyS24", "Galaxy S24 · 360×780", 360, 780),
        new("galaxyS24Ultra", "Galaxy S24 Ultra · 384×854", 384, 854),
    ];

    private static readonly NavItem[] _navItems = new[]
    {
        new NavItem("basic",     Icon("user"), "기본 정보"),
        new NavItem("notice",    Icon("note"), "예식 안내"),
        new NavItem("design",    Icon("palette"), "디자인"),
        new NavItem("story",     Icon("note"), "스토리 챕터"),
        new NavItem("photobook", Icon("media"), "포토북 페이지"),
        new NavItem("cards",     Icon("card"), "카드 강조"),
        new NavItem("content",   Icon("media"), "사진·동영상"),
        new NavItem("map",       Icon("pin"), "지도"),
        new NavItem("account",   Icon("card"), "계좌 안내"),
        new NavItem("share",     Icon("share"), "공유 설정"),
    };

    private WeddingLayoutMode EffectiveLegacyLayoutMode =>
        AppliedLayoutOption?.Mode ?? WeddingLayoutMode.WebPage;
    private bool IsStoryLayout => EffectiveLegacyLayoutMode == WeddingLayoutMode.Story;
    private bool IsPhotoBookLayout => EffectiveLegacyLayoutMode == WeddingLayoutMode.PhotoBook;
    private bool IsCardLayout => EffectiveLegacyLayoutMode == WeddingLayoutMode.Card;
    private bool UsesInviteHeroPlacement =>
        EffectiveLegacyLayoutMode is
            WeddingLayoutMode.WebPage or
            WeddingLayoutMode.TabMenu or
            WeddingLayoutMode.Story or
            WeddingLayoutMode.Card or
            WeddingLayoutMode.PhotoBook;
    private IEnumerable<NavItem> VisibleNavItems => _navItems.Where(i =>
        (i.Key != "story"     || IsStoryLayout) &&
        (i.Key != "photobook" || IsPhotoBookLayout) &&
        (i.Key != "cards"     || IsCardLayout));
    private NavItem CurrentNavItem => VisibleNavItems.FirstOrDefault(i => i.Key == _selected) ?? _navItems[0];
    private string AdminNavLabel(string key) => key switch
    {
        "basic" => Text["admin.basic"],
        "notice" => Text["admin.notice"],
        "design" => Text["admin.design"],
        "story" => Text["admin.story"],
        "photobook" => Text["admin.photobook"],
        "cards" => Text["admin.cards"],
        "content" => Text["admin.content"],
        "map" => Text["admin.map"],
        "account" => Text["admin.payment"],
        "share" => Text["admin.sharing"],
        _ => key
    };
    private string PreviewUrl
    {
        get
        {
            var design = Vm.Config?.DesignSettings;
            if (design is null)
            {
                return $"/{Uri.EscapeDataString(Slug)}?adminPreview=true";
            }

            var key = Uri.EscapeDataString(
                WeddingLayoutKeys.Normalize(design.LayoutKey));
            var version = Uri.EscapeDataString(
                WeddingLayoutVersion.IsValid(design.LayoutVersion)
                    ? design.LayoutVersion.Trim()
                    : WeddingLayoutVersion.Initial);
            var followActive = design.FollowActiveLayoutVersion
                ? "true"
                : "false";
            var url = $"/{Uri.EscapeDataString(Slug)}"
                + $"?adminPreview=true&previewLayoutKey={key}"
                + $"&previewLayoutVersion={version}"
                + $"&previewFollowActive={followActive}";

            if (_themePreviewSelection is { } theme)
            {
                url += $"&previewTheme={Uri.EscapeDataString(theme.ThemeKey)}";
                if (theme.Palette is { } palette)
                {
                    url += PreviewThemeQuery("previewThemeBase", palette.BaseColor)
                        + PreviewThemeQuery("previewThemePrimary", palette.Primary)
                        + PreviewThemeQuery("previewThemeDark", palette.Dark)
                        + PreviewThemeQuery("previewThemeAccent", palette.Accent)
                        + PreviewThemeQuery("previewThemeText", palette.Text)
                        + PreviewThemeQuery("previewThemeMuted", palette.MutedText)
                        + PreviewThemeQuery("previewThemeBackground", palette.Background)
                        + PreviewThemeQuery("previewThemePanel", palette.PanelBackground)
                        + PreviewThemeQuery("previewThemeButton", palette.ButtonBackground)
                        + PreviewThemeQuery("previewThemeButtonText", palette.ButtonText)
                        + PreviewThemeQuery("previewThemeBorder", palette.Border);
                }
            }

            return url + $"&previewRevision={_previewRevision}";
        }
    }
    private static string PreviewThemeQuery(string name, string value) =>
        $"&{name}={Uri.EscapeDataString(value)}";
    private string PreviewTitle => Text["admin.preview.title"];
    private string LocalizedSectionLabel(string section) => section switch
    {
        "hero" => Text["home"],
        "notice" => Text["admin.notice"],
        "story" => Text["admin.story"],
        "gallery" => Text["admin.media.gallery"],
        "video" => Text["admin.media.video"],
        "map" => Text["admin.map"],
        "account" => Text["admin.payment"],
        "guestbook" => Text["features.guestbook"],
        _ => WeddingSectionOrderCatalog.GetLabel(section)
    };
    private string DisplayStatusMessage =>
        Vm.StatusMessage.Contains("슈퍼관리자 권한으로 접속", StringComparison.Ordinal)
            ? Text["admin.super.connected"]
            : Vm.StatusMessage;
    private bool EffectiveSearchIndexing => WeddingSeoService.IsIndexingEnabled(Vm.Config);
    private WeddingLayoutOption? AppliedLayoutOption =>
        Vm.Config is null
            ? null
            : Vm.FindLayoutOption(
                Vm.Config.DesignSettings.LayoutKey,
                Vm.Config.DesignSettings.FollowActiveLayoutVersion
                    ? null
                    : Vm.Config.DesignSettings.LayoutVersion);
    private WeddingLayoutOption? SelectedLayoutOption =>
        _layoutCandidate is { } candidate
            ? Vm.FindLayoutOption(candidate.LayoutKey, candidate.Version) ?? AppliedLayoutOption
            : AppliedLayoutOption ?? Vm.LayoutCatalog.Layouts.FirstOrDefault();
    private IEnumerable<WeddingLayoutOption> FilteredLayoutOptions
    {
        get
        {
            var query = _layoutSearch.Trim();
            if (string.IsNullOrWhiteSpace(query))
            {
                return Vm.LayoutCatalog.Layouts;
            }

            return Vm.LayoutCatalog.Layouts.Where(option =>
                option.Label.Contains(query, StringComparison.OrdinalIgnoreCase)
                || option.Description.Contains(query, StringComparison.OrdinalIgnoreCase)
                || option.Key.Contains(query, StringComparison.OrdinalIgnoreCase)
                || option.Version.Contains(query, StringComparison.OrdinalIgnoreCase)
                || LayoutTierLabel(option).Contains(query, StringComparison.OrdinalIgnoreCase));
        }
    }
    private PreviewDevice CurrentPreviewDevice =>
        _previewDevices.FirstOrDefault(x => string.Equals(x.Key, _previewDeviceKey, StringComparison.OrdinalIgnoreCase))
        ?? _previewDevices[0];
    private bool CurrentHeroCropUsesFullImage =>
        _heroCropViewport == "mobile" ? _heroCropMobileFull : _heroCropDesktopFull;
    private HeroImageCropRegion CurrentHeroCropDraft =>
        _heroCropViewport == "mobile" ? _heroCropMobileDraft : _heroCropDesktopDraft;
    private double CurrentHeroCropAspect =>
        _heroCropViewport == "mobile"
            ? (double)CurrentPreviewDevice.Width / CurrentPreviewDevice.Height
            : 16d / 9d;
    private string HeroCropEditorKey => $"{_heroCropViewport}:{_heroCropEditorRevision}";
    private string PreviewHeaderTitle =>
        _previewMode == "phone"
            ? $"{Text["admin.preview.phone"]} {Text["admin.preview"]} · {CurrentPreviewDevice.Label}"
            : $"PC {Text["admin.preview"]}";
    private string PreviewFrameStyle =>
        _previewMode == "phone"
            ? $"--w-preview-device-width:{CurrentPreviewDevice.Width}px;--w-preview-device-height:{CurrentPreviewDevice.Height}px;"
            : "";
    private WeddingThemePalette CurrentCustomPalette =>
        WeddingThemePaletteGenerator.ResolveForEditing(
            Vm.Config?.DesignSettings.CustomTheme);
    private double TextContrastRatio =>
        WeddingThemePaletteGenerator.ContrastRatio(
            CurrentCustomPalette.Text,
            CurrentCustomPalette.Background);
    private double MutedContrastRatio =>
        WeddingThemePaletteGenerator.ContrastRatio(
            CurrentCustomPalette.MutedText,
            CurrentCustomPalette.Background);
    private double ButtonContrastRatio =>
        WeddingThemePaletteGenerator.ContrastRatio(
            CurrentCustomPalette.ButtonText,
            CurrentCustomPalette.ButtonBackground);
    private IReadOnlyList<string> OrderedDesignSections => Vm.Config is null
        ? []
        : WeddingSectionOrderCatalog.NormalizeInvitationOrder(
            Vm.Config.DesignSettings.SectionOrder,
            AppliedLayoutOption?.SupportedSections ?? WeddingSectionOrderCatalog.InvitationRecommendedOrder);
    private string CeremonyNotePreviewHtml
    {
        get
        {
            var raw = Vm.Config?.CeremonyNote ?? "";
            if (string.IsNullOrWhiteSpace(raw)) return "";
            if (string.Equals(Vm.Config?.CeremonyNoteFormat, "Html", StringComparison.OrdinalIgnoreCase))
                return raw;
            return Markdown.ToHtml(raw, new MarkdownPipelineBuilder().UseAdvancedExtensions().Build());
        }
    }

    private void SetPreviewMode(string mode)
    {
        _previewMode = mode == "pc" ? "pc" : "phone";
    }

    private void SetPreviewDevice(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (_previewDevices.Any(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase)))
        {
            _previewDeviceKey = key!;
            _previewMode = "phone";
            if (_heroCropEditorOpen && _heroCropViewport == "mobile")
            {
                QueueHeroCropEditorInit();
            }
        }
    }

    private static string LayoutTierLabel(WeddingLayoutOption option) =>
        option.Tier == WeddingLayoutTier.Free ? "무료" : "프리미엄";

    private bool IsAppliedLayout(WeddingLayoutOption option)
    {
        var applied = AppliedLayoutOption;
        return applied is not null
            && string.Equals(applied.Key, option.Key, StringComparison.OrdinalIgnoreCase)
            && string.Equals(applied.Version, option.Version, StringComparison.Ordinal);
    }

    private IReadOnlyList<WeddingLayoutOption> GetLayoutVersionOptions(string layoutKey) =>
        Vm.LayoutCatalog.Releases
            .Where(release => string.Equals(
                release.LayoutKey,
                layoutKey,
                StringComparison.OrdinalIgnoreCase))
            .Select(release => Vm.FindLayoutOption(release.LayoutKey, release.Version))
            .Where(option => option is not null)
            .Select(option => option!)
            .OrderByDescending(
                option => option.Version,
                Comparer<string>.Create(CompareLayoutVersions))
            .ToArray();

    private void SelectLayoutVersion(string layoutKey, ChangeEventArgs args)
    {
        var version = args.Value?.ToString();
        if (!WeddingLayoutVersion.IsValid(version))
        {
            return;
        }

        var option = Vm.FindLayoutOption(layoutKey, version);
        if (option is not null)
        {
            SelectLayoutCandidate(option);
        }
    }

    private static string LayoutVersionOptionLabel(
        WeddingLayoutOption option,
        WeddingLayoutOption? applied,
        string? activeVersion)
    {
        var labels = new List<string> { $"v{option.Version}" };
        if (applied is not null
            && string.Equals(applied.Key, option.Key, StringComparison.OrdinalIgnoreCase)
            && string.Equals(applied.Version, option.Version, StringComparison.Ordinal))
        {
            labels.Add("현재 사용");
        }

        if (string.Equals(
                activeVersion,
                option.Version,
                StringComparison.Ordinal))
        {
            labels.Add("현재 활성");
        }

        return string.Join(" · ", labels);
    }

    private string LayoutApplyButtonLabel(
        WeddingLayoutOption selected,
        WeddingLayoutOption? applied)
    {
        if (IsAppliedLayout(selected))
        {
            return "현재 적용 중";
        }

        if (applied is not null
            && string.Equals(
                applied.Key,
                selected.Key,
                StringComparison.OrdinalIgnoreCase))
        {
            return CompareLayoutVersions(selected.Version, applied.Version) > 0
                ? $"v{selected.Version}로 업데이트"
                : $"v{selected.Version} 사용";
        }

        return "이 레이아웃 적용";
    }

    private static int CompareLayoutVersions(string? left, string? right)
    {
        var leftParts = ParseLayoutVersion(left);
        var rightParts = ParseLayoutVersion(right);
        var coreComparison = leftParts.Core.CompareTo(rightParts.Core);
        if (coreComparison != 0)
        {
            return coreComparison;
        }

        if (leftParts.PreRelease.Length == 0)
        {
            return rightParts.PreRelease.Length == 0 ? 0 : 1;
        }

        if (rightParts.PreRelease.Length == 0)
        {
            return -1;
        }

        return string.Compare(
            leftParts.PreRelease,
            rightParts.PreRelease,
            StringComparison.OrdinalIgnoreCase);
    }

    private static (Version Core, string PreRelease) ParseLayoutVersion(
        string? version)
    {
        var normalized = version?.Trim() ?? WeddingLayoutVersion.Initial;
        var withoutBuild = normalized.Split('+', 2)[0];
        var parts = withoutBuild.Split('-', 2);
        return (
            Version.TryParse(parts[0], out var core)
                ? core
                : new Version(0, 0, 0),
            parts.Length == 2 ? parts[1] : "");
    }

    private void ToggleLayoutPicker()
    {
        _layoutPickerOpen = !_layoutPickerOpen;
        if (_layoutPickerOpen)
        {
            _layoutSearch = "";
        }
    }

    private void OnLayoutSearchKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            _layoutPickerOpen = false;
            return;
        }

        if (string.Equals(e.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            var first = FilteredLayoutOptions.FirstOrDefault();
            if (first is not null)
            {
                SelectLayoutCandidate(first);
            }
        }
    }

    private void SelectLayoutCandidate(WeddingLayoutOption option)
    {
        if (Vm.FindLayoutOption(option.Key, option.Version) is null) return;
        _layoutCandidate = option.ReleaseId;
        _layoutPickerOpen = false;
        _layoutSearch = "";
        _layoutApplyMessage = "";
    }

    private async Task ApplySelectedLayout()
    {
        var option = SelectedLayoutOption;
        if (option is null || !option.IsImplemented || !CanUseLayout(option)) return;

        SelectLayout(option);
        await PublishPreviewAccountDraftAsync();
        _previewOpen = true;
        _previewRevision++;
        _layoutApplyMessage =
            $"{option.Label} 레이아웃을 오른쪽 미리보기에 반영했습니다. 설정 저장을 누르면 공개 청첩장에 확정됩니다.";
    }

    private static string Icon(string name) => name switch
    {
        "user" => """<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5.5 20c1.2-4 4-6 6.5-6s5.3 2 6.5 6"/></svg>""",
        "note" => """<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>""",
