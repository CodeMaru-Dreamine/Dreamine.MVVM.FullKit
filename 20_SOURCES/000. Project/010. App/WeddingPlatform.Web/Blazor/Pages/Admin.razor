                                            <span><b>@Text["admin.preview.phone"]</b> @FormatPanelPosition(Vm.Config.DesignSettings.HeroPlacement.InviteBottom, true)</span>
                                            <div>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => SetPreviewMode("phone")'>@Text["admin.hero.position.drag"]</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => AlignHeroPanel("heroBottom", true)'>@Text["common.align"]</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => ResetHeroPanel("heroBottom", true)'>@Text["common.reset"]</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>
