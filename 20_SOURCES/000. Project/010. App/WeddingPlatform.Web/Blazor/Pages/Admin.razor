    private void MoveSection(string section, int offset)
    {
        if (Vm.Config is null || section == "hero") return;
        var order = OrderedDesignSections.ToList();
        var index = order.FindIndex(x => string.Equals(x, section, StringComparison.OrdinalIgnoreCase));
        if (index < 0) return;
        var target = Math.Clamp(index + offset, 1, order.Count - 1);
        if (target == index) return;
        order.RemoveAt(index);
        order.Insert(target, section);
        Vm.Config.DesignSettings.SectionOrder = order;
    }

    private void ResetSectionOrder()
    {
        if (Vm.Config is null) return;
        var supported = AppliedLayoutOption?.SupportedSections
            ?? WeddingSectionOrderCatalog.InvitationRecommendedOrder;
        Vm.Config.DesignSettings.SectionOrder =
            WeddingSectionOrderCatalog.NormalizeInvitationOrder(WeddingSectionOrderCatalog.InvitationRecommendedOrder, supported);
    }

    /// <summary>
    /// 지정한 섹션의 노출 여부를 반환합니다. 데이터에 항목이 없으면 기본값 true(노출)로 취급하며, hero 는 언제나 노출입니다.
    /// </summary>
    private bool IsSectionVisible(string section)
    {
        if (Vm.Config is null) return true;
        if (string.Equals(section, "hero", StringComparison.OrdinalIgnoreCase)) return true;
        return !Vm.Config.DesignSettings.SectionVisibility.TryGetValue(section, out var visible) || visible;
    }

    /// <summary>
    /// 섹션 노출/숨김 상태를 토글합니다. hero 는 고정 섹션이므로 무시합니다.
    /// </summary>
    private void ToggleSectionVisibility(string section)
    {
        if (Vm.Config is null) return;
        if (string.Equals(section, "hero", StringComparison.OrdinalIgnoreCase)) return;

        var visibility = Vm.Config.DesignSettings.SectionVisibility;
        var current = !visibility.TryGetValue(section, out var visible) || visible;
        visibility[section] = !current;
    }

