                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => SetPreviewMode("phone")'>@Text["admin.hero.position.drag"]</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => AlignHeroPanel("heroTop", true)'>@Text["common.align"]</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => ResetHeroPanel("heroTop", true)'>@Text["common.reset"]</button>
                                            </div>
