    private void OpenHeroCropEditor()
    {
        if (Vm.Config is null) return;
        var presentation = Vm.Config.DesignSettings.HeroImagePresentation;
        _heroCropDesktopFull = !string.Equals(
            presentation.DesktopFit,
            HeroImagePresentationSettings.Cover,
            StringComparison.OrdinalIgnoreCase);
        _heroCropMobileFull = !string.Equals(
            presentation.MobileFit,
            HeroImagePresentationSettings.Cover,
            StringComparison.OrdinalIgnoreCase);
        _heroCropDesktopDraft = CloneCrop(presentation.DesktopCrop);
        _heroCropMobileDraft = CloneCrop(presentation.MobileCrop);
        _heroCropViewport = _previewMode == "pc" ? "desktop" : "mobile";
        _heroCropEditorOpen = true;
        QueueHeroCropEditorInit();
    }

    private void CloseHeroCropEditor()
    {
        _heroCropEditorOpen = false;
        _heroCropEditorNeedsInit = false;
    }

    private void SetHeroCropViewport(string viewport)
    {
        _heroCropViewport = viewport == "desktop" ? "desktop" : "mobile";
        _previewMode = _heroCropViewport == "desktop" ? "pc" : "phone";
        QueueHeroCropEditorInit();
    }

    private void SetHeroCropMode(bool useFullImage)
    {
        if (_heroCropViewport == "mobile") _heroCropMobileFull = useFullImage;
        else _heroCropDesktopFull = useFullImage;
        QueueHeroCropEditorInit();
    }

    private void QueueHeroCropEditorInit()
    {
        _heroCropEditorRevision++;
        _heroCropEditorNeedsInit = _heroCropEditorOpen && !CurrentHeroCropUsesFullImage;
    }

    [JSInvokable]
    public void OnHeroCropDraftChanged(
        string viewport,
        double x,
        double y,
        double width,
        double height)
    {
        var draft = new HeroImageCropRegion
        {
            X = x,
            Y = y,
            Width = width,
            Height = height,
        };
        NormalizeCropDraft(draft);
        if (string.Equals(viewport, "mobile", StringComparison.OrdinalIgnoreCase))
        {
            _heroCropMobileDraft = draft;
        }
        else
        {
            _heroCropDesktopDraft = draft;
        }
    }

    private async Task ApplyHeroCropEditor()
    {
        if (Vm.Config is null) return;
        var presentation = Vm.Config.DesignSettings.HeroImagePresentation;
        presentation.DesktopFit = _heroCropDesktopFull
            ? HeroImagePresentationSettings.Contain
            : HeroImagePresentationSettings.Cover;
        presentation.MobileFit = _heroCropMobileFull
            ? HeroImagePresentationSettings.Contain
            : HeroImagePresentationSettings.Cover;
        presentation.DesktopCrop = CloneCrop(_heroCropDesktopDraft);
        presentation.MobileCrop = CloneCrop(_heroCropMobileDraft);
        presentation.DesktopFocusX = presentation.DesktopCrop.X + presentation.DesktopCrop.Width / 2;
        presentation.DesktopFocusY = presentation.DesktopCrop.Y + presentation.DesktopCrop.Height / 2;
        presentation.MobileFocusX = presentation.MobileCrop.X + presentation.MobileCrop.Width / 2;
        presentation.MobileFocusY = presentation.MobileCrop.Y + presentation.MobileCrop.Height / 2;

        await Vm.SaveConfigAsync();
        CloseHeroCropEditor();
        await ReloadPreview();
    }

    private static HeroImageCropRegion CloneCrop(HeroImageCropRegion source) =>
        new()
        {
            X = source.X,
            Y = source.Y,
            Width = source.Width,
            Height = source.Height,
        };

    private static void NormalizeCropDraft(HeroImageCropRegion crop)
    {
        crop.X = Math.Clamp(double.IsFinite(crop.X) ? crop.X : 0, 0, 95);
        crop.Y = Math.Clamp(double.IsFinite(crop.Y) ? crop.Y : 0, 0, 95);
        crop.Width = Math.Clamp(double.IsFinite(crop.Width) ? crop.Width : 100, 5, 100 - crop.X);
        crop.Height = Math.Clamp(double.IsFinite(crop.Height) ? crop.Height : 100, 5, 100 - crop.Y);
    }

    private async Task ResetHeroPanel(string target, bool mobile)
    {
        if (Vm.Config is null) return;
        var placement = target == "heroBottom"
            ? Vm.Config.DesignSettings.HeroPlacement.InviteBottom
            : Vm.Config.DesignSettings.HeroPlacement.InviteTop;

        if (mobile)
        {
            placement.MobileX = placement.MobileY = null;
        }
        else
        {
            placement.DesktopX = placement.DesktopY = null;
        }
        await Vm.SaveConfigAsync();
        await ReloadPreview();
    }

    private async Task AlignHeroPanel(string target, bool mobile)
    {
        if (Vm.Config is null) return;
        var placement = target == "heroBottom"
            ? Vm.Config.DesignSettings.HeroPlacement.InviteBottom
            : Vm.Config.DesignSettings.HeroPlacement.InviteTop;

        SnapPanelPlacement(placement, mobile);
        await Vm.SaveConfigAsync();
        await ReloadPreview();
    }

    [JSInvokable]
    public async Task OnPreviewElementMoved(string target, double xPercent, double yPercent, string viewport)
    {
        if (Vm.Config is null) return;
        var isMobile = string.Equals(viewport, "mobile", StringComparison.OrdinalIgnoreCase);
        switch (target)
        {
            case "music":
                SetFloatingPosition(Vm.Config.DesignSettings.MusicButtonPlacement, xPercent, yPercent, isMobile);
                Vm.Config.MusicButtonPosition = "custom";
                break;
            case "heroTop":
                SetHeroPosition(Vm.Config.DesignSettings.HeroPlacement.InviteTop, xPercent, yPercent, isMobile);
                break;
            case "heroBottom":
                SetHeroPosition(Vm.Config.DesignSettings.HeroPlacement.InviteBottom, xPercent, yPercent, isMobile);
                break;
            default:
                return;
        }

        await Vm.SaveConfigAsync();
        StateHasChanged();
    }

    private static void SetFloatingPosition(WeddingFloatingPosition position, double xPercent, double yPercent, bool mobile)
    {
        if (mobile)
        {
            position.MobileX = ClampPercent(xPercent);
            position.MobileY = ClampPercent(yPercent);
        }
        else
        {
            position.DesktopX = ClampPercent(xPercent);
            position.DesktopY = ClampPercent(yPercent);
        }
    }

    private static void SetHeroPosition(HeroPanelPlacement placement, double xPercent, double yPercent, bool mobile)
    {
        if (mobile)
        {
            placement.MobileX = ClampPercent(xPercent);
            placement.MobileY = ClampPercent(yPercent);
        }
        else
        {
            placement.DesktopX = ClampPercent(xPercent);
            placement.DesktopY = ClampPercent(yPercent);
        }
    }

    private static void SnapPanelPlacement(HeroPanelPlacement placement, bool mobile)
    {
        if (mobile && placement.HasMobileCustomPosition)
        {
            placement.MobileX = SnapPercent(placement.MobileX!.Value);
            placement.MobileY = SnapPercent(placement.MobileY!.Value);
        }
        else if (!mobile && placement.HasDesktopCustomPosition)
        {
            placement.DesktopX = SnapPercent(placement.DesktopX!.Value);
            placement.DesktopY = SnapPercent(placement.DesktopY!.Value);
        }
    }

    private static double SnapPercent(double value)
    {
        var anchors = new[] { 15d, 50d, 85d };
        return anchors.OrderBy(x => Math.Abs(x - value)).First();
    }

    private static double ClampPercent(double value) => Math.Clamp(value, 0, 100);

    private static string FormatPanelPosition(HeroPanelPlacement placement, bool mobile) =>
        mobile
            ? placement.HasMobileCustomPosition
                ? $"{placement.MobileX:0.#}%, {placement.MobileY:0.#}%"
                : "기본 위치"
            : placement.HasDesktopCustomPosition
                ? $"{placement.DesktopX:0.#}%, {placement.DesktopY:0.#}%"
                : "기본 위치";

    private static string FormatFloatingPosition(WeddingFloatingPosition position)
    {
        var mobile = position.HasMobile ? $"모바일 {position.MobileX:0.#}%, {position.MobileY:0.#}%" : "모바일 기본";
        var desktop = position.HasDesktop ? $"PC {position.DesktopX:0.#}%, {position.DesktopY:0.#}%" : "PC 기본";
        return $"{desktop} · {mobile}";
    }

