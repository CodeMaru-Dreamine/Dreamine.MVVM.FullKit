@page "/{Slug}/admin"
@layout WeddingPlatform.Blazor.Layout.WeddingLayout
@namespace WeddingPlatform.Blazor.Pages
@rendermode InteractiveServer

@using Markdig
@using Wedding.Common
@using WeddingPlatform.Models
@using Microsoft.JSInterop
@inject WeddingAdminViewModel Vm
@inject IWeddingLayoutCatalogRegistry LayoutRegistry
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WeddingLocalization Text
@implements IDisposable

<PageTitle>@Text["admin"] — @Slug</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="w-admin">
    <div class="w-admin-preferences" aria-label="@Text["screen.settings"]">
        <WeddingPlatform.Blazor.Components.WeddingPreferences />
    </div>
    @if (!Vm.IsAuthenticated && !_superAdminAutoLoginChecked)
    {
        <div class="w-loading">
            <div class="w-spinner"></div>
            <p class="w-hint">@Text["admin.checking"]</p>
        </div>
    }
    else if (!Vm.IsAuthenticated)
    {
        <h1 class="w-admin__title">⚙ @Text["admin"] — <code>@Slug</code></h1>
        <div class="w-admin__login w-panel">
            <h2>@Text["admin.signin"]</h2>
            @if (Vm.IsSignedIn)
            {
                <p class="w-hint">@Text["admin.shared.current"]: <strong>@Vm.CurrentUserLabel</strong></p>
                <p class="w-hint">@Text["admin.link.account"]</p>
            }
            else
            {
                <p class="w-hint">@Text["admin.login.first"]</p>
                <a class="w-btn" href="@LoginUrl">@Text["common.login"]</a>
            }
            <input class="w-input"
                   type="password"
                   placeholder="@Text["field.password"]"
                   @bind="Vm.LoginPassword"
                   @bind:event="oninput" />
            <button class="w-btn w-btn--primary" @onclick="OnLogin">@Text["login"]</button>
            @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
            {
                <p class="w-status">@DisplayStatusMessage</p>
            }
        </div>
    }
    else if (!Vm.IsLoaded)
    {
        <div class="w-loading"><div class="w-spinner"></div></div>
    }
    else
    {
        <div class="w-admin-shell @(_previewCollapsed ? "is-preview-collapsed" : "")">

            <!-- ══════ 사이드바 ══════ -->
            <aside class="w-admin-nav @(_navOpen ? "is-open" : "")">
                <div class="w-admin-nav__head">
                    <div class="w-admin-nav__brand">
                        <span class="w-admin-nav__brand-icon">⚙</span>
                        <div>
                            <strong>@Text["admin.manage"]</strong>
                            <small><code>@Slug</code></small>
                        </div>
                    </div>
                    <button class="w-admin-nav__close" @onclick="() => _navOpen = false" aria-label="@Text["admin.close.menu"]">✕</button>
                </div>

                <nav class="w-admin-nav__list">
                    @foreach (var item in VisibleNavItems)
                    {
                        <button class="w-admin-nav__item @(_selected == item.Key ? "active" : "")"
                                @onclick="() => SelectSection(item.Key)">
                            <span class="w-admin-nav__icon">@((MarkupString)item.Icon)</span>
                            <span class="w-admin-nav__label">@AdminNavLabel(item.Key)</span>
                        </button>
                    }
                </nav>

                <div class="w-admin-nav__foot">
                    <button class="w-btn w-btn--primary w-btn--block" @onclick="OnSaveConfig">
                        @Text["admin.save"]
                    </button>
                    <button class="w-btn w-btn--block" @onclick="OnShareInvitation">
                        @Text["admin.share"]
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
                    {
                        <p class="w-status w-status--compact">@DisplayStatusMessage</p>
                    }
                    <a class="w-admin-nav__link" href="/@Slug" target="_blank">@Text["admin.open.invite"]</a>
                    <a class="w-admin-nav__link" href="/@Slug/thankyou" target="_blank">@Text["admin.open.thankyou"]</a>
                </div>
            </aside>

            <!-- ══════ 콘텐츠 ══════ -->
            <main class="w-admin-content">

                <div class="w-admin-content__topbar">
                    <button class="w-admin-nav__toggle" @onclick="() => _navOpen = !_navOpen" aria-label="@Text["admin.open.menu"]">☰</button>
                    <h2 class="w-admin-content__title">
                        <span class="w-admin-title__icon">@((MarkupString)CurrentNavItem.Icon)</span>
                        <span class="w-admin-title__text">@AdminNavLabel(CurrentNavItem.Key)</span>
                    </h2>
                    <button class="w-admin-preview__toggle" @onclick="OnPreviewToggle" aria-label="@Text["admin.open.preview"]"
                            title="@(_previewCollapsed ? Text["admin.expand.preview"] : Text["admin.preview"])">
                        <span class="w-admin-preview__toggle-icon">📱</span>
                        <span class="w-admin-preview__toggle-text">@(_previewCollapsed ? Text["admin.expand.preview"] : Text["admin.preview"])</span>
                    </button>
                </div>

                <div class="w-admin-content__body">

                    @if (Vm.IsSignedIn)
                    {
                        <p class="w-status w-status--compact">@Text["common.login"]: @Vm.CurrentUserLabel · @(Vm.IsOwner ? Text["admin.owner"] : Text["admin.manager"])</p>
                    }
                    @if (Vm.IsSuperAdminSession)
                    {
                        <p class="w-status w-status--compact">
                            @Text["admin.super.session"] <code>@Slug</code>
                        </p>
                    }

                    @* ─────────── 기본 정보 ─────────── *@
                    @if (_selected == "basic")
                    {
                        <section class="w-admin__section">
                            <label class="w-label">@Text["admin.basic.hero"]</label>
                            <input class="w-input" @bind="Vm.Config!.HeroTitle" placeholder="Save The Date" />

                            <label class="w-label">@Text["field.couple"]</label>
                            <input class="w-input" @bind="Vm.Config!.CoupleName" />

                            <label class="w-label">@Text["field.date"]</label>
                            <input class="w-input" type="date" @bind="Vm.Config.WeddingDate" />

                            <label class="w-label">@Text["admin.basic.time"]</label>
                            <input class="w-input" @bind="Vm.Config.WeddingTime" placeholder="@Text["admin.basic.time.placeholder"]" />

                            <label class="w-label">@Text["admin.basic.venue"]</label>
                            <input class="w-input" @bind="Vm.Config.VenueName" />

                            <label class="w-label">@Text["admin.basic.address"]</label>
                            <input class="w-input" @bind="Vm.Config.VenueAddress" />

                            <label class="w-label">@Text["admin.basic.story.ko"]</label>
                            <textarea class="w-input w-textarea" rows="4" @bind="Vm.Config.Story"></textarea>

                            <label class="w-label">@Text["admin.basic.story.other"]</label>
                            <textarea class="w-input w-textarea" rows="4" @bind="Vm.Config.Story2"></textarea>
                        </section>
                    }

                    @* ─────────── 예식 안내 ─────────── *@
                    else if (_selected == "notice")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.notice"]</h3>
                            <p class="w-hint">@Text["admin.notice.desc"]</p>
                            <p class="w-hint">@Text["admin.notice.ai"]</p>

                            <div class="w-note-examples" aria-label="@Text["admin.notice.examples"]">
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("warm")'>@Text["admin.notice.warm"]</button>
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("formal")'>@Text["admin.notice.formal"]</button>
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("simple")'>@Text["admin.notice.simple"]</button>
                                <button class="w-btn w-btn--sm" type="button" @onclick='() => ApplyCeremonyNoteExample("ai")'>@Text["admin.notice.ai.example"]</button>
                            </div>

                            <div class="w-note-toolbar">
                                <button class="@(Vm.Config!.CeremonyNoteFormat == "Markdown" ? "active" : "")"
                                        @onclick='() => Vm.Config!.CeremonyNoteFormat = "Markdown"'>@Text["admin.notice.markdown"]</button>
                                <button class="@(Vm.Config!.CeremonyNoteFormat == "Html" ? "active" : "")"
                                        @onclick='() => Vm.Config!.CeremonyNoteFormat = "Html"'>HTML</button>
                            </div>
                            <div class="w-note-editor-grid">
                                <div class="w-note-editor">
                                    @if (Vm.Config.CeremonyNoteFormat == "Markdown")
                                    {
                                        <textarea class="w-input w-textarea w-textarea--code w-textarea--notice" rows="18"
                                                  @bind="Vm.Config.CeremonyNote" @bind:event="oninput"
                                                  placeholder="@Text["admin.notice.markdown.placeholder"]"></textarea>
                                        <p class="w-hint">@Text["admin.notice.markdown.hint"]</p>
                                    }
                                    else
                                    {
                                        <textarea class="w-input w-textarea w-textarea--code w-textarea--notice" rows="18"
                                                  @bind="Vm.Config.CeremonyNote" @bind:event="oninput"
                                                  placeholder="@Text["admin.notice.html.placeholder"]"></textarea>
                                        <p class="w-hint">@Text["admin.notice.html.hint"]</p>
                                    }
                                </div>
                                <div class="w-note-preview">
                                    <div class="w-note-preview__head">@Text["admin.notice.html.preview"]</div>
                                    <div class="w-note-preview__body">
                                        @if (string.IsNullOrWhiteSpace(Vm.Config.CeremonyNote))
                                        {
                                            <p class="w-note-preview__empty">@Text["admin.notice.preview.empty"]</p>
                                        }
                                        else
                                        {
                                            @((MarkupString)CeremonyNotePreviewHtml)
                                        }
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    @* ─────────── 디자인 ─────────── *@
                    else if (_selected == "design")
                    {
                        var selectedLayout = SelectedLayoutOption;
                        var matchingLayouts = FilteredLayoutOptions.ToArray();

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.design.layout"]</h3>
                            <p class="w-hint">@Text["admin.design.layout.hint"]</p>

                            <div class="w-layout-picker">
                                <div class="w-layout-combobox">
                                    <button type="button"
                                            class="w-layout-combobox__trigger"
                                            aria-haspopup="listbox"
                                            aria-expanded="@(_layoutPickerOpen ? "true" : "false")"
                                            aria-controls="w-layout-options"
                                            @onclick="ToggleLayoutPicker">
                                        <span class="w-layout-combobox__value">
                                            <small>@Text["admin.design.select"]</small>
                                            <strong>@(selectedLayout is null ? Text["admin.design.none"] : LocalizedLayoutLabel(selectedLayout))</strong>
                                        </span>
                                        <span class="w-layout-combobox__chevron" aria-hidden="true">@(_layoutPickerOpen ? "▴" : "▾")</span>
                                    </button>

                                    @if (_layoutPickerOpen)
                                    {
                                        <div class="w-layout-combobox__popover">
                                            <label class="w-layout-combobox__search-label" for="w-layout-search">@Text["admin.design.search"]</label>
                                            <input id="w-layout-search"
                                                   class="w-input w-layout-combobox__search"
                                                   type="search"
                                                   autocomplete="off"
                                                   placeholder="@Text["admin.design.search.placeholder"]"
                                                   @bind="_layoutSearch"
                                                   @bind:event="oninput"
                                                   @onkeydown="OnLayoutSearchKeyDown" />

                                            <div id="w-layout-options" class="w-layout-options" role="listbox" aria-label="@Text["admin.design.search.results"]">
                                                @if (matchingLayouts.Length == 0)
                                                {
                                                    <p class="w-layout-options__empty">@Text["admin.design.noresults"]</p>
                                                }
                                                else
                                                {
                                                    @foreach (var descriptor in matchingLayouts)
                                                    {
                                                        var canUse = CanUseLayout(descriptor);
                                                        var canApply = canUse && descriptor.IsImplemented;
                                                        var isCandidate = selectedLayout is not null
                                                            && string.Equals(selectedLayout.Key, descriptor.Key, StringComparison.OrdinalIgnoreCase)
                                                            && string.Equals(selectedLayout.Version, descriptor.Version, StringComparison.Ordinal);
                                                        var isApplied = IsAppliedLayout(descriptor);

                                                        <button type="button"
                                                                id="w-layout-option-@descriptor.Key"
                                                                class="w-layout-option @(isCandidate ? "is-selected" : "") @(!canApply ? "is-locked" : "")"
                                                                role="option"
                                                                aria-selected="@(isCandidate ? "true" : "false")"
                                                                @onclick="() => SelectLayoutCandidate(descriptor)">
                                                            <span class="w-style-card__preview w-style-card__preview--@descriptor.Key" aria-hidden="true"></span>
                                                            <span class="w-layout-option__meta">
                                                                <strong>@LocalizedLayoutLabel(descriptor)</strong>
                                                                <small>@LocalizedLayoutDescription(descriptor)</small>
                                                            </span>
                                                            <span class="w-layout-option__badges">
                                                                @if (isApplied)
                                                                {
                                                                    <span class="w-layout-badge w-layout-badge--active">@Text["admin.design.applied"]</span>
                                                                }
                                                                @if (!descriptor.IsImplemented)
                                                                {
                                                                    <span class="w-layout-badge">@Text["admin.design.preparing"]</span>
                                                                }
                                                                else if (!canUse)
                                                                {
                                                                    <span class="w-layout-badge">@Text["admin.design.locked"]</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="w-layout-badge">@LayoutTierLabel(descriptor)</span>
                                                                }
                                                            </span>
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (selectedLayout is not null)
                                {
                                    var canUseSelectedLayout = CanUseLayout(selectedLayout);
                                    var canApplySelectedLayout = canUseSelectedLayout && selectedLayout.IsImplemented;
                                    var isSelectedLayoutApplied = IsAppliedLayout(selectedLayout);
                                    var availableVersions = GetLayoutVersionOptions(selectedLayout.Key);
                                    var appliedLayout = AppliedLayoutOption;
                                    var activeVersion = Vm.LayoutCatalog
                                        .FindDescriptor(selectedLayout.Key)
                                        ?.CurrentVersion;

                                    <article class="w-layout-detail" aria-live="polite">
                                        <div class="w-layout-detail__visual w-style-card__preview w-style-card__preview--@selectedLayout.Key"
                                             role="img"
                                             aria-label="@LocalizedLayoutLabel(selectedLayout)"></div>

                                        <div class="w-layout-detail__content">
                                            <div class="w-layout-detail__badges">
                                                <span class="w-layout-badge">@LayoutTierLabel(selectedLayout)</span>
                                                <span class="w-layout-badge">@(Vm.IsBuiltInLayout(selectedLayout.Key) ? Text["admin.design.builtin"] : Text["admin.design.approved"])</span>
                                                <span class="w-layout-badge">v@(selectedLayout.Version)</span>
                                                @if (isSelectedLayoutApplied)
                                                {
                                                    <span class="w-layout-badge w-layout-badge--active">@Text["admin.design.current"]</span>
                                                }
                                            </div>
                                            <h4>@LocalizedLayoutLabel(selectedLayout)</h4>
                                            <p>@LocalizedLayoutDescription(selectedLayout)</p>

                                            <dl class="w-layout-detail__facts">
                                                <div>
                                                    <dt>@Text["admin.design.screen.mode"]</dt>
                                                    <dd>@(selectedLayout.UsesBottomNavigation ? Text["admin.design.bottom.nav"] : Text["admin.design.vertical.scroll"])</dd>
                                                </div>
                                                <div>
                                                    <dt>@Text["admin.design.supported.sections"]</dt>
                                                    <dd>@string.Format(Text["admin.super.layout.count"], selectedLayout.SupportedSections.Count)</dd>
                                                </div>
                                            </dl>

                                            @if (availableVersions.Count > 1)
                                            {
                                                <label class="w-label">
                                                    @Text["admin.design.use.version"]
                                                    <select class="w-input"
                                                            value="@selectedLayout.Version"
                                                            @onchange="e => SelectLayoutVersion(selectedLayout.Key, e)">
                                                        @foreach (var versionOption in availableVersions)
                                                        {
                                                            <option value="@versionOption.Version">
                                                                @LayoutVersionOptionLabel(
                                                                    versionOption,
                                                                    appliedLayout,
                                                                    activeVersion)
                                                            </option>
                                                        }
                                                    </select>
                                                </label>

                                                @if (appliedLayout is not null
                                                    && string.Equals(
                                                        appliedLayout.Key,
                                                        selectedLayout.Key,
                                                        StringComparison.OrdinalIgnoreCase)
                                                    && !string.Equals(
                                                        appliedLayout.Version,
                                                        activeVersion,
                                                        StringComparison.Ordinal))
                                                {
                                                    <p class="w-layout-detail__notice">
                                                        @string.Format(Text["admin.design.version.notice"], appliedLayout.Version, activeVersion)
                                                    </p>
                                                }
                                            }

                                            @if (isSelectedLayoutApplied)
                                            {
                                                <label class="w-layout-version-policy">
                                                    <input type="checkbox"
                                                           @bind="Vm.Config!.DesignSettings.FollowActiveLayoutVersion" />
                                                    <span>
                                                        <strong>@Text["admin.design.follow.active"]</strong>
                                                        <small>
                                                            @string.Format(Text["admin.design.follow.active.hint"], selectedLayout.Version)
                                                        </small>
                                                    </span>
                                                </label>
                                            }
                                            else
                                            {
                                                <p class="w-layout-detail__notice">
                                                    @string.Format(Text["admin.design.apply.pin.hint"], selectedLayout.Version)
                                                </p>
                                            }

                                            @if (!selectedLayout.IsImplemented)
                                            {
                                                <p class="w-layout-detail__notice">@Text["admin.design.renderer.missing"]</p>
                                            }
                                            else if (!canUseSelectedLayout)
                                            {
                                                <p class="w-layout-detail__notice">@Text["admin.design.premium.required"]</p>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(_layoutApplyMessage))
                                            {
                                                <p class="w-layout-detail__success">@_layoutApplyMessage</p>
                                            }

                                            <div class="w-layout-detail__actions">
                                                <button type="button"
                                                        class="w-btn w-btn--primary"
                                                        disabled="@(!canApplySelectedLayout || isSelectedLayoutApplied)"
                                                        @onclick="ApplySelectedLayout">
                                                    @LayoutApplyButtonLabel(selectedLayout, appliedLayout)
                                                </button>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        </section>

                        <section class="w-admin__section">
                            <div class="w-admin-section-title-row">
                                <div>
                                    <h3 class="w-admin__section-h">@Text["admin.design.sections"]</h3>
                                    <p class="w-hint">@Text["admin.design.sections.hint"]</p>
                                </div>
                                <button type="button" class="w-btn w-btn--sm" @onclick="ResetSectionOrder">@Text["admin.design.recommended"]</button>
                            </div>
                            <div class="w-section-order-list">
                                @foreach (var section in OrderedDesignSections)
                                {
                                    var isSectionVisible = IsSectionVisible(section);
                                    <div class="w-section-order-item @(section == "hero" ? "is-fixed" : "") @(!isSectionVisible ? "is-hidden" : "")">
                                        <span class="w-section-order-item__icon">@WeddingSectionOrderCatalog.GetIcon(section)</span>
                                        <span class="w-section-order-item__label">@LocalizedSectionLabel(section)</span>
                                        <div class="w-section-order-item__actions">
                                            @if (section == "hero")
                                            {
                                                <span class="w-hint">@Text["admin.design.fixed"]</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="w-btn w-btn--sm" @onclick="() => MoveSection(section, -1)">@Text["admin.design.up"]</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick="() => MoveSection(section, 1)">@Text["admin.design.down"]</button>
                                                <button type="button"
                                                        class="w-btn w-btn--sm @(isSectionVisible ? "" : "w-btn--muted")"
                                                        title="@(isSectionVisible ? Text["admin.design.section.hide.title"] : Text["admin.design.section.show.title"])"
                                                        @onclick="() => ToggleSectionVisibility(section)">
                                                    @(isSectionVisible ? Text["admin.design.hide"] : Text["admin.design.show"])
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🎨 @Text["admin.design.colors"]</h3>
                            <div class="w-theme-picker">
                                @foreach (var t in InvitationDesignCatalog.Themes)
                                {
                                    var canUse = CanUseTheme(t);
                                    var canSelect = canUse && t.IsImplemented;
                                    <button class="w-theme-btn @(Vm.Config!.DesignSettings.ThemeKey == t.Key ? "active" : "") @(!canSelect ? "is-locked" : "")"
                                            style="--tc:@t.Primary;--tca:@t.Accent"
                                            disabled="@(!canSelect)"
                                            @onclick="() => SelectTheme(t.Key)">
                                        <span class="w-theme-swatch"></span>
                                        <span>
                                            @Text[$"theme.{t.Key}"]
                                            @if (!t.IsImplemented)
                                            {
                                                <small class="w-layout-lock">@Text["admin.design.preparing"]</small>
                                            }
                                            else if (!canUse)
                                            {
                                                <small class="w-layout-lock">@Text["admin.design.locked"]</small>
                                            }
                                        </span>
                                    </button>
                                }
                            </div>

                            <div class="w-custom-theme @(Vm.Config!.DesignSettings.ThemeKey == WeddingThemeCatalog.CustomThemeKey ? "is-active" : "")">
                                <div class="w-custom-theme__head">
                                    <div>
                                        <strong>@Text["admin.design.custom.theme"]</strong>
                                        <p class="w-hint">@Text["admin.design.custom.theme.hint"]</p>
                                    </div>
                                    <span class="w-layout-badge">Premium</span>
                                </div>

                                @if (Vm.Config.HasPremiumPlan)
                                {
                                    var customPalette = CurrentCustomPalette;

                                    <label class="w-label">@Text["admin.design.theme.name"]</label>
                                    <input class="w-input"
                                           maxlength="40"
                                           @bind="Vm.Config.DesignSettings.CustomTheme.Name" />

                                    <div class="w-custom-theme__generator">
                                        <div class="w-custom-theme__generator-copy">
                                            <strong>@Text["admin.design.auto.palette"]</strong>
                                            <p class="w-hint">@Text["admin.design.auto.palette.hint"]</p>
                                        </div>
                                        <label class="w-custom-theme__base">
                                            <span>@Text["admin.design.primary.color"]</span>
                                            <input type="color"
                                                   value="@customPalette.BaseColor"
                                                   @oninput="OnThemeBaseColorChanged" />
                                            <code>@customPalette.BaseColor</code>
                                        </label>
                                        <button type="button"
                                                class="w-btn w-btn--sm"
                                                @onclick="ApplyAutomaticThemePalette">
                                            @Text["admin.design.palette.rebuild"]
                                        </button>
                                    </div>

                                    <div class="w-custom-theme__palette"
                                         aria-label="@Text["admin.design.palette.aria"]">
                                        <span style="--w-custom-swatch:@customPalette.Primary" title="@Text["admin.design.color.primary"]"></span>
                                        <span style="--w-custom-swatch:@customPalette.Accent" title="@Text["admin.design.color.accent"]"></span>
                                        <span style="--w-custom-swatch:@customPalette.Background" title="@Text["admin.design.color.background"]"></span>
                                        <span style="--w-custom-swatch:@customPalette.PanelBackground" title="@Text["admin.design.color.surface"]"></span>
                                        <span style="--w-custom-swatch:@customPalette.Text" title="@Text["admin.design.color.text"]"></span>
                                        <span style="--w-custom-swatch:@customPalette.MutedText" title="@Text["admin.design.color.muted"]"></span>
                                    </div>

                                    <div class="w-custom-theme__contrast" aria-live="polite">
                                        <span class="@(TextContrastRatio >= 4.5 ? "is-good" : "is-warning")">
                                            @Text["admin.design.contrast.text"] @TextContrastRatio.ToString("0.0"):1
                                        </span>
                                        <span class="@(MutedContrastRatio >= 4.5 ? "is-good" : "is-warning")">
                                            @Text["admin.design.contrast.muted"] @MutedContrastRatio.ToString("0.0"):1
                                        </span>
                                        <span class="@(ButtonContrastRatio >= 4.5 ? "is-good" : "is-warning")">
                                            @Text["admin.design.contrast.button"] @ButtonContrastRatio.ToString("0.0"):1
                                        </span>
                                    </div>

