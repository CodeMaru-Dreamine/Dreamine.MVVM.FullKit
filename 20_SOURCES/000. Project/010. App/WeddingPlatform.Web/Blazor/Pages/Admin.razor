    private async Task PublishPreviewAccountDraftAsync()
    {
        if (!_adminInteropInitialized || Vm.Config is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "weddingInterop.updateAdminPreviewAccountDraft",
                Vm.Config.Accounts);
        }
        catch
        {
            // 프리뷰 iframe이 아직 연결되기 전이면 ready 핸드셰이크에서 다시 전송됩니다.
        }
    }

