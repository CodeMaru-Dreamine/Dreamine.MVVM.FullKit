                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => SetPreviewMode("pc")'>@Text["admin.hero.position.drag"]</button>
                                                <button type="button" class="w-btn w-btn--sm" @onclick='() => AlignHeroPanel("heroBottom", false)'>@Text["common.align"]</button>
