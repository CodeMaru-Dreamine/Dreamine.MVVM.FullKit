                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🎬 @Text["admin.media.video"]</h3>
                            <p class="w-hint">@Text["admin.media.video.hint"] @LocalizedVideoSizeLabel</p>

                            @if (Vm.Config!.VideoFileNames.Count > 0)
                            {
                                <div class="w-admin__video-list">
                                    @foreach (var fn in Vm.Config.VideoFileNames.ToList())
                                    {
                                        <div class="w-admin__video-item">
                                            <video src="@Vm.GetVideoUrl(Slug, fn)"
                                                   controls preload="metadata" class="w-admin__video-player"></video>
                                            <div class="w-admin__video-meta">
                                                <span class="w-hint">@fn</span>
                                                <button class="w-btn w-btn--danger w-btn--sm"
                                                        @onclick="() => OnDeleteVideo(fn)">@Text["common.delete"]</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (Vm.MaxVideoCount <= 0 || Vm.Config.VideoFileNames.Count < Vm.MaxVideoCount)
                            {
                                <LocalizedInputFile Class="w-file-input" OnChange="OnVideoUpload" Accept="video/*" />
                                @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }
                            }
                            else
                            {
                                <p class="w-hint w-hint--attention">@Text["admin.media.video.limit"]</p>
                            }
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🖼 @Text["admin.media.gallery"] (@Vm.Gallery.Count)</h3>

                            <label class="w-label">@Text["admin.media.interval"] — <strong>@Vm.Config!.GalleryAutoPlaySeconds @Text["common.seconds"]</strong></label>
                            <input type="range" class="w-range" min="1" max="10" step="1"
                                   @bind="Vm.Config!.GalleryAutoPlaySeconds" @bind:event="oninput" />
                            <p class="w-hint">@Text["admin.media.interval.hint"]</p>

                            <LocalizedInputFile Class="w-file-input" OnChange="OnGalleryUpload" Accept="image/*" Multiple="true" />
                            @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }

                            <div class="w-admin__gallery">
                                @foreach (var p in Vm.Gallery)
                                {
                                    <div class="w-admin__gallery-item">
                                        <img src="@Vm.GetThumbUrl(Slug, p.FileName)" alt="@p.FileName" />
                                        <div class="w-admin__photo-order">
                                            <button type="button" class="w-btn w-btn--sm" title="@Text["common.first"]" @onclick="() => OnMovePhotoTo(p.FileName, true)">@Text["common.first"]</button>
                                            <button type="button" class="w-btn w-btn--sm" title="@Text["common.forward"]" aria-label="@Text["common.forward"]" @onclick="() => OnMovePhoto(p.FileName, -1)">↑</button>
                                            <button type="button" class="w-btn w-btn--sm" title="@Text["common.backward"]" aria-label="@Text["common.backward"]" @onclick="() => OnMovePhoto(p.FileName, 1)">↓</button>
                                            <button type="button" class="w-btn w-btn--sm" title="@Text["common.last"]" @onclick="() => OnMovePhotoTo(p.FileName, false)">@Text["common.last"]</button>
                                        </div>
                                        <button class="w-btn w-btn--danger w-btn--sm"
                                                @onclick="() => OnDeletePhoto(p.FileName)">@Text["common.delete"]</button>
                                        <span class="w-admin__fname">@p.FileName</span>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @* ─────────── 지도 ─────────── *@
                    else if (_selected == "map")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.map.coordinates"]</h3>
                            <div class="w-maplink-header">
                                <span class="w-label" style="margin:0">@Text["admin.map.latlng"]</span>
                                <button class="w-btn w-btn--sm" type="button" @onclick="OnGeocode"
                                        disabled="@Vm.IsGeocoding"
                                        title="@Text["admin.map.search.hint"]">
                                    @(Vm.IsGeocoding ? Text["admin.map.searching"] : $"📍 {Text["admin.map.search"]}")
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Vm.GeocodeStatus))
                            {
                                <p class="w-hint" style="color:@(Vm.GeocodeStatus.StartsWith("✅") ? "green" : "#e53e3e")">
                                    @Vm.GeocodeStatus
                                </p>
                            }
                            <div class="w-coord-row">
                                <div>
                                    <label class="w-label">@Text["admin.map.latitude"]</label>
                                    <input class="w-input" type="number" step="0.000001" @bind="Vm.Config!.VenueLat" placeholder="@Text["admin.map.input.placeholder"]" />
                                </div>
                                <div>
                                    <label class="w-label">@Text["admin.map.longitude"]</label>
                                    <input class="w-input" type="number" step="0.000001" @bind="Vm.Config.VenueLng" placeholder="@Text["admin.map.input.placeholder"]" />
                                </div>
                            </div>
                            <p class="w-hint">@Text["admin.map.coordinates.hint"]</p>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🗺 @Text["admin.map.links"]</h3>
                            <div class="w-maplink-header">
                                <span class="w-label" style="margin:0">@Text["admin.map.apps"]</span>
                                <button class="w-btn w-btn--sm" type="button" @onclick="OnAutoGenerateMapLinks"
                                        title="@Text["admin.map.generate.hint"]">
                                    ✨ @Text["admin.map.generate"]
                                </button>
                            </div>
                            <p class="w-hint">@Text["admin.map.generate.hint"]</p>
                            @if (Vm.Config!.MapLinkKakao != "" || Vm.Config.MapLinkNaver != "" || Vm.Config.MapLinkAtlan != "" || Vm.Config.MapLinkTmap != "")
                            {
                                <p class="w-hint w-hint--success">✅ @Text["admin.map.generate.done"]</p>
                            }
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.map.roadmap"]</h3>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config!.RoadMapFileName))
                            {
                                <div class="w-admin__hero-preview">
                                    <img src="@Vm.GetRoadMapUrl(Slug, Vm.Config.RoadMapFileName)" alt="@Text["admin.map.roadmap"]" />
                                    <span>@Vm.Config.RoadMapFileName</span>
                                </div>
                            }
                            else
                            {
                                <p class="w-hint">@Text["admin.map.roadmap.empty"]</p>
                            }
                            <LocalizedInputFile Class="w-file-input" OnChange="OnRoadMapUpload" Accept="image/*" />
                            @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }
                        </section>
                    }

                    @* ─────────── 계좌 안내 ─────────── *@
                    else if (_selected == "account")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">💌 @Text["admin.payment.title"]</h3>
                            <p class="w-hint">@Text["admin.payment.hint"]</p>

                            @for (int i = 0; i < Vm.Config!.Accounts.Count; i++)
                            {
                                var idx = i;
                                var acc = Vm.Config.Accounts[idx];
                                <div class="w-acc-editor">
                                    <div class="w-acc-editor__header">
                                        <strong>@string.Format(Text["admin.payment.item"], idx + 1) — @(string.IsNullOrWhiteSpace(acc.Label) ? Text["admin.payment.label.empty"] : acc.Label)</strong>
                                        <button class="w-btn w-btn--danger w-btn--sm" @onclick="() => RemoveAccount(idx)">✕ @Text["common.delete"]</button>
                                    </div>
                                    <div class="w-acc-editor__grid">
                                        <div>
                                            <label class="w-label">@Text["admin.payment.label"]</label>
                                            <select class="w-input" value="@acc.Label" @onchange="e => OnAccountLabelChanged(acc, e)">
                                                <option value="신랑">@Text["admin.payment.groom"]</option>
                                                <option value="신부">@Text["admin.payment.bride"]</option>
                                                <option value="신랑 아버지">@Text["admin.payment.groom.father"]</option>
                                                <option value="신랑 어머니">@Text["admin.payment.groom.mother"]</option>
                                                <option value="신부 아버지">@Text["admin.payment.bride.father"]</option>
                                                <option value="신부 어머니">@Text["admin.payment.bride.mother"]</option>
                                                <option value="직접 입력">@Text["admin.payment.custom"]</option>
                                            </select>
                                            @if (acc.Label == "직접 입력" || !_defaultLabels.Contains(acc.Label))
                                            {
                                                <input class="w-input" style="margin-top:.4rem" @bind="acc.Label" @bind:after="PublishPreviewAccountDraftAsync" placeholder="@Text["admin.payment.label.placeholder"]" />
                                            }
                                        </div>
                                        <div>
                                            <label class="w-label">@Text["admin.payment.name"]</label>
                                            <input class="w-input" @bind="acc.Name" @bind:after="PublishPreviewAccountDraftAsync" placeholder="@Text["admin.payment.name.placeholder"]" />
                                        </div>
                                        <div>
                                            <label class="w-label">@Text["admin.payment.contact"]</label>
                                            <input class="w-input" @bind="acc.Phone" @bind:after="PublishPreviewAccountDraftAsync" placeholder="010-0000-0000" />
                                        </div>
                                        <div>
                                            <label class="w-label">@Text["admin.payment.bank"]</label>
                                            <input class="w-input" @bind="acc.BankName" @bind:after="PublishPreviewAccountDraftAsync" placeholder="@Text["admin.payment.bank.placeholder"]" />
                                        </div>
                                        <div>
                                            <label class="w-label">@Text["admin.payment.number"]</label>
                                            <input class="w-input" @bind="acc.Account" @bind:after="PublishPreviewAccountDraftAsync" placeholder="000-000-000000" />
                                        </div>
                                        <div>
                                            <label class="w-label">@Text["admin.payment.holder"]</label>
                                            <input class="w-input" @bind="acc.AccountHolder" @bind:after="PublishPreviewAccountDraftAsync" placeholder="@Text["admin.payment.holder.placeholder"]" />
                                        </div>
                                        <div class="w-acc-editor__full">
                                            <label class="w-label">@Text["admin.payment.kakaopay"]</label>
                                            <input class="w-input" @bind="acc.KakaoPayUrl" @bind:after="PublishPreviewAccountDraftAsync" placeholder="https://qr.kakaopay.com/..." />
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Vm.Config.Accounts.Count < 8)
                            {
                                <button class="w-btn" @onclick="AddAccount">+ @Text["admin.payment.add"]</button>
                            }
                        </section>
                    }

                    @* ─────────── 공유 설정 ─────────── *@
                    else if (_selected == "share")
                    {
                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">@Text["admin.share.mode"]</h3>
                            <select class="w-input" @bind="Vm.Config!.Mode">
                                <option value="@WeddingSiteMode.Invite">@Text["admin.share.invite"]</option>
                                <option value="@WeddingSiteMode.ThankYou">@Text["admin.share.thankyou"]</option>
                                <option value="@WeddingSiteMode.Both">@Text["admin.share.both"]</option>
                            </select>
                            <p class="w-hint">@Text["admin.share.mode.hint"]</p>

                            <label class="w-label">@Text["admin.share.thankyou.url"]</label>
                            <input class="w-input" @bind="Vm.Config.ThankYouUrl" placeholder="https://thankyou.example.com" />

                            <label class="w-label">@Text["admin.share.home"]</label>
                            <label class="w-toggle">
                                <input type="checkbox" @bind="Vm.Config.ShowOnHome" />
                                <span class="w-toggle__track"></span>
                                <span class="w-toggle__label">@(Vm.Config.ShowOnHome ? Text["admin.share.home.on"] : Text["admin.share.home.off"])</span>
                            </label>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🔎 @Text["admin.share.seo"]</h3>
                            <p class="w-hint">@Text["admin.share.seo.hint"]</p>

                            <label class="w-label">@Text["admin.share.seo"]</label>
                            <label class="w-toggle">
                                <input type="checkbox"
                                       checked="@EffectiveSearchIndexing"
                                       @onchange="OnSearchIndexingChanged" />
                                <span class="w-toggle__track"></span>
                                <span class="w-toggle__label">
                                    @(EffectiveSearchIndexing ? Text["admin.share.seo.on"] : Text["admin.share.seo.off"])
                                </span>
                            </label>

                            @if (!Vm.Config!.IsPublished)
                            {
                                <p class="w-status w-status--compact">
                                    @Text["admin.share.seo.private"]
                                </p>
                            }

                            <label class="w-label">@Text["admin.share.search.title"]</label>
                            <input class="w-input"
                                   maxlength="70"
                                   @bind="Vm.Config.SearchTitle"
                                   placeholder="@WeddingSeoService.ResolveSearchTitle(Vm.Config)" />
                            <p class="w-hint">@Text["admin.share.search.auto"]</p>

                            <label class="w-label">@Text["admin.share.search.description"]</label>
                            <textarea class="w-input w-textarea"
                                      rows="3"
                                      maxlength="180"
                                      @bind="Vm.Config.SearchDescription"
                                      placeholder="@WeddingSeoService.ResolveSearchDescription(Vm.Config)"></textarea>
                            <p class="w-hint">@Text["admin.share.search.note"]</p>
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🔗 @Text["admin.share.og"]</h3>
                            <p class="w-hint">@Text["admin.share.og.hint"]</p>

                            <label class="w-label">@Text["admin.share.og.title"]</label>
                            <input class="w-input" @bind="Vm.Config!.OgTitle"
                                   placeholder="@string.Format(Text["admin.share.og.invite.title.placeholder"], Vm.Config?.CoupleName)" />

                            <label class="w-label">@Text["admin.share.og.description"]</label>
                            <textarea class="w-input w-textarea" rows="3" @bind="Vm.Config!.OgDescription"
                                      placeholder="@string.Format(Text["admin.share.og.invite.description.placeholder"], Vm.Config?.CoupleName, Vm.Config?.VenueName)"></textarea>

                            <label class="w-label">@Text["admin.share.og.image"]</label>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config!.OgImageFileName))
                            {
                                <div class="w-admin__hero-preview">
                                    <img src="@Vm.GetOgImageUrl(Slug, Vm.Config.OgImageFileName)" alt="@Text["admin.share.og.image.alt"]" />
                                    <span>@Vm.Config.OgImageFileName</span>
                                    <button class="w-btn w-btn--sm" @onclick="() => { Vm.Config!.OgImageFileName = string.Empty; }">✕ @Text["common.remove"]</button>
                                </div>
                            }
                            <LocalizedInputFile Class="w-file-input" OnChange="OnOgImageUpload" Accept="image/*" />
                            <p class="w-hint">@Text["admin.share.og.size.hint"]</p>
                            @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">💌 @Text["admin.share.og.thankyou"]</h3>
                            <p class="w-hint">@string.Format(Text["admin.share.og.thankyou.hint"], Slug)</p>

                            <label class="w-label">@Text["admin.share.og.title"]</label>
                            <input class="w-input" @bind="Vm.Config!.ThankYouOgTitle"
                                   placeholder="@string.Format(Text["admin.share.og.thankyou.title.placeholder"], Vm.Config?.CoupleName)" />

                            <label class="w-label">@Text["admin.share.og.description"]</label>
                            <textarea class="w-input w-textarea" rows="3" @bind="Vm.Config!.ThankYouOgDescription"
                                      placeholder="@string.Format(Text["admin.share.og.thankyou.description.placeholder"], Vm.Config?.CoupleName, Vm.Config?.VenueName)"></textarea>

                            <label class="w-label">@Text["admin.share.og.image"]</label>
                            @if (!string.IsNullOrWhiteSpace(Vm.Config!.ThankYouOgImageFileName))
                            {
                                <div class="w-admin__hero-preview">
                                    <img src="@Vm.GetOgImageUrl(Slug, Vm.Config.ThankYouOgImageFileName)" alt="@Text["admin.share.og.thankyou.image.alt"]" />
                                    <span>@Vm.Config.ThankYouOgImageFileName</span>
                                    <button class="w-btn w-btn--sm" @onclick="() => { Vm.Config!.ThankYouOgImageFileName = string.Empty; }">✕ @Text["common.remove"]</button>
                                </div>
                            }
                            <LocalizedInputFile Class="w-file-input" OnChange="OnThankYouOgImageUpload" Accept="image/*" />
                            <p class="w-hint">@Text["admin.share.og.thankyou.image.hint"]</p>
                            @if (Vm.IsUploading) { <span class="w-uploading">@Text["common.uploading"] (@_uploadElapsedSec @Text["common.seconds"])</span> }
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">👥 @Text["admin.share.users"]</h3>
                            <p class="w-hint">@Text["admin.share.users.hint"]</p>
                            @if (Vm.EffectiveAdminUsers.Count == 0)
                            {
                                <p class="w-hint">@Text["admin.share.users.empty"]</p>
                            }
                            else
                            {
                                <div class="w-admin-users">
                                    @foreach (var admin in Vm.EffectiveAdminUsers)
                                    {
                                        var isOwner = string.Equals(admin.Role, "Owner", StringComparison.OrdinalIgnoreCase);
                                        <div class="w-admin-users__item">
                                            <div>
                                                <strong>@(isOwner ? Text["admin.owner"] : Text["admin.manager"])</strong>
                                                <span>@(string.IsNullOrWhiteSpace(admin.DisplayName) ? admin.Provider : admin.DisplayName)</span>
                                                @if (!string.IsNullOrWhiteSpace(admin.Email))
                                                {
                                                    <small>@admin.Email</small>
                                                }
                                                <small>@admin.Provider · @admin.AddedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                            </div>
                                            @if (Vm.CanManageAdministrators && !isOwner)
                                            {
                                                <button class="w-btn w-btn--danger w-btn--sm" @onclick="() => OnRemoveAdmin(admin.UserId)">@Text["common.delete"]</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        <section class="w-admin__section">
                            <h3 class="w-admin__section-h">🔒 @Text["admin.share.password"]</h3>
                            <label class="w-label">@Text["admin.share.password.change"]</label>
                            <input class="w-input" type="password" @bind="Vm.Config!.PasswordHash" />
                        </section>
                    }

                </div>
            </main>

            <!-- ══════ 스플리터 (드래그로 프리뷰 폭 조정) ══════ -->
            <div class="w-admin-splitter" title="@Text["admin.preview.splitter"]"></div>

            <!-- ══════ 프리뷰 ══════ -->
            <aside class="w-admin-preview @(_previewOpen ? "is-open" : "")">
                <div class="w-admin-preview__head">
                    <strong>@PreviewHeaderTitle</strong>
                    <div class="w-admin-preview__actions">
                        <button class="w-admin-preview__mode @(_previewMode == "phone" ? "active" : "")" @onclick='() => SetPreviewMode("phone")'>@Text["admin.preview.phone"]</button>
                        <button class="w-admin-preview__mode @(_previewMode == "pc" ? "active" : "")" @onclick='() => SetPreviewMode("pc")'>PC</button>
                        @if (_previewMode == "phone")
                        {
                            <select class="w-admin-preview__device" value="@_previewDeviceKey" @onchange="SetPreviewDevice" title="@Text["admin.preview.phone"]">
                                @foreach (var device in _previewDevices)
                                {
                                    <option value="@device.Key">@device.Label</option>
                                }
                            </select>
                        }
                        <button class="w-btn w-btn--sm" @onclick="ReloadPreview" title="@Text["admin.preview.refresh"]">🔄</button>
                        <a class="w-btn w-btn--sm" href="@PreviewUrl" target="_blank" title="@Text["admin.preview.newtab"]">↗</a>
                        <button class="w-admin-preview__close" @onclick="OnClosePreview" aria-label="@Text["admin.preview"]">✕</button>
                    </div>
                </div>
                <div class="w-admin-preview__frame w-admin-preview__frame--@_previewMode" style="@PreviewFrameStyle">
                    <iframe id="w-preview-iframe" src="@PreviewUrl" title="@PreviewTitle"></iframe>
                </div>
                <p class="w-admin-preview__hint">@Text["admin.preview.hint"]</p>
            </aside>

        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private string LoginUrl
    {
        get
        {
            var current = Nav.ToAbsoluteUri(Nav.Uri);
            return $"/_identity/login?lang={Uri.EscapeDataString(Text.Language)}&returnUrl={Uri.EscapeDataString(current.PathAndQuery)}";
        }
    }

    private string _selected = "basic";
    private bool _navOpen = false;
    private bool _previewOpen = false;
    private bool _previewCollapsed = false;
    private bool _initialStateLoaded = false;
    private bool _adminInteropInitialized = false;
    private bool _superAdminAutoLoginChecked = false;
    private string _previewMode = "phone";
    private string _previewDeviceKey = "galaxyS26";
    private bool _layoutPickerOpen = false;
    private string _layoutSearch = "";
    private WeddingLayoutReleaseId? _layoutCandidate;
    private string _layoutApplyMessage = "";
    private WeddingThemePreviewSelection? _themePreviewSelection;
    private string _themePreviewMessage = "";
    private System.Threading.CancellationTokenSource? _themePreviewDebounceCts;
    private bool _heroCropEditorOpen;
    private bool _heroCropEditorNeedsInit;
    private string _heroCropViewport = "mobile";
    private bool _heroCropDesktopFull = true;
    private bool _heroCropMobileFull = true;
    private HeroImageCropRegion _heroCropDesktopDraft = new();
    private HeroImageCropRegion _heroCropMobileDraft = new();
    private long _heroCropEditorRevision;
    private long _previewRevision;
    private DotNetObjectReference<Admin>? _selfRef;

    private record NavItem(string Key, string Icon, string Label);
    private record PreviewDevice(string Key, string Label, int Width, int Height);

    private static readonly PreviewDevice[] _previewDevices =
    [
        new("galaxyS26", "Galaxy S26 · 360×780", 360, 780),
        new("galaxyS26Plus", "Galaxy S26+ · 384×854", 384, 854),
        new("galaxyS26Ultra", "Galaxy S26 Ultra · 412×915", 412, 915),
        new("galaxyZFlip7", "Galaxy Z Flip 7 · 360×840", 360, 840),
        new("galaxyZFold7", "Galaxy Z Fold 7 · 412×915", 412, 915),
        new("iphone17", "iPhone 17 · 393×852", 393, 852),
        new("iphone17Pro", "iPhone 17 Pro · 402×874", 402, 874),
        new("iphone17Max", "iPhone 17 Pro Max · 430×932", 430, 932),
        new("iphoneSE", "iPhone SE · 375×667", 375, 667),
        new("iphone15", "iPhone 15 · 393×852", 393, 852),
        new("iphone15Max", "iPhone 15 Pro Max · 430×932", 430, 932),
        new("galaxyS24", "Galaxy S24 · 360×780", 360, 780),
        new("galaxyS24Ultra", "Galaxy S24 Ultra · 384×854", 384, 854),
    ];

    private static readonly NavItem[] _navItems = new[]
    {
        new NavItem("basic",     Icon("user"), "기본 정보"),
        new NavItem("notice",    Icon("note"), "예식 안내"),
        new NavItem("design",    Icon("palette"), "디자인"),
        new NavItem("story",     Icon("note"), "스토리 챕터"),
        new NavItem("photobook", Icon("media"), "포토북 페이지"),
        new NavItem("cards",     Icon("card"), "카드 강조"),
        new NavItem("content",   Icon("media"), "사진·동영상"),
