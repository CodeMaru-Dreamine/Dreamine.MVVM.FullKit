    private void BeginArchivedLayoutPurge(WeddingLayoutArchiveRecord archive)
    {
        if (_isLayoutWorkflowBusy)
        {
            return;
        }

        ClearSelectedLayoutSubmission();
        CancelLayoutSubmissionArchive();
        CancelLayoutDefinitionPolicyChange();
        _confirmLayoutReleaseId = null;
        _layoutReleaseChangeReason = "";
        _layoutArchivePurgeSubmissionId = archive.SubmissionId;
        _layoutPurgeReason = "";
        _layoutPurgePhrase = "";
        _layoutPurgeIrreversibleConfirmed = false;
        _layoutPurgeConfirmationStep = 1;
        _layoutWorkflowSucceeded = false;
        _layoutWorkflowStatus =
            $"'{PurgeConfirmationPhrase(archive)}'의 복구 불가 영구 삭제를 준비했습니다. " +
            "사유와 확인 문구를 입력해주세요.";
    }

    private void AdvanceArchivedLayoutPurgeConfirmation(
        WeddingLayoutArchiveRecord archive)
    {
        if (_isLayoutWorkflowBusy
            || _layoutPurgeConfirmationStep != 1
            || !string.Equals(
                _layoutArchivePurgeSubmissionId,
                archive.SubmissionId,
                StringComparison.Ordinal))
        {
            return;
        }

        var reason = _layoutPurgeReason.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus = "영구 삭제 사유를 입력해주세요.";
            return;
        }

        var expectedPhrase = PurgeConfirmationPhrase(archive);
        if (!string.Equals(
                _layoutPurgePhrase,
                expectedPhrase,
                StringComparison.Ordinal))
        {
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus =
                $"확인 문구 '{expectedPhrase}'를 정확히 입력해주세요.";
            return;
        }

        _layoutPurgeReason = reason;
        _layoutPurgeConfirmationStep = 2;
        _layoutPurgeIrreversibleConfirmed = false;
        _layoutWorkflowSucceeded = false;
        _layoutWorkflowStatus =
            $"'{expectedPhrase}' 영구 삭제의 1단계 확인을 마쳤습니다. " +
            "복구 불가 확인 후 최종 실행해주세요.";
    }

    private async Task PurgeArchivedLayoutAsync(
        WeddingLayoutArchiveRecord archive)
    {
        if (_isLayoutWorkflowBusy
            || _layoutPurgeConfirmationStep != 2
            || !_layoutPurgeIrreversibleConfirmed
            || !string.Equals(
                _layoutArchivePurgeSubmissionId,
                archive.SubmissionId,
                StringComparison.Ordinal))
        {
            return;
        }

        var reason = _layoutPurgeReason.Trim();
        if (string.IsNullOrWhiteSpace(reason)
            || !string.Equals(
                _layoutPurgePhrase,
                PurgeConfirmationPhrase(archive),
                StringComparison.Ordinal))
        {
            _layoutPurgeConfirmationStep = 1;
            _layoutPurgeIrreversibleConfirmed = false;
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus =
                "영구 삭제 사유와 확인 문구를 다시 확인해주세요.";
            return;
        }

        _isLayoutWorkflowBusy = true;
        try
        {
            var result = await LayoutSubmissions.PurgeArchivedAsync(
                archive.SubmissionId,
                RequireSuperAdminSessionToken(),
                SuperAdminWorkflowActor,
                reason);
            _layoutWorkflowSucceeded = true;
            _layoutWorkflowStatus =
                $"✅ '{PurgeConfirmationPhrase(archive)}'의 제출·패키지" +
                $"{(archive.PublishedReleaseArchived ? "·승인 릴리스" : "")} payload를 " +
                "물리 삭제했습니다. 동일 LayoutKey 소유권 기록과 감사 로그는 유지됩니다. " +
                (result.DefinitionPolicyPreserved
                    ? "다른 산출물이 남아 있어 LayoutKey 등급 정책도 유지했습니다. "
                    : "이 키의 마지막 산출물이어서 사용자 LayoutKey 등급 정책도 정리했습니다. ") +
                "같은 소유자는 동일 버전을 다시 제출할 수 있습니다.";
            CancelArchivedLayoutPurge();
            await RefreshLayoutSubmissionsNoLockAsync();
        }
        catch (Exception ex) when (ex is not UnauthorizedAccessException)
        {
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus =
                $"'{PurgeConfirmationPhrase(archive)}' 영구 삭제가 거부되었습니다. " +
                "현재 활성 포인터나 청첩장 참조가 남아 있는지 확인해주세요. " +
                $"서버 응답: {ex.Message}";
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleLayoutWorkflowFailureAsync(ex);
        }
        finally
        {
            _isLayoutWorkflowBusy = false;
        }
    }

    private static string PurgeConfirmationPhrase(
        WeddingLayoutArchiveRecord archive) =>
        $"{archive.LayoutKey}@{archive.LayoutVersion}";

    private void BeginLayoutReleaseChange(WeddingLayoutReleaseId releaseId, bool isRollback)
    {
        CancelLayoutSubmissionArchive();
        CancelArchivedLayoutPurge();
        CancelLayoutDefinitionPolicyChange();
        _confirmLayoutSubmissionAction = null;
        _confirmLayoutReleaseId = releaseId;
        _layoutReleaseChangeReason = isRollback
            ? $"Rollback to {releaseId.Version}"
            : $"Activate {releaseId.Version}";
    }

    private async Task ChangeActiveLayoutReleaseAsync(WeddingLayoutReleaseId releaseId)
    {
        if (_isLayoutWorkflowBusy || _confirmLayoutReleaseId != releaseId)
        {
            return;
        }

        var reason = _layoutReleaseChangeReason.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus = "활성 버전 변경 사유는 필수입니다.";
            return;
        }

        _isLayoutWorkflowBusy = true;
        try
        {
            var currentVersion = LayoutRegistry.Current
                .FindDescriptor(releaseId.LayoutKey)?
                .CurrentVersion;
            var isRollback = currentVersion is not null
                && IsOlderLayoutVersion(releaseId.Version, currentVersion);
            var result = isRollback
                ? await LayoutSubmissions.RollbackAsync(
                    releaseId.LayoutKey,
                    releaseId.Version,
                    RequireSuperAdminSessionToken(),
                    SuperAdminWorkflowActor,
                    reason)
                : await LayoutSubmissions.ActivateAsync(
                    releaseId.LayoutKey,
                    releaseId.Version,
                    RequireSuperAdminSessionToken(),
                    SuperAdminWorkflowActor,
                    reason);
            _layoutWorkflowSucceeded = true;
            _layoutWorkflowStatus =
                $"✅ '{result.Active.Key}' 활성 버전을 " +
                $"{(isRollback ? "롤백" : "변경")}했습니다: " +
                $"{result.Previous?.Version ?? "없음"} → {result.Active.Version}";
            _confirmLayoutReleaseId = null;
            _layoutReleaseChangeReason = "";
        }
        catch (Exception ex)
        {
            await HandleLayoutWorkflowFailureAsync(ex);
        }
        finally
        {
            _isLayoutWorkflowBusy = false;
        }
    }

    private void CancelLayoutWorkflowConfirmation()
    {
        CancelLayoutSubmissionArchive();
        CancelArchivedLayoutPurge();
        CancelLayoutDefinitionPolicyChange();
        _confirmLayoutSubmissionAction = null;
        _confirmLayoutReleaseId = null;
