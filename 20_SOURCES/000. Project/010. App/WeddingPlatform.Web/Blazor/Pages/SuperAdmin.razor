    private string RequireSuperAdminSessionToken()
    {
        if (!Vm.IsAuthenticated || string.IsNullOrWhiteSpace(Vm.SuperAdminSessionToken))
        {
            throw new UnauthorizedAccessException("슈퍼 관리자 세션이 필요합니다.");
        }

        return Vm.SuperAdminSessionToken;
    }

    private async Task HandleLayoutWorkflowFailureAsync(Exception ex)
    {
        _layoutWorkflowSucceeded = false;
        _layoutWorkflowStatus = $"레이아웃 작업을 완료하지 못했습니다. {ex.Message}";
        if (ex is UnauthorizedAccessException)
        {
            await ClearSuperAdminTokenAsync();
            Vm.Logout();
            _layoutUploadTenantSlug = "";
            _sessionRestoreChecked = true;
        }
    }

