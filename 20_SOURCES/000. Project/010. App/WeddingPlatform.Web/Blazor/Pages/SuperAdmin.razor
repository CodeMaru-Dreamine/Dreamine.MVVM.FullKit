    private void BeginLayoutDefinitionPolicyChange(string layoutKey)
    {
        if (_isLayoutWorkflowBusy
            || !string.Equals(
                _layoutDefinitionPolicyEditorKey,
                layoutKey,
                StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var currentPolicy = FindLayoutDefinitionPolicy(layoutKey);
        if (currentPolicy?.Revision == 0)
        {
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus = "기본 제공 LayoutKey의 확정 등급 정책은 변경할 수 없습니다.";
            return;
        }

        var reason = _layoutDefinitionPolicyReason.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus = "LayoutKey 등급 정책을 설정하려면 사유를 입력해주세요.";
            return;
        }

        if (currentPolicy?.Tier == _layoutDefinitionPolicyTier)
        {
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus = "현재 등급과 다른 등급을 선택해야 재분류할 수 있습니다.";
            return;
        }

        CancelLayoutSubmissionArchive();
        _confirmLayoutSubmissionAction = null;
        _confirmLayoutReleaseId = null;
        _layoutReleaseChangeReason = "";
        _layoutDefinitionPolicyReason = reason;
        _layoutDefinitionPolicyConfirmationKey = layoutKey;
        _layoutDefinitionPolicyConfirmationStep = 1;
        _layoutWorkflowSucceeded = true;
        _layoutWorkflowStatus =
            $"'{layoutKey}' 등급 정책 변경을 준비했습니다. 영향 범위를 확인해주세요.";
    }

    private void AdvanceLayoutDefinitionPolicyConfirmation(string layoutKey)
    {
        if (_isLayoutWorkflowBusy
            || _layoutDefinitionPolicyConfirmationStep != 1
            || !string.Equals(
                _layoutDefinitionPolicyConfirmationKey,
                layoutKey,
                StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _layoutDefinitionPolicyConfirmationStep = 2;
        _layoutWorkflowSucceeded = true;
        _layoutWorkflowStatus =
            $"'{layoutKey}' 정책 변경의 1단계 확인을 마쳤습니다. 최종 확인 후 즉시 적용됩니다.";
    }

    private async Task SetLayoutDefinitionPolicyAsync(string layoutKey)
    {
        if (_isLayoutWorkflowBusy
            || _layoutDefinitionPolicyConfirmationStep != 2
            || !string.Equals(
                _layoutDefinitionPolicyConfirmationKey,
                layoutKey,
                StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var reason = _layoutDefinitionPolicyReason.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            CancelLayoutDefinitionPolicyChange();
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus = "LayoutKey 등급 정책 설정 사유는 필수입니다.";
            return;
        }

        var previousPolicy = FindLayoutDefinitionPolicy(layoutKey);
        if (previousPolicy?.Tier == _layoutDefinitionPolicyTier)
        {
            CancelLayoutDefinitionPolicyChange();
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus = "정책이 이미 선택한 등급으로 설정되어 있습니다.";
            return;
        }

        _isLayoutWorkflowBusy = true;
        try
        {
            var result = await LayoutSubmissions.SetDefinitionTierAsync(
                layoutKey,
                _layoutDefinitionPolicyTier,
                RequireSuperAdminSessionToken(),
                SuperAdminWorkflowActor,
                reason);
            _layoutDefinitionPolicies = await LayoutSubmissions.ListDefinitionPoliciesAsync(
                RequireSuperAdminSessionToken());
            _layoutDefinitionPolicyTier = result.Policy.Tier;
            _layoutDefinitionPolicyReason = "";
            CancelLayoutDefinitionPolicyChange();
            _layoutWorkflowSucceeded = true;
            _layoutWorkflowStatus = result.Reclassified
                ? $"✅ '{result.Policy.LayoutKey}'를 {TierLabel(result.Policy.Tier)} 등급으로 재분류했습니다. " +
                  $"Revision {result.Policy.Revision} 정책이 모든 버전과 사용자 접근에 즉시 적용됩니다."
                : $"✅ '{result.Policy.LayoutKey}'의 신규 등급 정책을 {TierLabel(result.Policy.Tier)}로 설정했습니다. " +
                  $"Revision {result.Policy.Revision} 정책이 모든 버전과 사용자 접근에 즉시 적용됩니다.";
        }
        catch (Exception ex)
        {
            await HandleLayoutWorkflowFailureAsync(ex);
        }
        finally
        {
            _isLayoutWorkflowBusy = false;
        }
    }

    private void BeginLayoutSubmissionAction(string action, string submissionId)
    {
        if (action == "reject" && string.IsNullOrWhiteSpace(_layoutRejectReason))
        {
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus = "반려하려면 반려 사유를 입력해주세요.";
            return;
        }

        if (action == "approve"
            && _layoutSubmissions.FirstOrDefault(x => string.Equals(
                x.SubmissionId,
                submissionId,
                StringComparison.Ordinal)) is { } submission
            && FindLayoutDefinitionPolicy(submission.LayoutKey) is null)
        {
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus = "LayoutKey 등급 정책을 먼저 설정해야 승인할 수 있습니다.";
            return;
        }

        CancelLayoutSubmissionArchive();
        CancelLayoutDefinitionPolicyChange();
        _confirmLayoutReleaseId = null;
        _confirmLayoutSubmissionAction = $"{action}:{submissionId}";
    }

    private async Task ApproveLayoutSubmissionAsync(WeddingLayoutSubmissionRecord submission)
    {
        if (_isLayoutWorkflowBusy
            || _confirmLayoutSubmissionAction != $"approve:{submission.SubmissionId}")
        {
            return;
        }

        if (FindLayoutDefinitionPolicy(submission.LayoutKey) is null)
        {
            _confirmLayoutSubmissionAction = null;
            _layoutWorkflowSucceeded = false;
            _layoutWorkflowStatus = "LayoutKey 등급 정책을 먼저 설정해야 승인할 수 있습니다.";
            return;
        }

        _isLayoutWorkflowBusy = true;
        try
        {
            var result = await LayoutSubmissions.ApproveAsync(
                submission.SubmissionId,
                RequireSuperAdminSessionToken(),
                SuperAdminWorkflowActor,
                _approveAndActivate);
            _layoutWorkflowSucceeded = true;
            _layoutWorkflowStatus = result.Activated
                ? $"✅ '{submission.LayoutLabel} v{submission.LayoutVersion}'을 승인하고 활성화했습니다."
                : $"✅ '{submission.LayoutLabel} v{submission.LayoutVersion}'을 불변 릴리스로 승인했습니다.";
            ClearSelectedLayoutSubmission();
            await RefreshLayoutSubmissionsNoLockAsync();
        }
        catch (Exception ex)
        {
            await HandleLayoutWorkflowFailureAsync(ex);
        }
        finally
        {
            _isLayoutWorkflowBusy = false;
        }
    }

    private async Task RejectLayoutSubmissionAsync(WeddingLayoutSubmissionRecord submission)
