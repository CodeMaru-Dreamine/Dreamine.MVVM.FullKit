@page "/admin"
@layout WeddingPlatform.Blazor.Layout.WeddingLayout
@namespace WeddingPlatform.Blazor.Pages
@rendermode InteractiveServer
@implements IDisposable

@using Wedding.Common
@using Wedding.Layouts.Contracts
@using WeddingPlatform.Models
@using WeddingPlatform.Services
@using Microsoft.JSInterop
@using System.IO
@inject WeddingSuperAdminViewModel Vm
@inject ITenantStore TenantStore
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IWeddingLayoutCatalogRegistry LayoutRegistry
@inject IWeddingLayoutSubmissionService LayoutSubmissions
@inject WeddingLocalization Text

<PageTitle>@Text["admin.integrated"]</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="w-admin @(Vm.IsAuthenticated ? "wedding-admin-shell" : "")">
    @if (!_sessionRestoreChecked)
    {
        <div class="w-loading">
            <div class="w-spinner"></div>
            <p class="w-sa-hint">@Text["admin.super.checking"]</p>
        </div>
    }
    else if (!Vm.IsAuthenticated)
    {
        <div class="w-admin-preferences" aria-label="@Text["screen.settings"]">
            <WeddingPlatform.Blazor.Components.WeddingPreferences />
        </div>
        <div class="w-admin__login w-panel">
            <h2>@Text["admin.super.login"]</h2>
            @if (!Vm.HasConfiguredPassword)
            {
                <p class="w-status w-status--error">@Text["admin.super.password.required"]</p>
            }
            <input class="w-input" type="password" placeholder="@Text["field.password"]"
                   @bind="Vm.LoginPassword"
                   @bind:event="oninput"
                   @onkeydown="OnLoginKeyDown" />
            <button class="w-btn w-btn--primary" @onclick="OnLogin">@Text["login"]</button>
            @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
            {
                <p class="w-status w-status--error">@Vm.StatusMessage</p>
            }
        </div>
    }
    else if (!Vm.IsLoaded)
    {
        <div class="w-loading"><div class="w-spinner"></div></div>
    }
    else
    {
        var filteredTenants = FilteredTenants.ToArray();
        var totalPages = GetTotalPages(filteredTenants.Length);
        var currentPage = Math.Min(_currentPage, totalPages);
        var pagedTenants = filteredTenants
            .Skip((currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToArray();
        var layoutCatalog = LayoutRegistry.Current;
        var publishedLayoutPackages = LayoutRegistry.PublishedPackages;

        <aside class="wedding-admin-sidebar">
            <div class="wedding-admin-brand">
                <span class="wedding-admin-brand__mark">W</span>
                <div>
                    <strong>Wedding</strong>
                    <span>@Text["admin.integrated"]</span>
                </div>
            </div>

            <nav class="wedding-admin-nav" aria-label="@Text["admin.super"]">
                <button class="@NavClass("dashboard")" type="button" @onclick='() => SetActiveMenu("dashboard")'>@Text["admin.dashboard"]</button>
                <button class="@NavClass("invite")" type="button" @onclick='() => SetActiveMenu("invite")'>@Text["admin.invitations"]</button>
                <button class="@NavClass("account")" type="button" @onclick='() => SetActiveMenu("account")'>@Text["admin.accounts"]</button>
                <button class="@NavClass("media")" type="button" @onclick='() => SetActiveMenu("media")'>@Text["admin.media"]</button>
                <button class="@NavClass("layouts")" type="button" @onclick='() => SetActiveMenu("layouts")'>@Text["admin.layouts"]</button>
                <button class="@NavClass("settings")" type="button" @onclick='() => SetActiveMenu("settings")'>@Text["admin.settings"]</button>
            </nav>

            <div class="wedding-admin-sidebar__meter">
                <span>@Text["admin.super.free.policy"]</span>
                <strong>@FormatVideoSize(Vm.MediaPolicy.FreeTier.VideoMaxFileSizeMb)</strong>
                <small>@Text["admin.media.video"] @Vm.MediaPolicy.FreeTier.VideoMaxCount · @Text["admin.media.gallery"] @Vm.MediaPolicy.FreeTier.ImageMaxCount</small>
            </div>
        </aside>

        <main class="wedding-admin-content">
            <header class="wedding-admin-header">
                <div>
                    <p class="wedding-admin-eyebrow">Super Admin</p>
                    <h1>@ActiveTitle</h1>
                    <span>@ActiveDescription</span>
                </div>

                <div class="wedding-admin-header__tools">
                    <WeddingPlatform.Blazor.Components.WeddingPreferences />
                    @if (!ShowLayoutCatalog)
                    {
                    <label class="wedding-admin-search">
                        <span>@Text["admin.search"]</span>
                        <input value="@_searchText"
                               @oninput="OnSearchInput"
                               placeholder="@Text["admin.search.placeholder"]" />
                    </label>
                    }
                    <button class="wedding-admin-action-button is-compact" type="button" @onclick="OnRefresh" title="@Text["admin.refresh"]">
                        @(ShowLayoutCatalog ? Text["admin.layouts"] : Text["admin.refresh"])
                    </button>
                    <button class="wedding-admin-action-button is-compact" type="button" @onclick="OnLogout" title="@Text["logout"]">
                        @Text["logout"]
                    </button>
                    <button class="wedding-admin-icon-button" type="button" title="@Text["admin.notifications"]">!</button>
                    <div class="wedding-admin-profile">
                        <span>A</span>
                        <div>
                            <strong>Admin</strong>
                            <small>@Text["admin.super"]</small>
                        </div>
                    </div>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
            {
                <p class="w-status @(Vm.StatusMessage.StartsWith("✅") ? "" : "w-status--error")">
                    @Vm.StatusMessage
                </p>
            }

            @if (ShowStats)
            {
                <section class="wedding-admin-stats" aria-label="@Text["admin.summary"]">
                    <article class="wedding-admin-stat-card">
                        <span class="wedding-admin-stat-card__icon">A</span>
                        <div>
                            <small>@Text["admin.total.accounts"]</small>
                            <strong>@Vm.Tenants.Count</strong>
                            <em>@Text["admin.registered.couples"]</em>
                        </div>
                    </article>
                    <article class="wedding-admin-stat-card">
                        <span class="wedding-admin-stat-card__icon is-green">H</span>
                        <div>
                            <small>@Text["admin.home.visible"]</small>
                            <strong>@MainVisibleCount</strong>
                            <em>@Percent(MainVisibleCount, Vm.Tenants.Count)</em>
                        </div>
                    </article>
                    <article class="wedding-admin-stat-card">
                        <span class="wedding-admin-stat-card__icon is-gold">PR</span>
                        <div>
                            <small>@Text["admin.premium.active"]</small>
                            <strong>@PremiumActiveCount</strong>
                            <em>@Text["admin.super.premium.plan"]</em>
                        </div>
                    </article>
                    <article class="wedding-admin-stat-card">
                        <span class="wedding-admin-stat-card__icon is-sage">M</span>
                        <div>
                            <small>@Text["admin.storage"]</small>
                            <strong>@TotalStorageLabel</strong>
                            <em>@AvailableStorageLabel</em>
                        </div>
                    </article>
                    <article class="wedding-admin-stat-card">
                        <span class="wedding-admin-stat-card__icon is-blue">V</span>
                        <div>
                            <small>@Text["admin.video.usage"]</small>
                            <strong>@TotalVideoCount</strong>
                            <em>@Text["admin.media.gallery"] @TotalPhotoCount</em>
                        </div>
                    </article>
                </section>
            }

            @if (!ShowStats)
            {
                <section class="wedding-admin-card wedding-admin-section-summary">
                    <h2>@ActiveTitle</h2>
                    <p>@ActiveDescription</p>
                </section>
            }

            @if (ShowLayoutCatalog)
            {
                <section class="wedding-admin-card wedding-admin-layout-upload" aria-labelledby="layout-upload-title">
                    <div class="wedding-admin-card__header">
                        <div>
                            <h2 id="layout-upload-title">@Text["admin.super.layout.upload"]</h2>
                            <p>@Text["admin.super.layout.upload.desc"]</p>
                        </div>
                        <span class="wedding-admin-badge is-success">@Text["admin.super.only"]</span>
                    </div>

                    @if (Vm.Tenants.Count == 0)
                    {
                        <p class="w-sa-empty">@Text["admin.super.layout.owner.empty"]</p>
                    }
                    else
                    {
                        <div class="wedding-admin-layout-upload__form">
                            <label class="w-label">
                                @Text["admin.super.layout.owner"]
                                <select class="w-input"
                                        disabled="@_isLayoutWorkflowBusy"
                                        @bind="_layoutUploadTenantSlug"
                                        @bind:after="OnLayoutUploadTenantChanged">
                                    <option value="">@Text["admin.super.select.account"]</option>
                                    @foreach (var tenant in Vm.Tenants
                                        .OrderBy(x => x.CoupleName, StringComparer.CurrentCulture)
                                        .ThenBy(x => x.Slug, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <option value="@tenant.Slug">@tenant.CoupleName · /@tenant.Slug</option>
                                    }
                                </select>
                                <span class="w-hint">
                                    @Text["admin.super.layout.owner.hint"]
                                </span>
                            </label>

                            <label class="w-label">
                                WPF LayoutPackage JSON
                                <LocalizedInputFile @key="_layoutUploadInputVersion"
                                                    Class="w-input"
                                                    Accept=".json,application/json"
                                                    Disabled="@(_isLayoutWorkflowBusy || string.IsNullOrWhiteSpace(_layoutUploadTenantSlug))"
                                                    OnChange="OnSuperAdminLayoutPackageUpload" />
                                <span class="w-hint">
                                    @Text["admin.super.layout.package.hint"]
                                </span>
                            </label>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_layoutUploadStatus))
                        {
                            <p class="w-status @(_layoutUploadSucceeded ? "" : "w-status--error")"
                               aria-live="polite">
                                @_layoutUploadStatus
                            </p>
                        }
                    }
                </section>

                <section class="wedding-admin-card wedding-admin-table-card" aria-labelledby="layout-catalog-title">
                    <div class="wedding-admin-table-card__header">
                        <div>
                            <h2 id="layout-catalog-title">@Text["admin.super.layout.active"] <span>@layoutCatalog.Descriptors.Count</span></h2>
                            <p>@string.Format(
                                Text["admin.super.layout.summary"],
                                layoutCatalog.Descriptors.Count(x => x.IsBuiltIn),
                                layoutCatalog.Descriptors.Count(x => !x.IsBuiltIn),
                                publishedLayoutPackages.Count,
                                WeddingLayoutCatalog.Instance.Releases.Count + publishedLayoutPackages.Count)</p>
                        </div>

                        <div class="wedding-admin-table-tools">
                            <span class="wedding-admin-badge is-success">@Text["admin.super.layout.watch"]</span>
                            @if (_layoutCatalogChangedAt is { } changedAt)
                            {
                                <small>@string.Format(Text["admin.super.layout.last.applied"], changedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))</small>
                            }
                            <button class="wedding-admin-action-button"
                                    type="button"
                                    disabled="@_isLayoutCatalogReloading"
                                    @onclick="OnReloadLayoutCatalog">
                                @(_isLayoutCatalogReloading ? Text["admin.super.layout.checking"] : Text["admin.super.layout.reload"])
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_layoutCatalogStatus))
                    {
                        <p class="w-status @(_layoutCatalogReloadSucceeded ? "" : "w-status--error")">
                            @_layoutCatalogStatus
                        </p>
                    }

                    <div class="wedding-admin-table-wrap">
                        <table class="wedding-admin-table">
                            <thead>
                                <tr>
                                    <th>@Text["admin.super.layout.name"]</th>
                                    <th>@Text["admin.super.layout.key"]</th>
                                    <th>@Text["admin.super.table.tier"]</th>
                                    <th>@Text["admin.super.layout.version"]</th>
                                    <th>@Text["admin.super.layout.source"]</th>
                                    <th>@Text["admin.super.layout.runtime"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var descriptor in layoutCatalog.Descriptors
                                    .Where(x => x.IsBuiltIn)
                                    .OrderBy(x => x.Label, StringComparer.OrdinalIgnoreCase))
                                {
                                    var activeRelease = layoutCatalog.FindRelease(descriptor.Key, descriptor.CurrentVersion);
                                    <tr>
                                        <td>
                                            <strong>@LayoutLabel(descriptor.Key, descriptor.Label)</strong>
                                            <small style="display:block">@LayoutDescription(descriptor.Key, descriptor.Description)</small>
                                        </td>
                                        <td><span class="w-sa-slug">@descriptor.Key</span></td>
                                        <td>
                                            <span class="wedding-admin-badge @(descriptor.Tier == WeddingLayoutTier.Premium ? "is-gold" : "is-muted")">
                                                @TierLabel(descriptor.Tier)
                                            </span>
                                            <small style="display:block">@Text["admin.super.layout.policy.protected"]</small>
                                        </td>
                                        <td><strong>v@(descriptor.CurrentVersion)</strong></td>
                                        <td>@SourceLabel(descriptor)</td>
                                        <td>
                                            <span class="wedding-admin-badge @(activeRelease?.IsImplemented == true ? "is-success" : "is-danger")">
                                                @(activeRelease?.IsImplemented == true ? Text["admin.super.layout.serving"] : Text["admin.super.layout.unavailable"])
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="wedding-admin-card wedding-admin-table-card" aria-labelledby="layout-policy-title">
                    <div class="wedding-admin-table-card__header">
                        <div>
                            <h2 id="layout-policy-title">
                                @Text["admin.super.layout.tier.policy"]
                                <span>@_layoutDefinitionPolicies.Count</span>
                            </h2>
                            <p>@Text["admin.super.layout.policy.desc"]</p>
                        </div>
                    </div>

                    @if (UnclassifiedLayoutKeys.Count > 0)
                    {
                        <section class="wedding-admin-panel-section" aria-live="polite">
                            <h3>등급 설정이 필요한 LayoutKey</h3>
                            <p class="w-status w-status--error">
                                아래 키는 아직 Free/Premium 서버 정책이 없습니다. 등급을 설정하기 전에는
                                신규 버전을 승인할 수 없습니다.
                            </p>
                            <div class="wedding-admin-quick-actions">
                                @foreach (var unclassifiedKey in UnclassifiedLayoutKeys)
                                {
                                    <button class="wedding-admin-action-button is-primary"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="() => OpenStandaloneLayoutDefinitionPolicyEditor(unclassifiedKey)">
                                        @unclassifiedKey · 등급 설정
                                    </button>
                                }
                            </div>
                        </section>
                    }

                    @if (_layoutDefinitionPolicies.Count == 0)
                    {
                        <p class="w-sa-empty">등록된 LayoutKey 등급 정책이 없습니다.</p>
                    }
                    else
                    {
                        <div class="wedding-admin-table-wrap">
                            <table class="wedding-admin-table">
                                <thead>
                                    <tr>
                                        <th>LayoutKey</th>
                                        <th>@Text["admin.super.table.tier"]</th>
                                        <th>@Text["admin.super.layout.policy.kind"]</th>
                                        <th>@Text["admin.super.layout.revision"]</th>
                                        <th>@Text["admin.super.layout.policy.recent"]</th>
                                        <th>@Text["admin.super.layout.reason"]</th>
                                        <th>@Text["admin.super.table.action"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var policy in _layoutDefinitionPolicies
                                        .OrderByDescending(x => IsProtectedLayoutDefinitionPolicy(x))
                                        .ThenBy(x => x.LayoutKey, StringComparer.OrdinalIgnoreCase))
                                    {
                                        var isProtectedPolicy = IsProtectedLayoutDefinitionPolicy(policy);
                                        <tr>
                                            <td><span class="w-sa-slug">@policy.LayoutKey</span></td>
                                            <td>
                                                <span class="wedding-admin-badge @(policy.Tier == LayoutTier.Premium ? "is-gold" : "is-muted")">
                                                    @TierLabel(policy.Tier)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="wedding-admin-badge @(isProtectedPolicy ? "is-muted" : "is-success")">
                                                    @(isProtectedPolicy ? Text["admin.super.layout.policy.protected"] : Text["admin.super.layout.user.policy"])
                                                </span>
                                            </td>
                                            <td>@(isProtectedPolicy ? Text["admin.super.layout.protected"] : policy.Revision.ToString())</td>
                                            <td>
                                                @if (isProtectedPolicy)
                                                {
                                                    <span>@Text["admin.super.layout.server.builtin"]</span>
                                                    <small style="display:block">@Text["admin.super.layout.immutable"]</small>
                                                }
                                                else
                                                {
                                                    <span>@policy.ClassifiedBy</span>
                                                    <small style="display:block">
                                                        @policy.ClassifiedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                    </small>
                                                }
                                            </td>
                                            <td>@PolicyReasonLabel(policy.Reason)</td>
                                            <td>
                                                @if (isProtectedPolicy)
                                                {
                                                    <span class="wedding-admin-badge is-muted">@Text["admin.super.layout.protected"]</span>
                                                }
                                                else
                                                {
                                                    <button class="wedding-admin-action-button is-compact"
                                                            type="button"
                                                            disabled="@_isLayoutWorkflowBusy"
                                                            @onclick="() => OpenStandaloneLayoutDefinitionPolicyEditor(policy.LayoutKey)">
                                                        @Text["admin.super.layout.manage.policy"]
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (SelectedLayoutSubmission is null
                        && !string.IsNullOrWhiteSpace(_layoutDefinitionPolicyEditorKey))
                    {
                        var editorLayoutKey = _layoutDefinitionPolicyEditorKey!;
                        var editorPolicy = FindLayoutDefinitionPolicy(editorLayoutKey);
                        <section class="wedding-admin-panel-section" aria-labelledby="standalone-layout-policy-editor-title">
                            <h3 id="standalone-layout-policy-editor-title">
                                등급 정책 관리 · <span class="w-sa-slug">@editorLayoutKey</span>
                            </h3>

                            @if (editorPolicy is { } currentEditorPolicy)
                            {
                                <p class="w-hint">
                                    현재 @TierLabel(currentEditorPolicy.Tier) · Revision @currentEditorPolicy.Revision ·
                                    @currentEditorPolicy.ClassifiedBy ·
                                    @currentEditorPolicy.ClassifiedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </p>
                            }

                            <label class="w-label" for="standalone-layout-definition-policy-tier">적용 등급</label>
                            <select id="standalone-layout-definition-policy-tier"
                                    class="w-input"
                                    disabled="@(_isLayoutWorkflowBusy || _layoutDefinitionPolicyConfirmationStep > 0)"
                                    @bind="_layoutDefinitionPolicyTier">
                                <option value="@LayoutTier.Free">Free</option>
                                <option value="@LayoutTier.Premium">Premium</option>
                            </select>

                            <label class="w-label" for="standalone-layout-definition-policy-reason">
                                @(editorPolicy is null ? "최초 분류 사유" : "재분류 사유")
                            </label>
                            <textarea id="standalone-layout-definition-policy-reason"
                                      class="w-input"
                                      rows="3"
                                      maxlength="300"
                                      disabled="@(_isLayoutWorkflowBusy || _layoutDefinitionPolicyConfirmationStep > 0)"
                                      placeholder="감사 기록에 남길 등급 정책 사유를 입력합니다."
                                      @bind="_layoutDefinitionPolicyReason"
                                      @bind:event="oninput"></textarea>

                            @if (_layoutDefinitionPolicyConfirmationStep == 0)
                            {
                                <div class="wedding-admin-quick-actions">
                                    <button class="wedding-admin-action-button is-primary"
                                            type="button"
                                            disabled="@(_isLayoutWorkflowBusy
                                                || string.IsNullOrWhiteSpace(_layoutDefinitionPolicyReason)
                                                || editorPolicy?.Tier == _layoutDefinitionPolicyTier)"
                                            @onclick="() => BeginLayoutDefinitionPolicyChange(editorLayoutKey)">
                                        @(editorPolicy is null ? "등급 설정 준비" : "등급 재분류 준비")
                                    </button>
                                    <button class="wedding-admin-action-button"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="CloseLayoutDefinitionPolicyEditor">
                                        닫기
                                    </button>
                                </div>
                            }
                            else if (_layoutDefinitionPolicyConfirmationStep == 1)
                            {
                                <p class="w-status w-status--error">
                                    1단계 확인: 이 변경은 <strong>@editorLayoutKey</strong>의 모든 버전과
                                    모든 사용자 접근 권한에 즉시 영향을 줍니다.
                                </p>
                                <div class="wedding-admin-quick-actions">
                                    <button class="wedding-admin-action-button is-danger"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="() => AdvanceLayoutDefinitionPolicyConfirmation(editorLayoutKey)">
                                        1단계 확인
                                    </button>
                                    <button class="wedding-admin-action-button"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="CancelLayoutDefinitionPolicyChange">
                                        취소
                                    </button>
                                </div>
                            }
                            else if (_layoutDefinitionPolicyConfirmationStep == 2)
                            {
                                <p class="w-status w-status--error">
                                    최종 확인: @(DefinitionPolicyChangeSummary(editorPolicy)).
                                    기존 버전과 향후 버전 모두 같은 정책을 사용합니다.
                                </p>
                                <div class="wedding-admin-quick-actions">
                                    <button class="wedding-admin-action-button is-danger"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="() => SetLayoutDefinitionPolicyAsync(editorLayoutKey)">
                                        @(_isLayoutWorkflowBusy
                                            ? "등급 정책 적용 중..."
                                            : "2단계 확인 · 등급 정책 적용")
                                    </button>
                                    <button class="wedding-admin-action-button"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="CancelLayoutDefinitionPolicyChange">
                                        취소
                                    </button>
                                </div>
                            }
                        </section>
                    }
                </section>

                <section class="wedding-admin-card wedding-admin-table-card" aria-labelledby="layout-submission-title">
                    <div class="wedding-admin-table-card__header">
                        <div>
                            <h2 id="layout-submission-title">
                                @Text["admin.super.layout.review"]
                                <span>@_layoutSubmissions.Count(x => x.Status == WeddingLayoutSubmissionStatus.Pending)</span>
                            </h2>
                            <p>@Text["admin.super.layout.review.desc"]</p>
                        </div>

                        <div class="wedding-admin-table-tools">
                            @if (UnclassifiedLayoutKeys.Count > 0)
                            {
                                <button class="wedding-admin-action-button is-primary"
                                        type="button"
                                        disabled="@_isLayoutWorkflowBusy"
                                        @onclick="() => OpenStandaloneLayoutDefinitionPolicyEditor(UnclassifiedLayoutKeys[0])">
                                    미분류 등급 설정 (@UnclassifiedLayoutKeys.Count)
                                </button>
                            }
                            <select class="w-input"
                                    style="width:auto; min-width:130px; margin:0"
                                    title="@Text["admin.super.layout.review.scope"]"
                                    @bind="_layoutSubmissionFilter">
                                <option value="pending">@Text["admin.super.layout.review.pending"]</option>
                                <option value="completed">@Text["admin.super.layout.review.completed"]</option>
                                <option value="all">@Text["admin.super.all"]</option>
                            </select>
                            <button class="wedding-admin-action-button"
                                    type="button"
                                    disabled="@_isLayoutWorkflowBusy"
                                    @onclick="LoadLayoutSubmissionsAsync">
                                @(_isLayoutWorkflowBusy ? Text["admin.super.loading"] : Text["admin.super.layout.review.refresh"])
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_layoutWorkflowStatus))
                    {
                        <p class="w-status @(_layoutWorkflowSucceeded ? "" : "w-status--error")">
                            @_layoutWorkflowStatus
                        </p>
                    }

                    @if (_layoutSubmissions.Count == 0)
                    {
                        <p class="w-sa-empty">@Text["admin.super.layout.review.empty"]</p>
                    }
                    else if (FilteredLayoutSubmissions.Count == 0)
                    {
                        <p class="w-sa-empty">@Text["admin.super.layout.review.empty.filtered"]</p>
                    }
                    else
                    {
                        <div class="wedding-admin-table-wrap">
                            <table class="wedding-admin-table">
                                <thead>
                                    <tr>
                                        <th>@Text["admin.super.layout.submitted.at"]</th>
                                        <th>@Text["admin.super.layout.submitted.by"]</th>
                                        <th>@Text["admin.super.layout.name"]</th>
                                        <th>@Text["admin.super.layout.version"]</th>
                                        <th>@Text["admin.super.table.tier"]</th>
                                        <th>@Text["admin.super.layout.status"]</th>
                                        <th>@Text["admin.super.layout.review.result"]</th>
                                        <th>@Text["admin.super.table.action"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var submission in FilteredLayoutSubmissions)
                                    {
                                        var submissionPolicy = FindLayoutDefinitionPolicy(submission.LayoutKey);
                                        <tr class="@(IsSelectedLayoutSubmission(submission) ? "is-selected" : "")">
                                            <td>@submission.SubmittedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>
                                                <strong>@submission.SubmittedByDisplayName</strong>
                                                <small style="display:block">@submission.TenantSlug</small>
                                            </td>
                                            <td>
                                                <strong>@submission.LayoutLabel</strong>
                                                <small style="display:block">@submission.LayoutKey</small>
                                            </td>
                                            <td><span class="w-sa-slug">v@(submission.LayoutVersion)</span></td>
                                            <td>
                                                @if (submissionPolicy is { } classifiedSubmissionPolicy)
                                                {
                                                    <span class="wedding-admin-badge @(classifiedSubmissionPolicy.Tier == LayoutTier.Premium ? "is-gold" : "is-muted")">
                                                        @TierLabel(classifiedSubmissionPolicy.Tier)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="wedding-admin-badge is-danger">@Text["admin.super.layout.unclassified"]</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="wedding-admin-badge @SubmissionStatusClass(submission.Status)">
                                                    @SubmissionStatusLabel(submission.Status)
                                                </span>
                                            </td>
                                            <td>
                                                @if (submission.ReviewedAtUtc is { } reviewedAt)
                                                {
                                                    <span>@submission.ReviewedBy</span>
                                                    <small style="display:block">@reviewedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
                                                    @if (!string.IsNullOrWhiteSpace(submission.ReviewReason))
                                                    {
                                                        <small style="display:block">@submission.ReviewReason</small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="wedding-admin-quick-actions">
                                                    @if (submission.Status == WeddingLayoutSubmissionStatus.Pending)
                                                    {
                                                        <button class="wedding-admin-action-button is-compact"
                                                                type="button"
                                                                disabled="@_isLayoutWorkflowBusy"
                                                                @onclick="() => SelectLayoutSubmissionAsync(submission)">
                                                            @Text["admin.super.layout.review.action"]
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="wedding-admin-badge is-muted">@Text["admin.super.layout.review.done"]</span>
                                                    }

                                                    @if (submissionPolicy is null)
                                                    {
                                                        <button class="wedding-admin-action-button is-compact is-primary"
                                                                type="button"
                                                                disabled="@_isLayoutWorkflowBusy"
                                                                @onclick="() => OpenStandaloneLayoutDefinitionPolicyEditor(submission.LayoutKey)">
                                                            @Text["admin.super.layout.classify"]
                                                        </button>
                                                    }

                                                    <button class="wedding-admin-action-button is-compact is-danger"
                                                            type="button"
                                                            disabled="@_isLayoutWorkflowBusy"
                                                            title="파일을 물리 삭제하지 않고 서버 보관함으로 이동합니다."
                                                            @onclick="() => BeginLayoutSubmissionArchive(submission)">
                                                        보관함 이동
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (LayoutSubmissionToArchive is { } archiveSubmission)
                    {
                        <section class="wedding-admin-panel-section" aria-live="polite">
                            <h3>
                                서버 보관함으로 이동:
                                @archiveSubmission.LayoutLabel v@(archiveSubmission.LayoutVersion)
                            </h3>
                            <p class="w-hint">
                                이 작업은 물리 삭제가 아닙니다. 제출 기록과 서버 파일을 운영 목록에서 분리해
                                서버 관리 보관함으로 이동합니다.
                            </p>
                            @if (archiveSubmission.Status == WeddingLayoutSubmissionStatus.Approved)
                            {
                                <p class="w-status w-status--error">
                                    승인 릴리스도 함께 보관을 시도합니다. 현재 활성 버전이라도 해당 키의
                                    유일한 릴리스이고 참조 중인 청첩장이 0개이면 활성 포인터와 함께 보관할
                                    수 있습니다. 다른 릴리스가 남아 있으면 아래 목록에서 먼저 다른 버전을
                                    활성화하거나 롤백해야 하며, 청첩장이 이 버전을 참조 중이면 서버가
                                    이동을 거부합니다.
                                </p>
                            }

                            <label class="w-label" for="layout-archive-reason">보관함 이동 사유</label>
                            <textarea id="layout-archive-reason"
                                      class="w-input"
                                      rows="3"
                                      maxlength="300"
                                      disabled="@(_layoutArchiveConfirmationStep == 2)"
                                      placeholder="감사 기록에 남길 사유를 입력합니다."
                                      @bind="_layoutArchiveReason"
                                      @bind:event="oninput"></textarea>

                            @if (_layoutArchiveConfirmationStep == 1)
                            {
                                <div class="wedding-admin-quick-actions">
                                    <button class="wedding-admin-action-button is-danger"
                                            type="button"
                                            disabled="@(_isLayoutWorkflowBusy || string.IsNullOrWhiteSpace(_layoutArchiveReason))"
                                            @onclick="() => AdvanceLayoutSubmissionArchiveConfirmation(archiveSubmission)">
                                        1단계 확인
                                    </button>
                                    <button class="wedding-admin-action-button"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="CancelLayoutSubmissionArchive">
                                        취소
                                    </button>
                                </div>
                            }
                            else if (_layoutArchiveConfirmationStep == 2)
                            {
                                <p class="w-status w-status--error">
                                    최종 확인 단계입니다. 계속하면 이 제출은 검토 목록에서 사라지고 서버
                                    보관함으로 이동합니다. 파일은 물리 삭제되지 않습니다.
                                </p>
                                <div class="wedding-admin-quick-actions">
                                    <button class="wedding-admin-action-button is-danger"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="() => ArchiveLayoutSubmissionAsync(archiveSubmission)">
                                        @(_isLayoutWorkflowBusy
                                            ? "서버 보관함으로 이동 중..."
                                            : "2단계 확인 · 서버 보관함으로 이동")
                                    </button>
                                    <button class="wedding-admin-action-button"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="CancelLayoutSubmissionArchive">
                                        취소
                                    </button>
                                </div>
                            }
                        </section>
                    }

                    @if (SelectedLayoutSubmission is { } selectedSubmission
                        && _layoutReviewPackage is { } reviewPackage)
                    {
                        var selectedDefinitionPolicy = FindLayoutDefinitionPolicy(selectedSubmission.LayoutKey);
                        <section class="wedding-admin-panel-section">
                            <h3>@selectedSubmission.LayoutLabel v@(selectedSubmission.LayoutVersion) 검토</h3>
                            <dl class="wedding-admin-detail-list">
                                <div>
                                    <dt>제출자</dt>
                                    <dd>@selectedSubmission.SubmittedByDisplayName · @selectedSubmission.TenantSlug</dd>
                                </div>
                                <div>
                                    <dt>설명</dt>
                                    <dd>@reviewPackage.Manifest.Description</dd>
                                </div>
                                <div>
                                    <dt>선언 블록</dt>
                                    <dd>@(CountLayoutBlocks(reviewPackage.Definition.Root))개</dd>
                                </div>
                                <div>
                                    <dt>섹션 순서</dt>
                                    <dd>@string.Join(", ", reviewPackage.Definition.SectionOrder)</dd>
                                </div>
                                <div>
                                    <dt>패키지 지문</dt>
                                    <dd><span class="w-sa-slug">@ShortHash(selectedSubmission.PackageSha256)</span></dd>
                                </div>
                            </dl>

                            <section class="wedding-admin-panel-section" aria-labelledby="layout-definition-policy-title">
                                <h3 id="layout-definition-policy-title">LayoutKey 등급 정책</h3>
                                <p class="w-hint">
                                    등급은 개별 업로드나 버전이 아니라
                                    <span class="w-sa-slug">@selectedSubmission.LayoutKey</span>
                                    키 전체에 적용됩니다.
                                </p>

                                @if (selectedDefinitionPolicy is { } currentPolicy)
                                {
                                    <dl class="wedding-admin-detail-list">
                                        <div>
                                            <dt>현재 정책</dt>
                                            <dd>
                                                <span class="wedding-admin-badge @(currentPolicy.Tier == LayoutTier.Premium ? "is-gold" : "is-muted")">
                                                    @TierLabel(currentPolicy.Tier)
                                                </span>
                                                · Revision @currentPolicy.Revision
                                            </dd>
                                        </div>
                                        <div>
                                            <dt>최근 분류</dt>
                                            <dd>
                                                @currentPolicy.ClassifiedBy ·
                                                @currentPolicy.ClassifiedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                            </dd>
                                        </div>
                                        <div>
                                            <dt>최근 사유</dt>
                                            <dd>@currentPolicy.Reason</dd>
                                        </div>
                                    </dl>
                                }
                                else
                                {
                                    <p class="w-status w-status--error">
                                        미분류 상태입니다. 이 LayoutKey의 등급 정책을 먼저 설정해야 버전을 승인할 수 있습니다.
                                    </p>
                                }

                                <label class="w-label" for="layout-definition-policy-tier">적용 등급</label>
                                <select id="layout-definition-policy-tier"
                                        class="w-input"
                                        disabled="@(_isLayoutWorkflowBusy || _layoutDefinitionPolicyConfirmationStep > 0)"
                                        @bind="_layoutDefinitionPolicyTier">
                                    <option value="@LayoutTier.Free">Free</option>
                                    <option value="@LayoutTier.Premium">Premium</option>
                                </select>

                                <label class="w-label" for="layout-definition-policy-reason">정책 설정 사유</label>
                                <textarea id="layout-definition-policy-reason"
                                          class="w-input"
                                          rows="3"
                                          maxlength="300"
                                          disabled="@(_isLayoutWorkflowBusy || _layoutDefinitionPolicyConfirmationStep > 0)"
                                          placeholder="감사 기록에 남길 분류 또는 재분류 사유를 입력합니다."
                                          @bind="_layoutDefinitionPolicyReason"
                                          @bind:event="oninput"></textarea>

                                @if (_layoutDefinitionPolicyConfirmationStep == 0)
                                {
                                    <button class="wedding-admin-action-button is-primary"
                                            type="button"
                                            disabled="@(_isLayoutWorkflowBusy
                                                || string.IsNullOrWhiteSpace(_layoutDefinitionPolicyReason)
                                                || selectedDefinitionPolicy?.Tier == _layoutDefinitionPolicyTier)"
                                            @onclick="() => BeginLayoutDefinitionPolicyChange(selectedSubmission.LayoutKey)">
                                        @(selectedDefinitionPolicy is null ? "신규 정책 설정 준비" : "등급 재분류 준비")
                                    </button>
                                }
                                else if (_layoutDefinitionPolicyConfirmationStep == 1)
                                {
                                    <p class="w-status w-status--error">
                                        1단계 확인: 이 변경은
                                        <strong>@selectedSubmission.LayoutKey</strong>의 모든 버전과 모든 사용자 접근 권한에
                                        즉시 영향을 줍니다.
                                    </p>
                                    <div class="wedding-admin-quick-actions">
                                        <button class="wedding-admin-action-button is-danger"
                                                type="button"
                                                disabled="@_isLayoutWorkflowBusy"
                                                @onclick="() => AdvanceLayoutDefinitionPolicyConfirmation(selectedSubmission.LayoutKey)">
                                            1단계 확인
                                        </button>
                                        <button class="wedding-admin-action-button"
                                                type="button"
                                                disabled="@_isLayoutWorkflowBusy"
                                                @onclick="CancelLayoutDefinitionPolicyChange">
                                            취소
                                        </button>
                                    </div>
                                }
                                else if (_layoutDefinitionPolicyConfirmationStep == 2)
                                {
                                    <p class="w-status w-status--error">
                                        최종 확인: @(DefinitionPolicyChangeSummary(selectedDefinitionPolicy)).
                                        적용 즉시 이 키의 기존 버전과 향후 버전 모두 같은 등급 정책을 사용합니다.
                                    </p>
                                    <div class="wedding-admin-quick-actions">
                                        <button class="wedding-admin-action-button is-danger"
                                                type="button"
                                                disabled="@_isLayoutWorkflowBusy"
                                                @onclick="() => SetLayoutDefinitionPolicyAsync(selectedSubmission.LayoutKey)">
                                            @(_isLayoutWorkflowBusy
                                                ? "등급 정책 적용 중..."
                                                : "2단계 확인 · 등급 정책 적용")
                                        </button>
                                        <button class="wedding-admin-action-button"
                                                type="button"
                                                disabled="@_isLayoutWorkflowBusy"
                                                @onclick="CancelLayoutDefinitionPolicyChange">
                                            취소
                                        </button>
                                    </div>
                                }
                            </section>

                            <label class="wedding-admin-checkline">
                                <input type="checkbox" @bind="_approveAndActivate" />
                                <span>승인과 동시에 이 버전을 활성화</span>
                            </label>

                            @if (selectedDefinitionPolicy is null)
                            {
                                <p class="w-status w-status--error">
                                    승인할 수 없습니다. 위에서 LayoutKey 등급 정책을 먼저 설정해주세요.
                                </p>
                            }

                            <label class="w-label" for="layout-reject-reason">반려 사유</label>
                            <textarea id="layout-reject-reason"
                                      class="w-input"
                                      rows="3"
                                      maxlength="500"
                                      placeholder="반려할 때 필수로 입력합니다."
                                      @bind="_layoutRejectReason"></textarea>

                            <div class="wedding-admin-quick-actions">
                                @if (_confirmLayoutSubmissionAction == $"approve:{selectedSubmission.SubmissionId}")
                                {
                                    <button class="wedding-admin-action-button is-primary"
                                            type="button"
                                            disabled="@(_isLayoutWorkflowBusy || selectedDefinitionPolicy is null)"
                                            @onclick="() => ApproveLayoutSubmissionAsync(selectedSubmission)">
                                        @(_approveAndActivate ? "승인 및 활성화 확인" : "승인 확인")
                                    </button>
                                    <button class="wedding-admin-action-button"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="CancelLayoutWorkflowConfirmation">
                                        취소
                                    </button>
                                }
                                else
                                {
                                    <button class="wedding-admin-action-button is-primary"
                                            type="button"
                                            disabled="@(_isLayoutWorkflowBusy || selectedDefinitionPolicy is null)"
                                            @onclick='() => BeginLayoutSubmissionAction("approve", selectedSubmission.SubmissionId)'>
                                        @(_approveAndActivate ? "승인 및 활성화" : "승인")
                                    </button>
                                }

                                @if (_confirmLayoutSubmissionAction == $"reject:{selectedSubmission.SubmissionId}")
                                {
                                    <button class="wedding-admin-action-button is-danger"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="() => RejectLayoutSubmissionAsync(selectedSubmission)">
                                        반려 확인
                                    </button>
                                    <button class="wedding-admin-action-button"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="CancelLayoutWorkflowConfirmation">
                                        취소
                                    </button>
                                }
                                else
                                {
                                    <button class="wedding-admin-action-button is-danger"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick='() => BeginLayoutSubmissionAction("reject", selectedSubmission.SubmissionId)'>
                                        반려
                                    </button>
                                }
                            </div>
                        </section>
                    }
                </section>

                <section class="wedding-admin-card wedding-admin-table-card" aria-labelledby="layout-archive-title">
                    <div class="wedding-admin-table-card__header">
                        <div>
                            <h2 id="layout-archive-title">
                                @Text["admin.super.layout.archive"]
                                <span>@_layoutArchives.Count</span>
                            </h2>
                            <p>@Text["admin.super.layout.archive.desc"]</p>
                        </div>
                    </div>

                    @if (_layoutArchives.Count == 0)
                    {
                        <p class="w-sa-empty">@Text["admin.super.layout.archive.empty"]</p>
                    }
                    else
                    {
                        <div class="wedding-admin-table-wrap">
                            <table class="wedding-admin-table">
                                <thead>
                                    <tr>
                                        <th>@Text["admin.super.layout.archived.at"]</th>
                                        <th>@Text["admin.super.layout.submitted.account"]</th>
                                        <th>LayoutKey</th>
                                        <th>@Text["admin.super.layout.version"]</th>
                                        <th>@Text["admin.super.layout.archive.scope"]</th>
                                        <th>@Text["admin.super.layout.archive.info"]</th>
                                        <th>@Text["admin.super.table.action"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var archive in _layoutArchives)
                                    {
                                        <tr>
                                            <td>@archive.ArchivedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                            <td><span class="w-sa-slug">@archive.TenantSlug</span></td>
                                            <td><strong>@archive.LayoutKey</strong></td>
                                            <td><span class="w-sa-slug">v@(archive.LayoutVersion)</span></td>
                                            <td>
                                                <span class="wedding-admin-badge @(archive.PublishedReleaseArchived ? "is-gold" : "is-muted")">
                                                    @(archive.PublishedReleaseArchived
                                                        ? Text["admin.super.layout.archive.release"]
                                                        : Text["admin.super.layout.archive.submission"])
                                                </span>
                                            </td>
                                            <td>
                                                <span>@archive.ArchivedBy</span>
                                                <small style="display:block">@archive.Reason</small>
                                            </td>
                                            <td>
                                                <button class="wedding-admin-action-button is-compact is-danger"
                                                        type="button"
                                                        disabled="@_isLayoutWorkflowBusy"
                                                        @onclick="() => BeginArchivedLayoutPurge(archive)">
                                                    @Text["admin.super.layout.purge"]
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (LayoutArchiveToPurge is { } purgeArchive)
                    {
                        <section class="wedding-admin-panel-section" aria-live="assertive">
                            <h3>
                                복구 불가 영구 삭제:
                                <span class="w-sa-slug">@PurgeConfirmationPhrase(purgeArchive)</span>
                            </h3>
                            <p class="w-status w-status--error">
                                먼저 운영 목록에서 안전하게 보관된 항목만 삭제할 수 있습니다.
                                계속하면 제출 원본·JSON 패키지·승인 릴리스 payload는 물리 삭제되어
                                복구할 수 없습니다. 최소 소유권 기록과 감사 로그는 유지됩니다.
                                LayoutKey 등급 정책은 다른 제출·릴리스·활성 포인터·복구 가능한
                                보관 항목이 남아 있을 때만 유지되며, 이 키의 마지막 산출물이면
                                함께 정리됩니다. 삭제가 끝나면 같은 소유자가 동일 버전을 다시
                                제출할 수 있습니다.
                            </p>

                            <label class="w-label" for="layout-purge-reason">영구 삭제 사유</label>
                            <textarea id="layout-purge-reason"
                                      class="w-input"
                                      rows="3"
                                      maxlength="300"
                                      disabled="@(_layoutPurgeConfirmationStep == 2)"
                                      placeholder="감사 로그와 최소 소유권 기록에 남길 사유를 입력합니다."
                                      @bind="_layoutPurgeReason"
                                      @bind:event="oninput"></textarea>

                            <label class="w-label" for="layout-purge-phrase">
                                확인 문구를 그대로 입력:
                                <span class="w-sa-slug">@PurgeConfirmationPhrase(purgeArchive)</span>
                            </label>
                            <input id="layout-purge-phrase"
                                   class="w-input"
                                   type="text"
                                   autocomplete="off"
                                   disabled="@(_layoutPurgeConfirmationStep == 2)"
                                   @bind="_layoutPurgePhrase"
                                   @bind:event="oninput" />

                            @if (_layoutPurgeConfirmationStep == 1)
                            {
                                <div class="wedding-admin-quick-actions">
                                    <button class="wedding-admin-action-button is-danger"
                                            type="button"
                                            disabled="@(_isLayoutWorkflowBusy
                                                || string.IsNullOrWhiteSpace(_layoutPurgeReason)
                                                || !string.Equals(
                                                    _layoutPurgePhrase,
                                                    PurgeConfirmationPhrase(purgeArchive),
                                                    StringComparison.Ordinal))"
                                            @onclick="() => AdvanceArchivedLayoutPurgeConfirmation(purgeArchive)">
                                        1단계 확인
                                    </button>
                                    <button class="wedding-admin-action-button"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="CancelArchivedLayoutPurge">
                                        취소
                                    </button>
                                </div>
                            }
                            else if (_layoutPurgeConfirmationStep == 2)
                            {
                                <label class="wedding-admin-checkline">
                                    <input type="checkbox"
                                           @bind="_layoutPurgeIrreversibleConfirmed" />
                                    <span>원본 payload를 복구할 수 없다는 점과 사용자 참조 검사를 확인했습니다.</span>
                                </label>
                                <div class="wedding-admin-quick-actions">
                                    <button class="wedding-admin-action-button is-danger"
                                            type="button"
                                            disabled="@(_isLayoutWorkflowBusy || !_layoutPurgeIrreversibleConfirmed)"
                                            @onclick="() => PurgeArchivedLayoutAsync(purgeArchive)">
                                        @(_isLayoutWorkflowBusy
                                            ? "영구 삭제 중..."
                                            : "2단계 확인 · 영구 삭제")
                                    </button>
                                    <button class="wedding-admin-action-button"
                                            type="button"
                                            disabled="@_isLayoutWorkflowBusy"
                                            @onclick="CancelArchivedLayoutPurge">
                                        취소
                                    </button>
                                </div>
                            }
                        </section>
                    }
                </section>

                <section class="wedding-admin-card wedding-admin-table-card" aria-labelledby="layout-release-title">
                    <div class="wedding-admin-table-card__header">
                        <div>
                            <h2 id="layout-release-title">
                                @Text["admin.super.layout.history"]
                                <span>@(WeddingLayoutCatalog.Instance.Releases.Count + publishedLayoutPackages.Count)</span>
                            </h2>
                            <p>@Text["admin.super.layout.history.desc"]</p>
                        </div>
                    </div>

                    <div class="wedding-admin-table-wrap">
                        <table class="wedding-admin-table">
                            <thead>
                                <tr>
                                    <th>@Text["admin.super.layout.name"]</th>
                                    <th>@Text["admin.super.layout.version"]</th>
                                    <th>@Text["admin.super.layout.status"]</th>
                                    <th>@Text["admin.super.table.tier"]</th>
                                    <th>@Text["admin.super.layout.source"]</th>
                                    <th>@Text["admin.super.layout.approval"]</th>
                                    <th>@Text["admin.super.layout.sections"]</th>
                                    <th>@Text["admin.super.table.action"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var descriptor in layoutCatalog.Descriptors
                                    .Where(x => x.IsBuiltIn)
                                    .OrderBy(x => x.Label, StringComparer.OrdinalIgnoreCase))
                                {
                                    @foreach (var release in layoutCatalog.Releases
                                        .Where(x => string.Equals(x.LayoutKey, descriptor.Key, StringComparison.OrdinalIgnoreCase))
                                        .OrderByDescending(x => string.Equals(x.Version, descriptor.CurrentVersion, StringComparison.Ordinal))
                                        .ThenByDescending(x => x.Version, StringComparer.OrdinalIgnoreCase))
                                    {
                                        var isCurrent = string.Equals(
                                            release.Version,
                                            descriptor.CurrentVersion,
                                            StringComparison.Ordinal);
                                        <tr>
                                            <td>
                                                <strong>@LayoutLabel(descriptor.Key, descriptor.Label)</strong>
                                                <small style="display:block">@release.LayoutKey</small>
                                            </td>
                                            <td><span class="w-sa-slug">v@(release.Version)</span></td>
                                            <td>
                                                <span class="wedding-admin-badge @(isCurrent ? "is-success" : "is-muted")">
                                                    @(isCurrent ? Text["admin.super.layout.current"] : Text["admin.super.layout.archived"])
                                                </span>
                                            </td>
                                            <td>
                                                <span class="wedding-admin-badge @(descriptor.Tier == WeddingLayoutTier.Premium ? "is-gold" : "is-muted")">
                                                    @TierLabel(descriptor.Tier)
                                                </span>
                                                <small style="display:block">@Text["admin.super.layout.policy.protected"]</small>
                                            </td>
                                            <td>@SourceLabel(descriptor)</td>
                                            <td><span>@Text["admin.super.layout.base.release"]</span></td>
                                            <td>@string.Format(Text["admin.super.layout.count"], release.SupportedSections.Count)</td>
                                            <td><span class="wedding-admin-badge is-muted">@Text["admin.super.layout.protected"]</span></td>
                                        </tr>
                                    }
                                }

                                @foreach (var releaseGroup in publishedLayoutPackages.Values
                                    .GroupBy(x => x.Manifest.Key, StringComparer.OrdinalIgnoreCase)
                                    .OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
                                {
                                    var activeDescriptor = layoutCatalog.FindDescriptor(releaseGroup.Key);
                                    @foreach (var publishedPackage in releaseGroup
                                        .OrderByDescending(x => string.Equals(
                                            x.Manifest.Version,
                                            activeDescriptor?.CurrentVersion,
                                            StringComparison.Ordinal))
                                        .ThenByDescending(x => x.Manifest.Version, StringComparer.OrdinalIgnoreCase))
                                    {
                                        var releasePolicy = FindLayoutDefinitionPolicy(publishedPackage.Manifest.Key);
                                        var isCurrent = string.Equals(
                                            publishedPackage.Manifest.Version,
                                            activeDescriptor?.CurrentVersion,
                                            StringComparison.Ordinal);
                                        var releaseId = publishedPackage.ReleaseId;
                                        var isRollback = activeDescriptor is not null
                                            && IsOlderLayoutVersion(
                                                publishedPackage.Manifest.Version,
                                                activeDescriptor.CurrentVersion);
                                        <tr>
                                            <td>
                                                <strong>@publishedPackage.Manifest.Label</strong>
                                                <small style="display:block">@publishedPackage.Manifest.Key</small>
                                            </td>
                                            <td><span class="w-sa-slug">v@(publishedPackage.Manifest.Version)</span></td>
                                            <td>
                                                <span class="wedding-admin-badge @(isCurrent ? "is-success" : "is-muted")">
                                                    @(isCurrent
                                                        ? Text["admin.super.layout.current"]
                                                        : activeDescriptor is null
                                                            ? Text["admin.super.layout.approved.inactive"]
                                                            : Text["admin.super.layout.archived"])
                                                </span>
                                            </td>
                                            <td>
                                                @if (releasePolicy is { } classifiedReleasePolicy)
                                                {
                                                    <span class="wedding-admin-badge @(classifiedReleasePolicy.Tier == LayoutTier.Premium ? "is-gold" : "is-muted")">
                                                        @TierLabel(classifiedReleasePolicy.Tier)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="wedding-admin-badge is-danger">@Text["admin.super.layout.unclassified"]</span>
                                                }
                                            </td>
                                            <td>@Text["admin.super.source.uploaded"]</td>
                                            <td>
                                                <span>@publishedPackage.Approval.ApprovedBy</span>
                                                <small style="display:block">
                                                    @publishedPackage.Approval.ApprovedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                </small>
                                                <small style="display:block">@publishedPackage.Approval.OwnerTenantSlug</small>
                                            </td>
                                            <td>@string.Format(Text["admin.super.layout.count"], publishedPackage.Definition.SectionOrder.Count)</td>
                                            <td>
                                                @if (isCurrent)
                                                {
                                                    <span class="wedding-admin-badge is-success">@Text["admin.super.layout.in.service"]</span>
                                                }
                                                else
                                                {
                                                    <button class="wedding-admin-action-button is-compact"
                                                            type="button"
                                                            disabled="@_isLayoutWorkflowBusy"
                                                            @onclick="() => BeginLayoutReleaseChange(releaseId, isRollback)">
                                                        @(isRollback ? "롤백 준비" : "활성화 준비")
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (_confirmLayoutReleaseId is { } targetReleaseId
                        && FindPublishedPackage(targetReleaseId) is { } targetPackage)
                    {
                        var activeDescriptor = layoutCatalog.FindDescriptor(targetReleaseId.LayoutKey);
                        var isRollback = activeDescriptor is not null
                            && IsOlderLayoutVersion(targetReleaseId.Version, activeDescriptor.CurrentVersion);
                        <section class="wedding-admin-panel-section">
                            <h3>
                                @(isRollback ? "레이아웃 롤백" : "레이아웃 활성화"):
                                @targetPackage.Manifest.Label v@(targetReleaseId.Version)
                            </h3>
                            <p class="w-hint">
                                현재 버전:
                                @(activeDescriptor is null ? "없음" : $"v{activeDescriptor.CurrentVersion}")
                                → 대상 버전: v@(targetReleaseId.Version)
                            </p>
                            <label class="w-label" for="layout-release-reason">변경 사유</label>
                            <input id="layout-release-reason"
                                   class="w-input"
                                   maxlength="300"
                                   @bind="_layoutReleaseChangeReason" />
                            <div class="wedding-admin-quick-actions">
                                <button class="wedding-admin-action-button @(isRollback ? "is-danger" : "is-primary")"
                                        type="button"
                                        disabled="@_isLayoutWorkflowBusy"
                                        @onclick="() => ChangeActiveLayoutReleaseAsync(targetReleaseId)">
                                    @(isRollback ? "이 버전으로 롤백 확인" : "이 버전 활성화 확인")
                                </button>
                                <button class="wedding-admin-action-button"
                                        type="button"
                                        disabled="@_isLayoutWorkflowBusy"
                                        @onclick="CancelLayoutWorkflowConfirmation">
                                    취소
                                </button>
                            </div>
                        </section>
                    }

                    <p class="w-hint">@Text["admin.super.layout.footer.hint"]</p>
                </section>
            }

            @if (ShowCreateCard || ShowSettingsCard)
            {
                <section class="wedding-admin-card-grid @(ShowCreateCard && ShowSettingsCard ? "" : "is-single")">
                @if (ShowCreateCard)
                {
                    <article class="wedding-admin-card wedding-admin-card--create">
                    <div class="wedding-admin-card__header">
                        <div>
                            <h2>@Text["admin.super.create"]</h2>
                            <p>@Text["admin.super.create.desc"]</p>
                        </div>
                    </div>

                    <div class="w-sa-form wedding-admin-form">
                        <div class="w-sa-field">
                            <label class="w-label">@Text["admin.super.slug"]</label>
                            <input class="w-input" placeholder="gildong-sunja"
                                   @bind="Vm.NewSlug" />
                            @if (!string.IsNullOrWhiteSpace(Vm.NewSlug))
                            {
                                <span class="w-sa-preview">/@Vm.NewSlug.Trim().ToLowerInvariant()</span>
                            }
                        </div>

                        <div class="w-sa-field">
                            <label class="w-label">@Text["field.couple"]</label>
                            <input class="w-input" placeholder="@Text["field.couple.placeholder"]"
                                   @bind="Vm.NewCoupleName" />
                        </div>

                        <div class="w-sa-field">
                            <label class="w-label">@Text["field.date"]</label>
                            <input class="w-input" type="date" @bind="Vm.NewWeddingDate" />
                        </div>

                        <div class="w-sa-field">
                            <label class="w-label">@Text["admin.super.couple.password"]</label>
                            <input class="w-input" type="password" placeholder="@Text["field.password.hint"]"
                                   @bind="Vm.NewPassword" />
                        </div>

                        <button class="w-btn w-btn--primary w-sa-create-btn" @onclick="OnCreate">
                            @Text["create.button"]
                        </button>
                    </div>
                    </article>
                }

                @if (ShowSettingsCard)
                {
                    <article class="wedding-admin-card wedding-admin-card--settings">
                    <div class="wedding-admin-card__header">
                        <div>
                            <h2>@Text["admin.super.media.policy"]</h2>
                            <p>@Text["admin.super.media.policy.desc"]</p>
                        </div>
                    </div>

                    <div class="wedding-admin-policy-grid">
                        <section>
                            <h3>@Text["admin.super.free.tier"]</h3>
                            <label class="w-label">@Text["admin.super.image.count"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.FreeTier.ImageMaxCount" />
                            <label class="w-label">@Text["admin.super.image.storage"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.FreeTier.ImageOptimizedMaxStorageMb" />
                            <label class="w-label">@Text["admin.super.video.file"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.FreeTier.VideoMaxFileSizeMb" />
                            <label class="w-label">@Text["admin.super.video.count"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.FreeTier.VideoMaxCount" />
                            <label class="wedding-admin-checkline">
                                <input type="checkbox" @bind="Vm.MediaPolicy.FreeTier.KeepOriginalImages" />
                                <span>@Text["admin.super.keep.images"]</span>
                            </label>
                            <label class="wedding-admin-checkline">
                                <input type="checkbox" @bind="Vm.MediaPolicy.FreeTier.KeepOriginalVideos" />
                                <span>@Text["admin.super.keep.videos"]</span>
                            </label>
                        </section>

                        <section>
                            <h3>@Text["admin.super.premium.tier"]</h3>
                            <label class="w-label">@Text["admin.super.image.count"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.PremiumTier.ImageMaxCount" />
                            <label class="w-label">@Text["admin.super.image.storage"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.PremiumTier.ImageOptimizedMaxStorageMb" />
                            <label class="w-label">@Text["admin.super.original.storage"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.PremiumTier.ImageOriginalMaxStorageMb" />
                            <label class="w-label">@Text["admin.super.video.file"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.PremiumTier.VideoMaxFileSizeMb" />
                            <label class="w-label">@Text["admin.super.video.count"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.PremiumTier.VideoMaxCount" />
                            <label class="wedding-admin-checkline">
                                <input type="checkbox" @bind="Vm.MediaPolicy.PremiumTier.KeepOriginalImages" />
                                <span>@Text["admin.super.keep.images"]</span>
                            </label>
                            <label class="wedding-admin-checkline">
                                <input type="checkbox" @bind="Vm.MediaPolicy.PremiumTier.KeepOriginalVideos" />
                                <span>@Text["admin.super.keep.videos"]</span>
                            </label>
                        </section>

                        <section>
                            <h3>@Text["admin.super.image.processing"]</h3>
                            <label class="w-label">@Text["admin.super.image.resolution"]</label>
                            <input class="w-input" type="number" min="320" @bind="Vm.MediaPolicy.FreeTier.ImageMaxLongSidePx" />
                            <label class="w-label">@Text["admin.super.image.format"]</label>
                            <select class="w-input" @bind="Vm.MediaPolicy.FreeTier.ImageOutputFormat">
                                <option value="WebP">WebP</option>
                                <option value="Jpeg">JPEG</option>
                                <option value="Png">PNG</option>
                            </select>
                            <label class="w-label">@Text["admin.super.image.quality"]</label>
                            <input class="w-input" type="number" min="1" max="100" @bind="Vm.MediaPolicy.FreeTier.ImageQuality" />
                            <label class="wedding-admin-checkline">
                                <input type="checkbox" @bind="Vm.MediaPolicy.FreeTier.StripExif" />
                                <span>@Text["admin.super.image.exif"]</span>
                            </label>
                            <p class="w-hint">@Text["admin.super.processing.default.hint"]</p>
                        </section>

                        <section>
                            <h3>@Text["admin.super.video.processing"]</h3>
                            <label class="w-label">@Text["admin.super.free.tier"] · @Text["admin.super.video.storage"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.FreeTier.VideoMaxStorageMb" />
                            <label class="w-label">@Text["admin.super.premium.tier"] · @Text["admin.super.video.storage"]</label>
                            <input class="w-input" type="number" min="0" @bind="Vm.MediaPolicy.PremiumTier.VideoMaxStorageMb" />
                            <p class="w-hint">@Text["admin.super.override.hint"]</p>
                        </section>
                    </div>

                    <button class="w-btn w-btn--primary" @onclick="OnSaveGlobalSettings">@Text["admin.super.save.all"]</button>
                    </article>
                }
                </section>
            }

            @if (ShowTenantTable)
            {
            <section class="wedding-admin-card wedding-admin-table-card">
                <div class="wedding-admin-table-card__header">
                    <div>
                        <h2>@TableTitle <span>@filteredTenants.Length</span></h2>
                        <p>@TableDescription</p>
                    </div>

                    <div class="wedding-admin-table-tools">
                        <select class="wedding-admin-select" value="@_statusFilter" @onchange="OnFilterChange">
                            <option value="all">@Text["admin.super.all"]</option>
                            <option value="published">@Text["admin.super.visible"]</option>
                            <option value="hidden">@Text["admin.super.hidden"]</option>
                            <option value="premium">@Text["admin.super.premium.plan"]</option>
                            @if (IsMediaMenu)
                            {
                                <option value="image">@Text["admin.super.filter.images"]</option>
                                <option value="video">@Text["admin.super.filter.videos"]</option>
                                <option value="free">@Text["admin.super.filter.free"]</option>
                                <option value="migration-completed">@Text["admin.super.filter.optimized"]</option>
                                <option value="migration-pending">@Text["admin.super.filter.pending"]</option>
                                <option value="migration-failed">@Text["admin.super.filter.failed"]</option>
                                <option value="keep-original">@Text["admin.super.filter.originals"]</option>
                            }
                        </select>
                        <button class="wedding-admin-action-button" type="button" @onclick="OnRefresh">@Text["admin.refresh"]</button>
                    </div>
                </div>

                @if (filteredTenants.Length == 0)
                {
                    <p class="w-sa-empty">@EmptyText</p>
                }
                else
                {
                    <div class="wedding-admin-table-wrap">
                        <table class="wedding-admin-table">
                            <thead>
                                <tr>
                                    <th>@Text["admin.super.table.slug"]</th>
                                    <th>@Text["admin.super.table.couple"]</th>
                                    <th>@Text["admin.super.table.date"]</th>
                                    <th>@Text["admin.super.table.home"]</th>
                                    @if (IsMediaMenu)
                                    {
                                        <th>@Text["admin.super.table.tier"]</th>
                                        <th>@Text["admin.super.table.images"]</th>
                                        <th>@Text["admin.super.table.optimized"]</th>
                                        <th>@Text["admin.super.table.original"]</th>
                                        <th>@Text["admin.super.table.videos"]</th>
                                        <th>@Text["admin.super.table.total"]</th>
                                        <th>@Text["admin.super.table.migration"]</th>
                                    }
                                    else
                                    {
                                        <th>@Text["admin.super.table.premium.layouts"]</th>
                                        <th>@Text["admin.super.table.theme"]</th>
                                        <th>@Text["admin.super.table.storage"]</th>
                                        <th>@Text["admin.super.video.count"]</th>
                                    }
                                    <th>@Text["admin.super.table.updated"]</th>
                                    <th>@Text["admin.super.table.link"]</th>
                                    <th>@Text["admin.super.table.action"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in pagedTenants)
                                {
                                    <tr class="@(IsSelected(t) ? "is-selected" : "")" @onclick="() => SelectTenant(t)">
                                        <td><span class="w-sa-slug">@t.Slug</span></td>
                                        <td>@t.CoupleName</td>
                                        <td>@t.WeddingDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <span class="wedding-admin-badge @(t.ShowOnHome ? "is-success" : "is-muted")">
                                                @(t.ShowOnHome ? Text["admin.super.visible"] : Text["admin.super.hidden"])
                                            </span>
                                        </td>
                                        @if (IsMediaMenu)
                                        {
                                            var usage = GetUsage(t);
                                            <td><span class="wedding-admin-badge @(t.HasPremiumPlan ? "is-gold" : "is-muted")">@(t.HasPremiumPlan ? "Premium" : "Free")</span></td>
                                            <td>@usage.ImageCount</td>
                                            <td>@FormatBytes(usage.OptimizedImageBytes)</td>
                                            <td>@FormatBytes(usage.OriginalImageBytes)</td>
                                            <td>@usage.VideoCount / @FormatBytes(usage.VideoBytes)</td>
                                            <td>@FormatBytes(usage.TotalBytes)</td>
                                            <td><span class="wedding-admin-badge @MigrationBadgeClass(usage.MigrationState)">@MigrationLabel(usage.MigrationState)</span></td>
                                            <td>@(usage.LastModified?.ToString("yyyy-MM-dd") ?? t.CreatedAt.ToString("yyyy-MM-dd"))</td>
                                        }
                                        else
                                        {
                                            <td>@RenderLayoutBadges(t)</td>
                                            <td>@RenderThemeBadges(t)</td>
                                            <td>@EstimateTenantStorage(t)</td>
                                            <td>@t.VideoFileNames.Count</td>
                                            <td>@t.CreatedAt.ToString("yyyy-MM-dd")</td>
                                        }
                                        <td>
                                            <a class="wedding-admin-icon-link" href="@PublicPath(t)" target="_blank" @onclick:stopPropagation="true">@Text["admin.super.open"]</a>
                                        </td>
                                        <td>
                                            <button class="wedding-admin-action-button is-compact" type="button" @onclick="() => SelectTenant(t)" @onclick:stopPropagation="true">
                                                @Text["admin.super.details"]
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="wedding-admin-pagination">
                        <span>@currentPage / @totalPages</span>
                        <div>
                            <button class="wedding-admin-action-button is-compact" type="button" disabled="@(currentPage <= 1)" @onclick="PrevPage">@Text["admin.super.previous"]</button>
                            <button class="wedding-admin-action-button is-compact" type="button" disabled="@(currentPage >= totalPages)" @onclick="NextPage">@Text["admin.super.next"]</button>
                        </div>
                        <label>
                            @Text["admin.super.per.page"]
                            <select class="wedding-admin-select" value="@_pageSize" @onchange="OnPageSizeChange">
                                <option value="10">10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                        </label>
                    </div>
                }
            </section>
            }
        </main>

        <aside class="wedding-admin-detail-panel" hidden="@ShowLayoutCatalog">
            @if (SelectedTenant is { } selected)
            {
                <div class="wedding-admin-detail-panel__header">
                    <div>
                        <span>@Text["admin.super.selected"]</span>
                        <h2>@selected.CoupleName</h2>
                        <p>@selected.Slug</p>
                    </div>
                    <button class="wedding-admin-icon-button" type="button" @onclick="ClearSelection" title="@Text["admin.super.clear.selection"]">x</button>
                </div>

                var mediaOverride = EnsureMediaOverride(selected);
                var selectedUsage = GetUsage(selected);

                <dl class="wedding-admin-detail-list">
                    <div>
                        <dt>@Text["admin.super.table.date"]</dt>
                        <dd>@selected.WeddingDate.ToString("yyyy-MM-dd")</dd>
                    </div>
                    <div>
                        <dt>@Text["admin.super.published"]</dt>
                        <dd><span class="wedding-admin-badge @(selected.IsPublished ? "is-success" : "is-muted")">@(selected.IsPublished ? Text["admin.super.published"] : Text["admin.super.private"])</span></dd>
                    </div>
                    <div>
                        <dt>@Text["admin.super.table.home"]</dt>
                        <dd>
                            <label class="wedding-admin-switch">
                                <input type="checkbox" checked="@selected.ShowOnHome" @onchange="e => OnShowOnHomeChange(selected, e)" />
                                <span>@(selected.ShowOnHome ? Text["admin.super.visible"] : Text["admin.super.hidden"])</span>
                            </label>
                        </dd>
                    </div>
                    <div>
                        <dt>@Text["admin.super.pin.order"]</dt>
                        <dd>
                            <input type="number" class="wedding-admin-number-input" min="0" max="99"
                                   value="@selected.PinOrder"
                                   @onchange="e => OnPinOrderChange(selected, e)" />
                        </dd>
                    </div>
                </dl>

                <section class="wedding-admin-panel-section">
                    <h3>@Text["admin.super.premium.plan"]</h3>
                    <label class="wedding-admin-switch">
                        <input type="checkbox"
                               checked="@selected.HasPremiumPlan"
                               @onchange="e => OnPremiumPlanChange(selected, e)" />
                        <span>@(selected.HasPremiumPlan ? Text["admin.super.active"] : Text["admin.super.inactive"])</span>
                    </label>
                    <p class="w-hint">@Text["admin.super.premium.hint"]</p>
                </section>

                <section class="wedding-admin-panel-section">
                    <h3>@Text["admin.super.account.media"]</h3>
                    <div class="wedding-admin-usage-mini">
                        <span>@Text["admin.super.table.images"] @selectedUsage.ImageCount</span>
                        <span>@Text["admin.super.table.optimized"] @FormatBytes(selectedUsage.OptimizedImageBytes)</span>
                        <span>@Text["admin.super.table.original"] @FormatBytes(selectedUsage.OriginalImageBytes)</span>
                        <span>@Text["admin.super.table.videos"] @selectedUsage.VideoCount / @FormatBytes(selectedUsage.VideoBytes)</span>
                    </div>

                    <label class="w-label">@Text["admin.super.image.count"]</label>
                    <input class="w-input" type="number" min="0" placeholder="@Text["admin.super.tier.default"]"
                           @bind="mediaOverride.ImageMaxCount" />

                    <label class="w-label">@Text["admin.super.image.storage"]</label>
                    <input class="w-input" type="number" min="0" placeholder="@Text["admin.super.tier.default"]"
                           @bind="mediaOverride.ImageOptimizedMaxStorageMb" />

                    <label class="w-label">@Text["admin.super.original.storage"]</label>
                    <input class="w-input" type="number" min="0" placeholder="@Text["admin.super.tier.default"]"
                           @bind="mediaOverride.ImageOriginalMaxStorageMb" />

                    <label class="w-label">@Text["admin.super.video.file"]</label>
                    <input class="w-input" type="number" min="0" placeholder="@Text["admin.super.tier.default"]"
                           @bind="mediaOverride.VideoMaxFileSizeMb" />

                    <label class="w-label">@Text["admin.super.video.count"]</label>
                    <input class="w-input" type="number" min="0" placeholder="@Text["admin.super.tier.default"]"
                           @bind="mediaOverride.VideoMaxCount" />

                    <label class="w-label">@Text["admin.super.video.storage"]</label>
                    <input class="w-input" type="number" min="0" placeholder="@Text["admin.super.tier.default"]"
                           @bind="mediaOverride.VideoMaxStorageMb" />

                    <label class="wedding-admin-checkline">
                        <input type="checkbox"
                               checked="@(mediaOverride.KeepOriginalImages == true)"
                               @onchange="e => mediaOverride.KeepOriginalImages = ReadBool(e)" />
                        <span>@Text["admin.super.keep.images"]</span>
                    </label>
                    <label class="wedding-admin-checkline">
                        <input type="checkbox"
                               checked="@(mediaOverride.KeepOriginalVideos == true)"
                               @onchange="e => mediaOverride.KeepOriginalVideos = ReadBool(e)" />
                        <span>@Text["admin.super.keep.videos"]</span>
                    </label>

                    <button class="wedding-admin-action-button is-primary" type="button" @onclick="() => OnSaveMediaOverride(selected)">@Text["admin.super.media.save"]</button>
                    <button class="wedding-admin-action-button" type="button" @onclick="() => OnResetMediaOverride(selected)">@Text["admin.super.override.reset"]</button>
                </section>

                <section class="wedding-admin-panel-section">
                    <h3>@Text["admin.super.migration"]</h3>
                    <div class="wedding-admin-migration-state">
                        <span class="wedding-admin-badge @MigrationBadgeClass(selectedUsage.MigrationState)">@MigrationLabel(selectedUsage.MigrationState)</span>
                        <small>@(Vm.MigrationStatuses.TryGetValue(selected.Slug, out var migration) ? MigrationLabel(migration.State) : Text["admin.super.no.migration"])</small>
                    </div>
                    <button class="wedding-admin-action-button" type="button" @onclick="() => OnQueueMigration(selected)">@Text["admin.super.migration.run"]</button>
                    <button class="wedding-admin-action-button" type="button" @onclick="() => OnRetryMigration(selected)">@Text["admin.super.migration.retry"]</button>
                </section>

                <section class="wedding-admin-panel-section">
                    <h3>@Text["admin.super.theme.policy"]</h3>
                    <p class="w-hint">@Text["admin.super.theme.policy.hint"]</p>
                </section>

                <section class="wedding-admin-panel-section">
                    <h3>@Text["admin.super.quick.actions"]</h3>
                    <div class="wedding-admin-quick-actions">
                        <a class="wedding-admin-action-button" href="@PublicPath(selected)" target="_blank">@Text["admin.super.preview"]</a>
                        <button class="wedding-admin-action-button" type="button" @onclick="() => CopyPublicLink(selected)">@Text["admin.super.copy.link"]</button>
                        <a class="wedding-admin-action-button" href="/@selected.Slug/admin" target="_blank" rel="noopener">@Text["admin.super.manage.account"]</a>
                        @if (_confirmSlug == selected.Slug)
                        {
                            <button class="wedding-admin-action-button is-danger" type="button" @onclick="() => OnDeleteConfirmed(selected.Slug)">@Text["admin.super.confirm.delete"]</button>
                            <button class="wedding-admin-action-button" type="button" @onclick="() => _confirmSlug = null">@Text["admin.cancel"]</button>
                        }
                        else
                        {
                            <button class="wedding-admin-action-button is-danger" type="button" @onclick="() => _confirmSlug = selected.Slug">@Text["admin.super.delete.account"]</button>
                        }
                    </div>
                </section>
            }
            else
            {
                <div class="wedding-admin-detail-empty">
                    <strong>@Text["admin.super.no.selection"]</strong>
                    <span>@Text["admin.super.selection.help"]</span>
                </div>
            }
        </aside>
    }
</div>

@code {
    private string? _confirmSlug;
    private string? _selectedSlug;
    private string _searchText = "";
    private string _statusFilter = "all";
    private string _activeMenu = "dashboard";
    private int _pageSize = 10;
    private int _currentPage = 1;
    private bool _isLayoutCatalogReloading;
    private bool _layoutCatalogReloadSucceeded = true;
    private string? _layoutCatalogStatus;
    private DateTimeOffset? _layoutCatalogChangedAt;
    private string _layoutUploadTenantSlug = "";
    private int _layoutUploadInputVersion;
    private bool _layoutUploadSucceeded = true;
    private string? _layoutUploadStatus;
    private IReadOnlyList<WeddingLayoutSubmissionRecord> _layoutSubmissions = [];
    private string _layoutSubmissionFilter = "pending";
    private IReadOnlyList<WeddingLayoutArchiveRecord> _layoutArchives = [];
    private IReadOnlyList<LayoutDefinitionPolicy> _layoutDefinitionPolicies = [];
    private LayoutPackage? _layoutReviewPackage;
    private string? _selectedLayoutSubmissionId;
    private string? _confirmLayoutSubmissionAction;
    private WeddingLayoutReleaseId? _confirmLayoutReleaseId;
    private string? _layoutSubmissionArchiveId;
    private string? _layoutArchivePurgeSubmissionId;
    private string? _layoutDefinitionPolicyEditorKey;
    private string? _layoutDefinitionPolicyConfirmationKey;
    private string _layoutRejectReason = "";
    private string _layoutArchiveReason = "";
    private string _layoutPurgeReason = "";
    private string _layoutPurgePhrase = "";
    private string _layoutReleaseChangeReason = "";
    private string _layoutDefinitionPolicyReason = "";
    private int _layoutArchiveConfirmationStep;
    private int _layoutPurgeConfirmationStep;
    private int _layoutDefinitionPolicyConfirmationStep;
    private LayoutTier _layoutDefinitionPolicyTier = LayoutTier.Free;
    private bool _approveAndActivate = true;
    private bool _layoutPurgeIrreversibleConfirmed;
    private bool _isLayoutWorkflowBusy;
    private bool _layoutWorkflowSucceeded = true;
    private string? _layoutWorkflowStatus;

    private const string SuperAdminWorkflowActor = "SuperAdmin";

    private IReadOnlyList<WeddingLayoutOption> PremiumLayouts =>
        LayoutRegistry.Current.Layouts
            .Where(x => x.Tier == WeddingLayoutTier.Premium)
            .OrderBy(x => x.Label, StringComparer.CurrentCulture)
            .ToArray();
    private static IReadOnlyList<WeddingThemeOption> PremiumThemes =>
        WeddingThemeCatalog.Options.Where(x => x.Tier == WeddingThemeTier.Premium).ToArray();

    private TenantConfig? SelectedTenant =>
        !string.IsNullOrWhiteSpace(_selectedSlug)
            ? Vm.Tenants.FirstOrDefault(x => string.Equals(x.Slug, _selectedSlug, StringComparison.OrdinalIgnoreCase))
            : Vm.Tenants.FirstOrDefault();

    private WeddingLayoutSubmissionRecord? SelectedLayoutSubmission =>
        !string.IsNullOrWhiteSpace(_selectedLayoutSubmissionId)
            ? _layoutSubmissions.FirstOrDefault(x => string.Equals(
                x.SubmissionId,
                _selectedLayoutSubmissionId,
                StringComparison.Ordinal))
            : null;

    private WeddingLayoutSubmissionRecord? LayoutSubmissionToArchive =>
        !string.IsNullOrWhiteSpace(_layoutSubmissionArchiveId)
            ? _layoutSubmissions.FirstOrDefault(x => string.Equals(
                x.SubmissionId,
                _layoutSubmissionArchiveId,
                StringComparison.Ordinal))
            : null;

    private WeddingLayoutArchiveRecord? LayoutArchiveToPurge =>
        !string.IsNullOrWhiteSpace(_layoutArchivePurgeSubmissionId)
            ? _layoutArchives.FirstOrDefault(x => string.Equals(
                x.SubmissionId,
                _layoutArchivePurgeSubmissionId,
                StringComparison.Ordinal))
            : null;

    private IReadOnlyList<WeddingLayoutSubmissionRecord> FilteredLayoutSubmissions =>
        _layoutSubmissionFilter switch
        {
            "completed" => _layoutSubmissions
                .Where(x => x.Status != WeddingLayoutSubmissionStatus.Pending)
                .ToArray(),
            "all" => _layoutSubmissions,
            _ => _layoutSubmissions
                .Where(x => x.Status == WeddingLayoutSubmissionStatus.Pending)
                .ToArray(),
        };

    private IReadOnlyList<string> UnclassifiedLayoutKeys =>
        _layoutSubmissions
            .Select(x => x.LayoutKey)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(key =>
                WeddingLayoutCatalog.Instance.FindDescriptor(key) is null
                && FindLayoutDefinitionPolicy(key) is null)
            .OrderBy(key => key, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private LayoutDefinitionPolicy? FindLayoutDefinitionPolicy(string layoutKey) =>
        _layoutDefinitionPolicies.FirstOrDefault(x => string.Equals(
            x.LayoutKey,
            layoutKey,
            StringComparison.OrdinalIgnoreCase));

    private bool ShowStats => _activeMenu == "dashboard";
    private bool IsMediaMenu => _activeMenu == "media";
    private bool ShowLayoutCatalog => _activeMenu == "layouts";
    private bool ShowCreateCard => _activeMenu == "invite";
    private bool ShowSettingsCard => _activeMenu is "media" or "settings";
    private bool ShowTenantTable => _activeMenu != "settings" && _activeMenu != "layouts";
    private string ActiveTitle => _activeMenu switch
    {
        "invite" => Text["admin.invitations"],
        "account" => Text["admin.accounts"],
        "media" => Text["admin.media"],
        "layouts" => Text["admin.layouts"],
        "settings" => Text["admin.settings"],
        _ => Text["admin.integrated"]
    };
    private string ActiveDescription => _activeMenu switch
    {
        "invite" => Text["admin.super.invite.desc"],
        "account" => Text["admin.super.account.desc"],
        "media" => Text["admin.super.media.desc"],
        "layouts" => Text["admin.super.layouts.desc"],
        "settings" => Text["admin.super.settings.desc"],
        _ => Text["admin.integrated.desc"]
    };
    private string TableTitle => _activeMenu switch
    {
        "invite" => Text["admin.super.list.invites"],
        "account" => Text["admin.super.list.accounts"],
        "media" => Text["admin.super.list.media"],
        _ => Text["admin.registered.couples"]
    };
    private string TableDescription => _activeMenu switch
    {
        "media" => Text["admin.super.list.media.desc"],
        _ => Text["admin.super.list.desc"]
    };
    private string EmptyText => _activeMenu switch
    {
        "invite" => Text["admin.super.empty.invite"],
        _ => Text["admin.super.empty"]
    };

    private IEnumerable<TenantConfig> FilteredTenants
    {
        get
        {
            IEnumerable<TenantConfig> tenants = ApplyMenuFilter(Vm.Tenants);
            var query = _searchText.Trim();

            if (!string.IsNullOrWhiteSpace(query))
            {
                tenants = tenants.Where(t => MatchesSearch(t, query));
            }

            tenants = _statusFilter switch
            {
                "published" => tenants.Where(t => t.ShowOnHome),
                "hidden" => tenants.Where(t => !t.ShowOnHome),
                "premium" => tenants.Where(IsPremiumActive),
                "image" => tenants.Where(t => GetUsage(t).ImageCount > 0),
                "video" => tenants.Where(t => GetUsage(t).VideoCount > 0),
                "free" => tenants.Where(t => !t.HasPremiumPlan),
                "migration-completed" => tenants.Where(t => GetUsage(t).MigrationState == MediaMigrationState.Completed),
                "migration-pending" => tenants.Where(t => GetUsage(t).MigrationState == MediaMigrationState.Pending),
                "migration-failed" => tenants.Where(t => GetUsage(t).MigrationState == MediaMigrationState.Failed),
                "keep-original" => tenants.Where(HasOriginalRetention),
                _ => tenants
            };

            return tenants.OrderByDescending(t => t.CreatedAt).ThenBy(t => t.Slug);
        }
    }

    private int PremiumActiveCount => Vm.Tenants.Count(IsPremiumActive);
    private int MainVisibleCount => Vm.Tenants.Count(t => t.ShowOnHome);
    private int TotalPhotoCount => Vm.MediaUsage.Values.Sum(x => x.ImageCount);
    private int TotalVideoCount => Vm.MediaUsage.Values.Sum(x => x.VideoCount);
    private long TotalStorageBytes => Vm.MediaUsage.Values.Sum(x => x.TotalBytes);
    private string TotalStorageLabel => Vm.IsMediaUsageAccurate ? FormatBytes(TotalStorageBytes) : Text["admin.super.storage.quick"];
    private string AvailableStorageLabel => Vm.IsMediaUsageAccurate && GetAvailableStorageBytes() is long bytes
        ? string.Format(Text["admin.super.storage.remaining"], FormatBytes(bytes))
        : Text["admin.super.storage.refresh"];

    private bool _sessionRestoreChecked;

    protected override void OnInitialized()
    {
        LayoutRegistry.Changed += OnLayoutCatalogChanged;
        Text.Changed += OnLanguageChanged;
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionRestoreChecked)
        {
            return;
        }

        _sessionRestoreChecked = true;
        try
        {
            var token = await JS.InvokeAsync<string>("weddingInterop.getSuperAdminSessionToken");
            if (Vm.RestoreSession(token))
            {
                await Vm.LoadAsync();
                EnsureSelectedTenant();
                _ = RefreshMediaUsageInBackgroundAsync();
            }
            else if (!string.IsNullOrWhiteSpace(token))
            {
                await ClearSuperAdminTokenAsync();
            }
        }
        catch
        {
            await ClearSuperAdminTokenAsync();
        }

        StateHasChanged();
    }

    private async Task OnLogin()
    {
        _sessionRestoreChecked = true;
        if (await Vm.LoginAsync())
        {
            await StoreSuperAdminTokenAsync();
            await Vm.LoadAsync();
            EnsureSelectedTenant();
            // 대시보드에서도 실제 저장 용량이 표시되도록 백그라운드로 파일 시스템 스캔을 시작한다.
            // UI 를 막지 않고 완료 시 자동 갱신되며, 실패는 조용히 무시(빠른 집계 값 유지).
            _ = RefreshMediaUsageInBackgroundAsync();
        }
        else
        {
            await ClearSuperAdminTokenAsync();
        }
        StateHasChanged();
    }

    private async Task RefreshMediaUsageInBackgroundAsync()
    {
        try
        {
            await Vm.RefreshMediaUsageAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // 스캔 실패는 사용자에게 노출하지 않는다. 새로고침 버튼으로 재시도 가능.
        }
    }

    private async Task OnLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnLogin();
    }

    private async Task StoreSuperAdminTokenAsync()
    {
        try { await JS.InvokeVoidAsync("weddingInterop.setSuperAdminSessionToken", Vm.SuperAdminSessionToken); }
        catch { }
    }

    private async Task ClearSuperAdminTokenAsync()
    {
        try { await JS.InvokeVoidAsync("weddingInterop.setSuperAdminSessionToken", ""); }
        catch { }
    }

    private async Task OnLogout()
    {
        await ClearSuperAdminTokenAsync();
        Vm.Logout();
        _layoutUploadTenantSlug = "";
        _layoutUploadStatus = null;
        _sessionRestoreChecked = true;
        StateHasChanged();
    }

    private async Task OnCreate()
    {
        var slug = Vm.NewSlug.Trim().ToLowerInvariant();
        if (await Vm.CreateTenantAsync())
        {
            _selectedSlug = slug;
            _currentPage = 1;
            EnsureSelectedTenant();
        }
        StateHasChanged();
    }

    private async Task OnShowOnHomeChange(TenantConfig t, ChangeEventArgs e)
    {
        t.ShowOnHome = (bool)(e.Value ?? false);
        await Vm.SetDisplayAsync(t.Slug, t.ShowOnHome, t.PinOrder);
        EnsureSelectedTenant(t.Slug);
        StateHasChanged();
    }

    private async Task OnPinOrderChange(TenantConfig t, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var order))
        {
            t.PinOrder = Math.Max(0, order);
            await Vm.SetDisplayAsync(t.Slug, t.ShowOnHome, t.PinOrder);
            EnsureSelectedTenant(t.Slug);
            StateHasChanged();
        }
    }

    private async Task OnDeleteConfirmed(string slug)
    {
        _confirmSlug = null;
        await Vm.DeleteTenantAsync(slug);
        EnsureSelectedTenant();
        StateHasChanged();
    }

    private async Task OnSaveGlobalSettings()
    {
        await Vm.SaveGlobalSettingsAsync();
        StateHasChanged();
    }

    private async Task OnSaveMediaOverride(TenantConfig t)
    {
        await Vm.SaveMediaOverrideAsync(t);
        EnsureSelectedTenant(t.Slug);
        StateHasChanged();
    }

    private async Task OnResetMediaOverride(TenantConfig t)
    {
        await Vm.ResetMediaOverrideAsync(t.Slug);
        EnsureSelectedTenant(t.Slug);
        StateHasChanged();
    }

    private async Task OnQueueMigration(TenantConfig t)
    {
        await Vm.QueueImageMigrationAsync(t.Slug);
        EnsureSelectedTenant(t.Slug);
        StateHasChanged();
    }

    private async Task OnRetryMigration(TenantConfig t)
    {
        await Vm.RetryImageMigrationAsync(t.Slug);
        EnsureSelectedTenant(t.Slug);
        StateHasChanged();
    }

    private async Task OnPremiumPlanChange(TenantConfig tenant, ChangeEventArgs e)
    {
        await Vm.SetPremiumPlanAsync(tenant.Slug, ReadBool(e));
        EnsureSelectedTenant(tenant.Slug);
        StateHasChanged();
    }

    private static bool IsThemeUnlocked(TenantConfig tenant, string themeKey)
    {
        var key = WeddingThemeCatalog.NormalizeKey(themeKey);
        return tenant.UnlockedThemeKeys?.Any(x => string.Equals(WeddingThemeCatalog.NormalizeKey(x), key, StringComparison.OrdinalIgnoreCase)) == true;
    }

    private static void OnThemeUnlockChange(TenantConfig tenant, string themeKey, ChangeEventArgs e)
    {
        var key = WeddingThemeCatalog.NormalizeKey(themeKey);
        tenant.UnlockedThemeKeys ??= new();
        tenant.UnlockedThemeKeys.RemoveAll(x => string.Equals(WeddingThemeCatalog.NormalizeKey(x), key, StringComparison.OrdinalIgnoreCase));
        if (e.Value is bool enabled && enabled)
        {
            tenant.UnlockedThemeKeys.Add(key);
        }
    }

    private async Task OnSaveThemeUnlocks(TenantConfig tenant)
    {
        await Vm.SetUnlockedThemesAsync(tenant.Slug, tenant.UnlockedThemeKeys);
        EnsureSelectedTenant(tenant.Slug);
        StateHasChanged();
    }

    private async Task OnRefresh()
    {
        if (ShowLayoutCatalog)
        {
            await OnReloadLayoutCatalog();
            return;
        }

        await Vm.LoadAsync();
        EnsureSelectedTenant();
        StateHasChanged();
        // 어느 메뉴에 있든 새로고침 버튼은 실제 파일 시스템 재집계까지 유도한다.
        // 스캔은 백그라운드로 실행되어 응답성을 해치지 않고, 대시보드 카드도 갱신된다.
        _ = RefreshMediaUsageInBackgroundAsync();
    }

    private async Task OnReloadLayoutCatalog()
    {
        if (_isLayoutCatalogReloading)
        {
            return;
        }

        _isLayoutCatalogReloading = true;
        _layoutCatalogStatus = null;
        try
        {
            var result = await LayoutRegistry.ReloadAsync();
            _layoutCatalogReloadSucceeded = result.Succeeded;
            _layoutCatalogStatus = result.Succeeded
                ? result.Changed
                    ? $"✅ 새 카탈로그를 적용했습니다. 승인 릴리스 {result.PublishedReleaseCount}개가 서비스에 반영되었습니다."
                    : $"✅ 현재 카탈로그가 최신입니다. 승인 릴리스 {result.PublishedReleaseCount}개를 확인했습니다."
                : $"카탈로그를 적용하지 못했습니다. 마지막 정상 스냅샷을 유지합니다. {result.Error}";
        }
        catch (Exception ex)
        {
            _layoutCatalogReloadSucceeded = false;
            _layoutCatalogStatus = $"카탈로그를 다시 읽지 못했습니다. 마지막 정상 스냅샷을 유지합니다. {ex.Message}";
        }
        finally
        {
            _isLayoutCatalogReloading = false;
        }

        await LoadLayoutSubmissionsAsync();
    }

    private async Task LoadLayoutSubmissionsAsync()
    {
        if (_isLayoutWorkflowBusy)
        {
            return;
        }

        _isLayoutWorkflowBusy = true;
        try
        {
            await RefreshLayoutSubmissionsNoLockAsync();
            _layoutWorkflowSucceeded = true;
            _layoutWorkflowStatus = string.Format(
                Text["admin.super.layout.refresh.status"],
                _layoutSubmissions.Count(x => x.Status == WeddingLayoutSubmissionStatus.Pending),
                _layoutArchives.Count);
        }
        catch (Exception ex)
        {
            await HandleLayoutWorkflowFailureAsync(ex);
        }
        finally
        {
            _isLayoutWorkflowBusy = false;
            _layoutUploadInputVersion++;
        }
    }

    private async Task OnSuperAdminLayoutPackageUpload(InputFileChangeEventArgs args)
    {
        if (_isLayoutWorkflowBusy || args.File is null)
        {
            return;
        }

        var tenantSlug = _layoutUploadTenantSlug.Trim();
        if (!Vm.Tenants.Any(x => string.Equals(
                x.Slug,
                tenantSlug,
                StringComparison.OrdinalIgnoreCase)))
        {
            _layoutUploadSucceeded = false;
            _layoutUploadStatus = "레이아웃 소유 계정을 먼저 선택하세요.";
            return;
        }

        _isLayoutWorkflowBusy = true;
        _layoutUploadSucceeded = true;
        _layoutUploadStatus = "레이아웃 패키지를 검증하고 승인 대기열에 등록하는 중입니다.";
        try
        {
            await using var stream = args.File.OpenReadStream(384 * 1024);
            var submission = await LayoutSubmissions.SubmitAsSuperAdminAsync(
                tenantSlug,
                RequireSuperAdminSessionToken(),
                SuperAdminWorkflowActor,
                stream);

            await RefreshLayoutSubmissionsNoLockAsync();
            _layoutSubmissionFilter = "pending";
            _layoutUploadSucceeded = true;
            _layoutUploadStatus =
                $"✅ {submission.LayoutLabel} v{submission.LayoutVersion}을(를) 승인 대기열에 등록했습니다. " +
                "등급 정책을 확인한 뒤 아래 검토 목록에서 승인하세요.";
        }
        catch (Exception ex)
        {
            _layoutUploadSucceeded = false;
            _layoutUploadStatus = $"레이아웃 JSON을 추가하지 못했습니다. {ex.Message}";
            if (ex is UnauthorizedAccessException)
            {
                await HandleLayoutWorkflowFailureAsync(ex);
            }
        }
        finally
        {
            _isLayoutWorkflowBusy = false;
        }
    }

    private void OnLayoutUploadTenantChanged()
    {
        _layoutUploadStatus = null;
        _layoutUploadInputVersion++;
    }

    private async Task RefreshLayoutSubmissionsNoLockAsync()
    {
        var token = RequireSuperAdminSessionToken();
        _layoutSubmissions = await LayoutSubmissions.ListAllAsync(token);
        _layoutArchives = await LayoutSubmissions.ListArchivedAsync(token);
        _layoutDefinitionPolicies = await LayoutSubmissions.ListDefinitionPoliciesAsync(token);
        if (_selectedLayoutSubmissionId is not null
            && _layoutSubmissions.All(x => !string.Equals(
                x.SubmissionId,
                _selectedLayoutSubmissionId,
                StringComparison.Ordinal)))
        {
            ClearSelectedLayoutSubmission();
        }

        if (_layoutSubmissionArchiveId is not null
            && _layoutSubmissions.All(x => !string.Equals(
                x.SubmissionId,
                _layoutSubmissionArchiveId,
                StringComparison.Ordinal)))
        {
            CancelLayoutSubmissionArchive();
        }

        if (_layoutArchivePurgeSubmissionId is not null
            && _layoutArchives.All(x => !string.Equals(
                x.SubmissionId,
                _layoutArchivePurgeSubmissionId,
                StringComparison.Ordinal)))
        {
            CancelArchivedLayoutPurge();
        }
    }

    private async Task SelectLayoutSubmissionAsync(WeddingLayoutSubmissionRecord submission)
    {
