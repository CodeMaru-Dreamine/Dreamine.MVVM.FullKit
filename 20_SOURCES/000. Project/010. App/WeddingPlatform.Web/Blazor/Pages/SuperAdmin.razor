    private static bool IsOlderLayoutVersion(string candidate, string current)
    {
        var candidateCore = ParseLayoutVersionCore(candidate);
        var currentCore = ParseLayoutVersionCore(current);
        var coreComparison = candidateCore.CompareTo(currentCore);
        if (coreComparison != 0)
        {
            return coreComparison < 0;
        }

        var candidatePrerelease = LayoutPrerelease(candidate);
        var currentPrerelease = LayoutPrerelease(current);
        if (candidatePrerelease.Length == 0)
        {
            return false;
        }

        if (currentPrerelease.Length == 0)
        {
            return true;
        }

        return string.Compare(
            candidatePrerelease,
            currentPrerelease,
            StringComparison.OrdinalIgnoreCase) < 0;
    }

    private static Version ParseLayoutVersionCore(string version)
    {
        var core = version.Split(['-', '+'], 2)[0];
        return Version.TryParse(core, out var parsed)
            ? parsed
            : new Version(0, 0, 0);
    }

    private static string LayoutPrerelease(string version)
    {
        var dash = version.IndexOf('-');
        if (dash < 0)
        {
            return "";
        }

        var plus = version.IndexOf('+', dash + 1);
        return plus < 0
            ? version[(dash + 1)..]
            : version[(dash + 1)..plus];
    }

