@page "/{Slug}"
@layout WeddingPlatform.Blazor.Layout.WeddingLayout
@namespace WeddingPlatform.Blazor.Pages
@rendermode InteractiveServer

@using Microsoft.JSInterop
@using Wedding.Common
@using WeddingPlatform.Models
@inject WeddingInvitationViewModel Vm
@inject WeddingGuestbookViewModel VmGuest
@inject IWeddingLayoutCatalogRegistry LayoutRegistry
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@Vm.SearchTitle</PageTitle>

<HeadContent>
    <meta name="description" content="@Vm.SearchDescription" />
    <meta name="robots" content="@RobotsDirective" />
    @if (Vm.IsLoaded && !Vm.NotFound)
    {
        <link rel="canonical" href="@Vm.CanonicalUrl" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@Vm.OgTitle" />
    <meta property="og:description" content="@Vm.OgDescription" />
    @if (Vm.IsLoaded && !Vm.NotFound)
    {
        <meta property="og:url" content="@Vm.CanonicalUrl" />
    }
    @if (!string.IsNullOrWhiteSpace(Vm.OgImageUrl))
    {
        <meta property="og:image" content="@Vm.OgImageUrl" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Vm.OgTitle" />
    <meta name="twitter:description" content="@Vm.OgDescription" />
    @if (!string.IsNullOrWhiteSpace(Vm.OgImageUrl))
    {
        <meta name="twitter:image" content="@Vm.OgImageUrl" />
    }
</HeadContent>

@if (!Vm.IsLoaded)
{
    <div class="w-loading"><div class="w-spinner"></div></div>
}
else if (Vm.NotFound)
{
    <div class="w-notfound">
        <h1>404</h1>
        <p>청첩장을 찾을 수 없습니다.</p>
        <a href="/">홈으로</a>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Vm.MusicUrl))
    {
        <div class="w-music-bar @(Vm.MusicButtonPosition == "top" ? "w-music-bar--top" : "") @(Vm.UsesBottomNavigation ? "w-music-bar--with-tabs" : "") @(Vm.HasCustomMusicButtonPosition ? "w-draggable-positioned" : "") @(AdminPreview ? "w-design-draggable" : "")"
             data-drag-target="music"
             style="@Vm.MusicButtonStyle">
            <audio @ref="audioRef" src="@Vm.MusicUrl" loop preload="auto"></audio>
            <button class="w-music-btn" @onclick="ToggleMusic" title="@(isMusicPlaying ? "음악 끄기" : "음악 켜기")">
                @(isMusicPlaying ? "⏸" : "🎵")
            </button>
            <span class="w-music-label">@(isMusicPlaying ? "재생 중" : "음악 켜기")</span>
        </div>
    }

    <div class="w-runtime-layout @Vm.LayoutDescriptor.CssClass"
         style="@Vm.LayoutStyle"
         data-layout-key="@Vm.LayoutKey"
         data-layout-version="@Vm.LayoutVersion">
        @if (Vm.DynamicLayoutDefinition is { } definition)
        {
            <DynamicInvitationLayout Definition="@definition"
                                     Slug="@Slug"
                                     Vm="@Vm"
                                     VmGuest="@VmGuest"
                                     PauseMusicRequested="@PauseMusicForVideo" />
        }
        else
        {
            <LegacyInvitationLayoutHost Slug="@Slug"
                                        Vm="@Vm"
                                        VmGuest="@VmGuest"
                                        PauseMusicRequested="@PauseMusicForVideo" />
        }
    </div>

    <footer class="w-footer">
        <a href="/@Slug/admin" class="w-admin-link" title="관리자">·</a>
    </footer>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "adminPreview")] public bool AdminPreview { get; set; }
    [SupplyParameterFromQuery(Name = "previewLayoutKey")] public string? PreviewLayoutKey { get; set; }
    [SupplyParameterFromQuery(Name = "previewLayoutVersion")] public string? PreviewLayoutVersion { get; set; }
    [SupplyParameterFromQuery(Name = "previewFollowActive")] public bool? PreviewFollowActive { get; set; }
    [SupplyParameterFromQuery(Name = "previewTheme")] public string? PreviewTheme { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemeBase")] public string? PreviewThemeBase { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemePrimary")] public string? PreviewThemePrimary { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemeDark")] public string? PreviewThemeDark { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemeAccent")] public string? PreviewThemeAccent { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemeText")] public string? PreviewThemeText { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemeMuted")] public string? PreviewThemeMuted { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemeBackground")] public string? PreviewThemeBackground { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemePanel")] public string? PreviewThemePanel { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemeButton")] public string? PreviewThemeButton { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemeButtonText")] public string? PreviewThemeButtonText { get; set; }
    [SupplyParameterFromQuery(Name = "previewThemeBorder")] public string? PreviewThemeBorder { get; set; }

    private ElementReference audioRef;
    private bool isMusicPlaying;
    private bool musicSyncInitialized;
    private bool previewDraftBridgeInitialized;
    private string appliedThemeFingerprint = "";
    private int catalogRefreshRunning;
    private int catalogRefreshRequested;
    private DotNetObjectReference<Invite>? _selfRef;
    private string RobotsDirective =>
        !Vm.IsLoaded || Vm.NotFound || AdminPreview || !Vm.IsSearchIndexingEnabled
            ? "noindex, nofollow"
            : "index, follow, max-image-preview:large";

    protected override void OnInitialized()
    {
        LayoutRegistry.Changed += OnLayoutCatalogChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadInvitationAsync();
        await VmGuest.InitializeAsync(Slug);
    }

    private Task LoadInvitationAsync() =>
        AdminPreview
            ? Vm.LoadAsync(
                Slug,
                PreviewLayoutKey,
                PreviewLayoutVersion,
                PreviewFollowActive,
                BuildPreviewThemeSelection())
            : Vm.LoadAsync(Slug);

    private WeddingThemePreviewSelection? BuildPreviewThemeSelection()
    {
        if (string.IsNullOrWhiteSpace(PreviewTheme))
        {
            return null;
        }

        if (!string.Equals(
                PreviewTheme,
                WeddingThemeCatalog.CustomThemeKey,
                StringComparison.OrdinalIgnoreCase))
        {
            return new WeddingThemePreviewSelection(PreviewTheme, null);
        }

        return new WeddingThemePreviewSelection(
            WeddingThemeCatalog.CustomThemeKey,
            new WeddingThemePalette(
                PreviewThemeBase ?? "",
                PreviewThemePrimary ?? "",
                PreviewThemeDark ?? "",
                PreviewThemeAccent ?? "",
                PreviewThemeText ?? "",
                PreviewThemeMuted ?? "",
                PreviewThemeBackground ?? "",
                PreviewThemePanel ?? "",
                PreviewThemeButton ?? "",
                PreviewThemeButtonText ?? "",
                PreviewThemeBorder ?? ""));
    }

    private void OnLayoutCatalogChanged(
        object? sender,
        WeddingLayoutCatalogChangedEventArgs args)
    {
        Interlocked.Exchange(ref catalogRefreshRequested, 1);
        _ = InvokeAsync(ProcessLayoutCatalogChangesAsync);
    }

    private async Task ProcessLayoutCatalogChangesAsync()
    {
        if (Interlocked.CompareExchange(ref catalogRefreshRunning, 1, 0) != 0)
        {
            return;
        }

        try
        {
            do
            {
                Interlocked.Exchange(ref catalogRefreshRequested, 0);
                await LoadInvitationAsync();
                StateHasChanged();
            }
            while (Interlocked.Exchange(ref catalogRefreshRequested, 0) != 0);
        }
        finally
        {
            Interlocked.Exchange(ref catalogRefreshRunning, 0);

            // 활성화와 즉시 롤백처럼 변경이 연달아 발생해도 마지막 카탈로그
            // 스냅샷을 놓치지 않습니다.
            if (Interlocked.Exchange(ref catalogRefreshRequested, 0) != 0)
            {
                _ = InvokeAsync(ProcessLayoutCatalogChangesAsync);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var themeFingerprint = $"{Vm.ThemeName}|{string.Join("|", Vm.ThemeCssVariables.Select(x => $"{x.Key}={x.Value}"))}";
        if (!string.Equals(appliedThemeFingerprint, themeFingerprint, StringComparison.Ordinal))
        {
            appliedThemeFingerprint = themeFingerprint;
            await JS.InvokeVoidAsync("weddingInterop.applyTheme", Vm.ThemeName, Vm.ThemeCssVariables);
        }

        if (firstRender)
        {
            VmGuest.ApplyDefaultMessage();
        }

        if (Vm.IsLoaded && !string.IsNullOrWhiteSpace(Vm.MusicUrl) && !musicSyncInitialized)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("weddingInterop.initMusicSync", _selfRef);
            await JS.InvokeVoidAsync("weddingInterop.initMusicAutoplay");
            isMusicPlaying = await JS.InvokeAsync<bool>("weddingInterop.isMusicPlaying");
            musicSyncInitialized = true;
            StateHasChanged();
        }

        if (Vm.IsLoaded)
        {
            await JS.InvokeVoidAsync("weddingInterop.initHeroCropTargets");
        }

        if (Vm.IsLoaded && AdminPreview)
        {
            await JS.InvokeVoidAsync("weddingInterop.initDesignDragTargets");

            if (!previewDraftBridgeInitialized)
            {
                _selfRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync(
                    "weddingInterop.initAdminPreviewDraftReceiver",
                    _selfRef);
                previewDraftBridgeInitialized = true;
            }
        }
    }

    private async Task ToggleMusic()
    {
        try
        {
            isMusicPlaying = await JS.InvokeAsync<bool>(isMusicPlaying ? "weddingInterop.pauseMusic" : "weddingInterop.playMusic");
            StateHasChanged();
        }
        catch { }
    }

    private async Task PauseMusicForVideo()
    {
        if (!isMusicPlaying) return;
        try
        {
            isMusicPlaying = await JS.InvokeAsync<bool>("weddingInterop.pauseMusic");
            StateHasChanged();
        }
        catch { }
    }

    [JSInvokable]
    public void OnMusicStateChanged(bool playing)
    {
        isMusicPlaying = playing;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnAdminPreviewAccountsChanged(AccountInfo[]? accounts)
    {
        if (!AdminPreview)
        {
            return;
        }

        Vm.ApplyAdminPreviewAccounts(accounts ?? []);
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        LayoutRegistry.Changed -= OnLayoutCatalogChanged;
        _selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
