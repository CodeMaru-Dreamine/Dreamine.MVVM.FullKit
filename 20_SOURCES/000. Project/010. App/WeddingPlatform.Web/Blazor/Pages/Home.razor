@page "/"
@layout WeddingPlatform.Blazor.Layout.WeddingLayout
@namespace WeddingPlatform.Blazor.Pages
@rendermode InteractiveServer
@implements IDisposable

@inject WeddingSuperAdminViewModel Vm
@inject WeddingUserContext UserContext
@inject NavigationManager Nav
@inject WeddingLocalization Text
@using Dreamine.UI.Blazor.Navigation

<PageTitle>@Text["page.title"]</PageTitle>

<HeadContent>
    <meta name="description" content="@Text["seo.description"]" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@Nav.Uri" />
    <meta property="og:title" content="@Text["page.title"]" />
    <meta property="og:description" content="@Text["seo.description"]" />
    <meta property="og:image" content="@(Nav.BaseUri.TrimEnd('/') + "/img/og-platform.jpg")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Text["page.title"]" />
    <meta name="twitter:description" content="@Text["seo.description"]" />
    <meta name="twitter:image" content="@(Nav.BaseUri.TrimEnd('/') + "/img/og-platform.jpg")" />
</HeadContent>

<div class="wh-page">
    <DreaminePortalHeader BrandName="CodeMaru"
                          BrandUrl="@CodeMaruHomeUrl"
                          BrandImageUrl="/img/Codemaru_Bloom.jpg"
                          BrandLightImageUrl="/img/Codemaru%20Bloom%20Light.jpg"
                          Items="@PortalItems"
                          ActiveKey="wedding"
                          NavigationAriaLabel="CodeMaru services"
                          ToggleMenuLabel="@Text["nav.toggle"]"
                          CssClass="wh-topnav"
                          IsAuthenticated="@currentUser.IsAuthenticated"
                          DisplayName="@NavUserLabel"
                          ScreenSettingsLabel="@Text["screen.settings"]"
                          LoginUrl="@(hasLoadedCurrentUser ? LoginUrl : null)"
                          LoginLabel="@Text["login"]"
                          AccountUrl="@AccountUrl"
                          AccountLabel="@Text["account"]"
                          SignoutUrl="@SignoutUrl"
                          SignoutLabel="@Text["logout"]">
        <Preferences>
            <WeddingPlatform.Blazor.Components.WeddingPreferences />
        </Preferences>
        <AdditionalUserActions>
            <a href="#my-invites"><span aria-hidden="true">▣</span> @Text["manage.mine"]</a>
        </AdditionalUserActions>
    </DreaminePortalHeader>

    <!-- ── 히어로 배너 ── -->
    <section class="wh-hero">
        <div class="wh-hero__inner">
            <p class="wh-hero__badge">@Text["hero.badge"]</p>
            <h1 class="wh-hero__title">@Text["hero.title"]</h1>
            <p class="wh-hero__sub">@Text["hero.sub"]</p>
            <div class="wh-hero__actions">
                <a href="#create" class="wh-btn wh-btn--primary">@Text["create.now"]</a>
                <a href="@LocalizedUrl("https://codemaru.co.kr")" class="wh-btn wh-btn--secondary">@Text["codemaru.home"]</a>
                @if (currentUser.IsAuthenticated)
                {
                    <a href="#my-invites" class="wh-btn wh-btn--secondary">@Text["manage.mine"]</a>
                }
                else if (hasLoadedCurrentUser)
                {
                    <a href="@LoginUrl" class="wh-btn wh-btn--secondary">@Text["login"]</a>
                }
            </div>
        </div>
    </section>

    <!-- ── 서비스 안내 ── -->
    <div class="wh-service-notice">
        <span>@Text["service.notice"] <a href="mailto:admin@codemaru.co.kr">admin@codemaru.co.kr</a></span>
        <span class="wh-notice-sep">·</span>
        <span>@Text["service.cleanup"]</span>
    </div>

    <!-- ── 기능 소개 ── -->
    <section class="wh-features">
        <div class="wh-feature">
            <span class="wh-feature__icon">🖼</span>
            <h3>@Text["features.photos"]</h3>
            <p>@Text["features.photos.desc"]</p>
        </div>
        <div class="wh-feature">
            <span class="wh-feature__icon">🗺</span>
            <h3>@Text["features.map"]</h3>
            <p>@Text["features.map.desc"]</p>
        </div>
        <div class="wh-feature">
            <span class="wh-feature__icon">🎵</span>
            <h3>@Text["features.music"]</h3>
            <p>@Text["features.music.desc"]</p>
        </div>
        <div class="wh-feature">
            <span class="wh-feature__icon">📖</span>
            <h3>@Text["features.guestbook"]</h3>
            <p>@Text["features.guestbook.desc"]</p>
        </div>
        <div class="wh-feature">
            <span class="wh-feature__icon">💌</span>
            <h3>@Text["features.accounts"]</h3>
            <p>@Text["features.accounts.desc"]</p>
        </div>
        <div class="wh-feature">
            <span class="wh-feature__icon">🎨</span>
            <h3>@Text["features.themes"]</h3>
            <p>@Text["features.themes.desc"]</p>
        </div>
    </section>

    <!-- ── 가입 폼 ── -->
    <section class="wh-create" id="create">
        <div class="wh-create__box">
            @if (currentUser.IsAuthenticated)
            {
                <div class="wh-account">
                    <span>@Text["common.login"]</span>
                    <strong>@CurrentUserLabel</strong>
                    <a href="@AccountUrl" class="wh-account__link">@Text["account"]</a>
                    <a href="@SignoutUrl" class="wh-account__link">@Text["logout"]</a>
                </div>
            }
            else if (hasLoadedCurrentUser)
            {
                <div class="wh-account wh-account--guest">
                    <span>@Text["guest.account"]</span>
                    <a href="@LoginUrl" class="wh-account__link">@Text["common.login"]</a>
                </div>
            }
            <h2 class="wh-create__title">@Text["start.title"]</h2>
            <p class="wh-create__desc">@Text["start.desc"]</p>

            @if (!string.IsNullOrWhiteSpace(Vm.StatusMessage))
            {
                <p class="wh-status @(Vm.StatusMessage.StartsWith("✅") ? "wh-status--ok" : "wh-status--err")">
                    @Vm.StatusMessage
                </p>
            }

            <div class="wh-form">
                <div class="wh-form__row">
                    <label class="wh-label">
                        @Text["field.slug"]
                        <span class="wh-label__hint">@Text["field.slug.hint"]</span>
                    </label>
                    <div class="wh-input-prefix">
                        <span class="wh-prefix">@Nav.BaseUri</span>
                        <input class="wh-input" @bind="Vm.NewSlug" placeholder="hong-gildong"
                               @oninput="OnSlugInput" spellcheck="false" autocomplete="off" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(slugPreview))
                    {
                        <p class="wh-slug-preview">👉 @slugPreview</p>
                    }
                </div>

                <div class="wh-form__row">
                    <label class="wh-label">@Text["field.couple"]</label>
                    <input class="wh-input" @bind="Vm.NewCoupleName" placeholder="@Text["field.couple.placeholder"]" />
                </div>

                <div class="wh-form__row">
                    <label class="wh-label">@Text["field.date"]</label>
                    <input class="wh-input" type="date" @bind="Vm.NewWeddingDate" />
                </div>

                <div class="wh-form__row">
                    <label class="wh-label">
                        @Text["field.password"]
                        <span class="wh-label__hint">@Text["field.password.hint"]</span>
                    </label>
                    <input class="wh-input" type="password" @bind="Vm.NewPassword"
                           placeholder="@Text["field.password.placeholder"]" autocomplete="new-password" />
                </div>

                <button class="wh-btn wh-btn--primary wh-btn--full"
                        @onclick="OnCreate" disabled="@isCreating">
                    @(isCreating ? Text["creating"] : Text["create.button"])
                </button>
            </div>

            <p class="wh-create__notice">
                @Text["create.notice"]
            </p>
        </div>
    </section>

    @if (currentUser.IsAuthenticated)
    {
        <section class="wh-invites wh-invites--mine" id="my-invites">
            <h2 class="wh-invites__title">@Text["my.invites"]</h2>
            @if (myInvites.Count == 0)
            {
                <p class="wh-empty">아직 이 계정에 연결된 청첩장이 없습니다. 기존 청첩장이 있다면 <code>/{슬러그}/admin</code>에서 기존 비밀번호를 한 번 입력해 연결하세요.</p>
            }
            else
            {
                <div class="wh-invites__grid">
                    @foreach (var t in myInvites)
                    {
                        <a href="/@t.Slug/admin" class="wh-invite-card wh-invite-card--manage">
                            <div class="wh-invite-card__body">
                                <div class="wh-invite-card__name">@t.CoupleName</div>
                                <div class="wh-invite-card__date">@t.WeddingDate.ToString("yyyy년 MM월 dd일")</div>
                                <div class="wh-invite-card__venue">/@t.Slug/admin</div>
                                <span class="wh-manage-link">@Text["manage.open"]</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>
    }

    <!-- ── 공개 청첩장 목록 ── -->
    @if (publicInvites.Count > 0)
    {
        <section class="wh-invites">
            <h2 class="wh-invites__title">@Text["public.invites"]</h2>
            <div class="wh-invites__grid">
                @foreach (var t in publicInvites)
                {
                    var imgFile = !string.IsNullOrWhiteSpace(t.OgImageFileName) ? t.OgImageFileName
                                : !string.IsNullOrWhiteSpace(t.HeroImageFileName) ? t.HeroImageFileName
                                : null;
                    var imgUrl  = imgFile != null ? $"/wedding-data/{t.Slug}/{Uri.EscapeDataString(imgFile)}" : null;

                    <a href="/@t.Slug" class="wh-invite-card">
                        <div class="wh-invite-card__thumb"
                             style="@(imgUrl != null ? $"background-image:url('{imgUrl}')" : "")">
                            @if (imgUrl == null)
                            {
                                <span class="wh-invite-card__no-img">💒</span>
                            }
                        </div>
                        <div class="wh-invite-card__body">
                            <div class="wh-invite-card__name">@t.CoupleName</div>
                            <div class="wh-invite-card__date">@t.WeddingDate.ToString("yyyy년 MM월 dd일")</div>
                            @if (!string.IsNullOrWhiteSpace(t.VenueName))
                            {
                                <div class="wh-invite-card__venue">📍 @t.VenueName</div>
                            }
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- ── 하단 ── -->
    <footer class="wh-footer">
        <p>Powered by Codemaru Wedding Platform · <a href="mailto:admin@codemaru.co.kr" class="wh-footer__contact">admin@codemaru.co.kr</a></p>
        <a href="/admin" class="wh-admin-link">@Text["admin"]</a>
    </footer>
</div>

@code {
    private bool isCreating;
    private string slugPreview = "";
    private List<WeddingPlatform.Models.TenantConfig> publicInvites = [];
    private List<WeddingPlatform.Models.TenantConfig> myInvites = [];
    private WeddingCurrentUser currentUser = WeddingCurrentUser.Anonymous;
    private bool hasLoadedCurrentUser;

    // Authentication must be completed on the current host. In local/WPF mode a
    // codemaru.co.kr sign-out cannot remove the localhost cookie; in production
    // the shared cookie domain is still honoured by this same relative endpoint.
    private string LoginUrl => IdentityUrl("login");
    private string AccountUrl => IdentityUrl("account");
    private string SignoutUrl => IdentityUrl("signout");
    private string NavUserLabel => string.IsNullOrWhiteSpace(currentUser.DisplayName) ? Text["account"] : currentUser.DisplayName;
    private string CurrentUserLabel => string.IsNullOrWhiteSpace(currentUser.DisplayName)
        ? currentUser.Provider
        : $"{currentUser.DisplayName} ({currentUser.Provider})";
    private string CodeMaruHomeUrl => LocalizedUrl("https://codemaru.co.kr");
    private IReadOnlyList<DreaminePortalNavigationItem> PortalItems =>
    [
        new("home", Text["home"], CodeMaruHomeUrl),
        new("dreamine", "Dreamine", "https://dreamine.kr/", OpenInNewWindow: true),
        new("cardhybrid", "CardHybrid", LocalizedUrl("https://codemaru.co.kr/cardhybrid")),
        new("wedding", "Wedding", LocalizedUrl("https://wedding.codemaru.co.kr")),
        new("thankyou", "ThankYou", LocalizedUrl("https://thankyou.codemaru.co.kr/")),
        new("families", "Families", LocalizedUrl("https://families.codemaru.co.kr")),
        new("portfolio", "Portfolio", LocalizedUrl("https://portfolio.codemaru.co.kr/")),
        new("cctv", "CCTV", LocalizedUrl("https://cctvviewer.codemaru.co.kr")),
        new("shop", "ShopStore", LocalizedUrl("https://shop.codemaru.co.kr/")),
        new("contact", Text["contact"], LocalizedUrl("https://codemaru.co.kr/contact"))
    ];

    private string LocalizedUrl(string url)
    {
        var separator = url.Contains('?') ? '&' : '?';
        return $"{url}{separator}lang={Uri.EscapeDataString(Text.Language)}";
    }

    private string IdentityUrl(string action)
    {
        var current = Nav.ToAbsoluteUri(Nav.Uri);
        var returnUrl = current.PathAndQuery;
        return $"/_identity/{action}?lang={Uri.EscapeDataString(Text.Language)}&returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    protected override void OnInitialized()
    {
        Text.Changed += OnTextChanged;
        Vm.NewSlug = "";
        Vm.NewCoupleName = "";
        Vm.NewPassword = "";
        Vm.NewWeddingDate = DateTime.Today.AddMonths(3);
    }

    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserContext.GetCurrentAsync();
        hasLoadedCurrentUser = true;
        await Vm.LoadAsync();
        publicInvites = Vm.Tenants
            .Where(t => t.ShowOnHome)
            .OrderBy(t => t.PinOrder <= 0 ? int.MaxValue : t.PinOrder)
            .ThenByDescending(t => t.WeddingDate)
            .ThenByDescending(t => t.CreatedAt)
            .ToList();
        myInvites = currentUser.IsAuthenticated
            ? Vm.Tenants
                .Where(IsMyInvite)
                .OrderByDescending(t => t.CreatedAt)
                .ToList()
            : [];
    }

    private void OnSlugInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        // 영문 소문자·숫자·하이픈만 허용
        var clean = new string(raw.ToLowerInvariant()
            .Select(c => char.IsLetterOrDigit(c) || c == '-' ? c : '-').ToArray())
            .Trim('-');
        Vm.NewSlug = clean;
        slugPreview = string.IsNullOrWhiteSpace(clean) ? "" : $"{Nav.BaseUri}{clean}";
    }

    private async Task OnCreate()
    {
        isCreating = true;
        StateHasChanged();
        try
        {
            var slug = Vm.NewSlug.Trim().ToLowerInvariant();
            var ok = await Vm.CreateTenantAsync();
            if (ok)
            {
                await Task.Delay(1200); // 성공 메시지 잠깐 표시
                Nav.NavigateTo($"/{slug}/admin");
            }
        }
        finally { isCreating = false; }
    }

    private bool IsMyInvite(WeddingPlatform.Models.TenantConfig config) =>
        string.Equals(config.OwnerUserId, currentUser.Id, StringComparison.Ordinal)
        || (config.AdminUsers?.Any(x => string.Equals(x.UserId, currentUser.Id, StringComparison.Ordinal)) == true);

    public void Dispose()
    {
        Text.Changed -= OnTextChanged;
    }

    private void OnTextChanged() => _ = InvokeAsync(StateHasChanged);
}
