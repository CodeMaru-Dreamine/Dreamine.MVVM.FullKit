@namespace WeddingPlatform.Blazor.Components
@using Wedding.Layouts.Contracts
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    플랫폼 중립 LayoutTransitionDefinition을 실제 Web 전환으로 해석하는
    공통 프리미티브. 동적 JSON 레이아웃과 기존 내장 레이아웃이 같은
    페이지 전환 동작을 사용하도록 콘텐츠를 typed RenderFragment로 받는다.
*@
<section class="@RootCssClass"
         style="@TransitionStyle"
         aria-busy="@(_isTransitioning ? "true" : "false")"
         aria-label="@AriaLabel">
    <header class="w-layout-transition__status">
        <span class="w-layout-transition__edition">@PresentationLabel</span>
        <strong aria-live="polite" aria-atomic="true">@CurrentPageLabel</strong>
        <span class="w-layout-transition__counter">@CurrentPageCounter</span>
    </header>

    <div class="w-layout-transition__viewport"
         @ref="_viewportElement"
         @onpointerdown="HandlePointerDown"
         @onpointerup="HandlePointerUp"
         @onpointercancel="CancelPointer">
        @if (Presentation != LayoutPresentationMode.Flow)
        {
            <div class="w-layout-transition__stack w-layout-transition__stack--back"
                 aria-hidden="true"></div>
            <div class="w-layout-transition__stack w-layout-transition__stack--middle"
                 aria-hidden="true"></div>
        }

        <div @key="PageRenderKey"
             class="@PageCssClass">
            @if (Presentation == LayoutPresentationMode.PagedBook)
            {
                @if (_isCompactBook)
                {
                    <div class="w-layout-transition__sheet w-layout-transition__sheet--mobile">
                        @RenderPage(BookMobileBaseIndex)
                    </div>
                }
                else
                {
                    <div class="w-layout-transition__sheet w-layout-transition__sheet--left w-layout-transition__sheet--desktop">
                        @RenderPage(BookBaseLeftIndex)
                    </div>
                    @if (BookBaseRightIndex < PageCount)
                    {
                        <div class="w-layout-transition__sheet w-layout-transition__sheet--right w-layout-transition__sheet--desktop">
                            @RenderPage(BookBaseRightIndex)
                        </div>
                    }
                    else
                    {
                        <div class="w-layout-transition__sheet w-layout-transition__sheet--right w-layout-transition__sheet--desktop w-layout-transition__sheet--empty"
                             aria-hidden="true"></div>
                    }
                }

                <div class="w-layout-transition__spine" aria-hidden="true"></div>
                @if (_isTransitioning)
                {
                    <div @key="_turnSequence"
                         class="@TurningLeafCssClass"
                         aria-hidden="true"
                         inert="inert"
                         @onanimationend="HandleBookTurnAnimationEnd">
                        <div class="w-layout-transition__leaf-face w-layout-transition__leaf-face--front"
                             @onanimationend:stopPropagation>
                            <div class="w-layout-transition__leaf-content @(_isCompactBook ? "w-layout-transition__leaf-content--mobile" : "w-layout-transition__leaf-content--desktop")">
                                @RenderReplicaPage(
                                    _isCompactBook
                                        ? _displayIndex
                                        : BookLeafFrontIndex)
                            </div>
                        </div>
                        <div class="w-layout-transition__leaf-face w-layout-transition__leaf-face--back"
                             @onanimationend:stopPropagation>
                            <div class="w-layout-transition__leaf-content @(_isCompactBook ? "w-layout-transition__leaf-content--mobile" : "w-layout-transition__leaf-content--desktop")">
                                @RenderReplicaPage(
                                    _isCompactBook
                                        ? _pendingIndex
                                        : BookLeafBackIndex)
                            </div>
                        </div>
                    </div>

                    @* 감속 모션 환경에서는 3D 회전 대신 현재 펼침면을 짧게 페이드 아웃한다.
                       기본(target) 펼침면은 아래에 이미 렌더되어 있으므로 빈 프레임이 없다. *@
                    <div class="@ReducedMotionOverlayCssClass"
                         aria-hidden="true"
                         inert="inert"
                         @onanimationend="HandleBookTurnAnimationEnd">
                        @if (_isCompactBook)
                        {
                            <div class="w-layout-transition__sheet w-layout-transition__sheet--mobile"
                                 @onanimationend:stopPropagation>
                                @RenderReplicaPage(_displayIndex)
                            </div>
                        }
                        else
                        {
                            <div class="w-layout-transition__sheet w-layout-transition__sheet--left w-layout-transition__sheet--desktop"
                                 @onanimationend:stopPropagation>
                                @RenderReplicaPage(_displayIndex)
                            </div>
                            @if (_displayIndex + 1 < PageCount)
                            {
                                <div class="w-layout-transition__sheet w-layout-transition__sheet--right w-layout-transition__sheet--desktop"
                                     @onanimationend:stopPropagation>
                                    @RenderReplicaPage(_displayIndex + 1)
                                </div>
                            }
                            else
                            {
                                <div class="w-layout-transition__sheet w-layout-transition__sheet--right w-layout-transition__sheet--desktop w-layout-transition__sheet--empty"
                                     @onanimationend:stopPropagation></div>
                            }
                        }
                    </div>
                }
            }
            else
            {
                <div class="w-layout-transition__sheet w-layout-transition__sheet--single">
                    @RenderPage(_displayIndex)
                </div>
            }
        </div>
    </div>

    @if (Transition.ShowNavigation && SafePageCount > 1)
    {
        <nav class="w-layout-transition__navigation"
             aria-label="페이지 이동"
             tabindex="0"
             @onkeydown="HandleNavigationKeyDown">
            <button type="button"
                    class="w-layout-transition__arrow"
                    disabled="@(!CanMovePrevious || _isTransitioning)"
                    aria-label="이전 페이지"
                    @onclick="MovePreviousAsync">
                <span aria-hidden="true">←</span>
                <small>이전</small>
            </button>

            <div class="w-layout-transition__progress" aria-label="페이지 선택">
                @foreach (var progressItem in ProgressItems)
                {
                    if (progressItem is { } pageIndex)
                    {
                        <button type="button"
                                class="w-layout-transition__dot @(pageIndex == _displayIndex ? "is-active" : "")"
                                disabled="@_isTransitioning"
                                aria-label="@($"{ResolvePageLabel(pageIndex)} 페이지로 이동")"
                                aria-current="@(pageIndex == _displayIndex ? "page" : null)"
                                @onclick="() => GoToPageAsync(pageIndex)">
                            <span aria-hidden="true"></span>
                        </button>
                    }
                    else
                    {
                        <span class="w-layout-transition__ellipsis"
                              aria-hidden="true">…</span>
                    }
                }
            </div>

            <button type="button"
                    class="w-layout-transition__arrow"
                    disabled="@(!CanMoveNext || _isTransitioning)"
                    aria-label="다음 페이지"
                    @onclick="MoveNextAsync">
                <small>다음</small>
                <span aria-hidden="true">→</span>
            </button>
        </nav>
    }
    else if (Transition.EnableKeyboard && SafePageCount > 1)
    {
        <div class="w-layout-transition__keyboard"
             role="group"
             aria-label="페이지 이동. 좌우 방향키를 사용하세요."
             tabindex="0"
             @onkeydown="HandleNavigationKeyDown">
            좌우 방향키로 페이지 이동
        </div>
    }
</section>

@code {
    [Parameter] public LayoutPresentationMode Presentation { get; set; } =
        LayoutPresentationMode.Flow;

    [Parameter, EditorRequired]
    public LayoutTransitionDefinition Transition { get; set; } = new();

    [Parameter] public int PageCount { get; set; }

    [Parameter] public int ActiveIndex { get; set; }

    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }

    /// <summary>
    /// 내부 페이지 상태를 바꾸기 직전에 대상 인덱스를 전달합니다.
    /// 카드에 열린 미디어처럼 현재 페이지에 종속된 임시 UI를 정리할 때 사용합니다.
    /// </summary>
    [Parameter] public EventCallback<int> ActiveIndexChanging { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<int>? PageContent { get; set; }

    /// <summary>
    /// 책장이 회전하는 동안 앞·뒷면에 사용할 비대화형 복제 콘텐츠입니다.
    /// 지도·폼·미디어처럼 DOM ID나 생명주기를 갖는 실제 페이지를 중복 생성하지
    /// 않도록 호출자가 안전한 정적 표현을 제공할 수 있습니다.
    /// </summary>
    [Parameter]
    public RenderFragment<int>? ReplicaContent { get; set; }

    [Parameter] public Func<int, string>? PageLabel { get; set; }

    [Parameter] public string AriaLabel { get; set; } = "페이지형 레이아웃";

    private int _displayIndex;
    private int _pendingIndex;
    private int? _queuedIndex;
    private int _turnSequence;
    private string _direction = "";
    private bool _initialized;
    private bool _isTransitioning;
    private bool _animationStarted;
    private bool _preparingAnimation;
    private bool _isCompactBook = true;
    private bool? _queuedCompactBook;
    private bool _viewportObserverInitialized;
    private bool _observedResponsiveBook;
    private double? _pointerStartX;
    private double? _pointerStartY;
    private ElementReference _viewportElement;
    private DotNetObjectReference<LayoutTransitionSurface>? _selfReference;
    private CancellationTokenSource? _turnFallbackCts;

    private int SafePageCount => Math.Max(1, PageCount);

    private int DurationMilliseconds =>
        Math.Clamp(Transition.DurationMilliseconds, 150, 2000);

    private string TransitionStyle =>
        $"--w-layout-transition-duration:{DurationMilliseconds}ms";

    public bool IsTransitioning => _isTransitioning;

    private int NavigationStep =>
        IsBookPageTurn && !_isCompactBook ? 2 : 1;

    /// <summary>
    /// 현재 실제 뷰포트에서 한 번 이동할 때 넘기는 페이지 수입니다.
    /// 포토북 자동 넘김처럼 다음 콘텐츠의 성격을 확인해야 하는 호출자가
    /// PC 펼침면(2쪽)과 모바일 단일면(1쪽)을 같은 규칙으로 따르게 합니다.
    /// </summary>
    public int NavigationPageStep => NavigationStep;

    private bool CanMovePrevious => _displayIndex > 0;

    private bool CanMoveNext =>
        _displayIndex + NavigationStep < SafePageCount;

    private string CurrentPageLabel => ResolvePageLabel(_displayIndex);

    private string CurrentPageCounter =>
        IsBookPageTurn
        && !_isCompactBook
        && _displayIndex + 1 < SafePageCount
            ? $"{_displayIndex + 1}–{_displayIndex + 2} / {SafePageCount}"
            : $"{_displayIndex + 1} / {SafePageCount}";

    private bool IsBookPageTurn =>
        Presentation == LayoutPresentationMode.PagedBook
        && Transition.Kind == LayoutTransitionKind.PageTurn;

    /*
     * 다음: 현재 왼쪽은 유지하고 target+1을 오른쪽 밑장으로 준비한다.
     * 이전: target을 왼쪽 밑장으로 준비하고 현재 오른쪽은 유지한다.
     * 회전이 끝나는 순간 아래 조합과 최종 펼침면이 정확히 일치하므로
     * leaf 제거/인덱스 커밋 시 빈 배경이나 콘텐츠 점프가 생기지 않는다.
     */
    private int BookBaseLeftIndex =>
        !_isTransitioning || _direction == "next"
            ? _displayIndex
            : _pendingIndex;

    private int BookBaseRightIndex =>
        !_isTransitioning || _direction == "previous"
            ? _displayIndex + 1
            : _pendingIndex + 1;

    private int BookMobileBaseIndex =>
        _isTransitioning ? _pendingIndex : _displayIndex;

    private int BookLeafFrontIndex =>
        _direction == "next" ? _displayIndex + 1 : _displayIndex;

    private int BookLeafBackIndex =>
        _direction == "next" ? _pendingIndex : _pendingIndex + 1;

    private object PageRenderKey =>
        IsBookPageTurn ? "paged-book-surface" : $"{_displayIndex}-{_turnSequence}";

    private string TurningLeafCssClass =>
        string.Join(" ",
        [
            "w-layout-transition__turning-leaf",
            $"w-layout-transition__turning-leaf--{_direction}",
            _animationStarted ? "is-animating" : "is-prepared",
        ]);

    private string ReducedMotionOverlayCssClass =>
        string.Join(" ",
        [
            "w-layout-transition__reduced-overlay",
            _animationStarted ? "is-animating" : "is-prepared",
        ]);

    private IReadOnlyList<int?> ProgressItems
    {
        get
        {
            var indexes = Enumerable.Range(0, SafePageCount)
                .Where(index =>
                    !IsBookPageTurn
                    || _isCompactBook
                    || index % 2 == 0)
                .ToArray();
            if (indexes.Length <= 9)
            {
                return indexes
                    .Select(index => (int?)index)
                    .ToArray();
            }

            var visibleIndexes = new SortedSet<int>
            {
                indexes[0],
                indexes[^1],
            };
            foreach (var index in indexes.Where(index =>
                         Math.Abs(index - _displayIndex)
                         <= NavigationStep * 2))
            {
                visibleIndexes.Add(index);
            }

            var result = new List<int?>();
            int? previous = null;
            foreach (var index in visibleIndexes)
            {
                if (previous is { } previousIndex
                    && index - previousIndex > NavigationStep)
                {
                    result.Add(null);
                }

                result.Add(index);
                previous = index;
            }

            return result;
        }
    }

    private string PresentationLabel => Presentation switch
    {
        LayoutPresentationMode.FlipCard => "PREMIUM CARD",
        LayoutPresentationMode.PagedBook => "PREMIUM BOOK",
        _ => "INVITATION",
    };

    private string RootCssClass =>
        string.Join(" ",
        [
            "w-layout-transition",
            Presentation switch
            {
                LayoutPresentationMode.FlipCard =>
                    "w-layout-transition--flip-card",
                LayoutPresentationMode.PagedBook =>
                    "w-layout-transition--paged-book",
                _ => "w-layout-transition--flow",
            },
            $"w-layout-transition--{Transition.Kind.ToString().ToLowerInvariant()}",
            IsBookPageTurn
                ? _isCompactBook
                    ? "is-book-compact"
                    : "is-book-spread"
                : "",
            IsBookPageTurn
            && _isCompactBook
            && _displayIndex > 0
            && _displayIndex % 2 == 0
                ? "is-book-left-page"
                : "",
            _isTransitioning ? "is-transitioning" : "",
            _isTransitioning && !_animationStarted ? "is-preparing" : "",
            _isTransitioning ? $"is-turning-{_direction}" : "",
        ]);

    private string PageCssClass =>
        string.Join(" ",
        new[]
        {
            "w-layout-transition__page",
            _direction switch
            {
                "next" => "w-layout-transition__page--next",
                "previous" => "w-layout-transition__page--previous",
                _ => "",
            },
        }.Where(value => value.Length > 0));

    protected override void OnParametersSet()
    {
        var normalized = NormalizeBookIndexForViewport(
            Math.Clamp(ActiveIndex, 0, SafePageCount - 1));
        if (!_initialized)
        {
            _initialized = true;
            _displayIndex = normalized;
            _pendingIndex = normalized;
            return;
        }

        if (IsBookPageTurn)
        {
            if (_isTransitioning)
            {
                if (normalized != _displayIndex
                    && normalized != _pendingIndex)
                {
                    // 외부 자동 넘김/상위 재렌더 요청은 한 건만 직렬화한다.
                    _queuedIndex = normalized;
                }

                return;
            }

            if (normalized != _displayIndex)
            {
                BeginBookTurn(normalized);
            }

            return;
        }

        if (normalized == _displayIndex)
        {
            return;
        }

        _direction = normalized > _displayIndex ? "next" : "previous";
        _displayIndex = normalized;
        _turnSequence++;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var supportsHorizontalWheel =
            Presentation != LayoutPresentationMode.Flow;
        if (!supportsHorizontalWheel && _viewportObserverInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "weddingInterop.disposePageTurnViewport",
                    _viewportElement);
            }
            catch (InvalidOperationException)
            {
                // 정적 prerender 단계에는 다음 interactive render에서 재시도한다.
            }
            catch (JSException)
            {
                // 이미 교체된 DOM은 브라우저에서 함께 정리된다.
            }

            _viewportObserverInitialized = false;
        }
        else if (supportsHorizontalWheel
                 && (!_viewportObserverInitialized
                     || _observedResponsiveBook != IsBookPageTurn))
        {
            try
            {
                _selfReference ??=
                    DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync(
                    "weddingInterop.observePageTurnViewport",
                    _viewportElement,
                    _selfReference,
                    IsBookPageTurn);
                _viewportObserverInitialized = true;
                _observedResponsiveBook = IsBookPageTurn;
            }
            catch (InvalidOperationException)
            {
                // 정적 prerender 단계에는 다음 interactive render에서 재시도한다.
            }
            catch (JSException)
            {
                // ResizeObserver를 사용할 수 없는 환경은 안전한 단일면으로 유지한다.
            }
        }

        if (!_isTransitioning
            || _animationStarted
            || _preparingAnimation)
        {
            return;
        }

        _preparingAnimation = true;
        var sequence = _turnSequence;

        try
        {
            // leaf와 그 아래 target 페이지를 먼저 DOM에 올린 뒤, 필요한 이미지가
            // decode될 때까지 기다리고 두 프레임 후 애니메이션 클래스를 붙인다.
            await JS.InvokeVoidAsync(
                "weddingInterop.preparePageTurn",
                _viewportElement);
        }
        catch (InvalidOperationException)
        {
            // 정적 prerender 단계에는 JS interop을 사용할 수 없다.
            await Task.Yield();
        }
        catch (JSException)
        {
            // 이미지 decode 실패가 페이지 이동 자체를 막지는 않도록 종이 배경으로 진행한다.
            await Task.Yield();
        }
        catch (TaskCanceledException)
        {
            await Task.Yield();
        }

        if (!_isTransitioning || sequence != _turnSequence)
        {
            _preparingAnimation = false;
            return;
        }

        _animationStarted = true;
        _preparingAnimation = false;
        StartTurnCompletionFallback(sequence);
        await InvokeAsync(StateHasChanged);
    }

    private RenderFragment RenderPage(int index) => builder =>
    {
        if (PageContent is null || index < 0 || index >= PageCount)
        {
            return;
        }

        builder.AddContent(0, PageContent(index));
    };

    private RenderFragment RenderReplicaPage(int index) => builder =>
    {
        if (index < 0 || index >= PageCount)
        {
            return;
        }

        var content = ReplicaContent ?? PageContent;
        if (content is not null)
        {
            builder.AddContent(0, content(index));
        }
    };

    private string ResolvePageLabel(int index)
    {
        var label = PageLabel?.Invoke(index);
        return string.IsNullOrWhiteSpace(label)
            ? $"페이지 {index + 1}"
            : label;
    }

    [JSInvokable]
    public async Task OnPageTurnViewportModeChanged(bool compact)
    {
        if (!IsBookPageTurn || compact == _isCompactBook)
        {
            return;
        }

        if (_isTransitioning)
        {
            _queuedCompactBook = compact;
            return;
        }

        _isCompactBook = compact;
        var normalized = NormalizeBookIndexForViewport(_displayIndex);
        _displayIndex = normalized;
        _pendingIndex = normalized;
        _queuedIndex = null;
        await ActiveIndexChanged.InvokeAsync(normalized);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnPageTurnHorizontalWheel(int direction)
    {
        if (Presentation == LayoutPresentationMode.Flow
            || direction == 0
            || _isTransitioning)
        {
            return;
        }

        if (direction > 0)
        {
            await MoveNextAsync();
        }
        else
        {
            await MovePreviousAsync();
        }
    }

    private int NormalizeBookIndexForViewport(int index)
    {
        var normalized = Math.Clamp(index, 0, SafePageCount - 1);
        return IsBookPageTurn && !_isCompactBook
            ? normalized - normalized % 2
            : normalized;
    }

    private Task MovePreviousAsync() =>
        GoToPageAsync(_displayIndex - NavigationStep);

    private Task MoveNextAsync() =>
        GoToPageAsync(_displayIndex + NavigationStep);

    public async Task<bool> RequestNextAsync()
    {
        if (_isTransitioning || !CanMoveNext)
        {
            return false;
        }

        await MoveNextAsync();
        return true;
    }

    public async Task<bool> RequestPreviousAsync()
    {
        if (_isTransitioning || !CanMovePrevious)
        {
            return false;
        }

        await MovePreviousAsync();
        return true;
    }

    private async Task GoToPageAsync(int requestedIndex)
    {
        var nextIndex = NormalizeBookIndexForViewport(
            Math.Clamp(requestedIndex, 0, SafePageCount - 1));
        if (nextIndex == _displayIndex || _isTransitioning)
        {
            return;
        }

        if (ActiveIndexChanging.HasDelegate)
        {
            await ActiveIndexChanging.InvokeAsync(nextIndex);
        }

        // 전환 전 콜백이 상위 상태를 바꾸는 동안 다른 이동이 시작된 경우
        // 동일한 요청을 겹쳐 실행하지 않습니다.
        if (nextIndex == _displayIndex || _isTransitioning)
        {
            return;
        }

        if (IsBookPageTurn)
        {
            BeginBookTurn(nextIndex);
            await InvokeAsync(StateHasChanged);
            return;
        }

        _direction = nextIndex > _displayIndex ? "next" : "previous";
        _displayIndex = nextIndex;
        _turnSequence++;
        await ActiveIndexChanged.InvokeAsync(nextIndex);
    }

    private void BeginBookTurn(int nextIndex)
    {
        nextIndex = NormalizeBookIndexForViewport(
            Math.Clamp(nextIndex, 0, SafePageCount - 1));
        if (nextIndex == _displayIndex || _isTransitioning)
        {
            return;
        }

        _pendingIndex = nextIndex;
        _direction = nextIndex > _displayIndex ? "next" : "previous";
        _isTransitioning = true;
        _animationStarted = false;
        _preparingAnimation = false;
        _turnSequence++;
        CancelPointer();
        CancelTurnCompletionFallback();
    }

    /*
     * .NET 8의 기본 animationend EventArgs에는 animationName이 노출되지 않는다.
     * 곡률 애니메이션이 걸린 leaf-face에서 전파를 차단했으므로 여기에는
     * leaf 본체의 turn 또는 reduced-overlay의 fade 완료만 도달한다.
     */
    private Task HandleBookTurnAnimationEnd(EventArgs _)
        => CompleteBookTurnAsync(_turnSequence);

    private async Task CompleteBookTurnAsync(int expectedSequence)
    {
        if (!_isTransitioning
            || !_animationStarted
            || expectedSequence != _turnSequence)
        {
            return;
        }

        CancelTurnCompletionFallback();

        if (_queuedCompactBook is { } queuedCompact)
        {
            _isCompactBook = queuedCompact;
            _queuedCompactBook = null;
        }

        var completedIndex = NormalizeBookIndexForViewport(_pendingIndex);
        var queuedIndex = _queuedIndex;
        _queuedIndex = null;
        _displayIndex = completedIndex;
        _pendingIndex = completedIndex;
        _direction = "";
        _isTransitioning = false;
        _animationStarted = false;
        _preparingAnimation = false;

        // 바인딩 값은 회전이 실제로 끝난 뒤에만 확정한다.
        await ActiveIndexChanged.InvokeAsync(completedIndex);

        if (queuedIndex is { } queued)
        {
            queued = NormalizeBookIndexForViewport(queued);
            if (queued != _displayIndex)
            {
                BeginBookTurn(queued);
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void StartTurnCompletionFallback(int sequence)
    {
        CancelTurnCompletionFallback();
        _turnFallbackCts = new CancellationTokenSource();
        _ = CompleteTurnAfterTimeoutAsync(
            sequence,
            _turnFallbackCts.Token);
    }

    private async Task CompleteTurnAfterTimeoutAsync(
        int sequence,
        CancellationToken cancellationToken)
    {
        try
        {
            // animationend가 백그라운드 탭/브라우저 중단으로 유실되더라도
            // CSS duration이 지난 뒤 잠금이 영구히 남지 않게 하는 안전장치다.
            await Task.Delay(
                DurationMilliseconds + 350,
                cancellationToken);
            await InvokeAsync(() => CompleteBookTurnAsync(sequence));
        }
        catch (OperationCanceledException)
        {
            // 정상 완료 시 취소되는 경로다.
        }
    }

    private void CancelTurnCompletionFallback()
    {
        _turnFallbackCts?.Cancel();
        _turnFallbackCts?.Dispose();
        _turnFallbackCts = null;
    }

    private async Task HandleNavigationKeyDown(KeyboardEventArgs args)
    {
        if (!Transition.EnableKeyboard || _isTransitioning)
        {
            return;
        }

        if (string.Equals(args.Key, "ArrowLeft", StringComparison.Ordinal))
        {
            await MovePreviousAsync();
        }
        else if (string.Equals(args.Key, "ArrowRight", StringComparison.Ordinal))
        {
            await MoveNextAsync();
        }
    }

    private void HandlePointerDown(PointerEventArgs args)
    {
        if (!Transition.EnableSwipe || _isTransitioning)
        {
            return;
        }

        _pointerStartX = args.ClientX;
        _pointerStartY = args.ClientY;
    }

    private async Task HandlePointerUp(PointerEventArgs args)
    {
        if (!Transition.EnableSwipe
            || _isTransitioning
            || _pointerStartX is not { } startX
            || _pointerStartY is not { } startY)
        {
            CancelPointer();
            return;
        }

        var deltaX = args.ClientX - startX;
        var deltaY = args.ClientY - startY;
        CancelPointer();

        if (Math.Abs(deltaX) < 64
            || Math.Abs(deltaX) <= Math.Abs(deltaY) * 1.25)
        {
            return;
        }

        if (deltaX < 0)
        {
            await MoveNextAsync();
        }
        else
        {
            await MovePreviousAsync();
        }
    }

    private void CancelPointer(PointerEventArgs? _ = null)
    {
        _pointerStartX = null;
        _pointerStartY = null;
    }

    public async ValueTask DisposeAsync()
    {
        CancelTurnCompletionFallback();
        if (_viewportObserverInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "weddingInterop.disposePageTurnViewport",
                    _viewportElement);
            }
            catch (JSDisconnectedException)
            {
                // 회로 종료 중에는 브라우저 정리가 불가능할 수 있다.
            }
            catch (TaskCanceledException)
            {
                // 탐색 중 취소되는 정상 종료 경로다.
            }
        }

        _selfReference?.Dispose();
    }
}
