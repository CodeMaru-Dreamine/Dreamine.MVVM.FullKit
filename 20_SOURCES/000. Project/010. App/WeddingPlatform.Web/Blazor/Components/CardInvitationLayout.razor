@namespace WeddingPlatform.Blazor.Components
@using Wedding.Common
@using Wedding.Layouts.Contracts
@using WeddingPlatform.Models
@using WeddingPlatform.ViewModels

@*
    기존 Card 레이아웃도 JSON 동적 레이아웃과 동일한 공통 전환
    LayoutTransitionSurface를 사용한다. 이 파일은 카드별 콘텐츠 구성만 담당한다.
*@
@{
    var pages = VisiblePages;
}
<section class="wedding-card-experience @Vm.LayoutDescriptor.CssClass"
         aria-label="카드형 모바일 청첩장">
    <LayoutTransitionSurface Presentation="LayoutPresentationMode.FlipCard"
                             Transition="@CardTransition"
                             PageCount="@pages.Count"
                             ActiveIndex="@_activePageIndex"
                             ActiveIndexChanging="OnActivePageChanging"
                             ActiveIndexChanged="OnActivePageChanged"
                             PageLabel="@ResolvePageLabel"
                             AriaLabel="@($"{Vm.CoupleName} 카드 청첩장")">
        <PageContent Context="pageIndex">
            @{
                var safeIndex = Math.Clamp(pageIndex, 0, pages.Count - 1);
                var activePage = pages[safeIndex];
                var activeHighlight = activePage.SectionKey is null
                    ? null
                    : Vm.ResolveCardHighlight(activePage.SectionKey);
                var activeTitle = ResolvePageTitle(activePage, activeHighlight);
                var activeIcon = ResolvePageIcon(activePage, activeHighlight);
                var protectPointerGestures = PageProtectsPointerGestures(activePage);
            }
            <article class="wedding-card-face"
                     aria-label="@activeTitle"
                     @onpointerdown:stopPropagation="@protectPointerGestures"
                     @onpointerup:stopPropagation="@protectPointerGestures">
                @if (activePage.SectionKey is null)
                {
                    <section class="wedding-card-cover"
                             role="banner"
                             data-drag-container
                             data-hero-crop-container
                             style="@Vm.HeroImageStyle">
                        @if (!string.IsNullOrWhiteSpace(Vm.HeroImageUrl))
                        {
                            <img class="wedding-card-cover__image wedding-card-cover__image--backdrop"
                                 src="@Vm.HeroImageUrl"
                                 alt=""
                                 aria-hidden="true"
                                 loading="eager" />
                            <img class="wedding-card-cover__image"
                                 data-hero-crop-image
                                 src="@Vm.HeroImageUrl"
                                 alt="@Vm.CoupleName 대표 사진"
                                 loading="eager" />
                        }
                        else
                        {
                            <div class="wedding-card-cover__image wedding-card-cover__image--empty"></div>
                        }
                        <div class="wedding-card-cover__veil"></div>
                        <span class="wedding-card-cover__seal" aria-hidden="true">W</span>

                        <div class="wedding-card-cover__panel wedding-card-cover__panel--top w-panel w-hero__top
                                    w-hero-panel--dv-@Vm.InviteHeroTopVerticalDesktop
                                    w-hero-panel--dh-@Vm.InviteHeroTopHorizontalDesktop
                                    w-hero-panel--mv-@Vm.InviteHeroTopVerticalMobile
                                    w-hero-panel--mh-@Vm.InviteHeroTopHorizontalMobile
                                    @(Vm.HasInviteHeroTopCustomPosition ? "w-draggable-positioned" : "")"
                             data-drag-target="heroTop"
                             @onpointerdown:stopPropagation
                             @onpointerup:stopPropagation
                             style="@Vm.InviteHeroTopStyle">
                            <p class="wedding-card-cover__kicker">@Vm.HeroTitle</p>
                            <h1>@Vm.CoupleName</h1>
                        </div>

                        <div class="wedding-card-cover__panel wedding-card-cover__panel--bottom w-panel w-hero__bottom
                                    w-hero-panel--dv-@Vm.InviteHeroBottomVerticalDesktop
                                    w-hero-panel--dh-@Vm.InviteHeroBottomHorizontalDesktop
                                    w-hero-panel--mv-@Vm.InviteHeroBottomVerticalMobile
                                    w-hero-panel--mh-@Vm.InviteHeroBottomHorizontalMobile
                                    @(Vm.HasInviteHeroBottomCustomPosition ? "w-draggable-positioned" : "")"
                             data-drag-target="heroBottom"
                             @onpointerdown:stopPropagation
                             @onpointerup:stopPropagation
                             style="@Vm.InviteHeroBottomStyle">
                            <p class="wedding-card-cover__date">
                                @Vm.WeddingDate.ToString("yyyy년 MM월 dd일 (ddd)")
                                @if (!string.IsNullOrWhiteSpace(Vm.WeddingTime))
                                {
                                    <span>@Vm.WeddingTime</span>
                                }
                            </p>
                            @if (!string.IsNullOrWhiteSpace(Vm.VenueName))
                            {
                                <p class="wedding-card-cover__venue">@Vm.VenueName</p>
                            }
                        </div>
                    </section>
                }
                else
                {
                    var hasHighlightCopy = activeHighlight is not null
                        && !string.IsNullOrWhiteSpace(activeHighlight.Body);
                    <section class="wedding-card-sheet wedding-card-sheet--@activePage.SectionKey">
                        <header class="wedding-card-sheet__header">
                            <span class="wedding-card-sheet__folio">@(safeIndex + 1). CARD</span>
                            <span class="wedding-card-sheet__icon" aria-hidden="true">@activeIcon</span>
                            <h2>@activeTitle</h2>
                            @if (hasHighlightCopy)
                            {
                                <p>@activeHighlight!.Body</p>
                            }
                        </header>
                        <div class="wedding-card-sheet__content"
                             role="region"
                             tabindex="0"
                             aria-label="@($"{activeTitle} 내용. 위아래로 스크롤할 수 있습니다.")">
                            <InvitationSections Slug="@Slug"
                                                Vm="@Vm"
                                                VmGuest="@VmGuest"
                                                MediaDismissVersion="@_mediaDismissVersion"
                                                IsTabbed="true"
                                                ActiveSection="@activePage.SectionKey"
                                                PauseMusicRequested="@PauseMusicRequested" />
                        </div>
                        <footer class="wedding-card-sheet__footer" aria-hidden="true">
                            <span>@Vm.CoupleName</span>
                            <span class="wedding-card-sheet__scroll-hint">
                                <span class="wedding-card-sheet__scroll-arrow">↕</span>
                                @ResolveScrollHint(activePage)
                            </span>
                            <span>WEDDING INVITATION</span>
                        </footer>
                    </section>
                }
            </article>
        </PageContent>
    </LayoutTransitionSurface>

    <p class="wedding-card-navigation__hint">
        버튼이나 키보드 좌우 방향키를 사용하고, 콘텐츠가 없는 영역에서는 좌우로 밀어 카드를 넘겨보세요.
    </p>
</section>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter, EditorRequired] public WeddingInvitationViewModel Vm { get; set; } = default!;
    [Parameter, EditorRequired] public WeddingGuestbookViewModel VmGuest { get; set; } = default!;
    [Parameter] public EventCallback PauseMusicRequested { get; set; }

    private static readonly LayoutTransitionDefinition CardTransition = new()
    {
        Kind = LayoutTransitionKind.FlipCard,
        DurationMilliseconds = 720,
        EnableSwipe = true,
        EnableKeyboard = true,
        ShowNavigation = true,
    };

    private sealed record CardPage(string Key, string? SectionKey);

    private int _activePageIndex;
    private int _mediaDismissVersion;
    private string _layoutFingerprint = "";

    private IReadOnlyList<CardPage> VisiblePages
    {
        get
        {
            var pages = new List<CardPage> { new("cover", null) };
            pages.AddRange(
                Vm.OrderedSections
                    .Where(section => !string.Equals(section, "hero", StringComparison.OrdinalIgnoreCase))
                    .Where(IsSectionRenderable)
                    .Select(section => new CardPage(section, section)));
            return pages;
        }
    }

    protected override void OnParametersSet()
    {
        var fingerprint = $"{Vm.LayoutKey}|{Vm.LayoutVersion}";
        if (!string.Equals(_layoutFingerprint, fingerprint, StringComparison.Ordinal))
        {
            _layoutFingerprint = fingerprint;
            _activePageIndex = 0;
            _mediaDismissVersion++;
            Vm.CloseLightbox();
        }

        _activePageIndex = Math.Clamp(
            _activePageIndex,
            0,
            Math.Max(0, VisiblePages.Count - 1));
    }

    private Task OnActivePageChanging(int _)
    {
        // 현재 카드의 사진·영상·자동재생을 먼저 정리하라는 선언적 신호입니다.
        // 새 카드가 같은 InvitationSections 인스턴스를 재사용하더라도
        // MediaDismissVersion 변경을 확인하고 임시 미디어 상태를 비웁니다.
        _mediaDismissVersion++;
        Vm.CloseLightbox();
        return Task.CompletedTask;
    }

    private Task OnActivePageChanged(int nextIndex)
    {
        _activePageIndex = Math.Clamp(
            nextIndex,
            0,
            Math.Max(0, VisiblePages.Count - 1));
        return Task.CompletedTask;
    }

    private string ResolvePageLabel(int index)
    {
        var pages = VisiblePages;
        if (index < 0 || index >= pages.Count)
        {
            return $"카드 {index + 1}";
        }

        var page = pages[index];
        return ResolvePageTitle(
            page,
            page.SectionKey is null
                ? null
                : Vm.ResolveCardHighlight(page.SectionKey));
    }

    private bool IsSectionRenderable(string section)
    {
        if (!Vm.LayoutDescriptor.SupportedSections.Contains(section))
        {
            return false;
        }

        return section switch
        {
            "story" => !string.IsNullOrWhiteSpace(Vm.Story) || !string.IsNullOrWhiteSpace(Vm.Story2),
            "info" => Vm.Mode != WeddingSiteMode.ThankYou || !string.IsNullOrWhiteSpace(Vm.CeremonyNoteHtml),
            "details" => HasDetails,
            "gallery" => Vm.Gallery.Count > 0,
            "video" => Vm.VideoUrls.Count > 0,
            "gift" => Vm.Accounts.Count > 0,
            "guestbook" => true,
            _ => false,
        };
    }

    private bool HasDetails =>
        Vm.Mode != WeddingSiteMode.ThankYou
        && (!string.IsNullOrWhiteSpace(Vm.VenueName)
            || !string.IsNullOrWhiteSpace(Vm.VenueAddress)
            || !string.IsNullOrWhiteSpace(Vm.MapLinkKakao)
            || !string.IsNullOrWhiteSpace(Vm.MapLinkNaver)
            || !string.IsNullOrWhiteSpace(Vm.MapLinkAtlan)
            || !string.IsNullOrWhiteSpace(Vm.MapLinkTmap)
            || Vm.HasVenueCoords
            || !string.IsNullOrWhiteSpace(Vm.RoadMapUrl));

    private static bool PageProtectsPointerGestures(CardPage page) =>
        page.SectionKey is "details" or "gallery" or "video" or "gift" or "guestbook";

    private static string ResolvePageTitle(CardPage page, CardHighlight? highlight)
    {
        if (page.SectionKey is null)
        {
            return "표지";
        }

        return !string.IsNullOrWhiteSpace(highlight?.Title)
            ? highlight.Title
            : WeddingSectionOrderCatalog.GetLabel(page.SectionKey);
    }

    private static string ResolvePageIcon(CardPage page, CardHighlight? highlight)
    {
        if (page.SectionKey is null)
        {
            return "♡";
        }

        return !string.IsNullOrWhiteSpace(highlight?.Icon)
            ? highlight.Icon
            : WeddingSectionOrderCatalog.GetIcon(page.SectionKey);
    }

    private string ResolveScrollHint(CardPage page) =>
        string.Equals(page.SectionKey, "gift", StringComparison.OrdinalIgnoreCase)
        && Vm.Accounts.Count > 1
            ? $"계좌 {Vm.Accounts.Count}개 · SCROLL"
            : "SCROLL";
}
