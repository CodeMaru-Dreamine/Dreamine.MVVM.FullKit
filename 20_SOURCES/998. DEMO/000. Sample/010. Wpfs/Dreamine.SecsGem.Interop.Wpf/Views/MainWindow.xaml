<Window x:Class="Dreamine.SecsGem.Interop.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Dreamine.SecsGem.Interop.Wpf.ViewModels"
        xmlns:behaviors="clr-namespace:Dreamine.SecsGem.Interop.Wpf.Behaviors"
        Title="Dreamine SECS/GEM Interoperability Harness"
        Width="1600" Height="1000" MinWidth="1100" MinHeight="650"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="#263B5C"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:SecsItemNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <ComboBox Width="120" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"/>
                <TextBox Width="300" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma-separated typed values"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Dreamine SECS/GEM Interop"/>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Evidence harness — not a compliance certificate"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel HorizontalAlignment="Right">
                        <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsMultiEquipmentMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                    <Border Style="{StaticResource Badge}"><StackPanel Orientation="Horizontal"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="TCP  "/><TextBlock FontWeight="SemiBold" Text="{Binding TcpState}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#F2C66D"/><Style.Triggers><DataTrigger Binding="{Binding TcpState}" Value="Connected"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding TcpState}" Value="Faulted"><Setter Property="Foreground" Value="#FF7782"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                    <Border Style="{StaticResource Badge}"><StackPanel Orientation="Horizontal"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="HSMS  "/><TextBlock FontWeight="SemiBold" Text="{Binding HsmsState}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#F2C66D"/><Style.Triggers><DataTrigger Binding="{Binding HsmsState}" Value="Selected"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                    <Border Style="{StaticResource Badge}"><StackPanel Orientation="Horizontal"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Role  "/><TextBlock FontWeight="SemiBold" Text="{Binding Settings.Role}"/></StackPanel></Border>
                    <Border Style="{StaticResource Badge}"><StackPanel Orientation="Horizontal"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Mode  "/><TextBlock FontWeight="SemiBold" Text="{Binding Settings.Mode}"/></StackPanel></Border>
                    <Border Style="{StaticResource Badge}"><StackPanel Orientation="Horizontal"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Responder  "/><TextBlock FontWeight="SemiBold" Text="{Binding EquipmentResponderState}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#F2C66D"/><Style.Triggers><DataTrigger Binding="{Binding AnyEquipmentResponderActive}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                    </WrapPanel>
                    <Border HorizontalAlignment="Right"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Badge}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMultiEquipmentMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Multi Host  "/><TextBlock FontWeight="SemiBold" Text="{Binding MultiEquipmentSummary}"/></StackPanel></Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,10" FontSize="18" FontWeight="SemiBold" Text="Connection"/>
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Margin="3,0,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Harness mode"/>
                        <ComboBox ItemsSource="{Binding HostModes}" SelectedItem="{Binding HostMode}"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsMultiEquipmentMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="Host / Bind"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.Host, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Grid.Row="1" Content="Port"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Grid.Row="2" Content="Mode"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ConnectionModes}" SelectedItem="{Binding Settings.Mode}"/>
                        <Label Grid.Row="3" Content="Role"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding Settings.Role}"/>
                        <Label Grid.Row="4" Content="Session ID"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.SessionId, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="0,14,0,8">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsMultiEquipmentMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <UniformGrid Columns="2"><Button Style="{StaticResource PrimaryButton}" Content="Connect" Command="{Binding ConnectCommand}"/><Button Style="{StaticResource DangerButton}" Content="Disconnect" Command="{Binding DisconnectCommand}"/></UniformGrid>
                        <UniformGrid Columns="2"><Button Content="Select" Command="{Binding SelectCommand}"/><Button Style="{StaticResource DangerButton}" Content="Separate" Command="{Binding SeparateCommand}"/></UniformGrid>
                        <UniformGrid Columns="2"><Button Content="Linktest" Command="{Binding LinktestCommand}"/><Button Content="Reconnect" Command="{Binding ReconnectCommand}"/></UniformGrid>
                        <TextBlock Margin="4,8,4,0" FontWeight="SemiBold" Text="Equipment responder profile"/>
                        <ComboBox ItemsSource="{Binding EquipmentResponderProfileOptions}"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  SelectedIndex="0"
                                  SelectedValue="{Binding SelectedEquipmentResponderProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers><DataTrigger Binding="{Binding EquipmentResponderEnabled}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Button Content="{Binding EquipmentResponderButtonText}" Command="{Binding EnableResponderCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EquipmentResponderEnabled}" Value="True">
                                            <Setter Property="Background" Value="#087F6B"/>
                                            <Setter Property="BorderBrush" Value="#20C7A5"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Margin="4,3,4,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Select one mutually exclusive Demo responder. The E30 option uses the public profile; the educational fallback is Demo-only. Enabled state persists across reconnects." TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="5" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsMultiEquipmentMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Connection summary"/>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Foreground="{StaticResource MutedTextBrush}" Text="Provider"/><TextBlock Grid.Row="0" Grid.Column="1" Text="Dreamine"/>
                                <TextBlock Grid.Row="1" Foreground="{StaticResource MutedTextBrush}" Text="TCP"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TcpState}"/>
                                <TextBlock Grid.Row="2" Foreground="{StaticResource MutedTextBrush}" Text="HSMS"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HsmsState}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="5" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMultiEquipmentMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Multi Equipment Host"/>
                            <TextBlock Margin="0,7,0,0" Text="{Binding MultiEquipmentSummary}"/>
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding SelectedEquipment.Endpoint, TargetNullValue=Select an equipment row}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedEquipment.Endpoint}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Border>

            <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedMainTabIndex}">
                <TabItem Header="Messages">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
                    <Grid Margin="12" MinHeight="420" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <WrapPanel>
                                <Label Content="Stream"/><TextBox Width="70" Text="{Binding Stream}"/>
                                <Label Margin="14,0,0,0" Content="Function"/><TextBox Width="70" Text="{Binding Function}"/>
                                <CheckBox Margin="18,0" VerticalAlignment="Center" Content="W-bit / reply expected" IsChecked="{Binding ReplyExpected}"/>
                                <Button MinWidth="136" Content="Send Message" Command="{Binding SendCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsMultiEquipmentMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Use Send to Selected or Broadcast Message on the Multi Equipment tab.">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMultiEquipmentMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </WrapPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="Structured SECS-II Item Tree"/><TextBlock Margin="0,3,0,10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Build typed items without implying SML support. Values are comma-separated."/></StackPanel>
                                <TreeView Grid.Row="1" Padding="8" ItemsSource="{Binding RootItems}" behaviors:TreeViewSelectionBehavior.SelectedItem="{Binding SelectedItem, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                        <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Add root item" Command="{Binding AddRootItemCommand}"/><Button Content="Add child item" Command="{Binding AddChildItemCommand}"/><Button Style="{StaticResource DangerButton}" Content="Remove selected" Command="{Binding RemoveItemCommand}"/></WrapPanel>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Multi Equipment" IsEnabled="{Binding IsMultiEquipmentMode}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
                    <Grid Margin="12" MinHeight="420" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
                            <WrapPanel VerticalAlignment="Center">
                                <Label Content="Equipment ID"/><TextBox Width="105" Text="{Binding NewEquipmentId, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="IP"/><TextBox Width="125" Text="{Binding NewEquipmentHost, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Port"/><TextBox Width="75" Text="{Binding NewEquipmentPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Mode"/><ComboBox Width="105" ItemsSource="{Binding ConnectionModes}" SelectedItem="{Binding NewEquipmentMode}"/>
                                <Label Content="Session ID"/><TextBox Width="75" Text="{Binding NewEquipmentSessionId, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Add Equipment" Command="{Binding AddEquipmentCommand}"/>
                                <Button Style="{StaticResource DangerButton}" Content="Remove Selected" Command="{Binding RemoveEquipmentCommand}"/>
                            </WrapPanel>
                        </Border>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <Button Style="{StaticResource PrimaryButton}" Content="Connect Selected" Command="{Binding ConnectSelectedEquipmentCommand}"/>
                            <Button Style="{StaticResource DangerButton}" Content="Disconnect Selected" Command="{Binding DisconnectSelectedEquipmentCommand}"/>
                            <Button Content="Reconnect Selected" Command="{Binding ReconnectSelectedEquipmentCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Connect All" Command="{Binding ConnectAllEquipmentCommand}"/>
                            <Button Style="{StaticResource DangerButton}" Content="Disconnect All" Command="{Binding DisconnectAllEquipmentCommand}"/>
                            <Button Content="Linktest Selected" Command="{Binding LinktestSelectedEquipmentCommand}"/>
                            <Button Content="Linktest All" Command="{Binding LinktestAllEquipmentCommand}"/>
                            <Button Content="Send to Selected" Command="{Binding SendSelectedEquipmentCommand}"/>
                            <Button Content="Broadcast Message" Command="{Binding BroadcastEquipmentCommand}"/>
                            <Button Content="Run Scenario for Selected" Command="{Binding RunSelectedEquipmentScenarioCommand}"/>
                            <Button Content="Run Scenario for All" Command="{Binding RunAllEquipmentScenariosCommand}"/>
                            <Button Content="Run 1/2/10/50 Self-test" Command="{Binding RunMultiEquipmentSelfTestCommand}"/>
                            <Button Content="Import Configuration" Command="{Binding ImportEquipmentConfigurationCommand}"/>
                            <Button Content="Export Configuration" Command="{Binding ExportEquipmentConfigurationCommand}"/>
                        </WrapPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding EquipmentConnections}" SelectedItem="{Binding SelectedEquipment}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeRows="False" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Equipment" Binding="{Binding EquipmentId}" Width="1.1*"/>
                                <DataGridTextColumn Header="IP" Binding="{Binding Host}" Width="1.1*"/>
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="0.65*"/>
                                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="0.8*"/>
                                <DataGridTextColumn Header="SID" Binding="{Binding SessionId}" Width="0.55*"/>
                                <DataGridTextColumn Header="TCP" Binding="{Binding TcpState}" Width="0.9*"/>
                                <DataGridTextColumn Header="HSMS" Binding="{Binding HsmsState}" Width="1.1*"/>
                                <DataGridTextColumn Header="GEM" Binding="{Binding GemState}" Width="1.15*"/>
                                <DataGridTextColumn Header="Responder" Binding="{Binding ResponderState}" Width="1.1*"/>
                                <DataGridTextColumn Header="Activity" Binding="{Binding LastActivity, StringFormat=HH:mm:ss.fff}" Width="1.15*"/>
                                <DataGridTemplateColumn Header="Last Error" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LastError}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastError}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10,6">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding MultiEquipmentSummary}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding MultiEquipmentTestResult}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} · {2} SID {3} · TCP {4} · HSMS {5} · GEM {6} · {7} · Activity {8:HH:mm:ss.fff} · Error {9}">
                                            <Binding Path="SelectedEquipment.EquipmentId"/><Binding Path="SelectedEquipment.Endpoint"/><Binding Path="SelectedEquipment.Mode"/><Binding Path="SelectedEquipment.SessionId"/><Binding Path="SelectedEquipment.TcpState"/><Binding Path="SelectedEquipment.HsmsState"/><Binding Path="SelectedEquipment.GemState"/><Binding Path="SelectedEquipment.ResponderState"/><Binding Path="SelectedEquipment.LastActivity"/><Binding Path="SelectedEquipment.LastError"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Scenarios">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
                    <Grid Margin="12" MinHeight="420" TextElement.Foreground="{StaticResource TextBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.ColumnSpan="3"><TextBlock FontSize="16" FontWeight="SemiBold" Text="Scenario v1 file workbench"/><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Runs the selected persisted file through the same bounded ScenarioRunnerV1 used by headless mode. This is separate from synthetic Run All." TextWrapping="Wrap"/></StackPanel>
                                <Border Grid.Row="1" Margin="0,8,6,0" Height="34" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,0"><TextBlock VerticalAlignment="Center" Text="{Binding ScenarioFilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ScenarioFilePath}"/></Border>
                                <Button Grid.Row="1" Grid.Column="1" Margin="3,8,3,0" Content="Browse / Load…" Command="{Binding LoadScenarioFileCommand}"/>
                                <Button Grid.Row="1" Grid.Column="2" Margin="3,8,0,0" Style="{StaticResource PrimaryButton}" Content="Run selected file" Command="{Binding RunScenarioFileCommand}"/>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0"><TextBlock Text="{Binding ScenarioFileStatus}" TextWrapping="Wrap"/><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding ScenarioRunStatus, StringFormat=Last selected-file run: {0}}"/></StackPanel>
                            </Grid>
                        </Border>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,8"><Button Style="{StaticResource PrimaryButton}" Content="Run Selected" Command="{Binding RunSelectedCommand}"/><Button Content="Run All Automatic" Command="{Binding RunAllCommand}"/><Button Style="{StaticResource DangerButton}" Content="Stop" Command="{Binding CancelCommand}"/><Button Content="Reset" Command="{Binding ResetScenariosCommand}"/></WrapPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="72"/>
                                <DataGridTemplateColumn Header="Scenario" Width="2.1*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Name}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#46536A"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="NotRun"><Setter Property="Background" Value="#46536A"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="WaitingForUser"><Setter Property="Background" Value="#8A6424"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="Background" Value="#275C91"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Passed"><Setter Property="Background" Value="#16745F"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Background" Value="#963D47"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Status}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Duration" Binding="{Binding Elapsed}" Width="100"/>
                                <DataGridTemplateColumn Header="Detail" Width="2.4*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock VerticalAlignment="Center" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold" Text="Selected scenario detail"/>
                                <StackPanel Grid.Row="1" Margin="0,8,12,0"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding SelectedScenario.Id, TargetNullValue=No selection}"/><TextBlock FontWeight="SemiBold" Text="{Binding SelectedScenario.Status}"/><TextBlock Text="{Binding SelectedScenario.Elapsed, StringFormat=Duration: {0}}"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"><TextBlock Text="{Binding SelectedScenario.Detail, TargetNullValue=Select a scenario to inspect its full result.}" TextWrapping="Wrap"/><TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ScenarioRunDetails}" TextWrapping="Wrap"/></StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Protocol Log">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
                    <Grid Margin="12" MinHeight="500">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10,6">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Equipment"/>
                                <ComboBox Width="160" Margin="8,0" ItemsSource="{Binding EquipmentFilterOptions}" SelectedItem="{Binding EquipmentLogFilter}"/>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Filter"/>
                                <TextBox Width="220" Margin="8,0" ToolTip="Equipment, connection, endpoint, direction, SxFy, System Bytes, category, summary, or decoded text" Text="{Binding LogFilterText, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Margin="8,0" VerticalAlignment="Center" Content="Pause view" IsChecked="{Binding IsLogViewPaused}"/>
                                <CheckBox Margin="8,0" VerticalAlignment="Center" Content="Auto scroll" IsChecked="{Binding AutoScrollLogs}"/>
